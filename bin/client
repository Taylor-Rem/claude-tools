#!/usr/bin/env python3
"""client — stamp and inspect client workspaces (~/projects/clients/<slug>).

A client workspace is where the relay runs Claude for one client: their git
repos under repos/ and texted photos in incoming/. The workspace's CLAUDE.md and
.claude/settings.json are the permission boundary; this tool writes them from
templates/client/ in the claude-tools repo.

  client new <slug> --name "Name" [--live-url URL] [--tier T] [--template TYPE] [--shared-key] [--restamp]
  client ls
  client doctor [slug]
  client snippet <slug>          # the config.json project entry to paste
  client remotes [slug] [--write] # record each registered repo's push address in sites.json (B85)
  client exec --project P --role client|demo|owner --workspace WS --cwd C -- TOOL ARGV…
                                 # the relay's broker only: one keyed tool for a walled run (B85)

Per-client facts that must survive a --restamp (who decides what, standing
instructions, anything Taylor said about this one client) go in the
workspace's NOTES.md; `client new` folds it into CLAUDE.md under "Notes for
this client" every time it stamps, and never writes to NOTES.md itself.

Each client runs on its own Anthropic Console workspace + key,
ANTHROPIC_KEY_<SLUG> in the toolbelt (`client new` prints the setenv.sh step
and puts the `auth` line in the config.json entry). --shared-key skips that:
the relay's defaults.client_auth (the shared workspace) pays instead.

`client ls` and `client doctor` read the relay's config.json (RELAY_CONFIG,
default ~/projects/sms-relay/config.json) for what is true of each client
now — on the plan or unbilled, the demo, frozen, who texts, and which key
actually pays — so the listing can't drift from the relay. The tier's name,
price, texter cap and schedules come from the relay's own relay/tiers.py
beside that config.json (six tiers since B31; since B96 Hosting holds a
few small changes by text a month, one texter, no top-up).

CLIENTS_DIR overrides ~/projects/clients. No keys needed (it only checks names).
"""

import argparse
import importlib.util
import json
import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
TEMPLATES = HERE / "templates" / "client"
CLIENTS_DIR = Path(os.environ.get("CLIENTS_DIR", "~/projects/clients")).expanduser()

DANGEROUS = ("Bash(python3 -c:*)", "Bash(python:*)", "Bash(cat:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(ls:*)",
             "Bash(head:*)", "Bash(wc:*)", "Bash(grep:*)", "Bash(python3 -m json.tool:*)", "Bash(magick:*)",
             "Bash(magick *)", "Bash(identify *)", "Bash(bash:*)", "Bash(sh:*)", "Bash(curl:*)", "Bash(wget:*)",
             "Bash(env:*)", "Read", "Bash", "Edit", "Write")
REQUIRED_DENY = ("Bash(* /home/*)", "Bash(*~/*)", "Bash(*../*)", "Bash(*$HOME*)",
                 "Bash(*$ANTHROPIC*)", "Bash(*$GEMINI*)", "Bash(*_API_KEY*)",   # the run's own keys stay out of commands
                 "Edit(./.client.json)", "Write(./.client.json)",               # the tenant identity isn't the agent's to change (B80)
                 "Edit(./.claude/**)", "Write(./.claude/**)")                    # nor its own settings
TOOLBELT = Path(os.environ.get("CLAUDE_TOOLS_ENV", "~/.config/claude-tools/env")).expanduser()
SITES = TOOLBELT.parent / "sites.json"          # `site new` / `site adopt` record every site here
RELAY_CONFIG = Path(os.environ.get("RELAY_CONFIG", "~/projects/sms-relay/config.json")).expanduser()
sys.path.insert(0, str(HERE / "lib"))
import sandbox_tools  # noqa: E402  (client exec, B85; also read_beneath for anything read from a workspace)


def relay_config():
    try:
        return json.loads(RELAY_CONFIG.read_text())
    except (OSError, ValueError):
        return None


def relay_tiers():
    """The relay's tier table (relay/tiers.py beside config.json), or None. It has no imports of its own."""
    path = RELAY_CONFIG.parent / "relay" / "tiers.py"
    try:
        spec = importlib.util.spec_from_file_location("relay_tiers", path)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except (OSError, ImportError, SyntaxError, AttributeError):
        return None


def plan_line(tier_key):
    """'Hosting $10/mo · $10 usage/mo ($20 first) · 1 texter · no schedules', or '' when unknown."""
    tiers = relay_tiers()
    t = tiers.get(tier_key) if tiers else None
    if not t:
        return f"tier {tier_key!r} (not in the relay's tiers.py)" if tier_key else ""
    who = ("unlimited texters" if t["texters"] is None else f"{t['texters']} texter{'s' if t['texters'] != 1 else ''}")
    usage = (f"${t['monthly_allowance_usd']:g} usage/mo (${t['first_period_allowance_usd']:g} first)"
             if t["monthly_allowance_usd"] else "no usage")
    sched = f"{t['schedules']} schedules" if t["schedules"] else "no schedules"
    return f"{t['name']} ${t['monthly_usd']:g}/mo · {usage} · {who} · {sched}"


def relay_view(slug, cfg):
    """What the relay says about this client: status, who texts, what pays. None if the relay doesn't know it."""
    if not cfg:
        return None
    p = (cfg.get("projects") or {}).get(slug)
    if not p:
        return None
    senders = [(k, v) for k, v in (cfg.get("senders") or {}).items()
               if v.get("role") in ("client", "family") and (v.get("projects") == "*" or slug in (v.get("projects") or []))]
    active = [v.get("name") or k for k, v in senders if v.get("state") in (None, "active")]
    billing = p.get("billing") or {}
    demo = cfg.get("demo") or {}
    if slug == demo.get("project") or slug in (demo.get("projects") or {}):
        status = "demo"
        active = active or ["anyone (the demo's texters aren't senders)"]
    elif senders and not active:
        status = "frozen"
    elif billing.get("plan") == "managed":
        tiers = relay_tiers()
        t = tiers.get(billing.get("tier")) if tiers else None
        status = f"on {t['name']}" if t else f"on the plan ({billing.get('tier') or '?'})"
    else:
        status = "unbilled"
    auth = (p.get("agent") or {}).get("auth")
    if auth:
        pays = auth
    elif p.get("allow_plan"):
        pays = "Taylor's plan (allow_plan)"
    else:
        pays = (cfg.get("defaults") or {}).get("client_auth") or "nothing — the relay refuses to load"
    return {"status": status, "texters": active, "pays": pays, "auth": auth, "allow_plan": bool(p.get("allow_plan")),
            "plan": plan_line(billing.get("tier")) if billing.get("plan") == "managed" else ""}


def patch_built(slug, repo):
    """Is this repo a site `site new` / `site adopt` made (so it carries the template's CLAUDE.md)?
    A row `client remotes --add` wrote (host "external") is only a push address, not one of ours."""
    try:
        entries = json.loads(SITES.read_text()).get(slug, {})
    except (OSError, ValueError):
        return True
    return any((e.get("repo") == repo or name == repo) and e.get("host") != "external"
               for name, e in entries.items()) if entries else False


def binding_problem(ws, repo, entry):
    """A site with a database (sites.json `d1`) must bind exactly that database in
    its repo's wrangler.toml, and a repo with functions/ must have one. None = fine."""
    import tomllib
    d = ws / "repos" / repo
    d1 = (entry or {}).get("d1") or {}
    if not d1.get("id"):
        return "functions/ but no database in sites.json (site data " + repo + ")" if (d / "functions").is_dir() else None
    p = d / "wrangler.toml"
    if not p.exists():
        return f"sites.json gives it D1 {d1.get('name')} but the repo has no wrangler.toml (site data {repo})"
    try:
        conf = tomllib.loads(p.read_text())
    except tomllib.TOMLDecodeError as exc:
        return f"wrangler.toml doesn't parse ({exc})"
    for b in conf.get("d1_databases") or []:
        if b.get("binding") == "DB":
            if b.get("database_id") == d1["id"] and b.get("database_name") == d1.get("name"):
                return None
            return (f"wrangler.toml binds {b.get('database_name')} ({b.get('database_id')}), "
                    f"sites.json says {d1.get('name')} ({d1['id']})")
    return f"sites.json gives it D1 {d1.get('name')} but wrangler.toml has no DB binding"


def site_urls(meta):
    """Every URL a client session may check: live_url, plus each site `site new`
    made for this workspace (its pages.dev address and any domain on it)."""
    urls = []
    if meta.get("live_url"):
        urls.append(meta["live_url"])
    try:
        sites = json.loads(SITES.read_text()).get(meta.get("slug", ""), {})
    except (OSError, ValueError):
        sites = {}
    for entry in sites.values():
        if entry.get("host") == "cloudflare" and entry.get("project"):
            urls.append(f"https://{entry.get('pages_host') or entry['project'] + '.pages.dev'}/")
        for d in entry.get("domains", []):
            urls.append(f"https://{d}/")
    return list(dict.fromkeys(u.rstrip("/") + "/" for u in urls))


def key_name(slug):
    """The toolbelt key name for a client's Anthropic Console workspace."""
    return "ANTHROPIC_KEY_" + slug.upper().replace("-", "_")


def toolbelt_has(name):
    """Whether a key is set in the toolbelt. Names only; values are never read into anything that prints."""
    if not TOOLBELT.exists():
        return False
    for line in TOOLBELT.read_text().splitlines():
        k, _, v = line.partition("=")
        if k.strip() == name and v.strip():
            return True
    return False


def die(msg, code=1):
    print(f"client: {msg}", file=sys.stderr)
    sys.exit(code)


def repos_of(ws):
    d = ws / "repos"
    return sorted(r.name for r in d.iterdir() if (r / ".git").exists()) if d.is_dir() else []


def read_meta(ws):
    """.client.json, read without following a link (a run could leave one; B85)."""
    raw = sandbox_tools.read_beneath(ws, ".client.json") if ws.is_dir() else None
    try:
        return json.loads(raw) if raw else {}
    except ValueError:
        return {}


def write_plain(ws, rel, text):
    """Write ws/rel as a plain file: a symlink a run left in its place is removed first,
    never followed, so a restamp can't be aimed at a file outside the workspace (B85)."""
    p = ws / rel
    if p.is_symlink():
        p.unlink()
    fd = sandbox_tools.open_beneath(ws, rel, os.O_WRONLY | os.O_CREAT | os.O_TRUNC)
    with os.fdopen(fd, "w") as f:
        f.write(text)


def is_demo(meta):
    """A demo workspace: the slug the templates reset nightly, or marked in .client.json."""
    return bool(meta.get("demo")) or (meta.get("slug") or "").startswith("demo-")


def render_settings(meta, ws):
    tpl = json.loads((TEMPLATES / "settings.json").read_text())
    rules = tpl.pop("_rules")
    allow = list(tpl["permissions"]["allow"]) + rules["repos"]
    for url in site_urls(meta):
        allow += [r.format(url=url.rstrip("/")) for r in rules["live_url"]]
    tpl["permissions"]["allow"] = allow
    return json.dumps(tpl, indent=2) + "\n"


def render_claude_md(meta, notes=""):
    md = (TEMPLATES / "CLAUDE.md").read_text()
    if not meta.get("live_url"):
        md = md.replace("{{LIVE_URL}}", "https://<the live site>/")   # no site yet: the example still reads
    for k in ("name", "slug", "live_url"):
        md = md.replace("{{" + k.upper() + "}}", meta.get(k) or "")
    tools = ["`git -C repos/<name>`", "`img`", "`site`", "`db`", "`shot`", "`newsletter`", "`gbp`", "`pay`", "`social`", "`print`", "`doc`"]
    md = md.replace("{{TOOLS}}", ", ".join(tools))
    if meta.get("live_url"):
        check = f"`curl -s {meta['live_url']}PAGE` — no .html on the end, the host redirects those — is allowed; the change is there as soon as `site publish` says so"
    else:
        check = ("the allowlist gains a curl rule for a site's URL when `site new` creates it; "
                 "until then verify the push landed with `git -C repos/<name> log -1` and say so")
    md = md.replace("{{LIVE_CHECK}}", check)
    block = ""
    if notes.strip():
        block = ("\n## Notes for this client (from `NOTES.md`; these win over the general rules above)\n\n"
                 + notes.strip() + "\n")
    md = md.replace("{{NOTES}}", block)
    return md


def stamp(ws, meta):
    ws.mkdir(parents=True, exist_ok=True)
    (ws / "repos").mkdir(exist_ok=True)
    (ws / "incoming").mkdir(exist_ok=True)
    (ws / "incoming" / ".keep").touch()
    (ws / "mail" / "drafts").mkdir(parents=True, exist_ok=True)   # B75: Patch's reply drafts, EMAIL-DRAFT: <id>
    (ws / ".claude").mkdir(exist_ok=True)
    # NOTES.md is read without following a link: a run could leave NOTES.md pointing at a
    # file outside the workspace, and this text is folded into CLAUDE.md, which it reads.
    if (ws / "NOTES.md").is_symlink():
        print("  note: NOTES.md is a link, not a file; left out of CLAUDE.md (make it a plain file)")
    raw = sandbox_tools.read_beneath(ws, "NOTES.md")
    notes = raw.decode("utf-8", "replace") if raw else ""
    write_plain(ws, "CLAUDE.md", render_claude_md(meta, notes))
    write_plain(ws, "PLAYBOOK.md", (TEMPLATES / "PLAYBOOK.md").read_text())   # capabilities Patch sets up itself
    write_plain(ws, ".claude/settings.json", render_settings(meta, ws))
    write_plain(ws, ".client.json", json.dumps(meta, indent=2) + "\n")


def snippet(slug, meta):
    entry = {"type": "client", "name": meta["name"]}
    if meta.get("live_url"):
        entry["live_url"] = meta["live_url"]
    entry["agent"] = {"model": "opus"}
    if meta.get("auth"):
        entry["agent"]["auth"] = meta["auth"]
    return json.dumps({slug: entry}, indent=2)[1:-1].strip()


def tier_sites(name):
    """--tier: the tier's site count from the relay's table (all six tiers), or None."""
    if not name:
        return None
    tiers = relay_tiers()
    t = tiers.get(name) if tiers else None
    if not t:
        die(f"--tier {name!r}: not a tier ({', '.join(tiers.ORDER) if tiers else 'relay/tiers.py not found'})")
    return t["sites"]


def cmd_new(a):
    ws = CLIENTS_DIR / a.slug
    stamped = (ws / "CLAUDE.md").exists()
    if stamped and not a.restamp:
        die(f"{ws} already exists; use --restamp to rewrite CLAUDE.md and the allowlist "
            f"(repos/ and incoming/ are never touched)")
    old = read_meta(ws) if stamped else {}
    meta = {"slug": a.slug, "name": a.name or old.get("name") or a.slug,
            "live_url": a.live_url or old.get("live_url"),
            "sites": a.sites if a.sites is not None else tier_sites(a.tier) or old.get("sites", 1),   # the tier's count (plan 02); `site new` enforces it
            "auth": None if a.shared_key else (old.get("auth") or key_name(a.slug))}
    if old.get("contact_email"):
        meta["contact_email"] = old["contact_email"]      # `newsletter setup --contact` wrote it; a restamp keeps it
    # role: what the toolbelt's role table (lib/sandbox_tools.py) calls this workspace. The
    # relay reads a run's role from its own config.json, never from this file (B85).
    meta["role"] = "client"
    if is_demo({"slug": a.slug, "demo": old.get("demo")}):
        meta["demo"] = True
        meta["role"] = "demo"
        # Whether a stranger's text may still put a demo site live (B80 change 5,
        # supervisor review): "static" lets page edits go live but refuses any
        # change to Functions/_worker.js/_headers/wrangler against golden; "off"
        # lets only `demo reset` publish. Default static; kept on a restamp.
        meta["demo_publish"] = old.get("demo_publish") or "static"
    template = a.template or old.get("template")
    if template:
        known = sorted(d.name for d in (HERE / "templates" / "sites").iterdir() if d.is_dir() and not d.name.startswith("_"))
        if template not in known:
            die(f"--template {template!r}: not a kind of site ({', '.join(known)})")
        meta["template"] = template                       # the kind of site they chose on /start; `site new` uses it
    stamp(ws, meta)
    for name, url, note in sandbox_tools.record_remotes(a.slug, ws, write=True):   # B85: push addresses
        if note == "recorded":
            print(f"  registry: repos/{name} pushes to {url} (recorded)")
        elif url is None:
            print(f"  registry: repos/{name}: {note}")
    print(f"{'restamped' if stamped else 'created'} {ws}" + (f" · template: {meta['template']}" if meta.get("template") else ""))
    print(f"  repos: {', '.join(repos_of(ws)) or '(none yet — site new <slug> from inside it, or clone into repos/)'}"
          f" · sites allowed: {meta['sites']}")
    if meta["auth"]:
        state = "already in the toolbelt" if toolbelt_has(meta["auth"]) else "NOT in the toolbelt yet"
        print(f"\nAnthropic key ({state}): in console.anthropic.com make a workspace relay-{a.slug} with a "
              f"monthly spend limit, create one API key in it, then\n"
              f"  ~/.config/claude-tools/setenv.sh {meta['auth']}\n"
              f"  (until it exists every message from this client fails and you're notified; "
              f"your own messages here run on your plan)")
    else:
        print("\nAnthropic key: none of its own — the relay's defaults.client_auth (shared workspace) pays")
    print("\nconfig.json project entry:\n")
    print("  " + snippet(a.slug, meta).replace("\n", "\n  "))
    print("\nthen a sender line with \"projects\": [\"" + a.slug + "\"], ./relay.py check and ./doctor.py")
    print("\nWeekly report (B20): off unless the client asks Patch for it by text (or you run "
          "`./relay.py weekly on " + a.slug + "`); `./relay.py weekly show " + a.slug + "` previews their week.")


def cmd_ls(a):
    if not CLIENTS_DIR.is_dir():
        die(f"{CLIENTS_DIR} does not exist")
    cfg = relay_config()
    for ws in sorted(CLIENTS_DIR.iterdir()):
        if not ws.is_dir() or ws.name.startswith("."):
            continue
        m = read_meta(ws)
        rv = relay_view(ws.name, cfg)
        flags = []
        if m.get("live_url"):
            flags.append(m["live_url"])
        status = rv["status"] if rv else "not in the relay"
        who = ", ".join(rv["texters"]) if rv and rv["texters"] else "nobody"
        print(f"{ws.name:<18} {m.get('name', '?'):<28} {status:<20} texts: {who}")
        print(f"{'':<18} repos={','.join(repos_of(ws)) or '-'}  {' '.join(flags)}"
              + (f"  · pays: {rv['pays']}" if rv else ""))
        if rv and rv.get("plan"):
            print(f"{'':<18} plan: {rv['plan']}")


def admin_views(repo):
    """(views, missing): the lists a site's /admin shows, each (module, kind) with
    kind 'collection', 'named list' or 'tool' (a table of the site's own, a web
    tool — B40); missing = modules collections.js imports that aren't there."""
    import re
    reg = repo / "functions" / "_admin" / "collections.js"
    if not reg.exists():
        return [], []
    coll = HERE / "templates" / "collections"
    std = {p.stem for p in coll.glob("*/functions/_admin/*.js")}
    tabs = set()
    for m in coll.glob("*/migrations/*.sql"):
        tabs |= {t.lower() for t in re.findall(r"(?i)create\s+table\s+(?:if\s+not\s+exists\s+)?(\w+)", m.read_text())}
    views, missing = [], []
    for mod in re.findall(r'import\s+[A-Za-z_]\w*\s+from\s+"\./([\w-]+)\.js";', reg.read_text()):
        f = repo / "functions" / "_admin" / f"{mod}.js"
        if not f.exists():
            missing.append(mod)
            continue
        t = (re.search(r'\btable:\s*"(\w+)"', f.read_text()) or [None, ""])[1].lower()
        views.append((mod, "collection" if mod in std else "named list" if t in tabs else "tool"))
    return views, missing


def cmd_doctor(a):
    ok = True
    targets = [CLIENTS_DIR / a.slug] if a.slug else [d for d in sorted(CLIENTS_DIR.iterdir())
                                                     if d.is_dir() and not d.name.startswith(".")]
    for ws in targets:
        print(f"== {ws.name}")
        for f in ("CLAUDE.md", ".claude/settings.json", ".client.json"):
            if not (ws / f).exists():
                print(f"  FAIL missing {f}  (client new {ws.name} --restamp)"); ok = False
        settings = ws / ".claude" / "settings.json"
        if settings.exists():
            allow = json.loads(settings.read_text()).get("permissions", {}).get("allow", [])
            bad = [r for r in allow if r in DANGEROUS]
            if bad:
                print(f"  FAIL unbounded rules in allowlist: {', '.join(bad)}"); ok = False
            deny = json.loads(settings.read_text()).get("permissions", {}).get("deny", [])
            missing = [r for r in REQUIRED_DENY if r not in deny]
            if missing:
                print(f"  FAIL missing path denies: {', '.join(missing)}  (client new {ws.name} --restamp)"); ok = False
            if "{" in json.dumps(allow):
                print("  FAIL unrendered placeholder in allowlist"); ok = False
            m0 = read_meta(ws)
            want = "demo" if is_demo(m0) else "client"
            if m0.get("role") != want:
                print(f"  FAIL .client.json role is {m0.get('role')!r}, not {want!r}  (client new {ws.name} --restamp)"); ok = False
            if is_demo(m0):
                if m0.get("demo_publish") not in ("static", "off"):
                    print(f"  FAIL demo_publish is {m0.get('demo_publish')!r}, not 'static' or 'off'  (client new {ws.name} --restamp)"); ok = False
        for r in repos_of(ws):
            d = ws / "repos" / r
            # Before any git runs here (outside every sandbox): settings a run could have
            # added (a hook, fsmonitor, an include) would execute as Taylor (B85).
            rprob = sandbox_tools.registry_remote_problem(ws, ws.name, r)
            if rprob:
                print(f"  FAIL repo {r}: push address: {rprob}  (client remotes {ws.name} --write records a "
                      f"missing one; a mismatch is Taylor's to look at)"); ok = False
            gprob = sandbox_tools.repo_problem(ws, r)
            if gprob:
                print(f"  FAIL repo {r}: git settings look changed ({gprob}); publishing from it is paused. "
                      f"Look at repos/{r}/.git/config and hooks/ by hand before running git there"); ok = False
                continue
            remote = subprocess.run(["git", "-C", str(d), "remote", "get-url", "origin"],
                                    capture_output=True, text=True).stdout.strip()
            branch = subprocess.run(["git", "-C", str(d), "rev-parse", "--abbrev-ref", "HEAD"],
                                    capture_output=True, text=True).stdout.strip()
            probs = []
            if not remote.startswith("git@"):
                probs.append(f"remote is not SSH ({remote or 'none'})")
            if branch != "main":
                probs.append(f"on {branch}, not main")
            if not (d / "CLAUDE.md").exists() and patch_built(ws.name, r):
                probs.append("no CLAUDE.md")          # a repo that isn't a Patch-built site (James's app) is its owner's business
            print(f"  repo {r}: {'ok' if not probs else 'WARN ' + '; '.join(probs)}")
            ok = ok and not probs
            try:
                entry = json.loads(SITES.read_text()).get(ws.name, {}).get(r) if SITES.exists() else None
            except ValueError:
                entry = None
            bad = binding_problem(ws, r, entry)
            if bad:
                print(f"  FAIL repo {r}: database binding: {bad}"); ok = False
            elif (entry or {}).get("d1"):
                print(f"  repo {r}: database {entry['d1']['name']} bound as DB (db doctor checks the rest)")
            views, missing = admin_views(d)
            if missing:
                print(f"  FAIL repo {r}: /admin imports view(s) that aren't there: {', '.join(missing)}"); ok = False
            if views:
                tools = [m for m, k in views if k == "tool"]
                print(f"  repo {r}: /admin shows {len(views)} list(s)"
                      + (f", web tool(s): {', '.join(tools)}" if tools else ""))
        m = read_meta(ws)
        rv = relay_view(ws.name, relay_config())
        if rv is None:
            print("  relay: no project by this name in config.json (client snippet " + ws.name + ")")
        else:
            print(f"  relay: {rv['status']}; texts: {', '.join(rv['texters']) or 'nobody'}; pays: {rv['pays']}")
            if rv.get("plan"):
                print(f"  plan: {rv['plan']}")
            if rv["auth"]:
                if not toolbelt_has(rv["auth"]):
                    print(f"  FAIL key {rv['auth']} is named in config.json but NOT in the toolbelt — client messages fail (setenv.sh {rv['auth']})")
                    ok = False
            if m.get("auth") and m["auth"] != rv["auth"]:
                print(f"  note: .client.json names {m['auth']}, but the relay "
                      + (f"uses {rv['auth']}" if rv["auth"] else f"runs it on {rv['pays']}")
                      + f" (client new {ws.name} --restamp{' --shared-key' if not rv['auth'] else ''} to match)")
        stray = [p.name for p in (ws / "incoming").iterdir() if p.name != ".keep"] if (ws / "incoming").is_dir() else []
        if stray:
            print(f"  note: {len(stray)} file(s) left in incoming/")
    # One repo-wide check (B80): the identity tools cross-check .client.json
    # against RELAY_PROJECT, through lib/tenant.py.
    print("== toolbelt")
    if not (HERE / "lib" / "tenant.py").exists():
        print("  FAIL lib/tenant.py is missing (the tenant-identity cross-check)"); ok = False
    else:
        gaps = [t for t in ("site", "db", "newsletter", "social", "gbp", "pay", "connections")
                if (HERE / "bin" / t).exists() and "tenant.enforce" not in (HERE / "bin" / t).read_text()]
        if gaps:
            print(f"  FAIL these tools no longer cross-check RELAY_PROJECT: {', '.join(gaps)}"); ok = False
        else:
            print("  identity tools cross-check RELAY_PROJECT")
    ok = sandbox_doctor(a) and ok
    sys.exit(0 if ok else 1)


def sandbox_doctor(a):
    """The B85 half that lives here: bwrap, the shims, and (with --all) the relay's word that
    every client and demo project runs walled. Before the relay half ships, its absence is a
    note, not a failure, so merging the toolbelt first changes nothing."""
    ok = True
    print("== sandbox (B85)")
    if not Path(sandbox_tools.BWRAP).exists():
        print("  FAIL bwrap is not installed (apt install bubblewrap); keyed tools can't run for a walled run"); ok = False
    shims = HERE / "sandbox" / "bin"
    missing = [t for t in sandbox_tools.SHIMS if os.readlink(shims / t) != "tb"] if shims.is_dir() and all(
        (shims / t).is_symlink() for t in sandbox_tools.SHIMS) else list(sandbox_tools.SHIMS)
    if missing or not (shims / "tb").is_file():
        print(f"  FAIL sandbox/bin shims missing or not linked to tb: {', '.join(missing) or 'tb'}"); ok = False
    else:
        print(f"  bwrap present; {len(sandbox_tools.SHIMS)} shims in sandbox/bin (mounted by the relay, never in ~/.local/bin)")
    # B100: tools that run inside the wall are real files there, and bin/<name> links to them.
    bad = [t for t in sandbox_tools.IN_WALL
           if (shims / t).is_symlink() or not (shims / t).is_file() or not os.access(shims / t, os.X_OK)
           or not (HERE / "bin" / t).resolve() == (shims / t).resolve()]
    if bad:
        print(f"  FAIL sandbox/bin should hold {', '.join(bad)} as a real file with bin/ linking to it, "
              f"so a walled run can read the files people send"); ok = False
    else:
        print(f"  {len(sandbox_tools.IN_WALL)} tool runs inside the wall ({', '.join(sandbox_tools.IN_WALL)}: "
              f"no key, workspace files only)")
    if not getattr(a, "all", False):
        return ok
    relay = RELAY_CONFIG.parent / "relay.py"
    try:
        r = subprocess.run([str(relay), "sandbox", "doctor", "--json"], capture_output=True, text=True, timeout=60)
        data = json.loads(r.stdout) if r.stdout.strip().startswith("{") else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        data = None
    if data is None:
        print("  note: the relay has no `sandbox doctor --json` yet (its half of B85); runs are unwalled as today")
        return ok
    unwalled = [p.get("project", "?") for p in data.get("projects", []) if not p.get("walled")]
    if data.get("mode") != "on" or unwalled:
        print(f"  FAIL relay sandbox is {data.get('mode')!r}; unwalled: {', '.join(unwalled) or 'every project'}"
              f"  (./relay.py sandbox doctor)")
        ok = False
    else:
        print(f"  relay: every client and demo project walled ({len(data.get('projects', []))})")
    return ok


def cmd_remotes(a):
    """Record each registered repo's origin into its sites.json row as `remote` (B85): the only
    place a walled run's git push/fetch address comes from. Prints what it would do without --write.
    --add REPO registers a repo we don't host (sandbox_tools.add_remote)."""
    if a.add:
        if not a.slug:
            die("--add needs the workspace: client remotes SLUG --add REPO")
        url, note = sandbox_tools.add_remote(a.slug, CLIENTS_DIR / a.slug, a.add, write=a.write)
        print(f"{a.slug}/{a.add}: {url or '-'}  ({note})")
        if not a.write and url and note.startswith("would"):
            print("(nothing written; --write registers it)")
        sys.exit(0 if url else 1)
    targets = [CLIENTS_DIR / a.slug] if a.slug else [d for d in sorted(CLIENTS_DIR.iterdir())
                                                     if d.is_dir() and (d / ".client.json").exists()]
    for ws in targets:
        for name, url, note in sandbox_tools.record_remotes(ws.name, ws, write=a.write):
            print(f"{ws.name}/{name}: {url or '-'}  ({note})")
    if not a.write:
        print("(nothing written; --write records them)")


def cmd_exec(a):
    """The broker's entry point: one keyed tool call for a walled run (lib/sandbox_tools.py)."""
    sys.exit(sandbox_tools.main_exec(a))


def cmd_snippet(a):
    ws = CLIENTS_DIR / a.slug
    m = read_meta(ws)
    if not m:
        die(f"{ws} is not a stamped client workspace")
    print(snippet(a.slug, m))


def main():
    ap = argparse.ArgumentParser(prog="client", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    n = sub.add_parser("new", help="create (or --restamp) a client workspace")
    n.add_argument("slug"); n.add_argument("--name")
    n.add_argument("--live-url"); n.add_argument("--restamp", action="store_true")
    n.add_argument("--shared-key", action="store_true", help="no key of its own: the relay's defaults.client_auth pays")
    n.add_argument("--sites", type=int, metavar="N", help="how many sites this client's plan covers (default 1; kept on --restamp)")
    n.add_argument("--template", metavar="TYPE", help="the kind of site they picked on /start (business, service, …); "
                   "`site new` in the workspace uses it (kept on --restamp)")
    n.add_argument("--tier", metavar="T", help="hosting|light|starter|standard|elite|elite_plus: sites from the tier (--sites wins)")
    n.set_defaults(fn=cmd_new)
    sub.add_parser("ls", help="list client workspaces").set_defaults(fn=cmd_ls)
    d = sub.add_parser("doctor", help="check workspaces are stamped and repos are pushable")
    d.add_argument("slug", nargs="?")
    d.add_argument("--all", action="store_true", help="every workspace, and fail if the relay runs any client/demo unwalled")
    d.set_defaults(fn=cmd_doctor)
    s = sub.add_parser("snippet", help="print the config.json entry for a client")
    s.add_argument("slug"); s.set_defaults(fn=cmd_snippet)
    r = sub.add_parser("remotes", help="record each registered repo's push address in sites.json (B85)")
    r.add_argument("slug", nargs="?"); r.add_argument("--write", action="store_true")
    r.add_argument("--add", metavar="REPO", help="register repos/REPO, a repo we don't host (its own push deploys it), "
                   "at its GitHub origin, so a walled run can push it")
    r.set_defaults(fn=cmd_remotes)
    x = sub.add_parser("exec", help="(the relay's broker) run one keyed tool for a walled run")
    x.add_argument("--project", required=True); x.add_argument("--role", required=True, choices=sandbox_tools.ROLES)
    x.add_argument("--workspace", required=True); x.add_argument("--cwd", default=".")
    x.add_argument("argv", nargs=argparse.REMAINDER); x.set_defaults(fn=cmd_exec)
    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
