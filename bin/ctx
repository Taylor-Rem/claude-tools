#!/usr/bin/env python3
"""ctx — how full is a Claude session's context, and how long until it expires.

Every relay conversation is a resumed Claude Code session. Claude Code keeps a
transcript per session at ~/.claude/projects/<slugged-cwd>/<session-id>.jsonl,
and every assistant record in it carries the usage of that API call. The size
of the prompt on the last call is:

    input_tokens + cache_creation_input_tokens + cache_read_input_tokens

which is exactly how much context that session is carrying. Compare it with
the model's window and you have a fuel gauge.

The relay's side of it is ~/projects/sms-relay/state/state.json: which session
id belongs to which sender and project, and when it was last used. A session
goes stale after the project's session_expiry_minutes (config.json, default
360) — the next message then starts from nothing, so the countdown here is
"how long until this conversation forgets itself".

  ctx                     every live relay session: tokens, % of window, expiry
  ctx <name|project>      just the ones matching (a sender name, a project)
  ctx --json              the same as JSON
  ctx here                the session running in THIS directory (newest)
  ctx <session-id>        one session by id (full or first 8 chars)
  ctx doctor              can it find everything it needs?

Counts sidechain records (subagents) separately: they run in their own context
and don't sit in the main thread's window.

No keys needed; it only reads local files.
"""

import argparse
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

PROJECTS = Path(os.environ.get("CLAUDE_PROJECTS_DIR", "~/.claude/projects")).expanduser()
RELAY = Path(os.environ.get("SMS_RELAY_DIR", "~/projects/sms-relay")).expanduser()

# Context windows, tokens. Source: the claude-api skill's model table
# (cached 2026-06-24). A model that isn't listed falls back to DEFAULT_WINDOW
# and is shown with a "?" so the number is never quietly wrong.
WINDOWS = {
    "claude-fable-5-1": 1_000_000,
    "claude-fable-5": 1_000_000,
    "claude-mythos-5-1": 1_000_000,
    "claude-opus-5": 1_000_000,
    "claude-opus-4-8": 1_000_000,
    "claude-opus-4-7": 1_000_000,
    "claude-opus-4-6": 1_000_000,
    "claude-sonnet-5": 1_000_000,
    "claude-sonnet-4-6": 1_000_000,
    "claude-haiku-4-5": 200_000,
}
DEFAULT_WINDOW = 200_000


def die(msg, code=1):
    print(f"ctx: {msg}", file=sys.stderr)
    sys.exit(code)


def now():
    return datetime.now(timezone.utc)


def human_tokens(n):
    if n >= 1_000_000:
        return f"{n / 1_000_000:.2f}M"
    if n >= 1_000:
        return f"{n / 1_000:.0f}K"
    return str(n)


def human_age(minutes):
    if minutes < 60:
        return f"{minutes:.0f}m"
    if minutes < 60 * 24:
        return f"{minutes / 60:.1f}h"
    return f"{minutes / 1440:.1f}d"


def bar(fraction, width=20):
    filled = max(0, min(width, round(fraction * width)))
    return "█" * filled + "·" * (width - filled)


# ---- the relay's view: which session belongs to whom -----------------------

def relay_config():
    """(projects, limits, senders-by-key). Empty dicts if the relay isn't here."""
    path = RELAY / "config.json"
    if not path.exists():
        return {}, {"session_expiry_minutes": 360}, {}
    try:
        cfg = json.loads(path.read_text())
    except (json.JSONDecodeError, OSError) as exc:
        die(f"{path} is not readable JSON: {exc}")
    limits = cfg.get("limits") or {}
    limits.setdefault("session_expiry_minutes", 360)
    return cfg.get("projects") or {}, limits, cfg.get("senders") or {}


def expiry_minutes(project, limits):
    """Mirrors relay/router.py: a project may shorten its own session life."""
    v = ((project or {}).get("agent") or {}).get("session_expiry_minutes")
    return v if isinstance(v, (int, float)) and v > 0 else limits["session_expiry_minutes"]


def relay_sessions():
    """[{key, session_id, at, who, project, expiry_minutes}] from state.json."""
    path = RELAY / "state" / "state.json"
    if not path.exists():
        return []
    try:
        st = json.loads(path.read_text())
    except (json.JSONDecodeError, OSError):
        return []
    projects, limits, senders = relay_config()
    out = []
    for key, s in (st.get("sessions") or {}).items():
        if not isinstance(s, dict) or not s.get("id"):
            continue
        # "sms:+1…|bleu-grave|thread" or "room:discord:<channel>|hangout|"
        parts = key.split("|")
        sender_key, project_name = parts[0], (parts[1] if len(parts) > 1 else "")
        project = projects.get(project_name) or {}
        if sender_key.startswith("room:"):
            who = "room " + sender_key.split(":", 2)[-1]
        else:
            who = (senders.get(sender_key) or {}).get("name") or sender_key
        out.append({
            "key": key,
            "session_id": s["id"],
            "at": s.get("at") or "",
            "who": who,
            "project": project.get("name") or project_name or "?",
            "project_key": project_name,
            "expiry_minutes": expiry_minutes(project, limits),
        })
    return out


# ---- the transcript's view: how much context is in it ----------------------

def transcript_path(session_id):
    """The newest transcript for a session id, across every project dir."""
    if not PROJECTS.is_dir():
        return None
    hits = sorted(PROJECTS.glob(f"*/{session_id}.jsonl"), key=lambda p: p.stat().st_mtime)
    return hits[-1] if hits else None


def read_transcript(path):
    """What the transcript says about the main thread's context.

    The last assistant record that isn't a sidechain is the live prompt size;
    sidechain records are subagents, which carry their own separate context.
    """
    info = {
        "tokens": 0, "input": 0, "cache_read": 0, "cache_write": 0, "output_total": 0,
        "model": "", "records": 0, "sidechain_records": 0, "compactions": 0,
        "first": "", "last": "", "bytes": 0, "cwd": "", "turns": 0,
    }
    try:
        info["bytes"] = path.stat().st_size
    except OSError:
        return info
    last_usage = None
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    r = json.loads(line)
                except json.JSONDecodeError:
                    continue
                info["records"] += 1
                ts = r.get("timestamp")
                if ts:
                    info["first"] = info["first"] or ts
                    info["last"] = ts
                if r.get("cwd") and not info["cwd"]:
                    info["cwd"] = r["cwd"]
                # A compaction shows up as a boundary record or a summary marker.
                if r.get("isCompactSummary") or r.get("subtype") == "compact_boundary":
                    info["compactions"] += 1
                if r.get("isSidechain"):
                    info["sidechain_records"] += 1
                    continue
                if r.get("type") == "user":
                    info["turns"] += 1
                msg = r.get("message") or {}
                usage = msg.get("usage")
                if r.get("type") == "assistant" and isinstance(usage, dict):
                    last_usage = usage
                    info["model"] = msg.get("model") or info["model"]
                    info["output_total"] += usage.get("output_tokens", 0) or 0
    except OSError as exc:
        die(f"could not read {path}: {exc}")
    if last_usage:
        info["input"] = last_usage.get("input_tokens", 0) or 0
        info["cache_write"] = last_usage.get("cache_creation_input_tokens", 0) or 0
        info["cache_read"] = last_usage.get("cache_read_input_tokens", 0) or 0
        info["tokens"] = info["input"] + info["cache_write"] + info["cache_read"]
    return info


def window_for(model):
    """(window, exact?) — exact False means the model isn't in the table."""
    if not model:
        return DEFAULT_WINDOW, False
    if model in WINDOWS:
        return WINDOWS[model], True
    for name, size in WINDOWS.items():          # tolerate a dated suffix
        if model.startswith(name):
            return size, True
    return DEFAULT_WINDOW, False


def describe(session):
    """Merge the relay's row with its transcript. Returns a dict or None."""
    path = transcript_path(session["session_id"])
    if not path:
        return None
    info = read_transcript(path)
    window, exact = window_for(info["model"])
    row = dict(session)
    row.update(info)
    row["transcript"] = str(path)
    row["window"] = window
    row["window_exact"] = exact
    row["fraction"] = (info["tokens"] / window) if window else 0.0
    if session.get("at"):
        try:
            age = (now() - datetime.fromisoformat(session["at"])).total_seconds() / 60
        except ValueError:
            age = 0.0
        row["age_minutes"] = age
        row["expires_in_minutes"] = session["expiry_minutes"] - age
    else:
        row["age_minutes"] = 0.0
        row["expires_in_minutes"] = session["expiry_minutes"]
    return row


# ---- output ----------------------------------------------------------------

def print_row(r, verbose=False):
    pct = r["fraction"] * 100
    window = human_tokens(r["window"]) + ("" if r["window_exact"] else "?")
    expires = r["expires_in_minutes"]
    when = f"expires in {human_age(expires)}" if expires > 0 else "EXPIRED (next message starts fresh)"
    model = (r["model"] or "?").replace("claude-", "")
    print(f"{r['who']} · {r['project']}")
    print(f"  {bar(r['fraction'])}  {human_tokens(r['tokens'])} of {window}  ({pct:.1f}%)  {model}")
    print(f"  last used {human_age(r['age_minutes'])} ago · {when}")
    bits = [f"{r['turns']} messages", f"{r['records']} records", f"{r['bytes'] / 1e6:.1f} MB"]
    if r["sidechain_records"]:
        bits.append(f"{r['sidechain_records']} subagent records (own context)")
    bits.append(f"{r['compactions']} compactions" if r["compactions"] else "no compaction yet")
    print("  " + " · ".join(bits))
    if verbose:
        print(f"  cache read {human_tokens(r['cache_read'])} · cache write {human_tokens(r['cache_write'])} "
              f"· fresh input {human_tokens(r['input'])} · output so far {human_tokens(r['output_total'])}")
        print(f"  session {r['session_id']}")
        print(f"  {r['transcript']}")
    print()


def cmd_list(args):
    sessions = relay_sessions()
    if not sessions:
        die(f"no relay sessions found ({RELAY / 'state' / 'state.json'}). `ctx here` reads this directory instead.")
    rows = []
    for s in sessions:
        r = describe(s)
        if r:
            rows.append(r)
    if args.match:
        m = args.match.lower()
        rows = [r for r in rows if m in r["who"].lower() or m in r["project"].lower()
                or m in r["project_key"].lower() or r["session_id"].startswith(args.match)]
        if not rows:
            die(f"nothing matches {args.match!r}. `ctx` lists them all.")
    if args.live:
        rows = [r for r in rows if r["expires_in_minutes"] > 0]
    rows.sort(key=lambda r: r["expires_in_minutes"], reverse=True)
    if args.json:
        print(json.dumps(rows, indent=2))
        return
    if not rows:
        print("no sessions (every one has expired; the next message starts fresh)")
        return
    for r in rows:
        print_row(r, args.verbose)


def cmd_here(args):
    """The newest transcript for this working directory — what a terminal session wants."""
    slug = str(Path.cwd()).replace("/", "-")
    d = PROJECTS / slug
    if not d.is_dir():
        die(f"no transcripts for {Path.cwd()} ({d} does not exist)")
    files = sorted(d.glob("*.jsonl"), key=lambda p: p.stat().st_mtime)
    if not files:
        die(f"no transcripts in {d}")
    path = files[-1]
    info = read_transcript(path)
    window, exact = window_for(info["model"])
    row = dict(info)
    row.update({
        "who": "this directory", "project": Path.cwd().name, "project_key": "",
        "session_id": path.stem, "transcript": str(path), "window": window,
        "window_exact": exact, "fraction": (info["tokens"] / window) if window else 0.0,
        "age_minutes": (now().timestamp() - path.stat().st_mtime) / 60,
        "expires_in_minutes": float("inf"), "expiry_minutes": 0,
    })
    if args.json:
        row["expires_in_minutes"] = None
        print(json.dumps(row, indent=2))
        return
    pct = row["fraction"] * 100
    print(f"{path.stem[:8]} · {Path.cwd()}")
    print(f"  {bar(row['fraction'])}  {human_tokens(row['tokens'])} of "
          f"{human_tokens(window)}{'' if exact else '?'}  ({pct:.1f}%)  {(info['model'] or '?').replace('claude-', '')}")
    print(f"  {info['turns']} messages · {info['records']} records · {info['bytes'] / 1e6:.1f} MB · "
          + (f"{info['compactions']} compactions" if info["compactions"] else "no compaction yet"))
    if args.verbose:
        print(f"  {path}")


def cmd_doctor(args):
    ok = True

    def line(good, label, detail="", warn_only=False):
        nonlocal ok
        if not good and not warn_only:
            ok = False
        tag = "  ok  " if good else (" warn " if warn_only else " FAIL ")
        print(f"[{tag}] {label}")
        if detail:
            print(f"         {detail}")

    line(PROJECTS.is_dir(), f"transcripts at {PROJECTS}",
         "" if PROJECTS.is_dir() else "set CLAUDE_PROJECTS_DIR if Claude Code stores them elsewhere")
    n = len(list(PROJECTS.glob("*/*.jsonl"))) if PROJECTS.is_dir() else 0
    line(n > 0, f"{n} transcript files")
    state = RELAY / "state" / "state.json"
    line(state.exists(), f"relay state at {state}",
         "" if state.exists() else "set SMS_RELAY_DIR if the relay lives elsewhere; `ctx here` works without it")
    sessions = relay_sessions()
    line(True, f"{len(sessions)} relay sessions recorded")
    found = sum(1 for s in sessions if transcript_path(s["session_id"]))
    line(found == len(sessions) or not sessions,
         f"{found} of {len(sessions)} have a transcript on disk",
         "" if found == len(sessions) else "the missing ones are expired sessions whose transcripts were cleaned up; harmless",
         warn_only=True)
    models = {r["model"] for r in (describe(s) or {"model": ""} for s in sessions) if r.get("model")}
    unknown = [m for m in models if not window_for(m)[1]]
    line(not unknown, "every model's context window is known",
         "" if not unknown else f"not in the table, assuming {human_tokens(DEFAULT_WINDOW)}: {', '.join(unknown)}")
    sys.exit(0 if ok else 1)


def main():
    ap = argparse.ArgumentParser(prog="ctx", description=__doc__.split("\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("match", nargs="?", help="a sender name, a project, a session id, "
                                             "'here' for this directory, or 'doctor'")
    ap.add_argument("--json", action="store_true", help="machine-readable")
    ap.add_argument("-v", "--verbose", action="store_true", help="cache split, session id, transcript path")
    ap.add_argument("--live", action="store_true", help="only sessions that haven't expired")
    args = ap.parse_args()
    if args.match == "doctor":
        cmd_doctor(args)
    elif args.match == "here":
        cmd_here(args)
    else:
        cmd_list(args)


if __name__ == "__main__":
    main()
