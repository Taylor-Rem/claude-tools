#!/usr/bin/env python3
"""db — a client site's own database (Cloudflare D1), run from inside a client workspace.

A site that needs more than pages (a quote queue the owner reads on /admin,
a customer list, bookings) gets one D1 database, bound to that site's own
Pages project, by `site data <name>` (or `site new <name> --db`). This tool
is how Patch works with it. It only ever touches the database of a site in
*this* workspace: which one comes from the site registry
(~/.config/claude-tools/sites.json, written by `site`, outside any
workspace), never from an argument.

  db migrate [--dry-run]                 # apply repos/<site>/migrations/*.sql not yet applied, in order
  db query "SELECT …" [--json]           # read (SELECT / WITH / PRAGMA / EXPLAIN only)
  db exec "UPDATE …" [--yes] [--dry-run] # write; DROP, and DELETE with no WHERE, need --yes
  db export                              # every table -> exports/<date>/<table>.csv + .json (the handover)
  db import TABLE FILE.csv|FILE.json [--dry-run]
  db add COLLECTION [--no-migrate]       # a standard collection: migration + Function + /admin view
  db add NAME --from-sheet FILE [--sheet S] [--title T] [--singular S] [--statuses "a,b"] [--dry-run]
                                         # a web tool of the owner's own from a sheet's header row:
                                         # the migration, the /admin view, registered, migrated, rows imported
  db collections                         # what can be added, what this site has
  db tools                               # every list /admin shows: collection, named list or web tool
  db doctor                              # token, binding, migrations applied, secrets, /admin wiring

The customer book (`db add customers`, ROADMAP B122; --json on each for a machine):
  db customers find PHONE|EMAIL|NAME     # who is 801-555-0134; "the Smiths" finds Smith
  db customers show ID|PHONE|NAME        # one customer and their jobs
  db customers add NAME [--phone --email --address --notes --tags --seen DATE]
  db customers set ID [--phone … --add-tag weekly --contact stop]
  db customers lapsed [--days 90]        # who haven't I seen in 90 days
  db customers import FILE.csv|.xlsx [--dry-run] | --from-records
  db customers export                    # customers + jobs -> exports/<date>/
  db jobs add CUSTOMER "what" [--date --amount 450 --status booked|done|cancelled --source S --ref R --create]
  db jobs done JOB_ID|CUSTOMER [--amount]   db jobs set ID [--status …]   db jobs ls [CUSTOMER]

The ledger, receipts by photo (`db add ledger`, ROADMAP B124; --json on add, ls, set):
  db ledger add VENDOR AMOUNT [--date --category --note --photo incoming/x.jpg] [--yes over $10,000]   # keeps the photo in receipts/
  db ledger ls [--month september|2026-09|last] [--search truck] [--vendor --category --days]   # rows + the total
  db ledger set ID [--date --vendor --amount --category --note --photo]   db ledger rm ID
  db ledger export                       # ledger.csv/.json + receipts.zip (plain `db export` zips them too)
Bookings that finish the job (`db add bookings`, ROADMAP B119):
  db bookings setup                      # the booking key + the calendar feed key (Pages secrets), then site publish
  db bookings feed [--new]               # the owner's calendar subscribe address, and how to add it
  db bookings upgrade [--dry-run]        # an older site's bookings Functions brought up to the toolbelt's
  db bookings status                     # what's on (never the keys)
  db bookings confirm ID                 # by text: confirm it on the site, the customer emailed
  db bookings move ID "2026-10-14T15:00" # to that open time, capacity checked, the customer emailed
  db bookings cancel ID                  # the place freed, the customer emailed
  db bookings remind ID                  # a confirmed one ahead: the reminder email (B120's morning run)

Every command takes --site NAME when the workspace has more than one site
with a database, and --local to work on the local copy `wrangler pages dev`
uses (repos/<site>/.wrangler/, for trying a change before it goes live).
Collections live in claude-tools/templates/collections/<name>/ (a README
each); PLAYBOOK.md § Data is when to use which. A web tool (ROADMAP B40) is
the same three parts built for one owner — a table, an /admin view, a
public Function only when the public writes to it — in the client's own
repo; the worked examples are claude-tools/templates/tools/<name>/ and
PLAYBOOK.md § Web tools is the checklist.

`--from-sheet` (a CSV, or an .xlsx/.xls read the way `doc text` reads it)
guesses each column's type from the rows: whole numbers, numbers, dates
(YYYY-MM-DD), money (a price/cost/amount/total header over numbers, kept in
cents as <name>_cents), else text; the owner's headers are the labels. It
adds the house columns status, notes, created_at, updated_at, and a
"below reorder" shortcut when it sees an on-hand count beside a reorder
level. `--dry-run` prints the header mapping and the files and writes
nothing: say the mapping back to the owner first.

Migrations are recorded in `d1_migrations`, the table wrangler's own
`d1 migrations apply` uses, so whoever takes the repo over can keep going
with plain wrangler.

Config, by name, never printed:
  CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID   ~/.config/claude-tools/env (Account: D1 Edit)
  DB_WRANGLER   tests only: a stand-in for wrangler
"""

import argparse
import csv
import datetime
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
import urllib.error
import urllib.request
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import tenant  # noqa: E402  (shared tenant-identity check, B80)

HERE = Path(__file__).resolve().parent.parent
ENV_FILE = Path(os.environ.get("CLAUDE_TOOLS_ENV", Path.home() / ".config/claude-tools/env"))
REGISTRY = ENV_FILE.parent / "sites.json"
COLLECTIONS = HERE / "templates" / "collections"
TOOLS = HERE / "templates" / "tools"                 # worked examples of web tools (B40), not addable
DOC_BIN = HERE / "bin" / "doc"
WRANGLER = Path(os.environ.get("DB_WRANGLER") or HERE / "node_modules" / ".bin" / "wrangler")
FAKE = bool(os.environ.get("DB_WRANGLER"))
CF_API = "https://api.cloudflare.com/client/v4"
SYSTEM_TABLES = ("d1_migrations", "admin_tokens", "admin_sessions")   # infrastructure, not the owner's data
READ_START = ("select", "with", "pragma", "explain")
WRITE_WORDS = re.compile(r"\b(insert|update|delete|drop|alter|create|replace|attach|detach|vacuum|reindex)\b", re.I)
MIGRATIONS_TABLE = ("CREATE TABLE IF NOT EXISTS d1_migrations(id INTEGER PRIMARY KEY AUTOINCREMENT, "
                    "name TEXT UNIQUE, applied_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL);")


def die(msg, code=1):
    print(f"db: {msg}", file=sys.stderr)
    sys.exit(code)


def say(msg=""):
    print(msg, flush=True)


def read_env():
    keys = {}
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                keys[k.strip()] = v.strip()
    return keys


def cf_creds():
    env = read_env()
    return (os.environ.get("CLOUDFLARE_API_TOKEN") or env.get("CLOUDFLARE_API_TOKEN"),
            os.environ.get("CLOUDFLARE_ACCOUNT_ID") or env.get("CLOUDFLARE_ACCOUNT_ID"))


def cf_get(path):
    """GET on the account; (status, result or error text). Never raises."""
    tok, acct = cf_creds()
    if not (tok and acct):
        return 0, "CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID are not in the toolbelt"
    req = urllib.request.Request(f"{CF_API}/accounts/{acct}{path}", headers={
        "Authorization": f"Bearer {tok}", "User-Agent": "claude-tools db"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return r.status, json.loads(r.read().decode()).get("result")
    except urllib.error.HTTPError as exc:
        try:
            errs = json.loads(exc.read().decode()).get("errors", [])
            return exc.code, "; ".join(str(e.get("message")) for e in errs) or f"HTTP {exc.code}"
        except ValueError:
            return exc.code, f"HTTP {exc.code}"
    except (urllib.error.URLError, OSError) as exc:
        return 0, str(exc)


# ---------------------------------------------------------------- where we are

class Site:
    """The one site (and so the one database) this command works on."""

    def __init__(self, ws, meta, name, row):
        self.ws, self.meta, self.name, self.row = ws, meta, name, row
        self.repo = ws / "repos" / name
        self.d1 = row.get("d1") or {}
        self.db_name = self.d1.get("name")
        self.project = row.get("project")


def workspace():
    ws = Path.cwd()
    p = ws / ".client.json"
    if not p.exists():
        die("not in a client workspace (no .client.json here). Run this from ~/projects/clients/<slug>.")
    try:
        meta = json.loads(p.read_text())
    except ValueError as exc:
        die(f".client.json is not valid JSON: {exc}")
    if not meta.get("slug"):
        die(".client.json has no slug")
    tenant.enforce(meta["slug"], die)
    return ws, meta


def registry():
    try:
        return json.loads(REGISTRY.read_text()) if REGISTRY.exists() else {}
    except ValueError:
        die(f"{REGISTRY} is not valid JSON")


def the_site(a, need=True):
    ws, meta = workspace()
    mine = registry().get(meta["slug"], {})
    with_db = {n: r for n, r in mine.items() if (r.get("d1") or {}).get("name")}
    if a.site:
        if a.site not in mine:
            die(f"{a.site!r} isn't one of this workspace's sites ({', '.join(sorted(mine)) or 'none'})")
        if a.site not in with_db:
            die(f"{a.site} has no database yet: `site data {a.site}` adds one (PLAYBOOK.md § Data)")
        name = a.site
    elif not with_db:
        if not need:
            return None
        die("no site in this workspace has a database yet. A form alone doesn't need one; a list the "
            "owner reads, a queue, a catalog does: `site data <site>` (PLAYBOOK.md § Data).")
    elif len(with_db) > 1:
        die(f"more than one site here has a database ({', '.join(sorted(with_db))}); say which with --site NAME")
    else:
        name = next(iter(with_db))
    s = Site(ws, meta, name, with_db[name])
    if not (s.repo / ".git").exists():
        die(f"repos/{name} is not here (the registry has it; clone it back or ask Taylor)")
    return s


# ---------------------------------------------------------------- wrangler d1

def wrangler_env(local=False):
    env = dict(os.environ)
    if not FAKE and not local:
        tok, acct = cf_creds()
        if not (tok and acct):
            die("CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID are not in the toolbelt (Taylor: setenv.sh)")
        env.update({"CLOUDFLARE_API_TOKEN": tok, "CLOUDFLARE_ACCOUNT_ID": acct})
    env.update({"WRANGLER_SEND_METRICS": "false", "CI": "1", "NO_COLOR": "1"})
    return env


def d1(site, local, *, command=None, file=None):
    """Run SQL on the site's database; the list of per-statement results."""
    if not WRANGLER.exists():
        die(f"wrangler is not installed at {WRANGLER} (claude-tools/install.sh)")
    args = [str(WRANGLER), "d1", "execute", site.db_name, "--local" if local else "--remote", "--json", "--yes"]
    # --command=… in one word: SQL that starts with a `--` comment would otherwise be read as flags
    args += [f"--command={command}"] if command is not None else [f"--file={file}"]
    r = subprocess.run(args, capture_output=True, text=True, env=wrangler_env(local), cwd=str(site.repo))
    if r.returncode != 0:
        msg = (r.stderr.strip() or r.stdout.strip()).splitlines()
        text = "\n".join(line for line in msg if line.strip())[-800:]
        if "Authentication error" in text or "10000" in text:
            die("Cloudflare refused the D1 call: the toolbelt token has no D1 permission "
                "(TAYLOR-TODO §1 \"Give the Cloudflare token D1\")")
        die(f"the database refused it:\n{text}")
    try:
        out = json.loads(r.stdout)
    except ValueError:
        die(f"wrangler said something that isn't JSON:\n{r.stdout[-500:]}")
    return out if isinstance(out, list) else [out]


def rows_of(results):
    rows = []
    for res in results:
        rows.extend(res.get("results") or [])
    return rows


def run_sql(site, local, sql):
    """Many statements in one wrangler call: as --command (one batch), or through a
    file when it's too long for a command line."""
    if len(sql) < 100_000:
        return d1(site, local, command=sql)
    with tempfile.NamedTemporaryFile("w", suffix=".sql", delete=False) as f:
        f.write(sql)
        path = f.name
    try:
        return d1(site, local, file=path)
    finally:
        os.unlink(path)


def lit(v):
    if v is None:
        return "NULL"
    if isinstance(v, bool):
        return "1" if v else "0"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, (dict, list)):
        v = json.dumps(v)
    return "'" + str(v).replace("'", "''") + "'"


def ident(name):
    if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", name or ""):
        die(f"{name!r} isn't a plain table or column name")
    return name


def split_statements(sql):
    """Statements in a string, split on ; outside quotes, `--` comments dropped
    (a comment may hold an apostrophe or a semicolon; D1 refuses a statement
    that is only a comment)."""
    out, cur, q = [], [], None
    sql = re.sub(r"(?m)^\s*--[^\n]*$", "", sql)             # whole-line comments
    i = 0
    while i < len(sql):
        ch = sql[i]
        i += 1
        if not q and ch == "-" and sql[i:i + 1] == "-":        # a comment at the end of a line
            j = sql.find("\n", i)
            i = len(sql) if j < 0 else j
            continue
        if q:
            cur.append(ch)
            if ch == q:
                q = None
        elif ch in "'\"`":
            q = ch
            cur.append(ch)
        elif ch == ";":
            out.append("".join(cur).strip())
            cur = []
        else:
            cur.append(ch)
    out.append("".join(cur).strip())
    return [s for s in out if s]


def strip_strings(sql):
    return re.sub(r"'(?:[^']|'')*'", "''", sql)


# ---------------------------------------------------------------- migrations

def repo_migrations(site):
    d = site.repo / "migrations"
    return sorted(p for p in d.glob("*.sql")) if d.is_dir() else []


def applied(site, local, create):
    if create:
        d1(site, local, command=MIGRATIONS_TABLE)
        return [r["name"] for r in rows_of(d1(site, local, command="SELECT name FROM d1_migrations ORDER BY id"))]
    tables = rows_of(d1(site, local, command="SELECT name FROM sqlite_master WHERE type='table' AND name='d1_migrations'"))
    if not tables:
        return []
    return [r["name"] for r in rows_of(d1(site, local, command="SELECT name FROM d1_migrations ORDER BY id"))]


def cmd_migrate(a):
    site = the_site(a)
    files = repo_migrations(site)
    if not files:
        die(f"repos/{site.name}/migrations/ has no .sql files (site data {site.name} puts the first one there)")
    done = set(applied(site, a.local, create=not a.dry_run))
    todo = [p for p in files if p.name not in done]
    where = "local copy" if a.local else f"D1 {site.db_name}"
    if not todo:
        say(f"{where}: all {len(files)} migration(s) applied")
        return
    for p in todo:
        sql = p.read_text().rstrip() + f"\nINSERT INTO d1_migrations (name) VALUES ({lit(p.name)});\n"
        if a.dry_run:
            say(f"-- would apply {p.name} to {where}\n{sql}")
            continue
        run_sql(site, a.local, sql)
        say(f"applied {p.name} to {where}")
    if a.dry_run:
        say(f"dry run: {len(todo)} to apply, nothing changed")


# ---------------------------------------------------------------- read / write

def print_rows(rows):
    if not rows:
        say("(no rows)")
        return
    cols = list(rows[0].keys())
    cell = lambda v: "" if v is None else str(v).replace("\n", " ")
    width = {c: min(40, max(len(c), *(len(cell(r.get(c))) for r in rows))) for c in cols}
    say("  ".join(c.ljust(width[c]) for c in cols))
    for r in rows:
        say("  ".join(cell(r.get(c))[:40].ljust(width[c]) for c in cols))
    say(f"({len(rows)} row{'s' if len(rows) != 1 else ''})")


def cmd_query(a):
    stmts = split_statements(a.sql)
    if len(stmts) != 1:
        die("one statement at a time")
    s = stmts[0]
    if not s.lower().startswith(READ_START) or WRITE_WORDS.search(strip_strings(s)):
        die("db query only reads (SELECT / WITH / PRAGMA / EXPLAIN); a change is `db exec`")
    site = the_site(a)
    rows = rows_of(d1(site, a.local, command=s))
    if a.json:
        say(json.dumps(rows, indent=2))
    else:
        print_rows(rows)


def dangerous(stmt):
    s = strip_strings(stmt).lower()
    if re.match(r"\s*drop\b", s):
        return "it drops something"
    if re.match(r"\s*delete\s+from\s+\S+\s*$", s):
        return "it deletes every row (no WHERE)"
    if re.search(r"\bd1_migrations\b", s):
        return "it touches d1_migrations (the record of what's applied)"
    if re.match(r"\s*alter\s+table\s+\S+\s+drop\b", s):
        return "it drops a column"
    return None


def cmd_exec(a):
    stmts = split_statements(a.sql)
    if not stmts:
        die("nothing to run")
    risky = [(s, why) for s in stmts if (why := dangerous(s))]
    if risky and not a.yes:
        die("refused: " + "; ".join(f"{why} ({s[:60]})" for s, why in risky)
            + ". If the owner asked for exactly that, run it again with --yes. Export first (db export).")
    site = the_site(a)
    sql = ";\n".join(stmts) + ";\n"
    if a.dry_run:
        say(f"-- would run on {'the local copy' if a.local else 'D1 ' + site.db_name}\n{sql}")
        return
    res = run_sql(site, a.local, sql)
    counted = [r["meta"]["changes"] for r in res if "changes" in (r.get("meta") or {})]   # the local copy doesn't count
    rows = rows_of(res)
    if rows:
        print_rows(rows)
    n = sum(int(c or 0) for c in counted)
    say(f"ok: {len(stmts)} statement{'s' if len(stmts) != 1 else ''}"
        + (f", {n} row{'s' if n != 1 else ''} changed" if counted else ""))


# ---------------------------------------------------------------- export / import

def tables(site, local):
    names = [r["name"] for r in rows_of(d1(site, local, command=(
        "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' "
        "AND name NOT LIKE '_cf_%' ORDER BY name")))]
    return [n for n in names if n not in SYSTEM_TABLES]


def columns(site, local, table):
    return [r["name"] for r in rows_of(d1(site, local, command=f"PRAGMA table_info({ident(table)})"))]


# Run after `db export` writes its tables: hook(site, out_dir, table_names). A collection
# with files beside its rows (the ledger's receipt photos, B124) adds one in its own block.
EXPORT_HOOKS = []


def cmd_export(a, only=None):
    site = the_site(a)
    day = datetime.date.today().isoformat()
    out = site.ws / "exports" / day
    out.mkdir(parents=True, exist_ok=True)
    names = [t for t in tables(site, a.local) if not only or t in only]
    if not names:
        say("the database has no tables yet (db add <collection>)")
        return
    for t in names:
        cols = columns(site, a.local, t)
        rows, offset = [], 0
        while True:
            page = rows_of(d1(site, a.local, command=f"SELECT * FROM {ident(t)} ORDER BY rowid LIMIT 1000 OFFSET {offset}"))
            rows.extend(page)
            if len(page) < 1000:
                break
            offset += 1000
        with open(out / f"{t}.csv", "w", newline="") as f:
            w = csv.DictWriter(f, fieldnames=cols, extrasaction="ignore")
            w.writeheader()
            w.writerows(rows)
        # The same columns as the CSV: PRAGMA table_info leaves out generated ones (the ledger's
        # `month`), which `SELECT *` returns but `db import` can't write back.
        rows = [{c: r.get(c) for c in cols} for r in rows]
        (out / f"{t}.json").write_text(json.dumps(rows, indent=2, ensure_ascii=False) + "\n")
        say(f"  {t}: {len(rows)} row{'s' if len(rows) != 1 else ''} -> exports/{day}/{t}.csv, .json")
    for hook in EXPORT_HOOKS:
        hook(site, out, names)
    say(f"exported {len(names)} table{'s' if len(names) != 1 else ''} to exports/{day}/ "
        + (f"(left out: {', '.join(SYSTEM_TABLES)}, the sign-in and migration bookkeeping)" if not only else ""))


def cmd_import(a):
    path = Path(a.file)
    if not path.is_file() or path.resolve().is_relative_to(Path.home() / ".config"):
        die(f"no such file: {a.file}")
    if path.suffix.lower() == ".json":
        data = json.loads(path.read_text())
        if not isinstance(data, list) or not all(isinstance(r, dict) for r in data):
            die("a JSON import is a list of objects, one per row")
    elif path.suffix.lower() == ".csv":
        data = list(csv.DictReader(io.StringIO(path.read_text())))
    else:
        die("import takes a .csv (with a header row) or a .json file")
    if not data:
        die("the file has no rows")
    if a.table == "customers":
        die("customers go in with `db customers import FILE` (it matches phones and emails to the ones "
            "already there, reads the owner's own headers, and keeps the phone searchable)")
    site = the_site(a)
    table = ident(a.table)
    have = columns(site, a.local, table)
    if not have:
        die(f"no table {table} in the database (db query \"SELECT name FROM sqlite_master\")")
    if table in SYSTEM_TABLES:
        die(f"{table} is the sign-in machinery, not something to import into")
    cols = [c for c in data[0].keys()]
    extra = [c for c in cols if c not in have]
    if extra:
        die(f"{table} has no column(s) {', '.join(extra)} (it has {', '.join(have)})")
    stmts = [f"INSERT INTO {table} ({', '.join(ident(c) for c in cols)}) VALUES "
             f"({', '.join(lit(r.get(c) if r.get(c) != '' else None) for c in cols)});" for r in data]
    if a.dry_run:
        say("\n".join(stmts[:5]) + (f"\n-- … {len(stmts) - 5} more" if len(stmts) > 5 else ""))
        say(f"dry run: {len(stmts)} row(s) into {table}, nothing changed")
        return
    for i in range(0, len(stmts), 500):
        run_sql(site, a.local, "\n".join(stmts[i:i + 500]) + "\n")
    say(f"imported {len(stmts)} row{'s' if len(stmts) != 1 else ''} into {table}")


# ---------------------------------------------------------------- collections

REGISTRY_JS = """// The lists /admin shows, one view file per collection in this folder.
// `db add <collection>` writes this file; edit a view's title or columns in
// its own file, not here. A second list on the same table (customers and
// jobs on `records`) is a copy of the view with a `filter`, imported here.
{imports}
export default {{ {names} }};
"""


def collection_info(name):
    d = COLLECTIONS / name
    if not re.match(r"^[a-z][a-z0-9-]*$", name) or not (d / "collection.json").exists():
        return None
    info = json.loads((d / "collection.json").read_text())
    info["dir"] = d
    return info


def registered_views(repo):
    p = repo / "functions" / "_admin" / "collections.js"
    if not p.exists():
        return []
    return re.findall(r'import\s+([A-Za-z_]\w*)\s+from\s+"\./([\w-]+)\.js";', p.read_text())


def write_views(repo, views):
    imports = "\n".join(f'import {var} from "./{mod}.js";' for var, mod in views)
    (repo / "functions" / "_admin" / "collections.js").write_text(
        REGISTRY_JS.format(imports=imports, names=", ".join(var for var, _ in views)))


def cmd_collections(a):
    site = the_site(a, need=False)
    have = {mod for _, mod in registered_views(site.repo)} if site else set()
    migs = " ".join(p.name for p in repo_migrations(site)) if site else ""
    for d in sorted(COLLECTIONS.iterdir()):
        info = collection_info(d.name)
        if not info:
            continue
        mark = "added" if d.name in have or f"_{d.name}.sql" in migs else ("" if info["status"] == "ready" else "scaffold")
        say(f"{d.name:<12} {mark:<9} {info['summary']}")
    if not site:
        say("\n(no site here has a database yet: site data <site>)")


def cmd_add(a):
    if a.from_sheet:
        return cmd_add_sheet(a)
    info = collection_info(a.collection)
    if not info:
        die(f"no collection {a.collection!r} (db collections lists them)")
    if info["status"] != "ready":
        die(f"{a.collection} is a scaffold, not built yet ({info['summary']}). Don't offer it; "
            f"PLAYBOOK.md § Data says what to tell the client.")
    site = the_site(a)
    repo, src = site.repo, info["dir"]
    if not (repo / "functions" / "_lib" / "core.js").exists():
        die(f"repos/{site.name} has no functions/_lib/core.js: run `site data {site.name}` first")
    added = []
    # the migration(s), numbered after what's there
    existing = repo_migrations(site)
    ours = {m.name.split("_", 1)[-1] for m in (src / "migrations").glob("*.sql")}
    mine = {t.lower() for m in (src / "migrations").glob("*.sql")
            for t in re.findall(r"(?i)create\s+table\s+(?:if\s+not\s+exists\s+)?(\w+)", m.read_text())}
    for p in existing:
        if p.name.split("_", 1)[-1] in ours:
            continue
        clash = mine & {t.lower() for t in re.findall(r"(?i)create\s+table\s+(?:if\s+not\s+exists\s+)?(\w+)", p.read_text())}
        if clash:
            die(f"repos/{site.name}/migrations/{p.name} already makes a {', '.join(sorted(clash))} table of this site's own "
                f"(a web tool), and {a.collection} needs that name. Nothing written. Tell the owner, and FORWARD-TO-TAYLOR "
                f"if they want both: the tool's table needs renaming by hand first.")
    if any(p.name.split("_", 1)[-1] == m.name.split("_", 1)[-1] for p in existing for m in (src / "migrations").glob("*.sql")):
        say(f"  migration for {a.collection} already in repos/{site.name}/migrations/")
    else:
        n = max([int(m.group(1)) for p in existing if (m := re.match(r"^(\d+)_", p.name))] or [0])
        for m in sorted((src / "migrations").glob("*.sql")):
            n += 1
            dest = repo / "migrations" / f"{n:04d}_{m.name.split('_', 1)[-1]}"
            if not a.dry_run:
                dest.parent.mkdir(exist_ok=True)
                shutil.copy(m, dest)
            added.append(str(dest.relative_to(site.ws)))
    # the Function(s) and the view
    fsrc = src / "functions"
    if fsrc.is_dir():
        for f in sorted(fsrc.rglob("*")):
            if not f.is_file():
                continue
            dest = repo / "functions" / f.relative_to(fsrc)
            if dest.exists():
                was, now_ = view_table(dest), view_table(f)
                if dest.parent.name == "_admin" and was and now_ and was != now_:
                    # a named list of the same name on another table (customers on records): the
                    # collection's own view takes its place; the old rows stay where they were
                    if not a.dry_run:
                        shutil.copy(f, dest)
                    added.append(f"{dest.relative_to(site.ws)} (replaced: it was a list on {was}; those rows are still in {was})")
                    continue
                say(f"  kept {dest.relative_to(site.ws)} (already there)")
                continue
            if not a.dry_run:
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy(f, dest)
            added.append(str(dest.relative_to(site.ws)))
    # wire the view(s) into /admin: the collection's own first, then any others it ships (bookings: slots)
    mods = sorted((p.stem for p in (fsrc / "_admin").glob("*.js")), key=lambda m: (m != a.collection, m)) \
        if (fsrc / "_admin").is_dir() else []
    views = registered_views(repo)
    new = [(re.sub(r"\W", "_", m), m) for m in mods if m not in {mod for _, mod in views}]
    if new:
        if not a.dry_run:
            write_views(repo, views + new)
        added.append(f"repos/{site.name}/functions/_admin/collections.js (+{', '.join(m for _, m in new)})")
    say(("would add" if a.dry_run else "added") + f" {a.collection} to repos/{site.name}:")
    for x in added:
        say(f"  {x}")
    if a.dry_run:
        say("dry run: nothing written")
        return
    if not a.no_migrate:
        cmd_migrate(argparse.Namespace(site=site.name, local=a.local, dry_run=False))
    form = next((src / f for f in ("form.html", "booking.html", "shop.html") if (src / f).exists()), src / "form.html")
    say(f"\nnext: {src.name}'s README is the rest ({src / 'README.md'}); in short: "
        + ("put the block below on the page, " if form.exists() else "")
        + f"commit, `git -C repos/{site.name} push`, `site publish {site.name}`, then prove it on the live site.")
    if form.exists():
        say("\n" + form.read_text())


# ---------------------------------------------------------------- web tools (B40)

HOUSE = ("status", "notes", "created_at", "updated_at")
MONEY_WORDS = re.compile(r"price|cost|amount|total|fee|paid|value|\$", re.I)
SUM_WORDS = re.compile(r"total|amount|paid|value", re.I)
COUNT_WORDS = re.compile(r"on.?hand|in.?stock|qty|quantity|stock|count", re.I)
LEVEL_WORDS = re.compile(r"reorder|par\b|minimum|min\b|low", re.I)
NUM = re.compile(r"^-?\d+(\.\d+)?$")
INT = re.compile(r"^-?\d+$")
DAY = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def load_doc():
    from importlib.machinery import SourceFileLoader
    import importlib.util
    loader = SourceFileLoader("doc_tool", str(DOC_BIN))
    spec = importlib.util.spec_from_loader("doc_tool", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def read_sheet(path, sheet=None):
    """(sheet name, other sheet names, header, rows) from a CSV or a spreadsheet."""
    if not path.is_file():
        die(f"no such file: {path}")
    if path.suffix.lower() == ".csv":
        raw = path.read_bytes()
        try:
            text = raw.decode("utf-8-sig")
        except UnicodeDecodeError:
            text = raw.decode("cp1252", errors="replace")
        name, others, rows = path.stem, [], list(csv.reader(io.StringIO(text)))
    else:
        doc = load_doc()
        kind = doc.kind_of(path)
        if kind not in ("xlsx", "xls"):
            die(f"--from-sheet takes a CSV or an Excel file (.xlsx, .xls); {path.name} isn't one")
        sheets = [(n, r) for n, r in doc.sheets_of(path, kind) if r]
        if not sheets:
            die(f"{path.name} has no rows in any sheet")
        pick = [x for x in sheets if sheet and x[0].lower() == sheet.lower()] if sheet else sheets[:1]
        if not pick:
            die(f"no sheet {sheet!r} in {path.name}; it has: {', '.join(n for n, _ in sheets)}")
        name, rows = pick[0]
        others = [n for n, _ in sheets if n != name]
    rows = [[str(c).strip() for c in r] for r in rows]
    rows = [r for r in rows if any(r)]
    if len(rows) < 2:
        die(f"sheet {name!r} needs a header row and at least one row under it")
    header, body = rows[0], rows[1:]
    while header and not header[-1]:
        header.pop()
    body = [(r + [""] * len(header))[:len(header)] for r in body]
    return name, others, header, body


def column_name(label, taken):
    c = re.sub(r"[^a-z0-9]+", "_", label.lower()).strip("_") or "column"
    if c[0].isdigit():
        c = "c_" + c
    if c in ("id", "created_at", "updated_at", "rowid"):
        c += "_ref"
    base, n = c, 2
    while c in taken:
        c, n = f"{base}_{n}", n + 1
    taken.add(c)
    return c


def sheet_columns(header, body):
    """[{label, name, kind, sql}] per header cell: kind is text/whole/number/date/money/status/notes."""
    cols, taken = [], set()
    for i, label in enumerate(header):
        label = label or f"Column {i + 1}"
        vals = [r[i].replace(",", "") for r in body if r[i]]
        low = re.sub(r"[^a-z]", "", label.lower())
        if low in ("status", "notes"):
            kind = low
        elif vals and all(NUM.match(v.lstrip("$")) for v in vals) and MONEY_WORDS.search(label):
            kind = "money"
        elif vals and all(INT.match(v) for v in vals):
            kind = "whole"
        elif vals and all(NUM.match(v) for v in vals):
            kind = "number"
        elif vals and all(DAY.match(v) for v in vals):
            kind = "date"
        else:
            kind = "text"
        if kind in ("status", "notes"):
            name = low
            taken.add(name)
        else:
            name = column_name(label, taken | set(HOUSE))
            if kind == "money" and not name.endswith("_cents"):
                taken.discard(name)
                name = column_name(name + "_cents", taken | set(HOUSE))
        cols.append({"label": label, "name": name, "kind": kind,
                     "sql": {"whole": "INTEGER", "money": "INTEGER", "number": "REAL"}.get(kind, "TEXT")})
    return cols


def cell_value(col, v):
    v = v.strip()
    if v == "":
        return None
    if col["kind"] == "money":
        return int(round(float(v.replace(",", "").lstrip("$")) * 100))
    if col["kind"] == "whole":
        return int(v.replace(",", ""))
    if col["kind"] == "number":
        return float(v.replace(",", ""))
    return v


KIND_WORDS = {"text": "text", "whole": "whole number", "number": "number", "date": "date",
              "money": "money, kept in cents: 4.50 -> 450", "status": "the status", "notes": "the notes"}


def tool_files(table, title, singular, cols, statuses, sheet_label):
    """(migration SQL, descriptor JS, shortcut or None) for a web tool made from a sheet."""
    lines = [f"  {c['name']} {c['sql']}{' NOT NULL' if i == 0 else ''}," for i, c in enumerate(cols) if c["kind"] not in ("status", "notes")]
    mig = (f"-- {table}: the owner's {title.lower()}, made by `db add {table} --from-sheet` from {sheet_label}.\n"
           f"-- The owner's own columns first, then the house columns every list has.\n"
           f"CREATE TABLE IF NOT EXISTS {table} (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n" + "\n".join(lines) + "\n"
           f"  status TEXT NOT NULL DEFAULT {lit(statuses[0])},\n  notes TEXT,\n"
           "  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),\n  updated_at TEXT\n);\n")
    own = [c for c in cols if c["kind"] not in ("status", "notes")]
    count = next((c for c in own if c["kind"] in ("whole", "number") and COUNT_WORDS.search(c["label"])), None)
    level = next((c for c in own if c["kind"] in ("whole", "number") and LEVEL_WORDS.search(c["label"]) and c is not count), None)
    cut = ("below reorder", f"{count['name']} < {level['name']}") if count and level else None
    q = lambda x: json.dumps(x, ensure_ascii=False)
    typ = {"whole": "number", "number": "number", "money": "number", "date": "date"}
    field = lambda c, req=False: ("{ name: " + q(c["name"]) + ", label: " + q(c["label"] + (" (cents: 450 = $4.50)" if c["kind"] == "money" else ""))
                                  + (", type: " + q(typ[c["kind"]]) if c["kind"] in typ else "") + (", required: true" if req else "") + " },")
    shown = own[:5]
    js = [f"// {title}: made by `db add {table} --from-sheet` from {sheet_label}. Change the title, the",
          "// columns shown or the statuses here; the /admin shell does the rest (search, totals, CSV).",
          "export default {",
          f"  table: {q(table)},", f"  title: {q(title)},", f"  singular: {q(singular)},",
          "  list: [" + ", ".join(f"[{q(c['name'])}, {q(c['label'])}]" for c in shown) + ', ["status", "Status"]],',
          f"  statuses: {q(statuses)},",
          f"  order: [{q(own[0]['name'])}, \"asc\"],"]
    sums = [c["name"] for c in own if c["kind"] == "money" and SUM_WORDS.search(c["label"])]
    if sums:
        js.append(f"  sum: {q(sums)},")
    if cut:
        js.append(f"  shortcuts: [[{q(cut[0])}, {q(cut[1])}]],")
    # the edit form: the status, the numbers and dates the owner keeps changing, the notes
    # (a name alone reuses the create field; the text columns stay in create)
    edits = ["status"] + [c["name"] for c in own if c["kind"] in ("whole", "number", "money", "date")] + ["notes"]
    js += ["  create: ["] + [f"    {field(c, i == 0)}" for i, c in enumerate(own)] + ["  ],",
           f"  edit: {q(edits)},", '  touch: "updated_at",', "};", ""]
    return mig, "\n".join(js), cut


def cmd_add_sheet(a):
    table = a.collection
    if not re.match(r"^[a-z][a-z0-9_]{0,40}$", table):
        die(f"{table!r}: a web tool's name is its table's, lower case (stock, routes, jobs_log)")
    if collection_info(table):
        die(f"{table} is a standard collection: `db add {table}` (no --from-sheet)")
    if table in SYSTEM_TABLES or table.startswith(("sqlite", "_cf", "d1_")):
        die(f"{table} is taken by the sign-in and migration bookkeeping; pick another name")
    path = Path(a.from_sheet)
    if path.resolve().is_relative_to(Path.home() / ".config"):
        die(f"no such file: {a.from_sheet}")
    name, others, header, body = read_sheet(path, a.sheet)
    cols = sheet_columns(header, body)
    given = [x.strip() for x in (a.statuses or "").split(",") if x.strip()]
    st_col = next((c for c in cols if c["kind"] == "status"), None)
    found = list(dict.fromkeys(r[cols.index(st_col)] for r in body if r[cols.index(st_col)])) if st_col else []
    statuses = given or (found[:8] if found else ["active", "archived"])
    title = a.title or table.replace("_", " ").capitalize()
    singular = a.singular or (table[:-1] if table.endswith("s") and not table.endswith("ss") else table).replace("_", " ")
    label = f"{path.name}" + (f", sheet {name}" if path.suffix.lower() != ".csv" else "")
    mig, js, cut = tool_files(table, title, singular, cols, statuses, label)

    site = the_site(a)
    repo = site.repo
    if not (repo / "functions" / "_lib" / "core.js").exists():
        die(f"repos/{site.name} has no functions/_lib/core.js: run `site data {site.name}` first")
    existing = repo_migrations(site)
    if any(p.name.split("_", 1)[-1] == f"{table}.sql" for p in existing) or (repo / "functions" / "_admin" / f"{table}.js").exists():
        die(f"repos/{site.name} already has a {table} table or view; pick another name, or change that one by hand")
    n = max([int(m.group(1)) for p in existing if (m := re.match(r"^(\d+)_", p.name))] or [0]) + 1
    mig_path = repo / "migrations" / f"{n:04d}_{table}.sql"
    view_path = repo / "functions" / "_admin" / f"{table}.js"

    say(f"{label}: {len(body)} row{'s' if len(body) != 1 else ''}, {len(header)} column{'s' if len(header) != 1 else ''}"
        + (f" (other sheets, not used: {', '.join(others)})" if others else ""))
    w = max(len(c["label"]) for c in cols)
    for c in cols:
        say(f"  {c['label'].ljust(w)}  ->  {c['name']} ({KIND_WORDS[c['kind']]})")
    say(f"  + {'status (' + ' / '.join(statuses) + ')' if not st_col else ''}{', ' if not st_col else ''}"
        + ("notes, " if not any(c["kind"] == "notes" for c in cols) else "") + "created_at, updated_at (every list has them)")
    if cut:
        say(f"  shortcut on /admin/{table}: \"{cut[0]}\" ({cut[1]})")
    say(f"{'would write' if a.dry_run else 'writing'} {mig_path.relative_to(site.ws)}, {view_path.relative_to(site.ws)}, "
        f"functions/_admin/collections.js (+{table})")
    order = [c for c in cols]
    stmts = []
    for r in body:
        vals = {c["name"]: cell_value(c, r[i]) for i, c in enumerate(order)}
        vals = {k: v for k, v in vals.items() if v is not None}
        if not vals:
            continue
        stmts.append(f"INSERT INTO {table} ({', '.join(ident(k) for k in vals)}) VALUES ({', '.join(lit(v) for v in vals.values())});")
    if a.dry_run:
        say("\n-- the migration\n" + mig)
        say("-- the first rows\n" + "\n".join(stmts[:3]) + (f"\n-- … {len(stmts) - 3} more" if len(stmts) > 3 else ""))
        say(f"\ndry run: nothing written. Say the mapping back to the owner, then run it again without --dry-run.")
        return
    mig_path.parent.mkdir(exist_ok=True)
    mig_path.write_text(mig)
    view_path.write_text(js)
    views = registered_views(repo)
    if table not in {mod for _, mod in views}:
        write_views(repo, views + [(table, table)])
    if a.no_migrate:
        say(f"not migrated (--no-migrate): db migrate, then db import {table} with the rows")
        return
    cmd_migrate(argparse.Namespace(site=site.name, local=a.local, dry_run=False))
    if stmts and not a.no_import:
        for i in range(0, len(stmts), 500):
            run_sql(site, a.local, "\n".join(stmts[i:i + 500]) + "\n")
        say(f"imported {len(stmts)} row{'s' if len(stmts) != 1 else ''} into {table}")
    say(f"\nnext: look at it (the view file is yours to rename and trim), commit, `git -C repos/{site.name} push`, "
        f"`site publish {site.name}`, then open /admin/{table} and tell the owner where it is.")


def view_table(path):
    """The `table: "…"` a view file names, or None."""
    m = re.search(r'\btable:\s*"([^"]*)"', path.read_text()) if path.exists() else None
    return m.group(1) if m else None


def view_meta(repo, mod):
    p = repo / "functions" / "_admin" / f"{mod}.js"
    text = p.read_text() if p.exists() else ""
    get = lambda k: (re.search(rf'\b{k}:\s*"([^"]*)"', text) or [None, None])[1]
    return {"exists": p.exists(), "table": get("table"), "title": get("title"),
            "filter": bool(re.search(r"\bfilter:\s*\{", text))}


def collection_tables():
    """table -> the collection whose migrations create it."""
    out = {}
    for d in sorted(COLLECTIONS.iterdir()) if COLLECTIONS.is_dir() else []:
        for m in (d / "migrations").glob("*.sql") if (d / "migrations").is_dir() else []:
            for t in re.findall(r"(?i)create\s+table\s+(?:if\s+not\s+exists\s+)?(\w+)", m.read_text()):
                out[t.lower()] = d.name
    return out


def view_kinds(repo):
    """[(module, meta, kind)] for every view /admin shows: kind is 'collection' (a
    collection's own view), 'named list' (a copy on a collection's table, like
    customers on records) or 'tool' (a table of this site's own: a web tool)."""
    std = {p.stem: (view_table(p) or "").lower() for p in COLLECTIONS.glob("*/functions/_admin/*.js")}
    tabs = collection_tables()
    out = []
    for _, mod in registered_views(repo):
        m = view_meta(repo, mod)
        t = (m["table"] or "").lower()
        kind = "collection" if std.get(mod) == t else "named list" if t in tabs else "tool"
        out.append((mod, m, kind))
    return out


def cmd_tools(a):
    site = the_site(a)
    views = view_kinds(site.repo)
    if not views:
        say("/admin shows nothing yet (db add <collection>, or build a tool: PLAYBOOK.md § Web tools)")
        return
    have = {r["name"] for r in rows_of(d1(site, a.local, command="SELECT name FROM sqlite_master WHERE type='table'"))}
    tables = sorted({m["table"] for _, m, k in views if k == "tool" and m["table"] in have})
    counts = rows_of(d1(site, a.local, command="SELECT " + ", ".join(f"(SELECT COUNT(*) FROM {ident(t)}) AS {ident(t)}" for t in tables)))[0] if tables else {}
    w = max(len(mod) for mod, _, _ in views)
    for mod, m, kind in views:
        extra = ""
        if kind == "tool":
            extra = f"  {counts[m['table']]} rows" if m["table"] in counts else "  TABLE MISSING (db migrate)"
        if not m["exists"]:
            extra = "  VIEW FILE MISSING"
        say(f"{mod.ljust(w)}  {kind:<10}  {m['title'] or '?'} (table {m['table'] or '?'})  /admin/{mod}{extra}")
    n = sum(1 for _, _, k in views if k == "tool")
    say(f"\n{n} web tool{'s' if n != 1 else ''} of this site's own; worked examples: "
        + ", ".join(sorted(p.name for p in TOOLS.iterdir() if p.is_dir())) + f" in claude-tools/templates/tools/ (PLAYBOOK.md § Web tools)")


# ---------------------------------------------------------------- collection commands (B122 on)
# A collection with its own everyday commands registers them here: one
# @subcommands("name", "help") on a function that adds its actions to the
# parser it's given. main() adds each, in the order they're defined. A later
# collection (ledger, estimates, signatures) adds its own block like the
# customer book's below and touches nothing above it.

SUBCOMMANDS = {}


def subcommands(name, help):
    def deco(fn):
        SUBCOMMANDS[name] = (help, fn)
        return fn
    return deco


def rows(site, local, sql):
    return rows_of(d1(site, local, command=sql))


def has_table(site, local, name):
    return bool(rows(site, local, f"SELECT name FROM sqlite_master WHERE type='table' AND name={lit(name)}"))


def emit_json(obj):
    say(json.dumps(obj, indent=2, ensure_ascii=False))


# ---------------------------------------------------------------- the customer book (B122)
# customers (one row a customer) and jobs (what was done for them), from
# templates/collections/customers. The same matching as the site's own
# functions/_lib/customers.js: the same phone (last ten digits) or email (any
# case) is the same customer; a name alone never merges two people.
#
# For machines (the review loop, B118; bookings, B119; estimates, B123; pay):
#   db customers find PHONE|EMAIL|NAME --json   -> [customer, …] (empty when none)
#   db customers show ID|PHONE|EMAIL|NAME --json -> customer with "jobs"; exit 3 + {"error","matches"} when
#                                                  it names several, exit 4 + {"error"} when none
#   db jobs add CUSTOMER "what" [--status done] [--source S --ref R] --json -> {"job": …, "customer": …}
#   db jobs done JOB_ID --json                   -> {"job": …, "customer": …}
# A customer is {id, name, phone, email, address, notes, tags, contact ("ok"|"stop"), source,
# last_seen (YYYY-MM-DD), created_at, updated_at}; a job {id, customer_id, customer_name, date, what,
# amount_cents, status ("booked"|"done"|"cancelled"), notes, source, ref, created_at, updated_at}.

JOB_STATUSES = ("booked", "done", "cancelled")
CUSTOMER_COLS = ("id", "name", "phone", "email", "address", "notes", "tags", "contact", "source",
                 "last_seen", "created_at", "updated_at")
# the header words a spreadsheet of customers is read by (the same as the site's
# functions/_lib/customers.js HEADERS, which the /admin import uses)
CUSTOMER_HEADERS = {
    "name": ["name", "full name", "customer", "customer name", "client", "client name", "contact", "contact name"],
    "first": ["first", "first name", "firstname", "given name"],
    "last": ["last", "last name", "lastname", "surname", "family name"],
    "phone": ["phone", "phone number", "mobile", "mobile phone", "cell", "cell phone", "tel", "telephone", "number"],
    "email": ["email", "e-mail", "email address", "e-mail address", "mail"],
    "address": ["address", "street", "street address", "service address", "address 1", "address line 1"],
    "city": ["city", "town"],
    "state": ["state", "province", "region"],
    "zip": ["zip", "zip code", "zipcode", "postal code", "postcode"],
    "notes": ["notes", "note", "comments", "comment", "details"],
    "tags": ["tags", "tag", "labels", "label", "group", "groups", "type"],
    "last_seen": ["last seen", "last visit", "last service", "last job", "last appointment", "last contact",
                  "last done", "last serviced", "date"],
}


def phone_key(phone):
    d = re.sub(r"\D", "", str(phone or ""))
    if len(d) < 7:
        return ""
    return d[-10:] if len(d) > 10 else d


def phone_shown(phone):
    raw = str(phone or "").strip()
    d = re.sub(r"\D", "", raw)
    ten = d[1:] if len(d) == 11 and d[0] == "1" else d
    return f"{ten[:3]}-{ten[3:6]}-{ten[6:]}" if len(ten) == 10 else (raw or None)


def email_key(email):
    return str(email or "").strip().lower()


def iso_date(v):
    """'3/14/2026', '2026-03-14', '03/14/26', 'Mar 14, 2026', 'today', 'yesterday' -> '2026-03-14'; '' otherwise."""
    s = str(v or "").strip()
    low = s.lower()
    today = datetime.date.today()
    if low == "today":
        return today.isoformat()
    if low == "yesterday":
        return (today - datetime.timedelta(days=1)).isoformat()
    if m := re.match(r"^(\d{4})-(\d{1,2})-(\d{1,2})(?:[T ]\d{1,2}:\d{2}(?::\d{2}(?:\.\d+)?)?(?:Z|[+-]\d{2}:?\d{2})?)?$", s):
        y, mo, d = map(int, m.groups())
    elif m := re.match(r"^(\d{1,2})/(\d{1,2})/(\d{2}|\d{4})$", s):
        mo, d, y = int(m.group(1)), int(m.group(2)), int(m.group(3)) + (2000 if len(m.group(3)) == 2 else 0)
    else:
        for fmt in ("%b %d, %Y", "%b %d %Y", "%B %d, %Y", "%B %d %Y", "%d %b %Y", "%d %B %Y"):
            try:
                return datetime.datetime.strptime(s, fmt).date().isoformat()
            except ValueError:
                pass
        return ""
    try:
        return datetime.date(y, mo, d).isoformat()
    except ValueError:
        return ""


def money_cents(v):
    """'450', '450.00', '$1,200', '-12.50' -> cents. Plain decimal money only: '1e5', 'inf' and
    'nan' are refused, since float() would read them as numbers nobody wrote on a receipt."""
    s = re.sub(r"[$,\s]", "", str(v or ""))
    if not s:
        return None
    if not re.fullmatch(r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)", s):
        die(f"{v!r} isn't an amount (450, 450.00, $1,200)")
    return int(round(float(s) * 100))


def the_book(a):
    site = the_site(a)
    if not has_table(site, a.local, "customers"):
        die("this site has no customer book yet: `db add customers` (PLAYBOOK.md § Data). "
            "Customers kept as records (kind = customer) move in with `db customers import --from-records`.")
    return site


def days_ago(day):
    try:
        return (datetime.date.today() - datetime.date.fromisoformat(str(day)[:10])).days
    except ValueError:
        return None


def find_customers(site, local, term, limit=20):
    """Customers a phone, email, #id or name points at, best first."""
    t = str(term or "").strip().lstrip("#")
    cols = ", ".join(CUSTOMER_COLS)
    if re.fullmatch(r"\d{1,6}", t):
        return rows(site, local, f"SELECT {cols} FROM customers WHERE id = {int(t)}")
    if "@" in t:
        return rows(site, local, f"SELECT {cols} FROM customers WHERE email = {lit(email_key(t))} ORDER BY id")
    key = phone_key(t)
    if key and not re.search(r"[A-Za-z]", t):
        cond = f"phone_key = {lit(key)}" if len(key) == 10 else f"phone_key LIKE {lit('%' + key)}"
        return rows(site, local, f"SELECT {cols} FROM customers WHERE {cond} ORDER BY id LIMIT {limit}")
    words = [w for w in re.split(r"\s+", t.lower()) if w and w not in ("the", "and", "&")]
    if not words:
        return []
    # "the Smiths" finds Smith: a plural family name is the name
    like = lambda w: f"(lower(name) LIKE {lit('%' + w + '%')}" + (
        f" OR lower(name) LIKE {lit('%' + w[:-1] + '%')}" if len(w) > 3 and w.endswith("s") else "") + ")"
    exact = f"lower(name) = {lit(t.lower())}"
    return rows(site, local, f"SELECT {cols} FROM customers WHERE {' AND '.join(like(w) for w in words)} "
                             f"ORDER BY ({exact}) DESC, last_seen DESC, id LIMIT {limit}")


def jobs_of(site, local, ids, per=200):
    if not ids:
        return {}
    got = rows(site, local, f"SELECT * FROM jobs WHERE customer_id IN ({', '.join(str(int(i)) for i in ids)}) "
                            f"ORDER BY date DESC, id DESC")
    out = {}
    for j in got:
        out.setdefault(j["customer_id"], []).append(j)
    return {k: v[:per] for k, v in out.items()}


def customer_line(c, jobs=()):
    bits = [f"#{c['id']} {c['name']}"] + [x for x in (c.get("phone"), c.get("email")) if x]
    if c.get("last_seen"):
        n = days_ago(c["last_seen"])
        bits.append(f"last seen {c['last_seen']}" + (f" ({n} days ago)" if n is not None and n > 1 else ""))
    if jobs:
        j = jobs[0]
        bits.append(f"{len(jobs)} job{'s' if len(jobs) != 1 else ''}, last: {j['what']} {j.get('date') or ''} {j['status']}".rstrip())
    if c.get("contact") == "stop":
        bits.append("ASKED NOT TO BE CONTACTED")
    return " · ".join(bits)


def money_text(cents):
    return "" if cents is None else f"${cents / 100:,.2f}"


def cmd_customers_find(a):
    site = the_book(a)
    found = find_customers(site, a.local, a.term)
    jobs = jobs_of(site, a.local, [c["id"] for c in found])
    if a.json:
        emit_json([dict(c, jobs_count=len(jobs.get(c["id"], [])), last_job=(jobs.get(c["id"]) or [None])[0])
                   for c in found])
        return
    if not found:
        say(f"no customer matches {a.term!r}")
        return
    for c in found:
        say(customer_line(c, jobs.get(c["id"], [])))


def one_customer(site, local, term, as_json):
    found = find_customers(site, local, term)
    if len(found) == 1:
        return found[0]
    if as_json:
        emit_json({"error": "not found" if not found else "more than one customer matches", "matches": found})
    elif not found:
        say(f"no customer matches {term!r} (db customers find, or db customers add)")
    else:
        say(f"{len(found)} customers match {term!r}; say which by number:")
        for c in found:
            say("  " + customer_line(c))
    sys.exit(4 if not found else 3)


def cmd_customers_show(a):
    site = the_book(a)
    c = one_customer(site, a.local, a.term, a.json)
    jobs = jobs_of(site, a.local, [c["id"]]).get(c["id"], [])
    if a.json:
        emit_json(dict(c, jobs=jobs))
        return
    say(f"#{c['id']} {c['name']}")
    for k in ("phone", "email", "address", "tags", "last_seen", "notes", "source"):
        if c.get(k):
            say(f"  {k.replace('_', ' ')}: {c[k]}")
    if c.get("contact") == "stop":
        say("  contact: STOP — asked not to be contacted; nothing goes to them")
    if not jobs:
        say("  no jobs yet")
    for j in jobs:
        say(f"  job #{j['id']}  {j.get('date') or '':<10}  {j['status']:<9}  {money_text(j.get('amount_cents')):>10}  {j['what']}")


def upsert_customer(site, local, *, name="", phone="", email="", address="", notes="", tags="", source=None, seen=None):
    """Find-or-make, the way the site's recordCustomer does. -> (customer, created)."""
    key, em = phone_key(phone), email_key(email)
    found = []
    if key:
        found = rows(site, local, f"SELECT id FROM customers WHERE phone_key = {lit(key)} ORDER BY id LIMIT 1")
    if not found and em:
        found = rows(site, local, f"SELECT id FROM customers WHERE email = {lit(em)} ORDER BY id LIMIT 1")
    opt = lambda v: str(v).strip()[:5000] if v is not None and str(v).strip() else None
    shown = phone_shown(phone) if key else None
    if found:
        cid = found[0]["id"]
        d1(site, local, command=(
            f"UPDATE customers SET name = CASE WHEN name = '' THEN {lit(opt(name) or '')} ELSE name END, "
            f"phone = COALESCE(phone, {lit(shown)}), phone_key = COALESCE(phone_key, {lit(key or None)}), "
            f"email = COALESCE(email, {lit(em or None)}), address = COALESCE(address, {lit(opt(address))}), "
            f"notes = COALESCE(notes, {lit(opt(notes))}), tags = COALESCE(tags, {lit(opt(tags))}), "
            + (f"last_seen = CASE WHEN last_seen IS NULL OR last_seen < {lit(seen)} THEN {lit(seen)} ELSE last_seen END, " if seen else "")
            + f"updated_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now') WHERE id = {cid}"))
        created = False
    else:
        if not (opt(name) or key or em):
            die("a customer needs a name, a phone or an email")
        res = d1(site, local, command=(
            "INSERT INTO customers (name, phone, phone_key, email, address, notes, tags, source, last_seen) VALUES ("
            + ", ".join(lit(v) for v in (opt(name) or em or shown, shown, key or None, em or None, opt(address),
                                         opt(notes), opt(tags), source, seen)) + ")"))
        cid = (res[-1].get("meta") or {}).get("last_row_id")
        if not cid:
            cid = rows(site, local, "SELECT MAX(id) AS id FROM customers")[0]["id"]
        created = True
    return rows(site, local, f"SELECT {', '.join(CUSTOMER_COLS)} FROM customers WHERE id = {int(cid)}")[0], created


def seen_arg(v):
    if v is None:
        return None
    d = iso_date(v)
    if not d:
        die(f"--seen {v!r} isn't a date (2026-10-05, 10/5/2026, today)")
    return d


def cmd_customers_add(a):
    site = the_book(a)
    c, created = upsert_customer(site, a.local, name=a.name, phone=a.phone, email=a.email, address=a.address,
                                 notes=a.notes, tags=a.tags, source=a.source, seen=seen_arg(a.seen))
    if a.json:
        emit_json({"customer": c, "created": created})
        return
    say(("added " if created else "already in the book (same phone or email), filled in: ") + customer_line(c))


def cmd_customers_set(a):
    site = the_book(a)
    c = one_customer(site, a.local, a.id, a.json)
    sets = []
    for k in ("name", "address", "notes"):
        v = getattr(a, k)
        if v is not None:
            sets.append(f"{k} = {lit(v.strip() or None) if k != 'name' else lit(v.strip() or c['name'])}")
    if a.phone is not None:
        key = phone_key(a.phone)
        sets += [f"phone = {lit(phone_shown(a.phone) if key else (a.phone.strip() or None))}", f"phone_key = {lit(key or None)}"]
    if a.email is not None:
        sets.append(f"email = {lit(email_key(a.email) or None)}")
    tags = [t.strip() for t in (c.get("tags") or "").split(",") if t.strip()]
    if a.tags is not None:
        tags = [t.strip() for t in a.tags.split(",") if t.strip()]
    for t in a.add_tag or []:
        if t.strip() and t.strip().lower() not in {x.lower() for x in tags}:
            tags.append(t.strip())
    if a.tags is not None or a.add_tag:
        sets.append(f"tags = {lit(', '.join(tags) or None)}")
    if a.contact:
        sets.append(f"contact = {lit(a.contact)}")
    if a.seen:
        sets.append(f"last_seen = {lit(seen_arg(a.seen))}")
    if not sets:
        die("nothing to change (--name, --phone, --email, --address, --notes, --tags, --add-tag, --contact, --seen)")
    sets.append("updated_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now')")
    d1(site, a.local, command=f"UPDATE customers SET {', '.join(sets)} WHERE id = {c['id']}")
    if a.name and a.name.strip() and a.name.strip() != c["name"]:
        d1(site, a.local, command=f"UPDATE jobs SET customer_name = {lit(a.name.strip())} WHERE customer_id = {c['id']}")
    c = rows(site, a.local, f"SELECT {', '.join(CUSTOMER_COLS)} FROM customers WHERE id = {c['id']}")[0]
    if a.json:
        emit_json({"customer": c})
    else:
        say("changed: " + customer_line(c))


def lapsed(site, local, days):
    cut = (datetime.date.today() - datetime.timedelta(days=days)).isoformat()
    today = datetime.date.today().isoformat()
    cols = ", ".join(CUSTOMER_COLS)
    booked = f"SELECT customer_id FROM jobs WHERE status = 'booked' AND date >= {lit(today)}"
    gone = rows(site, local, f"SELECT {cols} FROM customers WHERE last_seen IS NOT NULL AND last_seen < {lit(cut)} "
                             f"AND id NOT IN ({booked}) ORDER BY last_seen DESC, name")
    unknown = rows(site, local, f"SELECT {cols} FROM customers WHERE last_seen IS NULL AND id NOT IN ({booked}) ORDER BY name")
    return cut, gone, unknown


def cmd_customers_lapsed(a):
    site = the_book(a)
    cut, gone, unknown = lapsed(site, a.local, a.days)
    if a.json:
        emit_json({"days": a.days, "before": cut, "customers": gone, "never_seen": unknown if a.unknown else len(unknown)})
        return
    if not gone:
        say(f"everyone with a visit on record has been seen in the last {a.days} days")
    else:
        say(f"{len(gone)} not seen in {a.days} days (since before {cut}), most recent first:")
        for c in gone:
            say("  " + customer_line(c))
    stop = sum(1 for c in gone if c.get("contact") == "stop")
    if stop:
        say(f"({stop} of them asked not to be contacted: never on a message list)")
    if unknown:
        if a.unknown:
            say(f"\n{len(unknown)} with no visit on record:")
            for c in unknown:
                say("  " + customer_line(c))
        else:
            say(f"(and {len(unknown)} with no visit on record: --unknown lists them)")
    say("(anyone with a job booked from today on is left out)")


def read_customer_sheet(path, sheet=None):
    """(header mapping {field: index}, extra [(label, index)], rows) from a CSV or Excel file."""
    if path.resolve().is_relative_to(Path.home() / ".config"):
        die(f"no such file: {path}")
    _, _, header, body = read_sheet(path, sheet)
    norm = lambda h: re.sub(r"\s+", " ", re.sub(r"[_\-.]+", " ", h.lower())).strip()
    fmap, extra = {}, []
    for i, h in enumerate(header):
        f = next((k for k, words in CUSTOMER_HEADERS.items() if norm(h) in words), None)
        if f and f not in fmap:
            fmap[f] = i
        elif h.strip():
            extra.append((h.strip(), i))
    return fmap, extra, header, body


def customer_from_row(fmap, extra, r):
    at = lambda f: r[fmap[f]].strip() if f in fmap and fmap[f] < len(r) else ""
    name = at("name") or " ".join(x for x in (at("first"), at("last")) if x)
    place = ", ".join(x for x in (at("address"), at("city"), " ".join(x for x in (at("state"), at("zip")) if x)) if x)
    raw_seen = at("last_seen")
    seen = iso_date(raw_seen) if raw_seen else ""
    more = [f"{label}: {r[i].strip()}" for label, i in extra if i < len(r) and r[i].strip()]
    if raw_seen and not seen:
        more.append(f"Last seen: {raw_seen}")
    if not (name or phone_key(at("phone")) or at("email")):
        return None
    return {"name": name, "phone": at("phone"), "email": at("email"), "address": place,
            "notes": "\n".join(x for x in [at("notes"), *more] if x), "tags": at("tags"), "seen": seen or None,
            "unread_date": bool(raw_seen and not seen)}


def plan_import(existing, incoming):
    """Match incoming customers against the book (and each other): -> (inserts, updates {id: fields}, merged_in_file)."""
    by_key = {c["phone_key"]: c["id"] for c in existing if c.get("phone_key")}
    by_mail = {c["email"]: c["id"] for c in existing if c.get("email")}
    inserts, updates, dup = [], {}, 0
    new_key, new_mail = {}, {}
    for c in incoming:
        key, em = phone_key(c["phone"]), email_key(c["email"])
        cid = (by_key.get(key) if key else None) or (by_mail.get(em) if em else None)
        if cid:
            u = updates.setdefault(cid, {})
            for k, v in c.items():
                if v and not u.get(k):
                    u[k] = v
                elif k == "seen" and v and u.get(k) and v > u[k]:
                    u[k] = v
            continue
        j = (new_key.get(key) if key else None)
        if j is None and em:
            j = new_mail.get(em)
        if j is not None:
            dup += 1
            prev = inserts[j]
            for k, v in c.items():
                if v and not prev.get(k):
                    prev[k] = v
                elif k == "seen" and v and prev.get(k) and v > prev[k]:
                    prev[k] = v
            continue
        inserts.append(dict(c))
        if key:
            new_key[key] = len(inserts) - 1
        if em:
            new_mail[em] = len(inserts) - 1
    return inserts, updates, dup


def import_sql(inserts, updates, source):
    stmts = []
    opt = lambda v: str(v).strip()[:5000] if v is not None and str(v).strip() else None
    for c in inserts:
        key = phone_key(c.get("phone"))
        em = email_key(c.get("email"))
        shown = phone_shown(c.get("phone")) if key else None
        stmts.append("INSERT INTO customers (name, phone, phone_key, email, address, notes, tags, source, last_seen) VALUES ("
                     + ", ".join(lit(v) for v in (opt(c.get("name")) or em or shown, shown, key or None, em or None,
                                                  opt(c.get("address")), opt(c.get("notes")), opt(c.get("tags")),
                                                  source, c.get("seen"))) + ");")
    for cid, c in updates.items():
        key = phone_key(c.get("phone"))
        sets = [f"phone = COALESCE(phone, {lit(phone_shown(c.get('phone')) if key else None)})",
                f"phone_key = COALESCE(phone_key, {lit(key or None)})",
                f"email = COALESCE(email, {lit(email_key(c.get('email')) or None)})"]
        sets += [f"{k} = COALESCE({k}, {lit(opt(c.get(k)))})" for k in ("address", "notes", "tags")]
        if c.get("seen"):
            sets.append(f"last_seen = CASE WHEN last_seen IS NULL OR last_seen < {lit(c['seen'])} THEN {lit(c['seen'])} ELSE last_seen END")
        sets.append("updated_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now')")
        stmts.append(f"UPDATE customers SET {', '.join(sets)} WHERE id = {int(cid)};")
    return stmts


def cmd_customers_import(a):
    if a.from_records:
        return import_from_records(a)
    if not a.file:
        die("db customers import FILE (a .csv or .xlsx with a header row), or --from-records")
    path = Path(a.file)
    if not path.is_file():
        die(f"no such file: {a.file}")
    fmap, extra, header, body = read_customer_sheet(path, a.sheet)
    if not ({"name", "first", "phone", "email"} & set(fmap)):
        die(f"I can't find a name, phone or email column in the header row ({', '.join(header)}). "
            f"Ask the owner which column is which, or rename the header to Name / Phone / Email.")
    incoming, skipped = [], 0
    for r in body:
        c = customer_from_row(fmap, extra, r)
        if c:
            incoming.append(c)
        else:
            skipped += 1
    site = the_book(a)
    existing = rows(site, a.local, "SELECT id, phone_key, email FROM customers")
    inserts, updates, dup = plan_import(existing, incoming)
    labels = {f: header[i] for f, i in fmap.items()}
    say(f"{path.name}: {len(body)} row{'s' if len(body) != 1 else ''}")
    for f, h in labels.items():
        say(f"  {h!r} -> {f.replace('_', ' ')}")
    if extra:
        say(f"  into the notes: {', '.join(repr(h) for h, _ in extra)}")
    undated = sum(1 for c in incoming if c.get("unread_date"))
    blank = sum(1 for c in incoming if not c["seen"] and not c.get("unread_date"))
    say(f"{len(inserts)} new, {len(updates)} already in the book (filled in, never overwritten)"
        + (f", {dup} repeated in the file (merged)" if dup else "")
        + (f", {skipped} skipped (no name, phone or email)" if skipped else ""))
    if "last_seen" in fmap and undated:
        say(f"{undated} with a date I couldn't read in {labels['last_seen']!r} (kept in their notes)")
    if "last_seen" in fmap and blank:
        say(f"{blank} with no date in {labels['last_seen']!r}: \"who haven't I seen\" lists them apart")
    elif "last_seen" not in fmap:
        say("no last-visit column: \"who haven't I seen\" won't know these until a job or booking")
    stmts = import_sql(inserts, updates, "import")
    if a.dry_run:
        for c in inserts[:5]:
            say(f"  + {c['name'] or c['email'] or c['phone']}" + (f" (last seen {c['seen']})" if c["seen"] else ""))
        if len(inserts) > 5:
            say(f"  … {len(inserts) - 5} more")
        say("dry run: nothing written. Say the mapping back to the owner, then run it without --dry-run.")
        return
    for i in range(0, len(stmts), 200):
        run_sql(site, a.local, "\n".join(stmts[i:i + 200]) + "\n")
    n = rows(site, a.local, "SELECT COUNT(*) AS n FROM customers")[0]["n"]
    say(f"imported: the book has {n} customer{'s' if n != 1 else ''} now (/admin/customers)")


def import_from_records(a):
    """records rows kept as customers and jobs (the named lists before B122) into the book. The records rows stay."""
    site = the_book(a)
    if not has_table(site, a.local, "records"):
        die("this site has no records table: nothing to move")
    recs = rows(site, a.local, "SELECT id, kind, title, status, notes, data, created_at FROM records "
                               "WHERE kind IN ('customer', 'job') ORDER BY id")
    custs = [r for r in recs if r["kind"] == "customer"]
    jobs = [r for r in recs if r["kind"] == "job"]
    incoming = []
    for r in custs:
        try:
            d = json.loads(r.get("data") or "{}")
        except ValueError:
            d = {}
        d = d if isinstance(d, dict) else {}
        incoming.append({"name": r["title"], "phone": d.get("phone") or "", "email": d.get("email") or "",
                         "address": d.get("address") or "", "notes": r.get("notes") or "",
                         "tags": d.get("tags") or "", "seen": iso_date(d.get("last_seen") or "") or None})
    existing = rows(site, a.local, "SELECT id, name, phone_key, email FROM customers")
    have_names = {(c.get("name") or "").lower() for c in existing}
    incoming = [c for c in incoming if phone_key(c["phone"]) or email_key(c["email"]) or c["name"].lower() not in have_names]
    inserts, updates, _ = plan_import(existing, incoming)
    say(f"records: {len(custs)} customer{'s' if len(custs) != 1 else ''}, {len(jobs)} job{'s' if len(jobs) != 1 else ''}")
    say(f"{len(inserts)} new customer{'s' if len(inserts) != 1 else ''}, {len(updates)} already in the book")
    if a.dry_run:
        say("dry run: nothing written")
        return
    stmts = import_sql(inserts, updates, "records")
    if stmts:
        run_sql(site, a.local, "\n".join(stmts) + "\n")
    names = {(c["name"] or "").lower(): c["id"] for c in rows(site, a.local, "SELECT id, name FROM customers")}
    status = {"open": "booked", "done": "done", "archived": "cancelled"}
    done, unmatched = [], []
    for j in jobs:
        parts = re.split(r"\s+[—–-]\s+", j["title"], maxsplit=1)
        what, who = (parts[0], parts[1]) if len(parts) == 2 else (j["title"], "")
        cid = names.get(who.strip().lower())
        if not cid:
            unmatched.append(j["title"])
            continue
        exists = rows(site, a.local, f"SELECT id FROM jobs WHERE source = 'records' AND ref = {lit(str(j['id']))}")
        if exists:
            continue
        done.append(f"INSERT INTO jobs (customer_id, customer_name, date, what, status, notes, source, ref) "
                    f"SELECT id, name, {lit((j.get('created_at') or '')[:10] or None)}, {lit(what.strip())}, "
                    f"{lit(status.get(j['status'], 'booked'))}, {lit(j.get('notes'))}, 'records', {lit(str(j['id']))} "
                    f"FROM customers WHERE id = {cid};")
    if done:
        run_sql(site, a.local, "\n".join(done) + "\n")
    say(f"moved {len(inserts)} customer{'s' if len(inserts) != 1 else ''} and {len(done)} job{'s' if len(done) != 1 else ''} into the book")
    if unmatched:
        say(f"{len(unmatched)} job{'s' if len(unmatched) != 1 else ''} not moved (no customer named in the title, "
            f"\"What — Customer Name\"): " + "; ".join(unmatched[:5]))
    say("the records rows are still there; once the owner is happy, "
        "`db exec \"DELETE FROM records WHERE kind IN ('customer', 'job')\"`")


def cmd_customers_export(a):
    the_book(a)
    cmd_export(a, only=("customers", "jobs"))


def job_out(site, local, jid):
    j = rows(site, local, f"SELECT * FROM jobs WHERE id = {int(jid)}")[0]
    c = rows(site, local, f"SELECT {', '.join(CUSTOMER_COLS)} FROM customers WHERE id = {int(j['customer_id'])}")[0]
    return j, c


def job_line(j):
    return (f"job #{j['id']} for {j.get('customer_name')}: {j['what']}, {j.get('date') or 'no date'}, {j['status']}"
            + (f", {money_text(j['amount_cents'])}" if j.get("amount_cents") is not None else ""))


def bump_seen(site, local, cid, day):
    d1(site, local, command=f"UPDATE customers SET last_seen = {lit(day)}, updated_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now') "
                            f"WHERE id = {int(cid)} AND (last_seen IS NULL OR last_seen < {lit(day)})")


def cmd_jobs_add(a):
    site = the_book(a)
    if a.create:
        term = a.customer
        c, _ = upsert_customer(site, a.local, name=a.name or ("" if (phone_key(term) or "@" in term) else term),
                               phone=a.phone or (term if phone_key(term) and not re.search(r"[A-Za-z]", term) else ""),
                               email=a.email or (term if "@" in term else ""), source=a.source or "text")
    else:
        c = one_customer(site, a.local, a.customer, a.json)
    day = iso_date(a.date) if a.date else datetime.date.today().isoformat()
    if not day:
        die(f"--date {a.date!r} isn't a date (2026-10-05, 10/5/2026, today)")
    cents = money_cents(a.amount)
    same = rows(site, a.local, f"SELECT id FROM jobs WHERE source = {lit(a.source)} AND ref = {lit(a.ref)}") if a.source and a.ref else []
    if same:
        jid = same[0]["id"]
        d1(site, a.local, command=f"UPDATE jobs SET date = {lit(day)}, what = {lit(a.what)}, status = {lit(a.status)}, "
                                  + (f"amount_cents = {cents}, " if cents is not None else "")
                                  + f"updated_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now') WHERE id = {jid}")
    else:
        res = d1(site, a.local, command=(
            "INSERT INTO jobs (customer_id, customer_name, date, what, amount_cents, status, notes, source, ref) "
            f"SELECT id, name, {lit(day)}, {lit(a.what)}, {lit(cents)}, {lit(a.status)}, {lit(a.notes)}, "
            f"{lit(a.source or 'text')}, {lit(a.ref)} FROM customers WHERE id = {int(c['id'])}"))
        jid = (res[-1].get("meta") or {}).get("last_row_id") or rows(site, a.local, "SELECT MAX(id) AS id FROM jobs")[0]["id"]
    if a.status == "done":
        bump_seen(site, a.local, c["id"], day)
    j, c = job_out(site, a.local, jid)
    if a.json:
        emit_json({"job": j, "customer": c, "updated": bool(same)})
    else:
        say(("updated " if same else "added ") + job_line(j))


def cmd_jobs_done(a):
    site = the_book(a)
    t = str(a.job).strip().lstrip("#")
    if re.fullmatch(r"\d{1,6}", t):
        got = rows(site, a.local, f"SELECT * FROM jobs WHERE id = {int(t)}")
        if not got:
            die(f"no job #{t} (db jobs ls)")
        j = got[0]
    else:
        c = one_customer(site, a.local, t, a.json)
        open_ = rows(site, a.local, f"SELECT * FROM jobs WHERE customer_id = {c['id']} AND status = 'booked' ORDER BY date, id")
        if len(open_) != 1:
            msg = (f"{c['name']} has no booked job: `db jobs add {c['id']} \"what\" --status done` records one done"
                   if not open_ else f"{c['name']} has {len(open_)} booked jobs; say which by number:\n"
                   + "\n".join("  " + job_line(x) for x in open_))
            if a.json:
                emit_json({"error": msg, "jobs": open_})
                sys.exit(3)
            die(msg, 3)
        j = open_[0]
    day = iso_date(a.date) if a.date else (j.get("date") or datetime.date.today().isoformat())
    if day > datetime.date.today().isoformat() and not a.date:
        day = datetime.date.today().isoformat()          # done early: done today, not on the booked day
    cents = money_cents(a.amount)
    d1(site, a.local, command=f"UPDATE jobs SET status = 'done', date = {lit(day)}, "
                              + (f"amount_cents = {cents}, " if cents is not None else "")
                              + f"updated_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now') WHERE id = {j['id']}")
    bump_seen(site, a.local, j["customer_id"], day)
    j, c = job_out(site, a.local, j["id"])
    if a.json:
        emit_json({"job": j, "customer": c})
    else:
        say("done: " + job_line(j))


def cmd_jobs_set(a):
    site = the_book(a)
    got = rows(site, a.local, f"SELECT * FROM jobs WHERE id = {int(a.id)}")
    if not got:
        die(f"no job #{a.id}")
    if a.status == "done":
        return cmd_jobs_done(argparse.Namespace(**{**vars(a), "job": str(a.id)}))
    sets = []
    if a.status:
        sets.append(f"status = {lit(a.status)}")
    if a.date:
        sets.append(f"date = {lit(iso_date(a.date) or die(f'--date {a.date!r} is not a date'))}")
    if a.what:
        sets.append(f"what = {lit(a.what)}")
    if a.amount is not None:
        sets.append(f"amount_cents = {lit(money_cents(a.amount))}")
    if a.notes is not None:
        sets.append(f"notes = {lit(a.notes or None)}")
    if not sets:
        die("nothing to change (--status, --date, --what, --amount, --notes)")
    d1(site, a.local, command=f"UPDATE jobs SET {', '.join(sets)}, updated_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now') WHERE id = {int(a.id)}")
    j, c = job_out(site, a.local, a.id)
    if a.json:
        emit_json({"job": j, "customer": c})
    else:
        say("changed: " + job_line(j))


def cmd_jobs_ls(a):
    site = the_book(a)
    where = []
    if a.customer:
        c = one_customer(site, a.local, a.customer, a.json)
        where.append(f"customer_id = {c['id']}")
    if a.status:
        where.append(f"status = {lit(a.status)}")
    if a.days:
        where.append(f"date >= {lit((datetime.date.today() - datetime.timedelta(days=a.days)).isoformat())}")
    got = rows(site, a.local, "SELECT * FROM jobs" + (f" WHERE {' AND '.join(where)}" if where else "")
               + f" ORDER BY date DESC, id DESC LIMIT {int(a.limit)}")
    if a.json:
        emit_json(got)
        return
    if not got:
        say("no jobs" + (" like that" if where else " yet"))
    for j in got:
        say(job_line(j))
    total = sum(j["amount_cents"] or 0 for j in got if j["status"] == "done")
    if total:
        say(f"({money_text(total)} done in these {len(got)})")


@subcommands("customers", "the customer book: find, show, add, set, lapsed, import, export")
def customers_parser(p, common):
    s = p.add_subparsers(dest="action", required=True)
    f = s.add_parser("find", parents=[common], help="customers by phone, email, #id or name")
    f.add_argument("term"); f.add_argument("--json", action="store_true"); f.set_defaults(fn=cmd_customers_find)
    w = s.add_parser("show", parents=[common], help="one customer and their jobs")
    w.add_argument("term"); w.add_argument("--json", action="store_true"); w.set_defaults(fn=cmd_customers_show)
    d = s.add_parser("add", parents=[common], help="add one (the same phone or email fills in the one there)")
    d.add_argument("name")
    for k in ("phone", "email", "address", "notes", "tags"):
        d.add_argument(f"--{k}", default="")
    d.add_argument("--seen", help="a visit date to record (default: none)")
    d.add_argument("--source", default="text"); d.add_argument("--json", action="store_true")
    d.set_defaults(fn=cmd_customers_add)
    t = s.add_parser("set", parents=[common], help="change one: --phone, --tags, --add-tag, --contact stop …")
    t.add_argument("id", help="#id (or a phone, email or name that names one)")
    for k in ("name", "phone", "email", "address", "notes", "tags"):
        t.add_argument(f"--{k}")
    t.add_argument("--add-tag", action="append"); t.add_argument("--contact", choices=("ok", "stop"))
    t.add_argument("--seen"); t.add_argument("--json", action="store_true"); t.set_defaults(fn=cmd_customers_set)
    g = s.add_parser("lapsed", parents=[common], help="who hasn't been seen in --days (90)")
    g.add_argument("--days", type=int, default=90); g.add_argument("--unknown", action="store_true",
                                                                    help="also list those with no visit on record")
    g.add_argument("--json", action="store_true"); g.set_defaults(fn=cmd_customers_lapsed)
    i = s.add_parser("import", parents=[common], help="a CSV or Excel sheet of customers (merged by phone/email)")
    i.add_argument("file", nargs="?"); i.add_argument("--sheet"); i.add_argument("--dry-run", action="store_true")
    i.add_argument("--from-records", action="store_true", help="move records kept as customers/jobs into the book")
    i.set_defaults(fn=cmd_customers_import)
    s.add_parser("export", parents=[common], help="customers and jobs to exports/<date>/").set_defaults(fn=cmd_customers_export)


@subcommands("jobs", "jobs in the customer book: add, done, set, ls")
def jobs_parser(p, common):
    s = p.add_subparsers(dest="action", required=True)
    d = s.add_parser("add", parents=[common], help="a job for a customer")
    d.add_argument("customer", help="#id, phone, email or name (one customer)"); d.add_argument("what")
    d.add_argument("--date", help="default today"); d.add_argument("--amount", help="dollars: 450, 450.00")
    d.add_argument("--status", choices=JOB_STATUSES, default="booked"); d.add_argument("--notes")
    d.add_argument("--source", help="who wrote it: text (default), booking, estimate, pay")
    d.add_argument("--ref", help="the source's own id: the same source+ref again updates that job")
    d.add_argument("--create", action="store_true", help="make the customer when none matches")
    d.add_argument("--name"); d.add_argument("--phone"); d.add_argument("--email")
    d.add_argument("--json", action="store_true"); d.set_defaults(fn=cmd_jobs_add)
    n = s.add_parser("done", parents=[common], help="mark a job done (a job #, or a customer with one booked)")
    n.add_argument("job"); n.add_argument("--date"); n.add_argument("--amount")
    n.add_argument("--json", action="store_true"); n.set_defaults(fn=cmd_jobs_done)
    t = s.add_parser("set", parents=[common], help="change a job: --status, --date, --what, --amount, --notes")
    t.add_argument("id", type=int); t.add_argument("--status", choices=JOB_STATUSES); t.add_argument("--date")
    t.add_argument("--what"); t.add_argument("--amount"); t.add_argument("--notes")
    t.add_argument("--json", action="store_true"); t.set_defaults(fn=cmd_jobs_set)
    ls = s.add_parser("ls", parents=[common], help="jobs, newest first")
    ls.add_argument("customer", nargs="?"); ls.add_argument("--status", choices=JOB_STATUSES)
    ls.add_argument("--days", type=int); ls.add_argument("--limit", type=int, default=50)
    ls.add_argument("--json", action="store_true"); ls.set_defaults(fn=cmd_jobs_ls)


# ---------------------------------------------------------------- the ledger (B124)
# Receipts by photo, from templates/collections/ledger: Patch reads a receipt
# (vendor, date, total) and files it with `db ledger add`, which also keeps the
# photo at receipts/<YYYY-MM>/<date>-<vendor>-<id>.<ext> in the workspace — the
# workspace, because incoming/ is emptied once a photo is used, the relay's own
# archive is outside the client's wall, and the site is public. `db export`
# zips receipts/ into exports/<date>/receipts.zip beside ledger.csv, with the
# same paths the `photo` column holds, so `site handover` carries both.
#
# For machines (the weekly report, relay/weekly.py):
#   db ledger ls --month 2026-10 --json  -> {"month", "count", "total_cents", "by_category": [{category, count,
#                                           total_cents}], "rows": [receipt, …]}   (rows capped by --limit)
#   db ledger add VENDOR AMOUNT … --json -> {"receipt": …, "month": {month, count, total_cents}}; exit 3 +
#                                           {"error", "existing"} when the same vendor, date and amount is there
# A receipt is {id, date, month, vendor, amount_cents, category, note, photo, source, created_at, updated_at}.

LEDGER_COLS = ("id", "date", "month", "vendor", "amount_cents", "category", "note", "photo", "source",
               "created_at", "updated_at")
RECEIPTS_DIR = "receipts"
RECEIPT_TYPES = {".jpg", ".jpeg", ".png", ".webp", ".heic", ".gif", ".pdf"}
RECEIPT_MAX_BYTES = 20 * 1024 * 1024
LEDGER_CEILING_CENTS = 10_000_00   # over $10,000 needs --yes (check_ceiling)
MONTH_NAMES = {m.lower(): i for i, m in enumerate(
    ("January", "February", "March", "April", "May", "June", "July", "August", "September", "October",
     "November", "December"), 1)}


def the_ledger(a):
    site = the_site(a)
    if not has_table(site, a.local, "ledger"):
        die("this site has no ledger yet: `db add ledger` (PLAYBOOK.md § Files, receipts). Until then a receipt "
            "can't be filed; say so, and that it's one step to add.")
    return site


def month_arg(v, today=None):
    """'2026-09', '9/2026', 'september', 'sep 2026', 'this', 'last' -> '2026-09'; '' when it isn't a month.
    A month named without a year is the latest one that isn't in the future."""
    today = today or datetime.date.today()
    s = str(v or "").strip().lower()
    if s in ("this", "this month", "now"):
        return today.strftime("%Y-%m")
    if s in ("last", "last month"):
        return (today.replace(day=1) - datetime.timedelta(days=1)).strftime("%Y-%m")
    if m := re.fullmatch(r"(\d{4})-(\d{1,2})", s):
        y, mo = int(m.group(1)), int(m.group(2))
    elif m := re.fullmatch(r"(\d{1,2})/(\d{4})", s):
        mo, y = int(m.group(1)), int(m.group(2))
    elif m := re.fullmatch(r"([a-z]+)\.?(?:,?\s+(\d{4}))?", s):
        mo = next((i for name, i in MONTH_NAMES.items() if len(m.group(1)) >= 3 and name.startswith(m.group(1))), 0)
        y = int(m.group(2)) if m.group(2) else (today.year if mo <= today.month else today.year - 1)
    else:
        return ""
    return f"{y:04d}-{mo:02d}" if 1 <= mo <= 12 and 2000 <= y <= 2100 else ""


def month_label(month):
    try:
        return datetime.date.fromisoformat(month + "-01").strftime("%B %Y")
    except ValueError:
        return month


def receipt_line(r):
    try:
        day = datetime.date.fromisoformat(r["date"]).strftime("%b %-d, %Y")
    except (TypeError, ValueError):
        day = r.get("date") or "no date"
    return (f"#{r['id']} {day} {r['vendor']} {money_text(r['amount_cents'])}"
            + (f" ({r['category']})" if r.get("category") else "")
            + (f" — {r['note']}" if r.get("note") else "")
            + ("" if r.get("photo") else " [no photo]"))


def vendor_slug(vendor):
    return re.sub(r"[^a-z0-9]+", "-", str(vendor).lower()).strip("-")[:40] or "receipt"


def ws_file(site, path):
    """A file the run named, as a resolved path inside the workspace that is a regular file and no link."""
    p = Path(path)
    p = p if p.is_absolute() else Path.cwd() / p
    ws = site.ws.resolve()
    try:
        real = p.resolve(strict=True)
    except (OSError, RuntimeError):
        die(f"no such file: {path}")
    if not real.is_relative_to(ws):
        die(f"{path} is outside this workspace; a receipt photo is one sent here (incoming/…)")
    if p.is_symlink() or not real.is_file():
        die(f"{path} isn't a plain file")
    return real


def receipts_root(site, make=False):
    """The workspace's receipts/ (made when asked); refuses a receipts/ that is a link."""
    root = site.ws / RECEIPTS_DIR
    if root.is_symlink() or (root.exists() and not root.is_dir()):
        die(f"{RECEIPTS_DIR}/ in this workspace is not a plain folder; tell Taylor (FORWARD-TO-TAYLOR) and file the row without the photo")
    if make:
        root.mkdir(exist_ok=True)
    return root


def receipt_photo(site, src):
    """The photo a run named, checked (in the workspace, a plain file, a receipt's type, under the size cap)
    -> its resolved path. Called before anything is written, so a refused photo leaves no row behind."""
    real = ws_file(site, src)
    if real.suffix.lower() not in RECEIPT_TYPES:
        die(f"{src}: a receipt is a photo or a PDF ({', '.join(sorted(RECEIPT_TYPES))})")
    if real.stat().st_size > RECEIPT_MAX_BYTES:
        die(f"{src} is over {RECEIPT_MAX_BYTES // (1024 * 1024)} MB")
    receipts_root(site)
    return real


def keep_photo(site, src, day, vendor, rid):
    """Copy the receipt into receipts/<YYYY-MM>/ -> its workspace-relative path."""
    real = receipt_photo(site, src)
    ext = real.suffix.lower()
    folder = receipts_root(site, make=True) / day[:7]
    if folder.is_symlink():
        die(f"{RECEIPTS_DIR}/{day[:7]} is a link, not a folder; file the row without the photo and tell Taylor")
    folder.mkdir(exist_ok=True)
    dest = folder / f"{day}-{vendor_slug(vendor)}-{rid}{'.jpg' if ext == '.jpeg' else ext}"
    fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0), 0o644)
    with os.fdopen(fd, "wb") as out, open(real, "rb") as inp:
        shutil.copyfileobj(inp, out)
    return str(dest.relative_to(site.ws))


def check_ceiling(cents, a):
    """A receipt over LEDGER_CEILING_CENTS is more often a misread (a dropped decimal point: 8310 for 83.10)
    than a real bill, so it waits for --yes after the run has looked at the photo again."""
    if abs(cents) > LEDGER_CEILING_CENTS and not getattr(a, "yes", False):
        die(f"{money_text(cents)} is over {money_text(LEDGER_CEILING_CENTS)}, which on a receipt is more often a "
            f"misread decimal point than a real bill. Look at the total again; if it really is {money_text(cents)}, "
            f"add --yes")


def drop_photo(site, local, path):
    """Delete a kept photo no row points at any more (inside receipts/, a plain file) -> True if it went."""
    if not path:
        return False
    p = site.ws / path
    root = receipts_root(site).resolve()
    others = rows(site, local, f"SELECT COUNT(*) AS n FROM ledger WHERE photo = {lit(path)}")[0]["n"]
    if not others and not p.is_symlink() and p.is_file() and p.resolve().is_relative_to(root):
        p.unlink()
        return True
    return False


def receipt(site, local, rid):
    got = rows(site, local, f"SELECT {', '.join(LEDGER_COLS)} FROM ledger WHERE id = {int(rid)}")
    return got[0] if got else None


def month_total(site, local, month):
    r = rows(site, local, f"SELECT COUNT(*) AS n, COALESCE(SUM(amount_cents), 0) AS t FROM ledger WHERE month = {lit(month)}")[0]
    return {"month": month, "count": r["n"], "total_cents": r["t"]}


def cmd_ledger_add(a):
    site = the_ledger(a)
    vendor = " ".join(str(a.vendor).split())[:200]
    if not vendor:
        die("a receipt needs the vendor's name (as the receipt says it)")
    cents = money_cents(a.amount)
    if not cents:
        die(f"{a.amount!r}: a receipt needs its total (42.18); a refund is negative (-12.50)")
    check_ceiling(cents, a)
    day = iso_date(a.date) if a.date else datetime.date.today().isoformat()
    if not day:
        die(f"--date {a.date!r} isn't a date (2026-10-03, 10/3/2026, Oct 3, 2026)")
    if day > (datetime.date.today() + datetime.timedelta(days=1)).isoformat() and not a.force:
        die(f"--date {day} is after today. Check the date on the receipt (a misread year?); --force if it's right")
    if a.photo:
        receipt_photo(site, a.photo)                        # refuse a bad photo before anything is written
    same = rows(site, a.local, f"SELECT {', '.join(LEDGER_COLS)} FROM ledger WHERE date = {lit(day)} "
                               f"AND lower(vendor) = {lit(vendor.lower())} AND amount_cents = {cents} LIMIT 1")
    if same and not a.force:
        if a.json:
            emit_json({"error": "already filed", "existing": same[0]})
        else:
            print("db: already filed (the same vendor, date and amount): " + receipt_line(same[0])
                  + "\n  a second receipt like it really is two: add --force", file=sys.stderr)
        sys.exit(3)
    note = (a.note or "").strip()[:500] or None
    category = (a.category or "").strip().lower()[:60] or None
    res = d1(site, a.local, command=(
        "INSERT INTO ledger (date, vendor, amount_cents, category, note, source) VALUES ("
        + ", ".join(lit(v) for v in (day, vendor, cents, category, note, a.source or "text")) + ")"))
    rid = (res[-1].get("meta") or {}).get("last_row_id") or rows(site, a.local, "SELECT MAX(id) AS id FROM ledger")[0]["id"]
    if a.photo:
        path = keep_photo(site, a.photo, day, vendor, rid)
        d1(site, a.local, command=f"UPDATE ledger SET photo = {lit(path)} WHERE id = {int(rid)}")
    r = receipt(site, a.local, rid)
    m = month_total(site, a.local, day[:7])
    if a.json:
        emit_json({"receipt": r, "month": m})
        return
    say("filed " + receipt_line(r) + (f"\n  photo kept at {r['photo']}" if r.get("photo") else ""))
    say(f"  {month_label(m['month'])} so far: {money_text(m['total_cents'])} over {m['count']} receipt{'s' if m['count'] != 1 else ''}")
    if day < (datetime.date.today() - datetime.timedelta(days=400)).isoformat():
        say(f"  (the date is over a year ago: {day}. If the receipt is newer, fix it: db ledger set {rid} --date …)")


def ledger_where(a):
    where = []
    if a.month:
        m = month_arg(a.month)
        if not m:
            die(f"--month {a.month!r} isn't a month (2026-09, september, last)")
        where.append(f"month = {lit(m)}")
    if a.days:
        where.append(f"date >= {lit((datetime.date.today() - datetime.timedelta(days=a.days)).isoformat())}")
    if a.vendor:
        where.append(f"lower(vendor) LIKE {lit('%' + a.vendor.lower() + '%')}")
    if a.category:
        where.append(f"lower(category) = {lit(a.category.lower())}")
    if a.search:
        like = lit("%" + a.search.lower() + "%")
        where.append(f"(lower(vendor) LIKE {like} OR lower(COALESCE(note, '')) LIKE {like} "
                     f"OR lower(COALESCE(category, '')) LIKE {like})")
    return " WHERE " + " AND ".join(where) if where else ""


def cmd_ledger_ls(a):
    site = the_ledger(a)
    w = ledger_where(a)
    tot = rows(site, a.local, f"SELECT COUNT(*) AS n, COALESCE(SUM(amount_cents), 0) AS t FROM ledger{w}")[0]
    cats = rows(site, a.local, f"SELECT COALESCE(category, '') AS category, COUNT(*) AS count, "
                               f"SUM(amount_cents) AS total_cents FROM ledger{w} GROUP BY 1 ORDER BY 3 DESC")
    got = rows(site, a.local, f"SELECT {', '.join(LEDGER_COLS)} FROM ledger{w} ORDER BY date DESC, id DESC "
                              f"LIMIT {max(0, int(a.limit))}")
    month = month_arg(a.month) if a.month else None
    if a.json:
        emit_json({"month": month, "count": tot["n"], "total_cents": tot["t"], "by_category": cats, "rows": got})
        return
    what = month_label(month) if month else ("these" if w else "everything in the ledger")
    if not tot["n"]:
        say(f"no receipts {'like that' if w else 'yet'}" + (f" in {what}" if month else ""))
        return
    for r in got:
        say(receipt_line(r))
    if tot["n"] > len(got):
        say(f"… and {tot['n'] - len(got)} more (--limit)")
    say(f"{what}: {money_text(tot['t'])} over {tot['n']} receipt{'s' if tot['n'] != 1 else ''}")
    if len(cats) > 1:
        say("  by category: " + "; ".join(f"{c['category'] or 'none'} {money_text(c['total_cents'])}" for c in cats))


def cmd_ledger_set(a):
    site = the_ledger(a)
    r = receipt(site, a.local, a.id)
    if not r:
        die(f"no receipt #{a.id} (db ledger ls)", 4)
    sets = []
    if a.date:
        d = iso_date(a.date)
        if not d:
            die(f"--date {a.date!r} isn't a date")
        sets.append(f"date = {lit(d)}")
    if a.amount:
        c = money_cents(a.amount)
        if not c:
            die(f"{a.amount!r} isn't a total")
        check_ceiling(c, a)
        sets.append(f"amount_cents = {c}")
    for k in ("vendor", "category", "note"):
        v = getattr(a, k)
        if v is not None:
            v = v.strip()
            sets.append(f"{k} = {lit((v.lower() if k == 'category' else v) or None)}")
    if a.photo:
        path = keep_photo(site, a.photo, iso_date(a.date) if a.date else r["date"], a.vendor or r["vendor"], r["id"])
        sets.append(f"photo = {lit(path)}")
    if not sets:
        die("nothing to change: --date, --vendor, --amount, --category, --note or --photo")
    d1(site, a.local, command=f"UPDATE ledger SET {', '.join(sets)}, updated_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now') "
                              f"WHERE id = {int(r['id'])}")
    old = r.get("photo")
    r = receipt(site, a.local, r["id"])
    if a.photo and old and old != r.get("photo"):
        drop_photo(site, a.local, old)               # the replaced photo, so receipts.zip holds only live ones
    emit_json(r) if a.json else say("changed " + receipt_line(r))


def cmd_ledger_rm(a):
    site = the_ledger(a)
    r = receipt(site, a.local, a.id)
    if not r:
        die(f"no receipt #{a.id} (db ledger ls)", 4)
    d1(site, a.local, command=f"DELETE FROM ledger WHERE id = {int(r['id'])}")
    gone = f" and its photo ({r['photo']})" if drop_photo(site, a.local, r.get("photo")) else ""
    say(f"removed {receipt_line(r)}{gone}")


def zip_receipts(site, out, names):
    """EXPORT_HOOKS: with the ledger exported, receipts/ -> out/receipts.zip (plain files only, no links)."""
    if "ledger" not in names:
        return
    root = site.ws / RECEIPTS_DIR
    if not root.is_dir() or root.is_symlink():
        say("  receipts: no photos kept yet")
        missing_photos(site, out)
        return
    import zipfile
    n = 0
    with zipfile.ZipFile(out / "receipts.zip", "w", zipfile.ZIP_DEFLATED) as z:
        for d, dirs, files in os.walk(root, followlinks=False):
            dirs[:] = sorted(x for x in dirs if not (Path(d) / x).is_symlink())
            for f in sorted(files):
                p = Path(d) / f
                if p.is_symlink() or not p.is_file():
                    continue
                z.write(p, str(p.relative_to(site.ws)))
                n += 1
    say(f"  receipts: {n} photo{'s' if n != 1 else ''} -> exports/{out.name}/receipts.zip "
        f"(the paths inside match ledger.csv's photo column)")
    missing_photos(site, out)


def missing_photos(site, out):
    """Warn about rows whose photo column names a file that isn't on disk (deleted by hand, or a restore)."""
    try:
        got = json.loads((out / "ledger.json").read_text())
    except (OSError, ValueError):
        return
    gone = [r for r in got if r.get("photo") and not (site.ws / r["photo"]).is_file()]
    if gone:
        say(f"  receipts: {len(gone)} row{'s name' if len(gone) != 1 else ' names'} a photo that isn't in "
            f"receipts/ any more, so it's not in the zip: " + ", ".join(f"#{r['id']} {r['photo']}" for r in gone[:10])
            + (" …" if len(gone) > 10 else ""))


EXPORT_HOOKS.append(zip_receipts)


def cmd_ledger_export(a):
    the_ledger(a)
    cmd_export(a, only=("ledger",))


@subcommands("ledger", "receipts by photo: add, ls, set, rm, export")
def ledger_parser(p, common):
    s = p.add_subparsers(dest="action", required=True)
    d = s.add_parser("add", parents=[common], help="file a receipt (and keep its photo)")
    d.add_argument("vendor", help="who was paid, as the receipt says it"); d.add_argument("amount", help="the total: 42.18")
    d.add_argument("--date", help="the date on the receipt (default today)")
    d.add_argument("--category", help="the owner's word: fuel, supplies, equipment, vehicle, meals, other")
    d.add_argument("--note", help="what it was for: \"truck: oil change\"")
    d.add_argument("--photo", help="the photo or PDF in this workspace (incoming/…); a copy goes to receipts/")
    d.add_argument("--source", help="text (default), email, admin, import")
    d.add_argument("--force", action="store_true", help="file it even if the same one is there, or the date is ahead")
    d.add_argument("--yes", action="store_true", help="a total over $10,000 really is that much (checked against the photo)")
    d.add_argument("--json", action="store_true"); d.set_defaults(fn=cmd_ledger_add)
    ls = s.add_parser("ls", parents=[common], help="receipts and their total: --month, --vendor, --search …")
    ls.add_argument("--month", help="2026-09, september, last, this"); ls.add_argument("--days", type=int)
    ls.add_argument("--vendor"); ls.add_argument("--category")
    ls.add_argument("--search", help="vendor, note or category: \"truck\"")
    ls.add_argument("--limit", type=int, default=50); ls.add_argument("--json", action="store_true")
    ls.set_defaults(fn=cmd_ledger_ls)
    t = s.add_parser("set", parents=[common], help="fix one: --date, --vendor, --amount, --category, --note, --photo")
    t.add_argument("id", type=int)
    for k in ("date", "vendor", "amount", "category", "note", "photo"):
        t.add_argument(f"--{k}")
    t.add_argument("--yes", action="store_true", help="a total over $10,000 really is that much")
    t.add_argument("--json", action="store_true"); t.set_defaults(fn=cmd_ledger_set)
    r = s.add_parser("rm", parents=[common], help="remove one filed by mistake (its photo too)")
    r.add_argument("id", type=int); r.set_defaults(fn=cmd_ledger_rm)
    s.add_parser("export", parents=[common], help="the ledger and receipts.zip to exports/<date>/").set_defaults(fn=cmd_ledger_export)
# ---------------------------------------------------------------- bookings that finish the job (B119)
# The bookings collection's keys and upgrade. Two Pages secrets on the site:
#   BOOKING_KEY        signs the customer's manage links and the posts to
#                      patchlamp.com; derived, never stored: HMAC-SHA256 of
#                      "booking-mail:<slug>" under PATCHLAMP_RELAY_SHARED_SECRET,
#                      which is how patchlamp.com (App\Support\BookingSignature)
#                      derives the same one. Without it the site still takes
#                      bookings and the owner is mailed; the customer isn't.
#   BOOKINGS_FEED_KEY  the calendar feed's key, random, kept in the site's
#                      registry row (sites.json) as `bookings_feed_key` the way
#                      `site` keeps `indexnow_key`. Never printed except inside
#                      the subscribe address `db bookings feed` gives the owner.
#
#   db bookings setup [--dry-run]     both secrets on the Pages project (then site publish)
#   db bookings feed [--new] [--json] the owner's subscribe address and how to add it
#   db bookings upgrade [--dry-run]   the collection's Functions brought up to the toolbelt's
#   db bookings status [--json]       what's on: the key, the feed, the files (no key shown)
#   db bookings confirm|cancel|remind ID [--json]
#   db bookings move ID "YYYY-MM-DDTHH:MM" [--json]
#                                     a change by text, run by the site itself (functions/api/bookings/[id].js):
#                                     the same capacity check and customer mail as /admin. POSTs JSON
#                                     {"action", "starts_at"?, "ts"} to <site>/api/bookings/<id>, signed
#                                     X-Booking-Signature: hex(HMAC-SHA256(BOOKING_KEY, "api|" + body)).
#                                     The contract: ~/projects/plans/49-the-customer-side.md § Site endpoint.
#                                     --json prints the site's answer as is; exit 0 on ok, 1 when the site
#                                     refused (the reason and, for a move, the open times), 2 when unreachable.
#                                     BOOKINGS_SITE_URL overrides the site's address (tests, `wrangler pages dev`).

import hashlib  # noqa: E402
import hmac  # noqa: E402
import secrets  # noqa: E402
import time  # noqa: E402

BOOKINGS = COLLECTIONS / "bookings"
OLD_THANKS = "Booked — we've got you down and we'll confirm by email or phone."
NEW_THANKS = ("Got it, your request is in. We'll confirm by email or phone, and if you left an email, "
              "a copy with a link to move or cancel it is on its way.")


def booking_key(slug):
    env = read_env()
    secret = os.environ.get("PATCHLAMP_RELAY_SHARED_SECRET") or env.get("PATCHLAMP_RELAY_SHARED_SECRET")
    if not secret:
        die("PATCHLAMP_RELAY_SHARED_SECRET is not in the toolbelt, so there's no booking key to give the site. "
            "Bookings still work and the owner is still mailed; the customer's mails wait on it (Taylor: setenv.sh).")
    return hmac.new(secret.encode(), f"booking-mail:{slug}".encode(), hashlib.sha256).hexdigest()


def bookings_site(a):
    site = the_site(a)
    if not any(p.name.endswith("_bookings.sql") for p in repo_migrations(site)):
        die(f"repos/{site.name} has no bookings yet: `db add bookings` first (PLAYBOOK.md § Data)")
    return site


def site_url(site):
    """The site's own address: the client's live URL, else its Pages host."""
    live = (site.meta.get("live_url") or "").strip()
    if live:
        return live.rstrip("/")
    return f"https://{site.row.get('pages_host') or (site.project or site.name) + '.pages.dev'}"


def registry_save(reg):
    REGISTRY.parent.mkdir(parents=True, exist_ok=True)
    tmp = REGISTRY.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(reg, indent=2, sort_keys=True) + "\n")
    tmp.replace(REGISTRY)


def feed_key(site, new=False):
    """The feed key from the registry row, made (and saved) when there's none or --new."""
    reg = registry()
    row = reg.setdefault(site.meta["slug"], {}).setdefault(site.name, {})
    if new or not row.get("bookings_feed_key"):
        row["bookings_feed_key"] = secrets.token_hex(20)
        registry_save(reg)
        site.row["bookings_feed_key"] = row["bookings_feed_key"]
        return row["bookings_feed_key"], True
    return row["bookings_feed_key"], False


def pages_secrets(site, values, dry, say=say):
    """Set Pages secrets on the site's project (production and preview); values never printed."""
    names = ", ".join(sorted(values))
    if dry or FAKE:
        say(f"  {'would set' if dry else 'set (test stand-in: no Cloudflare call)'} Pages secrets {names} on {site.project}")
        return
    tok, acct = cf_creds()
    if not (tok and acct):
        die("CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID are not in the toolbelt (Taylor: setenv.sh)")
    env = {k: {"type": "secret_text", "value": v} for k, v in values.items()}
    body = json.dumps({"deployment_configs": {"production": {"env_vars": env}, "preview": {"env_vars": env}}}).encode()
    req = urllib.request.Request(f"{CF_API}/accounts/{acct}/pages/projects/{site.project}", data=body, method="PATCH",
                                 headers={"Authorization": f"Bearer {tok}", "Content-Type": "application/json",
                                          "User-Agent": "claude-tools db"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            ok = json.loads(r.read().decode()).get("success")
    except urllib.error.HTTPError as exc:
        die(f"Cloudflare refused the secrets ({exc.code}); nothing else changed. `db doctor` shows the token's reach.")
    except (urllib.error.URLError, OSError) as exc:
        die(f"Cloudflare unreachable: {exc}")
    if not ok:
        die("Cloudflare didn't take the secrets; nothing else changed")
    say(f"  set Pages secrets {names} on {site.project} (values never shown)")


def pages_secret_names(site):
    """The env var names on the Pages project (production), or None when it can't be read."""
    if FAKE:
        return None
    code, res = cf_get(f"/pages/projects/{site.project}")
    if code != 200:
        return None
    return set(((res.get("deployment_configs") or {}).get("production") or {}).get("env_vars") or {})


def cmd_bookings_setup(a):
    site = bookings_site(a)
    say(f"bookings setup for repos/{site.name} (Pages project {site.project})")
    values = {"BOOKING_KEY": booking_key(site.meta["slug"])}
    if a.dry_run and not site.row.get("bookings_feed_key"):
        say(f"  would make the calendar feed's key and keep it in {REGISTRY.name}")
        values["BOOKINGS_FEED_KEY"] = "(new)"
    else:
        key, made = feed_key(site) if not a.dry_run else (site.row["bookings_feed_key"], False)
        if made:
            say(f"  made the calendar feed's key, kept in {REGISTRY.name} (not shown)")
        values["BOOKINGS_FEED_KEY"] = key
    pages_secrets(site, values, a.dry_run)
    behind = bookings_behind(site)
    if behind:
        say(f"  note: {len(behind)} bookings file(s) are older than the toolbelt's: `db bookings upgrade` first")
    say(f"next: `site publish {site.name}` (a secret reaches the Functions from the next deploy), then "
        f"`db bookings feed` for the owner's calendar address")


def cmd_bookings_feed(a):
    site = bookings_site(a)
    key, made = feed_key(site, new=a.new)
    if made:
        pages_secrets(site, {"BOOKINGS_FEED_KEY": key}, False,
                      say=(lambda m: print(m, file=sys.stderr)) if a.json else say)
    url = f"{site_url(site)}/api/bookings.ics?key={key}"
    webcal = "webcal://" + url.split("://", 1)[1]
    if a.json:
        emit_json({"url": url, "webcal": webcal, "new_key": made})
        return
    if made:
        say(f"(a {'new' if a.new else 'first'} feed key: it works once `site publish {site.name}` has run"
            + ("; the old address stops working then" if a.new else "") + ")\n")
    say(f"""Your bookings calendar. Subscribe once and every confirmed booking shows up on your phone.
Keep this address to yourself: anyone with it can read your bookings.

{url}

Google Calendar (on a computer): Settings > Add calendar > From URL, paste it, Add calendar.
  It then shows on your phone's Google Calendar too. Google refreshes it every few hours.
iPhone: Settings > Calendar > Accounts > Add Account > Other > Add Subscribed Calendar,
  paste it ({webcal}). Apple Calendar on a Mac: File > New Calendar Subscription.
Outlook: Add calendar > Subscribe from web, paste it.

It's one way: bookings go onto your calendar; your own appointments don't close times on the site.""")


def bookings_files():
    """The collection's own code: every Function but the /admin views (those are the site's to rename)."""
    src = BOOKINGS / "functions"
    return [f for f in sorted(src.rglob("*")) if f.is_file() and f.parent.name != "_admin"]


def bookings_behind(site):
    src = BOOKINGS / "functions"
    out = []
    for f in bookings_files():
        dest = site.repo / "functions" / f.relative_to(src)
        rel = f.relative_to(src)
        if rel == Path("_lib/customers.js") and dest.exists():
            continue                           # the customer book's own copy; `db add customers` owns it
        if not dest.exists() or dest.read_bytes() != f.read_bytes():
            out.append(str(Path("functions") / rel))
    return out


# The bookings Functions as the toolbelt shipped them before (sha256), so an
# upgrade can tell the template's old copy from one someone changed by hand.
# Read from the toolbelt's own git history; this one is the fallback when git
# isn't there (a66f09d's api/bookings.js, the only file before B119).
KNOWN_OLD = {"6b02bc961d4f29d61de3ca2d904be1641c25d1d694d8e1a3d09e8152e8594ec4"}


def shipped_versions(rel):
    """sha256 of every version of templates/collections/bookings/functions/<rel> the toolbelt has committed."""
    path = f"templates/collections/bookings/functions/{rel}"
    out = set(KNOWN_OLD)
    try:
        revs = subprocess.run(["git", "-C", str(HERE), "log", "--format=%H", "--", path],
                              capture_output=True, text=True, timeout=20).stdout.split()
        for rev in revs:
            blob = subprocess.run(["git", "-C", str(HERE), "show", f"{rev}:{path}"], capture_output=True, timeout=20)
            if blob.returncode == 0:
                out.add(hashlib.sha256(blob.stdout).hexdigest())
    except (OSError, subprocess.SubprocessError):
        pass
    return out


def customised(site, rel):
    """True when the site's copy exists and is neither the toolbelt's current one nor any it shipped before."""
    dest = site.repo / rel
    if not dest.exists():
        return False
    return hashlib.sha256(dest.read_bytes()).hexdigest() not in shipped_versions(str(Path(rel).relative_to("functions")))


def old_thanks(site):
    """The pages still carrying the calendar's old thanks line (it said nothing of the email)."""
    return [p for p in sorted(site.repo.rglob("*.html")) if ".wrangler" not in p.parts and OLD_THANKS in p.read_text(errors="replace")]


def cmd_bookings_upgrade(a):
    site = bookings_site(a)
    behind = bookings_behind(site)
    pages = old_thanks(site)
    for p in pages:
        if not a.dry_run:
            p.write_text(p.read_text().replace(OLD_THANKS, NEW_THANKS))
        say(f"  {'would say' if a.dry_run else 'said'} the email and the link in the thanks line of repos/{site.name}/{p.relative_to(site.repo)}")
    if not behind and not pages:
        say(f"repos/{site.name}: the bookings Functions are the toolbelt's already")
        return
    src = BOOKINGS / "functions"
    kept = [] if a.force else [rel for rel in behind if customised(site, rel)]
    for rel in kept:
        # someone changed this one by hand (a question added, a word changed): overwriting it would lose that
        say(f"  kept repos/{site.name}/{rel}: it isn't any copy the toolbelt shipped, so someone changed it. "
            f"Compare it with {BOOKINGS.relative_to(HERE)}/{Path(rel).relative_to('functions')} and carry the change over, "
            f"or `db bookings upgrade --force` to replace it")
    for rel in [r for r in behind if r not in kept]:
        f = src / Path(rel).relative_to("functions")
        dest = site.repo / rel
        if not a.dry_run:
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(f, dest)
        say(f"  {'would write' if a.dry_run else 'wrote'} repos/{site.name}/{rel}")
    if a.dry_run:
        say("dry run: nothing written")
        return
    say(f"next: commit, `git -C repos/{site.name} push`, `db bookings setup`, `site publish {site.name}`")


def cmd_bookings_status(a):
    site = bookings_site(a)
    names = pages_secret_names(site)
    st = {
        "files_behind": bookings_behind(site),
        "feed_key_in_registry": bool(site.row.get("bookings_feed_key")),
        "pages_secrets": None if names is None else {k: k in names for k in ("BOOKING_KEY", "BOOKINGS_FEED_KEY")},
    }
    if a.json:
        emit_json(st)
        return
    say(f"bookings on repos/{site.name}:")
    say(f"  files: {'up to date' if not st['files_behind'] else ', '.join(st['files_behind']) + ' behind (db bookings upgrade)'}")
    say(f"  calendar feed: {'a key in the registry (db bookings feed gives the address)' if st['feed_key_in_registry'] else 'none yet (db bookings setup)'}")
    if names is None:
        say("  Pages secrets: not read (no Cloudflare access from here)")
    else:
        for k, on in st["pages_secrets"].items():
            say(f"  {k}: {'set' if on else 'not set (db bookings setup)'}")


def cmd_bookings_change(a):
    """confirm / move / cancel / remind one booking through the site's own signed endpoint."""
    if not re.fullmatch(r"\d{1,12}", a.id):
        die(f"{a.id!r} isn't a booking id (the number on /admin/bookings, or `db query \"SELECT id, name, starts_at FROM bookings\"`)")
    payload = {"action": a.change}
    if a.change == "move":
        at = a.starts_at.strip().replace(" ", "T")[:16]
        if not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d", at):
            die(f"{a.starts_at!r}: give the new time as YYYY-MM-DDTHH:MM in the site's own time (\"2026-10-14T15:00\")")
        payload["starts_at"] = at
    site = bookings_site(a)
    key = booking_key(site.meta["slug"])
    payload["ts"] = int(time.time())
    body = json.dumps(payload, separators=(",", ":"))
    sig = hmac.new(key.encode(), ("api|" + body).encode(), hashlib.sha256).hexdigest()
    base = (os.environ.get("BOOKINGS_SITE_URL") or site_url(site)).rstrip("/")
    req = urllib.request.Request(f"{base}/api/bookings/{a.id}", data=body.encode(), method="POST", headers={
        "Content-Type": "application/json", "Accept": "application/json", "X-Booking-Signature": sig,
        "User-Agent": "claude-tools db"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            code, raw = r.status, r.read().decode()
    except urllib.error.HTTPError as exc:
        code, raw = exc.code, exc.read().decode(errors="replace")
    except (urllib.error.URLError, OSError) as exc:
        die(f"couldn't reach {base}: {exc}. Nothing changed; try again, or the owner can do it on /admin/bookings", 2)
    try:
        res = json.loads(raw)
    except ValueError:
        res = {"ok": False, "error": f"the site answered {code} without JSON"
               + (": it may not have the bookings upgrade yet (db bookings status)" if code in (404, 405) else "")}
    if a.json:
        emit_json(res)
        sys.exit(0 if res.get("ok") else 1)
    if not res.get("ok"):
        hint = {401: " (the site's BOOKING_KEY isn't this one: db bookings setup, then site publish)",
                503: ""}.get(code, "")
        lines = [f"db: booking {a.id}: {res.get('error') or code}{hint}"]
        for o in res.get("open") or []:
            lines.append(f"  open: {o.get('starts_at')}{(' · ' + o['label']) if o.get('label') else ''} ({o.get('places')} place(s))")
        print("\n".join(lines), file=sys.stderr)
        sys.exit(1)
    b = res.get("booking") or {}
    done = {"confirm": "confirmed", "move": "moved", "cancel": "cancelled", "remind": "reminded"}[a.change]
    when = b.get("starts_at", "")
    say(f"booking {b.get('id', a.id)} ({b.get('name', '')}, {when}) {done}"
        + (f" (was {b['was']})" if b.get("was") else "") + ".")
    if res.get("customer_mailed"):
        say("  the customer is emailed" + (" a reminder" if a.change == "remind" else "") + ".")
    else:
        say(f"  the customer is NOT emailed: {res.get('why') or 'no reason given'}.")


def bookings_doctor(site, local, fail):
    """db doctor's bookings lines: the files, the feed (that it exists, never the key), the two secrets."""
    if not any(p.name.endswith("_bookings.sql") for p in repo_migrations(site)):
        return
    behind = bookings_behind(site)
    say("  bookings: Functions " + ("up to date" if not behind else f"{len(behind)} file(s) behind (db bookings upgrade)"))
    say("  bookings: calendar feed " + ("on (key in the registry; db bookings feed gives the address)"
                                        if site.row.get("bookings_feed_key") else "not set up (db bookings setup)"))
    names = None if local else pages_secret_names(site)
    if names is not None:
        missing = [k for k in ("BOOKING_KEY", "BOOKINGS_FEED_KEY") if k not in names]
        if missing:
            say(f"  note: bookings: {', '.join(missing)} not on the Pages project, so customers get no mail or the feed is "
                f"off (db bookings setup, then site publish)")
        else:
            say("  bookings: BOOKING_KEY and BOOKINGS_FEED_KEY set (customers are mailed; values not shown)")


@subcommands("bookings", "bookings: setup (the keys), feed (the owner's calendar), upgrade, status, confirm/move/cancel/remind")
def bookings_parser(p, common):
    s = p.add_subparsers(dest="action", required=True)
    u = s.add_parser("setup", parents=[common], help="the booking key and the feed key as Pages secrets")
    u.add_argument("--dry-run", action="store_true"); u.set_defaults(fn=cmd_bookings_setup)
    f = s.add_parser("feed", parents=[common], help="the owner's calendar subscribe address and how to add it")
    f.add_argument("--new", action="store_true", help="a new key; the old address stops after the next publish")
    f.add_argument("--json", action="store_true"); f.set_defaults(fn=cmd_bookings_feed)
    g = s.add_parser("upgrade", parents=[common], help="the bookings Functions brought up to the toolbelt's")
    g.add_argument("--dry-run", action="store_true")
    g.add_argument("--force", action="store_true", help="replace a file someone changed by hand too")
    g.set_defaults(fn=cmd_bookings_upgrade)
    for name, what in (("confirm", "confirm a requested booking; the customer is emailed"),
                       ("cancel", "cancel it, the place freed; the customer is emailed"),
                       ("remind", "the reminder email for a confirmed booking still ahead")):
        c = s.add_parser(name, parents=[common], help=what)
        c.add_argument("id")
        c.add_argument("--json", action="store_true"); c.set_defaults(fn=cmd_bookings_change, change=name)
    m = s.add_parser("move", parents=[common], help="move it to an open time; the customer is emailed the new one")
    m.add_argument("id"); m.add_argument("starts_at", help='the open time, "2026-10-14T15:00"')
    m.add_argument("--json", action="store_true"); m.set_defaults(fn=cmd_bookings_change, change="move")
    t = s.add_parser("status", parents=[common], help="the key, the feed, the files (no key shown)")
    t.add_argument("--json", action="store_true"); t.set_defaults(fn=cmd_bookings_status)


# ---------------------------------------------------------------- doctor

def toml_binding(repo):
    p = repo / "wrangler.toml"
    if not p.exists():
        return None, "no wrangler.toml"
    try:
        conf = tomllib.loads(p.read_text())
    except tomllib.TOMLDecodeError as exc:
        return None, f"wrangler.toml doesn't parse ({exc})"
    for b in conf.get("d1_databases") or []:
        if b.get("binding") == "DB":
            return b, None
    return None, "wrangler.toml has no [[d1_databases]] binding = \"DB\""


def cmd_doctor(a):
    ok = True

    def fail(msg):
        nonlocal ok
        ok = False
        say(f"  FAIL {msg}")

    say("== tools")
    say(f"  wrangler: {'present' if WRANGLER.exists() else 'MISSING (claude-tools/install.sh)'}")
    if not WRANGLER.exists():
        ok = False
    say(f"  collections: {', '.join(d.name for d in sorted(COLLECTIONS.iterdir()) if collection_info(d.name))}")
    if not FAKE:
        code, res = cf_get("/d1/database?per_page=1")
        if code == 200:
            say("  D1 API: ok (the token can manage databases)")
        elif code in (401, 403):
            fail("D1 API: the toolbelt's Cloudflare token has no D1 permission — TAYLOR-TODO §1 "
                 "\"Give the Cloudflare token D1\" (Account · D1 · Edit)")
        else:
            fail(f"D1 API: {res}")
    if not (Path.cwd() / ".client.json").exists():
        say("== not in a client workspace (cd ~/projects/clients/<slug> for the database checks)")
        sys.exit(0 if ok else 1)
    site = the_site(a, need=False)
    if not site:
        _, meta = workspace()
        say(f"== {meta['slug']}: no site here has a database (fine: a form alone doesn't need one)")
        sys.exit(0 if ok else 1)
    say(f"== {site.meta['slug']} / {site.name}: D1 {site.db_name} ({site.d1.get('id') or 'no id'})")
    b, err = toml_binding(site.repo)
    if err:
        fail(f"repos/{site.name}: {err} (site data {site.name} writes it)")
    elif b.get("database_id") != site.d1.get("id") or b.get("database_name") != site.db_name:
        fail(f"repos/{site.name}/wrangler.toml binds {b.get('database_name')} ({b.get('database_id')}), "
             f"the registry says {site.db_name} ({site.d1.get('id')})")
    else:
        say("  binding: wrangler.toml DB = the registry's database")
    if not FAKE and not a.local:
        code, res = cf_get(f"/d1/database/{site.d1.get('id')}")
        if code == 200:
            say(f"  database: reachable, {res.get('num_tables', '?')} tables, {int(res.get('file_size') or 0) // 1024} KB")
        else:
            fail(f"database {site.db_name}: {res}")
    files = repo_migrations(site)
    try:
        done = applied(site, a.local, create=False)
        missing = [p.name for p in files if p.name not in done]
        stray = [n for n in done if n not in {p.name for p in files}]
        if missing:
            fail(f"migrations not applied: {', '.join(missing)} (db migrate)")
        if stray:
            fail(f"applied but not in the repo: {', '.join(stray)}")
        if not missing and not stray:
            say(f"  migrations: {len(files)} in the repo, {len(done)} applied")
    except SystemExit:
        fail("could not read d1_migrations (see the line above)")
    fn = site.repo / "functions"
    if not (fn / "_lib" / "core.js").exists() or not (fn / "admin" / "_middleware.js").exists():
        fail(f"repos/{site.name}/functions/ is missing the admin shell (site data {site.name})")
    views = registered_views(site.repo)
    lost = [mod for _, mod in views if not (fn / "_admin" / f"{mod}.js").exists()]
    if lost:
        fail(f"functions/_admin/collections.js imports missing view(s): {', '.join(lost)}")
    else:
        kinds = view_kinds(site.repo)
        say(f"  /admin shows: {', '.join(mod + (' (tool)' if k == 'tool' else '') for mod, _, k in kinds) or '(nothing yet — db add <collection>)'}")
        missing_t = [mod for mod, m, _ in kinds if not m["table"]]
        if missing_t:
            fail(f"view(s) with no table: {', '.join(missing_t)} (a view names its table: `table: \"…\"`)")
    shell = HERE / "templates" / "sites" / "_shell" / "functions"
    behind = [str(f.relative_to(shell.parent)) for f in sorted(shell.rglob("*")) if f.is_file()
              and f.name != "collections.js" and (not (site.repo / f.relative_to(shell.parent)).exists()
                                                 or (site.repo / f.relative_to(shell.parent)).read_bytes() != f.read_bytes())]
    if behind:
        say(f"  note: the /admin shell is {len(behind)} file(s) behind the toolbelt's: `site shell {site.name}` brings it up")
    if not FAKE and site.project and not a.local:
        code, res = cf_get(f"/pages/projects/{site.project}")
        if code == 200:
            env = ((res.get("deployment_configs") or {}).get("production") or {}).get("env_vars") or {}
            need = [k for k in ("SESSION_SECRET", "ADMIN_EMAIL") if k not in env]
            if need:
                fail(f"Pages secret(s) not set on {site.project}: {', '.join(need)} (site data {site.name})")
            else:
                say("  secrets: SESSION_SECRET, ADMIN_EMAIL set on the Pages project (values not shown)")
        else:
            fail(f"Pages project {site.project}: {res}")
    bookings_doctor(site, a.local, fail)
    owner, contact = site.d1.get("owner"), site.meta.get("contact_email")
    if owner and contact and owner.lower() != contact.lower():
        fail(f"/admin signs in {owner} but the sign-in email goes to the contact address {contact} "
             f"(site data {site.name} --owner {contact}, or newsletter setup --contact {owner})")
    elif owner:
        say(f"  owner: {owner} (the sign-in link goes there)")
    sys.exit(0 if ok else 1)


def main():
    ap = argparse.ArgumentParser(prog="db", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--site", help="which site's database, when the workspace has more than one")
    common.add_argument("--local", action="store_true", help="the local copy (wrangler pages dev), not the live database")
    sub = ap.add_subparsers(dest="cmd", required=True)
    m = sub.add_parser("migrate", parents=[common], help="apply the repo's migrations not yet applied")
    m.add_argument("--dry-run", action="store_true"); m.set_defaults(fn=cmd_migrate)
    q = sub.add_parser("query", parents=[common], help="read: SELECT / WITH / PRAGMA / EXPLAIN")
    q.add_argument("sql"); q.add_argument("--json", action="store_true"); q.set_defaults(fn=cmd_query)
    e = sub.add_parser("exec", parents=[common], help="write; DROP / DELETE-without-WHERE need --yes")
    e.add_argument("sql"); e.add_argument("--yes", action="store_true"); e.add_argument("--dry-run", action="store_true")
    e.set_defaults(fn=cmd_exec)
    x = sub.add_parser("export", parents=[common], help="every table to exports/<date>/ as CSV and JSON")
    x.set_defaults(fn=cmd_export)
    i = sub.add_parser("import", parents=[common], help="rows from a CSV (header row) or JSON list into a table")
    i.add_argument("table"); i.add_argument("file"); i.add_argument("--dry-run", action="store_true")
    i.set_defaults(fn=cmd_import)
    ad = sub.add_parser("add", parents=[common], help="add a standard collection (migration, Function, /admin view)")
    ad.add_argument("collection", help="a collection (db collections), or with --from-sheet the new table's name")
    ad.add_argument("--no-migrate", action="store_true"); ad.add_argument("--dry-run", action="store_true")
    ad.add_argument("--from-sheet", metavar="FILE", help="a web tool from a CSV or Excel sheet's header row (B40)")
    ad.add_argument("--sheet", help="which sheet of an Excel file (default: the first with rows)")
    ad.add_argument("--title", help="what /admin calls the list (default: the name, capitalised)")
    ad.add_argument("--singular", help="what one row is called (item, stop)")
    ad.add_argument("--statuses", help='the statuses, first is the default: "in stock,discontinued"')
    ad.add_argument("--no-import", action="store_true", help="make the table and view, leave the rows out")
    ad.set_defaults(fn=cmd_add)
    sub.add_parser("collections", parents=[common], help="what can be added; what this site has").set_defaults(fn=cmd_collections)
    sub.add_parser("tools", parents=[common], help="every list /admin shows: collection, named list or web tool").set_defaults(fn=cmd_tools)
    sub.add_parser("doctor", parents=[common], help="token, binding, migrations, secrets, /admin").set_defaults(fn=cmd_doctor)
    for name, (hlp, build) in SUBCOMMANDS.items():
        build(sub.add_parser(name, help=hlp), common)
    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
