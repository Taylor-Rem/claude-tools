#!/usr/bin/env python3
"""
img — Claude's image toolbelt. Stock photos (Pexels) and generation (Gemini).

    img stock "chicken tikka masala" [-n 5] [--orientation landscape] [--out DIR] [--page 2]
    img gen "prompt" [--style plateful-menu] [--quality menu|hero|pro|draft] [--aspect 4:3] [--ref photo.jpg] [--out FILE]
    img edit photo.jpg "put a party hat on him" [--quality ...] [--out FILE]   # instructed edit of a real photo
    img video "prompt" [--quality draft|good|pro] [--seconds 4|6|8] [--aspect 16:9|9:16] [--ref first-frame.jpg] [--dry-run]
    img styles                       # list style presets
    img info FILE...                 # dimensions + sidecar metadata

Keys: the environment first (a non-empty $GEMINI_API_KEY / $PEXELS_API_KEY —
the relay sets a per-client key this way), then ~/.config/claude-tools/env. The
key values are read here and never printed. When the environment supplies the
key, $GEMINI_API_KEY_NAME (set by the relay) says which toolbelt key that was,
so the ledger line records who paid by *name*: billed_to "gemini:<key name>".
Every downloaded/generated image gets
a sidecar <name>.json recording where it came from (photographer, Pexels URL,
prompt, model) so credit and provenance are never lost.

Video is the expensive one: seconds, not images. `img video --dry-run` prints
the model, the length and the price without generating anything -- use it
before spending, and see VIDEO_QUALITY below for what a clip costs.

Every generated image is also a billable event: `img gen` appends one JSON line
per image to the ledger (~/.local/state/claude-tools/ledger.jsonl, or $IMG_LEDGER,
or --ledger PATH; --no-ledger to skip) with the estimated cost and the project it
was for ($PF_RESTAURANT, else the cwd). The relay's `./relay.py costs` reads it.

Output defaults to ~/.cache/claude-tools/img/<slug>/ and every path printed is
absolute, so the caller can Read the files to review them.
"""

import argparse
import base64
import calendar
import json
import os
import re
import shutil
import struct
import subprocess
import sys
import time
from pathlib import Path

import requests

ENV_FILE = Path(os.environ.get("CLAUDE_TOOLS_ENV", Path.home() / ".config/claude-tools/env"))
STYLES_FILE = Path.home() / ".config/claude-tools/img-styles.json"
OUT_ROOT = Path(os.environ.get("IMG_OUT_ROOT", Path.home() / ".cache/claude-tools/img"))
LEDGER = Path(os.environ.get("IMG_LEDGER", Path.home() / ".local/state/claude-tools/ledger.jsonl"))

PEXELS_SEARCH = "https://api.pexels.com/v1/search"
GEMINI_URL = "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent"

# Which model for which job. Prices are paid-tier per image (Sept 2026).
#   draft  — throwaway: exploring prompts/styles, checking composition.
#   menu   — DEFAULT. Menu items, about/gallery shots. Plateful serves 800px
#            medium variants so 1K is all the pixels that will ever be shown.
#   hero   — full-width banners (Plateful hero = 1200w): needs 2K.
#   pro    — anything with text/logos, a paying client's hero, or when flash
#            has missed the brief twice. ~2x the price; don't default to it.
QUALITY = {
    "draft": {"model": "gemini-3.1-flash-lite-image", "size": "1K", "usd": 0.034},
    "menu":  {"model": "gemini-3.1-flash-image",      "size": "1K", "usd": 0.067},
    "hero":  {"model": "gemini-3.1-flash-image",      "size": "2K", "usd": 0.101},
    "pro":   {"model": "gemini-3-pro-image",          "size": "2K", "usd": 0.134},
}
GEMINI_MODEL = os.environ.get("IMG_GEN_MODEL")  # explicit override beats --quality

# Video (Veo 3.1, Sept 2026 paid-tier rates, per SECOND -- a clip is 10-50x an
# image, which is the whole reason --dry-run exists).
#   draft — lite 720p, $0.05/s: 4s = $0.20. The one to reach for.
#   good  — fast 720p, $0.10/s: 4s = $0.40. Better motion and prompt-following.
#   pro   — standard 1080p, $0.40/s: 8s = $3.20. Only when it's going somewhere real.
# Veo always writes audio. 1080p and 4K are 8s only; lite has no 4K.
VIDEO_QUALITY = {
    "draft": {"model": "veo-3.1-lite-generate-preview", "resolution": "720p",  "usd_per_s": 0.05},
    "good":  {"model": "veo-3.1-fast-generate-preview", "resolution": "720p",  "usd_per_s": 0.10},
    "pro":   {"model": "veo-3.1-generate-preview",      "resolution": "1080p", "usd_per_s": 0.40},
}
VIDEO_MODEL = os.environ.get("IMG_VIDEO_MODEL")       # explicit override beats --quality

# House rules, set by whoever runs the tool (the relay sets them per room, per
# person) so a prompt can't talk its way past them -- they are checked here,
# before anything is spent:
#   IMG_VIDEO_MAX_SECONDS   longest clip allowed
#   IMG_VIDEO_MAX_RESOLUTION  720p / 1080p -- anything higher is clamped down
#   IMG_VIDEO_MAX_USD       refuse a clip that would cost more than this
#   IMG_VIDEO_WHO           who this run is for; the daily cap counts per person
#   IMG_VIDEO_WHO_LABEL     their name, for the refusal message
#   IMG_VIDEO_DAILY_CAP     how many videos that person gets per 24h
VEO_URL = "https://generativelanguage.googleapis.com/v1beta/models/{model}:predictLongRunning"
VEO_OP_URL = "https://generativelanguage.googleapis.com/v1beta/{op}"
VEO_POLL_SECONDS = 10
VEO_TIMEOUT_SECONDS = 300      # under a chat room's 480s run timeout, so a stuck
                               # generation fails as a tool error, not a dead run
DISCORD_ATTACH_LIMIT_MB = 10          # what a plain Discord server takes; bigger needs a link

# `--from`: Veo can't edit an existing video (no video-to-video; extension is
# Veo-generated clips only). What it can do is start from one frame. So a
# "remake" is: Gemini watches the clip and writes what's in it, the change the
# caller wants is folded into that description, and the clip's first frame
# anchors the generation. The result is the same room and the same subject
# doing something new -- not the original footage, and it says so.
DESCRIBE_MODEL = os.environ.get("IMG_DESCRIBE_MODEL", "gemini-3.6-flash")
DESCRIBE_URL = "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent"
DESCRIBE_MAX_MB = 15                  # bigger than this and a small proxy copy is described instead
DESCRIBE_PROMPT = (
    "Watch this video and write a single-paragraph shot description for a video generator: the setting, "
    "who or what is in frame and exactly what they look like, the camera (angle, height, movement, how it's "
    "held), the lighting and the look of the footage, and what happens over the clip. Be concrete and "
    "visual; no commentary, no lists, no preamble. Then continue the description so that this happens: "
    "{ask}. Write the whole thing as one continuous shot description, present tense."
)
# The frame a remake starts from decides what Veo thinks the subjects look
# like, so the model that just watched the clip picks it: the last moment where
# everything that matters is visible, before the action. Frame 0 is often the
# worst choice -- the cat is still off-screen.
START_FRAME_PROMPT = (
    "\n\nAlso choose the single best frame of the ORIGINAL video to generate from: the latest moment "
    "where every subject that matters (people, animals, the thing being acted on) is clearly visible, "
    "before the new action starts. Answer as JSON: "
    '{{"description": "<the shot description>", "start_seconds": <number>, "frame_note": "<what is visible '
    'at that moment, one short line>"}}'
)
WATCH_PROMPT = (
    "Watch this video and describe it for someone who can't see it: where it is, who or what is in it and "
    "what they look like, what actually happens, how it's shot and how it feels (funny, chaotic, staged, "
    "dull). Concrete and specific, two or three sentences, no preamble, no lists. Mention anything "
    "genuinely notable -- a fail, a reaction, something in the background. If there's speech, say what is "
    "said.{ask}"
)

# Pexels src sizes. large2x = 1880w, comfortably under Plateful's 2000px original cap.
PEXELS_SIZES = ("original", "large2x", "large", "medium", "small", "portrait", "landscape", "tiny")


# ---------------------------------------------------------------- helpers

def ledger_append(path, event):
    """One JSON line per billable image. Best effort: a ledger problem never
    fails the generation that already happened."""
    try:
        path = Path(path)
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, "a") as f:
            f.write(json.dumps(event) + "\n")
    except OSError as exc:
        print(f"img: ledger write failed ({exc})", file=sys.stderr)


def die(msg, code=1):
    print(f"img: {msg}", file=sys.stderr)
    sys.exit(code)


def load_keys():
    """Parse the toolbelt env file. Values stay in memory only."""
    keys = {}
    if not ENV_FILE.exists():
        return keys
    for line in ENV_FILE.read_text().splitlines():
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        keys[k.strip()] = v.strip()
    return keys


def key_source(name):
    """Where the key named `name` comes from, without touching its value:
    ("env", <toolbelt key name>) when the environment supplies it, ("file", name)
    when the toolbelt file does, or (None, name) when it is set nowhere."""
    if os.environ.get(name):
        return "env", os.environ.get(name + "_NAME") or name
    if load_keys().get(name):
        return "file", name
    return None, name


def need_key(name):
    """The key value. Environment wins (a per-client key passed in by the
    relay), then the toolbelt file. Never printed."""
    val = os.environ.get(name) or load_keys().get(name)
    if not val:
        die(f"{name} is not set. Ask Taylor to run: ~/.config/claude-tools/setenv.sh {name}")
    return val


def slugify(text, limit=48):
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return s[:limit] or "img"


def out_dir(base, slug):
    d = Path(base) if base else OUT_ROOT / slug
    d.mkdir(parents=True, exist_ok=True)
    return d.resolve()


def image_size(path):
    """Width/height for PNG, JPEG, WebP without Pillow. Returns (w, h) or None."""
    try:
        with open(path, "rb") as f:
            head = f.read(32)
            if head[:8] == b"\x89PNG\r\n\x1a\n":
                w, h = struct.unpack(">II", head[16:24])
                return w, h
            if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
                chunk = head[12:16]
                if chunk == b"VP8X":
                    f.seek(24)
                    b = f.read(6)
                    return (int.from_bytes(b[0:3], "little") + 1, int.from_bytes(b[3:6], "little") + 1)
                if chunk == b"VP8 ":
                    f.seek(26)
                    b = f.read(4)
                    return (struct.unpack("<H", b[0:2])[0] & 0x3FFF, struct.unpack("<H", b[2:4])[0] & 0x3FFF)
                if chunk == b"VP8L":
                    f.seek(21)
                    b = f.read(4)
                    bits = int.from_bytes(b, "little")
                    return ((bits & 0x3FFF) + 1, ((bits >> 14) & 0x3FFF) + 1)
            if head[:2] == b"\xff\xd8":
                f.seek(2)
                while True:
                    marker = f.read(2)
                    if len(marker) < 2 or marker[0] != 0xFF:
                        return None
                    if marker[1] in (0xC0, 0xC1, 0xC2):
                        f.read(3)
                        h, w = struct.unpack(">HH", f.read(4))
                        return w, h
                    seg_len = struct.unpack(">H", f.read(2))[0]
                    f.seek(seg_len - 2, 1)
    except OSError:
        return None
    return None


def write_sidecar(path, meta):
    Path(str(path.with_suffix("")) + ".json").write_text(json.dumps(meta, indent=2))


def default_styles():
    return {
        "plateful-menu": (
            "Professional restaurant menu food photography. Single plated dish, "
            "shot from a 45-degree angle, soft natural window light from the left, "
            "neutral matte ceramic plate on a light oak table, shallow depth of "
            "field, appetizing and realistic, no text, no hands, no utensils in frame."
        ),
        "plateful-hero": (
            "Wide editorial restaurant photograph, warm inviting interior or a "
            "spread of dishes on a table, soft natural light, realistic, no text."
        ),
        "plain": "",
    }


def load_styles():
    styles = default_styles()
    if STYLES_FILE.exists():
        try:
            styles.update(json.loads(STYLES_FILE.read_text()))
        except json.JSONDecodeError as e:
            die(f"{STYLES_FILE} is not valid JSON: {e}")
    return styles


# ---------------------------------------------------------------- stock

def cmd_stock(args):
    key = need_key("PEXELS_API_KEY")
    params = {"query": args.query, "per_page": args.n, "page": args.page}
    if args.orientation:
        params["orientation"] = args.orientation
    if args.color:
        params["color"] = args.color
    r = requests.get(PEXELS_SEARCH, headers={"Authorization": key}, params=params, timeout=30)
    if r.status_code != 200:
        die(f"Pexels search failed: HTTP {r.status_code} {r.text[:200]}")
    data = r.json()
    photos = data.get("photos", [])
    if not photos:
        print(f"No Pexels results for {args.query!r}.")
        return

    dest = out_dir(args.out, slugify(args.query))
    print(f"{data.get('total_results', '?')} results for {args.query!r}; page {args.page}; saving {len(photos)} to {dest}\n")
    for i, p in enumerate(photos, 1):
        url = p["src"][args.size]
        ext = ".jpg" if ".jpeg" in url or ".jpg" in url else ".jpg"
        name = f"{slugify(args.query, 32)}-{p['id']}{ext}"
        path = dest / name
        if not path.exists():
            img = requests.get(url, timeout=60)
            if img.status_code != 200:
                print(f"  [{i}] download failed for id {p['id']}")
                continue
            path.write_bytes(img.content)
        meta = {
            "source": "pexels",
            "pexels_id": p["id"],
            "pexels_url": p["url"],
            "photographer": p.get("photographer"),
            "photographer_url": p.get("photographer_url"),
            "alt": p.get("alt"),
            "size_variant": args.size,
            "original_width": p.get("width"),
            "original_height": p.get("height"),
            "query": args.query,
            "license": "Pexels License — free for commercial use, no attribution required (credit appreciated)",
        }
        write_sidecar(path, meta)
        wh = image_size(path)
        dims = f"{wh[0]}x{wh[1]}" if wh else "?"
        print(f"  [{i}] {path}")
        print(f"      {dims}  by {p.get('photographer')}  — {p.get('alt') or '(no alt)'}")
    if data.get("next_page"):
        print(f"\nMore available: re-run with --page {args.page + 1}")


# ---------------------------------------------------------------- gen

MIMES = {"png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg", "webp": "image/webp"}
EXTS = {"image/png": ".png", "image/jpeg": ".jpg", "image/webp": ".webp"}


def image_part(path):
    p = Path(path)
    if not p.exists():
        die(f"image not found: {path}")
    mime = MIMES.get(p.suffix.lower().lstrip("."), "image/jpeg")
    return {"inlineData": {"mimeType": mime, "data": base64.b64encode(p.read_bytes()).decode()}}


def gemini_image(model, key, body):
    """One generateContent call; returns (base64 image, mime) or dies."""
    r = requests.post(GEMINI_URL.format(model=model), headers={"x-goog-api-key": key},
                      json=body, timeout=180)
    if r.status_code != 200:
        die(f"Gemini generate failed: HTTP {r.status_code} {r.text[:300]}")
    resp = r.json()
    for cand in resp.get("candidates", []):
        for part in cand.get("content", {}).get("parts", []):
            if "inlineData" in part:
                return part["inlineData"]["data"], part["inlineData"].get("mimeType", "image/png")
    die(f"Gemini returned no image. Response: {json.dumps(resp)[:400]}")


def cmd_edit(args):
    """img edit PHOTO "instruction": Gemini redraws the photo with the change
    asked for and nothing else. Same model/cost table as gen; the sidecar and
    ledger say which file it was an edit of."""
    key = need_key("GEMINI_API_KEY")
    _, key_name = key_source("GEMINI_API_KEY")
    src = Path(args.photo)
    prompt = (f"Edit this photo: {args.instruction}\n\nKeep everything else exactly as it is: the same "
              f"people, faces, framing, lighting and composition. Photorealistic, matching the original. "
              f"Output the edited photo only.")
    q = QUALITY[args.quality]
    model = GEMINI_MODEL or q["model"]
    body = {"contents": [{"parts": [image_part(src), {"text": prompt}]}],
            "generationConfig": {"responseModalities": ["IMAGE"], "imageConfig": {"imageSize": q["size"]}}}
    img_b64, mime = gemini_image(model, key, body)
    ext = EXTS.get(mime, ".png")
    if args.out:
        path = Path(args.out).resolve()
        path.parent.mkdir(parents=True, exist_ok=True)
    else:
        stamp = time.strftime("%Y%m%d-%H%M%S")
        path = out_dir(args.out_dir, slugify(src.stem)) / f"{slugify(src.stem, 24)}-{slugify(args.instruction, 24)}-{stamp}{ext}"
    path.write_bytes(base64.b64decode(img_b64))
    write_sidecar(path, {
        "source": "edited", "edit_of": str(src.resolve()), "instruction": args.instruction,
        "full_prompt": prompt, "model": model, "quality": args.quality, "size": q["size"],
        "est_cost_usd": q["usd"], "billed_to": f"gemini:{key_name}",
        "generated_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    })
    if not args.no_ledger:
        ledger_append(args.ledger, {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "image",
            "model": model, "quality": args.quality, "cost_usd": q["usd"], "billed_to": f"gemini:{key_name}",
            "project": os.environ.get("PF_RESTAURANT") or os.getcwd(), "path": str(path), "edit_of": str(src.resolve()),
        })
    wh = image_size(path)
    print(f"  {path}  {f'{wh[0]}x{wh[1]}' if wh else '?'}")
    print(f"  ({model}, {q['size']}, ~${q['usd']:.2f}, billed to {key_name})")
    return [path]


def cmd_gen(args):
    key = need_key("GEMINI_API_KEY")
    _, key_name = key_source("GEMINI_API_KEY")   # who pays, by name only
    styles = load_styles()
    if args.style not in styles:
        die(f"unknown style {args.style!r}; run `img styles`")
    style_text = styles[args.style]
    prompt = f"{style_text}\n\nSubject: {args.prompt}".strip() if style_text else args.prompt
    if args.aspect:
        prompt += f"\n\nAspect ratio {args.aspect}."

    parts = [{"text": prompt}]
    for ref in args.ref or []:
        rp = Path(ref)
        if not rp.exists():
            die(f"reference image not found: {ref}")
        mime = {"png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg", "webp": "image/webp"}.get(
            rp.suffix.lower().lstrip("."), "image/jpeg")
        parts.append({"inlineData": {"mimeType": mime, "data": base64.b64encode(rp.read_bytes()).decode()}})

    q = QUALITY[args.quality]
    model = GEMINI_MODEL or q["model"]
    body = {"contents": [{"parts": parts}], "generationConfig": {"responseModalities": ["IMAGE"]}}
    body["generationConfig"]["imageConfig"] = {"imageSize": q["size"]}
    if args.aspect:
        body["generationConfig"]["imageConfig"]["aspectRatio"] = args.aspect

    dest_dir = out_dir(args.out_dir, slugify(args.prompt))
    made = []
    for i in range(args.n):
        img_b64, mime = gemini_image(model, key, body)
        ext = {"image/png": ".png", "image/jpeg": ".jpg", "image/webp": ".webp"}.get(mime, ".png")
        if args.out and args.n == 1:
            path = Path(args.out).resolve()
            path.parent.mkdir(parents=True, exist_ok=True)
        else:
            stamp = time.strftime("%Y%m%d-%H%M%S")
            path = dest_dir / f"{slugify(args.prompt, 32)}-{stamp}-{i + 1}{ext}"
        path.write_bytes(base64.b64decode(img_b64))
        write_sidecar(path, {
            "source": "generated",
            "model": model,
            "quality": args.quality,
            "size": q["size"],
            "est_cost_usd": q["usd"],
            "billed_to": f"gemini:{key_name}",
            "style": args.style,
            "prompt": args.prompt,
            "full_prompt": prompt,
            "aspect": args.aspect,
            "refs": [str(Path(r_).resolve()) for r_ in (args.ref or [])],
            "generated_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        })
        if not args.no_ledger:
            ledger_append(args.ledger, {
                "ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()),
                "kind": "image",
                "model": model,
                "quality": args.quality,
                "cost_usd": q["usd"],
                "billed_to": f"gemini:{key_name}",
                "project": os.environ.get("PF_RESTAURANT") or os.getcwd(),
                "path": str(path),
            })
        wh = image_size(path)
        dims = f"{wh[0]}x{wh[1]}" if wh else "?"
        print(f"  [{i + 1}] {path}  {dims}")
        made.append(path)
    print(f"  ({model}, {q['size']}, ~${q['usd'] * args.n:.2f}, billed to {key_name})")
    return made


# ---------------------------------------------------------------- video

def veo_uri(payload):
    """Find the finished video's URI anywhere in the operation response.

    Veo returns it under response.generateVideoResponse.generatedSamples[].video.uri,
    but the shape has moved between previews; walking for the first uri-ish
    string is what keeps this working when it moves again."""
    stack = [payload]
    while stack:
        node = stack.pop(0)
        if isinstance(node, dict):
            for k, v in node.items():
                if k in ("uri", "videoUri", "url") and isinstance(v, str) and v.startswith("http"):
                    return v
                stack.append(v)
        elif isinstance(node, list):
            stack.extend(node)
    return None


RES_ORDER = ["720p", "1080p", "4k"]


def ffmpeg_or_die():
    for exe in ("ffmpeg", "ffprobe"):
        if not shutil.which(exe):
            die(f"{exe} is not installed — it's what reads a video's first frame. "
                "A static build in ~/.local/bin is enough (johnvansickle.com/ffmpeg).")


def probe(path):
    """(width, height, seconds) for a video file."""
    out = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                          "stream=width,height", "-show_entries", "format=duration",
                          "-of", "json", str(path)], capture_output=True, text=True)
    if out.returncode != 0:
        die(f"ffprobe couldn't read {path}: {out.stderr.strip()[:200]}")
    d = json.loads(out.stdout)
    st = (d.get("streams") or [{}])[0]
    return st.get("width", 0), st.get("height", 0), float(d.get("format", {}).get("duration") or 0)


def first_frame(path, dest, at=0.0):
    seek = ["-ss", f"{max(0.0, at):.2f}"] if at else []
    r = subprocess.run(["ffmpeg", "-v", "error", *seek, "-i", str(path), "-frames:v", "1", "-y", str(dest)],
                       capture_output=True, text=True)
    if r.returncode != 0 or not Path(dest).exists():
        die(f"ffmpeg couldn't take a frame from {path}: {r.stderr.strip()[:200]}")
    return dest


def describe_video(path, ask, key, prompt=None, want_start=False):
    """Gemini watches the clip. Returns the text, or (text, start_seconds,
    note) when want_start -- the moment a remake should generate from."""
    src = Path(path)
    if src.stat().st_size > DESCRIBE_MAX_MB * 1_000_000:
        # Too big to inline: describe a small, short proxy instead of the original.
        proxy = src.with_suffix(".proxy.mp4")
        subprocess.run(["ffmpeg", "-v", "error", "-i", str(src), "-t", "10", "-vf", "scale=360:-2",
                        "-r", "12", "-an", "-y", str(proxy)], capture_output=True, text=True)
        if proxy.exists():
            src = proxy
    mime = {"mov": "video/quicktime", "webm": "video/webm"}.get(src.suffix.lower().lstrip("."), "video/mp4")
    instruction = (prompt or DESCRIBE_PROMPT).format(ask=ask)
    if want_start:
        instruction += START_FRAME_PROMPT
    body = {"contents": [{"parts": [
        {"inlineData": {"mimeType": mime, "data": base64.b64encode(src.read_bytes()).decode()}},
        {"text": instruction},
    ]}]}
    if want_start:
        body["generationConfig"] = {"responseMimeType": "application/json"}
    r = requests.post(DESCRIBE_URL.format(model=DESCRIBE_MODEL),
                      headers={"x-goog-api-key": key, "Content-Type": "application/json"},
                      json=body, timeout=180)
    if r.status_code != 200:
        die(f"describe: HTTP {r.status_code} {r.text[:300]}")
    parts = r.json().get("candidates", [{}])[0].get("content", {}).get("parts", [])
    text = "".join(p.get("text", "") for p in parts).strip()
    if not text:
        die("describe: the model returned nothing to work from")
    if not want_start:
        return text
    try:
        d = json.loads(text)
        return d["description"].strip(), float(d.get("start_seconds") or 0), (d.get("frame_note") or "").strip()
    except (ValueError, KeyError, TypeError):
        # Malformed JSON shouldn't cost anyone their clip: fall back to frame 0.
        return text, 0.0, ""


def video_quota(ledger_path, who, cap, hours=24):
    """(used, frees_up_in_seconds) — how many videos `who` has made in the last
    `hours` according to the ledger, and how long until the oldest of them
    ages out. Counting the ledger rather than a counter file means the cap and
    the bill are the same record; a missing or unreadable ledger means zero
    used, because refusing on a bookkeeping problem is the wrong failure."""
    cutoff = time.time() - hours * 3600
    stamps = []
    try:
        with open(ledger_path) as f:
            for line in f:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                if row.get("kind") != "video" or row.get("who") != who:
                    continue
                try:
                    when = calendar.timegm(time.strptime(row["ts"][:19], "%Y-%m-%dT%H:%M:%S"))
                except (KeyError, ValueError):
                    continue
                if when >= cutoff:
                    stamps.append(when)
    except OSError:
        return 0, 0
    stamps.sort()
    frees = int(stamps[0] + hours * 3600 - time.time()) if len(stamps) >= cap and stamps else 0
    return len(stamps), max(0, frees)


def video_house_rules(resolution, seconds, cost, quality):
    """Apply IMG_VIDEO_MAX_*: returns the resolution to actually use, or dies."""
    max_s = os.environ.get("IMG_VIDEO_MAX_SECONDS")
    if max_s and seconds > int(max_s):
        die(f"clips here are {max_s}s or less (asked for {seconds}s)")
    max_res = os.environ.get("IMG_VIDEO_MAX_RESOLUTION")
    if max_res and RES_ORDER.index(resolution) > RES_ORDER.index(max_res):
        print(f"  ({resolution} isn't allowed here, using {max_res})")
        resolution = max_res
    max_usd = os.environ.get("IMG_VIDEO_MAX_USD")
    if max_usd and cost > float(max_usd) + 1e-9:
        die(f"that clip would cost ${cost:.2f}; the limit here is ${float(max_usd):.2f} "
            f"(try --quality draft, or fewer seconds)")
    return resolution


def cmd_video(args):
    source_note = None
    if args.source:
        ffmpeg_or_die()
        src = Path(args.source)
        if not src.exists():
            die(f"video not found: {args.source}")
        w, h, dur = probe(src)
        if not args.aspect:
            args.aspect = "9:16" if h > w else "16:9"
        source_note = {"from": str(src.resolve()), "asked": args.prompt,
                       "source_size": f"{w}x{h}", "source_seconds": round(dur, 1)}
    args.aspect = args.aspect or "16:9"

    q = VIDEO_QUALITY[args.quality]
    model = VIDEO_MODEL or q["model"]
    seconds = int(args.seconds)
    resolution = args.resolution or q["resolution"]
    cost = q["usd_per_s"] * seconds

    resolution = video_house_rules(resolution, seconds, cost, args.quality)
    cost = q["usd_per_s"] * seconds     # unchanged by a clamp: price is per second, not per pixel

    who = os.environ.get("IMG_VIDEO_WHO")
    cap = int(os.environ.get("IMG_VIDEO_DAILY_CAP") or 0)
    if who and cap:
        used, frees = video_quota(args.ledger, who, cap)
        if used >= cap:
            label = os.environ.get("IMG_VIDEO_WHO_LABEL") or who
            when = f"{frees // 3600}h {frees % 3600 // 60}m" if frees else "soon"
            die(f"video quota: {label} has used {used} of {cap} in the last 24h — "
                f"the next one frees up in {when}. Nothing was generated.")

    if resolution in ("1080p", "4k") and seconds != 8:
        die(f"{resolution} is 8 seconds only (asked for {seconds}); use --seconds 8 or --resolution 720p")
    if resolution == "4k" and args.quality == "draft":
        die("lite (draft) doesn't do 4K; use --quality good or pro")

    instance = {"prompt": args.prompt}
    if args.ref:
        rp = Path(args.ref)
        if not rp.exists():
            die(f"first-frame image not found: {args.ref}")
        mime = {"png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg", "webp": "image/webp"}.get(
            rp.suffix.lower().lstrip("."), "image/jpeg")
        # Veo's predictLongRunning takes the predict-style image object; the
        # generateContent-style {"inlineData": ...} is rejected with a 400
        # "`inlineData` isn't supported by this model" (checked 2026-09-17).
        instance["image"] = {"bytesBase64Encoded": base64.b64encode(rp.read_bytes()).decode(), "mimeType": mime}

    body = {"instances": [instance], "parameters": {
        # durationSeconds is a NUMBER; the docs show a string and the API
        # rejects that with a 400 (checked 2026-09-17).
        "aspectRatio": args.aspect, "resolution": resolution, "durationSeconds": seconds}}
    if args.negative:
        body["instances"][0]["negativePrompt"] = args.negative

    if args.dry_run:
        # A dry run stays free: it doesn't watch the video either, it says it would.
        if args.source:
            print(f"  would watch {Path(args.source).name} with {DESCRIBE_MODEL}, take its first frame, "
                  f"and fold in: {args.prompt}")
        if who and cap:
            used, _ = video_quota(args.ledger, who, cap)
            print(f"  quota: {used} of {cap} used in the last 24h")
        print(f"  would generate: {model}, {resolution}, {seconds}s, {args.aspect}"
              + (f", first frame {args.ref}" if args.ref else ""))
        print(f"  prompt: {args.prompt}")
        print(f"  ~${cost:.2f} — nothing was generated (--dry-run)")
        return None

    key = need_key("GEMINI_API_KEY")
    _, key_name = key_source("GEMINI_API_KEY")
    headers = {"x-goog-api-key": key, "Content-Type": "application/json"}

    if args.source:
        print(f"  watching {Path(args.source).name} ({DESCRIBE_MODEL})...")
        pick_frame = args.at is None
        if pick_frame:
            args.prompt, at, note = describe_video(args.source, args.prompt, key, want_start=True)
            dur = source_note["source_seconds"]
            at = min(max(0.0, at), max(0.0, dur - 0.05))     # a seek past the end gives no frame at all
            print(f"  starting from {at:.1f}s" + (f" — {note}" if note else ""))
        else:
            args.prompt = describe_video(args.source, args.prompt, key)
            at = args.at
        source_note["description"] = args.prompt
        source_note["start_seconds"] = round(at, 2)
        source_note["frame_chosen_by"] = DESCRIBE_MODEL if pick_frame else "--at"
        args.ref = args.ref or str(first_frame(args.source, Path(args.source).with_suffix(".startframe.png"), at))
        instance["prompt"] = args.prompt
        rp = Path(args.ref)
        instance["image"] = {"bytesBase64Encoded": base64.b64encode(rp.read_bytes()).decode(),
                             "mimeType": "image/png"}
        body["instances"] = [instance]
        print(f"  shot: {args.prompt[:160]}{'...' if len(args.prompt) > 160 else ''}")

    r = requests.post(VEO_URL.format(model=model), headers=headers, json=body, timeout=60)
    if r.status_code != 200:
        die(f"veo: HTTP {r.status_code} {r.text[:400]}")
    op = r.json().get("name")
    if not op:
        die(f"veo: no operation name in {r.text[:300]}")

    print(f"  generating ({model}, {resolution}, {seconds}s, ~${cost:.2f})...")
    waited = 0
    while True:
        time.sleep(VEO_POLL_SECONDS)
        waited += VEO_POLL_SECONDS
        pr = requests.get(VEO_OP_URL.format(op=op), headers={"x-goog-api-key": key}, timeout=60)
        if pr.status_code != 200:
            die(f"veo: poll HTTP {pr.status_code} {pr.text[:300]}")
        payload = pr.json()
        if payload.get("done"):
            break
        if waited >= VEO_TIMEOUT_SECONDS:
            die(f"veo: still not done after {waited}s (operation {op})")
        print(f"  ...{waited}s")

    if "error" in payload:
        die(f"veo: {json.dumps(payload['error'])[:400]}")
    uri = veo_uri(payload)
    if not uri:
        die(f"veo: finished but no video uri in {json.dumps(payload)[:400]}")

    if args.out:
        path = Path(args.out).resolve()
        path.parent.mkdir(parents=True, exist_ok=True)
    else:
        stamp = time.strftime("%Y%m%d-%H%M%S")
        path = out_dir(args.out_dir, slugify(args.prompt)) / f"{slugify(args.prompt, 32)}-{stamp}.mp4"

    dl = requests.get(uri, headers={"x-goog-api-key": key}, timeout=300)
    if dl.status_code != 200:
        die(f"veo: download HTTP {dl.status_code}")
    path.write_bytes(dl.content)

    mb = path.stat().st_size / 1_000_000
    write_sidecar(path, {
        "source": "generated", "kind": "video", "model": model, "quality": args.quality,
        "resolution": resolution, "seconds": seconds, "aspect": args.aspect,
        "est_cost_usd": round(cost, 3), "billed_to": f"gemini:{key_name}",
        "prompt": args.prompt, "negative_prompt": args.negative, "remake_of": source_note,
        "first_frame": str(Path(args.ref).resolve()) if args.ref else None,
        "generated_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    })
    if not args.no_ledger:
        ledger_append(args.ledger, {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()),
            "kind": "video", "model": model, "quality": args.quality,
            "seconds": seconds, "cost_usd": round(cost, 3),
            "billed_to": f"gemini:{key_name}",
            "who": who, "who_label": os.environ.get("IMG_VIDEO_WHO_LABEL"),
            "project": os.environ.get("PF_RESTAURANT") or os.getcwd(),
            "path": str(path),
        })
    print(f"  {path}  {mb:.1f}MB")
    if mb > DISCORD_ATTACH_LIMIT_MB:
        print(f"  note: {mb:.1f}MB is over Discord's {DISCORD_ATTACH_LIMIT_MB}MB attachment limit — "
              "regenerate shorter or at 720p")
    print(f"  ({model}, {resolution}, {seconds}s, ~${cost:.2f}, billed to {key_name})")
    return path


def cmd_describe(args):
    """Watch a clip and say what's in it. No generation, fractions of a cent --
    this is how something that can't see video gets to have an opinion."""
    ffmpeg_or_die()
    src = Path(args.clip)
    if not src.exists():
        die(f"video not found: {args.clip}")
    key = need_key("GEMINI_API_KEY")
    w, h, dur = probe(src)
    ask = f" The person asking wants to know: {args.ask}" if args.ask else ""
    text = describe_video(src, "", key, prompt=WATCH_PROMPT.format(ask=ask))
    print(f"  {src.name} — {w}x{h}, {dur:.1f}s ({DESCRIBE_MODEL})\n")
    print(text)
    return text


# ---------------------------------------------------------------- misc

def cmd_styles(_args):
    for name, text in load_styles().items():
        print(f"{name}\n    {text or '(no style text — prompt used verbatim)'}\n")
    print(f"Add or override presets in {STYLES_FILE} (JSON object of name -> prompt text).")


def cmd_doctor(_args):
    """Report whether each key is present and accepted, without printing values."""
    keys = load_keys()
    print(f"env file: {ENV_FILE}  ({'exists' if ENV_FILE.exists() else 'MISSING'})")
    for name, ping in (("PEXELS_API_KEY", _ping_pexels), ("GEMINI_API_KEY", _ping_gemini)):
        src, key_name = key_source(name)
        v = os.environ.get(name) if src == "env" else keys.get(name)
        if not v:
            print(f"  {name}: not set (neither in the environment nor the env file)")
            continue
        shape = f"from {'environment as ' + key_name if src == 'env' else 'env file'}, len={len(v)}"
        if v[:1] in "\"'" or v[-1:] in "\"'":
            shape += " HAS-QUOTES"
        if any(c.isspace() for c in v):
            shape += " HAS-WHITESPACE"
        print(f"  {name}: set ({shape}) → {ping(v)}")


def _ping_pexels(key):
    r = requests.get(PEXELS_SEARCH, headers={"Authorization": key}, params={"query": f"ping{int(time.time())}", "per_page": 1}, timeout=15)  # unique: defeats CDN cache
    return "OK" if r.status_code == 200 else f"HTTP {r.status_code} {r.json().get('message', '') if r.headers.get('content-type','').startswith('application/json') else ''}"


def _ping_gemini(key):
    r = requests.get("https://generativelanguage.googleapis.com/v1beta/models", headers={"x-goog-api-key": key},
                     params={"pageSize": 1}, timeout=15)
    return "OK" if r.status_code == 200 else f"HTTP {r.status_code}"


def cmd_info(args):
    for f in args.files:
        p = Path(f)
        if not p.exists():
            print(f"{f}: missing")
            continue
        wh = image_size(p)
        dims = f"{wh[0]}x{wh[1]}" if wh else "unknown format"
        print(f"{p.resolve()}  {dims}  {p.stat().st_size // 1024} KB")
        side = Path(str(p.with_suffix("")) + ".json")
        if side.exists():
            meta = json.loads(side.read_text())
            src = meta.get("source")
            if src == "pexels":
                print(f"    pexels #{meta['pexels_id']} by {meta.get('photographer')} — {meta.get('pexels_url')}")
            elif src == "generated":
                print(f"    generated by {meta.get('model')} ({meta.get('quality')}/{meta.get('size')}) [{meta.get('style')}]: {meta.get('prompt')}")


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(prog="img", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("stock", help="search + download Pexels photos")
    s.add_argument("query")
    s.add_argument("-n", type=int, default=5, help="how many (max 80)")
    s.add_argument("--page", type=int, default=1)
    s.add_argument("--orientation", choices=["landscape", "portrait", "square"])
    s.add_argument("--color", help="e.g. red, orange, or a hex like 8b4513")
    s.add_argument("--size", choices=PEXELS_SIZES, default="large2x")
    s.add_argument("--out", help="directory (default ~/.cache/claude-tools/img/<query-slug>/)")
    s.set_defaults(fn=cmd_stock)

    g = sub.add_parser("gen", help="generate an image with Gemini")
    g.add_argument("prompt")
    g.add_argument("--style", default="plain", help="preset name (see `img styles`)")
    g.add_argument("--quality", choices=list(QUALITY), default="menu",
                   help="draft (lite, 3¢) | menu (flash 1K, 7¢, default) | hero (flash 2K, 10¢) | pro (2K, 13¢)")
    g.add_argument("--aspect", help="1:1, 3:4, 4:3, 9:16, 16:9")
    g.add_argument("--ref", action="append", help="reference image(s) to guide the generation")
    g.add_argument("-n", type=int, default=1, help="variations to generate")
    g.add_argument("--out", help="exact output file (only with -n 1)")
    g.add_argument("--out-dir", help="directory for multiple outputs")
    g.add_argument("--ledger", default=str(LEDGER), help=f"cost ledger to append to (default {LEDGER})")
    g.add_argument("--no-ledger", action="store_true", help="don't record this generation's cost")
    g.set_defaults(fn=cmd_gen)

    e = sub.add_parser("edit", help="edit a real photo with Gemini (instructed edit, same photo back)")
    e.add_argument("photo")
    e.add_argument("instruction", help='what to change, e.g. "remove the guy on the left", "make it night"')
    e.add_argument("--quality", choices=list(QUALITY), default="menu")
    e.add_argument("--out", help="exact output file")
    e.add_argument("--out-dir", help="directory for the output")
    e.add_argument("--ledger", default=str(LEDGER))
    e.add_argument("--no-ledger", action="store_true")
    e.set_defaults(fn=cmd_edit)

    v = sub.add_parser("video", help="generate a short video with Veo (seconds, not cents — check --dry-run first)")
    v.add_argument("prompt")
    v.add_argument("--quality", choices=list(VIDEO_QUALITY), default="draft",
                   help="draft (lite 720p, $0.05/s, default) | good (fast 720p, $0.10/s) | pro (1080p, $0.40/s)")
    v.add_argument("--seconds", choices=["4", "6", "8"], default="4")
    v.add_argument("--aspect", choices=["16:9", "9:16"], default=None,
                   help="default 16:9, or matched to the source with --from")
    v.add_argument("--resolution", choices=["720p", "1080p", "4k"], help="default is the quality's own")
    v.add_argument("--ref", help="an image to start from (first frame) — a real face, a photo someone sent")
    v.add_argument("--from", dest="source", metavar="CLIP",
                   help="remake a video someone sent: Gemini watches it, the prompt becomes the change you "
                        "want, and the clip's first frame anchors the new one")
    v.add_argument("--at", type=float, metavar="SECONDS",
                   help="with --from: start from this moment instead of the one the model picks")
    v.add_argument("--negative", help="what to keep out of it")
    v.add_argument("--dry-run", action="store_true", help="print the model, length and price; generate nothing")
    v.add_argument("--out", help="exact output file (.mp4)")
    v.add_argument("--out-dir", help="directory for the output")
    v.add_argument("--ledger", default=str(LEDGER))
    v.add_argument("--no-ledger", action="store_true")
    v.set_defaults(fn=cmd_video)

    dsc = sub.add_parser("describe", help="watch a video and say what's in it (no generation, ~free)")
    dsc.add_argument("clip")
    dsc.add_argument("--ask", help="what you want to know about it")
    dsc.set_defaults(fn=cmd_describe)

    st = sub.add_parser("styles", help="list style presets")
    st.set_defaults(fn=cmd_styles)

    d = sub.add_parser("doctor", help="check keys are present and accepted (never prints them)")
    d.set_defaults(fn=cmd_doctor)

    inf = sub.add_parser("info", help="dimensions + provenance for image files")
    inf.add_argument("files", nargs="+")
    inf.set_defaults(fn=cmd_info)

    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
