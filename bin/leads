def die(msg, code=1):
    print(f"leads: {msg}", file=sys.stderr)
    sys.exit(code)


# ---- config -------------------------------------------------------------------

def _env_file(path):
    keys = {}
    if path.exists():
        for line in path.read_text().splitlines():
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                keys[k.strip()] = v.strip().strip('"').strip("'")
    return keys


def places_key():
    """(key, where) — the toolbelt env. Never printed."""
    val = os.environ.get("GOOGLE_MAPS_API_KEY") or _env_file(ENV_FILE).get("GOOGLE_MAPS_API_KEY")
    if val:
        return val, "toolbelt"
    return None, None


def home():
    raw = os.environ.get("LEADS_HOME")
    if raw:
        try:
            lat, lng = (float(x) for x in raw.split(","))
            return lat, lng
        except ValueError:
            die("LEADS_HOME must be 'lat,lng'")
    return HOME_DEFAULT


def miles(a, b):
    lat1, lng1 = a
    lat2, lng2 = b
    dy = (lat2 - lat1) * 69.0
    dx = (lng2 - lng1) * 69.0 * math.cos(math.radians(lat1))
    return math.hypot(dx, dy)


def next_saturday(today=None):
    today = today or dt.datetime.now(TZ).date()
    return today + dt.timedelta(days=(5 - today.weekday()) % 7)


# ---- the census ----------------------------------------------------------------

def census_candidates(min_reviews=25):
    if not CENSUS.exists():
        die(f"no census at {CENSUS} (LEADS_DB)")
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    rows = conn.execute("""
        SELECT r.place_id, p.name, p.address, p.locality, p.phone, p.website, p.has_website,
               p.rating, p.reviews, p.lat, p.lng, p.primary_type, p.google_maps_uri, p.refreshed_at,
               r.on_doordash, r.on_uber, r.on_grubhub, r.status, r.last_action_date, r.next_followup,
               r.parasite_url, r.serp_top3, r.contact_name, r.contact_email, r.city
        FROM restaurants r JOIN place_cache p ON p.place_id = r.place_id
        WHERE r.channel_class = 'marketplace-only'
          AND COALESCE(r.is_chain, 0) = 0
          AND (p.business_status IS NULL OR p.business_status = 'OPERATIONAL')
          AND p.lat IS NOT NULL AND p.lng IS NOT NULL
          AND r.status = 'Open'
          AND COALESCE(p.reviews, 0) >= ?
          AND COALESCE(p.phone, '') != ''
    """, (min_reviews,)).fetchall()
    conn.close()
    h = home()
    out = []
    for r in rows:
        d = dict(r)
        if d["primary_type"] in SKIP_TYPES:
            continue
        d["miles"] = round(miles(h, (d["lat"], d["lng"])), 1)
        out.append(d)
    out.sort(key=lambda d: (d["miles"], -(d["reviews"] or 0)))
    return out


def census_stamp(cands):
    stamps = sorted({(c.get("refreshed_at") or "")[:10] for c in cands if c.get("refreshed_at")})
    return stamps[-1] if stamps else "?"


# ---- the reach table (B61's `reach`; read here, written by client-leads/scripts/reach.py) ----

_REACH = None


def reach_table():
    """place_id -> {'instagram' (handle), 'facebook' ('facebook.com/x'), 'email', 'source', 'checked', 'evidence'},
    or None when the census has no `reach` table yet (B61 hasn't run). Read once, never written."""
    global _REACH
    if _REACH is not None:
        return _REACH or None
    if not CENSUS.exists():
        return None
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    try:
        if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='reach'").fetchone():
            _REACH = {}
            return None
        rows = conn.execute("SELECT * FROM reach").fetchall()
    finally:
        conn.close()
    out = {}
    for r in rows:
        d = dict(r)
        pid = d.get("place_id")
        if not pid:
            continue
        out[pid] = {"instagram": ig_handle(d.get("instagram")), "facebook": fb_page(d.get("facebook")),
                    "email": (d.get("email") or "").strip() or None, "source": d.get("source"),
                    "checked": d.get("checked"), "evidence": d.get("evidence")}
    _REACH = out
    return out


def ig_handle(value):
    """A handle from a handle, an @handle or a profile URL; None for a post, a reel or nothing."""
    v = (value or "").strip().lstrip("@")
    m = re.match(r"^(?:https?://)?(?:www\.|m\.)?instagram\.com/([A-Za-z0-9_.]+)", v)
    if m:
        v = m.group(1)
    v = v.strip("/")
    return v if re.fullmatch(r"[A-Za-z0-9_.]+", v or "") and v.lower() not in IG_SKIP else None


def fb_page(value):
    """'facebook.com/x' from a page URL or a bare page name; None for a group, an event or nothing."""
    v = (value or "").strip()
    if not v:
        return None
    m = re.match(r"^(?:https?://)?(?:www\.|m\.|web\.)?facebook\.com/([^/?#]+)", v)
    name = m.group(1) if m else (v.strip("/") if "/" not in v.strip("/") else None)
    if not name or name.lower() in FB_SKIP:
        return None
    return f"facebook.com/{name}"


def reach_fill(out, place_id):
    """The census's own columns win; the B61 table fills what they left empty."""
    row = (reach_table() or {}).get(place_id or "")
    if row:
        for f in ("instagram", "facebook", "email"):
            if not out.get(f) and row.get(f):
                out[f] = row[f]
    return out


# ---- the services census (B43's `businesses`; B44 reads it) -------------------------

def businesses_state():
    """(table exists, {segment: rows}) — never raises on an old census."""
    if not CENSUS.exists():
        return False, {}
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    try:
        if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='businesses'").fetchone():
            return False, {}
        return True, dict(conn.execute("SELECT segment, count(*) FROM businesses GROUP BY segment").fetchall())
    finally:
        conn.close()


DEFAULT_POOL_MIN = 6               # a kit's worth: below this the services census is mid-scan, not ready


def default_segment():
    """LEADS_SEGMENT, else services once the services census holds a kit's worth of leads (six with a phone and no
    site of their own), else restaurant — so a scan that has written its first rows doesn't empty the 11:45 kit."""
    env = (os.environ.get("LEADS_SEGMENT") or "").strip().lower()
    if env:
        if env not in SEGMENTS + ("all",):
            die(f"LEADS_SEGMENT is one of {', '.join(SEGMENTS)}, all")
        return env
    _, counts = businesses_state()
    if counts.get("services") and len(business_candidates(["services"])) >= DEFAULT_POOL_MIN:
        return "services"
    return "restaurant"


def resolve_segment(arg):
    """The segment a command runs on; a business segment with no census behind it stops here, in one line."""
    seg = (arg or default_segment()).lower()
    if seg in ("restaurant", "all"):
        if seg == "all" and not sum(businesses_state()[1].values()):
            print("leads: no services census yet — --segment all is the restaurants alone", file=sys.stderr)
        return seg
    exists, counts = businesses_state()
    if not exists or not sum(counts.values()):
        die("no services census yet — run B43's scan (client-leads/scripts/scan_services.py); --segment restaurant works today")
    if not counts.get(seg):
        die(f"no {seg} in the services census yet ({', '.join(f'{k} {v}' for k, v in sorted(counts.items()))})")
    return seg


def host_matches(host, table):
    for h, label in table.items():
        if host == h or host.endswith("." + h):
            return label
    return None


def presence_from_url(url):
    """(class, label) from the website link alone, no fetch: plan 18's classes minus the HTTP check
    ('own' here means only "a domain of its own", not that it loads)."""
    if not (url or "").strip():
        return "none", None
    host = host_of(url)
    if host == "business.site" or host.endswith(".business.site"):
        return "dead", "business.site"
    if host == "sites.google.com":
        return "page", "Google Sites"
    for table, cls in ((PAGE_HOSTS, "page"), (DIRECTORY_HOSTS, "directory"), (BUILDER_HOSTS, "builder")):
        label = host_matches(host, table)
        if label:
            return cls, label
    if ".webnode." in "." + host:
        return "builder", "Webnode"
    return "own", host


def presence(c, website=None):
    """(class, label, url) for a business: the census's class (B43 checked it), or read from the link when it
    says unknown or Google's listing now links somewhere else. An own-domain link nobody checked stays unknown."""
    census_url = c.get("presence_url") or c.get("website") or ""
    cls, url = c.get("presence_class") or "unknown", census_url
    if website is not None and host_of(website) != host_of(census_url):   # Google links somewhere new since the scan
        cls, url = None, website
    derived, label = presence_from_url(url)
    if cls in (None, "unknown"):
        cls = "unknown" if derived == "own" else derived
    elif derived == "own":
        label = host_of(url)
    return cls, label, url


def presence_short(cls, label, url):
    return {"none": "no website", "page": f"website → {label}", "directory": f"website → {label}",
            "dead": f"dead link ({label or host_of(url)})", "builder": f"free {label} site",
            "own": host_of(url), "unknown": host_of(url) or "website unchecked"}.get(cls, cls)


def presence_fault(cls, label, url):
    art = "an" if (label or "x")[0] in "AEIOU" else "a"
    if cls == "none":
        return "no website on Google"
    if cls == "page":
        return f"the website link is {art} {label} page, not a site of their own"
    if cls == "directory":
        return f"the website link is their {label} profile, not a site of their own"
    if cls == "dead":
        if label == "business.site":
            return "the website link is a business.site page, and Google shut those down in 2024: it's a dead link"
        return f"the website link ({label or host_of(url)}) doesn't load"
    if cls == "builder":
        return f"the website is a free {label} address ({host_of(url)})"
    return None


def business_candidates(segments, min_reviews=None):
    """The services census's pool: independent, operational, a phone, no site of its own; nearest first."""
    exists, _ = businesses_state()
    if not exists:
        return []
    floor = SEGMENT_MIN_REVIEWS if min_reviews is None else min_reviews
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    marks = ",".join("?" * len(segments))
    rows = conn.execute(f"""
        SELECT b.place_id, b.segment, b.category, b.presence_class, b.presence_url, b.city,
               p.name, p.address, p.locality, p.phone, p.website, p.has_website, p.rating, p.reviews,
               p.lat, p.lng, p.primary_type, p.google_maps_uri, p.refreshed_at
        FROM businesses b JOIN place_cache p ON p.place_id = b.place_id
        WHERE b.segment IN ({marks})
          AND (CASE WHEN b.chain_override = 'yes' THEN 1 WHEN b.chain_override = 'no' THEN 0
                    ELSE COALESCE(b.is_chain, 0) END) = 0
          AND (p.business_status IS NULL OR p.business_status = 'OPERATIONAL')
          AND p.lat IS NOT NULL AND p.lng IS NOT NULL
          AND COALESCE(p.reviews, 0) >= ?
          AND COALESCE(p.phone, '') != ''
    """, (*segments, floor)).fetchall()
    conn.close()
    h = home()
    out = []
    for r in rows:
        d = dict(r)
        d["presence"], d["presence_label"], d["presence_link"] = presence(d)
        if d["presence"] not in WEAK_PRESENCE:
            continue
        d["miles"] = round(miles(h, (d["lat"], d["lng"])), 1)
        out.append(d)
    out.sort(key=lambda d: (d["miles"], -(d["reviews"] or 0)))
    return out


def candidates_for(segment, min_reviews=None):
    """Every command's pool: `restaurant` is census_candidates() exactly as before B44."""
    if segment == "restaurant":
        return census_candidates(25 if min_reviews is None else min_reviews)
    if segment == "all":
        rest = [dict(c, segment="restaurant") for c in census_candidates(25 if min_reviews is None else min_reviews)]
        out = rest + business_candidates(BUSINESS_SEGMENTS, min_reviews)
        out.sort(key=lambda d: (d["miles"], -(d["reviews"] or 0)))
        return out
    return business_candidates([segment], min_reviews)


def is_business(c):
    return (c.get("segment") or "") in BUSINESS_SEGMENTS


# ---- kits already sent ---------------------------------------------------------

def kits_log():
    p = STATE / "kits.jsonl"
    if not p.exists():
        return []
    out = []
    for line in p.read_text().splitlines():
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return out


def recently_kitted(for_date, weeks=REPEAT_WEEKS):
    """place_id -> kit date for places on a kit in the last N weeks, except the
    kit for this same date (re-running Friday's kit gives the same six)."""
    since = for_date - dt.timedelta(weeks=weeks)
    seen = {}
    for k in kits_log():
        try:
            d = dt.date.fromisoformat(k["for"])
        except (KeyError, ValueError):
            continue
        if d == for_date or d < since:
            continue
        for pid in k.get("place_ids", []):
            seen[pid] = k["for"]
    return seen


# ---- Google Place Details ------------------------------------------------------

class Places:
    """Place Details with a seven-day cache and a fixture mode for tests."""

    def __init__(self, key, where, fixture=None, refresh=False):
        self.key, self.where, self.fixture, self.refresh = key, where, fixture, refresh
        self.calls, self.failed = 0, None
        (STATE / "details").mkdir(parents=True, exist_ok=True)

    def get(self, place_id):
        if self.fixture:
            p = Path(self.fixture) / f"{place_id}.json"
            return json.loads(p.read_text()) if p.exists() else None
        cache = STATE / "details" / f"{place_id}.json"
        if cache.exists() and not self.refresh:
            age = time.time() - cache.stat().st_mtime
            if age < CACHE_DAYS * 86400:
                return json.loads(cache.read_text())
        if not self.key or self.failed:
            return None
        req = urllib.request.Request(DETAILS_URL + place_id, headers={
            "X-Goog-Api-Key": self.key, "X-Goog-FieldMask": DETAILS_FIELDS,
            "Accept": "application/json", "User-Agent": "claude-tools/leads",
        })
        try:
            with urllib.request.urlopen(req, timeout=20) as resp:
                data = json.loads(resp.read().decode())
        except urllib.error.HTTPError as exc:
            body = exc.read().decode(errors="replace")[:300]
            if exc.code in (400, 401, 403, 429):
                self.failed = f"Places refused the key ({exc.code}; from {self.where}): {body.strip()}"
                return None
            if exc.code == 404:
                data = {"id": place_id, "businessStatus": "GONE"}
            else:
                self.failed = f"Places error {exc.code}: {body.strip()}"
                return None
        except (urllib.error.URLError, TimeoutError, OSError) as exc:
            self.failed = f"Places unreachable: {exc}"
            return None
        self.calls += 1
        cache.write_text(json.dumps(data))
        return data


def ledger_append(event):
    try:
        LEDGER.parent.mkdir(parents=True, exist_ok=True)
        with open(LEDGER, "a") as f:
            f.write(json.dumps(event) + "\n")
    except OSError as exc:
        print(f"leads: ledger write failed ({exc})", file=sys.stderr)


# ---- reading a listing ---------------------------------------------------------

def open_always(periods):
    """Google says "open 24 hours" with a single period that has no close and opens at day 0, hour 0 —
    the day field is present and zero, not missing, so a 24/7 listing must never read as closed Saturdays."""
    if len(periods or []) != 1 or "close" in (periods[0] or {}):
        return False
    o = (periods[0] or {}).get("open") or {}
    return o.get("day") in (None, 0) and not o.get("hour") and not o.get("minute")


def saturday_open(details):
    """(hour, minute) of the earliest Saturday opening, 'closed', or None (no hours)."""
    hours = (details or {}).get("regularOpeningHours") or {}
    periods = hours.get("periods")
    if not periods:
        return None
    if open_always(periods):
        return (0, 0)
    opens = []
    for p in periods:
        o = p.get("open") or {}
        if o.get("day") == 6:
            opens.append((o.get("hour", 0), o.get("minute", 0)))
    return min(opens) if opens else "closed"


def clock(hm):
    h, m = hm
    suffix = "am" if h < 12 else "pm"
    h12 = h % 12 or 12
    return f"{h12}:{m:02d}{suffix}" if m else f"{h12}{suffix}"


def host_of(url):
    m = re.match(r"^(?:https?://)?(?:www\.)?([^/]+)", url or "")
    return (m.group(1) if m else "").lower()


def marketplace_link(url):
    h = host_of(url)
    for mk in MARKETPLACE_HOSTS:
        if mk in h:
            return {"order.online": "DoorDash Storefront", "doordash": "DoorDash", "ubereats": "Uber Eats",
                    "grubhub": "Grubhub", "toasttab": "Toast", "facebook": "Facebook", "instagram": "Instagram",
                    "linktr": "Linktree", "yelp": "Yelp", "slicelife": "Slice", "menufy": "Menufy",
                    "postmates": "Postmates", "seamless": "Seamless"}[mk]
    return None


def platforms(c):
    on = [name for col, name in (("on_doordash", "DoorDash"), ("on_uber", "Uber Eats"), ("on_grubhub", "Grubhub"))
          if (c.get(col) or "").strip().lower() == "yes"]
    maybe = [name for col, name in (("on_doordash", "DoorDash"), ("on_uber", "Uber Eats"), ("on_grubhub", "Grubhub"))
             if (c.get(col) or "").strip().lower() == "maybe"]
    s = " + ".join(on) if on else ""
    if maybe:
        s += (" (maybe " if s else "maybe ") + " + ".join(maybe) + (")" if s else "")
    return s or "a marketplace"


def review_age_days(rev, today):
    ts = rev.get("publishTime")
    if not ts:
        return None
    try:
        d = dt.datetime.fromisoformat(ts.replace("Z", "+00:00")).date()
    except ValueError:
        return None
    return (today - d).days


def faults(c, details, today):
    """What is wrong on the listing, worst first. Also returns the one-line
    Google summary. Works with details=None (census-only)."""
    out = []
    d = details or {}
    website = d.get("websiteUri") if details else (c.get("website") if (c.get("has_website") or "").lower() == "yes" else None)
    rating = d.get("rating") if details else c.get("rating")
    n_reviews = d.get("userRatingCount") if details else c.get("reviews")
    plat = platforms(c)

    if not website:
        out.append(f"no website — Google sends people to {plat}")
    else:
        mk = marketplace_link(website)
        if mk:
            out.append(f"the website link is {'an' if mk[0] in 'AEIOU' else 'a'} {mk} page, not their own")

    if details:
        sat = saturday_open(details)
        if sat is None:
            out.append("no hours on Google")
        elif sat == "closed":
            out.append("Google says closed Saturdays")
        cur = (d.get("currentOpeningHours") or {}).get("weekdayDescriptions")
        reg = (d.get("regularOpeningHours") or {}).get("weekdayDescriptions")
        if cur and reg and cur != reg:
            out.append("special hours set this week (check they're right)")
        n_photos = len(d.get("photos") or [])
        if n_photos == 0:
            out.append("no photos")
        elif n_photos < 5:
            out.append(f"only {n_photos} photos")
        revs = d.get("reviews") or []
        newest = None
        for r in revs:
            age = review_age_days(r, today)
            if age is not None and (newest is None or age < newest):
                newest = age
        low = [r for r in revs if (r.get("rating") or 5) <= 3]
        if low:
            r = min(low, key=lambda r: review_age_days(r, today) or 9999)
            out.append(f"a {r.get('rating')}★ review {r.get('relativePublishTimeDescription') or ''}".strip())
        if newest is not None and newest > STALE_REVIEW_DAYS:
            out.append(f"newest review is {newest // 30} months old")
        if not d.get("nationalPhoneNumber"):
            out.append("no phone on Google")
    if c.get("parasite_url") and not (details and website and not marketplace_link(website)):
        out.append(f"searching the name brings up {host_of(c['parasite_url'])}, a menu page they don't control")
    if n_reviews is not None and n_reviews < 100:
        out.append(f"only {n_reviews} reviews")
    if rating is not None and rating < 4.0:
        out.append(f"rating {rating}")

    stars = f"{rating}★ ({n_reviews})" if rating is not None else "no rating"
    if details:
        n_photos = len(d.get("photos") or [])
        photos = "10+ photos" if n_photos >= 10 else f"{n_photos} photos"
        web = "no website" if not website else (f"website → {marketplace_link(website)}" if marketplace_link(website) else host_of(website))
        summary = f"{stars} · {photos} · {web} · on {plat}"
    else:
        web = "no website" if not website else (f"website → {marketplace_link(website)}" if marketplace_link(website) else host_of(website))
        summary = f"{stars} · {web} · on {plat} · (census only)"
    return out, summary


def business_faults(c, details, today):
    """faults() for a service business, a creative, a shop or a nonprofit (B44): the presence first (no site, a
    social page or a directory profile as the site, a dead business.site, a free builder address), then what the
    listing shows when it was read (no hours, under five photos, a low review, a street address where a trade
    would show a service area). Works with details=None (census only)."""
    d = details or {}
    cls, label, url = presence(c, (d.get("websiteUri") or "") if details else None)
    c["presence"], c["presence_label"], c["presence_link"] = cls, label, url
    out = []
    pf = presence_fault(cls, label, url)
    if pf:
        out.append(pf)
    rating = d.get("rating") if details else c.get("rating")
    n_reviews = d.get("userRatingCount") if details else c.get("reviews")
    if details:
        hours = (d.get("regularOpeningHours") or {}).get("periods")
        if not hours:
            out.append("no hours on Google")
        n_photos = len(d.get("photos") or [])
        if n_photos == 0:
            out.append("no photos")
        elif n_photos < 5:
            out.append(f"only {n_photos} photos")
        if (c.get("segment") == "services" and not d.get("pureServiceAreaBusiness")
                and re.match(r"^\d", d.get("formattedAddress") or "")):
            out.append("Google shows a street address, not the area they serve")
        revs = d.get("reviews") or []
        ages = [a for a in (review_age_days(r, today) for r in revs) if a is not None]
        low = [r for r in revs if (r.get("rating") or 5) <= 3]
        if low:
            r = min(low, key=lambda r: review_age_days(r, today) or 9999)
            out.append(f"a {r.get('rating')}★ review {r.get('relativePublishTimeDescription') or ''}".strip())
        if ages and min(ages) > STALE_REVIEW_DAYS:
            out.append(f"newest review is {min(ages) // 30} months old")
        if not d.get("nationalPhoneNumber"):
            out.append("no phone on Google")
    if n_reviews is not None and n_reviews < 10:
        out.append(f"only {n_reviews} reviews")
    if rating is not None and rating < 4.0:
        out.append(f"rating {rating}")
    stars = f"{rating}★ ({n_reviews})" if rating is not None else "no rating"
    bits = [stars, presence_short(cls, label, url)]
    if details:
        n_photos = len(d.get("photos") or [])
        bits.append("10+ photos" if n_photos >= 10 else f"{n_photos} photos")
    bits.append(c.get("category") or (d.get("primaryTypeDisplayName") or {}).get("text") or c.get("segment") or "")
    summary = " · ".join(b for b in bits if b) + ("" if details else " · (census only)")
    return out, summary


def live_segment(details):
    """A name looked up live (not in either census): None for food (the restaurant faults), 'services' for a
    business people book (the service-area check applies), 'retail' for anything else (a storefront)."""
    t = (details or {}).get("primaryType")
    if is_food(t):
        return None
    return "services" if is_service({"primary_type": t}, None) else "retail"


def is_food(primary_type):
    t = (primary_type or "").lower()
    return any(w in t for w in FOOD_WORDS)


def booking_link(c, details):
    """How people book this place online, or None (B40: None prints the tool line).
    Google's `reservable`, else the listing's (or the census's) website on a booking host."""
    d = details or {}
    if d.get("reservable"):
        return "reservations on Google"
    url = d.get("websiteUri") if details else c.get("website")
    low = (url or "").lower()
    for h in BOOKING_HOSTS:
        if h in low:
            return f"books on {host_of(url)}"
    return None


def is_service(c, details):
    """A service business (pool care, cleaning, lessons): a known primary type that isn't food or drink."""
    t = ((details or {}).get("primaryType") or c.get("primary_type") or "").strip().lower()
    if not t or t in NOT_SERVICE:
        return False
    return t in SERVICE_TYPES or t.endswith(SERVICE_SUFFIXES)


# ---- the kit --------------------------------------------------------------------

def route(picks, start):
    """Nearest-neighbour from home. Six stops; good enough for a morning."""
    left, order, at = list(picks), [], start
    while left:
        nxt = min(left, key=lambda p: miles(at, (p["lat"], p["lng"])))
        left.remove(nxt)
        order.append(nxt)
        at = (nxt["lat"], nxt["lng"])
    return order


def loop_miles(order, start):
    total, at = 0.0, start
    for p in order:
        total += miles(at, (p["lat"], p["lng"]))
        at = (p["lat"], p["lng"])
    return total + miles(at, start)


def build_kit(args):
    for_date = dt.date.fromisoformat(args.for_date) if args.for_date else next_saturday()
    today = dt.datetime.now(TZ).date()
    key, where = (None, None) if args.census_only else places_key()
    places = Places(key, where, fixture=args.fixture, refresh=args.refresh)
    cands = census_candidates(args.min_reviews)
    skip = {} if args.allow_repeat else recently_kitted(for_date)
    skip.update({pid: "pipeline" for pid in pipeline_skip()})
    skip.update({pid: "claimed" for pid in claimed_places()})   # B45: they took the preview; they're a client
    pool = [c for c in cands if c["miles"] <= args.radius and c["place_id"] not in skip]
    if not pool:
        die(f"no candidates within {args.radius} miles of home; widen --radius")

    picks, skipped, cap = [], [], max(args.n * 5, 20)
    for c in pool[:cap]:
        if len(picks) >= args.n:
            break
        details = places.get(c["place_id"]) if (key or args.fixture) else None
        if places.failed and not args.fixture:
            details = None
        c = dict(c)
        c["details"] = details
        if details:
            if details.get("businessStatus") not in (None, "OPERATIONAL"):
                skipped.append((c["name"], details.get("businessStatus", "").lower().replace("_", " ")))
                continue
            sat = saturday_open(details)
            if sat == "closed":
                skipped.append((c["name"], "closed Saturdays"))
                continue
            if sat is not None and sat > LATEST_OPEN:
                skipped.append((c["name"], f"opens Sat {clock(sat)}"))
                continue
            c["sat_open"] = sat
            loc = details.get("location") or {}
            if loc.get("latitude") is not None:
                c["lat"], c["lng"] = loc["latitude"], loc["longitude"]
            c["address"] = details.get("formattedAddress") or c["address"]
            c["phone"] = details.get("nationalPhoneNumber") or c["phone"]
            c["maps"] = clean_maps(details.get("googleMapsUri") or c["google_maps_uri"])
            c["name"] = (details.get("displayName") or {}).get("text") or c["name"]
        else:
            c["sat_open"] = None
            c["maps"] = clean_maps(c["google_maps_uri"])
        c["faults"], c["summary"] = faults(c, details, today)
        c["booking"] = booking_link(c, details)
        picks.append(c)

    start = home()
    order = route(picks, start)
    for p in order:
        p["miles"] = round(miles(start, (p["lat"], p["lng"])), 1)

    if places.calls:
        ledger_append({
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
            "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
            "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global", "for": for_date.isoformat(),
        })

    page = render(order, for_date, today, mode=("fixture" if args.fixture else "google" if (key and not places.failed) else "census"),
                  note=places.failed, skipped=skipped, census_date=census_stamp(cands), loop=loop_miles(order, start),
                  short=len(order) < args.n, n=args.n)

    if not args.fixture and not args.no_save:
        (STATE / "kits").mkdir(parents=True, exist_ok=True)
        (STATE / "kits" / f"{for_date.isoformat()}.md").write_text(page)
        with open(STATE / "kits.jsonl", "a") as f:
            f.write(json.dumps({"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "for": for_date.isoformat(),
                                "place_ids": [p["place_id"] for p in order], "names": [p["name"] for p in order],
                                "mode": "google" if key and not places.failed else "census", "calls": places.calls}) + "\n")
    return page, order


def clean_maps(url):
    """The census stores Google's tracking suffix (&g_mp=...); the phone doesn't need it."""
    return re.sub(r"[&?]g_mp=[^&]*", "", url or "")


def short_address(addr):
    """'123 E Main St, American Fork, UT 84003, USA' -> '123 E Main St, American Fork'."""
    parts = [p.strip() for p in (addr or "").split(",")]
    return ", ".join(parts[:2]) if len(parts) >= 2 else (addr or "")


def render(order, for_date, today, mode, note, skipped, census_date, loop, short, n):
    lines = []
    head = f"Saturday kit — {for_date.strftime('%a %-d %b')}, 9–11 · {len(order)} counters from American Fork · ~{loop:.0f} mi loop"
    lines.append(head)
    if mode == "google":
        lines.append(f"(Google listings read {today.strftime('%a %-d %b')}; census {census_date})")
    elif mode == "fixture":
        lines.append("(FIXTURE listings — a test, not Google)")
    else:
        lines.append(f"(census {census_date} only — no Places key on this machine, so hours, photos and recent reviews are missing; TAYLOR-TODO §1)")
        if note:
            lines.append(f"({note})")
    if mode == "google" and note:
        lines.append(f"({note})")
    lines.append("")
    for i, p in enumerate(order, 1):
        opens = f"opens Sat {clock(p['sat_open'])}" if isinstance(p.get("sat_open"), tuple) else "Sat hours unknown, call first"
        phone = p.get("phone") or "no phone"
        lines.append(f"{i}. {p['name']} — {p['miles']} mi · {short_address(p['address'])} · {opens} · {phone}")
        lines.append(f"   Google: {p['summary']}")
        lines.append(f"   Wrong: {' · '.join(p['faults']) if p['faults'] else 'nothing obvious — lead with the text-Patch line'}")
        if not p.get("booking"):
            lines.append("   No booking link → the tool line (below)")
        if p.get("maps"):
            lines.append(f"   {p['maps']}")
        lines.append("")
    if short:
        lines.append(f"(only {len(order)} of {n}: the rest of the nearby pool is closed Saturday mornings; widen --radius)")
        lines.append("")
    if skipped:
        lines.append("Skipped: " + "; ".join(f"{name} ({why})" for name, why in skipped[:8]))
        lines.append("")
    lines += [
        "Open with the fault, not the pitch: \"Your Google listing is where people find you and it's got <the thing above>. "
        "Text me the fix and it's live today, free. If you want it kept right, that's $99 a month and I'm on the hook for all of it.\"",
        "The line to test: \"Text Patch and it's done. Your Google listing, your menu, your hours, changed in a minute by a number you text. It's AI, with someone on the hook.\"",
        "Ordering is not on offer (VISION § Decided, 2026-09-24): if they ask about their own ordering page, say not yet, plainly, and sell the listing.",
    ]
    if any(not p.get("booking") for p in order):
        lines.append(TOOL_LINE)
    lines += [
        "",
        "Log every conversation by text: \"log <name> talked|interested|… <note>\" (`leads log`). Owner replies to reviews aren't in the Places API — glance at the listing for unanswered ones.",
    ]
    return "\n".join(lines) + "\n"


# ---- the kit for any other segment (B44) ------------------------------------------------

def read_pick(c, details, today):
    """A candidate with its listing folded in and its faults worked out (either census)."""
    c = dict(c, details=details)
    if details:
        c["name"] = (details.get("displayName") or {}).get("text") or c["name"]
        c["address"] = details.get("formattedAddress") or c.get("address")
        c["phone"] = details.get("nationalPhoneNumber") or c.get("phone")
        c["maps"] = clean_maps(details.get("googleMapsUri") or c.get("google_maps_uri"))
    else:
        c["maps"] = clean_maps(c.get("google_maps_uri"))
    c["faults"], c["summary"] = (business_faults if is_business(c) else faults)(c, details, today)
    c["booking"] = booking_link(c, details)
    return c


def nearest_pool(cands, radius, n, skip):
    """Within the radius; if that's short of n, the nearest n wherever they are (the census is the valley)."""
    left = [c for c in cands if c["place_id"] not in skip]
    pool = [c for c in left if c["miles"] <= radius]
    return (pool, None) if len(pool) >= n or len(left) == len(pool) else (left, radius)


def build_segment_kit(args, segment):
    today = dt.datetime.now(TZ).date()
    for_date = dt.date.fromisoformat(args.for_date) if args.for_date else today
    key, where = (None, None) if args.census_only else places_key()
    places = Places(key, where, fixture=args.fixture, refresh=args.refresh)
    cands = candidates_for(segment, args.min_reviews)
    skip = {} if args.allow_repeat else recently_kitted(for_date)
    skip.update({pid: "pipeline" for pid in pipeline_skip()})
    skip.update({pid: "claimed" for pid in claimed_places()})   # B45: they took the preview; they're a client
    pool, widened = nearest_pool(cands, args.radius, args.n, skip)
    if not pool:
        die(f"no {SEGMENT_NOUN[segment]} left to kit (all kitted or in the pipeline); --allow-repeat" if cands else
            f"no {SEGMENT_NOUN[segment]} in the census's pool yet (a phone, ≥{SEGMENT_MIN_REVIEWS if args.min_reviews is None else args.min_reviews} "
            "reviews, no site of their own); `leads doctor` counts them")
    picks, skipped = [], []
    for c in pool:
        if len(picks) >= args.n:
            break
        details = places.get(c["place_id"]) if (key or args.fixture) else None
        if places.failed and not args.fixture:
            details = None
        if details and details.get("businessStatus") not in (None, "OPERATIONAL"):
            skipped.append((c["name"], details.get("businessStatus", "").lower().replace("_", " ")))
            continue
        picks.append(read_pick(c, details, today))
    if places.calls:
        ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
                       "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
                       "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global",
                       "for": f"{segment} {for_date.isoformat()}"})
    mode = "fixture" if args.fixture else "google" if (key and not places.failed) else "census"
    page = render_segment(picks, segment, for_date, today, mode, places.failed, skipped, census_stamp(cands), widened, args.n)
    if not args.fixture and not args.no_save:
        (STATE / "kits").mkdir(parents=True, exist_ok=True)
        (STATE / "kits" / f"{for_date.isoformat()}-{segment}.md").write_text(page)
        with open(STATE / "kits.jsonl", "a") as f:
            f.write(json.dumps({"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "for": for_date.isoformat(),
                                "segment": segment, "place_ids": [p["place_id"] for p in picks],
                                "names": [p["name"] for p in picks], "mode": mode, "calls": places.calls}) + "\n")
    return page, picks


def segment_copy(segments):
    """The opener, the close and one ladder line per business segment on the page (restaurants keep theirs)."""
    lines = []
    if any(s in BUSINESS_SEGMENTS for s in segments):
        lines += [SEGMENT_OPENER, SEGMENT_CLOSE]
        lines += [SEGMENT_LADDER[s] for s in BUSINESS_SEGMENTS if s in segments]
    if "restaurant" in segments:
        lines.append("A restaurant on the list: open with its fault the same way and sell the listing, the menu and the site; "
                     "ordering is not on offer (VISION § Decided, 2026-09-24).")
    return lines


def render_segment(order, segment, for_date, today, mode, note, skipped, census_date, widened, n):
    lines = [f"{SEGMENT_TITLE[segment]} kit — {for_date.strftime('%a %-d %b')} · {len(order)} {SEGMENT_NOUN[segment]} "
             f"nearest American Fork{'' if segment == 'all' else ' with no site of their own'} · call, or drop by"]
    if mode == "google":
        lines.append(f"(Google listings read {today.strftime('%a %-d %b')}; census {census_date})")
    elif mode == "fixture":
        lines.append("(FIXTURE listings — a test, not Google)")
    else:
        lines.append(f"(census {census_date} only — hours, photos and recent reviews aren't read"
                     + ("" if note else " without a Places call") + ")")
    if note:
        lines.append(f"({note})")
    if widened:
        lines.append(f"(fewer than {n} within {widened:g} mi, so the nearest wherever they are)")
    lines.append("")
    for i, p in enumerate(order, 1):
        where = p.get("locality") or (p.get("city") or "").replace(", Utah", "")
        what = p.get("category") or p.get("segment") or ""
        lines.append(f"{i}. {p['name']} — {p['miles']} mi · {what} · {where} · {p.get('phone') or 'no phone'}")
        if is_business(p):
            link = f" — {re.sub(r'^https?://(www[.])?', '', p['presence_link']).rstrip('/')}" if p.get("presence_link") else ""
            lines.append(f"   Presence: {p['presence']}{link}")
        lines.append(f"   Google: {p['summary']}")
        lines.append(f"   Wrong: {' · '.join(p['faults']) if p['faults'] else 'nothing obvious — lead with the text-Patch line'}")
        if p.get("maps"):
            lines.append(f"   {p['maps']}")
        lines.append("")
    if skipped:
        lines.append("Skipped: " + "; ".join(f"{name} ({why})" for name, why in skipped[:8]))
        lines.append("")
    lines += segment_copy({p.get("segment") or "restaurant" for p in order} or {segment})
    lines += ["",
              "Log every conversation by text: \"log <name> talked|interested|… <note>\" (`leads log`). Owner replies to "
              "reviews aren't in the Places API — glance at the listing for unanswered ones."]
    return "\n".join(lines) + "\n"


# ---- the remote lane (B25) -------------------------------------------------------

GROUPS_LOG = Path(os.environ.get("LEADS_GROUPS_LOG", PROJECTS / "social/leads-from-groups.md"))
SIGNOFF = "Taylor"
IG_SKIP = {"p", "reel", "reels", "explore", "stories", "tv", "accounts", "popular"}
FB_SKIP = {"groups", "events", "pages", "search", "watch", "marketplace", "hashtag", "people", "share", "sharer",
           "profile.php"}   # facebook.com/share/<id> is somebody's share link, not a page to message
TEXT_SEARCH_URL = "https://places.googleapis.com/v1/places:searchText"
TEXT_SEARCH_COST_USD = 0.032


def mail_address():
    return os.environ.get("LEADS_MAIL_ADDRESS") or _env_file(ENV_FILE).get("LEADS_MAIL_ADDRESS")


def reach(c):
    """Where the owner can be messaged, from the census's own search results, then B61's `reach` table:
    {'instagram', 'facebook', 'email'}."""
    out = {"instagram": None, "facebook": None, "email": (c.get("contact_email") or "").strip() or None}
    try:
        top = json.loads(c.get("serp_top3") or "[]")
    except ValueError:
        top = []
    for t in top:
        url = t.get("url") or ""
        m = re.match(r"^https?://(?:www\.|m\.)?instagram\.com/([A-Za-z0-9_.]+)", url)
        if m and not out["instagram"] and m.group(1).lower() not in IG_SKIP:
            out["instagram"] = m.group(1)
        m = re.match(r"^https?://(?:www\.|m\.|web\.)?facebook\.com/([^/?#]+)", url)
        if m and not out["facebook"] and m.group(1).lower() not in FB_SKIP:
            out["facebook"] = f"facebook.com/{m.group(1)}"
    return reach_fill(out, c.get("place_id"))


def clean_name(name):
    """'Pho 99 - Murray' → 'Pho 99'; 'WHISTLE WOK' → 'Whistle Wok'. A greeting reads wrong otherwise."""
    n = re.split(r"\s+[-–|]\s+", name or "", maxsplit=1)[0].strip() or name or ""
    return n.title() if n.isupper() else n


def to_them(fault):
    """The listing's faults are written about the place; a message is written to it."""
    return (fault.replace(" not their own", " not your own").replace("they don't control", "you don't control")
            .replace("Google says closed", "Google says you're closed"))


def chain_names():
    """Names at three or more places in the census: chains the census didn't flag."""
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    rows = conn.execute("SELECT lower(name), count(*) FROM place_cache GROUP BY lower(name) HAVING count(*) >= 3").fetchall()
    conn.close()
    return {r[0] for r in rows}


def lead_faults(c, details, today):
    """The faults a message may name: things on the listing, not the review count or the rating."""
    fs, summary = (business_faults if is_business(c) else faults)(c, details, today)
    return [f for f in fs if not re.match(r"^(only \d+ reviews|rating )", f)], summary


def dm_text(c, fs):
    """The Instagram / Facebook message, from Taylor's phone. Two faults at most; no price, no pitch."""
    name = clean_name(c["name"])
    shown = [to_them(f) for f in fs[:2]]
    what = " — and ".join(shown)
    fix = "Both are easy to fix." if len(shown) > 1 else "It's easy to fix."
    return (f"Hi {name} team — I'm Taylor, a small-business owner in American Fork; I fix Google listings for "
            f"local restaurants. I looked yours up: {what}. {fix} Want me to send you exactly what to change? "
            f"Free, no strings.")


def tool_dm_text(c, fs):
    """B40, the second variant: a service business with no way to book online. One listing fault at most, then the
    tool (a booking page on their own site, the list private to them). No price, like the first."""
    name = clean_name(c["name"])
    fault = f" While I was there: {to_them(fs[0])}." if fs else ""
    return (f"Hi {name} team — I'm Taylor, a small-business owner in American Fork; I build websites and web tools for "
            f"local businesses. I looked you up: there's no way to book you online from Google or your website.{fault} "
            f"Where do the bookings live now — a notebook, a spreadsheet? I can put a booking page on your own site, with "
            f"every booking on a private page only you open. There are working ones at {TOOLS_URL} if you want a look.")


def message_for(c):
    """Which of the two messages a pick gets: the tool variant for a service business with no booking link."""
    if is_service(c, c.get("details")) and not c.get("booking"):
        return "tool", tool_dm_text(c, c["faults"])
    return "listing", dm_text(c, c["faults"])


def email_draft(c, fs):
    name = clean_name(c["name"])
    if c.get("variant") == "tool":
        subject = f"{name}: booking online"
        return subject, tool_dm_text(c, fs).replace(f"Hi {name} team — I'm Taylor,", f"Hi {name} team,\n\nI'm Taylor Remund —", 1)
    subject = f"{name} on Google — {'two quick fixes' if len(fs) > 1 else 'a quick fix'}"
    return subject, dm_text(c, fs).replace(f"Hi {name} team — I'm Taylor,", f"Hi {name} team,\n\nI'm Taylor Remund —", 1)


def email_footer():
    addr = mail_address()
    return ("— Taylor Remund · Patchlamp (Plateful LLC) · founder@patchlamp.com · "
            + (addr if addr else "[POSTAL ADDRESS — required by CAN-SPAM; not set, so don't send yet: TAYLOR-TODO §1]")
            + "\nIf you'd rather not hear from me, reply \"no thanks\" and I won't write again.")


def contacted(days=REPEAT_WEEKS * 7):
    """place_id -> date for leads messaged (remote kits) or kitted (Saturday) recently."""
    since = dt.datetime.now(TZ).date() - dt.timedelta(days=days)
    seen = {}
    for name in ("remote.jsonl", "kits.jsonl"):
        p = STATE / name
        if not p.exists():
            continue
        for line in p.read_text().splitlines():
            try:
                k = json.loads(line)
                d = dt.date.fromisoformat((k.get("for") or k.get("ts") or "")[:10])
            except (ValueError, TypeError):
                continue
            if d >= since:
                for pid in k.get("place_ids", []):
                    seen[pid] = d.isoformat()
    return seen


def log_leads(rows):
    """Append to social/leads-from-groups.md (a markdown table beside the pipeline)."""
    try:
        GROUPS_LOG.parent.mkdir(parents=True, exist_ok=True)
        new = not GROUPS_LOG.exists()
        with open(GROUPS_LOG, "a") as f:
            if new:
                f.write("# Leads from the groups and the remote kit (B25)\n\n"
                        "One row per lead: where the name came from, how to reach them, what was wrong. "
                        "The pipeline itself (stages, follow-ups) is `leads log`, in private-docs/leads/.\n\n"
                        "| date | name | city | source | reach | what was wrong | what happened |\n"
                        "|---|---|---|---|---|---|---|\n")
            for r in rows:
                cells = [r["date"], r["name"], r.get("city") or "", r["source"], r.get("reach") or "", r.get("wrong") or "", ""]
                f.write("| " + " | ".join(str(x).replace("|", "/").replace("\n", " ") for x in cells) + " |\n")
    except OSError as exc:
        print(f"leads: couldn't write {GROUPS_LOG} ({exc})", file=sys.stderr)


def reach_line(rc):
    bits = []
    if rc["instagram"]:
        bits.append(f"Instagram @{rc['instagram']}")
    if rc["facebook"]:
        bits.append(rc["facebook"])
    if rc["email"]:
        bits.append(rc["email"])
    return " · ".join(bits)


def build_remote(args):
    today = dt.datetime.now(TZ).date()
    key, where = (None, None) if args.census_only else places_key()
    places = Places(key, where, fixture=args.fixture, refresh=args.refresh)
    cands = census_candidates(args.min_reviews)
    skip = {} if args.allow_repeat else contacted()
    skip.update({pid: "pipeline" for pid in pipeline_skip()})
    skip.update({pid: "claimed" for pid in claimed_places()})   # B45: they took the preview; they're a client
    chains = chain_names()
    pool = [c for c in cands if c["miles"] <= args.radius and c["place_id"] not in skip
            and (c["name"] or "").lower() not in chains]
    for c in pool:
        c["reach"] = reach(c)
    # messageable first (a handle or an address), then nearest
    pool.sort(key=lambda c: (not (c["reach"]["instagram"] or c["reach"]["facebook"] or c["reach"]["email"]), c["miles"]))
    picks = []
    for c in pool:
        if len(picks) >= args.n:
            break
        details = places.get(c["place_id"]) if (key or args.fixture) else None
        if places.failed and not args.fixture:
            details = None
        if details and details.get("businessStatus") not in (None, "OPERATIONAL"):
            continue
        c = dict(c, details=details)
        if details:
            c["name"] = (details.get("displayName") or {}).get("text") or c["name"]
            c["maps"] = clean_maps(details.get("googleMapsUri") or c["google_maps_uri"])
        else:
            c["maps"] = clean_maps(c["google_maps_uri"])
        c["faults"], c["summary"] = lead_faults(c, details, today)
        c["booking"] = booking_link(c, details)
        c["variant"], c["message"] = message_for(c)
        if not c["faults"] and c["variant"] != "tool":
            continue          # a message has to name something real that's wrong (no booking link is, for a service business)
        c["summary"] = c["summary"].replace(" · (census only)", "")
        picks.append(c)
    if places.calls:
        ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
                       "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
                       "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global", "for": f"remote {today}"})
    kit_previews(picks, build=getattr(args, "previews", False),      # B45: a link per pick, built with --previews
                 publish=not getattr(args, "no_save", False))
    mode = "fixture" if args.fixture else "google" if (key and not places.failed) else "census"
    page = render_remote(picks, today, mode, places.failed, census_stamp(cands))
    if not args.fixture and not args.no_save:
        (STATE / "remote").mkdir(parents=True, exist_ok=True)
        (STATE / "remote" / f"{today.isoformat()}.md").write_text(page)
        # the same seam `--json` prints, kept on disk so `leads today` can read the morning's six
        # without paying for the listings twice
        (STATE / "remote" / f"{today.isoformat()}.json").write_text(
            json.dumps(kit_json(picks, "restaurant", today), indent=1, default=str) + "\n")
        with open(STATE / "remote.jsonl", "a") as f:
            f.write(json.dumps({"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "for": today.isoformat(),
                                "place_ids": [p["place_id"] for p in picks], "names": [p["name"] for p in picks], "mode": mode}) + "\n")
        log_leads([{"date": today.isoformat(), "name": clean_name(p["name"]), "city": p.get("locality") or p.get("city"), "source": "remote kit",
                    "reach": reach_line(p["reach"]) or p.get("phone"), "wrong": "; ".join(p["faults"][:3])} for p in picks])
    return page, picks


def render_remote(picks, today, mode, note, census_date, compact=False):
    """One Telegram message (4,096 characters): over 3,900 and the per-lead email lines go."""
    if not compact:
        page = render_remote(picks, today, mode, note, census_date, compact=True)
        full = _render_remote(picks, today, mode, note, census_date, emails=True)
        return full if len(full) <= 3900 else page
    return _render_remote(picks, today, mode, note, census_date, emails=False)


def _render_remote(picks, today, mode, note, census_date, emails):
    lines = [f"Remote kit — {today.strftime('%a %-d %b')} · {len(picks)} messages to send from your phone"]
    if mode == "census":
        lines.append(f"(census {census_date} only — no Places key here, so hours, photos and reviews aren't checked; TAYLOR-TODO §1)")
    elif mode == "fixture":
        lines.append("(FIXTURE listings — a test, not Google)")
    else:
        lines.append(f"(Google listings read today; census {census_date})")
    if note:
        lines.append(f"({note})")
    lines.append("")
    for i, p in enumerate(picks, 1):
        rc = p["reach"]
        lines.append(f"{i}. {clean_name(p['name'])} — {p.get('locality') or p.get('city') or ''} · {p['summary']}")
        if rc["instagram"]:
            lines.append(f"   DM on Instagram: instagram.com/{rc['instagram']}")
        elif rc["facebook"]:
            lines.append(f"   Message on Facebook: {rc['facebook']}")
        elif rc["email"]:
            lines.append(f"   Email: {rc['email']}")
        else:
            lines.append(f"   No handle or address found — call {p.get('phone') or 'them'}; the message is the opener")
        if p.get("variant") == "tool":
            lines.append("   (a service business with no way to book online: the tool message, B40)")
        if p.get("preview_url"):
            lines.append(f"   Their preview site: {p['preview_url']}")
        lines.append(f"   \"{p.get('message') or dm_text(p, p['faults'])}\"")
        if emails:
            subject, _ = email_draft(p, p["faults"])
            to = rc["email"] or ("their FB About" if rc["facebook"] else "none known")
            lines.append(f"   Email (to: {to}): \"{subject}\" + the message + footer")
        if p.get("maps"):
            lines.append(f"   {p['maps']}")
        lines.append("")
    lines += ["Email footer (every cold email, from founder@):", email_footer(), "",
              "No owner names in the census; greet the team. After sending, text \"sent 1 3 4\" (or \"sent all\")."]
    return "\n".join(lines) + "\n"


# ---- the remote lane for any other segment (B44) -------------------------------------------

NOT_A_FIRST_NAME = {"utah", "america", "americas", "nature", "natures", "mother", "mothers", "grandma", "grandmas",
                    "grandpa", "papa", "mama", "uncle", "aunt", "auntie", "dad", "dads", "mom", "moms", "kid", "kids",
                    "everyone", "people", "nana", "granny", "brother", "brothers", "sister", "sisters", "family", "families",
                    "timp", "timpanogos", "wasatch", "provo", "orem", "lehi", "sandy", "draper", "ogden", "layton", "payson",
                    "canyon", "valley", "mountain", "summit", "alpine", "county", "city", "state", "god", "gods", "christ",
                    "king", "kings", "queen", "queens", "doctor", "pro", "pros", "the", "our", "your", "saint", "st"}
FIRST_NAME_RE = r"[A-Z][a-z]{2,11}"


def first_name(name):
    """A first name the business carries, or None: "Mike's Pool Care" → Mike, "Photography by Jenna" → Jenna.
    Only those two shapes — a word that might be a place or a brand is not a person."""
    n = clean_name(name)
    m = re.match(rf"^({FIRST_NAME_RE})['’]s\b", n) or re.search(rf"\b(?:by|with) ({FIRST_NAME_RE})\b(?!['’])", n)
    if m and m.group(1).lower() not in NOT_A_FIRST_NAME:
        return m.group(1)
    return None


def greeting(c):
    """Greet by the first name in the name, else by the business — never "the team" (a solo's listing is one person)."""
    return first_name(c["name"]) or clean_name(c["name"])


def business_reach(c):
    """Where a business can be messaged: the link on its own listing first (an Instagram or Facebook page is a DM,
    a directory profile has its own message button), then B61's `reach` table, which is the only place a service
    business's email address comes from. {'instagram','facebook','directory','email'}."""
    out = {"instagram": None, "facebook": None, "directory": None, "email": None}
    if not c.get("presence"):        # a row straight from census_lookup hasn't been classed yet
        cls, label, link = presence(c)
        c["presence"], c["presence_label"] = cls, label
        c["presence_link"] = c.get("presence_link") or link
    url = c.get("presence_link") or c.get("website") or ""
    m = re.match(r"^(?:https?://)?(?:www\.|m\.)?instagram\.com/([A-Za-z0-9_.]+)", url)
    if m and m.group(1).lower() not in IG_SKIP:
        out["instagram"] = m.group(1)
    m = re.match(r"^(?:https?://)?(?:www\.|m\.|web\.)?facebook\.com/([^/?#]+)", url)
    if m and m.group(1).lower() not in FB_SKIP:
        out["facebook"] = f"facebook.com/{m.group(1)}"
    if c.get("presence") == "directory" and url:
        out["directory"] = (c.get("presence_label") or host_of(url), url)
    return reach_fill(out, c.get("place_id"))


def business_reach_line(rc):
    bits = []
    if rc.get("instagram"):
        bits.append(f"Instagram @{rc['instagram']}")
    if rc.get("facebook"):
        bits.append(rc["facebook"])
    if rc.get("directory"):
        bits.append(f"{rc['directory'][0]} profile")
    if rc.get("email"):
        bits.append(rc["email"])
    return " · ".join(bits)


def to_you(fault):
    """A business fault, said to the owner."""
    said = {"no website on Google": "there's no website on your listing", "no hours on Google": "there are no hours on it",
            "no photos": "there are no photos on it", "no phone on Google": "there's no phone number on it"}
    if fault in said:
        return said[fault]
    if re.match(r"^only \d+ photos$", fault):
        return "it has " + fault
    f = (fault.replace("the website link is a business.site page, and Google shut those down in 2024: it's a dead link",
                       "your listing's website link is a business.site page, which Google shut down in 2024, so it goes nowhere")
         .replace("the website link", "your listing's website link").replace("the website is", "your website is"))
    return (to_them(f).replace("not a site of their own", "not a site of your own")
            .replace("their ", "your ").replace("the area they serve", "the area you serve"))


DM_NOUN = {"nonprofit": "nonprofits and churches around here"}


def segment_dm_text(c, fs):
    """The DM for a trade, a creative, a shop or a nonprofit: greeted by name, the business named, two faults at
    most, the offer is the free diagnostic. No price, no pitch (the close is for when they answer)."""
    hi, biz = greeting(c), clean_name(c["name"])
    shown = [to_you(f) for f in fs[:2]]
    what = " — and ".join(shown)
    fix = "Both are easy to fix." if len(shown) > 1 else "It's easy to fix."
    looked = "I looked yours up on Google" if hi == biz else f"I looked up {biz} on Google"
    return (f"Hi {hi} — I'm Taylor, a small-business owner in American Fork; I fix websites and Google listings for "
            f"{DM_NOUN.get(c.get('segment'), 'businesses around here')}. {looked}: {what}. {fix} Want me to send you exactly "
            f"what to change? Free, no strings.")


def segment_email(c, fs):
    hi, biz = greeting(c), clean_name(c["name"])
    subject = f"{biz} on Google — {'two quick fixes' if len(fs) > 1 else 'a quick fix'}"
    return subject, segment_dm_text(c, fs).replace(f"Hi {hi} — I'm Taylor,", f"Hi {hi},\n\nI'm Taylor Remund —", 1)


def build_segment_remote(args, segment):
    today = dt.datetime.now(TZ).date()
    key, where = (None, None) if args.census_only else places_key()
    places = Places(key, where, fixture=args.fixture, refresh=args.refresh)
    cands = [c for c in candidates_for(segment, args.min_reviews) if is_business(c)]
    skip = {} if args.allow_repeat else contacted()
    skip.update({pid: "pipeline" for pid in pipeline_skip()})
    skip.update({pid: "claimed" for pid in claimed_places()})   # B45: they took the preview; they're a client
    chains = chain_names()
    pool, _ = nearest_pool([c for c in cands if (c["name"] or "").lower() not in chains], args.radius, args.n, skip)
    if not pool:
        die(f"no {SEGMENT_NOUN[segment]} left to message (all contacted or in the pipeline); --allow-repeat" if cands else
            f"no {SEGMENT_NOUN[segment]} in the census's pool yet (a phone, no site of their own); `leads doctor` counts them")
    for c in pool:
        c["reach"] = business_reach(c)
    pool.sort(key=lambda c: (not business_reach_line(c["reach"]), c["miles"]))    # messageable first, then nearest
    picks = []
    for c in pool:
        if len(picks) >= args.n:
            break
        details = places.get(c["place_id"]) if (key or args.fixture) else None
        if places.failed and not args.fixture:
            details = None
        if details and details.get("businessStatus") not in (None, "OPERATIONAL"):
            continue
        c = read_pick(c, details, today)
        c["faults"] = [f for f in c["faults"] if not re.match(r"^(only \d+ reviews|rating )", f)]
        if not c["faults"]:
            continue
        c["reach"] = business_reach(c)
        c["summary"] = c["summary"].replace(" · (census only)", "")
        c["variant"], c["message"] = "listing", segment_dm_text(c, c["faults"])
        picks.append(c)
    kit_previews(picks, build=getattr(args, "previews", False),      # B45: a link per pick, built with --previews
                 publish=not getattr(args, "no_save", False))
    if places.calls:
        ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
                       "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
                       "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global",
                       "for": f"remote {segment} {today}"})
    mode = "fixture" if args.fixture else "google" if (key and not places.failed) else "census"
    page = render_segment_remote(picks, segment, today, mode, places.failed, census_stamp(cands))
    if not args.fixture and not args.no_save:
        (STATE / "remote").mkdir(parents=True, exist_ok=True)
        (STATE / "remote" / f"{today.isoformat()}-{segment}.md").write_text(page)
        (STATE / "remote" / f"{today.isoformat()}-{segment}.json").write_text(
            json.dumps(kit_json(picks, segment, today), indent=1, default=str) + "\n")
        with open(STATE / "remote.jsonl", "a") as f:
            f.write(json.dumps({"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "for": today.isoformat(),
                                "segment": segment, "place_ids": [p["place_id"] for p in picks],
                                "names": [p["name"] for p in picks], "mode": mode}) + "\n")
        log_leads([{"date": today.isoformat(), "name": clean_name(p["name"]),
                    "city": p.get("locality") or (p.get("city") or "").replace(", Utah", ""),
                    "source": f"remote kit ({p.get('category') or segment})",
                    "reach": business_reach_line(p["reach"]) or p.get("phone"), "wrong": "; ".join(p["faults"][:3])}
                   for p in picks])
    return page, picks


def render_segment_remote(picks, segment, today, mode, note, census_date, emails=True):
    lines = [f"Remote kit — {today.strftime('%a %-d %b')} · {SEGMENT_TITLE[segment].lower()} · {len(picks)} messages to send from your phone"]
    if mode == "census":
        lines.append(f"(census {census_date} only — hours, photos and reviews aren't read)")
    elif mode == "fixture":
        lines.append("(FIXTURE listings — a test, not Google)")
    else:
        lines.append(f"(Google listings read today; census {census_date})")
    if note:
        lines.append(f"({note})")
    lines.append("")
    for i, p in enumerate(picks, 1):
        rc = p["reach"]
        where = p.get("locality") or (p.get("city") or "").replace(", Utah", "")
        lines.append(f"{i}. {clean_name(p['name'])} — {p.get('category') or ''} · {where} · {p['summary']}")
        if rc["instagram"]:
            lines.append(f"   DM on Instagram: instagram.com/{rc['instagram']}")
        elif rc["facebook"]:
            lines.append(f"   Message on Facebook: {rc['facebook']}")
        elif rc["directory"]:
            lines.append(f"   Message on {rc['directory'][0]}: {rc['directory'][1]}")
        elif rc.get("email"):
            lines.append(f"   Email: {rc['email']}")
        else:
            lines.append(f"   No page to message — call {p.get('phone') or 'them'}; the message is the opener")
        if p.get("preview_url"):
            lines.append(f"   Their preview site: {p['preview_url']}")
        lines.append(f"   \"{p['message']}\"")
        if emails:
            subject, _ = segment_email(p, p["faults"])
            to = rc.get("email") or ("their FB About" if rc["facebook"] else "none known")
            lines.append(f"   Email (to: {to}): \"{subject}\" + the message + footer")
        if p.get("maps"):
            lines.append(f"   {p['maps']}")
        lines.append("")
    lines += ["Email footer (every cold email, from founder@):", email_footer(), "",
              "Greet by the business, or by the first name when the name carries one (Mike's Pool Care → Mike). "
              "When they answer, the close and the ladder are on `leads kit --segment " + segment + "`. "
              "After sending, text \"sent 1 3 4\" (or \"sent all\")."]
    page = "\n".join(lines) + "\n"
    if emails and len(page) > 3900:
        return render_segment_remote(picks, segment, today, mode, note, census_date, emails=False)
    return page


def norm(text):
    text = re.sub(r"[^a-z0-9 ]+", " ", (text or "").lower().replace("&", " and "))
    return [w for w in text.split() if len(w) > 1 and w not in {"the", "restaurant", "and", "cafe", "grill", "llc", "co"}]


def census_lookup(name, city=None):
    """Every place in the census whose name matches, best first: (score, row)."""
    if not CENSUS.exists():
        die(f"no census at {CENSUS} (LEADS_DB)")
    has_b, _ = businesses_state()
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    b_cols = ("CASE WHEN r.place_id IS NULL THEN b.segment END AS segment, b.category, b.presence_class, b.presence_url, COALESCE(r.city, b.city) AS city" if has_b else
              "NULL AS segment, NULL AS category, NULL AS presence_class, NULL AS presence_url, r.city")
    b_join = "LEFT JOIN businesses b ON b.place_id = p.place_id" if has_b else ""
    rows = conn.execute(f"""
        SELECT p.place_id, p.name, p.address, p.locality, p.phone, p.website, p.has_website, p.rating, p.reviews,
               p.lat, p.lng, p.primary_type, p.google_maps_uri, p.refreshed_at, p.business_status,
               r.on_doordash, r.on_uber, r.on_grubhub, r.channel_class, r.parasite_url, r.serp_top3,
               r.contact_name, r.contact_email, {b_cols}
        FROM place_cache p LEFT JOIN restaurants r ON r.place_id = p.place_id {b_join}""").fetchall()
    conn.close()
    want = norm(name)
    if not want:
        return []
    wc = " ".join(norm(city)) if city else None
    out = []
    for r in rows:
        have = norm(r["name"])
        if not have:
            continue
        hit = len(set(want) & set(have))
        if hit == 0 or hit / len(set(want)) < 0.75:
            continue          # most of what was typed has to be in the name: "Joe's Taco Truck" is not "The Taco Truck"
        score = hit / max(len(set(want)), 1) + 0.5 * hit / max(len(set(have)), 1)
        if " ".join(want) == " ".join(have):
            score += 1
        where = " ".join(norm((r["locality"] or "") + " " + (r["city"] or "") + " " + (r["address"] or "")))
        if wc:
            score += 0.6 if wc in where else -0.6
        out.append((round(score, 3), dict(r)))
    out.sort(key=lambda x: (-x[0], -(x[1]["reviews"] or 0)))
    return [x for x in out if x[0] >= 0.9]


def text_search(key, query):
    """Places Text Search (New) for a name the census doesn't have: its place id, or None."""
    body = json.dumps({"textQuery": query + " Utah", "maxResultCount": 1}).encode()
    req = urllib.request.Request(TEXT_SEARCH_URL, data=body, method="POST", headers={
        "X-Goog-Api-Key": key, "X-Goog-FieldMask": "places.id", "Content-Type": "application/json",
        "User-Agent": "claude-tools/leads"})
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            places = json.loads(resp.read().decode()).get("places") or []
    except (urllib.error.URLError, OSError, ValueError):
        return None
    return places[0]["id"] if places else None


FIX_HINTS = [
    ("no website", "A one-page site with the menu and hours fixes the first one; Google links it the day it's up."),
    ("website link is a", "Pointing the website link at the restaurant's own page (menu, hours) keeps people off the apps' fees."),
    ("searching the name brings up", "A page of the restaurant's own with the menu pushes those scraper sites down within a few weeks."),
    ("no hours", "Hours go in under Google Maps → the listing → Edit profile → Hours; two minutes for the owner."),
    ("closed Saturdays", "If it's open Saturdays, that's Edit profile → Hours on Google Maps; it's costing weekend searches."),
    ("no photos", "Ten real photos of the food and the room is the single biggest lift on a listing."),
    ("only ", "Ten real photos of the food and the room is the single biggest lift on a listing."),
    ("★ review", "A short, polite owner reply to the recent low review reads well to everyone who sees it after."),
    ("months old", "Asking a few regulars for a review this week makes the listing look alive again."),
    ("no phone", "Add the phone number under Edit profile → Contact."),
]


def diagnosis_lines(c, fs, summary, hints=None):
    """Three lines for a group thread: what's good, what's wrong, the easiest fix. No pitch."""
    hints = hints or FIX_HINTS
    name = clean_name(c["name"])
    rating, n = c.get("rating"), c.get("reviews")
    d = c.get("details") or {}
    if d:
        rating, n = d.get("rating", rating), d.get("userRatingCount", n)
    good = f"{rating}★ from {n:,} reviews" if rating and n else "people are finding it"
    first = f"{name}: {good}{', people like it' if (rating or 0) >= 4.2 else ''}."
    if not fs:
        return [first, "On Google: nothing obviously wrong — hours, photos and website all look right from here.",
                "Nice work; the listing's doing its job."]
    second = "On Google: " + "; ".join(fs[:3]) + "."
    hint = next((h for k, h in hints if k in fs[0]), "Each of those is a few minutes in the Business Profile.")
    return [first, second, hint + " Happy to walk you through any of it."]


def cmd_diagnose(args):
    raw = " ".join(args.name).strip()
    if not raw:
        die('say which business: leads diagnose "Name, City"')
    name, _, city = raw.partition(",")
    today = dt.datetime.now(TZ).date()
    key, where = places_key()
    places = Places(key, where, fixture=args.fixture)
    hits = census_lookup(name.strip(), city.strip() or None)
    c = None
    if hits:
        c = hits[0][1]
    elif key and not args.fixture:
        pid = text_search(key, raw)
        if pid:
            ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_text_search",
                           "tool": "leads", "calls": 1, "cost_usd": TEXT_SEARCH_COST_USD,
                           "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global"})
            c = {"place_id": pid, "name": raw, "google_maps_uri": ""}
    if not c:
        die(f"\"{raw}\" isn't in the census" + ("" if key else " and there's no Places key to look it up (TAYLOR-TODO §1)")
            + "; send the Google Maps link or the city")
    from_census = bool(hits) and is_business(c) and not args.live
    # B44: a name in the services census answers from the census — no Places call; --live reads the listing too
    details = places.get(c["place_id"]) if (key or args.fixture) and not from_census else None
    if places.failed and not args.fixture:
        details = None
    if details:
        c["name"] = (details.get("displayName") or {}).get("text") or c["name"]
        c["locality"] = c.get("locality") or ""
        if not hits and live_segment(details):
            c["segment"] = live_segment(details)     # a live lookup that isn't food: a business's faults, not a restaurant's
            c["category"] = (details.get("primaryTypeDisplayName") or {}).get("text")
    c["details"] = details
    fs, summary = lead_faults(c, details, today)
    biz = is_business(c)
    for line in diagnosis_lines(c, fs, summary, BUSINESS_FIX_HINTS if biz else None):
        print(line)
    print()
    rc = business_reach(c) if biz else reach(c)
    rline = business_reach_line(rc) if biz else reach_line(rc)
    at = (c.get("locality") or (c.get("city") or "").replace(", Utah", "")) if biz else (c.get("locality") or c.get("city") or "")
    tail = ("" if details else
            " · from the services census, listing not read (--live reads it)" if from_census else
            " · census only, hours/photos/reviews not checked")
    print(f"({at} · {summary.replace(' · (census only)', '')}"
          + (f" · presence: {c['presence']}" if biz else "")
          + (f" · reach: {rline}" if rline else "")
          + tail
          + (f" · also matched: {', '.join(h[1]['name'] + ' (' + (h[1]['locality'] or '?') + ')' for h in hits[1:3])}" if len(hits) > 1 else "")
          + ")")
    if places.calls:
        ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
                       "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
                       "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global", "for": "diagnose"})
    if not args.no_log:
        log_leads([{"date": today.isoformat(), "name": clean_name(c["name"]), "city": (at or None) if biz else c.get("locality") or c.get("city"),
                    "source": f"group: {args.group}" if args.group else "group thread",
                    "reach": rline, "wrong": "; ".join(fs[:3])}])


# ---- preview sites (B45; plan ~/projects/plans/19-preview-sites.md) -----------------------
#
# A lead's own website, built before the first message, from the census row and
# the Google listing alone. Deterministic: the fill is the segment's template
# plus templates/previews/categories.json (one row per category in
# client-leads/scripts/services.json — the services a category implies, the
# tagline, the intro, a stock-photo term). No model call, so six previews cost
# nothing but the Place Details the kit already paid for.
#
# What is NEVER on a preview: their Google photos (Google's terms, and the
# photographer's copyright), the text of any review, a street address (a
# one-truck trade works from home; the city is what the page says), a claim
# about the business we did not read on the listing, and a price.
#
# Everything lives under ~/.local/state/claude-tools/previews (LEADS_PREVIEWS):
#   site/                what is uploaded: the root page, _headers, robots.txt,
#                        and <slug>/ per preview
#   meta/<slug>.json     the manifest (place_id, expiry, cost) — never uploaded
# One Cloudflare Pages project holds them all, so a publish is one upload of the
# whole tree: removing one preview is deleting its folder and publishing again,
# which is why a takedown takes a minute rather than an hour.

PREVIEWS = Path(os.environ.get("LEADS_PREVIEWS", Path.home() / ".local/state/claude-tools/previews"))
PREVIEW_PROJECT = os.environ.get("LEADS_PREVIEW_PROJECT", "patchlamp-previews")
PREVIEW_DOMAIN = os.environ.get("LEADS_PREVIEW_DOMAIN", "previews.patchlamp.com")
PREVIEW_DAYS = 30
TOOLBELT = Path(__file__).resolve().parent.parent
PREVIEW_TABLE = TOOLBELT / "templates" / "previews" / "categories.json"
PREVIEW_OVERLAY = TOOLBELT / "templates" / "sites" / "_preview"
SITE_TEMPLATES = TOOLBELT / "templates" / "sites"
# The toolbelt commands a preview shells out to. LEADS_PREVIEW_BIN points them at stand-ins so the
# tests can prove the claim and the publish without a Cloudflare project or a GitHub repo.
PREVIEW_BIN = Path(os.environ.get("LEADS_PREVIEW_BIN", TOOLBELT / "bin"))
SITE_BIN = PREVIEW_BIN / "site"
CLIENT_BIN = PREVIEW_BIN / "client"
IMG_BIN = TOOLBELT / "bin" / "img"
# The footer sentence, word for word. patchlamp/CLAIMS.md § Previews carries it;
# `tests/test_leads_preview.py` pins it. Change one and change all three.
PREVIEW_FOOTER = ("A preview Patchlamp made for {name}. Not their official site. "
                  "Claim it, or ask us to take it down: founder@patchlamp.com")


def now_date():
    """Today in Denver, or LEADS_NOW — the clock a preview's 30 days are measured against
    (so `sweep` can be proven by moving the clock instead of waiting a month)."""
    s = (os.environ.get("LEADS_NOW") or "").strip()
    if not s:
        return dt.datetime.now(TZ).date()
    try:
        return dt.date.fromisoformat(s)
    except ValueError:
        die("LEADS_NOW is a date: YYYY-MM-DD")


def esc(text):
    """Safe both in text and inside a double-quoted attribute, and still readable in the source:
    an apostrophe in a business name stays an apostrophe ("Mike's Pool Care"), not &#x27;."""
    return html.escape(str(text or ""), quote=False).replace('"', "&quot;")


def slugify(text):
    """"Mike's Pool Care" -> mikes-pool-care: an apostrophe closes up, everything else separates."""
    s = re.sub(r"['\u2019]", "", (text or "").lower())
    return re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", s)).strip("-")


def preview_copy(category):
    """The category's copy row from templates/previews/categories.json, over the default.
    An unknown category (a name looked up live, a segment we never scanned) still gets a page."""
    try:
        table = json.loads(PREVIEW_TABLE.read_text())
    except (OSError, ValueError) as exc:
        die(f"{PREVIEW_TABLE}: {exc}")
    row = dict(table["_default"])
    row.update(table["categories"].get(category or "", {}))
    row["category"] = category or "local business"
    return row


def preview_meta_dir():
    return PREVIEWS / "meta"


def preview_site_dir():
    return PREVIEWS / "site"


def previews_all():
    d = preview_meta_dir()
    out = []
    for p in sorted(d.glob("*.json")) if d.exists() else []:
        try:
            out.append(json.loads(p.read_text()))
        except ValueError:
            print(f"leads: {p} is not valid JSON — skipped", file=sys.stderr)
    return out


def preview_save(meta):
    preview_meta_dir().mkdir(parents=True, exist_ok=True)
    (preview_meta_dir() / f"{meta['slug']}.json").write_text(json.dumps(meta, indent=1, sort_keys=True) + "\n")


def preview_find(key):
    """A preview by slug, place id, or business name (the way `leads show` matches one)."""
    want = (key or "").strip().lower()
    rows = previews_all()
    for m in rows:
        if want in (m["slug"], (m.get("place_id") or "").lower()):
            return m
    hits = [m for m in rows if want == clean_name(m["name"]).lower()] or \
           [m for m in rows if want and want in m["name"].lower()]
    if len(hits) > 1:
        die("that matches " + ", ".join(m["slug"] for m in hits[:6]) + " — name the slug")
    return hits[0] if hits else None


def preview_slug(name, city, taken):
    base = "-".join(x for x in (slugify(clean_name(name)), slugify(city)) if x)[:60].strip("-") or "preview"
    slug, n = base, 2
    while slug in taken:
        slug, n = f"{base}-{n}", n + 1
    return slug


def phone_href(phone):
    digits = re.sub(r"\D", "", phone or "")
    if len(digits) == 10:
        return "+1" + digits
    if len(digits) == 11 and digits.startswith("1"):
        return "+" + digits
    return "+" + digits if digits else ""


WEEK_ORDER = [1, 2, 3, 4, 5, 6, 0]           # Monday first, the way a week reads on a site
LONG_DAY = {"sunday": 0, "monday": 1, "tuesday": 2, "wednesday": 3, "thursday": 4, "friday": 5, "saturday": 6}


def _group_week(per_day):
    """{day index: 'what it says'} -> ['Mon-Fri: 8am-6pm', 'Sat: 9am-2pm', 'Sun: closed'],
    runs of identical days folded into one line."""
    out, i = [], 0
    while i < len(WEEK_ORDER):
        val = per_day.get(WEEK_ORDER[i]) or "closed"
        j = i
        while j + 1 < len(WEEK_ORDER) and (per_day.get(WEEK_ORDER[j + 1]) or "closed") == val:
            j += 1
        label = DAYS[WEEK_ORDER[i]] if j == i else f"{DAYS[WEEK_ORDER[i]]}-{DAYS[WEEK_ORDER[j]]}"
        out.append(f"{label}: {val}")
        i = j + 1
    return out


def hours_lines(details):
    """The listing's hours as a site shows them: ['Mon-Fri: 8am-6pm', 'Sat: 9am-2pm', 'Sun: closed'],
    or [] when Google has none. Google's own weekdayDescriptions when the listing carries them (its
    wording, its rounding), else the periods, which is what the recorded fixtures hold. A single
    period with an open and no close is Google's "open 24 hours, every day"."""
    hours = (details or {}).get("regularOpeningHours") or {}
    descs = hours.get("weekdayDescriptions") or []
    if descs:
        per_day = {}
        for line in descs:
            day, _, rest = line.partition(":")
            d = LONG_DAY.get(day.strip().lower())
            if d is not None:
                per_day[d] = re.sub(r"\s*[\u2013\u2014-]\s*", "-", rest.strip().replace("\u202f", " ")) or "closed"
        if per_day:
            return _group_week(per_day)
    periods = hours.get("periods")
    if not periods:
        return []
    if len(periods) == 1 and "close" not in periods[0]:
        return ["Open 24 hours, every day"]
    per_day = {}
    for pd in periods:
        o, c = pd.get("open") or {}, pd.get("close")
        span = clock((o.get("hour", 0), o.get("minute", 0))) + (
            "-" + clock((c.get("hour", 0), c.get("minute", 0))) if c else " onwards")
        day = o.get("day")
        if day is None:
            continue
        per_day[day] = (per_day[day] + ", " + span) if day in per_day else span
    return _group_week(per_day) if per_day else []


def preview_where(c, details, city):
    """The city, never the street: a one-truck trade's listing address is often the owner's house."""
    if (details or {}).get("pureServiceAreaBusiness") or (c.get("segment") in ("services", "creatives")):
        return f"{city} and the towns nearby" if city else "The Wasatch Front"
    return f"{city}, Utah" if city else "Utah"


def fill_preview(text, values):
    for k, v in values.items():
        text = text.replace("{{" + k + "}}", str(v))
    return text


def preview_hero(slug, dest, term, mode):
    """The hero photo: one stock landscape (Pexels, free) or one generated image. NEVER one of
    their Google photos. Returns (relative src, credit, cost) or (None, None, 0.0)."""
    if mode == "none":
        return None, None, 0.0
    (dest / "images").mkdir(parents=True, exist_ok=True)
    out = dest / "images"
    if mode == "gen":
        r = subprocess.run([str(IMG_BIN), "gen", "--aspect", "3:2", "--quality", "menu",
                            "--out", str(out), term], capture_output=True, text=True)
        if r.returncode != 0:
            print(f"leads: img gen failed for {slug} ({(r.stderr or r.stdout).strip()[:120]}) — no hero",
                  file=sys.stderr)
            return None, None, 0.0
        made = sorted(out.glob("*.png")) + sorted(out.glob("*.jpg"))
        if not made:
            return None, None, 0.0
        src = made[-1].rename(out / ("hero" + made[-1].suffix))
        # img gen wrote its own ledger row for the dollars; the preview row records the mode.
        return f"images/{src.name}", "generated", 0.0
    r = subprocess.run([str(IMG_BIN), "stock", "-n", "1", "--orientation", "landscape",
                        "--size", "large", "--out", str(out), term], capture_output=True, text=True)
    made = sorted(p for p in out.glob("*") if p.suffix.lower() in (".jpg", ".jpeg", ".png"))
    if r.returncode != 0 or not made:
        print(f"leads: no stock photo for {slug} ({(r.stderr or r.stdout).strip().splitlines()[-1][:120] if (r.stderr or r.stdout).strip() else 'PEXELS_API_KEY?'})"
              " — the page goes out without a hero", file=sys.stderr)
        return None, None, 0.0
    src = made[0].rename(out / ("hero" + made[0].suffix.lower()))
    for p in out.glob("*"):
        if p != src and p.is_file():
            p.unlink()
    return f"images/{src.name}", "stock", 0.0


def build_preview(c, details, args, taken, today=None):
    """One preview: the segment's template filled from the listing. Returns its manifest."""
    today = today or now_date()
    copy = preview_copy(c.get("category"))
    kind = copy["template"]
    tdir = SITE_TEMPLATES / kind
    if not (tdir / "css" / "style.css").exists():
        die(f"templates/sites/{kind} has no css/style.css (categories.json points at it)")
    name = clean_name(c["name"])
    city = (c.get("locality") or (c.get("city") or "").replace(", Utah", "")).strip()
    slug = (c.get("_slug") or preview_slug(name, city, taken))
    dest = preview_site_dir() / slug
    if dest.exists():
        shutil.rmtree(dest)
    (dest / "css").mkdir(parents=True, exist_ok=True)
    (dest / "js").mkdir(parents=True, exist_ok=True)
    vals = {"NAME": esc(name), "YEAR": str(today.year)}
    (dest / "css" / "style.css").write_text(fill_preview((tdir / "css" / "style.css").read_text(), vals))
    (dest / "css" / "preview.css").write_text((PREVIEW_OVERLAY / "css" / "preview.css").read_text())
    (dest / "js" / "main.js").write_text(fill_preview((tdir / "js" / "main.js").read_text(), vals))

    d = details or {}
    phone = d.get("nationalPhoneNumber") or c.get("phone") or ""
    rating = d.get("rating") if details else c.get("rating")
    reviews = d.get("userRatingCount") if details else c.get("reviews")
    maps = clean_maps(d.get("googleMapsUri") or c.get("google_maps_uri"))
    hero_src, hero_kind, hero_cost = preview_hero(slug, dest, copy["hero"], args.hero)
    hrs = hours_lines(details)
    expires = today + dt.timedelta(days=args.days)
    words = {"name": name, "city": city or "the valley", "category": copy["category"], "trade": copy["trade"]}

    hero_block = ""
    if hero_src:
        hero_block = (f'    <figure class="hero-photo">\n'
                      f'      <img src="{hero_src}" alt="{esc(copy["trade"]).capitalize()} work" width="1200" height="400">\n'
                      f'<!--p:herocap-->\n'
                      f'      <figcaption>A stock photo, not {esc(name)}\'s — their own go here.</figcaption>\n'
                      f'<!--/p:herocap-->\n'
                      f'    </figure>')
    rating_block = ""
    if rating is not None and reviews:
        line = (f'<span class="stars">{float(rating):.1f}&#9733;</span> on Google, '
                f'{reviews} review{"s" if reviews != 1 else ""}')
        rating_block = (f'        <p class="rating-line">{line}'
                        + (f' &mdash; <a href="{esc(maps)}">see the listing</a>' if maps else "") + '</p>')
    hours_block = ("            <ul>\n" + "\n".join(f"              <li>{esc(h)}</li>" for h in hrs) + "\n            </ul>"
                   if hrs else
                   f'            <p class="muted">Google doesn\'t show hours for {esc(name)} yet &mdash; '
                   f'this is where they go.</p>')
    services = "\n".join(f'          <li><h3>{esc(h)}</h3><p class="card-meta">{esc(l.format(**words))}</p></li>'
                         for h, l in copy["services"])
    listing_li = f'              <li><a href="{esc(maps)}">Their listing on Google</a></li>' if maps else ""

    page = fill_preview((PREVIEW_OVERLAY / "page.html").read_text(), {
        "NAME": esc(name), "TAGLINE": esc(copy["tagline"].format(**words)),
        "INTRO": esc(copy["intro"].format(**words)), "TRADE": esc(copy["trade"]),
        "CTA": esc(copy["cta"]), "PHONE": esc(phone or "no number on Google"),
        "PHONE_HREF": esc(phone_href(phone)), "HERO_BLOCK": hero_block, "RATING_BLOCK": rating_block,
        "SERVICES": services, "WHERE": esc(preview_where(c, details, city)), "HOURS_BLOCK": hours_block,
        "LISTING_LI": listing_li, "YEAR": str(today.year),
        "EXPIRES_LONG": expires.strftime("%-d %B %Y"), "BUILT_LONG": today.strftime("%-d %B %Y"),
    })
    if "{{" in page:
        die(f"unfilled placeholder in {slug}: " + ", ".join(sorted(set(re.findall(r'\{\{[A-Z_]+\}\}', page)))))
    (dest / "index.html").write_text(re.sub(r"\n{3,}", "\n\n", page))
    meta = {"slug": slug, "place_id": c.get("place_id"), "name": name, "city": city,
            "category": copy["category"], "segment": c.get("segment") or "", "template": kind,
            "phone": phone, "rating": rating, "reviews": reviews, "maps_url": maps,
            "hero": hero_kind or "none", "built": today.isoformat(), "expires": expires.isoformat(),
            "days": args.days, "hours": bool(hrs), "url": preview_url(slug), "claimed": None,
            "cost_usd": round(hero_cost, 4)}
    preview_save(meta)
    ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "preview",
                   "tool": "leads", "cost_usd": round(hero_cost, 4), "billed_to": "none",
                   "project": "global", "slug": slug, "hero": hero_kind or "none",
                   "for": f"preview {meta['name']} ({copy['category']})"})
    return meta


def preview_host():
    """The host previews are served from: the custom domain once its CNAME exists, else the
    project's own pages.dev host (resolved once and remembered)."""
    cache = PREVIEWS / "project.json"
    if os.environ.get("LEADS_PREVIEW_HOST"):
        return os.environ["LEADS_PREVIEW_HOST"]
    try:
        row = json.loads(cache.read_text())
    except (OSError, ValueError):
        row = {}
    return row.get("domain") or row.get("pages_host") or f"{PREVIEW_PROJECT}.pages.dev"


def preview_url(slug):
    return f"https://{preview_host()}/{slug}/"


def preview_root_files():
    """The files the previews project needs at its root: the "nothing to see here" page, the
    404 an expired preview falls to, robots.txt and _headers (both halves of noindex)."""
    site = preview_site_dir()
    (site / "css").mkdir(parents=True, exist_ok=True)
    (site / "js").mkdir(parents=True, exist_ok=True)
    base = SITE_TEMPLATES / "business"
    (site / "css" / "style.css").write_text(fill_preview((base / "css" / "style.css").read_text(),
                                                         {"NAME": "Patchlamp previews"}))
    (site / "css" / "preview.css").write_text((PREVIEW_OVERLAY / "css" / "preview.css").read_text())
    (site / "js" / "main.js").write_text(fill_preview((base / "js" / "main.js").read_text(),
                                                      {"NAME": "Patchlamp previews"}))
    (site / "index.html").write_text((PREVIEW_OVERLAY / "root.html").read_text())
    (site / "404.html").write_text((PREVIEW_OVERLAY / "404.html").read_text())
    (site / "robots.txt").write_text((PREVIEW_OVERLAY / "robots.txt").read_text())
    (site / "_headers").write_text((PREVIEW_OVERLAY / "_headers").read_text())


def preview_publish(dry=False):
    """The whole tree -> the one Pages project, through `site previews` (SITE_ADMIN: it makes and
    writes an account-level project). Returns (ok, the host it reports)."""
    preview_root_files()
    cmd = [str(SITE_BIN), "previews", str(preview_site_dir()), "--project", PREVIEW_PROJECT]
    if dry:
        cmd.append("--dry-run")
    if os.environ.get("LEADS_PREVIEW_YES") == "1":      # Taylor's word, once, for the project's first publish
        cmd.append("--yes")
    r = subprocess.run(cmd, capture_output=True, text=True, env=dict(os.environ, SITE_ADMIN="1"))
    out = (r.stdout + r.stderr).strip()
    print(out)
    host = None
    m = re.search(r"pages host:\s*(\S+)", out)
    if m:
        host = m.group(1)
        PREVIEWS.mkdir(parents=True, exist_ok=True)
        row = {}
        try:
            row = json.loads((PREVIEWS / "project.json").read_text())
        except (OSError, ValueError):
            pass
        row["pages_host"] = host
        row["project"] = PREVIEW_PROJECT
        for dom in re.findall(r"domain:\s*(\S+)\s+active", out):
            row["domain"] = dom
        (PREVIEWS / "project.json").write_text(json.dumps(row, indent=1, sort_keys=True) + "\n")
    return r.returncode == 0, host


def preview_rows_for(args):
    """The businesses to build previews for: the names given, or today's remote-kit picks, or the
    nearest N of the segment's pool. Each comes back as (candidate, details)."""
    segment = resolve_segment(args.segment)
    key, where = (None, None) if args.census_only else places_key()
    places = Places(key, where, fixture=args.fixture, refresh=args.refresh)
    rows, cands = [], candidates_for(segment, args.min_reviews)
    by_id = {c["place_id"]: c for c in cands}
    if args.name:
        for raw in args.name:
            nm, _, city = raw.partition(",")
            hits = census_lookup(nm.strip(), city.strip() or None)
            if not hits:
                die(f"{raw!r} isn't in the census — `leads candidates --segment {segment}` lists the pool, "
                    f'or name the city: "Name, American Fork"')
            c = by_id.get(hits[0][1]["place_id"]) or hits[0][1]
            if len(hits) > 1 and not city.strip():
                print("leads: also matched " + ", ".join(f"{h[1]['name']} ({h[1]['locality'] or '?'})"
                                                         for h in hits[1:3]) + " — add the city to pick another",
                      file=sys.stderr)
            rows.append(c)
    elif args.kit:
        picks = preview_kit_picks(segment, args.n)
        if not picks:
            die(f"no remote kit today and no {SEGMENT_NOUN[segment]} in the pool; "
                f"run `leads kit --remote` first, or name a business")
        rows = [by_id.get(p) or _census_by_id(p) for p in picks]
        rows = [r for r in rows if r]
    else:
        die("which business? `leads preview \"Name, City\"`, or --kit for today's six")
    out = []
    for c in rows[:max(args.n, len(args.name or []))]:
        details = places.get(c["place_id"]) if (key or args.fixture) else None
        if places.failed and not args.fixture:
            details = None
        out.append((c, details))
    if places.calls:
        ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
                       "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
                       "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global",
                       "for": f"previews {segment} {now_date()}"})
    return out


def preview_kit_picks(segment, n):
    """Today's remote-kit place ids for this segment (so a preview matches the message that carries
    its link), else the nearest n of the pool that aren't previewed yet."""
    today = now_date().isoformat()
    log = STATE / "remote.jsonl"
    if log.exists():
        for line in reversed(log.read_text().splitlines()):
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if row.get("for") == today and (row.get("segment") or "restaurant") == segment:
                return row.get("place_ids") or []
    have = {m.get("place_id") for m in previews_all()}
    return [c["place_id"] for c in candidates_for(segment, None) if c["place_id"] not in have][:n]


def make_previews(rows, hero="stock", days=PREVIEW_DAYS, publish=True, dry=False):
    """Build a preview for each (candidate, details) and publish the tree once. A place that already
    has one is rebuilt in place, keeping its slug so a link already sent still works."""
    opts = argparse.Namespace(hero=hero, days=days)
    preview_root_files()       # the tree is complete on disk whether or not it is published
    taken = {m["slug"] for m in previews_all()}
    made = []
    for c, details in rows:
        existing = next((m for m in previews_all() if m.get("place_id") == c["place_id"]), None)
        if existing:
            c = dict(c, _slug=existing["slug"])
        made.append(build_preview(c, details, opts, taken))
        taken.add(made[-1]["slug"])
    ok = True
    if publish and made:
        ok, _ = preview_publish(dry=dry)
    for m in made:
        m["url"] = preview_url(m["slug"])
        preview_save(m)
    return made, ok


def previews_build(args):
    rows = preview_rows_for(args)
    made, ok = make_previews(rows, hero=args.hero, days=args.days,
                             publish=not args.no_publish, dry=args.dry_run)
    if args.no_publish:
        print(f"built {len(made)} preview(s) under {preview_site_dir()} — not published (--no-publish)")
    elif not ok:
        die("the publish failed; the filled pages are still under " + str(preview_site_dir()), 2)
    if args.json:
        print(json.dumps(made, indent=1))
        return
    for m in made:
        print(f"  {m['name']} ({m['category']}, {m['template']} template) -> {m['url']}"
              + ("" if m["hours"] else "  [no hours on Google]"))
    print(f"{len(made)} preview(s); each comes down {made[0]['expires'] if made else '-'} unless claimed "
          f"(`leads preview sweep`, or `leads preview --remove NAME` now).")


def kit_previews(picks, build=False, publish=True):
    """Hang a preview link on each of the kit's picks: the one it already has, and with --previews
    one built for every pick that hasn't got one. Sets `preview_url` (or None) on each pick."""
    rows = previews_all()
    have = {m.get("place_id"): m for m in rows if not m.get("claimed")}
    claimed = {m.get("place_id") for m in rows if m.get("claimed")}
    if build:
        missing = [(c, c.get("details")) for c in picks
                   if c["place_id"] not in have and c["place_id"] not in claimed]
        if missing:
            made, ok = make_previews(missing, publish=publish)
            if not ok:
                print("leads: the previews didn't publish — the messages go out without the link",
                      file=sys.stderr)
                made = []
            for m in made:
                have[m["place_id"]] = m
    for c in picks:
        m = have.get(c["place_id"])
        c["preview_url"] = m["url"] if m else None
        if m and c.get("message"):
            c["message"] += preview_sentence(m["url"])
    return picks


def preview_sentence(url):
    """The line a message adds when the lead already has a page to look at."""
    return (f" I also built you a page to see what one could look like: {url} — nothing to sign, "
            f"and I'll take it down the moment you say so.")


def kit_json(picks, segment, today):
    """The seam `bin/outreach` reads (B46): one object per pick, the keys documented in the
    docstring above. Add keys, never rename one."""
    out = []
    for c in picks:
        rc = c.get("reach") or {}
        fb = rc.get("facebook")
        out.append({
            "place_id": c.get("place_id"), "name": clean_name(c["name"]),
            "first": first_name(c["name"]) or clean_name(c["name"]),
            "category": c.get("category") or "", "segment": c.get("segment") or segment,
            "city": c.get("locality") or (c.get("city") or "").replace(", Utah", ""),
            "phone": c.get("phone") or None, "email": rc.get("email") or None,
            "instagram": rc.get("instagram") or None,
            "facebook": ("https://" + fb if fb and not fb.startswith("http") else fb) or None,
            "faults": list(c.get("faults") or []), "preview_url": c.get("preview_url"),
            "maps_url": c.get("maps") or clean_maps(c.get("google_maps_uri")),
            # beyond the agreed shape, and additive: the draft itself, so a caller doesn't rebuild it
            "message": c.get("message"), "summary": c.get("summary"),
        })
    return {"date": today.isoformat(), "segment": segment, "picks": out}


def cmd_preview(args):
    if args.remove:
        return preview_remove(args)
    if args.claim:
        return preview_claim(args)
    first = (args.name or [None])[0]
    if first in ("ls", "list"):
        return preview_ls(args)
    if first == "sweep":
        return preview_sweep(args)
    return previews_build(args)


def preview_ls(args):
    rows = sorted(previews_all(), key=lambda m: m["expires"])
    today = now_date()
    if not rows:
        print(f"no previews yet ({preview_meta_dir()}); `leads preview --kit` builds today's")
        return
    print(f"{len(rows)} preview(s) on https://{preview_host()}/ (project {PREVIEW_PROJECT}); today {today}")
    w = max(len(m["slug"]) for m in rows)
    for m in rows:
        left = (dt.date.fromisoformat(m["expires"]) - today).days
        state = "CLAIMED " + m["claimed"] if m.get("claimed") else (
            "EXPIRED" if left < 0 else f"{left}d left")
        print(f"  {m['slug']:<{w}}  {state:<16} {m['name']} · {m['category']} · {m['city'] or '-'}")
    if args.json:
        print(json.dumps(rows, indent=1))


def preview_sweep(args):
    """Every preview past its 30 days comes down (the tree, the manifest, one publish)."""
    today = now_date()
    gone = [m for m in previews_all() if not m.get("claimed") and dt.date.fromisoformat(m["expires"]) < today]
    if not gone:
        print(f"nothing expired as of {today} ({len(previews_all())} preview(s) live)")
        return
    for m in gone:
        print(f"  removing {m['slug']} ({m['name']}, expired {m['expires']})")
        if not args.dry_run:
            shutil.rmtree(preview_site_dir() / m["slug"], ignore_errors=True)
            (preview_meta_dir() / f"{m['slug']}.json").unlink(missing_ok=True)
    if args.dry_run:
        print(f"dry run: {len(gone)} would come down")
        return
    preview_root_files()
    if not args.no_publish:
        preview_publish()
    print(f"{len(gone)} preview(s) removed; {len(previews_all())} left")


def preview_remove(args):
    """A takedown: the folder, the manifest, one publish. Minutes, not the hour we promise."""
    m = preview_find(args.remove)
    if not m:
        die(f"no preview for {args.remove!r} (`leads preview ls`)")
    shutil.rmtree(preview_site_dir() / m["slug"], ignore_errors=True)
    (preview_meta_dir() / f"{m['slug']}.json").unlink(missing_ok=True)
    print(f"removed {m['slug']} ({m['name']})")
    if not args.no_publish:
        ok, _ = preview_publish(dry=args.dry_run)
        if not ok:
            die("the files are gone locally but the publish failed — run `leads preview sweep` again", 2)
    print(f"{m['url']} is gone; reply to the owner that it's down.")


CLAIM_STRIP = ("p:robots", "p:css", "p:bar", "p:caveat", "p:footer", "p:herocap")


def claim_html(page, name, year, has_photos):
    """The preview page as the client's own home page: every preview-only block cut at its
    markers, the disclaimers replaced with the site's own words. The markers are in
    templates/sites/_preview/page.html, so this never guesses at prose."""
    for tag in CLAIM_STRIP:
        page = re.sub(rf"<!--{tag}-->.*?<!--/{tag}-->\n?", "", page, flags=re.S)
    page = page.replace("<!--c:head-->",
                        f"  <title>{esc(name)}</title>\n"
                        f'  <meta name="description" content="{esc(name)}">')
    page = page.replace("<!--c:nav-->", '      <a href="photos.html">Photos</a>' if has_photos else "")
    page = page.replace("<!--c:what-->", '        <h3>What we do</h3>')
    page = page.replace("<!--c:footer-->", f'    <p class="copyright">&copy; {year} {esc(name)}</p>')
    page = page.replace('<link rel="stylesheet" href="css/preview.css">', "")
    # preview.css does not travel, so nothing may depend on its classes; and the page is theirs now.
    page = page.replace('class="preview-h3"', 'class="site-h3"').replace(">Their listing on Google<", ">See us on Google<")
    return re.sub(r"\n{3,}", "\n\n", page)


def preview_claim(args):
    """A claimed preview becomes the client's site: `client new` + `site new` from the same
    template, then the preview's own filled page as index.html, committed and published."""
    m = preview_find(args.claim)
    if not m:
        die(f"no preview for {args.claim!r} (`leads preview ls`)")
    slug = args.slug or slugify(clean_name(m["name"]))
    ws = PROJECTS / "clients" / slug
    repo = f"{slug}-site"
    page = (preview_site_dir() / m["slug"] / "index.html")
    if not page.exists():
        die(f"{page} is gone — rebuild it first: leads preview \"{m['name']}\"")
    print(f"claim {m['name']} -> clients/{slug}, site {repo} from the {m['template']} template")
    steps = [[str(CLIENT_BIN), "new", slug, "--name", m["name"]],
             [str(SITE_BIN), "new", repo, "--template", m["template"], "--primary",
              "--tagline", preview_copy(m["category"])["tagline"].format(
                  name=m["name"], city=m["city"] or "the valley", category=m["category"],
                  trade=preview_copy(m["category"])["trade"])]]
    if args.dry_run:
        for s in steps:
            print("  would run: " + " ".join(s[0].rsplit("/", 1)[-1:] + s[1:]))
        print(f"  would copy {page} -> clients/{slug}/repos/{repo}/index.html (preview blocks cut: "
              + ", ".join(CLAIM_STRIP) + ")")
        print(f"  would copy the hero and css, commit, push, `site publish {repo}`")
        print(f"  would mark {m['slug']} claimed and take the preview down")
        return
    r = subprocess.run(steps[0], capture_output=True, text=True)
    if r.returncode != 0 and not ws.exists():
        die(f"client new {slug} failed: {(r.stderr or r.stdout).strip()[:300]}")
    print((r.stdout or "").strip()[-400:])
    r = subprocess.run(steps[1], capture_output=True, text=True, cwd=str(ws),
                       env=dict(os.environ, SITE_ADMIN="1"))
    print((r.stdout + r.stderr).strip()[-800:])
    dest = ws / "repos" / repo
    if r.returncode != 0 or not dest.exists():
        die(f"site new {repo} failed; the workspace is made — finish it by hand from {dest}", 2)
    has_photos = (dest / "photos.html").exists()
    (dest / "index.html").write_text(claim_html(page.read_text(), m["name"], now_date().year, has_photos))
    src_img = preview_site_dir() / m["slug"] / "images"
    if src_img.is_dir():
        (dest / "images").mkdir(exist_ok=True)
        for p in src_img.iterdir():
            if p.is_file():
                shutil.copy2(p, dest / "images" / p.name)
    for git_args in (["add", "-A"],
                     ["-c", "user.name=Patch (claude-tools leads)", "-c", "user.email=noreply@anthropic.com",
                      "commit", "-q", "-m", f"The page {m['name']} claimed, from their Patchlamp preview"],
                     ["push", "-q"]):
        g = subprocess.run(["git", "-C", str(dest), *git_args], capture_output=True, text=True)
        if g.returncode != 0:
            print(f"leads: git {git_args[0]} in {dest}: {(g.stderr or g.stdout).strip()[:160]}", file=sys.stderr)
    r = subprocess.run([str(SITE_BIN), "publish", repo], capture_output=True, text=True, cwd=str(ws))
    print((r.stdout + r.stderr).strip()[-600:])
    m["claimed"], m["claimed_on"] = slug, now_date().isoformat()     # the week counts claims by date (B52)
    preview_save(m)
    print(f"claimed: clients/{slug} · repos/{repo} · the preview is marked claimed "
          f"(`leads preview --remove {m['slug']}` takes it off the previews host)")


# ---- the pipeline (B7) ----------------------------------------------------------------

PIPELINE = Path(os.environ.get("LEADS_PIPELINE", PROJECTS / "private-docs/leads/pipeline.jsonl"))

# outcome -> (stage, default days to the follow-up, what it means)
OUTCOMES = {
    "messaged":   ("contacted", 4, "a DM or email went out, no answer yet"),
    "visited":    ("contacted", 3, "walked in, the decision-maker wasn't there"),
    "talked":     ("contacted", 7, "talked to the owner or manager, no decision"),
    "inbound":    ("interested", 1, "they came to us — the site form, the demo line, a reply"),
    "interested": ("interested", 2, "wants to hear more"),
    "demo":       ("negotiating", 2, "saw the demo / talked price"),
    "later":      ("contacted", 30, "not now; ask again in a month"),
    "trial":      ("trialing", 5, "the free week started"),
    "won":        ("won", None, "said yes"),
    "lost":       ("lost", None, "said no, or not a fit"),
    "churned":    ("churned", None, "was paying, cancelled"),
}
STAGES = ["contacted", "interested", "negotiating", "trialing", "won", "lost", "churned"]
WEEKDAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]

# The channel a touch came through, so the week can be cut by it (B52, GROWTH § 2.4). `--via` is
# the older, freer word; this is the short list the week counts.
SOURCES = ("email", "dm", "group", "saturday", "referral", "inbound", "mail")
VIA_SOURCE = {"email": "email", "dm": "dm", "instagram": "dm", "facebook": "dm", "message": "dm",
              "group": "group", "counter": "saturday", "visit": "saturday", "door": "saturday",
              "referral": "referral", "mail": "mail", "postcard": "mail",
              "inbound": "inbound", "form": "inbound", "text": "inbound", "web": "inbound"}
# A conversation is a real exchange: the outcomes that mean somebody talked back (or came to us).
CONVERSATION = ("visited", "talked", "inbound", "interested", "demo", "later", "trial", "won", "lost")
# § 5.5: day 0 the fault and the preview, then these, and back in the pool at 90.
CADENCE = (3, 10, 30)


def parse_when(text, today):
    """'tomorrow', 'fri', 'friday', '3d', '2w', '2026-10-01', 'oct 3', 'none' -> a date (or None)."""
    t = (text or "").strip().lower()
    if t in ("", "none", "never", "-"):
        return None
    if t in ("today",):
        return today
    if t in ("tomorrow", "tmrw", "tmw"):
        return today + dt.timedelta(days=1)
    m = re.fullmatch(r"(\d+)\s*(d|day|days|w|wk|week|weeks)", t)
    if m:
        n = int(m.group(1))
        return today + dt.timedelta(days=n * (7 if m.group(2).startswith("w") else 1))
    names = {"mon": "monday", "tue": "tuesday", "wed": "wednesday", "thu": "thursday", "fri": "friday", "sat": "saturday", "sun": "sunday"}
    t = re.sub(r"^next\s+", "", t)
    if t[:3] in names and names[t[:3]].startswith(t.rstrip(".")):
        ahead = (WEEKDAYS.index(t[:3]) - today.weekday()) % 7 or 7
        return today + dt.timedelta(days=ahead)
    try:
        return dt.date.fromisoformat(t)
    except ValueError:
        pass
    for fmt in ("%b %d", "%B %d", "%m/%d"):
        try:
            d = dt.datetime.strptime(t, fmt).date().replace(year=today.year)
            return d if d >= today else d.replace(year=today.year + 1)
        except ValueError:
            continue
    die(f"can't read the date \"{text}\" (tomorrow, fri, 3d, 2w, 2026-10-01, oct 3)")


def pipeline_events():
    if not PIPELINE.exists():
        return []
    out = []
    for line in PIPELINE.read_text().splitlines():
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return out


def pipeline_state():
    """key -> the lead as of its last event (stage, next, who, notes, the history)."""
    leads = {}
    for e in pipeline_events():
        k = e["key"]
        lead = leads.setdefault(k, {"key": k, "place_id": e.get("place_id"), "name": e["name"], "city": e.get("city"),
                                    "history": [], "who": None, "email": None, "phone": None, "reach": None})
        lead["history"].append(e)
        for f in ("name", "city", "stage", "outcome", "next", "reach", "source"):
            if f in e:
                lead[f] = e[f]
        for f in ("who", "email", "phone"):
            if e.get(f):
                lead[f] = e[f]
        lead["last"] = e["date"]
    return leads


def source_for(explicit, via, outcome, lead=None, row=None, reach_row=None):
    """The channel to record (B52): what was asked for, else what `--via` says, else the channel this lead
    was already on, else — for a first message — the reach the kit would have used. Unknown stays unknown:
    the week counts an `unknown` row rather than inventing one."""
    if explicit:
        s = explicit.strip().lower()
        if s not in SOURCES:
            die(f"--source is one of: {', '.join(SOURCES)}")
        return s
    if via and VIA_SOURCE.get(via.strip().lower()):
        return VIA_SOURCE[via.strip().lower()]
    if outcome == "inbound":
        return "inbound"            # they came to us, whatever channel we were on with them
    if lead and lead_source(lead):
        return lead_source(lead)
    if outcome == "messaged":
        rc = reach_row or ((business_reach(row) if is_business(row) else reach(row)) if row else {})
        if rc.get("email"):
            return "email"
        if rc.get("instagram") or rc.get("facebook") or rc.get("directory"):
            return "dm"
    return None


def lead_source(lead):
    """The channel a lead is on: the first one any of its events recorded."""
    for e in lead.get("history") or []:
        if e.get("source"):
            return e["source"]
    return None


def claimed_places():
    """Place ids whose preview was claimed (B45): a client, not a lead. Cheap and never raises —
    the previews' manifests are small JSON files and may not exist at all."""
    try:
        return {m["place_id"] for m in previews_all() if m.get("claimed") and m.get("place_id")}
    except OSError:
        return set()


def pipeline_skip():
    """place_ids the kits should leave alone: anyone won or lost, and anyone with a follow-up still ahead."""
    today = dt.datetime.now(TZ).date().isoformat()
    return {l["place_id"] for l in pipeline_state().values()
            if l.get("place_id") and (l.get("stage") in ("won", "lost", "trialing", "churned")
                                      or (l.get("next") or "") > today)}


def resolve_lead(raw, place=None):
    """(key, place_id, name, city, row) for a name typed on a phone. The census first; else a free-text lead."""
    if place:
        hits = [h for h in census_lookup(raw.split(",")[0].strip() or "x") if h[1]["place_id"] == place] or \
               [(9, r) for r in _census_by_id(place)]
        if not hits:
            die(f"no place {place} in the census")
        r = hits[0][1]
        return f"place:{r['place_id']}", r["place_id"], clean_name(r["name"]), r.get("locality") or r.get("city"), r, []
    # a lead already in the pipeline wins: "log fong interested" shouldn't re-match the census
    name, _, city = raw.partition(",")
    want = " ".join(norm(name))
    for l in pipeline_state().values():
        if " ".join(norm(l["name"])) == want and (not city.strip() or norm(city)[0:1] == norm(l.get("city") or "")[0:1]):
            return l["key"], l.get("place_id"), l["name"], l.get("city"), None, []
    hits = census_lookup(name.strip(), city.strip() or None)
    if hits:
        r = hits[0][1]
        others = [h[1] for h in hits[1:3] if h[0] >= hits[0][0] - 0.3]
        return f"place:{r['place_id']}", r["place_id"], clean_name(r["name"]), r.get("locality") or r.get("city"), r, others
    slug = "-".join(norm(name)) or "lead"
    return f"name:{slug}", None, name.strip(), city.strip() or None, None, []


def _census_by_id(place_id):
    """The census row for one place, from either census (the services columns come too, so a services
    lead gets `business_reach` and the business faults, not a restaurant's)."""
    if not place_id or not CENSUS.exists():
        return []
    has_b, _ = businesses_state()
    b_cols = ("CASE WHEN r.place_id IS NULL THEN b.segment END AS segment, b.category, b.presence_class, "
              "b.presence_url, COALESCE(r.city, b.city) AS city" if has_b else
              "NULL AS segment, NULL AS category, NULL AS presence_class, NULL AS presence_url, r.city")
    b_join = "LEFT JOIN businesses b ON b.place_id = p.place_id" if has_b else ""
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    rows = conn.execute(f"""SELECT p.*, r.on_doordash, r.on_uber, r.on_grubhub, r.channel_class, r.parasite_url,
                                   r.serp_top3, r.contact_name, r.contact_email, {b_cols}
                            FROM place_cache p LEFT JOIN restaurants r ON r.place_id = p.place_id {b_join}
                            WHERE p.place_id = ?""", (place_id,)).fetchall()
    conn.close()
    return [dict(r) for r in rows]


def cmd_log(args):
    today = dt.datetime.now(TZ).date()
    outcome = args.outcome.lower()
    if outcome not in OUTCOMES:
        die(f"outcome is one of: {', '.join(OUTCOMES)}")
    key, pid, name, city, row, others = resolve_lead(" ".join(args.name), args.place)
    stage, days, _ = OUTCOMES[outcome]
    nxt = parse_when(args.next, today) if args.next is not None else (today + dt.timedelta(days=days) if days else None)
    if nxt and nxt.weekday() == 6 and args.next is None:
        nxt += dt.timedelta(days=1)            # nobody follows up on a Sunday
    lead = pipeline_state().get(key)
    event = {"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "date": today.isoformat(), "key": key,
             "place_id": pid, "name": name, "city": city, "outcome": outcome, "stage": stage,
             "next": nxt.isoformat() if nxt else None, "note": " ".join(args.note).strip() or None,
             "who": args.who, "email": args.email, "phone": args.phone or (row or {}).get("phone"), "via": args.via}
    if args.next is not None and nxt:
        event["next_by"] = "hand"          # a date Taylor named; the cadence never writes over it
    rc = None
    if row:
        rc = business_reach(row) if is_business(row) else reach(row)
        event["reach"] = (business_reach_line(rc) if is_business(row) else reach_line(rc)) or None
        event["email"] = event.get("email") or rc.get("email")
        if outcome == "messaged":
            event["was"] = "; ".join(lead_faults(row, None, today)[0][:2]) or None
    event["source"] = source_for(getattr(args, "source", None), args.via, outcome, lead, row, rc)
    PIPELINE.parent.mkdir(parents=True, exist_ok=True)
    with open(PIPELINE, "a") as f:
        f.write(json.dumps({k: v for k, v in event.items() if v is not None or k == "next"}) + "\n")
    when = f"follow up {nxt.strftime('%a %-d %b')}" if nxt else "no follow-up"
    print(f"Logged: {name}{' (' + city + ')' if city else ''} — {outcome} → {stage}; {when}."
          + ("" if row or pid else " (not in the census; logged by name)"))
    if others:
        print("  (matched the census's " + name + (f" in {city}" if city else "")
              + "; also close: " + "; ".join(f"{clean_name(o['name'])} ({o.get('locality') or '?'}) --place {o['place_id']}" for o in others) + ")")
    print()
    print_list(today + dt.timedelta(days=1), args.n)


def cmd_sent(args):
    """`leads sent 1 3 4` (or `all`): those picks from the last remote kit were messaged."""
    p = STATE / "remote.jsonl"
    last = None
    if p.exists():
        for line in p.read_text().splitlines():
            try:
                last = json.loads(line)
            except json.JSONDecodeError:
                pass
    if not last:
        die("no remote kit yet; run `leads kit --remote`")
    ids, names = last["place_ids"], last["names"]
    picks = range(1, len(ids) + 1) if args.which == ["all"] else []
    if not picks:
        try:
            picks = [int(x) for x in args.which]
        except ValueError:
            die("say which: leads sent 1 3 4, or leads sent all")
    today = dt.datetime.now(TZ).date()
    done = []
    for i in picks:
        if not 1 <= i <= len(ids):
            die(f"the last remote kit ({last['for']}) has {len(ids)} leads, not {i}")
        row = (_census_by_id(ids[i - 1]) or [{}])[0]
        nxt = today + dt.timedelta(days=OUTCOMES["messaged"][1])
        biz = is_business(row)
        rc = (business_reach(row) if biz else reach(row)) if row else {}
        event = {"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "date": today.isoformat(),
                 "key": f"place:{ids[i - 1]}", "place_id": ids[i - 1], "name": clean_name(names[i - 1]),
                 "city": row.get("locality") or row.get("city"), "outcome": "messaged", "stage": "contacted",
                 "next": nxt.isoformat(), "via": args.via, "phone": row.get("phone"),
                 "reach": ((business_reach_line(rc) if biz else reach_line(rc)) or None) if row else None,
                 "email": rc.get("email"), "source": source_for(args.source, args.via, "messaged", None, row, rc),
                 "was": ("; ".join(lead_faults(row, None, today)[0][:2]) or None) if row else None,
                 "note": f"remote kit {last['for']} #{i}"}
        PIPELINE.parent.mkdir(parents=True, exist_ok=True)
        with open(PIPELINE, "a") as f:
            f.write(json.dumps({k: v for k, v in event.items() if v is not None}) + "\n")
        done.append(event["name"])
    print(f"Logged {len(done)} sent: {', '.join(done)}; follow up {nxt.strftime('%a %-d %b')} if they don't answer.")


def due_by(day):
    """Leads whose follow-up is on or before `day`, oldest first (won and lost never come back)."""
    rows = [l for l in pipeline_state().values()
            if l.get("next") and l["next"] <= day.isoformat() and l.get("stage") not in ("won", "lost")]
    return sorted(rows, key=lambda l: (l["next"], l["name"]))


def lead_line(l, day):
    late = (day - dt.date.fromisoformat(l["next"])).days
    tag = f" · {late}d late" if late > 0 else ""
    last = l["history"][-1]
    what = (f"day {last.get('touch')} touch by {last.get('channel')}" if last.get("kind") == "touch_due"
            else f"{last['outcome']} {last['date'][5:]}")
    note = f" — \"{last['note']}\"" if last.get("note") else ""
    parts = [l.get("who"), l.get("phone"), l.get("reach")]
    if l.get("email") and l["email"] not in (l.get("reach") or ""):
        parts.append(l["email"])                      # the reach line already carries it when B61 found one
    contact = " · ".join(x for x in parts if x)
    return (f"{l['name']}{' (' + l['city'] + ')' if l.get('city') else ''} · {l['stage']}, {what}"
            f"{tag}{note}" + (f"\n     {contact}" if contact else ""))


def print_list(day, n=6, segment=None):
    """The day's list: follow-ups due, then fresh leads from the census (the default segment's) to make up n."""
    due = due_by(day)
    label = ("Tomorrow, " if day == dt.datetime.now(TZ).date() + dt.timedelta(days=1) else "") + day.strftime("%a %-d %b")
    print(f"{label}: {len(due)} follow-up{'s' if len(due) != 1 else ''}"
          + (", then new ones" if len(due) < n else ""))
    for i, l in enumerate(due, 1):
        print(f"  {i}. {lead_line(l, day)}")
    if len(due) < n:
        taken = pipeline_skip() | {l["place_id"] for l in pipeline_state().values() if l.get("place_id")} | set(contacted())
        chains = chain_names()
        seg = segment or default_segment()
        pool = candidates_for(seg)
        fresh = [c for c in pool if c["place_id"] not in taken and (c["name"] or "").lower() not in chains]
        for c in fresh:
            c["reach"] = business_reach(c) if is_business(c) else reach(c)
            c["faults"], _ = lead_faults(c, None, day)
        fresh = [c for c in fresh if c["faults"]]
        fresh.sort(key=lambda c: (not (c["reach"]["instagram"] or c["reach"]["facebook"]), c["miles"]))
        for i, c in enumerate(fresh[: n - len(due)], len(due) + 1):
            how = (business_reach_line(c["reach"]) if is_business(c) else reach_line(c["reach"])) or c.get("phone") or ""
            what = f"{c.get('category')}, " if is_business(c) and c.get("category") else ""
            print(f"  {i}. NEW {clean_name(c['name'])} ({what}{c.get('locality') or ''}, {c['miles']} mi) · {c['faults'][0]}"
                  + (f"\n     {how}" if how else ""))
    if day.weekday() == 5:
        print("  (Saturday: the counter kit is `leads kit --last`)")


def cmd_next(args):
    today = dt.datetime.now(TZ).date()
    day = parse_when(args.when, today) if args.when else today + dt.timedelta(days=1)
    print_list(day, args.n, resolve_segment(args.segment) if args.segment else None)


def cmd_due(args):
    today = dt.datetime.now(TZ).date()
    due = due_by(today)
    if not due:
        print("No follow-ups due today.")
        return
    print(f"{len(due)} follow-up{'s' if len(due) != 1 else ''} due:")
    for i, l in enumerate(due, 1):
        print(f"  {i}. {lead_line(l, today)}")


def cmd_show(args):
    key, pid, name, city, row, _ = resolve_lead(" ".join(args.name), args.place)
    lead = pipeline_state().get(key)
    if not lead:
        print(f"{name}{' (' + city + ')' if city else ''}: not in the pipeline yet.")
        if row:
            fs, summary = lead_faults(row, None, dt.datetime.now(TZ).date())
            print(f"  census: {summary.replace(' · (census only)', '')}" + (f" · wrong: {'; '.join(fs[:2])}" if fs else ""))
        return
    print(f"{lead['name']}{' (' + lead['city'] + ')' if lead.get('city') else ''} — {lead['stage']}"
          + (f", follow up {lead['next']}" if lead.get("next") and lead["stage"] not in ("won", "lost") else ""))
    for x in ("who", "phone", "email", "reach"):
        if lead.get(x):
            print(f"  {x}: {lead[x]}")
    for e in lead["history"]:
        print(f"  {e['date']}  {e['outcome']:<10} {e.get('note') or ''}")


def week_bounds(today):
    start = today - dt.timedelta(days=today.weekday())
    return start, start + dt.timedelta(days=6)


# GROWTH § 2.4, week 1 of the ramp: what the machine should be producing in its first week.
WEEK1_TARGET = {"messages sent": "15", "previews built": "6", "replies": "3", "conversations": "5",
                "fixes / claims": "1", "trials": "1", "paid": "0–1"}
CHANNEL_COLS = ("sent", "replies", "conversations", "fixes", "trials", "paid", "churned")


def week_events(start, end):
    return [e for e in pipeline_events() if start.isoformat() <= e["date"] <= end.isoformat()]


def event_source(e, state):
    """The channel to file an event under: its own, else the one the lead came in on."""
    return e.get("source") or lead_source(state.get(e["key"]) or {}) or "unknown"


def followups(start, end, state):
    """(due in the week, answered since) — the § 2.4 row nobody else counts."""
    due = done = 0
    for lead in state.values():
        for i, e in enumerate(lead["history"]):
            when = e.get("next")
            if not when or not (start.isoformat() <= when <= end.isoformat()):
                continue
            due += 1
            if any(x["date"] >= when for x in lead["history"][i + 1:]):
                done += 1
    return due, done


def week_numbers(start, end):
    """Everything the Sunday review reports (B52): the funnel per channel, the § 2.4 indicators."""
    state = pipeline_state()
    evs = week_events(start, end)
    messaged = {e["key"] for e in pipeline_events() if e.get("outcome") == "messaged"}
    by = {}
    for e in evs:
        src = event_source(e, state)
        row = by.setdefault(src, dict.fromkeys(CHANNEL_COLS, 0))
        o = e.get("outcome")
        if o == "messaged":
            row["sent"] += 1
        if o in CONVERSATION:
            row["conversations"] += 1
            if e["key"] in messaged:
                row["replies"] += 1            # an answer to something we sent
        if o == "trial":
            row["trials"] += 1
        if o == "won":
            row["paid"] += 1
        if o == "churned":
            row["churned"] += 1
    previews = [m for m in previews_all() if start.isoformat() <= (m.get("built") or "") <= end.isoformat()]
    linked = [m for m in previews if f"place:{m.get('place_id')}" in messaged]
    for m in previews_all():
        when = m.get("claimed_on") or ""
        if m.get("claimed") and start.isoformat() <= when <= end.isoformat():
            lead = state.get(f"place:{m.get('place_id')}") or {}
            by.setdefault(lead_source(lead) or "unknown", dict.fromkeys(CHANNEL_COLS, 0))["fixes"] += 1
    total = {c: sum(r[c] for r in by.values()) for c in CHANNEL_COLS}
    due, done = followups(start, end, state)
    return {"week_of": start.isoformat(), "by_channel": by, "total": total,
            "indicators": {"messages sent": total["sent"], "previews built": len(previews),
                           "previews linked": len(linked), "replies": total["replies"],
                           "conversations": total["conversations"], "fixes / claims": total["fixes"],
                           "trials": total["trials"], "paid": total["paid"],
                           "follow-ups due": due, "follow-ups done": done},
            "pipeline": {s: sum(1 for l in state.values() if l.get("stage") == s) for s in STAGES},
            "won_total": sum(1 for l in state.values() if l.get("stage") == "won"),
            "due_now": len(due_by(now_date()))}


def week_by_channel(w, start):
    """The Sunday message: under 25 lines, one row a channel, then the § 2.4 indicators."""
    lines = [f"Week of {start.strftime('%-d %b')} — by channel · " + " · ".join(CHANNEL_COLS)]
    order = sorted((s for s, r in w["by_channel"].items() if any(r.values())),
                   key=lambda s: (-w["by_channel"][s]["sent"], s))
    for src in order:
        r = w["by_channel"][src]
        lines.append(f"  {src:<9} " + " · ".join(str(r[c]) for c in CHANNEL_COLS))
    lines.append(f"  {'total':<9} " + " · ".join(str(w['total'][c]) for c in CHANNEL_COLS))
    if not order:
        lines.append("  (nothing logged this week — `leads log` after every conversation)")
    lines.append("Indicators (GROWTH § 2.4, week 1 in brackets):")
    ind = w["indicators"]
    shown = [f"{k} {v}" + (f" [{WEEK1_TARGET[k]}]" if k in WEEK1_TARGET else "")
             for k, v in ind.items() if not k.startswith("follow-ups")]
    shown.append(f"follow-ups due {ind['follow-ups due']}, done {ind['follow-ups done']}")
    for i in range(0, len(shown), 3):
        lines.append("  " + " · ".join(shown[i:i + 3]))
    lines.append("Pipeline now: " + " · ".join(f"{w['pipeline'][s]} {s}" for s in STAGES if w["pipeline"][s])
                 + f" · {w['due_now']} follow-ups due")
    lines.append(f"Target: 3 paying by 31 Oct, 10 by 31 Dec — {w['won_total']} won so far.")
    lines.append("One change for the week: pick the row above that is furthest from its § 2.4 number.")
    return "\n".join(lines) + "\n"


def cmd_week(args):
    today = now_date()
    start, end = week_bounds(today - dt.timedelta(weeks=args.ago))
    if args.by == "channel" or args.json:
        w = week_numbers(start, end)
        msg = week_by_channel(w, start)
        if args.json:
            print(json.dumps(dict(w, message=msg), indent=1, default=str))
            return
        print(msg, end="")
        return
    evs = week_events(start, end)
    counts = {o: sum(1 for e in evs if e["outcome"] == o) for o in OUTCOMES}
    convo = sum(counts[o] for o in ("visited", "talked", "interested", "demo", "later", "won", "lost"))
    state = pipeline_state()
    live = {s: sum(1 for l in state.values() if l.get("stage") == s) for s in STAGES}
    kits = sum(1 for k in kits_log() if start.isoformat() <= k.get("for", "") <= end.isoformat())
    remote = 0
    if (STATE / "remote.jsonl").exists():
        for line in (STATE / "remote.jsonl").read_text().splitlines():
            try:
                if start.isoformat() <= json.loads(line).get("for", "") <= end.isoformat():
                    remote += 1
            except json.JSONDecodeError:
                pass
    print(f"Week of {start.strftime('%-d %b')}: {convo} conversation{'s' if convo != 1 else ''}, {counts['messaged']} message{'s' if counts['messaged'] != 1 else ''} sent"
          f" · {counts['interested']} interested · {counts['demo']} demos · {counts['won']} won · {counts['lost']} lost")
    print(f"Pipeline now: " + " · ".join(f"{live[s]} {s}" for s in STAGES)
          + f" · {len(due_by(today))} follow-ups due")
    print(f"Kits: {kits} Saturday, {remote} remote this week.")
    won = sum(1 for l in state.values() if l.get("stage") == "won")
    print(f"Target: 3 paying by 31 Oct, 10 by 31 Dec — {won} won so far.")


# ---- the cadence, the 07:30 message and the brief (B48; the week by channel is B52) ------

OUTREACH_STATE = Path(os.environ.get("OUTREACH_STATE", Path.home() / ".local/state/claude-tools/outreach"))
EMAIL_RE = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}")

# GROWTH § 5.5. Day 0 is the fault and the preview; 90 is back in the pool, which the kit's
# own suppression already does. A day-3 touch is a DM or a second email, never a text to a cell.
TOUCH_WHAT = {
    3: "the other channel, one line: the preview's up, text Patch anything on it",
    10: "the preview comes down soon — want it kept? it's free to claim",
    30: "a fresh read of the listing: one new thing wrong, or the offer stands",
}
TOUCH_SHORT = {3: "the other channel", 10: "the preview expiry", 30: "a fresh read of the listing"}

# GROWTH § 6.2, verbatim: the six objections and the answer to each. The brief carries the one
# that fits the segment, then the one that usually follows it.
OBJECTIONS = {
    "nephew": ('"My nephew does my website."',
               "Keep him. This is for the 4pm \"we're closed Monday\" that he's not answering. $99 and it's "
               "done in a minute; he can still do the big stuff."),
    "referrals": ('"All my work is referrals, I don\'t need a website."',
                  "Your referrals still Google you before they call. Right now they hit a dead link / a Facebook "
                  "page / nothing. That's the thing to fix; the rest is optional."),
    "directory": ('"I\'m on Thumbtack / Angi."',
                  "Then you're paying for every lead and sharing it with four others. A site of your own is where "
                  "the ones who already chose you land. Keep Thumbtack; stop being only on Thumbtack."),
    "ai": ('"AI will break something / say something wrong."',
           "It changes only your site, inside a folder that holds only your things, and every change is saved so "
           "\"undo that\" works. It never posts for you or answers a customer unless you tell it to, and it says "
           "it's AI if anyone asks."),
    "price": ('"$99 is a lot."',
              "It's a website, hosting, the changes and someone to call, on one bill. The $50 plan is the same "
              "thing for a menu or a price list that changes now and then; the $10 plan just keeps a site up. "
              "Start where you're comfortable; moving up is a text."),
    "think": ('"Let me think about it."',
              "Sure. What day should I text you? — a date, logged; the day-10 preview expiry does the rest."),
}
# The one each segment hears first (GROWTH § 3.1–3.5: services sell against referrals, the rest against price),
# and the one that follows it. A directory profile as the website overrides both.
SEGMENT_OBJECTION = {"services": ("referrals", "price"), "creatives": ("price", "referrals"),
                     "retail": ("price", "referrals"), "nonprofit": ("price", "think"),
                     "restaurant": ("nephew", "price")}


def env_value(name):
    """A toolbelt setting by name (never a printed value; these are links and flags, not keys)."""
    return (os.environ.get(name) or _env_file(ENV_FILE).get(name) or "").strip() or None


def previews_on():
    return (env_value("LEADS_KIT_PREVIEWS") or "").lower() in ("1", "true", "yes", "on")


def lead_email(lead):
    if lead.get("email"):
        return lead["email"]
    m = EMAIL_RE.search(lead.get("reach") or "")
    return m.group(0) if m else None


def lead_handle(lead):
    """The page to message this lead on, from the reach line the kit recorded."""
    r = lead.get("reach") or ""
    m = re.search(r"Instagram @([A-Za-z0-9_.]+)", r)
    if m:
        return f"instagram.com/{m.group(1)}"
    m = re.search(r"(facebook\.com/[^\s·]+)", r)
    if m:
        return m.group(1)
    m = re.search(r"([A-Za-z][A-Za-z ]*) profile", r)
    return f"their {m.group(1)} profile" if m else None


def first_message(lead):
    for e in lead.get("history") or []:
        if e.get("outcome") == "messaged":
            return e
    return None


def answered_since(lead):
    """True once somebody talked back: the cadence chases silence only."""
    m = first_message(lead)
    if not m:
        return True
    return any(e.get("outcome") in CONVERSATION and e["date"] >= m["date"] for e in lead["history"])


def touches_done(lead):
    return {int(e["touch"]) for e in lead.get("history") or [] if e.get("kind") == "touch_due" and e.get("touch")}


def touch_channel(lead, touch):
    """§ 5.5: day 3 is the *other* channel; 10 and 30 are Patch's, so email where there is an address.
    Never SMS — a cold text is the one touch the law forbids (§ 8.1). `call` means Taylor's thumb."""
    has_mail, has_dm = bool(lead_email(lead)), bool(lead_handle(lead))
    want = ("dm" if lead_source(lead) == "email" else "email") if touch == 3 else "email"
    if want == "email" and has_mail:
        return "email"
    if want == "dm" and has_dm:
        return "dm"
    if has_dm:
        return "dm"
    return "email" if has_mail else "call"


def cadence_rows(today, state=None):
    """[(lead, touch, channel, due)] — each silent lead's next touch, due today or already late."""
    out = []
    for lead in (state or pipeline_state()).values():
        if lead.get("stage") in ("won", "lost", "trialing", "churned") or answered_since(lead):
            continue
        last = lead["history"][-1]
        if last.get("next_by") == "hand" and lead.get("next"):
            continue                                  # a date Taylor named wins over the cadence
        done, d0 = touches_done(lead), dt.date.fromisoformat(first_message(lead)["date"])
        floor = max(done) if done else 0
        ready = [t for t in CADENCE if t > floor and d0 + dt.timedelta(days=t) <= today]
        if ready:
            # the latest touch that has come due, never a catch-up queue: a day-3 line missed while
            # the timer was off is not worth sending on day 12 — the day-10 one is.
            touch = ready[-1]
            out.append((lead, touch, touch_channel(lead, touch), d0 + dt.timedelta(days=touch)))
    out.sort(key=lambda r: (r[3].isoformat(), r[0]["name"]))
    return out


def record_touch(lead, touch, channel, due, today):
    """The touch as a pipeline event, so `leads due` and the 07:30 message see it like any follow-up."""
    event = {"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "date": today.isoformat(),
             "key": lead["key"], "place_id": lead.get("place_id"), "name": lead["name"], "city": lead.get("city"),
             "outcome": "touch_due", "kind": "touch_due", "stage": lead.get("stage") or "contacted",
             "touch": touch, "channel": channel, "next": due.isoformat(), "source": lead_source(lead),
             "note": TOUCH_WHAT[touch]}
    PIPELINE.parent.mkdir(parents=True, exist_ok=True)
    with open(PIPELINE, "a") as f:
        f.write(json.dumps({k: v for k, v in event.items() if v is not None}) + "\n")
    return event


def touch_do(lead, touch, channel):
    """The one thing to do about this touch — a line Taylor can act on, or the command that drafts it."""
    if channel == "email":
        if touch in (3, 10):     # the approved letters; day 30 is one line off the fresh read, not a template
            return f"outreach send --touch {touch} --dry-run  (drafts it to {lead_email(lead)})"
        return f"one line to {lead_email(lead)} off the read below"
    if channel == "dm":
        return f"DM {lead_handle(lead)}"
    return f"call {lead.get('phone') or 'them'} — no page and no address (B61 hasn't found one)"


def cmd_cadence(args):
    today = now_date()
    rows = cadence_rows(today)
    if not rows:
        print("No touches due: every messaged lead has either answered or isn't at day 3 yet.")
        return
    lines = []
    for lead, touch, channel, due in rows:
        if not args.dry_run:
            record_touch(lead, touch, channel, due, today)
        late = (today - due).days
        lines.append(f"  {lead['name']} — day {touch}{f' ({late}d late)' if late else ''} by {channel}: "
                     f"{touch_do(lead, touch, channel)}")
    print(f"{len(rows)} touch{'es' if len(rows) != 1 else ''} due{' (dry run: nothing written)' if args.dry_run else ''}:")
    print("\n".join(lines))
    dm = [r for r in rows if r[2] != "email"]
    if dm:
        print(f"{len(dm)} for your thumb; the email ones are the schedule's `outreach send --touch N`.")


def due_touch(lead, today):
    """(what this lead is owed, the thing to do) for a row in `leads due` — a cadence touch, a date
    Taylor named, or the outcome's own default follow-up."""
    last = lead["history"][-1]
    if last.get("kind") == "touch_due":
        touch, channel = int(last.get("touch") or 0), last.get("channel") or "dm"
        return f"day {touch}, {TOUCH_SHORT.get(touch, 'a follow-up')}", touch_do(lead, touch, channel)
    if last.get("next_by") == "hand":
        when = dt.date.fromisoformat(lead["next"])
        return f"you said {when.strftime('%a')}", f"call {lead.get('phone') or lead_handle(lead) or 'them'}"
    _, days, meaning = OUTCOMES.get(last.get("outcome") or "", ("", None, "a follow-up"))
    return meaning, f"call {lead.get('phone') or lead_handle(lead) or 'them'}"


def thirty_day_read(lead, args, today):
    """§ 5.5's day 30: one fresh Place Details call (cached seven days), for a row due today only."""
    pid = lead.get("place_id")
    if not pid:
        return None
    key, where = (None, None) if args.census_only else places_key()
    if not (key or args.fixture):
        return "no Places key here — read the listing by hand"
    places = Places(key, where, fixture=args.fixture)
    details = places.get(pid)
    if places.calls:
        ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
                       "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
                       "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global",
                       "for": f"day-30 read {lead['name']} {today}"})
    if not details:
        return places.failed or "the listing wouldn't read"
    row = (_census_by_id(pid) or [{}])[0] or {"name": lead["name"]}
    fs, _ = lead_faults(row, details, today)
    was = (first_message(lead) or {}).get("was") or ""
    if not fs:
        return "the listing is clean now — lead with what a site would add"
    new = [f for f in fs if f not in was]
    return (f"new since the message: {new[0]}" if new else f"still {fs[0]} — the offer stands")


def yesterdays_replies(day):
    """(the lane is configured, [rows]) — read from `outreach`'s inbox log, never written here."""
    if not OUTREACH_STATE.exists():
        return False, []
    p = OUTREACH_STATE / "replies.jsonl"
    rows = []
    for line in (p.read_text().splitlines() if p.exists() else []):
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if r.get("date") == day.isoformat():
            rows.append(r)
    return True, rows


def inbound_rows(today, state=None):
    """What came to us since yesterday (the relay's inbound lane logs `leads log NAME inbound …`):
    the site form, the demo line, a reply on a channel we weren't watching."""
    since = (today - dt.timedelta(days=1)).isoformat()
    out = []
    for lead in (state or pipeline_state()).values():
        for e in lead["history"]:
            if e.get("outcome") == "inbound" and since <= e["date"] <= today.isoformat():
                out.append({"name": lead["name"], "date": e["date"], "note": e.get("note"),
                            "phone": lead.get("phone") or e.get("phone"), "key": lead["key"]})
    return sorted(out, key=lambda r: (r["date"], r["name"]), reverse=True)


def warmest(today, state=None):
    """The first call of the day (§ 5.1): the warmest thing in the pipeline, and why in one line."""
    best = None
    for lead in (state or pipeline_state()).values():
        if lead.get("stage") in ("won", "lost", "churned"):
            continue
        last = lead["history"][-1]
        rank = {"inbound": 5, "interested": 4, "demo": 4, "trial": 3,
                "talked": 2, "visited": 2}.get(last.get("outcome") or "")
        if not rank:
            continue
        if lead.get("next") and lead["next"] <= today.isoformat():
            rank += 1                                  # their own date has come
        if best is None or (rank, last["date"]) > (best[1], best[2]["date"]):
            best = (lead, rank, last)
    if not best:
        return None
    lead, _, last = best
    why = (f"{last['outcome']} {dt.date.fromisoformat(last['date']).strftime('%-d %b')}"
           + (f": \"{last['note']}\"" if last.get("note") else ""))
    return {"name": lead["name"], "phone": lead.get("phone"), "why": why, "key": lead["key"]}


def todays_kit(args, today):
    """Today's six: the remote run already saved today, else one run now (about $0.15 of Places;
    previews too when LEADS_KIT_PREVIEWS is set)."""
    folder = STATE / "remote"
    saved = sorted(folder.glob(f"{today.isoformat()}*.json"), key=lambda p: p.stat().st_mtime) if folder.exists() else []
    if saved and not args.fresh:
        try:
            return json.loads(saved[-1].read_text()), False
        except ValueError:
            pass
    segment = resolve_segment(args.segment)
    ns = argparse.Namespace(census_only=args.census_only, fixture=args.fixture, refresh=False, radius=30.0,
                            min_reviews=25 if segment == "restaurant" else None, allow_repeat=False,
                            n=args.n, previews=previews_on(), no_save=args.no_save)
    try:
        _, picks = (build_remote if segment == "restaurant" else lambda a: build_segment_remote(a, segment))(ns)
    except SystemExit:
        return {"date": today.isoformat(), "segment": segment, "picks": []}, True
    return kit_json(picks, segment, today), True


def today_data(args, today):
    """Everything the 07:30 message says, as data (`--json` prints this and the message itself)."""
    kit, fresh = todays_kit(args, today)
    lane, reps = yesterdays_replies(today - dt.timedelta(days=1))
    state = pipeline_state()
    due = []
    for lead in due_by(today):
        what, do = due_touch(lead, today)
        row = {"name": lead["name"], "city": lead.get("city"), "what": what, "do": do,
               "late": (today - dt.date.fromisoformat(lead["next"])).days, "key": lead["key"]}
        last = lead["history"][-1]
        if last.get("kind") == "touch_due" and int(last.get("touch") or 0) == 30:
            row["listing"] = thirty_day_read(lead, args, today)
        due.append(row)
    words = []
    if (env_value("OUTREACH_AUTO") or "") != "1":
        n = sum(1 for p in kit["picks"] if p.get("email"))
        words = [f"go — send the {n} email{'s' if n != 1 else ''} in today's six" if n else
                 "go — nothing to send by email today (no addresses; B61 is finding them)",
                 "go 1 3 — only those", "hold 4 — hold one back"]
    return {"date": today.isoformat(), "segment": kit.get("segment"), "fresh_kit": fresh,
            "six": kit["picks"], "lane": lane, "replies": reps, "inbound": inbound_rows(today, state),
            "due": due, "first_call": warmest(today, state), "words": words}


def today_message(d, n_due=6):
    """The message itself: under 40 lines, one line a pick, and nothing that isn't in `d`."""
    day = dt.date.fromisoformat(d["date"])
    six, due = d["six"], d["due"]
    head = (f"Morning — {day.strftime('%a %-d %b')} · {SEGMENT_TITLE.get(d['segment'], 'leads').lower()} · "
            f"{len(six)} to send, {len(d['replies'])} repl{'y' if len(d['replies']) == 1 else 'ies'} yesterday, "
            f"{len(due)} follow-up{'s' if len(due) != 1 else ''} due")
    lines = [head, ""]
    for i, p in enumerate(six, 1):
        reach_bit = ("@" + p["instagram"] if p.get("instagram") else
                     p.get("facebook") or p.get("email") or p.get("phone") or "no way in yet")
        bits = [f"{i}. {p['name']}", p.get("category") or p.get("segment") or "", p.get("city") or "",
                (p.get("faults") or ["nothing obvious"])[0], reach_bit]
        if p.get("preview_url"):
            bits.append(p["preview_url"])
        lines.append(" · ".join(b for b in bits if b))
    if not six:
        lines.append("No kit today — the pool is empty or every lead is already in the pipeline (`leads candidates`).")
    lines.append("")
    if not d["lane"]:
        lines.append("Yesterday: the email lane isn't running yet (`outreach doctor`), so replies are whatever came to your phone.")
    elif not d["replies"]:
        lines.append("Yesterday: no replies.")
    else:
        by = {}
        for r in d["replies"]:
            by.setdefault(r.get("class") or "other", []).append(r.get("name") or r.get("from") or "?")
        lines.append("Yesterday: " + " · ".join(f"{k} — {', '.join(v[:3])}" for k, v in sorted(by.items())))
    if d.get("inbound"):
        lines.append(f"What came to us ({len(d['inbound'])}) — answer these first:")
        for r in d["inbound"][:4]:
            lines.append(f"  {r['name']}{' · ' + r['phone'] if r.get('phone') else ''} — {r.get('note') or 'no note'}")
        if len(d["inbound"]) > 4:
            lines.append(f"  +{len(d['inbound']) - 4} more — `leads pipeline`")
    lines.append("")
    if due:
        lines.append(f"Due today ({len(due)}):")
        for r in due[:n_due]:
            late = f" · {r['late']}d late" if r["late"] > 0 else ""
            lines.append(f"  {r['name']} — {r['what']}{late}: {r['do']}")
            if r.get("listing"):
                lines.append(f"     the listing now: {r['listing']}")
        if len(due) > n_due:
            lines.append(f"  +{len(due) - n_due} more — `leads due`")
    else:
        lines.append("Due today: nothing.")
    lines.append("")
    fc = d["first_call"]
    if fc:
        lines.append(f"First call: {fc['name']}{' · ' + fc['phone'] if fc.get('phone') else ''} — {fc['why']}")
        lines.append(f"  the brief: leads brief \"{fc['name']}\"")
    elif six:
        lines.append(f"First call: nobody warm yet — the six above are the day's work.")
    if d["words"]:
        lines += ["", "Needs a word: " + " · ".join(d["words"])]
    return "\n".join(lines) + "\n"


def cmd_today(args):
    today = now_date()
    d = today_data(args, today)
    msg = today_message(d)
    if args.json:
        print(json.dumps(dict(d, message=msg), indent=1, default=str))
        return
    print(msg, end="")


def objections_for(segment, presence_class):
    keys = list(SEGMENT_OBJECTION.get(segment or "", ("price", "think")))
    if presence_class == "directory":
        keys = ["directory"] + [k for k in keys if k != "directory"]
    return [(k, *OBJECTIONS[k]) for k in keys[:2]]


def cmd_brief(args):
    """One screen before a call (§ 6.2): the business, the faults, the preview, the listing, the history,
    the objection that is coming and its answer, the close, the booking link. No Places call unless --live."""
    today = now_date()
    key, pid, name, city, row, _ = resolve_lead(" ".join(args.name), args.place)
    lead = pipeline_state().get(key)
    if row is None and pid:
        row = (_census_by_id(pid) or [None])[0]
    details = None
    if args.live and pid:
        k, where = places_key()
        places = Places(k, where, fixture=args.fixture)
        details = places.get(pid)
        if places.calls:
            ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
                           "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
                           "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global",
                           "for": f"brief {name}"})
    if not lead and not row:
        die(f"{name} isn't in the pipeline or the census — `leads log \"{name}\" talked …` first")
    segment = (row or {}).get("segment") or ("restaurant" if row else None)
    fs, summary = lead_faults(row, details, today) if row else ([], None)
    if not fs and lead:
        fs = [x for x in ((first_message(lead) or {}).get("was") or "").split("; ") if x]
    pv = preview_find(name) or (next((m for m in previews_all() if m.get("place_id") == pid), None) if pid else None)

    print(f"{name}{' — ' + city if city else ''}"
          + (f" · {(row or {}).get('category') or SEGMENT_NOUN.get(segment or '', '')}" if row else ""))
    if summary:
        print(f"  Google: {summary}")
    phone = (lead or {}).get("phone") or (row or {}).get("phone")
    contact = " · ".join(x for x in (phone, (lead or {}).get("reach"), lead_email(lead or {}),
                                     clean_maps((row or {}).get("google_maps_uri") or "") or None) if x)
    if contact:
        print(f"  {contact}")
    print("  Wrong: " + ("; ".join(fs[:3]) if fs else "nothing obvious — lead with what a site would add"))
    print(f"  Preview: {pv['url']} (down {dt.date.fromisoformat(pv['expires']).strftime('%-d %b')})" if pv
          else "  Preview: none yet — `leads preview \"" + name + "\"`")
    if lead:
        print(f"  Stage: {lead['stage']}" + (f", follow up {lead['next']}" if lead.get("next") else "")
              + (f" · came in by {lead_source(lead)}" if lead_source(lead) else ""))
        for e in lead["history"]:
            what = (f"day {e.get('touch')} touch ({e.get('channel')})" if e.get("kind") == "touch_due"
                    else e.get("outcome") or "")
            print(f"    {e['date']}  {what:<16} {e.get('note') or ''}".rstrip())
    else:
        print("  Stage: not in the pipeline yet — this is a cold call")
    print()
    for _, q, a in objections_for(segment, (row or {}).get("presence")):
        print(f"  They'll say {q}")
        print(f"    You say: {a}")
    print()
    print("  " + SEGMENT_CLOSE)
    if segment in SEGMENT_LADDER:
        print("  " + SEGMENT_LADDER[segment])
    book = env_value("LEADS_BOOKING_URL")
    print(f"  Book them while you're on the phone: {book}" if book else
          "  Booking link: not set yet (LEADS_BOOKING_URL, TAYLOR-TODO §1) — name a day and `leads log … --next`")


def cmd_pipeline(args):
    state = pipeline_state()
    if not state:
        print("The pipeline is empty. `leads log \"Name\" visited|talked|interested|demo|won|lost|messaged|later [note]`")
        return
    for s in STAGES:
        rows = sorted((l for l in state.values() if l.get("stage") == s), key=lambda l: l.get("next") or "9")
        if not rows or (s in ("won", "lost") and not args.all):
            if rows:
                print(f"{s}: {len(rows)}")
            continue
        print(f"{s}: {len(rows)}")
        for l in rows:
            print(f"  {l['name']}{' (' + l['city'] + ')' if l.get('city') else ''}"
                  + (f" · next {l['next']}" if l.get("next") else "") + f" · last {l['last']}")


# ---- commands -------------------------------------------------------------------

def latest(folder):
    """The newest page in a kits folder (restaurant pages are <date>.md, the others <date>-<segment>.md)."""
    pages = list(folder.glob("*.md")) if folder.exists() else []
    return max(pages, key=lambda p: (p.stat().st_mtime, p.name)) if pages else None


def cmd_kit(args):
    if args.last:
        page = latest(STATE / ("remote" if args.remote else "kits"))
        if not page:
            die("no remote kit yet; run `leads kit --remote`" if args.remote else "no kit yet; run `leads kit`")
        print(page.read_text(), end="")
        return
    segment = resolve_segment(args.segment)
    if args.remote:
        if args.radius == 10.0:
            args.radius = 30.0
        if segment == "restaurant":
            if args.min_reviews is None:
                args.min_reviews = 25
            page, picks = build_remote(args)
        else:
            page, picks = build_segment_remote(args, segment)
        if args.json:
            print(json.dumps(kit_json(picks, segment, now_date()), indent=1, default=str))
            return
        print(page, end="")
        return
    if segment == "restaurant":
        if args.min_reviews is None:
            args.min_reviews = 25
        page, order = build_kit(args)
    else:
        page, order = build_segment_kit(args, segment)
    if args.json:
        print(json.dumps([{k: v for k, v in p.items() if k != "details"} for p in order], indent=1, default=str))
        return
    print(page, end="")


def cmd_candidates(args):
    segment = resolve_segment(args.segment)
    if segment == "restaurant":
        if args.min_reviews is None:
            args.min_reviews = 25
        return restaurant_candidates(args)
    cands = candidates_for(segment, args.min_reviews)
    skip = recently_kitted(dt.datetime.now(TZ).date())
    floor = SEGMENT_MIN_REVIEWS if args.min_reviews is None else args.min_reviews
    print(f"{len(cands)} {SEGMENT_NOUN[segment]} with a phone, ≥{floor} reviews and no site of their own "
          f"(none, page, directory, dead, builder); nearest first (census {census_stamp(cands)})")
    shown = 0
    for c in cands:
        if c["miles"] > args.radius or shown >= args.n:
            break
        tag = f"  (kitted {skip[c['place_id']]})" if c["place_id"] in skip else ""
        if is_business(c):
            what = f"{c.get('category')} · {c.get('presence')}: {presence_short(c['presence'], c['presence_label'], c['presence_link'])}"
        else:
            what = f"restaurant · on {platforms(c)}"
        print(f"  {c['miles']:>4} mi  {c['name']} · {c.get('locality') or ''} · {c['rating']}★ ({c['reviews']}) · {what}{tag}")
        shown += 1


def restaurant_candidates(args):
    cands = census_candidates(args.min_reviews)
    for_date = next_saturday()
    skip = recently_kitted(for_date)
    print(f"{len(cands)} marketplace-only independents with a phone and ≥{args.min_reviews} reviews; nearest first (census {census_stamp(cands)})")
    shown = 0
    for c in cands:
        if c["miles"] > args.radius:
            break
        if shown >= args.n:
            break
        tag = f"  (kitted {skip[c['place_id']]})" if c["place_id"] in skip else ""
        web = "no site" if (c.get("has_website") or "").lower() != "yes" else (marketplace_link(c["website"]) or host_of(c["website"]))
        print(f"  {c['miles']:>4} mi  {c['name']} · {c['locality']} · {c['rating']}★ ({c['reviews']}) · {web} · on {platforms(c)}{tag}")
        shown += 1


def cmd_doctor(args):
    ok = True
    print(f"census: {CENSUS} {'ok' if CENSUS.exists() else 'MISSING'}")
    if CENSUS.exists():
        cands = census_candidates(25)
        print(f"  {len(cands)} marketplace-only independents (phone, ≥25 reviews); {sum(c['miles'] <= 10 for c in cands)} within 10 mi of home; census {census_stamp(cands)}")
    else:
        ok = False
    if CENSUS.exists():
        exists, counts = businesses_state()
        if not exists:
            print("services census: not yet — no `businesses` table (B43's scan, client-leads/scripts/scan_services.py); "
                  "the kits run on restaurants until it lands")
        else:
            conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
            classes = conn.execute("SELECT COALESCE(presence_class, 'unknown'), count(*) FROM businesses GROUP BY 1 ORDER BY 2 DESC").fetchall()
            conn.close()
            print(f"services census: {sum(counts.values())} rows"
                  + (" (" + ", ".join(f"{k} {v}" for k, v in sorted(counts.items())) + ")" if counts else " — empty, the scan hasn't written yet"))
            if classes:
                print("  presence: " + ", ".join(f"{k} {v}" for k, v in classes))
            for seg in BUSINESS_SEGMENTS:
                if counts.get(seg):
                    pool = business_candidates([seg])
                    print(f"  {seg}: {len(pool)} in the kit's pool (phone, ≥{SEGMENT_MIN_REVIEWS} reviews, no site of their own); "
                          f"{sum(c['miles'] <= 10 for c in pool)} within 10 mi")
        table = reach_table()
        if table is None:
            print("reach: no reach table yet — B61 (client-leads/scripts/reach.py) hasn't run; the kit's picks "
                  "carry only what the census's own columns hold")
        else:
            ig = sum(1 for r in table.values() if r["instagram"])
            fb = sum(1 for r in table.values() if r["facebook"])
            em = sum(1 for r in table.values() if r["email"])
            print(f"reach: {len(table)} rows searched — {ig} Instagram, {fb} Facebook, {em} email"
                  + (f"; newest check {max((r['checked'] or '')[:10] for r in table.values())}" if table else ""))
        print(f"default segment: {default_segment()}" + (" (LEADS_SEGMENT)" if os.environ.get("LEADS_SEGMENT") else
                                                       f" (services once the services census has {DEFAULT_POOL_MIN} in the kit's pool, else restaurant)"))
    key, where = places_key()
    if key:
        print(f"GOOGLE_MAPS_API_KEY: set ({where})")
        # Place Details with an IDs-only mask is the free SKU: an auth check that costs nothing.
        req = urllib.request.Request(DETAILS_URL + "ChIJN1t_tDeuEmsRUsoyG83frY4", headers={
            "X-Goog-Api-Key": key, "X-Goog-FieldMask": "id", "User-Agent": "claude-tools/leads"})
        try:
            with urllib.request.urlopen(req, timeout=15) as resp:
                json.loads(resp.read().decode())
            print("  Places API (New): ok")
        except urllib.error.HTTPError as exc:
            print(f"  Places API (New): FAIL {exc.code} — {exc.read().decode(errors='replace')[:200].strip()}")
            ok = False
        except (urllib.error.URLError, OSError) as exc:
            print(f"  Places API (New): unreachable ({exc})")
            ok = False
    else:
        print("GOOGLE_MAPS_API_KEY: not set — census-only kits until `setenv.sh GOOGLE_MAPS_API_KEY` (TAYLOR-TODO §1)")
        ok = False
    lat, lng = home()
    print(f"home: {lat},{lng}{' (LEADS_HOME)' if os.environ.get('LEADS_HOME') else ' (American Fork)'}")
    kits = kits_log()
    print(f"state: {STATE}  kits sent: {len(kits)}" + (f", last for {kits[-1]['for']}" if kits else ""))
    cached = len(list((STATE / "details").glob("*.json"))) if (STATE / "details").exists() else 0
    print(f"  cached listings: {cached}  ledger: {LEDGER}")
    print(f"next Saturday: {next_saturday()}")
    print(f"remote lane: {GROUPS_LOG} {'exists' if GROUPS_LOG.exists() else '(created on first lead)'}; "
          f"postal address for cold email: {'set' if mail_address() else 'NOT set — drafts say not ready (TAYLOR-TODO §1)'}")
    ok = preview_doctor() and ok
    sys.exit(0 if ok else 1)


def preview_doctor():
    """The previews half (B45): the copy table, the overlay, what's live, what's expiring."""
    ok = True
    print(f"previews: {PREVIEWS}  project {PREVIEW_PROJECT}  host https://{preview_host()}/")
    try:
        table = json.loads(PREVIEW_TABLE.read_text())
        cats = table["categories"]
    except (OSError, ValueError, KeyError) as exc:
        print(f"  copy table: FAIL {PREVIEW_TABLE} ({exc})")
        return False
    missing = sorted({v["template"] for v in cats.values()} - {d.name for d in SITE_TEMPLATES.iterdir() if d.is_dir()})
    print(f"  copy table: {len(cats)} categories -> templates "
          + ", ".join(sorted({v["template"] for v in cats.values()}))
          + (f"  MISSING {', '.join(missing)}" if missing else ""))
    ok = ok and not missing
    for f in ("page.html", "root.html", "404.html", "_headers", "robots.txt", "css/preview.css"):
        if not (PREVIEW_OVERLAY / f).exists():
            print(f"  overlay: MISSING templates/sites/_preview/{f}")
            ok = False
    if "noindex" not in (PREVIEW_OVERLAY / "_headers").read_text(errors="replace"):
        print("  overlay: FAIL _headers does not say noindex")
        ok = False
    rows, today = previews_all(), now_date()
    live = [m for m in rows if not m.get("claimed")]
    expired = [m for m in live if dt.date.fromisoformat(m["expires"]) < today]
    soon = [m for m in live if 0 <= (dt.date.fromisoformat(m["expires"]) - today).days <= 5]
    print(f"  built: {len(rows)} ({len(live)} live, {len(rows) - len(live)} claimed); "
          f"{len(expired)} expired (leads preview sweep), {len(soon)} down within 5 days")
    on_disk = {d.name for d in preview_site_dir().iterdir() if d.is_dir() and d.name != "css" and d.name != "js" and d.name != "images"} \
        if preview_site_dir().exists() else set()
    orphan = sorted(on_disk - {m["slug"] for m in rows})
    if orphan:
        print(f"  WARN folders with no manifest (a publish would still serve them): {', '.join(orphan[:6])}")
    row = {}
    try:
        row = json.loads((PREVIEWS / "project.json").read_text())
    except (OSError, ValueError):
        pass
    if row.get("domain"):
        print(f"  domain: {row['domain']} (the link in a message)")
    else:
        print(f"  domain: {PREVIEW_DOMAIN} not attached yet — links use the pages.dev host "
              f"(TAYLOR-TODO §1 \"previews.patchlamp.com\")")
    print(f"  hero photos: img stock (Pexels, free) by default; `--hero gen` costs one image and "
          f"logs its own ledger row")
    return ok


def main():
    ap = argparse.ArgumentParser(prog="leads", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")

    k = sub.add_parser("kit", help="Saturday's counters, one page")
    k.add_argument("--for", dest="for_date", help="YYYY-MM-DD (default: next Saturday for restaurants, today otherwise)")
    k.add_argument("--n", type=int, default=6)
    k.add_argument("--radius", type=float, default=10.0, help="miles from home (default 10)")
    k.add_argument("--min-reviews", type=int, default=None, help="default 25 for restaurants, 3 for the other segments")
    k.add_argument("--segment", choices=SEGMENTS + ("all",), help="default: services once the services census holds a kit's worth, else restaurant")
    k.add_argument("--census-only", action="store_true", help="no Google calls")
    k.add_argument("--refresh", action="store_true", help="ignore the 7-day listing cache")
    k.add_argument("--allow-repeat", action="store_true", help="don't skip places kitted in the last 8 weeks")
    k.add_argument("--last", action="store_true", help="reprint the last kit")
    k.add_argument("--no-save", action="store_true")
    k.add_argument("--json", action="store_true")
    k.add_argument("--fixture", help="dir of <place_id>.json Place Details (tests)")
    k.add_argument("--remote", action="store_true", help="today's six ready-to-send messages, not Saturday's counters (B25; radius 30)")
    k.add_argument("--previews", action="store_true",
                   help="with --remote: build a preview site for any pick that hasn't got one (B45) and put its "
                        "link in the message")
    k.set_defaults(fn=cmd_kit)

    g = sub.add_parser("diagnose", help="three lines on a business's Google listing, for a group thread")
    g.add_argument("name", nargs="+", help='"Name" or "Name, City"')
    g.add_argument("--group", help="the group the name came from (logged)")
    g.add_argument("--no-log", action="store_true")
    g.add_argument("--live", action="store_true", help="read the Google listing even for a name in the services census")
    g.add_argument("--fixture", help="dir of <place_id>.json Place Details (tests)")
    g.set_defaults(fn=cmd_diagnose)

    c = sub.add_parser("candidates", help="the pool the kit picks from (no spend)")
    c.add_argument("--n", type=int, default=20)
    c.add_argument("--radius", type=float, default=10.0)
    c.add_argument("--min-reviews", type=int, default=None, help="default 25 for restaurants, 3 for the other segments")
    c.add_argument("--segment", choices=SEGMENTS + ("all",))
    c.set_defaults(fn=cmd_candidates)

    lg = sub.add_parser("log", help="log a conversation: leads log \"Name[, City]\" OUTCOME [note...]")
    lg.add_argument("name", help='"Name" or "Name, City"', nargs=1)
    lg.add_argument("outcome", help=" | ".join(OUTCOMES))
    lg.add_argument("note", nargs="*")
    lg.add_argument("--next", help="follow-up: tomorrow, fri, 3d, 2w, 2026-10-01, none (default by outcome)")
    lg.add_argument("--who", help="who you talked to")
    lg.add_argument("--email")
    lg.add_argument("--phone")
    lg.add_argument("--via", help="counter, dm, email, group, phone, referral")
    lg.add_argument("--source", choices=SOURCES, help="the channel, for the week's cut (default: from --via, "
                                                      "the channel this lead is already on, or the reach the kit used)")
    lg.add_argument("--place", help="census place id, when the name matched the wrong one")
    lg.add_argument("--n", type=int, default=6, help="size of tomorrow's list")
    lg.set_defaults(fn=cmd_log)

    nx = sub.add_parser("next", help="the day's list: follow-ups due, then new leads (default tomorrow)")
    nx.add_argument("when", nargs="?")
    nx.add_argument("--n", type=int, default=6)
    nx.add_argument("--segment", choices=SEGMENTS + ("all",), help="where the new leads come from (default as kit)")
    nx.set_defaults(fn=cmd_next)

    se = sub.add_parser("sent", help="picks from the last remote kit that went out: leads sent 1 3 4 | all")
    se.add_argument("which", nargs="+")
    se.add_argument("--via", default="dm")
    se.add_argument("--source", choices=SOURCES, help="the channel (default: from --via)")
    se.set_defaults(fn=cmd_sent)

    du = sub.add_parser("due", help="follow-ups due today")
    du.set_defaults(fn=cmd_due)

    td = sub.add_parser("today", help="the 07:30 message: the six, yesterday's replies, what's due, the first call")
    td.add_argument("--n", type=int, default=6, help="picks in the kit (default 6)")
    td.add_argument("--segment", choices=SEGMENTS + ("all",))
    td.add_argument("--fresh", action="store_true", help="run a new kit even if one ran today")
    td.add_argument("--census-only", action="store_true", help="no Google calls")
    td.add_argument("--no-save", action="store_true")
    td.add_argument("--json", action="store_true", help="the message and everything in it")
    td.add_argument("--fixture", help="dir of <place_id>.json Place Details (tests)")
    td.set_defaults(fn=cmd_today)

    br = sub.add_parser("brief", help="one screen before a call: the fault, the preview, the history, the objection, the close")
    br.add_argument("name", nargs="+", help='"Name" or "Name, City"')
    br.add_argument("--place", help="census place id, when the name matched the wrong one")
    br.add_argument("--live", action="store_true", help="read the Google listing too (one Places call)")
    br.add_argument("--fixture", help="dir of <place_id>.json Place Details (tests)")
    br.set_defaults(fn=cmd_brief)

    cd = sub.add_parser("cadence", help="the day 3 / 10 / 30 touches a silent lead is owed (§ 5.5)")
    cd.add_argument("--dry-run", action="store_true", help="say what is due, write nothing")
    cd.set_defaults(fn=cmd_cadence)

    sh = sub.add_parser("show", help="one lead's history")
    sh.add_argument("name", nargs="+")
    sh.add_argument("--place")
    sh.set_defaults(fn=cmd_show)

    wk = sub.add_parser("week", help="this week's numbers")
    wk.add_argument("--ago", type=int, default=0, help="weeks back")
    wk.add_argument("--by", choices=["channel"], help="the Sunday review (B52): the funnel per channel and the § 2.4 rows")
    wk.add_argument("--json", action="store_true", help="the same numbers, for GROWTH § 13's row")
    wk.set_defaults(fn=cmd_week)

    pp = sub.add_parser("pipeline", help="every lead by stage")
    pp.add_argument("--all", action="store_true", help="list won and lost too")
    pp.set_defaults(fn=cmd_pipeline)

    pv = sub.add_parser("preview", help="a lead's own website, built from the census row (B45): NAME | --kit | ls | sweep")
    pv.add_argument("name", nargs="*", help='"Name" or "Name, City" (several allowed); or `ls` / `sweep`')
    pv.add_argument("--kit", action="store_true", help="today's remote-kit picks (else the nearest of the pool)")
    pv.add_argument("--n", type=int, default=6)
    pv.add_argument("--segment", choices=SEGMENTS + ("all",))
    pv.add_argument("--min-reviews", type=int, default=None)
    pv.add_argument("--days", type=int, default=PREVIEW_DAYS, help=f"days before it expires (default {PREVIEW_DAYS})")
    pv.add_argument("--hero", choices=["stock", "gen", "none"], default="stock",
                    help="the one photo: a Pexels stock landscape (free, default), one generated image, or none. "
                         "Never one of their Google photos.")
    pv.add_argument("--remove", metavar="NAME", help="take one down now (the folder, the manifest, one publish)")
    pv.add_argument("--claim", metavar="NAME", help="turn it into a client site: client new + site new from the same files")
    pv.add_argument("--slug", help="with --claim: the client workspace slug (default: from the name)")
    pv.add_argument("--no-publish", action="store_true", help="fill the files, upload nothing")
    pv.add_argument("--dry-run", action="store_true", help="say what would happen, change nothing live")
    pv.add_argument("--census-only", action="store_true", help="no Google calls (no hours, no rating)")
    pv.add_argument("--refresh", action="store_true", help="ignore the 7-day listing cache")
    pv.add_argument("--json", action="store_true")
    pv.add_argument("--fixture", help="dir of <place_id>.json Place Details (tests)")
    pv.set_defaults(fn=cmd_preview)

    d = sub.add_parser("doctor")
    d.set_defaults(fn=cmd_doctor)

    args = ap.parse_args()
    if not args.cmd:
        ap.print_help()
        sys.exit(0)
    args.fn(args)


if __name__ == "__main__":
    main()
