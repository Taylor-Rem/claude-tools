# ---- the email batch (B90, plan ~/projects/plans/37-email-at-volume.md § Contract) ----------------------
# B89's pass (client-leads/scripts/emails.py) stored, per business with a site of its own, the addresses its site
# publishes (`emails`) and the plain facts of the site (`site_facts`). Here those become a facts packet — the faults
# that are true of the business, each {key, sentence, evidence}, computed in code and never written by a model — and
# a batch: fifty or fewer in one trade across the corridor (--city narrows), each with its address and exactly two
# true specifics, at least one a fault and faults first; the second may be a plain fact (their Google standing).
# A business with no fault, or one fault and nothing true to say beside it, is left out: padding a letter with a
# weak fault is how a cold email reads as spam (plan 37 § What the first build found).

BATCH_MAX = 50
FACT_MAX_AGE_DAYS = 90         # a census read older than this isn't quoted back to them
FACT_MIN_REVIEWS, FACT_MIN_RATING = 21, 4.5   # "more than 20 reviews, averaging 4.5" or better: a compliment
CHAIN_SITE_LISTINGS = 3        # a website on this many listings is a franchise or a multi-site organisation
LOW_REVIEW_MAX_REVIEWS = 100     # past this many reviews, one low one isn't a fault worth a letter
OLD_YEAR_GAP = 3                  # a copyright line three or more years behind the calendar is worth naming
BATCH_LIVE_CAP_DEFAULT = 100      # listing reads a day for `leads batch --live` (LEADS_LIVE_READS_PER_DAY)
FREE_MAIL = {"gmail.com", "googlemail.com", "yahoo.com", "ymail.com", "hotmail.com", "outlook.com", "live.com",
             "msn.com", "aol.com", "icloud.com", "me.com", "mac.com", "comcast.net", "protonmail.com", "proton.me",
             "gmx.com", "mail.com", "zoho.com", "xmission.com", "juno.com", "att.net", "sbcglobal.net"}
# B89 keeps a free-mail address whose only tie to the business is the page's title; it flagged those as weak, and a
# letter to the wrong person's Gmail is the complaint we can least afford (plan 37 § 3, Gmail's 0.1% line).
WEAK_EMAIL_WHY = "titled with"
CLIENTS_DIR = Path(os.environ.get("LEADS_CLIENTS_DIR", PROJECTS / "clients"))
OUTREACH_BIN = Path(os.environ.get("LEADS_OUTREACH_BIN", Path(__file__).resolve().parent / "outreach"))

# key -> rank: lower is said first. What a customer meets first and can't be argued with leads: the secure address
# failing (the first thing a click from the listing meets, in the browser's own words), then a named link that goes
# nowhere (asked again the day the batch is made), then the phone layout sliding sideways and an image that doesn't
# load (seen on the page, on a phone). Then their own words with a number (the copyright year), a tag absent from
# the page (no viewport), Google's own phone score (a number, but one that moves between runs), then the listing.
FAULT_RANK = {"https_fails": 4, "broken_link": 6, "sideways": 7, "broken_image": 8,
              "old_copyright": 10, "no_viewport": 20, "psi_poor": 30, "website_link": 40,
              "no_hours": 50, "closed_saturday": 52, "no_photos": 55, "few_photos": 56, "no_phone": 60,
              "menu_page": 70, "low_review": 85, "listing": 88}

# B99: the faults client-leads/scripts/site_checks.py stores in `site_checks` (its README has every column and rule).
# A fault is said only once thirty spot checks of it found none false (client-leads/spot-checks/b99-*.md); this is
# that list, and the one place a fault is switched on. The others are computed, tested and counted by
# `--stats` as waiting, and never reach a letter. "No contact form" is not here and must not come back: forms hide
# in booking flows and pages two clicks deep (8 of 30 false), so `form` is a fact the pass stores, never a fault.
CHECK_FAULTS_PROVEN = ("https_fails", "broken_link")        # https 30/30; links 56 true, 0 false (2026-10-01)
CHECK_FAULTS_WAITING = ("sideways", "broken_image", "psi_poor")   # 4/4, 6/7 and no scores yet: fewer than thirty
# A stored check older than this isn't said: the pass reads the whole census in a night, and a month is long enough
# for a batch a week to draw on one re-read while short enough that a redesign rarely lands in between. The faults a
# re-check can confirm (the secure address, a link, an image) are also asked again the day the batch is made; the
# age still matters for them, since a link that still fails may no longer be on the page.
SITE_CHECK_MAX_DAYS = 30
SIDEWAYS_MIN_PX = 40      # site_checks.py's own threshold: less is a wobble (an off-canvas menu edge)
PSI_POOR_BELOW = 50       # Google's own "poor" band for the performance score
# Words a page uses for many links at once: "the 'Learn More' link" could be any of five, and a visitor who tries a
# working one has been told something untrue, so these are counted, not named (B99's real picks: three sites).
GENERIC_LINK_TEXT = {"learn more", "read more", "more", "see more", "view more", "more info", "click here", "here",
                     "details", "view details", "shop now", "buy now", "order now", "get started", "find out more",
                     "discover more", "explore", "view", "continue", "next", "previous", "back", "link", "go"}
LINK_TEXT_RE = re.compile(r"^[A-Za-z][A-Za-z0-9 &'’-]{1,29}$")    # a link's words safe to quote back to them
CHECK_UA = ("Mozilla/5.0 (compatible; PatchlampBot/1.0; +https://patchlamp.com; founder@patchlamp.com) "
            "reading published business contact details")       # the pass's own honest user agent (emails.py)


def email_tables():
    """True when B89's tables are in the census (emails + site_facts)."""
    if not CENSUS.exists():
        return False
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    try:
        have = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
    finally:
        conn.close()
    return {"emails", "site_facts"} <= have


def fmt_phone(digits):
    d = re.sub(r"\D", "", str(digits or ""))[-10:]
    return f"({d[:3]}) {d[3:6]}-{d[6:]}" if len(d) == 10 else str(digits or "")


def strip_tracking(url):
    """A site URL as a person would type it: Google's utm_* tags off, nothing else touched."""
    p = urllib.parse.urlsplit(url or "")
    if not p.query:
        return url or ""
    q = [(k, v) for k, v in urllib.parse.parse_qsl(p.query, keep_blank_values=True) if not k.lower().startswith("utm_")]
    return urllib.parse.urlunsplit((p.scheme, p.netloc, p.path, urllib.parse.urlencode(q), p.fragment))


def best_email(rows, high=True):
    """The address a letter goes to, or None: MX ok and syntax ok only; own-domain over free-mail; never a free-mail
    address B89 tied to the business by the page title alone. B104: only an address `emails.confidence` holds as
    `high` (tied to the place where it was read); a census from before that column has none, so no letter goes
    until emails.py's migrate has run. `high=False` is the best of the rest, for the call-only line."""
    rows = [r for r in rows if (r.get("confidence") == "high") == high]
    ok = [r for r in rows if r.get("mx") == "ok" and (r.get("syntax_ok") in (1, None))
          and r.get("kind") in ("own-domain", "free-mail")
          and not (r.get("kind") == "free-mail" and WEAK_EMAIL_WHY in (r.get("why") or ""))]
    ok.sort(key=lambda r: (r.get("kind") != "own-domain", r.get("source") != "site", r.get("address") or ""))
    return ok[0] if ok else None


BATCH_UNCONFIRMED = []      # B104: the rows batch_rows left out because their address isn't `high`; call-only


def batch_rows(segments):
    """Every business in these segments with a usable address: the census row joined to its best address, its site
    facts and the pages the crawl read. Operational only; chains are dropped later with the other exclusions."""
    if not email_tables():
        return []
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
    try:
        mail = {}
        for r in conn.execute("SELECT * FROM emails"):
            mail.setdefault(r["place_id"], []).append(dict(r))
        facts = {r["place_id"]: dict(r) for r in conn.execute("SELECT * FROM site_facts")}
        checks = ({r["place_id"]: dict(r) for r in conn.execute("SELECT * FROM site_checks")}
                  if "site_checks" in tables else {})
        pages = {}
        if "email_pass" in tables:
            for r in conn.execute("SELECT place_id, pages FROM email_pass"):
                try:
                    pages[r["place_id"]] = json.loads(r["pages"] or "[]")
                except ValueError:
                    pages[r["place_id"]] = []
        rows = []
        biz = [s for s in segments if s in BUSINESS_SEGMENTS]
        if biz and "businesses" in tables:
            marks = ",".join("?" * len(biz))
            rows += [dict(r) for r in conn.execute(f"""
                SELECT b.place_id, b.segment, b.category, b.presence_class, b.presence_url, b.city,
                       p.name, p.address, p.locality, p.phone, p.website, p.has_website, p.rating, p.reviews,
                       p.lat, p.lng, p.primary_type, p.google_maps_uri, p.business_status, p.refreshed_at
                FROM businesses b JOIN place_cache p ON p.place_id = b.place_id
                WHERE b.segment IN ({marks})
                  AND (p.business_status IS NULL OR p.business_status = 'OPERATIONAL')""", biz)]
        if "restaurant" in segments and "restaurants" in tables:
            rows += [dict(r, segment="restaurant", category=(r["primary_type"] or "restaurant").replace("_", " "))
                     for r in conn.execute("""
                SELECT r.place_id, r.city, r.parasite_url, r.on_doordash, r.on_uber, r.on_grubhub,
                       p.name, p.address, p.locality, p.phone, p.website, p.has_website, p.rating, p.reviews,
                       p.lat, p.lng, p.primary_type, p.google_maps_uri, p.business_status, p.refreshed_at
                FROM restaurants r JOIN place_cache p ON p.place_id = r.place_id
                WHERE (p.business_status IS NULL OR p.business_status = 'OPERATIONAL')
                  AND COALESCE(r.status, 'Open') = 'Open'""")]
    finally:
        conn.close()
    out = []
    BATCH_UNCONFIRMED.clear()
    for d in rows:
        e = best_email(mail.get(d["place_id"]) or [])
        if not e:
            held = best_email(mail.get(d["place_id"]) or [], high=False)
            if held:                       # an address nothing ties to the place: never a letter, said as call-only
                BATCH_UNCONFIRMED.append({"place_id": d["place_id"], "name": d.get("name"), "address": held["address"],
                                          "category": d.get("category"), "locality": d.get("locality"),
                                          "city": d.get("city"),
                                          "town": (d.get("locality") or (d.get("city") or "").replace(", Utah", "")).strip(),
                                          "why": held.get("place") or held.get("confidence")
                                          or "no place judgement yet (emails.py migrate)"})
            continue
        d["mail"], d["facts"], d["pages"] = e, facts.get(d["place_id"]), pages.get(d["place_id"]) or []
        d["checks"] = checks.get(d["place_id"])
        d["town"] = (d.get("locality") or (d.get("city") or "").replace(", Utah", "")).strip()
        out.append(d)
    return out


# The copyright year is read again from the page before a letter says it (B90's spot check: Bullett Electric's
# "© 2019-26" was stored as 2019, because B89's pattern takes a range's end only when it has four digits, and a page
# changes after a crawl). Only the picks a batch keeps are read, one request each, cached a week.
COPY_LINE_RE = re.compile(r"(?:©|&copy;|&#169;|\(c\)|copyright)\s*(?:by\s*)?((?:19|20)\d{2})"
                          r"(?:\s*(?:[-–—/]|&ndash;|&mdash;|&#8211;|to|through)\s*(\d{4}|\d{2})(?!\d))?", re.I)
_COPY = None


def copyright_now(url, today):
    """(latest year the page's copyright lines show, why) or (None, why) when unsure: the page didn't answer, no
    copyright line on it now, or a script writes the year (what the visitor sees is then the current one).
    LEADS_PAGE_FIXTURE is a JSON {url: html} for tests; LEADS_PAGE_CHECK=0 turns the reads off (nothing is said)."""
    global _COPY
    if not url:
        return None, "no url"
    fx = os.environ.get("LEADS_PAGE_FIXTURE")
    html = None
    if fx:
        try:
            html = json.loads(Path(fx).read_text()).get(url)
        except (OSError, ValueError):
            html = None
        if html is None:
            return None, "fixture: no page"
    elif os.environ.get("LEADS_PAGE_CHECK") == "0":
        return None, "page reads off"
    else:
        path = STATE / "copyright.json"
        if _COPY is None:
            try:
                _COPY = json.loads(path.read_text())
            except (OSError, ValueError):
                _COPY = {}
        row = _COPY.get(url)
        if row and row.get("checked", "") >= (today - dt.timedelta(days=CACHE_DAYS)).isoformat():
            return row.get("year"), row.get("why") or ""
        try:
            req = urllib.request.Request(url, headers={
                "User-Agent": "claude-tools/leads (Patchlamp; one page read to confirm a fact before it is said)"})
            with urllib.request.urlopen(req, timeout=12) as r:
                html = r.read(3_000_000).decode("utf-8", "replace")
        except Exception as exc:          # noqa: BLE001 — any failure is "unsure", and unsure is never said
            html, why = None, f"unsure ({type(exc).__name__})"
        if html is not None:
            year, why = _copyright_in(html)
        else:
            year = None
        _COPY[url] = {"year": year, "why": why, "checked": today.isoformat()}
        try:
            STATE.mkdir(parents=True, exist_ok=True)
            path.write_text(json.dumps(_COPY, indent=0, sort_keys=True) + "\n")
        except OSError:
            pass
        return year, why
    return _copyright_in(html)


def _copyright_in(html):
    if re.search(r"getFullYear|getUTCFullYear", html):
        return None, "a script writes a year on the page"
    latest = None
    for a, b in COPY_LINE_RE.findall(html):
        y = int(a)
        if b:
            e = int(b) if len(b) == 4 else y // 100 * 100 + int(b)
            y = max(y, e) if e <= y + 60 else y
        latest = y if latest is None else max(latest, y)
    return (latest, f"the page shows © {latest}") if latest else (None, "no copyright line on the page now")


def confirm_packet(c, today):
    """Re-read what the stored facts said and could have changed (the copyright year; B99's secure address, broken
    links and images, asked again); drop a fault the site no longer bears out and recompute the two specifics.
    True when the business still qualifies."""
    items = []
    for f in c["all_faults"]:
        if len(items) >= 2:              # two confirmed are all a letter says: don't ask a site more than that needs
            break
        if f.get("recheck"):
            g = recheck(f, today)
            if not g:
                c.setdefault("dropped", []).append(f"{f['key']} (not borne out when asked again)")
                continue
            f = g
        if f["key"] == "old_copyright":
            y, why = copyright_now(f["evidence"], today)
            if not y or y > today.year - OLD_YEAR_GAP:
                c.setdefault("dropped", []).append(f"old_copyright ({why})")
                continue
            f = dict(f, sentence=f"the copyright line on your site says © {y}", year=y)
        items.append(f)
    c["all_faults"] = items
    c["packet"] = specifics(c, today, items)
    return bool(c["packet"])


HOME_PATHS = {"", "/", "/home", "/home/", "/index.html", "/index.htm", "/index.php", "/en", "/en/"}


def own_home_page(listed, landed):
    """True when the page the crawl read is this business's own home page: the listing links a home path and the
    link lands on the same host. A location page on a bigger site (planetbeach.com/spa/layton, a franchise's
    /draper) or a link that lands on another domain is the organisation's page, not theirs, so its copyright line
    and layout aren't said as "your site" (B90's spot check: Planet Beach Layton landed on sol-spa.net)."""
    if not listed:
        return False
    path = urllib.parse.urlsplit(listed if "://" in listed else "http://" + listed).path.lower()
    return path in HOME_PATHS and (not landed or host_of(landed) == host_of(listed))


def site_fault_items(c, today):
    """The faults the stored site facts make true, each {key, sentence, evidence}."""
    f = c.get("facts")
    if not f:
        return []
    if not own_home_page(c.get("website") or f.get("url"), f.get("final_url")):
        return []
    out = []
    home_url = strip_tracking(f.get("final_url") or f.get("url") or "")
    yr = f.get("copyright_year")
    if yr and int(yr) <= today.year - OLD_YEAR_GAP:
        out.append({"key": "old_copyright", "sentence": f"the copyright line on your site says © {int(yr)}",
                    "evidence": home_url, "year": int(yr)})
    if f.get("viewport") == 0:
        out.append({"key": "no_viewport",
                    "sentence": "your site has no phone-sized layout, so phones get the desktop page shrunk to fit",
                    "evidence": home_url + " (no viewport tag on the home page)"})
    # Not said (B90's spot checks proved each false at least once; B99 grows the list with checks that hold):
    # "not secure" — Chrome upgrades an http link to https when the site serves it, and B89 stored only where the
    # link landed; a phone that differs from the listing — often a call-tracking number put there on purpose.
    # Not said: "no contact form". B89's `contact_form` looks for a <form> element, and builder sites draw theirs
    # without one (GoDaddy, a bare <textarea>) or by script (Wix, Squarespace): B90's spot check found three false of
    # thirty-six read. It becomes a fault once the crawl stores "a message box anywhere on the contact page".
    return out


def _check_day(s):
    try:
        return dt.date.fromisoformat((s or "")[:10])
    except ValueError:
        return None


def _say_date(d):
    return f"{d:%B} {d.day}"


def quotable(text):
    """A link's visible words as we may quote them back, or None: plain characters only, short, starting with a
    letter (an icon link, a phone number, a web address or a sentence falls back to a count). All capitals are
    usually a stylesheet's doing, so they are said in title case."""
    t = re.sub(r"\s+", " ", text or "").strip()
    if not LINK_TEXT_RE.match(t) or len(t.split()) > 4 or t.lower() in GENERIC_LINK_TEXT:
        return None
    return t.title() if t.isupper() and len(t) > 3 else t


def https_sentence(state, listed, https_url):
    """What a visitor meets, said of the website on their Google listing (a third of these are a vendor's ordering
    page, so never "your designer" or "your site"). A listing that links the https address itself opens Chrome's
    error page; one that links http (or an https address that sends them to http) loads, marked "Not secure"."""
    if state == "fails" and (listed or "").lower().startswith("https://") and \
            urllib.parse.urlsplit(listed).hostname == urllib.parse.urlsplit(https_url).hostname:
        return "the website link on your Google listing opens a browser error page instead of your site"
    return 'the website on your Google listing has no working secure (https) version, so Chrome marks it "Not secure"'


def check_fault_items(c, today):
    """Every fault B99's `site_checks` row makes true, each {key, sentence, evidence, ...}, proven or not (the caller
    keeps the ones on CHECK_FAULTS_PROVEN). None for a missing row or one older than SITE_CHECK_MAX_DAYS. The site's
    own faults (links, images, layout, score) only on the business's own home page, as B90's are; the secure address
    on any link the listing carries, because the link is theirs to change even when the page is a vendor's."""
    r = c.get("checks")
    if not r:
        return []
    day = _check_day(r.get("checked"))
    if not day or (today - day).days > SITE_CHECK_MAX_DAYS:
        return []
    out, on = [], day.isoformat()
    listed = c.get("website") or ""
    if r.get("https") in ("fails", "to-http") and r.get("https_url") and \
            host_of(r["https_url"]) == host_of(listed or r.get("url") or ""):
        out.append({"key": "https_fails", "sentence": https_sentence(r["https"], listed, r["https_url"]),
                    "evidence": f"{r['https_url']}: {r.get('https_why') or r['https']} (checked {on})",
                    "recheck": {"kind": "https", "url": r["https_url"], "listed": listed}})
    if not own_home_page(listed or r.get("url"), r.get("url")):
        return out
    page = strip_tracking(r.get("url") or "")
    try:
        links = (json.loads(r.get("broken_links_evidence") or "{}") or {}).get("links") or []
    except ValueError:
        links = []
    # Only a link with visible words: an icon or image link may be one a visitor can't follow (B99's two unsure).
    links = [lk for lk in links if (lk.get("text") or "").strip() and lk.get("href")]
    if (r.get("broken_links") or 0) > 0 and links:
        out.append({"key": "broken_link", "sentence": "", "evidence": "",
                    "recheck": {"kind": "links", "links": links[:3], "page": page, "on": on}})
    try:
        imgs = (json.loads(r.get("broken_images_evidence") or "{}") or {}).get("images") or []
    except ValueError:
        imgs = []
    imgs = [im for im in imgs if im.get("src")]
    if (r.get("broken_images") or 0) > 0 and imgs:
        out.append({"key": "broken_image", "sentence": "", "evidence": "",
                    "recheck": {"kind": "images", "images": imgs[:3], "page": page, "on": on}})
    if (r.get("sideways") or 0) >= SIDEWAYS_MIN_PX:
        try:
            ev = json.loads(r.get("sideways_evidence") or "{}") or {}
        except ValueError:
            ev = {}
        out.append({"key": "sideways",
                    "sentence": "on a phone, your site's home page slides sideways, part of it off the screen",
                    "evidence": f"{page}: on a {ev.get('vw') or 390}-px phone the page is {ev.get('sw') or '?'} px "
                                f"wide and scrolls {r['sideways']} px sideways (checked {on})"})
    psi_day = _check_day(r.get("psi_date"))
    if r.get("psi_score") is not None and r["psi_score"] < PSI_POOR_BELOW and psi_day and \
            (today - psi_day).days <= SITE_CHECK_MAX_DAYS:
        out.append({"key": "psi_poor",
                    "sentence": f"Google's PageSpeed test scored your site's home page {int(r['psi_score'])} out "
                                f"of 100 on a phone on {_say_date(psi_day)}",
                    "evidence": f"https://pagespeed.web.dev/ for {page}: mobile performance {int(r['psi_score'])} "
                                f"(run {psi_day.isoformat()}; under {PSI_POOR_BELOW} is Google's poor band)"})
    # Stored counts are what the pass saw; until the day's re-check, the two below say it plainly from storage.
    for it in out:
        if it["key"] == "broken_link":
            it["sentence"], it["evidence"] = link_words(it["recheck"]["links"], page, on)
        elif it["key"] == "broken_image":
            it["sentence"], it["evidence"] = image_words(it["recheck"]["images"], page, on)
    return out


NUMBER_WORDS = {2: "two", 3: "three", 4: "four", 5: "five"}


def link_words(dead, page, on, today=None):
    """(sentence, evidence) for links found gone: the first one whose words can be quoted, named; otherwise how many."""
    named = next((lk for lk in dead if quotable(lk.get("text"))), None)
    when = f"checked {on}" + (f", asked again {today}" if today else "")
    ev = f"{page}: " + "; ".join(f"\"{(lk.get('text') or '').strip()[:40]}\" → {lk['href']} answered "
                                 f"{lk.get('now') or lk.get('status')}" for lk in dead) + f" ({when})"
    if named:
        return f"the \"{quotable(named['text'])}\" link on your site's home page goes to a page that isn't there", ev
    if len(dead) == 1:
        return "a link on your site's home page goes to a page that isn't there", ev
    return f"{NUMBER_WORDS.get(len(dead), len(dead))} links on your site's home page go to pages that aren't there", ev


def image_words(dead, page, on, today=None):
    when = f"checked {on}" + (f", asked again {today}" if today else "")
    ev = f"{page}: " + "; ".join(f"{im['src']} answered {im.get('now') or im.get('status')}" for im in dead) + \
        f" ({when}, drawn on a 390-px phone)"
    if len(dead) == 1:
        return "on a phone, an image on your site's home page doesn't load", ev
    return f"on a phone, {NUMBER_WORDS.get(len(dead), len(dead))} images on your site's home page don't load", ev


_RECHECK = None
_LAST_HIT = {}


# What a page that isn't there says. A 404 is not enough for a link: a site can answer 404 and still show a whole
# page (B99's real-pick check: Nepali Chulo's Squarespace answers 404 for /mneu-nepali-chulo and shows its About
# page), and a visitor who meets a real page has not met a broken link. A blank answer is unsure, not gone.
GONE_PAGE_RE = re.compile(r"not\s*found|\b404\b|can\s*not be found|could\s*not be found|couldn.t find|can.t find|"
                          r"could not find|unable to find|does\s*n.?o?t exist|no longer exists|no longer available|"
                          r"page (?:you|you're) (?:are |were )?(?:looking|searching) for", re.I)


def reads_gone(body):
    """True when a 404/410 answer's page says it isn't there (title and visible words, scripts and styles out)."""
    t = re.sub(r"(?is)<(script|style|noscript)\b.*?</\1\s*>", " ", body or "")
    t = html.unescape(re.sub(r"<[^>]+>", " ", t))
    return bool(GONE_PAGE_RE.search(t[:200_000]))


def ask_again(url, today, page=False):
    """One GET of a stored address the day a batch is made: an HTTP status (int), or "tls" / "refused" when the
    secure connection fails, "http" when it lands on an http:// page, or "unsure" (a timeout, anything odd). With
    page=True a 404/410 counts only when its page says so (reads_gone); one that shows a page comes back as
    "404-page". One request a second per host, the pass's user agent, nothing sent; answers kept for the day.
    LEADS_STATUS_FIXTURE is a JSON {url: answer} (tests); LEADS_PAGE_CHECK=0 makes every answer "unsure", so nothing
    re-checked is said."""
    global _RECHECK
    fx = os.environ.get("LEADS_STATUS_FIXTURE")
    if fx or os.environ.get("LEADS_PAGE_FIXTURE"):
        try:
            return json.loads(Path(fx).read_text()).get(url, "unsure") if fx else "unsure"
        except (OSError, ValueError):
            return "unsure"
    if os.environ.get("LEADS_PAGE_CHECK") == "0":
        return "unsure"
    path = STATE / "rechecks.json"
    if _RECHECK is None:
        try:
            _RECHECK = json.loads(path.read_text())
        except (OSError, ValueError):
            _RECHECK = {}
    key = url + ("#page" if page else "")
    row = _RECHECK.get(key)
    if row and row.get("day") == today.isoformat():
        return row["answer"]
    host = urllib.parse.urlsplit(url).hostname or ""
    wait = 1.0 - (time.monotonic() - _LAST_HIT.get(host, -10.0))
    if wait > 0:
        time.sleep(wait)
    _LAST_HIT[host] = time.monotonic()
    req = urllib.request.Request(url, headers={"User-Agent": CHECK_UA, "Accept": "text/html,*/*;q=0.5"})
    try:
        with urllib.request.urlopen(req, timeout=12) as resp:
            answer = "http" if resp.geturl().lower().startswith("http://") and url.lower().startswith("https://") \
                else resp.status
    except urllib.error.HTTPError as exc:
        answer = exc.code
        if page and answer in (404, 410):
            try:
                body = exc.read(1_000_000).decode("utf-8", "replace")
            except Exception:            # noqa: BLE001 — a body we can't read is a page we can't vouch for
                body = ""
            if not reads_gone(body):
                answer = f"{answer}-page"
    except urllib.error.URLError as exc:
        why = str(exc.reason).lower()
        answer = ("tls" if "ssl" in why or "certificate" in why else
                  "refused" if "refused" in why else "unsure")
    except Exception:                    # noqa: BLE001 — anything else is unsure, and unsure is never said
        answer = "unsure"
    _RECHECK[key] = {"answer": answer, "day": today.isoformat()}
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(_RECHECK, indent=0, sort_keys=True) + "\n")
    except OSError:
        pass
    return answer


def recheck(f, today):
    """The fault as it stands today, or None when the site no longer bears it out (or we can't tell)."""
    rc = f.get("recheck") or {}
    if rc.get("kind") == "https":
        a = ask_again(rc["url"], today)
        if a in ("tls", "refused"):
            state = "fails"
        elif a == "http":
            state = "to-http"
        else:
            return None                  # it serves now, or we couldn't tell
        return dict(f, sentence=https_sentence(state, rc["listed"], rc["url"]),
                    evidence=f"{f['evidence']}; asked again {today.isoformat()}: {a}")
    if rc.get("kind") in ("links", "images"):
        items = rc["links"] if rc["kind"] == "links" else rc["images"]
        dead = []
        for it in items:
            a = ask_again(it["href" if rc["kind"] == "links" else "src"], today, page=rc["kind"] == "links")
            if a in (404, 410):
                dead.append(dict(it, now=a))
        if not dead:
            return None
        words = link_words if rc["kind"] == "links" else image_words
        s, ev = words(dead, rc["page"], rc["on"], today.isoformat())
        return dict(f, sentence=s, evidence=ev)
    return f


def listing_fault_item(fault, c, read_on):
    """One of the kit's listing faults (business_faults / faults, the same rules and words), as an item for a
    letter: said to the owner, standing on its own, with the listing as the evidence."""
    ev = clean_maps(c.get("google_maps_uri")) + (f" (listing read {read_on})" if read_on else " (census)")
    m = re.match(r"^only (\d+) photos$", fault)
    if fault == "no hours on Google":
        k, s = "no_hours", "your Google listing shows no hours"
    elif fault == "Google says closed Saturdays":
        k, s = "closed_saturday", "Google says you're closed on Saturdays"
    elif fault == "no photos":
        k, s = "no_photos", "your Google listing has no photos"
    elif m:
        k, s = "few_photos", f"your Google listing has only {m.group(1)} photos"
    elif fault == "no phone on Google":
        k, s = "no_phone", "there's no phone number on your Google listing"
    elif fault.startswith("newest review is "):
        return None                       # Places returns the five "most relevant" reviews, not the newest five
    elif fault.startswith("Google shows a street address"):
        return None                       # a shop with a real address is not wrong; the kit's opener, not a letter's fact
    elif re.match(r"^a \d★ review", fault):
        said = to_you(fault)
        k, s = "low_review", (said.replace(" on it ", " on your Google listing ", 1) if " on it " in said
                              else f"there's {fault} on your Google listing")
    elif fault.startswith("searching the name"):
        k, s = "menu_page", "searching your name on Google " + to_them(fault)[len("searching the name "):]
    elif fault.startswith(("special hours",)):
        return None                       # "check they're right" is a question, not a fact
    elif fault.startswith(("no website", "the website")):
        k, s = "website_link", site_fault_words(c, fault)[0]
    else:
        k, s = "listing", to_you(fault)
    return {"key": k, "sentence": s, "evidence": ev}


def listing_fault_items(c, details, today):
    """The kit's own listing rules (business_faults for a business, faults for a restaurant), minus the review count
    and the rating — the same line `lead_faults` draws for a DM. Census-only when details is None."""
    probe = dict(c)
    fs, _ = (faults if c.get("segment") == "restaurant" else business_faults)(probe, details, today)
    fs = [f for f in fs if not re.match(r"^(only \d+ reviews|rating )", f)]
    if probe.get("presence") == "own" or c.get("segment") == "restaurant":
        fs = [f for f in fs if not f.startswith(("no website", "the website"))]   # they have one: we read it
    read_on = None
    if details:
        cache = STATE / "details" / f"{c['place_id']}.json"
        read_on = (dt.datetime.fromtimestamp(cache.stat().st_mtime, TZ).date().isoformat()
                   if cache.exists() else today.isoformat())
    items = [i for i in (listing_fault_item(f, c, read_on) for f in fs) if i]
    # One low review among hundreds says nothing about the business, and naming it to them reads as a dare.
    n_rev = ((details or {}).get("userRatingCount") if details else None) or c.get("reviews") or 0
    return [i for i in items if not (i["key"] == "low_review" and n_rev > LOW_REVIEW_MAX_REVIEWS)]


def facts_packet(c, details, today, on=CHECK_FAULTS_PROVEN):
    """Every fault true of this business, most specific and surest first: [{key, sentence, evidence}]. One per key.
    `on` is the B99 faults that may be said (the proven list; `--stats` widens it to count the waiting ones)."""
    items, seen = [], set()
    checked = [i for i in check_fault_items(c, today) if i["key"] in on]
    for it in sorted(checked + site_fault_items(c, today) + listing_fault_items(c, details, today),
                     key=lambda i: FAULT_RANK.get(i["key"], 90)):
        if it["key"] in seen:
            continue
        seen.add(it["key"])
        items.append(it)
    return items


def fact_items(c, today):
    """Plain true facts about them, worth saying to an owner (B90, Flint 2026-10-01: the research is two true
    specifics, at least one a fault). Their Google standing from the census row, said so it stays true if they've
    gained reviews since ("more than 60", rounded down to a ten below the count) and only when it is a compliment and
    the read is under FACT_MAX_AGE_DAYS old. Never a judgement, never a number we didn't read."""
    out = []
    n, r = c.get("reviews"), c.get("rating")
    try:
        read = dt.date.fromisoformat((c.get("refreshed_at") or "")[:10])
    except ValueError:
        read = None
    if n and r and read and (today - read).days <= FACT_MAX_AGE_DAYS and n >= FACT_MIN_REVIEWS \
            and float(r) >= FACT_MIN_RATING:
        floor = (int(n) - 1) // 10 * 10
        out.append({"key": "google_standing", "kind": "fact",
                    "sentence": f"you have more than {floor:,} Google reviews, averaging {float(r):.1f} stars",
                    "evidence": clean_maps(c.get("google_maps_uri")) + f" (census read {read.isoformat()}: "
                                                                       f"{n} reviews, {r})"})
    return out


def specifics(c, today, faults_):
    """The two things a letter says: two faults, or one fault and one fact; [] when there aren't two (no fault at
    all, or one fault and nothing true to say beside it)."""
    fs = [dict(f, kind="fault") for f in faults_]
    if len(fs) >= 2:
        return fs[:2]
    if fs:
        facts = fact_items(c, today)
        if facts:
            return [fs[0], facts[0]]
    return []


def client_marks():
    """What identifies a paying client (or a gift one): every address, domain and ten-digit phone in each
    clients/<slug>/NOTES.md and CLAUDE.md. The workspaces carry no place id, so these are the match."""
    emails, domains, phones = set(), set(), set()
    if CLIENTS_DIR.exists():
        for ws in CLIENTS_DIR.iterdir():
            for name in ("NOTES.md", "CLAUDE.md"):
                p = ws / name
                try:
                    text = p.read_text(errors="replace") if p.is_file() else ""
                except OSError:
                    continue
                for a in re.findall(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}", text):
                    a = a.lower()
                    emails.add(a)
                    dom = a.split("@", 1)[1]
                    if dom not in FREE_MAIL and dom != "patchlamp.com":
                        domains.add(dom)
                for u in re.findall(r"https?://([A-Za-z0-9.-]+\.[A-Za-z]{2,})", text):
                    u = u.lower().removeprefix("www.")
                    if not u.endswith(("patchlamp.com", "pages.dev", "github.com", "google.com", "stripe.com")):
                        domains.add(u)
                for a, b, cc in re.findall(r"\(?(\d{3})\)?[\s.\-]?(\d{3})[\s.\-](\d{4})", text):
                    phones.add(a + b + cc)
    return emails, domains, phones


def suppressed():
    """(values lowercased, where from) — or (None, why) when the list can't be read. `outreach suppress ls --json` is
    the one source (plan 37 § Contract: [{value, kind: address|domain|place_id}]); a batch made without knowing who
    said no could write to them again, so a missing or failing command is a refusal upstream, never an empty set."""
    vals = set()
    try:
        r = subprocess.run([str(OUTREACH_BIN), "suppress", "ls", "--json"], capture_output=True, text=True, timeout=30)
        if r.returncode == 0:
            data = json.loads(r.stdout or "null")
            if isinstance(data, dict):
                data = data.get("suppressed") or (data.get("addresses") or []) + (data.get("domains") or []) + \
                    (data.get("place_ids") or [])
            if isinstance(data, list):
                for x in data:
                    v = x.get("value") if isinstance(x, dict) else x
                    if v:
                        vals.add(str(v).strip().lower())
                return vals, "outreach suppress ls --json"
            why = "its output isn't a list"
        else:
            why = ((r.stderr or r.stdout or "").strip().splitlines()[-1:] or [f"exit {r.returncode}"])[0][:120]
    except (OSError, subprocess.SubprocessError, ValueError) as exc:
        why = f"{type(exc).__name__}: {exc}"[:120]
    return None, f"`{OUTREACH_BIN} suppress ls --json` failed ({why})"


def is_suppressed(c, supp):
    addr = (c["mail"]["address"] or "").lower()
    dom = addr.split("@", 1)[-1]
    site = host_of(c.get("website") or "")
    return bool(supp & {addr, dom, "@" + dom, (c.get("place_id") or "").lower()}) or bool(site and site in supp)


def batches_log():
    p = STATE / "batches.jsonl"
    out = []
    if p.exists():
        for line in p.read_text().splitlines():
            try:
                out.append(json.loads(line))
            except ValueError:
                continue
    return out


def batch_exclusions():
    """place_id -> why, for everything a batch must never offer, plus the addresses already batched or in the
    pipeline (a business can sit under two listings with one inbox). Never raises on a missing file."""
    why = {pid: "held (a kit or a batch in the last 56 days)" for pid in contacted()}
    pipe_mail = set()
    try:
        for lead in pipeline_state().values():
            if lead.get("place_id"):
                why.setdefault(lead["place_id"], "in the pipeline")
            if lead.get("email"):
                pipe_mail.add(lead["email"].lower())
    except (OSError, KeyError):
        pass
    for pid in claimed_places():
        why.setdefault(pid, "a client (claimed their preview)")
    ids, names = _chains()
    for pid in ids:
        why.setdefault(pid, "a chain")
    batched = {(a or "").lower() for b in batches_log() for a in (b.get("emails") or [])}
    for pid in shared_site_places():
        why.setdefault(pid, f"a chain by its website ({CHAIN_SITE_LISTINGS}+ listings share it)")
    return why, names, pipe_mail | batched


def shared_site_places():
    """Place ids whose website domain is on CHAIN_SITE_LISTINGS or more listings in the census: franchises
    (Hotworx, Kid to Kid, Deseret Book) and multi-site organisations the name filter misses."""
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    try:
        rows = conn.execute("SELECT place_id, website FROM place_cache WHERE COALESCE(website, '') != ''").fetchall()
    finally:
        conn.close()
    by = {}
    for pid, w in rows:
        h = host_of(w).split(":")[0]
        if h:
            by.setdefault(h, []).append(pid)
    return {pid for h, ids in by.items() if len(ids) >= CHAIN_SITE_LISTINGS for pid in ids}


def batch_pool(segments, today, live=False, places=None, want=None):
    """(eligible picks with their packets, skipped counts, live reads made). `want(c)` narrows the rows a live read
    may be spent on (the chosen trade and city)."""
    rows = batch_rows(segments)
    why, chain_names_, mail_seen = batch_exclusions()
    supp, src = suppressed()
    if supp is None:
        die(f"no batch: the suppression list can't be read, and a batch made without it could write to someone who "
            f"said no. {src}. `outreach doctor` says why; `leads batch --stats` still works.")
    c_emails, c_domains, c_phones = client_marks()
    cache_only = Places(None, None)
    skipped, out, run_seen = {}, [], set()

    def skip(w):
        skipped[w] = skipped.get(w, 0) + 1
    for c in sorted(rows, key=lambda r: (r["mail"]["kind"] != "own-domain", -(r.get("reviews") or 0), r["name"] or "")):
        addr = c["mail"]["address"].lower()
        if c["place_id"] in why:
            skip(why[c["place_id"]])
            continue
        if (c.get("name") or "").lower() in chain_names_:
            skip("a chain")
            continue
        if addr in mail_seen:
            skip("address already batched or in the pipeline")
            continue
        if addr in run_seen:
            skip("the same address as another listing (one inbox, written to once)")
            continue
        if is_suppressed(c, supp):
            skip("suppressed")
            continue
        dom = addr.split("@", 1)[1]
        if addr in c_emails or dom in c_domains or host_of(c.get("website") or "") in c_domains or \
                re.sub(r"\D", "", c.get("phone") or "")[-10:] in c_phones:
            skip("a client")
            continue
        run_seen.add(addr)             # two listings, one inbox: the first one only
        details = places.get(c["place_id"]) if places and places.fixture else cache_only.get(c["place_id"])
        c["all_faults"] = facts_packet(c, details, today)
        c["packet"] = specifics(c, today, c["all_faults"])
        if len(c["all_faults"]) == 1 and not c["packet"] and live and places and not places.fixture \
                and details is None and (want is None or want(c)):
            details = places.get(c["place_id"])
            if details and details.get("businessStatus") not in (None, "OPERATIONAL"):
                skip("closed on Google")
                continue
            c["all_faults"] = facts_packet(c, details, today)
            c["packet"] = specifics(c, today, c["all_faults"])
        if not c["all_faults"]:
            skip("no fault to name")
            continue
        if not c["packet"]:
            skip("one fault and nothing else true to say")
            continue
        out.append(c)
    return out, skipped


def live_reads_today(today):
    """Listing reads `leads batch` has made today, from the ledger (the cap's count)."""
    n = 0
    try:
        for line in LEDGER.read_text().splitlines():
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if e.get("tool") == "leads" and e.get("kind") == "places_details" and \
                    str(e.get("for") or "").startswith(f"batch {today.isoformat()}"):
                n += int(e.get("calls") or 0)
    except OSError:
        pass
    return n


class CappedPlaces(Places):
    """Places with a daily ceiling: past it, a read returns None and the business is judged on what is stored."""

    def __init__(self, key, where, cap, fixture=None):
        super().__init__(key, where, fixture=fixture)
        self.cap = cap

    def get(self, place_id):
        if not self.fixture and self.calls >= self.cap:
            cache = STATE / "details" / f"{place_id}.json"
            if not (cache.exists() and time.time() - cache.stat().st_mtime < CACHE_DAYS * 86400):
                self.capped = True
                return None
        return super().get(place_id)


def town_match(c, city):
    """The listing's own locality when it has one (the scan's search city only when it hasn't): Saratoga Springs
    found by the Lehi search is Saratoga Springs."""
    w = (city or "").strip().lower()
    return not w or (c.get("town") or "").lower() == w


def pick_json(c):
    two = c["packet"][:2]
    return {"place_id": c["place_id"], "name": clean_name(c["name"]), "category": c.get("category") or "",
            "segment": c.get("segment") or "", "city": c.get("town") or "", "phone": c.get("phone") or "",
            "site_url": strip_tracking((c.get("facts") or {}).get("url") or c.get("website") or ""),
            "maps_url": clean_maps(c.get("google_maps_uri")), "rating": c.get("rating"), "reviews": c.get("reviews"),
            "email": c["mail"]["address"], "email_kind": c["mail"]["kind"],
            # B104: how sure the census is the address is this place's (only `high` is ever picked; outreach checks)
            "email_confidence": c["mail"].get("confidence"), "email_place": c["mail"].get("place"),
            "email_evidence": c["mail"].get("evidence_url") or "", "email_why": c["mail"].get("why") or "",
            "faults": [{"key": f["key"], "kind": f["kind"], "sentence": f["sentence"], "evidence": f["evidence"]}
                       for f in two]}


def batch_page(b, notes):
    lines = [f"Batch {b['batch_id']} · {b['category']} · {b['city']} · {len(b['picks'])} "
             f"business{'es' if len(b['picks']) != 1 else ''}, two true specifics each (a fault first)"]
    lines += [f"({n})" for n in notes if n]
    lines.append("")
    for i, p in enumerate(b["picks"], 1):
        lines.append(f"{i}. {p['name']} — {p['faults'][0]['sentence']}; {p['faults'][1]['sentence']}")
    lines.append("")
    lines.append("Addresses, evidence and the JSON: `leads batch --last --json`. "
                 "Approve with `go` (outreach send --batch); `hold 4` keeps one back.")
    return "\n".join(lines) + "\n"


def cmd_batch(args):
    today = now_date()
    if args.last:
        logs = batches_log()
        if not logs:
            die("no batch yet; run `leads batch`")
        bid = logs[-1]["batch_id"]
        f = STATE / "batches" / (f"{bid}.json" if args.json else f"{bid}.md")
        if not f.exists():
            die(f"{f} is gone")
        print(f.read_text(), end="")
        return
    if not email_tables():
        die("no address pass yet — the census has no `emails`/`site_facts` tables (B89, client-leads/scripts/emails.py)")
    if args.stats:
        return batch_stats(args, today)
    seg = (args.segment or "services").lower()
    if seg not in SEGMENTS:
        die(f"--segment is one of {', '.join(SEGMENTS)}")
    n = max(1, min(args.n, BATCH_MAX))
    places, notes = None, []
    if args.fixture:
        places = Places(None, None, fixture=args.fixture)
    elif args.live:
        key, where = places_key()
        cap = int(os.environ.get("LEADS_LIVE_READS_PER_DAY") or _env_file(ENV_FILE).get("LEADS_LIVE_READS_PER_DAY")
                  or BATCH_LIVE_CAP_DEFAULT)
        left = max(0, cap - live_reads_today(today))
        if not key:
            notes.append("--live: no GOOGLE_MAPS_API_KEY, so stored facts only")
        elif not left:
            notes.append(f"--live: today's {cap} listing reads are spent (LEADS_LIVE_READS_PER_DAY), stored facts only")
        else:
            places = CappedPlaces(key, where, left)
    # `any` widens one axis on purpose (a trade across every city, or every trade in a city): the research's
    # 6.2% reply rate is for one trade in one city, so the default stays that, and `any` is Taylor's call.
    city = None if (args.city or "").lower() == "any" else args.city
    category = None if (args.category or "").lower() == "any" else args.category

    def want(c):
        return town_match(c, city) and (not category or (c.get("category") or "").lower() == category.lower())
    picks, skipped = batch_pool([seg], today, live=bool(places), places=places,
                                want=want if (city or category) else None)
    if places and places.calls and not places.fixture:
        ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
                       "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
                       "billed_to": f"google:GOOGLE_MAPS_API_KEY({places.where})", "project": "global",
                       "for": f"batch {today.isoformat()} {seg}"})
    if places and getattr(places, "capped", False):
        notes.append(f"the daily cap on listing reads stopped the live reads after {places.calls}")
    picks = [c for c in picks if want(c)]
    if not picks:
        die(f"no {seg} business{' in ' + args.city if args.city else ''}"
            f"{' (' + args.category + ')' if args.category else ''} with an address and two true specifics is left "
            f"({', '.join(f'{v} {k}' for k, v in sorted(skipped.items(), key=lambda kv: -kv[1])) or 'none with an address'})")
    groups = {}
    # One trade across the corridor (Flint 2026-10-01: the research is about the batch size and the specifics, not
    # the city); --city narrows to one, --category any mixes trades.
    any_cat = (args.category or "").lower() == "any"
    for c in picks:
        groups.setdefault(((c.get("town") or "?") if city else "corridor",
                           "any" if any_cat else (c.get("category") or "?")), []).append(c)
    (town, cat), group = max(groups.items(), key=lambda kv: (len(kv[1]), kv[0][0] != "?"))
    chosen, second_look = [], 0
    for c in group:                     # the stored facts, read again from the page before a letter says them
        if len(chosen) >= n:
            break
        if confirm_packet(c, today):
            chosen.append(c)
        else:
            second_look += 1
    if not chosen:
        die(f"no {seg} {cat} is left once the pages are read again ({second_look} of them no longer bear the fault "
            f"out; also {', '.join(f'{v} {k}' for k, v in sorted(skipped.items(), key=lambda kv: -kv[1])) or 'nothing else'}"
            f"); try another --category")
    prefix = f"{today.isoformat()}-{seg}-{slugify(town)}-{slugify(cat)}"
    seq = 1 + sum(1 for b in batches_log() if str(b.get("batch_id") or "").startswith(prefix + "-"))
    bid = f"{prefix}-{seq}"
    b = {"batch_id": bid, "date": today.isoformat(), "segment": seg, "category": cat, "city": town,
         "picks": [pick_json(c) for c in chosen]}
    mode = "fixture listings (a test)" if args.fixture else (
        f"{places.calls} listing{'s' if places.calls != 1 else ''} read live" if places else
        "stored site facts, listings read in the last week, the census's Google standing; no live reads")
    notes.insert(0, mode)
    others = sorted(((len(v), k) for k, v in groups.items() if k != (town, cat)), reverse=True)[:3]
    if others:
        notes.append("next biggest: " + ", ".join(f"{k[1]}" + (f" in {k[0]}" if city else "") + f" ({m})"
                                                  for m, k in others))
    if second_look:
        notes.append(f"{second_look} left out on a second look: the site no longer bears a stored fault out (the "
                     f"copyright year read again, or a link, an image or the secure address asked again)")
    left_out = {k: v for k, v in skipped.items()}
    if left_out:
        notes.append("left out: " + ", ".join(f"{v} {k}" for k, v in sorted(left_out.items(), key=lambda kv: -kv[1])))
    held = [u for u in BATCH_UNCONFIRMED if want(u)]
    if held:
        notes.append(f"call-only, address unconfirmed ({len(held)}): "
                     + "; ".join(f"{u['name']} {u['address']} ({u['why']})" for u in held[:5])
                     + (" …" if len(held) > 5 else ""))
    page = batch_page(b, notes)
    if not args.no_save:
        (STATE / "batches").mkdir(parents=True, exist_ok=True)
        (STATE / "batches" / f"{bid}.json").write_text(json.dumps(b, indent=1, ensure_ascii=False) + "\n")
        (STATE / "batches" / f"{bid}.md").write_text(page)
        with open(STATE / "batches.jsonl", "a") as f:     # the hold: contacted() reads this beside the kits' logs
            f.write(json.dumps({"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "for": today.isoformat(),
                                "batch_id": bid, "segment": seg, "category": cat, "city": town,
                                "place_ids": [p["place_id"] for p in b["picks"]],
                                "names": [p["name"] for p in b["picks"]],
                                "emails": [p["email"] for p in b["picks"]], "mode": "batch"}) + "\n")
    if args.json:
        print(json.dumps(b, indent=1, ensure_ascii=False))
        return
    print(page, end="")
    if not args.no_save:
        print(f"(saved: {STATE / 'batches' / (bid + '.json')}; these {len(b['picks'])} are held out of the kits and "
              f"later batches for 56 days)")


def batch_stats(args, today):
    """How big the lane really is under the rule (two true specifics, at least one a fault), beside the old rule
    (two faults): by segment, by trade across the corridor, by city, and how often each fault and fact is true.
    Stored facts and the week's cached listings only; it spends nothing and holds nothing."""
    segs = [args.segment] if args.segment else list(BUSINESS_SEGMENTS) + ["restaurant"]
    rows = batch_rows(segs)
    why, chain_names_, _ = batch_exclusions()
    supp, supp_src = suppressed()
    c_emails, c_domains, c_phones = client_marks()
    cache_only = Places(None, None)
    by_seg, by_city, by_trade, keys, excl = {}, {}, {}, {}, {}
    total = qual = two = faulted = checked_rows = 0
    waiting = {}
    seen_mail = set()
    for c in rows:
        reason = why.get(c["place_id"]) or ("a chain" if (c.get("name") or "").lower() in chain_names_ else None)
        addr = c["mail"]["address"].lower()
        if not reason and addr in seen_mail:
            reason = "the same address as another listing"
        if not reason and supp and is_suppressed(c, supp):
            reason = "suppressed"
        if not reason and (addr in c_emails or addr.split("@")[-1] in c_domains
                           or host_of(c.get("website") or "") in c_domains
                           or re.sub(r"\D", "", c.get("phone") or "")[-10:] in c_phones):
            reason = "a client"
        seen_mail.add(addr)
        det = cache_only.get(c["place_id"])
        fs = facts_packet(c, det, today)
        sp = specifics(c, today, fs)
        total += 1
        faulted += bool(fs)
        s = by_seg.setdefault(c["segment"], [0, 0, 0, 0])      # with an address, qualify, two faults, excluded
        s[0] += 1
        everything = facts_packet(c, det, today, on=CHECK_FAULTS_PROVEN + CHECK_FAULTS_WAITING)
        for it in everything + fact_items(c, today):
            keys[it["key"]] = keys.get(it["key"], 0) + 1
        if c.get("checks"):
            checked_rows += 1
        if not reason and not sp:
            for k in CHECK_FAULTS_WAITING:      # how many each waiting fault would add, switched on alone
                if any(i["key"] == k for i in everything) and \
                        specifics(c, today, facts_packet(c, det, today, on=CHECK_FAULTS_PROVEN + (k,))):
                    waiting[k] = waiting.get(k, 0) + 1
        if not sp:
            continue
        if reason:
            s[3] += 1
            excl[reason.split(" (")[0]] = excl.get(reason.split(" (")[0], 0) + 1
            continue
        qual += 1
        s[1] += 1
        if len(fs) >= 2:
            two += 1
            s[2] += 1
        by_city[c["town"] or "?"] = by_city.get(c["town"] or "?", 0) + 1
        t = (c["segment"], c.get("category") or "?")
        by_trade[t] = by_trade.get(t, 0) + 1
    trades = sorted(by_trade.items(), key=lambda kv: -kv[1])
    if args.json:
        print(json.dumps({"date": today.isoformat(), "with_address": total, "with_a_fault": faulted,
                          "qualify": qual, "two_faults": two, "suppression": supp_src if supp is not None else None,
                          "by_segment": {k: {"with_address": v[0], "qualify": v[1], "two_faults": v[2],
                                             "excluded": v[3]} for k, v in by_seg.items()},
                          "excluded": excl, "by_city": by_city, "keys": keys,
                          "site_checks": checked_rows, "faults_on": list(CHECK_FAULTS_PROVEN),
                          "waiting": {k: {"true_of": keys.get(k, 0), "would_add": waiting.get(k, 0)}
                                      for k in CHECK_FAULTS_WAITING},
                          "trades": [{"segment": t[0], "category": t[1], "n": n} for t, n in trades]}, indent=1))
        return
    print(f"Email lane, {today}: {total} businesses with a usable address (MX ok, not tied by the page title alone), "
          f"{faulted} with at least one fault before the exclusions. {qual} qualify (two true specifics, at least one a fault, after the exclusions); {two} of them with two "
          f"faults. Stored site facts, listings cached this week and the census's Google standing (read within "
          f"{FACT_MAX_AGE_DAYS} days); nothing read live.")
    if supp is None:
        print(f"  (suppressed addresses not subtracted: {supp_src}; `leads batch` itself refuses until it reads)")
    for seg, v in sorted(by_seg.items(), key=lambda kv: -kv[1][0]):
        print(f"  {seg:<11} {v[0]:>5} with an address · {v[1]:>4} qualify · {v[2]:>3} with two faults · "
              f"{v[3]} more would qualify but are excluded")
    if excl:
        print("Excluded although they'd qualify: " + ", ".join(f"{v} {k}" for k, v in sorted(excl.items(), key=lambda kv: -kv[1])))
    print("Batches by trade, across the corridor (top 15): " + ", ".join(f"{t[1]} ({t[0]}) {n}" for t, n in trades[:15]))
    print("By city: " + ", ".join(f"{k} {v}" for k, v in sorted(by_city.items(), key=lambda kv: -kv[1])[:15]))
    print("True of how many (faults and facts, before exclusions): " + ", ".join(
        f"{k} {v}" + (" (waiting)" if k in CHECK_FAULTS_WAITING else "")
        for k, v in sorted(keys.items(), key=lambda kv: -kv[1])))
    print(f"Site checks (B99): {checked_rows} of these {total} have a `site_checks` row; said: "
          f"{', '.join(CHECK_FAULTS_PROVEN)} (stored within {SITE_CHECK_MAX_DAYS} days, asked again at batch time). "
          "Waiting on thirty spot checks, never said: " + ", ".join(
              f"{k} true of {keys.get(k, 0)}, would add {waiting.get(k, 0)}" for k in CHECK_FAULTS_WAITING) + ".")


def latest(folder):
    """The newest page in a kits folder (restaurant pages are <date>.md, the others <date>-<segment>.md)."""
    pages = list(folder.glob("*.md")) if folder.exists() else []
    return max(pages, key=lambda p: (p.stat().st_mtime, p.name)) if pages else None


def cmd_kit(args):
    if args.last:
        page = latest(STATE / ("remote" if args.remote else "kits"))
        if not page:
            die("no remote kit yet; run `leads kit --remote`" if args.remote else "no kit yet; run `leads kit`")
        print(page.read_text(), end="")
        return
    segment = resolve_segment(args.segment)
    if args.remote:
        if args.radius == 10.0:
            args.radius = 30.0
        if segment == "restaurant":
            if args.min_reviews is None:
                args.min_reviews = 25
            page, picks = build_remote(args)
        else:
            page, picks = build_segment_remote(args, segment)
        if args.json:
            print(json.dumps(kit_json(picks, segment, now_date()), indent=1, default=str))
            return
        print(page, end="")
        return
    if segment == "restaurant":
        if args.min_reviews is None:
            args.min_reviews = 25
        page, order = build_kit(args)
    else:
        page, order = build_segment_kit(args, segment)
    if args.json:
        print(json.dumps([{k: v for k, v in p.items() if k != "details"} for p in order], indent=1, default=str))
        return
    print(page, end="")


def cmd_candidates(args):
    segment = resolve_segment(args.segment)
    if segment == "restaurant" and args.radius is None:
        args.radius = 10.0          # the paying sort (B71) reads the services census's `hosts`, not restaurants
    if segment == "restaurant":
        if args.min_reviews is None:
            args.min_reviews = 25
        return restaurant_candidates(args)
    cands = candidates_for(segment, args.min_reviews)
    skip = recently_kitted(dt.datetime.now(TZ).date())
    floor = SEGMENT_MIN_REVIEWS if args.min_reviews is None else args.min_reviews
    radius = args.radius if args.radius is not None else (float("inf") if args.paying else 10.0)
    if args.paying:
        if hosts_table() is None:
            print("No host fingerprint yet — run client-leads/scripts/hosts.py (B71); nothing to sort by.")
            return
        cands = paying_order(cands)
        print(f"{len(cands)} {SEGMENT_NOUN[segment]} whose website link is on a platform someone pays for — "
              f"agency-hosted and dead or parked first, then the other dead ones, then the live ones; the band is the "
              f"vendor's public price (client-leads/vendor_prices.md), never their bill")
    else:
        cands.sort(key=strength_order)                                   # B73: strong first, nearest within
        print(f"{len(cands)} {SEGMENT_NOUN[segment]} with a phone, ≥{floor} reviews and no site of their own "
              f"(none, page, directory, dead, builder); strong first, then good, then weak, nearest within each "
              f"(census {census_stamp(cands)})")
    shown = 0
    for c in cands:
        if shown >= args.n:
            break
        if c["miles"] > radius:
            continue
        tag = f"  (kitted {skip[c['place_id']]})" if c["place_id"] in skip else ""
        if is_business(c):
            what = f"{c.get('category')} · {c.get('presence')}: {presence_short(c['presence'], c['presence_label'], c['presence_link'])}"
        else:
            what = f"restaurant · on {platforms(c)}"
        ht = host_tag(c)
        lt = language_tag(c)
        print(f"  {strength_tag(c, skip=('near',))} │", end="")              # B73: the level and why, first
        print(f"  {c['miles']:>4} mi  {c['name']} · {c.get('locality') or ''} · {c['rating']}★ ({c['reviews']}) · {what}"
              f"{' · ' + ht if ht else ''}{' · ' + lt if lt else ''}{tag}")
        shown += 1


def paying_order(cands):
    """The paying-for-dead sort (B71): only rows whose link is on a platform somebody pays for (not unknown, not a
    free page), agency-hosted dead or parked first, then a priced builder that's dead, then any other dead one,
    then the live agency sites, then the rest; nearest first within each."""
    out = []
    for c in cands:
        hi = host_info(c.get("place_id"))
        if not hi or hi["vendor"] == "unknown" or hi["kind"] in HOST_FREE_KINDS:
            continue
        dead, agency, priced = host_dead(hi), hi["kind"] == "agency", hi["from"] is not None
        tier = (0 if dead and agency else 1 if dead and priced else 2 if dead else 3 if agency else 4)
        out.append((tier, c["miles"], c))
    return [c for _, _, c in sorted(out, key=lambda t: (t[0], t[1]))]


def restaurant_candidates(args):
    cands = census_candidates(args.min_reviews)
    for_date = next_saturday()
    skip = recently_kitted(for_date)
    print(f"{len(cands)} marketplace-only independents with a phone and ≥{args.min_reviews} reviews; nearest first (census {census_stamp(cands)})")
    shown = 0
    for c in cands:
        if c["miles"] > args.radius:
            break
        if shown >= args.n:
            break
        tag = f"  (kitted {skip[c['place_id']]})" if c["place_id"] in skip else ""
        web = "no site" if (c.get("has_website") or "").lower() != "yes" else (marketplace_link(c["website"]) or host_of(c["website"]))
        lt = language_tag(c)
        print(f"  {c['miles']:>4} mi  {c['name']} · {c['locality']} · {c['rating']}★ ({c['reviews']}) · {web} · on {platforms(c)}"
              f"{' · ' + lt if lt else ''}{tag}")
        shown += 1


def cmd_doctor(args):
    ok = True
    print(f"census: {CENSUS} {'ok' if CENSUS.exists() else 'MISSING'}")
    if CENSUS.exists():
        cands = census_candidates(25)
        print(f"  {len(cands)} marketplace-only independents (phone, ≥25 reviews); {sum(c['miles'] <= 10 for c in cands)} within 10 mi of home; census {census_stamp(cands)}")
    else:
        ok = False
    if CENSUS.exists():
        exists, counts = businesses_state()
        if not exists:
            print("services census: not yet — no `businesses` table (B43's scan, client-leads/scripts/scan_services.py); "
                  "the kits run on restaurants until it lands")
        else:
            conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
            classes = conn.execute("SELECT COALESCE(presence_class, 'unknown'), count(*) FROM businesses GROUP BY 1 ORDER BY 2 DESC").fetchall()
            conn.close()
            print(f"services census: {sum(counts.values())} rows"
                  + (" (" + ", ".join(f"{k} {v}" for k, v in sorted(counts.items())) + ")" if counts else " — empty, the scan hasn't written yet"))
            if classes:
                print("  presence: " + ", ".join(f"{k} {v}" for k, v in classes))
            for seg in BUSINESS_SEGMENTS:
                if counts.get(seg):
                    pool = business_candidates([seg])
                    print(f"  {seg}: {len(pool)} in the kit's pool (phone, ≥{SEGMENT_MIN_REVIEWS} reviews, no site of their own); "
                          f"{sum(c['miles'] <= 10 for c in pool)} within 10 mi")
        table = reach_table()
        if table is None:
            print("reach: no reach table yet — B61 (client-leads/scripts/reach.py) hasn't run; the kit's picks "
                  "carry only what the census's own columns hold")
        else:
            ig = sum(1 for r in table.values() if r["instagram"])
            fb = sum(1 for r in table.values() if r["facebook"])
            em = sum(1 for r in table.values() if r["email"])
            print(f"reach: {len(table)} rows searched — {ig} Instagram, {fb} Facebook, {em} email"
                  + (f"; newest check {max((r['checked'] or '')[:10] for r in table.values())}" if table else ""))
            # B104: what the readers will actually use — a column value with no judgement yet reads as low
            conf = {}
            for pid in table:
                for f, j in reach_judgement(pid).items():
                    conf[j["confidence"]] = conf.get(j["confidence"], 0) + 1
            unchecked = sum(1 for pid, r in table.items()
                            for f in REACH_FIELDS if r.get(f) and reach_judgement(pid).get(f, {}).get("why") == UNCHECKED_WHY)
            print("reach judged (B104): " + (", ".join(f"{conf.get(k, 0)} {k}" for k in ("high", "unsure", "low", "rejected")))
                  + (f"; {unchecked} column value(s) not checked against the place yet — run reach.py --check --all"
                     if unchecked else ""))
        rp = reach_py()
        print(f"reach script: {rp}" + (" (LEADS_REACH_PY)" if os.environ.get("LEADS_REACH_PY") else "")
              + ("" if rp.exists() else " — missing: `leads recheck` and prep's verdicts can't run")
              + ("; place_evidence importable" if rp.exists() and reach_module() else
                 "; place_evidence not importable (research's 'theirs' promotes nothing)" if rp.exists() else ""))
        ht = hosts_table()
        if ht is None:
            print("hosts: no hosts table yet — B71 (client-leads/scripts/hosts.py) hasn't run; no vendor on the lines")
        else:
            vs = {}
            for r in ht.values():
                vs[r.get("vendor") or "?"] = vs.get(r.get("vendor") or "?", 0) + 1
            top = ", ".join(f"{v} {n}" for v, n in sorted(vs.items(), key=lambda kv: -kv[1])[:6])
            print(f"hosts: {len(ht)} links fingerprinted ({top}); newest check "
                  f"{max((r.get('checked') or '')[:10] for r in ht.values()) if ht else '-'}; "
                  f"prices: {len(vendor_prices())} vendors in {VENDOR_PRICES}"
                  + ("" if VENDOR_PRICES.exists() else " — MISSING, so no band is printed"))
        if exists and counts.get("services"):          # B73
            lv = {}
            for c in business_candidates(["services"]):
                s = strength(c)[0]
                lv[s] = lv.get(s, 0) + 1
            print(f"strength (services pool): " + ", ".join(f"{lv.get(s, 0)} {s}" for s in STRENGTHS)
                  + f"; weights from {STRENGTH_DOC}" + ("" if STRENGTH_DOC.exists() else " — missing, so the defaults"))
        lt = language_table()
        if lt is None:
            print("language: no language table yet — B74 (client-leads/scripts/language.py) hasn't run; no tag on the lines")
        else:
            by = {}
            for r in lt.values():
                by[r.get("language") or "?"] = by.get(r.get("language") or "?", 0) + 1
            print(f"language: {len(lt)} rows judged — " + ", ".join(f"{k} {by.get(k, 0)}" for k in ("es", "both", "en", "unknown"))
                  + f"; newest check {max((r.get('checked') or '')[:10] for r in lt.values()) if lt else '-'}")
        print(f"default segment: {default_segment()}" + (" (LEADS_SEGMENT)" if os.environ.get("LEADS_SEGMENT") else
                                                       f" (services once the services census has {DEFAULT_POOL_MIN} in the kit's pool, else restaurant)"))
    key, where = places_key()
    if key:
        print(f"GOOGLE_MAPS_API_KEY: set ({where})")
        # Place Details with an IDs-only mask is the free SKU: an auth check that costs nothing.
        req = urllib.request.Request(DETAILS_URL + "ChIJN1t_tDeuEmsRUsoyG83frY4", headers={
            "X-Goog-Api-Key": key, "X-Goog-FieldMask": "id", "User-Agent": "claude-tools/leads"})
        try:
            with urllib.request.urlopen(req, timeout=15) as resp:
                json.loads(resp.read().decode())
            print("  Places API (New): ok")
        except urllib.error.HTTPError as exc:
            print(f"  Places API (New): FAIL {exc.code} — {exc.read().decode(errors='replace')[:200].strip()}")
            ok = False
        except (urllib.error.URLError, OSError) as exc:
            print(f"  Places API (New): unreachable ({exc})")
            ok = False
    else:
        print("GOOGLE_MAPS_API_KEY: not set — census-only kits until `setenv.sh GOOGLE_MAPS_API_KEY` (TAYLOR-TODO §1)")
        ok = False
    lat, lng = home()
    print(f"home: {lat},{lng}{' (LEADS_HOME)' if os.environ.get('LEADS_HOME') else ' (American Fork)'}")
    kits = kits_log()
    print(f"state: {STATE}  kits sent: {len(kits)}" + (f", last for {kits[-1]['for']}" if kits else ""))
    cached = len(list((STATE / "details").glob("*.json"))) if (STATE / "details").exists() else 0
    print(f"  cached listings: {cached}  ledger: {LEDGER}")
    print(f"next Saturday: {next_saturday()}")
    print(f"remote lane: {GROUPS_LOG} {'exists' if GROUPS_LOG.exists() else '(created on first lead)'}; "
          f"postal address for cold email: {'set' if mail_address() else 'NOT set — drafts say not ready (TAYLOR-TODO §1)'}")
    ok = preview_doctor() and ok
    batch_doctor()
    sys.exit(0 if ok else 1)


def batch_doctor():
    """The email batch's half (B90). Informational: the lane is off until the identity hour, so nothing here fails
    the doctor."""
    if not email_tables():
        print("batch: no address pass yet — no `emails`/`site_facts` tables (B89, client-leads/scripts/emails.py); "
              "`leads batch` waits on it")
        return
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    try:
        n_addr = conn.execute("SELECT count(DISTINCT place_id) FROM emails WHERE mx='ok'").fetchone()[0]
        n_facts = conn.execute("SELECT count(*) FROM site_facts").fetchone()[0]
    finally:
        conn.close()
    print(f"batch: {n_addr} businesses with an MX-ok address, {n_facts} sites with stored facts "
          f"(`leads batch --stats` sizes the lane)")
    supp, src = suppressed()
    print(f"  suppression: {len(supp)} from {src}" if supp is not None else
          f"  suppression: unreadable, so `leads batch` refuses — {src}")
    em, dm, ph = client_marks()
    print(f"  clients kept out: {len(em)} addresses, {len(dm)} domains, {len(ph)} phones from {CLIENTS_DIR}/*/NOTES.md, CLAUDE.md")
    logs = batches_log()
    since = (dt.datetime.now(TZ).date() - dt.timedelta(weeks=REPEAT_WEEKS)).isoformat()
    held = {pid for b in logs if (b.get("for") or "") >= since for pid in b.get("place_ids") or []}
    print(f"  batches: {len(logs)} made, {len(held)} businesses held for 56 days"
          + (f"; last {logs[-1]['batch_id']}" if logs else ""))
    cap = int(os.environ.get("LEADS_LIVE_READS_PER_DAY") or _env_file(ENV_FILE).get("LEADS_LIVE_READS_PER_DAY")
              or BATCH_LIVE_CAP_DEFAULT)
    print(f"  live listing reads (--live): {live_reads_today(now_date())} of {cap} today (LEADS_LIVE_READS_PER_DAY)")


def preview_doctor():
    """The previews half (B45): the copy table, the overlay, what's live, what's expiring."""
    ok = True
    print(f"previews: {PREVIEWS}  project {PREVIEW_PROJECT}  host https://{preview_host()}/")
    try:
        table = json.loads(PREVIEW_TABLE.read_text())
        cats = table["categories"]
    except (OSError, ValueError, KeyError) as exc:
        print(f"  copy table: FAIL {PREVIEW_TABLE} ({exc})")
        return False
    missing = sorted({v["template"] for v in cats.values()} - {d.name for d in SITE_TEMPLATES.iterdir() if d.is_dir()})
    print(f"  copy table: {len(cats)} categories -> templates "
          + ", ".join(sorted({v["template"] for v in cats.values()}))
          + (f"  MISSING {', '.join(missing)}" if missing else ""))
    ok = ok and not missing
    for kind in sorted(d.name for d in SITE_TEMPLATES.iterdir() if d.is_dir() and not d.name.startswith("_")):
        if not has_library(kind):
            continue
        lib = SITE_TEMPLATES / kind
        fonts = set()
        for css in (lib / "css" / "looks").glob("*.css"):
            fonts |= set(re.findall(r'url\("\.\./\.\./fonts/([^"]+)"\)', css.read_text()))
        gone = sorted(f for f in fonts if not (lib / "fonts" / f).exists())
        print(f"  library: {kind} — {len(list((lib / 'sections').glob('[a-z]*.html')))} sections, looks "
              f"{', '.join(template_looks(kind))}, {len(fonts)} font files"
              + (f"  MISSING {', '.join(gone)}" if gone else ""))
        ok = ok and not gone
    for f in ("page.html", "root.html", "404.html", "_headers", "robots.txt", "css/preview.css", "claim.html", "bar.html"):
        if not (PREVIEW_OVERLAY / f).exists():
            print(f"  overlay: MISSING templates/sites/_preview/{f}")
            ok = False
    if "noindex" not in (PREVIEW_OVERLAY / "_headers").read_text(errors="replace"):
        print("  overlay: FAIL _headers does not say noindex")
        ok = False
    rows, today = previews_all(), now_date()
    live = [m for m in rows if not m.get("claimed")]
    expired = [m for m in live if dt.date.fromisoformat(m["expires"]) < today]
    soon = [m for m in live if 0 <= (dt.date.fromisoformat(m["expires"]) - today).days <= 5]
    print(f"  built: {len(rows)} ({len(live)} live, {len(rows) - len(live)} claimed); "
          f"{len(expired)} expired (leads preview sweep), {len(soon)} down within 5 days")
    on_disk = {d.name for d in preview_site_dir().iterdir() if d.is_dir() and d.name != "css" and d.name != "js" and d.name != "images"} \
        if preview_site_dir().exists() else set()
    orphan = sorted(on_disk - {m["slug"] for m in rows})
    if orphan:
        print(f"  WARN folders with no manifest (a publish would still serve them): {', '.join(orphan[:6])}")
    row = {}
    try:
        row = json.loads((PREVIEWS / "project.json").read_text())
    except (OSError, ValueError):
        pass
    if row.get("domain"):
        print(f"  domain: {row['domain']} (the link in a message)")
    else:
        print(f"  domain: {PREVIEW_DOMAIN} not attached yet — links use the pages.dev host "
              f"(TAYLOR-TODO §1 \"previews.patchlamp.com\")")
    print(f"  photos: img stock (Pexels, free) by default, {len({r.get('id') for r in image_registry()})} in use "
          f"across previews ({PREVIEW_IMAGES.name}); `--hero gen` costs one image and logs its own ledger row")
    return ok


def main():
    ap = argparse.ArgumentParser(prog="leads", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")

    k = sub.add_parser("kit", help="Saturday's counters, one page")
    k.add_argument("--for", dest="for_date", help="YYYY-MM-DD (default: next Saturday for restaurants, today otherwise)")
    k.add_argument("--n", type=int, default=6)
    k.add_argument("--radius", type=float, default=10.0, help="miles from home (default 10)")
    k.add_argument("--min-reviews", type=int, default=None, help="default 25 for restaurants, 3 for the other segments")
    k.add_argument("--segment", choices=SEGMENTS + ("all",), help="default: services once the services census holds a kit's worth, else restaurant")
    k.add_argument("--census-only", action="store_true", help="no Google calls")
    k.add_argument("--refresh", action="store_true", help="ignore the 7-day listing cache")
    k.add_argument("--allow-repeat", action="store_true", help="don't skip places kitted in the last 8 weeks")
    k.add_argument("--last", action="store_true", help="reprint the last kit")
    k.add_argument("--no-save", action="store_true")
    k.add_argument("--json", action="store_true")
    k.add_argument("--fixture", help="dir of <place_id>.json Place Details (tests)")
    k.add_argument("--remote", action="store_true", help="today's six ready-to-send messages, not Saturday's counters (B25; radius 30)")
    k.add_argument("--previews", action="store_true",
                   help="with --remote: build a preview site for any pick that hasn't got one (B45) and put its "
                        "link in the message")
    k.set_defaults(fn=cmd_kit)

    g = sub.add_parser("diagnose", help="three lines on a business's Google listing, for a group thread")
    g.add_argument("name", nargs="+", help='"Name" or "Name, City"')
    g.add_argument("--group", help="the group the name came from (logged)")
    g.add_argument("--no-log", action="store_true")
    g.add_argument("--live", action="store_true", help="read the Google listing even for a name in the services census")
    g.add_argument("--fixture", help="dir of <place_id>.json Place Details (tests)")
    g.set_defaults(fn=cmd_diagnose)

    c = sub.add_parser("candidates", help="the pool the kit picks from (no spend)")
    c.add_argument("--n", type=int, default=20)
    c.add_argument("--radius", type=float, default=None, help="miles from home (default 10; no limit with --paying)")
    c.add_argument("--min-reviews", type=int, default=None, help="default 25 for restaurants, 3 for the other segments")
    c.add_argument("--segment", choices=SEGMENTS + ("all",))
    c.add_argument("--paying", action="store_true",
                   help="only sites on a platform someone pays for (B71): agency-hosted dead or parked first")
    c.set_defaults(fn=cmd_candidates)

    lg = sub.add_parser("log", help="log a conversation: leads log \"Name[, City]\" OUTCOME [note...]")
    lg.add_argument("name", help='"Name" or "Name, City"', nargs=1)
    lg.add_argument("outcome", help=" | ".join(OUTCOMES))
    lg.add_argument("note", nargs="*")
    lg.add_argument("--next", help="follow-up: tomorrow, fri, 3d, 2w, 2026-10-01, none (default by outcome)")
    lg.add_argument("--who", help="who you talked to")
    lg.add_argument("--email")
    lg.add_argument("--phone")
    lg.add_argument("--via", help="counter, dm, email, group, phone, referral")
    lg.add_argument("--source", choices=SOURCES, help="the channel, for the week's cut (default: from --via, "
                                                      "the channel this lead is already on, or the reach the kit used)")
    lg.add_argument("--place", help="census place id, when the name matched the wrong one")
    lg.add_argument("--n", type=int, default=6, help="size of tomorrow's list")
    lg.set_defaults(fn=cmd_log)

    nx = sub.add_parser("next", help="the day's list: follow-ups due, then new leads (default tomorrow)")
    nx.add_argument("when", nargs="?")
    nx.add_argument("--n", type=int, default=6)
    nx.add_argument("--segment", choices=SEGMENTS + ("all",), help="where the new leads come from (default as kit)")
    nx.set_defaults(fn=cmd_next)

    se = sub.add_parser("sent", help="picks from the last remote kit that went out: leads sent 1 3 4 | all")
    se.add_argument("which", nargs="+")
    se.add_argument("--via", default="dm")
    se.add_argument("--source", choices=SOURCES, help="the channel (default: from --via)")
    se.set_defaults(fn=cmd_sent)

    du = sub.add_parser("due", help="follow-ups due today")
    du.set_defaults(fn=cmd_due)

    rk = sub.add_parser("recheck", help="the week's messaged leads: each logged handle or address judged again against "
                                        "the place (B104, reach.py --check through LEADS_REACH_PY; $0)")
    rk.add_argument("--since", help="YYYY-MM-DD (default: this week's Monday)")
    rk.add_argument("--dry-run", action="store_true", help="reach.py fetches nothing and writes nothing")
    rk.set_defaults(fn=cmd_recheck)

    td = sub.add_parser("today", help="the 07:30 message: the six, yesterday's replies, what's due, the first call")
    td.add_argument("--n", type=int, default=6, help="picks in the kit (default 6)")
    td.add_argument("--segment", choices=SEGMENTS + ("all",))
    td.add_argument("--fresh", action="store_true", help="run a new kit even if one ran today")
    td.add_argument("--census-only", action="store_true", help="no Google calls")
    td.add_argument("--no-save", action="store_true")
    td.add_argument("--json", action="store_true", help="the message and everything in it")
    td.add_argument("--fixture", help="dir of <place_id>.json Place Details (tests)")
    td.set_defaults(fn=cmd_today)

    br = sub.add_parser("brief", help="one screen before a call: the fault, the preview, the history, the objection, the close")
    br.add_argument("name", nargs="+", help='"Name" or "Name, City"')
    br.add_argument("--place", help="census place id, when the name matched the wrong one")
    br.add_argument("--live", action="store_true", help="read the Google listing too (one Places call)")
    br.add_argument("--fixture", help="dir of <place_id>.json Place Details (tests)")
    br.set_defaults(fn=cmd_brief)

    cd = sub.add_parser("cadence", help="the touches a silent lead is owed by its strength (§ 5.5): weak 3/10, "
                                        "good 3/10/30, strong 3/10/30/45/60/90")
    cd.add_argument("--dry-run", action="store_true", help="say what is due, write nothing")
    cd.set_defaults(fn=cmd_cadence)

    st = sub.add_parser("strength", help="a lead's strength and why; `strength NAME strong|good|weak \"why\"` is your word")
    st.add_argument("name", nargs=1, help='"Name" or "Name, City"')
    st.add_argument("level", nargs="?", help="strong | good | weak (your override, always wins) | auto (back to the score)")
    st.add_argument("why", nargs="*", help="the reason, in your words")
    st.add_argument("--place", help="census place id, when the name matched the wrong one")
    st.set_defaults(fn=cmd_strength)

    sh = sub.add_parser("show", help="one lead's history")
    sh.add_argument("name", nargs="+")
    sh.add_argument("--place")
    sh.set_defaults(fn=cmd_show)

    wk = sub.add_parser("week", help="this week's numbers")
    wk.add_argument("--ago", type=int, default=0, help="weeks back")
    wk.add_argument("--by", choices=["channel", "strength"],
                    help="channel: the Sunday review (B52), the funnel per channel and the § 2.4 rows; "
                         "strength: outcomes by strength and by reason (B73)")
    wk.add_argument("--json", action="store_true", help="alone: the overview's counts (B102); with --by: that view as JSON")
    wk.set_defaults(fn=cmd_week)

    pp = sub.add_parser("pipeline", help="every lead by stage")
    pp.add_argument("--all", action="store_true", help="list won and lost too")
    pp.add_argument("--strong", action="store_true", help="only the strong leads, each with why (B73)")
    pp.add_argument("--json", action="store_true", help="counts by stage and due today, no names (B102)")
    pp.set_defaults(fn=cmd_pipeline)

    pv = sub.add_parser("preview", help="a lead's own website, built from the census row (B45): NAME | --kit | ls | sweep")
    pv.add_argument("name", nargs="*", help='"Name" or "Name, City" (several allowed); or `ls` / `sweep`')
    pv.add_argument("--kit", action="store_true", help="today's remote-kit picks (else the nearest of the pool)")
    pv.add_argument("--place", metavar="PLACE_ID", help="one business by census place id, a site of its own or not "
                                                        "(B90: `outreach inbox` on a \"yes\"); with --json one object")
    pv.add_argument("--n", type=int, default=6)
    pv.add_argument("--segment", choices=SEGMENTS + ("all",))
    pv.add_argument("--min-reviews", type=int, default=None)
    pv.add_argument("--days", type=int, default=PREVIEW_DAYS, help=f"days before it expires (default {PREVIEW_DAYS})")
    pv.add_argument("--hero", choices=["stock", "gen", "none"], default="stock",
                    help="the one photo: a Pexels stock landscape (free, default), one generated image, or none. "
                         "Never one of their Google photos.")
    pv.add_argument("--remove", metavar="NAME", help="take one down now (the folder, the manifest, one publish)")
    pv.add_argument("--claim", metavar="NAME", help="turn it into a client site: client new + site new from the same files")
    pv.add_argument("--slug", help="with --claim: the client workspace slug (default: from the name)")
    pv.add_argument("--no-publish", action="store_true", help="fill the files, upload nothing")
    pv.add_argument("--dry-run", action="store_true", help="say what would happen, change nothing live")
    pv.add_argument("--census-only", action="store_true", help="no Google calls (no hours, no rating)")
    pv.add_argument("--refresh", action="store_true", help="ignore the 7-day listing cache")
    pv.add_argument("--json", action="store_true")
    pv.add_argument("--fixture", help="dir of <place_id>.json Place Details (tests)")
    pv.add_argument("--from", dest="from_file", metavar="CONTENT_JSON",
                    help="render one content.json (plan 28 § Contracts) with the template's section library")
    pv.add_argument("--out", help="with --from: render into DIR and record nothing (else the previews tree + manifest)")
    pv.add_argument("--look", help="the look (css/looks/<look>.css): overrides content.json's, or picks one for NAME")
    pv.add_argument("--from-press", metavar="HASH_OR_TOKEN",
                    help="B91: a press on a letter's link; build or reuse that business's preview, one JSON object")
    pv.add_argument("--press-tokens", action="store_true",
                    help="B91: every letter link's sha256 and whether it is active or removed, one JSON object")
    pv.set_defaults(fn=cmd_preview)

    bt = sub.add_parser("batch", help="the email lane's batch (B90): fifty or fewer in one trade, each with its address "
                                      "and two true specifics (a fault first); --stats sizes the lane")
    bt.add_argument("--segment", choices=SEGMENTS, help="default services")
    bt.add_argument("--city", help="narrow to one city (the listing's locality), e.g. Lehi; default the whole corridor")
    bt.add_argument("--category", help="one trade as the census names it, e.g. plumber, roofing, house cleaning; "
                                       "`any` for every trade in the city")
    bt.add_argument("--n", type=int, default=BATCH_MAX, help=f"at most this many (default and ceiling {BATCH_MAX})")
    bt.add_argument("--json", action="store_true", help="plan 37 § Contract's shape (what `outreach send --batch` reads)")
    bt.add_argument("--live", action="store_true",
                    help="read the Google listing (~$0.025) for a business one fault short; capped a day by "
                         f"LEADS_LIVE_READS_PER_DAY (default {BATCH_LIVE_CAP_DEFAULT}), counted in the ledger")
    bt.add_argument("--last", action="store_true", help="reprint the last batch (with --json, its JSON)")
    bt.add_argument("--stats", action="store_true", help="how many with an address have two faults or more, by "
                                                         "segment, city and trade, and each fault key's count")
    bt.add_argument("--no-save", action="store_true", help="print only: no file, and no 56-day hold")
    bt.add_argument("--fixture", help="dir of <place_id>.json Place Details (tests)")
    bt.set_defaults(fn=cmd_batch)

    d = sub.add_parser("doctor")
    d.set_defaults(fn=cmd_doctor)

    args = ap.parse_args()
    if not args.cmd:
        ap.print_help()
        sys.exit(0)
    args.fn(args)


if __name__ == "__main__":
    main()
