    ("no phone", "Add the phone number under Edit profile → Contact."),
]


def die(msg, code=1):
    print(f"leads: {msg}", file=sys.stderr)
    sys.exit(code)


# ---- config -------------------------------------------------------------------

def _env_file(path):
    keys = {}
    if path.exists():
        for line in path.read_text().splitlines():
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                keys[k.strip()] = v.strip().strip('"').strip("'")
    return keys


def places_key():
    """(key, where) — the toolbelt env. Never printed."""
    val = os.environ.get("GOOGLE_MAPS_API_KEY") or _env_file(ENV_FILE).get("GOOGLE_MAPS_API_KEY")
    if val:
        return val, "toolbelt"
    return None, None


def home():
    raw = os.environ.get("LEADS_HOME")
    if raw:
        try:
            lat, lng = (float(x) for x in raw.split(","))
            return lat, lng
        except ValueError:
            die("LEADS_HOME must be 'lat,lng'")
    return HOME_DEFAULT


def miles(a, b):
    lat1, lng1 = a
    lat2, lng2 = b
    dy = (lat2 - lat1) * 69.0
    dx = (lng2 - lng1) * 69.0 * math.cos(math.radians(lat1))
    return math.hypot(dx, dy)


def next_saturday(today=None):
    today = today or dt.datetime.now(TZ).date()
    return today + dt.timedelta(days=(5 - today.weekday()) % 7)


# ---- the census ----------------------------------------------------------------

def census_candidates(min_reviews=25):
    if not CENSUS.exists():
        die(f"no census at {CENSUS} (LEADS_DB)")
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    rows = conn.execute("""
        SELECT r.place_id, p.name, p.address, p.locality, p.phone, p.website, p.has_website,
               p.rating, p.reviews, p.lat, p.lng, p.primary_type, p.google_maps_uri, p.refreshed_at,
               r.on_doordash, r.on_uber, r.on_grubhub, r.status, r.last_action_date, r.next_followup,
               r.parasite_url, r.serp_top3, r.contact_name, r.contact_email, r.city
        FROM restaurants r JOIN place_cache p ON p.place_id = r.place_id
        WHERE r.channel_class = 'marketplace-only'
          AND COALESCE(r.is_chain, 0) = 0
          AND (p.business_status IS NULL OR p.business_status = 'OPERATIONAL')
          AND p.lat IS NOT NULL AND p.lng IS NOT NULL
          AND r.status = 'Open'
          AND COALESCE(p.reviews, 0) >= ?
          AND COALESCE(p.phone, '') != ''
    """, (min_reviews,)).fetchall()
    conn.close()
    h = home()
    out = []
    for r in rows:
        d = dict(r)
        if d["primary_type"] in SKIP_TYPES:
            continue
        d["miles"] = round(miles(h, (d["lat"], d["lng"])), 1)
        out.append(d)
    out.sort(key=lambda d: (d["miles"], -(d["reviews"] or 0)))
    return out


def census_stamp(cands):
    stamps = sorted({(c.get("refreshed_at") or "")[:10] for c in cands if c.get("refreshed_at")})
    return stamps[-1] if stamps else "?"


# ---- the reach table (B61's `reach`; read here, written by client-leads/scripts/reach.py) ----

_REACH = None


def reach_table():
    """place_id -> {'instagram' (handle), 'facebook' ('facebook.com/x'), 'email', 'source', 'checked', 'evidence',
    'unconfirmed' (B104: 'field=why; …' for the candidates not in a column)}, or None when the census has no `reach` table yet (B61 hasn't run). Read once, never written."""
    global _REACH
    if _REACH is not None:
        return _REACH or None
    if not CENSUS.exists():
        return None
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    try:
        if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='reach'").fetchone():
            _REACH = {}
            return None
        rows = conn.execute("SELECT * FROM reach").fetchall()
    finally:
        conn.close()
    out = {}
    for r in rows:
        d = dict(r)
        pid = d.get("place_id")
        if not pid:
            continue
        out[pid] = {"instagram": ig_handle(d.get("instagram")), "facebook": fb_page(d.get("facebook")),
                    "email": (d.get("email") or "").strip() or None, "source": d.get("source"),
                    "checked": d.get("checked"), "evidence": d.get("evidence"),
                    "unconfirmed": d.get("unconfirmed")}
    _REACH = out
    return out


def ig_handle(value):
    """A handle from a handle, an @handle or a profile URL; None for a post, a reel or nothing."""
    v = (value or "").strip().lstrip("@")
    m = re.match(r"^(?:https?://)?(?:www\.|m\.)?instagram\.com/([A-Za-z0-9_.]+)", v)
    if m:
        v = m.group(1)
    v = v.strip("/")
    return v if re.fullmatch(r"[A-Za-z0-9_.]+", v or "") and v.lower() not in IG_SKIP else None


def fb_page(value):
    """'facebook.com/x' from a page URL or a bare page name; None for a group, an event or nothing.
    A `facebook.com/p/<Name>-<id>` page keeps its whole path (it was cut to 'facebook.com/p' until 2026-09-30),
    and so does an old-style `facebook.com/pages/<Name>/<id>`."""
    v = (value or "").strip()
    if not v:
        return None
    m = re.match(r"^(?:https?://)?(?:www\.|m\.|web\.)?facebook\.com/([^?#]*)", v)
    if m:
        seg = [x for x in m.group(1).split("/") if x]
        if seg and seg[0].lower() == "p":
            return f"facebook.com/p/{seg[1]}" if len(seg) >= 2 else None
        if seg and seg[0].lower() == "pages":
            return "facebook.com/pages/" + "/".join(seg[1:3]) if len(seg) >= 3 else None
        name = seg[0] if seg else None
    else:
        name = v.strip("/") if "/" not in v.strip("/") else None
    if not name or name.lower() in FB_SKIP:
        return None
    return f"facebook.com/{name}"


def fb_from_url(url):
    """fb_page for a link that may be anything: None unless it is on facebook.com."""
    return fb_page(url) if re.match(r"^(?:https?://)?(?:www\.|m\.|web\.)?facebook\.com/", url or "") else None


# A handle or a search result's title naming one of these is another place's account (a franchise in Dallas,
# a namesake in Boise): the kit and `today` refuse it and fall through to the next channel. One list, here.
FOREIGN_PLACES = ("Dallas", "Fort Worth", "Houston", "San Antonio", "Phoenix", "Scottsdale", "Tucson", "Mesa",
                  "Las Vegas", "Vegas", "Boise", "Denver", "Colorado Springs", "Seattle", "Portland", "Sacramento",
                  "San Diego", "Los Angeles", "San Francisco", "Chicago", "Atlanta", "Nashville", "Miami", "Orlando",
                  "Tampa", "California", "Texas", "Arizona", "Idaho", "Nevada", "Colorado", "Oregon", "Wyoming",
                  "Montana", "Florida", "New Mexico", "Albuquerque")
FOREIGN_SHORT = ("mesa",)           # too short to look for inside a run-together handle: only as a word of its own


def foreign_place(text, c=None):
    """'Dallas' when the text names a place that is neither Utah nor in the business's own name or city, else None.
    Handles run words together (proslatgaragestore.dallas, sbpcdenver), so the long names match inside a word."""
    t = (text or "").lower()
    if not t:
        return None
    flat = re.sub(r"[^a-z]", "", t)
    own = re.sub(r"[^a-z]", "", " ".join(str((c or {}).get(k) or "") for k in ("name", "city", "locality")).lower())
    for place in FOREIGN_PLACES:
        w = re.sub(r"[^a-z]", "", place.lower())
        if w in own:
            continue
        if re.search(rf"(?<![a-z]){w}(?![a-z])", t) if w in FOREIGN_SHORT else w in flat:
            return place
    return None


def reach_guard(out, c, own=()):
    """Refuse an Instagram or Facebook handle that is another city's account (the handle itself, or the title of
    the search result B61 found it by). A refused handle is dropped, so the pick falls through to the next
    channel, and `out['skipped']` says why ("Instagram skipped: another city's account (Dallas)").
    Since B104/B107 the table's own judgement runs first (`reach_judge`): a value it didn't find `high` is taken
    out and labelled; the city list stays as a backstop for what the table doesn't know."""
    out = reach_judge(out, (c or {}).get("place_id"), own=own)
    row = (reach_table() or {}).get((c or {}).get("place_id") or "") or {}
    try:
        ev = json.loads(row.get("evidence") or "{}") if isinstance(row.get("evidence"), str) else (row.get("evidence") or {})
    except ValueError:
        ev = {}
    skipped = list(out.get("skipped") or [])
    for field, label in (("instagram", "Instagram"), ("facebook", "Facebook")):
        v = out.get(field)
        if not v:
            continue
        title = ""
        if row.get(field) and (row[field] == v or str(v).endswith(str(row[field]))):
            title = ((ev.get(field) or {}).get("title") or "") if isinstance(ev.get(field), dict) else ""
        handle = re.sub(r"^(?:https?://)?(?:www\.)?(?:facebook|instagram)\.com/", "", str(v))
        where = foreign_place(f"{handle} {title}", c)
        if where:
            out[field] = None
            skipped.append(f"{label} skipped: another city's account ({where})")
    if skipped:
        out["skipped"] = skipped
    return out


# ---- B104/B107: is it *their* place? (plan 44; the seam is client-leads/scripts/reach.py's docstring) ----
# reach.py judges every candidate against the place before it goes in its column: `high` only when something on the
# result or the page ties it to the business (Utah, the city, the listing phone, a 801/385/435 number, the listing's
# domain). Only `high` is ever in a column; the rest are named in `unconfirmed` and kept in `evidence[field]` with a
# `confidence` of unsure, low or rejected. A row stored before B104 has no `confidence`: its column value reads as
# `low` here until `reach.py --check` has run over it, so an unchecked handle is never a DM line (fails closed).
# Why it matters: on 2026-10-02 the kit carried a New Mexico namesake's Instagram for an Orem plumber, and a message
# to a namesake reaches a stranger with Taylor's name on it.

REACH_FIELDS = ("instagram", "facebook", "email")
REACH_LABEL = {"instagram": "Instagram", "facebook": "Facebook", "email": "email"}
UNCHECKED_WHY = "not checked against the place yet (stored before B104; reach.py --check)"


def reach_value(field, value):
    """One field's value in the form the readers compare: a bare handle, 'facebook.com/x', a lower-case address."""
    if not value:
        return None
    if field == "instagram":
        return ig_handle(value)
    if field == "facebook":
        return fb_page(value)
    return str(value).strip().lower() or None


def parse_unconfirmed(text):
    """reach.unconfirmed ('instagram=why; facebook=hidden: why') → {field: why}. A field named twice keeps the first."""
    out = {}
    for part in re.split(r";\s+(?=(?:instagram|facebook|email)=)", text or ""):
        field, _, why = part.partition("=")
        field = field.strip()
        if field in REACH_FIELDS and field not in out:
            out[field] = why.strip() or None
    return out


def reach_evidence(row):
    ev = (row or {}).get("evidence")
    if isinstance(ev, str):
        try:
            ev = json.loads(ev or "{}")
        except ValueError:
            ev = {}
    return ev if isinstance(ev, dict) else {}


def reach_judgement(place_id):
    """{field: {'value','confidence','place','why','by'}} for what the `reach` table knows of one place; a field with
    nothing known is absent. `confidence` is high | unsure | low | rejected; `why` is the reason when not high."""
    row = (reach_table() or {}).get(place_id or "") if place_id else None
    if not row:
        return {}
    ev, unconf = reach_evidence(row), parse_unconfirmed(row.get("unconfirmed"))
    out = {}
    for f in REACH_FIELDS:
        e = ev.get(f) if isinstance(ev.get(f), dict) else {}
        col = row.get(f)
        value = (reach_value(f, e.get("value")) or col
                 or reach_value(f, e.get("page") or e.get("url") if f != "email" else None))
        if not (value or e or f in unconf):
            continue
        conf = e.get("confidence")
        hidden = e.get("visible") is False
        if col and conf == "high" and not hidden and (not e.get("value") or reach_value(f, e["value"]) == col):
            out[f] = {"value": col, "confidence": "high", "place": e.get("place"), "why": None, "by": e.get("by")}
            continue
        if col and not conf:
            out[f] = {"value": col, "confidence": "low", "place": None, "why": UNCHECKED_WHY, "by": None}
            continue
        judged = conf in ("unsure", "low", "rejected")
        if not judged:
            conf = "low"                                 # no judgement, a hidden high, or a word we don't know
        why = unconf.get(f) or (e.get("reason") if e.get("reason") != "hidden" else None) or e.get("place_reason")
        if hidden:
            why = unconf.get(f) or "hidden: " + (e.get("why") or e.get("place_reason") or "a stranger can't see the page")
        out[f] = {"value": value, "confidence": conf, "place": None,
                  "why": why or ("nothing ties it to the place" if judged else
                                 "not judged against the place yet (reach.py --check)"),
                  "by": e.get("by")}
    return out


def unconfirmed_label(field, j):
    """How a reader says a candidate that isn't `high`. low: no handle at all, call-only. unsure: the handle and a
    look first (research or a judge doubted it; never a DM line). rejected: refused, said in the `skipped` list."""
    label, v, why = REACH_LABEL[field], j.get("value"), j.get("why") or "no reason given"
    if j["confidence"] == "rejected":
        return f"{label} refused ({why})"
    if j["confidence"] == "unsure" and v:
        shown = f"@{v}" if field == "instagram" else v
        return f"{label} {shown}: unconfirmed, look before sending ({why})"
    return f"{label}: unconfirmed, call-only ({why})"


def reach_profile(field, value):
    if field == "instagram":
        return f"https://www.instagram.com/{value}/"
    if field == "facebook":
        return "https://www." + value if not str(value).startswith("http") else value
    return None


def reach_judge(out, place_id, own=()):
    """Take out of `out` every value the table judged and didn't find `high`, and say why: `out['unconfirmed']` is a
    list of {field, value, confidence, why, label, profile} for the candidates that aren't usable (low and unsure),
    and a rejected one is a line in `out['skipped']`. A field in `own` came off the listing's own website link and is
    theirs by definition. A value the table doesn't know at all (a restaurant's own search result) is left as it was;
    the city backstop in `reach_guard` still reads it."""
    judged = reach_judgement(place_id)
    skipped = list(out.get("skipped") or [])
    unconfirmed = list(out.get("unconfirmed") or [])
    for f, j in judged.items():
        if j["confidence"] == "high" or f in own:
            continue
        have = reach_value(f, out.get(f))
        if have and j.get("value") and have != j["value"]:
            continue                                     # a different, usable value (the census's own) — keep it
        out[f] = None
        line = unconfirmed_label(f, j)
        if j["confidence"] == "rejected":
            if line not in skipped:
                skipped.append(line)
        elif not any(u["field"] == f for u in unconfirmed):
            unconfirmed.append({"field": f, "value": j.get("value"), "confidence": j["confidence"], "why": j.get("why"),
                                "label": line, "profile": reach_profile(f, j.get("value")) if j["confidence"] == "unsure" else None})
    if skipped:
        out["skipped"] = skipped
    out["unconfirmed"] = unconfirmed
    return out


def unconfirmed_lines(rc, indent="   "):
    """The kit's lines under a pick for what isn't a route: the refused ones, then the unconfirmed ones (B104/B107).
    An `unsure` handle is shown with its profile link so Taylor can look; it is never the pick's DM line."""
    out = [indent + s for s in (rc or {}).get("skipped") or []]
    out += [indent + u["label"] + (f" — look: {u['profile']}" if u.get("profile") else "")
            for u in (rc or {}).get("unconfirmed") or []]
    return out


def unconfirmed_line(rc):
    """The kit's line for the candidates that aren't usable: 'Instagram: unconfirmed, call-only (why)' · …"""
    bits = []
    for u in (rc or {}).get("unconfirmed") or []:
        bits.append(u["label"] + (f" {u['profile']}" if u.get("profile") else ""))
    return " · ".join(bits)


def reach_py():
    """The census's reach script (B104's `--check` and `--verdict`): LEADS_REACH_PY, else scripts/reach.py next to
    the census. Tests point it at a stub."""
    return Path(os.environ.get("LEADS_REACH_PY") or CENSUS.parent / "scripts" / "reach.py")


def reach_cli(args, timeout=1800):
    """(exit code, stdout, stderr) of `reach.py ARGS --db CENSUS`; (127, '', why) when it can't be run."""
    path = reach_py()
    if not path.exists():
        return 127, "", f"no reach script at {path} (LEADS_REACH_PY)"
    try:
        p = subprocess.run([sys.executable, str(path), *args, "--db", str(CENSUS)], capture_output=True, text=True,
                           timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 124, "", f"reach.py didn't finish ({exc})"
    return p.returncode, p.stdout, p.stderr


def reach_verdict(place_id, field, verdict, why, by, value=None):
    """Someone else's verdict on a stored candidate (B107: prep's research), through `reach.py --verdict`, the one
    way anything outside reach.py writes the table. (ok, the line it printed or why it refused)."""
    args = ["--verdict", place_id, field, verdict, why, "--by", by] + (["--value", value] if value else [])
    code, out, err = reach_cli(args, timeout=60)
    global _REACH
    _REACH = None                                        # the next read sees the verdict
    if code == 0:
        return True, out.strip().splitlines()[-1] if out.strip() else "recorded"
    return False, (err.strip().splitlines() or [f"exit {code}"])[-1]


_REACH_MOD = None


def reach_module():
    """reach.py imported (for `place_evidence`), or None when it isn't there or won't import. Never runs a pass."""
    global _REACH_MOD
    if _REACH_MOD is not None:
        return _REACH_MOD or None
    path = reach_py()
    _REACH_MOD = False
    if path.exists():
        import importlib.util
        sys.path.insert(0, str(path.parent))
        try:
            spec = importlib.util.spec_from_file_location("census_reach", path)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            if hasattr(mod, "place_evidence"):
                _REACH_MOD = mod
        except Exception:                                # a broken census script never stops a reader
            _REACH_MOD = False
        finally:
            sys.path.remove(str(path.parent))
    return _REACH_MOD or None


def place_tie(text, *, name, city, phone=None, site=None, where="the cited words"):
    """reach.py's `place_evidence` on some words: ('high', line) | ('low', why) | ('rejected', why). ('low', why)
    when reach.py isn't importable, so nothing is promoted without it."""
    mod = reach_module()
    if not mod:
        return "low", f"no place check here ({reach_py()} not importable)"
    try:
        return mod.place_evidence(text or "", name=name, city=city, phone=phone, site=site, where=where)
    except Exception as exc:                             # noqa: BLE001 — a reader says why and stays closed
        return "low", f"place check failed ({exc})"


# ---- the hosts table (B71's `hosts`; read here, written by client-leads/scripts/hosts.py) ----

VENDOR_PRICES = Path(os.environ.get("LEADS_VENDOR_PRICES", PROJECTS / "client-leads/vendor_prices.md"))
HOST_DEAD = ("404", "410", "nodns", "parked", "expired", "timeout", "refused", "tls", "error")
HOST_FREE_KINDS = ("social", "directory", "free")
_HOSTS = None
_PRICES = None


def hosts_table():
    """place_id -> {'vendor','kind','status','checked','url','evidence' (dict)}, or None when the census has no
    `hosts` table yet (B71 hasn't run). Read once, never written."""
    global _HOSTS
    if _HOSTS is not None:
        return _HOSTS or None
    if not CENSUS.exists():
        return None
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    try:
        if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='hosts'").fetchone():
            _HOSTS = {}
            return None
        rows = conn.execute("SELECT * FROM hosts").fetchall()
    finally:
        conn.close()
    out = {}
    for r in rows:
        d = dict(r)
        try:
            d["evidence"] = json.loads(d.get("evidence") or "{}")
        except json.JSONDecodeError:
            d["evidence"] = {}
        if d.get("place_id"):
            out[d["place_id"]] = d
    _HOSTS = out
    return out


def vendor_prices():
    """vendor -> {'says','kind','price','from','to','page','brief','note'} from vendor_prices.md's table.
    A vendor missing from the file is unpublished: no number is ever printed for it."""
    global _PRICES
    if _PRICES is not None:
        return _PRICES
    out, cols = {}, None
    try:
        text = VENDOR_PRICES.read_text()
    except OSError:
        text = ""
    for line in text.splitlines():
        if not line.startswith("|"):
            cols = None if not line.strip() else cols
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if cols is None:
            cols = [c.lower() for c in cells]
            continue
        if set("".join(cells)) <= set("-: "):
            continue
        row = dict(zip(cols, cells))
        v = row.get("vendor", "").strip("`")
        if not v or "price" not in row:
            continue
        for k in ("from", "to"):
            try:
                row[k] = float(row.get(k, "").replace("$", "").replace(",", "")) if row.get(k) else None
            except ValueError:
                row[k] = None
        if row.get("price") not in ("published", "reported"):
            row["from"] = row["to"] = None          # an unpublished or free row never carries a number
        out[v] = row
    _PRICES = out
    return out


def money(n):
    return f"${n:,.2f}" if n % 1 else f"${int(n):,}"


def host_info(place_id):
    """The fingerprint joined to the vendor's public price, or None (no table, no row, or nothing to say)."""
    h = (hosts_table() or {}).get(place_id) if place_id else None
    if not h or not h.get("vendor"):
        return None
    v = h["vendor"]
    p = vendor_prices().get(v) or {}
    says = p.get("says") or (v.split(":", 1)[1] if v.startswith("agency:") else v)
    return {"vendor": v, "kind": h.get("kind") or p.get("kind") or "unknown", "status": h.get("status") or "",
            "says": says, "price": p.get("price") or ("free" if h.get("kind") in HOST_FREE_KINDS else "unpublished"),
            "from": p.get("from"), "to": p.get("to"), "page": p.get("page") or None, "brief": p.get("brief") or None,
            "checked": h.get("checked"), "url": h.get("url"), "evidence": h.get("evidence") or {},
            "why": (h.get("evidence") or {}).get("why")}


def host_dead(hi):
    """Dead or parked: the link doesn't give a customer a site (a dead deep link whose home page loads isn't)."""
    st = (hi or {}).get("status") or ""
    if not (st in HOST_DEAD or st.startswith("5")):
        return False
    home = str(((hi.get("evidence") or {}).get("http") or {}).get("home_status") or "")
    return not (st in ("404", "410") and home[:1] in ("2", "3"))


def host_tag(c_or_pid):
    """'hibu ($449+/mo, 404)' — whose platform, its public band, whether it answers. None when unknown or free."""
    pid = c_or_pid if isinstance(c_or_pid, str) else (c_or_pid or {}).get("place_id")
    hi = host_info(pid)
    if not hi or hi["vendor"] == "unknown" or hi["kind"] in HOST_FREE_KINDS:
        return None
    if (hi.get("evidence") or {}).get("url_host"):       # a free wixsite.com-style address: no band to compare
        return f"{hi['vendor']} ({hi['status']})"
    band = f"{money(hi['from'])}+/mo" if hi["from"] is not None else "price unpublished"
    return f"{hi['vendor']} ({band}, {hi['status']})"


def host_status_words(hi):
    st = hi.get("status") or ""
    home = str(((hi.get("evidence") or {}).get("http") or {}).get("home_status") or "")
    if st in ("404", "410"):
        return ("the link on their Google listing returns a 404 (the home page loads)" if home[:1] in ("2", "3")
                else f"their site for you returns a {st}")
    return {"nodns": "their site's address doesn't resolve (no DNS)", "parked": "their domain shows a parked page",
            "expired": "their site shows an expired page", "timeout": "their site for you times out",
            "refused": "their site for you refuses the connection",
            "tls": "their site for you fails its security certificate", "error": "their site for you doesn't load",
            }.get(st, f"their site for you returns a {st} error" if st.startswith("5") else "their site for you is live")


def paying_sentence(c_or_pid, audience="brief"):
    """One sentence in the vendor's own public price.
    audience 'brief' (Taylor, before a call): the price with where it's from, and whether the site answers —
        "Hibu's plans start at $449 a month (reported — Hibu quotes only; flashcrafter.ai); their site for you returns a 404."
    audience 'letter' (the `{paying}` line a lead reads): only a published or reported number, only on the
        business's own domain, about the vendor and never about their bill; None otherwise so the line drops whole."""
    pid = c_or_pid if isinstance(c_or_pid, str) else (c_or_pid or {}).get("place_id")
    hi = host_info(pid)
    if not hi or hi["vendor"] == "unknown" or hi["kind"] in HOST_FREE_KINDS:
        return None
    says, n = hi["says"], hi["from"]
    if audience == "letter":
        own_domain = not (hi.get("evidence") or {}).get("url_host")        # not a free wixsite.com-style address
        if n is None or hi["price"] not in ("published", "reported") or not own_domain:
            return None
        if hi["price"] == "reported":
            return f"Your site's address is set up with {says}, whose plans are reported to start at {money(n)} a month."
        return f"Your site's address is set up with {says}, whose plans start at {money(n)} a month."
    if n is None:
        head = f"It's a {says} site ({says} publishes no price for it)"
    elif hi["price"] == "reported":
        head = (f"{says}'s plans start at {money(n)} a month (reported — {says} quotes only; "
                f"{host_of(hi['page']) if hi.get('page') else hi.get('brief')})")
    else:
        head = f"{says}'s plans start at {money(n)} a month (its own pricing page)"
    return f"{head}; {host_status_words(hi)}."


# ---- the language table (B74's `language`; read here, written by client-leads/scripts/language.py) ----

_LANGUAGE = None


def language_table():
    """place_id -> {'language','basis','checked','evidence' (dict)}, or None when the census has no `language`
    table yet (B74 hasn't run). Read once, never written."""
    global _LANGUAGE
    if _LANGUAGE is not None:
        return _LANGUAGE or None
    if not CENSUS.exists():
        return None
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    try:
        if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='language'").fetchone():
            _LANGUAGE = {}
            return None
        rows = conn.execute("SELECT * FROM language").fetchall()
    finally:
        conn.close()
    out = {}
    for r in rows:
        d = dict(r)
        try:
            d["evidence"] = json.loads(d.get("evidence") or "{}")
        except json.JSONDecodeError:
            d["evidence"] = {}
        if d.get("place_id"):
            out[d["place_id"]] = d
    _LANGUAGE = out
    return out


def language_info(c_or_pid):
    """{'language','basis','why','checked'} for a row, or None (no table, no row)."""
    pid = c_or_pid if isinstance(c_or_pid, str) else (c_or_pid or {}).get("place_id")
    row = (language_table() or {}).get(pid) if pid else None
    if not row or not row.get("language"):
        return None
    return {"language": row["language"], "basis": row.get("basis") or None,
            "why": (row.get("evidence") or {}).get("why"), "checked": row.get("checked")}


def language_tag(c_or_pid):
    """'lang: es' · 'lang: es (name only)' · 'lang: es+en' — only for a row that speaks Spanish; None otherwise."""
    li = language_info(c_or_pid)
    if not li or li["language"] not in ("es", "both"):
        return None
    if li["language"] == "both":
        return "lang: es+en"
    return "lang: es (name only)" if li["basis"] == "name" else "lang: es"


def reach_fill(out, place_id):
    """The census's own columns win; the B61 table fills what they left empty, with a value it judged `high` only
    (B104: a column value with no judgement yet is a pre-B104 name match, and waits for `reach.py --check`)."""
    for f, j in reach_judgement(place_id).items():
        if not out.get(f) and j["confidence"] == "high":
            out[f] = j["value"]
    return out


# ---- the services census (B43's `businesses`; B44 reads it) -------------------------

def businesses_state():
    """(table exists, {segment: rows}) — never raises on an old census."""
    if not CENSUS.exists():
        return False, {}
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    try:
        if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='businesses'").fetchone():
            return False, {}
        return True, dict(conn.execute("SELECT segment, count(*) FROM businesses GROUP BY segment").fetchall())
    finally:
        conn.close()


DEFAULT_POOL_MIN = 6               # a kit's worth: below this the services census is mid-scan, not ready


def default_segment():
    """LEADS_SEGMENT, else services once the services census holds a kit's worth of leads (six with a phone and no
    site of their own), else restaurant — so a scan that has written its first rows doesn't empty the 11:45 kit."""
    env = (os.environ.get("LEADS_SEGMENT") or "").strip().lower()
    if env:
        if env not in SEGMENTS + ("all",):
            die(f"LEADS_SEGMENT is one of {', '.join(SEGMENTS)}, all")
        return env
    _, counts = businesses_state()
    if counts.get("services") and len(business_candidates(["services"])) >= DEFAULT_POOL_MIN:
        return "services"
    return "restaurant"


def resolve_segment(arg):
    """The segment a command runs on; a business segment with no census behind it stops here, in one line."""
    seg = (arg or default_segment()).lower()
    if seg in ("restaurant", "all"):
        if seg == "all" and not sum(businesses_state()[1].values()):
            print("leads: no services census yet — --segment all is the restaurants alone", file=sys.stderr)
        return seg
    exists, counts = businesses_state()
    if not exists or not sum(counts.values()):
        die("no services census yet — run B43's scan (client-leads/scripts/scan_services.py); --segment restaurant works today")
    if not counts.get(seg):
        die(f"no {seg} in the services census yet ({', '.join(f'{k} {v}' for k, v in sorted(counts.items()))})")
    return seg


def host_matches(host, table):
    for h, label in table.items():
        if host == h or host.endswith("." + h):
            return label
    return None


def presence_from_url(url):
    """(class, label) from the website link alone, no fetch: plan 18's classes minus the HTTP check
    ('own' here means only "a domain of its own", not that it loads)."""
    if not (url or "").strip():
        return "none", None
    host = host_of(url)
    if host == "business.site" or host.endswith(".business.site"):
        return "dead", "business.site"
    if host == "sites.google.com":
        return "page", "Google Sites"
    for table, cls in ((PAGE_HOSTS, "page"), (DIRECTORY_HOSTS, "directory"), (BUILDER_HOSTS, "builder")):
        label = host_matches(host, table)
        if label:
            return cls, label
    if ".webnode." in "." + host:
        return "builder", "Webnode"
    return "own", host


def presence(c, website=None):
    """(class, label, url) for a business: the census's class (B43 checked it), or read from the link when it
    says unknown or Google's listing now links somewhere else. An own-domain link nobody checked stays unknown."""
    census_url = c.get("presence_url") or c.get("website") or ""
    cls, url = c.get("presence_class") or "unknown", census_url
    if website is not None and host_of(website) != host_of(census_url):   # Google links somewhere new since the scan
        cls, url = None, website
    derived, label = presence_from_url(url)
    if cls in (None, "unknown"):
        cls = "unknown" if derived == "own" else derived
    elif derived == "own":
        label = host_of(url)
    return cls, label, url


def presence_short(cls, label, url):
    return {"none": "no website", "page": f"website → {label}", "directory": f"website → {label}",
            "dead": f"dead link ({label or host_of(url)})", "builder": f"free {label} site",
            "own": host_of(url), "unknown": host_of(url) or "website unchecked"}.get(cls, cls)


def presence_fault(cls, label, url):
    art = "an" if (label or "x")[0] in "AEIOU" else "a"
    if cls == "none":
        return "no website on Google"
    if cls == "page":
        return f"the website link is {art} {label} page, not a site of their own"
    if cls == "directory":
        return f"the website link is their {label} profile, not a site of their own"
    if cls == "dead":
        if label == "business.site":
            return "the website link is a business.site page, and Google shut those down in 2024: it's a dead link"
        return f"the website link ({label or host_of(url)}) doesn't load"
    if cls == "builder":
        return f"the website is a free {label} address ({host_of(url)})"
    return None


def business_candidates(segments, min_reviews=None):
    """The services census's pool: independent, operational, a phone, no site of its own; nearest first."""
    exists, _ = businesses_state()
    if not exists:
        return []
    floor = SEGMENT_MIN_REVIEWS if min_reviews is None else min_reviews
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    marks = ",".join("?" * len(segments))
    rows = conn.execute(f"""
        SELECT b.place_id, b.segment, b.category, b.presence_class, b.presence_url, b.city,
               p.name, p.address, p.locality, p.phone, p.website, p.has_website, p.rating, p.reviews,
               p.lat, p.lng, p.primary_type, p.google_maps_uri, p.refreshed_at
        FROM businesses b JOIN place_cache p ON p.place_id = b.place_id
        WHERE b.segment IN ({marks})
          AND (CASE WHEN b.chain_override = 'yes' THEN 1 WHEN b.chain_override = 'no' THEN 0
                    ELSE COALESCE(b.is_chain, 0) END) = 0
          AND (p.business_status IS NULL OR p.business_status = 'OPERATIONAL')
          AND p.lat IS NOT NULL AND p.lng IS NOT NULL
          AND COALESCE(p.reviews, 0) >= ?
          AND COALESCE(p.phone, '') != ''
    """, (*segments, floor)).fetchall()
    conn.close()
    h = home()
    out = []
    for r in rows:
        d = dict(r)
        d["presence"], d["presence_label"], d["presence_link"] = presence(d)
        if d["presence"] not in WEAK_PRESENCE:
            continue
        d["miles"] = round(miles(h, (d["lat"], d["lng"])), 1)
        out.append(d)
    out.sort(key=lambda d: (d["miles"], -(d["reviews"] or 0)))
    return out


def candidates_for(segment, min_reviews=None):
    """Every command's pool: `restaurant` is census_candidates() exactly as before B44."""
    if segment == "restaurant":
        return census_candidates(25 if min_reviews is None else min_reviews)
    if segment == "all":
        rest = [dict(c, segment="restaurant") for c in census_candidates(25 if min_reviews is None else min_reviews)]
        out = rest + business_candidates(BUSINESS_SEGMENTS, min_reviews)
        out.sort(key=lambda d: (d["miles"], -(d["reviews"] or 0)))
        return out
    return business_candidates([segment], min_reviews)


def is_business(c):
    return (c.get("segment") or "") in BUSINESS_SEGMENTS


# ---- kits already sent ---------------------------------------------------------

def kits_log():
    p = STATE / "kits.jsonl"
    if not p.exists():
        return []
    out = []
    for line in p.read_text().splitlines():
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return out


def recently_kitted(for_date, weeks=REPEAT_WEEKS):
    """place_id -> kit date for places on a kit in the last N weeks, except the
    kit for this same date (re-running Friday's kit gives the same six)."""
    since = for_date - dt.timedelta(weeks=weeks)
    seen = {}
    for k in kits_log():
        try:
            d = dt.date.fromisoformat(k["for"])
        except (KeyError, ValueError):
            continue
        if d == for_date or d < since:
            continue
        for pid in k.get("place_ids", []):
            seen[pid] = k["for"]
    return seen


# ---- Google Place Details ------------------------------------------------------

class Places:
    """Place Details with a seven-day cache and a fixture mode for tests."""

    def __init__(self, key, where, fixture=None, refresh=False):
        self.key, self.where, self.fixture, self.refresh = key, where, fixture, refresh
        self.calls, self.failed = 0, None
        (STATE / "details").mkdir(parents=True, exist_ok=True)

    def get(self, place_id):
        if self.fixture:
            p = Path(self.fixture) / f"{place_id}.json"
            return json.loads(p.read_text()) if p.exists() else None
        cache = STATE / "details" / f"{place_id}.json"
        if cache.exists() and not self.refresh:
            age = time.time() - cache.stat().st_mtime
            if age < CACHE_DAYS * 86400:
                return json.loads(cache.read_text())
        if not self.key or self.failed:
            return None
        req = urllib.request.Request(DETAILS_URL + place_id, headers={
            "X-Goog-Api-Key": self.key, "X-Goog-FieldMask": DETAILS_FIELDS,
            "Accept": "application/json", "User-Agent": "claude-tools/leads",
        })
        try:
            with urllib.request.urlopen(req, timeout=20) as resp:
                data = json.loads(resp.read().decode())
        except urllib.error.HTTPError as exc:
            body = exc.read().decode(errors="replace")[:300]
            if exc.code in (400, 401, 403, 429):
                self.failed = f"Places refused the key ({exc.code}; from {self.where}): {body.strip()}"
                return None
            if exc.code == 404:
                data = {"id": place_id, "businessStatus": "GONE"}
            else:
                self.failed = f"Places error {exc.code}: {body.strip()}"
                return None
        except (urllib.error.URLError, TimeoutError, OSError) as exc:
            self.failed = f"Places unreachable: {exc}"
            return None
        self.calls += 1
        cache.write_text(json.dumps(data))
        return data


def ledger_append(event):
    try:
        LEDGER.parent.mkdir(parents=True, exist_ok=True)
        with open(LEDGER, "a") as f:
            f.write(json.dumps(event) + "\n")
    except OSError as exc:
        print(f"leads: ledger write failed ({exc})", file=sys.stderr)


# ---- reading a listing ---------------------------------------------------------

def open_always(periods):
    """Google says "open 24 hours" with a single period that has no close and opens at day 0, hour 0 —
    the day field is present and zero, not missing, so a 24/7 listing must never read as closed Saturdays."""
    if len(periods or []) != 1 or "close" in (periods[0] or {}):
        return False
    o = (periods[0] or {}).get("open") or {}
    return o.get("day") in (None, 0) and not o.get("hour") and not o.get("minute")


def saturday_open(details):
    """(hour, minute) of the earliest Saturday opening, 'closed', or None (no hours)."""
    hours = (details or {}).get("regularOpeningHours") or {}
    periods = hours.get("periods")
    if not periods:
        return None
    if open_always(periods):
        return (0, 0)
    opens = []
    for p in periods:
        o = p.get("open") or {}
        if o.get("day") == 6:
            opens.append((o.get("hour", 0), o.get("minute", 0)))
    return min(opens) if opens else "closed"


def clock(hm):
    h, m = hm
    suffix = "am" if h < 12 else "pm"
    h12 = h % 12 or 12
    return f"{h12}:{m:02d}{suffix}" if m else f"{h12}{suffix}"


def host_of(url):
    m = re.match(r"^(?:https?://)?(?:www\.)?([^/]+)", url or "")
    return (m.group(1) if m else "").lower()


def marketplace_link(url):
    h = host_of(url)
    for mk in MARKETPLACE_HOSTS:
        if mk in h:
            return {"order.online": "DoorDash Storefront", "doordash": "DoorDash", "ubereats": "Uber Eats",
                    "grubhub": "Grubhub", "toasttab": "Toast", "facebook": "Facebook", "instagram": "Instagram",
                    "linktr": "Linktree", "yelp": "Yelp", "slicelife": "Slice", "menufy": "Menufy",
                    "postmates": "Postmates", "seamless": "Seamless"}[mk]
    return None


def platforms(c):
    on = [name for col, name in (("on_doordash", "DoorDash"), ("on_uber", "Uber Eats"), ("on_grubhub", "Grubhub"))
          if (c.get(col) or "").strip().lower() == "yes"]
    maybe = [name for col, name in (("on_doordash", "DoorDash"), ("on_uber", "Uber Eats"), ("on_grubhub", "Grubhub"))
             if (c.get(col) or "").strip().lower() == "maybe"]
    s = " + ".join(on) if on else ""
    if maybe:
        s += (" (maybe " if s else "maybe ") + " + ".join(maybe) + (")" if s else "")
    return s or "a marketplace"


def review_age_days(rev, today):
    ts = rev.get("publishTime")
    if not ts:
        return None
    try:
        d = dt.datetime.fromisoformat(ts.replace("Z", "+00:00")).date()
    except ValueError:
        return None
    return (today - d).days


def faults(c, details, today):
    """What is wrong on the listing, worst first. Also returns the one-line
    Google summary. Works with details=None (census-only)."""
    out = []
    d = details or {}
    website = d.get("websiteUri") if details else (c.get("website") if (c.get("has_website") or "").lower() == "yes" else None)
    rating = d.get("rating") if details else c.get("rating")
    n_reviews = d.get("userRatingCount") if details else c.get("reviews")
    plat = platforms(c)

    if not website:
        out.append(f"no website — Google sends people to {plat}")
    else:
        mk = marketplace_link(website)
        if mk:
            out.append(f"the website link is {'an' if mk[0] in 'AEIOU' else 'a'} {mk} page, not their own")

    if details:
        sat = saturday_open(details)
        if sat is None:
            out.append("no hours on Google")
        elif sat == "closed":
            out.append("Google says closed Saturdays")
        cur = (d.get("currentOpeningHours") or {}).get("weekdayDescriptions")
        reg = (d.get("regularOpeningHours") or {}).get("weekdayDescriptions")
        if cur and reg and cur != reg:
            out.append("special hours set this week (check they're right)")
        n_photos = len(d.get("photos") or [])
        if n_photos == 0:
            out.append("no photos")
        elif n_photos < 5:
            out.append(f"only {n_photos} photos")
        revs = d.get("reviews") or []
        newest = None
        for r in revs:
            age = review_age_days(r, today)
            if age is not None and (newest is None or age < newest):
                newest = age
        low = [r for r in revs if (r.get("rating") or 5) <= 3]
        if low:
            r = min(low, key=lambda r: review_age_days(r, today) or 9999)
            out.append(f"a {r.get('rating')}★ review {r.get('relativePublishTimeDescription') or ''}".strip())
        if newest is not None and newest > STALE_REVIEW_DAYS:
            out.append(f"newest review is {newest // 30} months old")
        if not d.get("nationalPhoneNumber"):
            out.append("no phone on Google")
    if c.get("parasite_url") and not (details and website and not marketplace_link(website)):
        out.append(f"searching the name brings up {host_of(c['parasite_url'])}, a menu page they don't control")
    if n_reviews is not None and n_reviews < 100:
        out.append(f"only {n_reviews} reviews")
    if rating is not None and rating < 4.0:
        out.append(f"rating {rating}")

    stars = f"{rating}★ ({n_reviews})" if rating is not None else "no rating"
    if details:
        n_photos = len(d.get("photos") or [])
        photos = "10+ photos" if n_photos >= 10 else f"{n_photos} photos"
        web = "no website" if not website else (f"website → {marketplace_link(website)}" if marketplace_link(website) else host_of(website))
        summary = f"{stars} · {photos} · {web} · on {plat}"
    else:
        web = "no website" if not website else (f"website → {marketplace_link(website)}" if marketplace_link(website) else host_of(website))
        summary = f"{stars} · {web} · on {plat} · (census only)"
    return out, summary


def business_faults(c, details, today):
    """faults() for a service business, a creative, a shop or a nonprofit (B44): the presence first (no site, a
    social page or a directory profile as the site, a dead business.site, a free builder address), then what the
    listing shows when it was read (no hours, under five photos, a low review, a street address where a trade
    would show a service area). Works with details=None (census only)."""
    d = details or {}
    cls, label, url = presence(c, (d.get("websiteUri") or "") if details else None)
    c["presence"], c["presence_label"], c["presence_link"] = cls, label, url
    out = []
    pf = presence_fault(cls, label, url)
    if pf:
        out.append(pf)
    rating = d.get("rating") if details else c.get("rating")
    n_reviews = d.get("userRatingCount") if details else c.get("reviews")
    if details:
        hours = (d.get("regularOpeningHours") or {}).get("periods")
        if not hours:
            out.append("no hours on Google")
        n_photos = len(d.get("photos") or [])
        if n_photos == 0:
            out.append("no photos")
        elif n_photos < 5:
            out.append(f"only {n_photos} photos")
        if (c.get("segment") == "services" and not d.get("pureServiceAreaBusiness")
                and re.match(r"^\d", d.get("formattedAddress") or "")):
            out.append("Google shows a street address, not the area they serve")
        revs = d.get("reviews") or []
        ages = [a for a in (review_age_days(r, today) for r in revs) if a is not None]
        low = [r for r in revs if (r.get("rating") or 5) <= 3]
        if low:
            r = min(low, key=lambda r: review_age_days(r, today) or 9999)
            out.append(f"a {r.get('rating')}★ review {r.get('relativePublishTimeDescription') or ''}".strip())
        if ages and min(ages) > STALE_REVIEW_DAYS:
            out.append(f"newest review is {min(ages) // 30} months old")
        if not d.get("nationalPhoneNumber"):
            out.append("no phone on Google")
    if n_reviews is not None and n_reviews < 10:
        out.append(f"only {n_reviews} reviews")
    if rating is not None and rating < 4.0:
        out.append(f"rating {rating}")
    stars = f"{rating}★ ({n_reviews})" if rating is not None else "no rating"
    bits = [stars, presence_short(cls, label, url)]
    if details:
        n_photos = len(d.get("photos") or [])
        bits.append("10+ photos" if n_photos >= 10 else f"{n_photos} photos")
    bits.append(c.get("category") or (d.get("primaryTypeDisplayName") or {}).get("text") or c.get("segment") or "")
    summary = " · ".join(b for b in bits if b) + ("" if details else " · (census only)")
    return out, summary


def live_segment(details):
    """A name looked up live (not in either census): None for food (the restaurant faults), 'services' for a
    business people book (the service-area check applies), 'retail' for anything else (a storefront)."""
    t = (details or {}).get("primaryType")
    if is_food(t):
        return None
    return "services" if is_service({"primary_type": t}, None) else "retail"


def is_food(primary_type):
    t = (primary_type or "").lower()
    return any(w in t for w in FOOD_WORDS)


def booking_link(c, details):
    """How people book this place online, or None (B40: None prints the tool line).
    Google's `reservable`, else the listing's (or the census's) website on a booking host."""
    d = details or {}
    if d.get("reservable"):
        return "reservations on Google"
    url = d.get("websiteUri") if details else c.get("website")
    low = (url or "").lower()
    for h in BOOKING_HOSTS:
        if h in low:
            return f"books on {host_of(url)}"
    return None


def is_service(c, details):
    """A service business (pool care, cleaning, lessons): a known primary type that isn't food or drink."""
    t = ((details or {}).get("primaryType") or c.get("primary_type") or "").strip().lower()
    if not t or t in NOT_SERVICE:
        return False
    return t in SERVICE_TYPES or t.endswith(SERVICE_SUFFIXES)


# ---- the kit --------------------------------------------------------------------

def route(picks, start):
    """Nearest-neighbour from home. Six stops; good enough for a morning."""
    left, order, at = list(picks), [], start
    while left:
        nxt = min(left, key=lambda p: miles(at, (p["lat"], p["lng"])))
        left.remove(nxt)
        order.append(nxt)
        at = (nxt["lat"], nxt["lng"])
    return order


def loop_miles(order, start):
    total, at = 0.0, start
    for p in order:
        total += miles(at, (p["lat"], p["lng"]))
        at = (p["lat"], p["lng"])
    return total + miles(at, start)


def build_kit(args):
    for_date = dt.date.fromisoformat(args.for_date) if args.for_date else next_saturday()
    today = dt.datetime.now(TZ).date()
    key, where = (None, None) if args.census_only else places_key()
    places = Places(key, where, fixture=args.fixture, refresh=args.refresh)
    cands = census_candidates(args.min_reviews)
    skip = {} if args.allow_repeat else recently_kitted(for_date)
    skip.update({pid: "pipeline" for pid in pipeline_skip()})
    skip.update({pid: "claimed" for pid in claimed_places()})   # B45: they took the preview; they're a client
    pool = [c for c in cands if c["miles"] <= args.radius and c["place_id"] not in skip]
    if not pool:
        die(f"no candidates within {args.radius} miles of home; widen --radius")

    picks, skipped, cap = [], [], max(args.n * 5, 20)
    for c in pool[:cap]:
        if len(picks) >= args.n:
            break
        details = places.get(c["place_id"]) if (key or args.fixture) else None
        if places.failed and not args.fixture:
            details = None
        c = dict(c)
        c["details"] = details
        if details:
            if details.get("businessStatus") not in (None, "OPERATIONAL"):
                skipped.append((c["name"], details.get("businessStatus", "").lower().replace("_", " ")))
                continue
            sat = saturday_open(details)
            if sat == "closed":
                skipped.append((c["name"], "closed Saturdays"))
                continue
            if sat is not None and sat > LATEST_OPEN:
                skipped.append((c["name"], f"opens Sat {clock(sat)}"))
                continue
            c["sat_open"] = sat
            loc = details.get("location") or {}
            if loc.get("latitude") is not None:
                c["lat"], c["lng"] = loc["latitude"], loc["longitude"]
            c["address"] = details.get("formattedAddress") or c["address"]
            c["phone"] = details.get("nationalPhoneNumber") or c["phone"]
            c["maps"] = clean_maps(details.get("googleMapsUri") or c["google_maps_uri"])
            c["name"] = (details.get("displayName") or {}).get("text") or c["name"]
        else:
            c["sat_open"] = None
            c["maps"] = clean_maps(c["google_maps_uri"])
        c["faults"], c["summary"] = faults(c, details, today)
        c["booking"] = booking_link(c, details)
        picks.append(c)

    start = home()
    order = route(picks, start)
    for p in order:
        p["miles"] = round(miles(start, (p["lat"], p["lng"])), 1)

    if places.calls:
        ledger_append({
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
            "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
            "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global", "for": for_date.isoformat(),
        })

    page = render(order, for_date, today, mode=("fixture" if args.fixture else "google" if (key and not places.failed) else "census"),
                  note=places.failed, skipped=skipped, census_date=census_stamp(cands), loop=loop_miles(order, start),
                  short=len(order) < args.n, n=args.n)

    if not args.fixture and not args.no_save:
        (STATE / "kits").mkdir(parents=True, exist_ok=True)
        (STATE / "kits" / f"{for_date.isoformat()}.md").write_text(page)
        with open(STATE / "kits.jsonl", "a") as f:
            f.write(json.dumps({"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "for": for_date.isoformat(),
                                "place_ids": [p["place_id"] for p in order], "names": [p["name"] for p in order],
                                "mode": "google" if key and not places.failed else "census", "calls": places.calls}) + "\n")
    return page, order


def clean_maps(url):
    """The census stores Google's tracking suffix (&g_mp=...); the phone doesn't need it."""
    return re.sub(r"[&?]g_mp=[^&]*", "", url or "")


def short_address(addr):
    """'123 E Main St, American Fork, UT 84003, USA' -> '123 E Main St, American Fork'."""
    parts = [p.strip() for p in (addr or "").split(",")]
    return ", ".join(parts[:2]) if len(parts) >= 2 else (addr or "")


def render(order, for_date, today, mode, note, skipped, census_date, loop, short, n):
    lines = []
    head = f"Saturday kit — {for_date.strftime('%a %-d %b')}, 9–11 · {len(order)} counters from American Fork · ~{loop:.0f} mi loop"
    lines.append(head)
    if mode == "google":
        lines.append(f"(Google listings read {today.strftime('%a %-d %b')}; census {census_date})")
    elif mode == "fixture":
        lines.append("(FIXTURE listings — a test, not Google)")
    else:
        lines.append(f"(census {census_date} only — no Places key on this machine, so hours, photos and recent reviews are missing; TAYLOR-TODO §1)")
        if note:
            lines.append(f"({note})")
    if mode == "google" and note:
        lines.append(f"({note})")
    lines.append("")
    for i, p in enumerate(order, 1):
        opens = f"opens Sat {clock(p['sat_open'])}" if isinstance(p.get("sat_open"), tuple) else "Sat hours unknown, call first"
        phone = p.get("phone") or "no phone"
        lines.append(f"{i}. {p['name']} — {p['miles']} mi · {short_address(p['address'])} · {opens} · {phone}")
        lines.append(f"   Google: {p['summary']}")
        lines.append(f"   Wrong: {' · '.join(p['faults']) if p['faults'] else 'nothing obvious — lead with the text-Patch line'}")
        if not p.get("booking"):
            lines.append("   No booking link → the tool line (below)")
        if p.get("maps"):
            lines.append(f"   {p['maps']}")
        lines.append("")
    if short:
        lines.append(f"(only {len(order)} of {n}: the rest of the nearby pool is closed Saturday mornings; widen --radius)")
        lines.append("")
    if skipped:
        lines.append("Skipped: " + "; ".join(f"{name} ({why})" for name, why in skipped[:8]))
        lines.append("")
    lines += [
        "Open with the fault, not the pitch: \"Your Google listing is where people find you and it's got <the thing above>. "
        "Text me the fix and it's live today, free. If you want it kept right, that's $99 a month and I'm on the hook for all of it.\"",
        "The line to test: \"Text Patch and it's done. Your Google listing, your menu, your hours, changed in a minute by a number you text. It's AI, with someone on the hook.\"",
        "Ordering is not on offer (VISION § Decided, 2026-09-24): if they ask about their own ordering page, say not yet, plainly, and sell the listing.",
    ]
    if any(not p.get("booking") for p in order):
        lines.append(TOOL_LINE)
    lines += [
        "",
        "Log every conversation by text: \"log <name> talked|interested|… <note>\" (`leads log`). Owner replies to reviews aren't in the Places API — glance at the listing for unanswered ones.",
    ]
    return "\n".join(lines) + "\n"


# ---- the kit for any other segment (B44) ------------------------------------------------

def read_pick(c, details, today):
    """A candidate with its listing folded in and its faults worked out (either census)."""
    c = dict(c, details=details)
    if details:
        c["name"] = (details.get("displayName") or {}).get("text") or c["name"]
        c["address"] = details.get("formattedAddress") or c.get("address")
        c["phone"] = details.get("nationalPhoneNumber") or c.get("phone")
        c["maps"] = clean_maps(details.get("googleMapsUri") or c.get("google_maps_uri"))
    else:
        c["maps"] = clean_maps(c.get("google_maps_uri"))
    c["faults"], c["summary"] = (business_faults if is_business(c) else faults)(c, details, today)
    c["booking"] = booking_link(c, details)
    return c


def nearest_pool(cands, radius, n, skip):
    """Within the radius; if that's short of n, the nearest n wherever they are (the census is the valley)."""
    left = [c for c in cands if c["place_id"] not in skip]
    pool = [c for c in left if c["miles"] <= radius]
    return (pool, None) if len(pool) >= n or len(left) == len(pool) else (left, radius)


def build_segment_kit(args, segment):
    today = dt.datetime.now(TZ).date()
    for_date = dt.date.fromisoformat(args.for_date) if args.for_date else today
    key, where = (None, None) if args.census_only else places_key()
    places = Places(key, where, fixture=args.fixture, refresh=args.refresh)
    cands = candidates_for(segment, args.min_reviews)
    cands.sort(key=strength_order)                                       # B73: strong first, nearest within
    skip = {} if args.allow_repeat else recently_kitted(for_date)
    skip.update({pid: "pipeline" for pid in pipeline_skip()})
    skip.update({pid: "claimed" for pid in claimed_places()})   # B45: they took the preview; they're a client
    pool, widened = nearest_pool(cands, args.radius, args.n, skip)
    if not pool:
        die(f"no {SEGMENT_NOUN[segment]} left to kit (all kitted or in the pipeline); --allow-repeat" if cands else
            f"no {SEGMENT_NOUN[segment]} in the census's pool yet (a phone, ≥{SEGMENT_MIN_REVIEWS if args.min_reviews is None else args.min_reviews} "
            "reviews, no site of their own); `leads doctor` counts them")
    picks, skipped = [], []
    for c in pool:
        if len(picks) >= args.n:
            break
        details = places.get(c["place_id"]) if (key or args.fixture) else None
        if places.failed and not args.fixture:
            details = None
        if details and details.get("businessStatus") not in (None, "OPERATIONAL"):
            skipped.append((c["name"], details.get("businessStatus", "").lower().replace("_", " ")))
            continue
        picks.append(read_pick(c, details, today))
    if places.calls:
        ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
                       "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
                       "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global",
                       "for": f"{segment} {for_date.isoformat()}"})
    mode = "fixture" if args.fixture else "google" if (key and not places.failed) else "census"
    page = render_segment(picks, segment, for_date, today, mode, places.failed, skipped, census_stamp(cands), widened, args.n)
    if not args.fixture and not args.no_save:
        (STATE / "kits").mkdir(parents=True, exist_ok=True)
        (STATE / "kits" / f"{for_date.isoformat()}-{segment}.md").write_text(page)
        with open(STATE / "kits.jsonl", "a") as f:
            f.write(json.dumps({"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "for": for_date.isoformat(),
                                "segment": segment, "place_ids": [p["place_id"] for p in picks],
                                "names": [p["name"] for p in picks], "mode": mode, "calls": places.calls}) + "\n")
    return page, picks


def segment_copy(segments):
    """The opener, the close and one ladder line per business segment on the page (restaurants keep theirs)."""
    lines = []
    if any(s in BUSINESS_SEGMENTS for s in segments):
        lines += [SEGMENT_OPENER, SEGMENT_CLOSE]
        lines += [SEGMENT_LADDER[s] for s in BUSINESS_SEGMENTS if s in segments]
    if "restaurant" in segments:
        lines.append("A restaurant on the list: open with its fault the same way and sell the listing, the menu and the site; "
                     "ordering is not on offer (VISION § Decided, 2026-09-24).")
    return lines


def render_segment(order, segment, for_date, today, mode, note, skipped, census_date, widened, n):
    lines = [f"{SEGMENT_TITLE[segment]} kit — {for_date.strftime('%a %-d %b')} · {len(order)} {SEGMENT_NOUN[segment]} "
             f"nearest American Fork{'' if segment == 'all' else ' with no site of their own'} · call, or drop by"]
    if mode == "google":
        lines.append(f"(Google listings read {today.strftime('%a %-d %b')}; census {census_date})")
    elif mode == "fixture":
        lines.append("(FIXTURE listings — a test, not Google)")
    else:
        lines.append(f"(census {census_date} only — hours, photos and recent reviews aren't read"
                     + ("" if note else " without a Places call") + ")")
    if note:
        lines.append(f"({note})")
    if widened:
        lines.append(f"(fewer than {n} within {widened:g} mi, so the nearest wherever they are)")
    lines.append("")
    for i, p in enumerate(order, 1):
        where = p.get("locality") or (p.get("city") or "").replace(", Utah", "")
        what = p.get("category") or p.get("segment") or ""
        lt = language_tag(p)
        lines.append(f"{i}. {p['name']} — {p['miles']} mi · {what} · {where} · {p.get('phone') or 'no phone'}"
                     + (f" · {lt}" if lt else ""))
        if is_business(p):
            link = f" — {re.sub(r'^https?://(www[.])?', '', p['presence_link']).rstrip('/')}" if p.get("presence_link") else ""
            ht = host_tag(p)
            lines.append(f"   Presence: {p['presence']}{link}{' · ' + ht if ht else ''}")
            lines.append(f"   Strength: {strength_tag(p)}")              # B73
        lines.append(f"   Google: {p['summary']}")
        lines.append(f"   Wrong: {' · '.join(p['faults']) if p['faults'] else 'nothing obvious — lead with the text-Patch line'}")
        if p.get("maps"):
            lines.append(f"   {p['maps']}")
        lines.append("")
    if skipped:
        lines.append("Skipped: " + "; ".join(f"{name} ({why})" for name, why in skipped[:8]))
        lines.append("")
    lines += segment_copy({p.get("segment") or "restaurant" for p in order} or {segment})
    lines += ["",
              "Log every conversation by text: \"log <name> talked|interested|… <note>\" (`leads log`). Owner replies to "
              "reviews aren't in the Places API — glance at the listing for unanswered ones."]
    return "\n".join(lines) + "\n"


# ---- the remote lane (B25) -------------------------------------------------------

GROUPS_LOG = Path(os.environ.get("LEADS_GROUPS_LOG", PROJECTS / "social/leads-from-groups.md"))
SIGNOFF = "Taylor"
IG_SKIP = {"p", "reel", "reels", "explore", "stories", "tv", "accounts", "popular"}
FB_SKIP = {"groups", "events", "pages", "search", "watch", "marketplace", "hashtag", "people", "share", "sharer",
           "profile.php"}   # facebook.com/share/<id> is somebody's share link, not a page to message
TEXT_SEARCH_URL = "https://places.googleapis.com/v1/places:searchText"
TEXT_SEARCH_COST_USD = 0.032


def mail_address():
    return os.environ.get("LEADS_MAIL_ADDRESS") or _env_file(ENV_FILE).get("LEADS_MAIL_ADDRESS")


def reach(c):
    """Where the owner can be messaged, from the census's own search results, then B61's `reach` table:
    {'instagram', 'facebook', 'email'}."""
    out = {"instagram": None, "facebook": None, "email": (c.get("contact_email") or "").strip() or None}
    try:
        top = json.loads(c.get("serp_top3") or "[]")
    except ValueError:
        top = []
    for t in top:
        url = t.get("url") or ""
        m = re.match(r"^https?://(?:www\.|m\.)?instagram\.com/([A-Za-z0-9_.]+)", url)
        if m and not out["instagram"] and m.group(1).lower() not in IG_SKIP:
            out["instagram"] = m.group(1)
        fb = fb_from_url(url) if url.startswith("http") else None
        if fb and not out["facebook"]:
            out["facebook"] = fb
    return reach_guard(reach_fill(out, c.get("place_id")), c)


def clean_name(name):
    """'Pho 99 - Murray' → 'Pho 99'; 'WHISTLE WOK' → 'Whistle Wok'. A greeting reads wrong otherwise."""
    n = re.split(r"\s+[-–|]\s+", name or "", maxsplit=1)[0].strip() or name or ""
    return n.title() if n.isupper() else n


def to_them(fault):
    """The listing's faults are written about the place; a message is written to it."""
    return (fault.replace(" not their own", " not your own").replace("they don't control", "you don't control")
            .replace("Google says closed", "Google says you're closed"))


def chain_names():
    """Names at three or more places in the census: chains the census didn't flag."""
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    rows = conn.execute("SELECT lower(name), count(*) FROM place_cache GROUP BY lower(name) HAVING count(*) >= 3").fetchall()
    conn.close()
    return {r[0] for r in rows}


def lead_faults(c, details, today):
    """The faults a message may name: things on the listing, not the review count or the rating."""
    fs, summary = (business_faults if is_business(c) else faults)(c, details, today)
    return [f for f in fs if not re.match(r"^(only \d+ reviews|rating )", f)], summary


def dm_text(c, fs):
    """The restaurant DM: the same register as every other segment since 2026-09-29 (`register_dm`)."""
    return register_dm(c, fs)


def tool_dm_text(c, fs):
    """B40, the second variant: a service business with no way to book online. One listing fault at most, then the
    tool (a booking page on their own site, the list private to them). No price, like the first."""
    name = clean_name(c["name"])
    fault = f" While I was there: {to_them(fs[0])}." if fs else ""
    return (f"Hi {name} team — I'm Taylor, a small-business owner in American Fork; I build websites and web tools for "
            f"local businesses. I looked you up: there's no way to book you online from Google or your website.{fault} "
            f"Where do the bookings live now — a notebook, a spreadsheet? I can put a booking page on your own site, with "
            f"every booking on a private page only you open. There are working ones at {TOOLS_URL} if you want a look.")


def message_for(c):
    """Which of the two messages a pick gets: the tool variant for a service business with no booking link."""
    if is_service(c, c.get("details")) and not c.get("booking"):
        return "tool", tool_dm_text(c, c["faults"])
    return "listing", dm_text(c, c["faults"])


def email_draft(c, fs):
    name = clean_name(c["name"])
    if c.get("variant") == "tool":
        subject = f"{name}: booking online"
        return subject, tool_dm_text(c, fs).replace(f"Hi {name} team — I'm Taylor,", f"Hi {name} team,\n\nI'm Taylor Remund —", 1)
    return register_email(c, fs)


def email_footer():
    addr = mail_address()
    return ("— Taylor Remund · Patchlamp (Plateful LLC) · founder@patchlamp.com · "
            + (addr if addr else "[POSTAL ADDRESS — required by CAN-SPAM; not set, so don't send yet: TAYLOR-TODO §1]")
            + "\nIf you'd rather not hear from me, reply \"no thanks\" and I won't write again.")


def contacted(days=REPEAT_WEEKS * 7):
    """place_id -> date for leads messaged (remote kits), kitted (Saturday) or put in an email batch (B90) recently."""
    since = dt.datetime.now(TZ).date() - dt.timedelta(days=days)
    seen = {}
    for name in ("remote.jsonl", "kits.jsonl", "batches.jsonl"):
        p = STATE / name
        if not p.exists():
            continue
        for line in p.read_text().splitlines():
            try:
                k = json.loads(line)
                d = dt.date.fromisoformat((k.get("for") or k.get("ts") or "")[:10])
            except (ValueError, TypeError):
                continue
            if d >= since:
                for pid in k.get("place_ids", []):
                    seen[pid] = d.isoformat()
    return seen


def log_leads(rows):
    """Append to social/leads-from-groups.md (a markdown table beside the pipeline)."""
    try:
        GROUPS_LOG.parent.mkdir(parents=True, exist_ok=True)
        new = not GROUPS_LOG.exists()
        with open(GROUPS_LOG, "a") as f:
            if new:
                f.write("# Leads from the groups and the remote kit (B25)\n\n"
                        "One row per lead: where the name came from, how to reach them, what was wrong. "
                        "The pipeline itself (stages, follow-ups) is `leads log`, in private-docs/leads/.\n\n"
                        "| date | name | city | source | reach | what was wrong | what happened |\n"
                        "|---|---|---|---|---|---|---|\n")
            for r in rows:
                cells = [r["date"], r["name"], r.get("city") or "", r["source"], r.get("reach") or "", r.get("wrong") or "", ""]
                f.write("| " + " | ".join(str(x).replace("|", "/").replace("\n", " ") for x in cells) + " |\n")
    except OSError as exc:
        print(f"leads: couldn't write {GROUPS_LOG} ({exc})", file=sys.stderr)


def reach_line(rc):
    bits = []
    if rc["instagram"]:
        bits.append(f"Instagram @{rc['instagram']}")
    if rc["facebook"]:
        bits.append(rc["facebook"])
    if rc["email"]:
        bits.append(rc["email"])
    return " · ".join(bits)


def build_remote(args):
    today = dt.datetime.now(TZ).date()
    key, where = (None, None) if args.census_only else places_key()
    places = Places(key, where, fixture=args.fixture, refresh=args.refresh)
    cands = census_candidates(args.min_reviews)
    skip = {} if args.allow_repeat else contacted()
    skip.update({pid: "pipeline" for pid in pipeline_skip()})
    skip.update({pid: "claimed" for pid in claimed_places()})   # B45: they took the preview; they're a client
    chains = chain_names()
    pool = [c for c in cands if c["miles"] <= args.radius and c["place_id"] not in skip
            and (c["name"] or "").lower() not in chains]
    for c in pool:
        c["reach"] = reach(c)
    # messageable first (a handle or an address), then nearest
    pool.sort(key=lambda c: (not (c["reach"]["instagram"] or c["reach"]["facebook"] or c["reach"]["email"]), c["miles"]))
    picks = []
    for c in pool:
        if len(picks) >= args.n:
            break
        details = places.get(c["place_id"]) if (key or args.fixture) else None
        if places.failed and not args.fixture:
            details = None
        if details and details.get("businessStatus") not in (None, "OPERATIONAL"):
            continue
        c = dict(c, details=details)
        if details:
            c["name"] = (details.get("displayName") or {}).get("text") or c["name"]
            c["maps"] = clean_maps(details.get("googleMapsUri") or c["google_maps_uri"])
        else:
            c["maps"] = clean_maps(c["google_maps_uri"])
        c["faults"], c["summary"] = lead_faults(c, details, today)
        c["booking"] = booking_link(c, details)
        c["variant"], c["message"] = message_for(c)
        if not c["faults"] and c["variant"] != "tool":
            continue          # a message has to name something real that's wrong (no booking link is, for a service business)
        c["summary"] = c["summary"].replace(" · (census only)", "")
        picks.append(c)
    if places.calls:
        ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
                       "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
                       "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global", "for": f"remote {today}"})
    kit_previews(picks, build=getattr(args, "previews", False),      # B45: a link per pick, built with --previews
                 publish=not getattr(args, "no_save", False))
    mode = "fixture" if args.fixture else "google" if (key and not places.failed) else "census"
    page = render_remote(picks, today, mode, places.failed, census_stamp(cands))
    if not args.fixture and not args.no_save:
        (STATE / "remote").mkdir(parents=True, exist_ok=True)
        (STATE / "remote" / f"{today.isoformat()}.md").write_text(page)
        # the same seam `--json` prints, kept on disk so `leads today` can read the morning's six
        # without paying for the listings twice
        (STATE / "remote" / f"{today.isoformat()}.json").write_text(
            json.dumps(kit_json(picks, "restaurant", today), indent=1, default=str) + "\n")
        with open(STATE / "remote.jsonl", "a") as f:
            f.write(json.dumps({"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "for": today.isoformat(),
                                "place_ids": [p["place_id"] for p in picks], "names": [p["name"] for p in picks], "mode": mode}) + "\n")
        log_leads([{"date": today.isoformat(), "name": clean_name(p["name"]), "city": p.get("locality") or p.get("city"), "source": "remote kit",
                    "reach": reach_line(p["reach"]) or p.get("phone"), "wrong": "; ".join(p["faults"][:3])} for p in picks])
    return page, picks


def render_remote(picks, today, mode, note, census_date, compact=False):
    """One Telegram message (4,096 characters): over 3,900 and the per-lead email lines go."""
    if not compact:
        page = render_remote(picks, today, mode, note, census_date, compact=True)
        full = _render_remote(picks, today, mode, note, census_date, emails=True)
        return full if len(full) <= 3900 else page
    return _render_remote(picks, today, mode, note, census_date, emails=False)


def _render_remote(picks, today, mode, note, census_date, emails):
    lines = [f"Remote kit — {today.strftime('%a %-d %b')} · {len(picks)} messages to send from your phone"]
    if mode == "census":
        lines.append(f"(census {census_date} only — no Places key here, so hours, photos and reviews aren't checked; TAYLOR-TODO §1)")
    elif mode == "fixture":
        lines.append("(FIXTURE listings — a test, not Google)")
    else:
        lines.append(f"(Google listings read today; census {census_date})")
    if note:
        lines.append(f"({note})")
    lines.append("")
    for i, p in enumerate(picks, 1):
        rc = p["reach"]
        lines.append(f"{i}. {clean_name(p['name'])} — {p.get('locality') or p.get('city') or ''} · {p['summary']}")
        if rc["instagram"]:
            lines.append(f"   DM on Instagram: instagram.com/{rc['instagram']}")
        elif rc["facebook"]:
            lines.append(f"   Message on Facebook: {rc['facebook']}")
        elif rc["email"]:
            lines.append(f"   Email: {rc['email']}")
        else:
            lines.append(f"   No handle or address found — call {p.get('phone') or 'them'}; the message is the opener")
        lines += unconfirmed_lines(rc)
        if p.get("variant") == "tool":
            lines.append("   (a service business with no way to book online: the tool message, B40)")
        if p.get("preview_url"):
            lines.append(f"   Their preview site: {p['preview_url']}")
        lines.append(f"   \"{p.get('message') or dm_text(p, p['faults'])}\"")
        if emails:
            subject, _ = email_draft(p, p["faults"])
            to = rc["email"] or ("their FB About" if rc["facebook"] else "none known")
            lines.append(f"   Email (to: {to}): \"{subject}\" + the message + footer")
        if p.get("maps"):
            lines.append(f"   {p['maps']}")
        lines.append("")
    lines += ["Email footer (every cold email, from founder@):", email_footer(), "",
              "One fault, a question last; the link and the price are message two, when they answer (`leads today` "
              "prints it). After sending, text \"sent 1 3 4\" (or \"sent all\")."]
    return "\n".join(lines) + "\n"


# ---- the remote lane for any other segment (B44) -------------------------------------------

NOT_A_FIRST_NAME = {"utah", "america", "americas", "nature", "natures", "mother", "mothers", "grandma", "grandmas",
                    "grandpa", "papa", "mama", "uncle", "aunt", "auntie", "dad", "dads", "mom", "moms", "kid", "kids",
                    "everyone", "people", "nana", "granny", "brother", "brothers", "sister", "sisters", "family", "families",
                    "timp", "timpanogos", "wasatch", "provo", "orem", "lehi", "sandy", "draper", "ogden", "layton", "payson",
                    "canyon", "valley", "mountain", "summit", "alpine", "county", "city", "state", "god", "gods", "christ",
                    "king", "kings", "queen", "queens", "doctor", "pro", "pros", "the", "our", "your", "saint", "st"}
FIRST_NAME_RE = r"[A-Z][a-z]{2,11}"


def first_name(name):
    """A first name the business carries, or None: "Mike's Pool Care" → Mike, "Photography by Jenna" → Jenna.
    Only those two shapes — a word that might be a place or a brand is not a person."""
    n = clean_name(name)
    m = re.match(rf"^({FIRST_NAME_RE})['’]s\b", n) or re.search(rf"\b(?:by|with) ({FIRST_NAME_RE})\b(?!['’])", n)
    if m and m.group(1).lower() not in NOT_A_FIRST_NAME:
        return m.group(1)
    return None


COMPANY_TAIL = re.compile(r"[,\s]+(?:llc|l\.l\.c\.?|pllc|l\.?c\.?|inc\.?|corp\.?|ltd\.?)$", re.I)


def plain_name(name):
    """The business as a person would say it: "Pinnacle Painting LLC" → "Pinnacle Painting" (B62). Only in a
    message — the pipeline and the census keep the name as Google has it."""
    n = clean_name(name)
    return COMPANY_TAIL.sub("", n).strip() or n


def greeting(c):
    """Greet by the first name in the name, else by the business — never "the team" (a solo's listing is one person)."""
    return first_name(c["name"]) or plain_name(c["name"])


def business_reach(c):
    """Where a business can be messaged: the link on its own listing first (an Instagram or Facebook page is a DM,
    a directory profile has its own message button), then B61's `reach` table, which is the only place a service
    business's email address comes from. {'instagram','facebook','directory','email'}."""
    out = {"instagram": None, "facebook": None, "directory": None, "email": None}
    if not c.get("presence"):        # a row straight from census_lookup hasn't been classed yet
        cls, label, link = presence(c)
        c["presence"], c["presence_label"] = cls, label
        c["presence_link"] = c.get("presence_link") or link
    url = c.get("presence_link") or c.get("website") or ""
    m = re.match(r"^(?:https?://)?(?:www\.|m\.)?instagram\.com/([A-Za-z0-9_.]+)", url)
    if m and m.group(1).lower() not in IG_SKIP:
        out["instagram"] = m.group(1)
    out["facebook"] = fb_from_url(url)
    if c.get("presence") == "directory" and url:
        out["directory"] = (c.get("presence_label") or host_of(url), url)
    own = tuple(f for f in ("instagram", "facebook") if out.get(f))      # the listing's own link: theirs by definition
    return reach_guard(reach_fill(out, c.get("place_id")), c, own=own)


def business_reach_line(rc):
    bits = []
    if rc.get("instagram"):
        bits.append(f"Instagram @{rc['instagram']}")
    if rc.get("facebook"):
        bits.append(rc["facebook"])
    if rc.get("directory"):
        bits.append(f"{rc['directory'][0]} profile")
    if rc.get("email"):
        bits.append(rc["email"])
    return " · ".join(bits)


def to_you(fault):
    """A business fault, said to the owner."""
    said = {"no website on Google": "there's no website on your listing", "no hours on Google": "there are no hours on it",
            "no photos": "there are no photos on it", "no phone on Google": "there's no phone number on it"}
    if fault in said:
        return said[fault]
    if re.match(r"^only \d+ photos$", fault):
        return "it has " + fault
    m = re.match(r"^a (\d)★ review (.+)$", fault)
    if m:
        return f"there's a {m.group(1)}★ review on it from {m.group(2)}"
    if fault.startswith("newest review is "):
        return "your " + fault
    f = (fault.replace("the website link is a business.site page, and Google shut those down in 2024: it's a dead link",
                       "your listing's website link is a business.site page, which Google shut down in 2024, so it goes nowhere")
         .replace("the website link", "your listing's website link").replace("the website is", "your website is"))
    return (to_them(f).replace("not a site of their own", "not a site of your own")
            .replace("their ", "your ").replace("the area they serve", "the area you serve"))


def segment_dm_text(c, fs):
    """The DM for a trade, a creative, a shop or a nonprofit: `register_dm`, the same as a restaurant's."""
    return register_dm(c, fs)


def segment_email(c, fs):
    return register_email(c, fs)


# ---- the register (Taylor, 2026-09-29) --------------------------------------------------------
# "Hi, I'm Taylor. A small business owner in American Fork. Looked you up on Google. 92 reviews at 4.9, but the website link on your
#  listing goes to a Hibu page that doesn't load anymore. So I went ahead and built you one. Want to see it?"
# One fault, stated once; a thing already built; a question last. The AI line, the price and the link are message
# two (`then_text`), after they answer. VISION § Decided 2026-09-29; memory "outreach message register".

DM_HELLO = "Hi, I'm Taylor. A small business owner in American Fork."
REVIEWS_MIN, RATING_MIN = 10, 4.5
HOSTING_PRICE = "$10"          # Hosting on patchlamp.com/pricing (patchlamp/CLAIMS.md, Prices::TIERS); small plans first, 2026-10-02


def pick_reviews(c):
    """(count, rating) from the listing read today, else the pick, else the census row; (None, None) if unknown."""
    d = c.get("details") or {}
    n, r = d.get("userRatingCount"), d.get("rating")
    if n is None:
        n, r = c.get("reviews"), c.get("rating")
    if n is None and c.get("place_id"):
        row = (_census_by_id(c["place_id"]) or [{}])[0]
        n, r = row.get("reviews"), row.get("rating")
    try:
        return (int(n) if n is not None else None), (float(r) if r is not None else None)
    except (TypeError, ValueError):
        return None, None


def reviews_clause(c):
    """'92 reviews at 4.9' when it is worth saying (10+ reviews at 4.5 or better), else None."""
    n, r = pick_reviews(c)
    if n is None or r is None or n < REVIEWS_MIN or r < RATING_MIN:
        return None
    return f"{n} reviews at {r:.1f}"


def site_fault(fs):
    """The one fault a DM names: the first that is about the website (the pool is no-site-of-their-own)."""
    return next((f for f in fs or [] if f == "no website on Google" or f.startswith(("no website", "the website"))), None)


def site_fault_words(c, fault):
    """(the 'but …' clause, said to the owner; what was built: 'one' or 'one of your own')."""
    if fault.startswith("no website"):
        return "there's no website on your listing", "one"
    if "business.site" in fault:
        return ("the website link on your listing is a business.site page, which Google shut down in 2024, "
                "so it goes nowhere"), "one"
    m = re.match(r"^the website link \((.+)\) doesn't load$", fault)
    if m:
        hi = host_info(c.get("place_id"))
        if hi and hi["kind"] in ("agency", "builder") and hi.get("says"):     # a platform with pages (not WordPress)
            art = "an" if hi["says"][:1].upper() in "AEIOU" else "a"
            return f"the website link on your listing goes to {art} {hi['says']} page that doesn't load anymore", "one"
        return f"the website link on your listing ({m.group(1)}) doesn't load anymore", "one"
    m = re.match(r"^the website is a free (.+) address \((.+)\)$", fault)
    if m:
        return f"the website on your listing is a free {m.group(1)} address ({m.group(2)})", "one of your own"
    m = re.match(r"^the website link is an? (.+) page, not (?:a site of )?their own$", fault)
    if m:
        return f"the website link on your listing goes to {m.group(1)}, not a site of your own", "one"
    m = re.match(r"^the website link is their (.+) profile, not a site of their own$", fault)
    if m:
        return f"the website link on your listing is your {m.group(1)} page, not a site of your own", "one"
    return to_you(fault), "one"


def register_parts(c, fs):
    """(the one fault said to the owner or None, 'So I went ahead and built you one.', 'I can build you one in an
    afternoon') — shared by the DM and the call opener so both name the same fault the same way."""
    fault = site_fault(fs)
    if fault:
        said, one = site_fault_words(c, fault)
        return said, f"So I went ahead and built you {one}.", f"I can build you {one} in an afternoon"
    if fs:
        return to_you(fs[0]), "I went ahead and built you a website too.", "I can build you a website in an afternoon"
    return None, "I went ahead and built you a website.", "I can build you a website in an afternoon"


def register_dm(c, fs):
    """Message one, for every segment. "Built you one" only when the pick has a preview_url (it is true then);
    without one the offer is to build it."""
    biz = plain_name(c["name"])
    who = "you" if greeting(c) == biz else biz
    said, built, offer = register_parts(c, fs)
    rv = reviews_clause(c)
    if rv and said:
        looked = f"Looked {who} up on Google. {rv}, but {said}."
    elif said:
        looked = f"Looked {who} up on Google, and {said}."
    else:
        looked = f"Looked {who} up on Google." + (f" {rv}." if rv else "")
    close = f"{built} Want to see it?" if c.get("preview_url") else f"{offer} — want to see what it'd look like?"
    return f"{DM_HELLO} {looked} {close}"


def then_text(url):
    """Message two, for when they answer yes: the link, the AI line, the price. Never in message one."""
    return (f"{url} — nothing to sign, and I'll take it down the moment you say so. Patch, my AI, does the work and "
            f"I'm on the hook for it; if you want it kept right after the free fix it's {HOSTING_PRICE} a month to keep it up "
            f"on your own web address, with a few small changes by text each month.")


def register_email(c, fs):
    """The one-shot email (nobody to wait on for a yes): message one as a letter, and with a preview the link and
    message two in place of the question."""
    hi, biz = greeting(c), plain_name(c["name"])
    url = c.get("preview_url")
    body = register_dm(c, fs).replace(DM_HELLO, f"Hi {hi},\n\nI'm Taylor Remund, a small business owner in American Fork.", 1)
    if url:
        body = body.replace(" Want to see it?", " Here it is: " + then_text(url), 1)
    return (f"A website for {biz}" if url else f"{biz} on Google"), body


def build_segment_remote(args, segment):
    today = dt.datetime.now(TZ).date()
    key, where = (None, None) if args.census_only else places_key()
    places = Places(key, where, fixture=args.fixture, refresh=args.refresh)
    cands = [c for c in candidates_for(segment, args.min_reviews) if is_business(c)]
    skip = {} if args.allow_repeat else contacted()
    skip.update({pid: "pipeline" for pid in pipeline_skip()})
    skip.update({pid: "claimed" for pid in claimed_places()})   # B45: they took the preview; they're a client
    chains = chain_names()
    pool, _ = nearest_pool([c for c in cands if (c["name"] or "").lower() not in chains], args.radius, args.n, skip)
    if not pool:
        die(f"no {SEGMENT_NOUN[segment]} left to message (all contacted or in the pipeline); --allow-repeat" if cands else
            f"no {SEGMENT_NOUN[segment]} in the census's pool yet (a phone, no site of their own); `leads doctor` counts them")
    for c in pool:
        c["reach"] = business_reach(c)
    pool.sort(key=lambda c: (not business_reach_line(c["reach"]), c["miles"]))    # messageable first, then nearest
    pool.sort(key=lambda c: (not business_reach_line(c["reach"]), strength_order(c)))   # B73: strong first within
    picks = []
    for c in pool:
        if len(picks) >= args.n:
            break
        details = places.get(c["place_id"]) if (key or args.fixture) else None
        if places.failed and not args.fixture:
            details = None
        if details and details.get("businessStatus") not in (None, "OPERATIONAL"):
            continue
        c = read_pick(c, details, today)
        c["faults"] = [f for f in c["faults"] if not re.match(r"^(only \d+ reviews|rating )", f)]
        if not c["faults"]:
            continue
        c["reach"] = business_reach(c)
        c["summary"] = c["summary"].replace(" · (census only)", "")
        c["variant"], c["message"] = "listing", segment_dm_text(c, c["faults"])
        picks.append(c)
    kit_previews(picks, build=getattr(args, "previews", False),      # B45: a link per pick, built with --previews
                 publish=not getattr(args, "no_save", False))
    if places.calls:
        ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
                       "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
                       "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global",
                       "for": f"remote {segment} {today}"})
    mode = "fixture" if args.fixture else "google" if (key and not places.failed) else "census"
    page = render_segment_remote(picks, segment, today, mode, places.failed, census_stamp(cands))
    if not args.fixture and not args.no_save:
        (STATE / "remote").mkdir(parents=True, exist_ok=True)
        (STATE / "remote" / f"{today.isoformat()}-{segment}.md").write_text(page)
        (STATE / "remote" / f"{today.isoformat()}-{segment}.json").write_text(
            json.dumps(kit_json(picks, segment, today), indent=1, default=str) + "\n")
        with open(STATE / "remote.jsonl", "a") as f:
            f.write(json.dumps({"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "for": today.isoformat(),
                                "segment": segment, "place_ids": [p["place_id"] for p in picks],
                                "names": [p["name"] for p in picks], "mode": mode}) + "\n")
        log_leads([{"date": today.isoformat(), "name": clean_name(p["name"]),
                    "city": p.get("locality") or (p.get("city") or "").replace(", Utah", ""),
                    "source": f"remote kit ({p.get('category') or segment})",
                    "reach": business_reach_line(p["reach"]) or p.get("phone"), "wrong": "; ".join(p["faults"][:3])}
                   for p in picks])
    return page, picks


def render_segment_remote(picks, segment, today, mode, note, census_date, emails=True):
    lines = [f"Remote kit — {today.strftime('%a %-d %b')} · {SEGMENT_TITLE[segment].lower()} · {len(picks)} messages to send from your phone"]
    if mode == "census":
        lines.append(f"(census {census_date} only — hours, photos and reviews aren't read)")
    elif mode == "fixture":
        lines.append("(FIXTURE listings — a test, not Google)")
    else:
        lines.append(f"(Google listings read today; census {census_date})")
    if note:
        lines.append(f"({note})")
    lines.append("")
    for i, p in enumerate(picks, 1):
        rc = p["reach"]
        where = p.get("locality") or (p.get("city") or "").replace(", Utah", "")
        ht = host_tag(p)
        lt = language_tag(p)
        lines.append(f"{i}. {clean_name(p['name'])} — {p.get('category') or ''} · {where} · {p['summary']}"
                     + (f" · {ht}" if ht else "") + (f" · {lt}" if lt else ""))
        if emails:                                                        # B73: the level and why; the short
            lines.append(f"   {strength_tag(p, n=2)}")                    # page (SMS-sized) keeps the level alone
        else:
            lines[-1] += f" · {strength(p)[0]}"
        if rc["instagram"]:
            lines.append(f"   DM on Instagram: instagram.com/{rc['instagram']}")
        elif rc["facebook"]:
            lines.append(f"   Message on Facebook: {rc['facebook']}")
        elif rc["directory"]:
            lines.append(f"   Message on {rc['directory'][0]}: {rc['directory'][1]}")
        elif rc.get("email"):
            lines.append(f"   Email: {rc['email']}")
        else:
            lines.append(f"   No page to message — call {p.get('phone') or 'them'}; the message is the opener")
        lines += unconfirmed_lines(rc)
        if p.get("preview_url"):
            lines.append(f"   Their preview site: {p['preview_url']}")
        lines.append(f"   \"{p['message']}\"")
        if emails:
            subject, _ = segment_email(p, p["faults"])
            to = rc.get("email") or ("their FB About" if rc["facebook"] else "none known")
            lines.append(f"   Email (to: {to}): \"{subject}\" + the message + footer")
        if p.get("maps"):
            lines.append(f"   {p['maps']}")
        lines.append("")
    lines += ["Email footer (every cold email, from founder@):", email_footer(), "",
              "One fault, a question last; the link and the price are message two, when they answer (`leads today` prints it). "
              "When they answer, the close and the ladder are on `leads kit --segment " + segment + "`. "
              "After sending, text \"sent 1 3 4\" (or \"sent all\")."]
    page = "\n".join(lines) + "\n"
    if emails and len(page) > 3900:
        return render_segment_remote(picks, segment, today, mode, note, census_date, emails=False)
    return page


def norm(text):
    text = re.sub(r"[^a-z0-9 ]+", " ", (text or "").lower().replace("&", " and "))
    return [w for w in text.split() if len(w) > 1 and w not in {"the", "restaurant", "and", "cafe", "grill", "llc", "co"}]


def census_lookup(name, city=None):
    """Every place in the census whose name matches, best first: (score, row)."""
    if not CENSUS.exists():
        die(f"no census at {CENSUS} (LEADS_DB)")
    has_b, _ = businesses_state()
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    b_cols = ("CASE WHEN r.place_id IS NULL THEN b.segment END AS segment, b.category, b.presence_class, b.presence_url, COALESCE(r.city, b.city) AS city" if has_b else
              "NULL AS segment, NULL AS category, NULL AS presence_class, NULL AS presence_url, r.city")
    b_join = "LEFT JOIN businesses b ON b.place_id = p.place_id" if has_b else ""
    rows = conn.execute(f"""
        SELECT p.place_id, p.name, p.address, p.locality, p.phone, p.website, p.has_website, p.rating, p.reviews,
               p.lat, p.lng, p.primary_type, p.google_maps_uri, p.refreshed_at, p.business_status,
               r.on_doordash, r.on_uber, r.on_grubhub, r.channel_class, r.parasite_url, r.serp_top3,
               r.contact_name, r.contact_email, {b_cols}
        FROM place_cache p LEFT JOIN restaurants r ON r.place_id = p.place_id {b_join}""").fetchall()
    conn.close()
    want = norm(name)
    if not want:
        return []
    wc = " ".join(norm(city)) if city else None
    out = []
    for r in rows:
        have = norm(r["name"])
        if not have:
            continue
        hit = len(set(want) & set(have))
        if hit == 0 or hit / len(set(want)) < 0.75:
            continue          # most of what was typed has to be in the name: "Joe's Taco Truck" is not "The Taco Truck"
        score = hit / max(len(set(want)), 1) + 0.5 * hit / max(len(set(have)), 1)
        if " ".join(want) == " ".join(have):
            score += 1
        where = " ".join(norm((r["locality"] or "") + " " + (r["city"] or "") + " " + (r["address"] or "")))
        if wc:
            score += 0.6 if wc in where else -0.6
        out.append((round(score, 3), dict(r)))
    out.sort(key=lambda x: (-x[0], -(x[1]["reviews"] or 0)))
    return [x for x in out if x[0] >= 0.9]


def text_search(key, query):
    """Places Text Search (New) for a name the census doesn't have: its place id, or None."""
    body = json.dumps({"textQuery": query + " Utah", "maxResultCount": 1}).encode()
    req = urllib.request.Request(TEXT_SEARCH_URL, data=body, method="POST", headers={
        "X-Goog-Api-Key": key, "X-Goog-FieldMask": "places.id", "Content-Type": "application/json",
        "User-Agent": "claude-tools/leads"})
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            places = json.loads(resp.read().decode()).get("places") or []
    except (urllib.error.URLError, OSError, ValueError):
        return None
    return places[0]["id"] if places else None


FIX_HINTS = [
    ("no website", "A one-page site with the menu and hours fixes the first one; Google links it the day it's up."),
    ("website link is a", "Pointing the website link at the restaurant's own page (menu, hours) keeps people off the apps' fees."),
    ("searching the name brings up", "A page of the restaurant's own with the menu pushes those scraper sites down within a few weeks."),
    ("no hours", "Hours go in under Google Maps → the listing → Edit profile → Hours; two minutes for the owner."),
    ("closed Saturdays", "If it's open Saturdays, that's Edit profile → Hours on Google Maps; it's costing weekend searches."),
    ("no photos", "Ten real photos of the food and the room is the single biggest lift on a listing."),
    ("only ", "Ten real photos of the food and the room is the single biggest lift on a listing."),
    ("★ review", "A short, polite owner reply to the recent low review reads well to everyone who sees it after."),
    ("months old", "Asking a few regulars for a review this week makes the listing look alive again."),
    ("no phone", "Add the phone number under Edit profile → Contact."),
]


def diagnosis_lines(c, fs, summary, hints=None):
    """Three lines for a group thread: what's good, what's wrong, the easiest fix. No pitch."""
    hints = hints or FIX_HINTS
    name = clean_name(c["name"])
    rating, n = c.get("rating"), c.get("reviews")
    d = c.get("details") or {}
    if d:
        rating, n = d.get("rating", rating), d.get("userRatingCount", n)
    good = f"{rating}★ from {n:,} reviews" if rating and n else "people are finding it"
    first = f"{name}: {good}{', people like it' if (rating or 0) >= 4.2 else ''}."
    if not fs:
        return [first, "On Google: nothing obviously wrong — hours, photos and website all look right from here.",
                "Nice work; the listing's doing its job."]
    second = "On Google: " + "; ".join(fs[:3]) + "."
    hint = next((h for k, h in hints if k in fs[0]), "Each of those is a few minutes in the Business Profile.")
    return [first, second, hint + " Happy to walk you through any of it."]


def cmd_diagnose(args):
    raw = " ".join(args.name).strip()
    if not raw:
        die('say which business: leads diagnose "Name, City"')
    name, _, city = raw.partition(",")
    today = dt.datetime.now(TZ).date()
    key, where = places_key()
    places = Places(key, where, fixture=args.fixture)
    hits = census_lookup(name.strip(), city.strip() or None)
    c = None
    if hits:
        c = hits[0][1]
    elif key and not args.fixture:
        pid = text_search(key, raw)
        if pid:
            ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_text_search",
                           "tool": "leads", "calls": 1, "cost_usd": TEXT_SEARCH_COST_USD,
                           "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global"})
            c = {"place_id": pid, "name": raw, "google_maps_uri": ""}
    if not c:
        die(f"\"{raw}\" isn't in the census" + ("" if key else " and there's no Places key to look it up (TAYLOR-TODO §1)")
            + "; send the Google Maps link or the city")
    from_census = bool(hits) and is_business(c) and not args.live
    # B44: a name in the services census answers from the census — no Places call; --live reads the listing too
    details = places.get(c["place_id"]) if (key or args.fixture) and not from_census else None
    if places.failed and not args.fixture:
        details = None
    if details:
        c["name"] = (details.get("displayName") or {}).get("text") or c["name"]
        c["locality"] = c.get("locality") or ""
        if not hits and live_segment(details):
            c["segment"] = live_segment(details)     # a live lookup that isn't food: a business's faults, not a restaurant's
            c["category"] = (details.get("primaryTypeDisplayName") or {}).get("text")
    c["details"] = details
    fs, summary = lead_faults(c, details, today)
    biz = is_business(c)
    for line in diagnosis_lines(c, fs, summary, BUSINESS_FIX_HINTS if biz else None):
        print(line)
    print()
    rc = business_reach(c) if biz else reach(c)
    rline = business_reach_line(rc) if biz else reach_line(rc)
    at = (c.get("locality") or (c.get("city") or "").replace(", Utah", "")) if biz else (c.get("locality") or c.get("city") or "")
    tail = ("" if details else
            " · from the services census, listing not read (--live reads it)" if from_census else
            " · census only, hours/photos/reviews not checked")
    print(f"({at} · {summary.replace(' · (census only)', '')}"
          + (f" · presence: {c['presence']}" if biz else "")
          + (f" · reach: {rline}" if rline else "")
          + (f" · {unconfirmed_line(rc)}" if unconfirmed_line(rc) else "")
          + tail
          + (f" · also matched: {', '.join(h[1]['name'] + ' (' + (h[1]['locality'] or '?') + ')' for h in hits[1:3])}" if len(hits) > 1 else "")
          + ")")
    if places.calls:
        ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
                       "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
                       "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global", "for": "diagnose"})
    if not args.no_log:
        log_leads([{"date": today.isoformat(), "name": clean_name(c["name"]), "city": (at or None) if biz else c.get("locality") or c.get("city"),
                    "source": f"group: {args.group}" if args.group else "group thread",
                    "reach": rline, "wrong": "; ".join(fs[:3])}])


# ---- preview sites (B45; plan ~/projects/plans/19-preview-sites.md) -----------------------
#
# A lead's own website, built before the first message, from the census row and
# the Google listing alone. Deterministic: the fill is the segment's template
# plus templates/previews/categories.json (one row per category in
# client-leads/scripts/services.json — the services a category implies, the
# tagline, the intro, a stock-photo term). No model call, so six previews cost
# nothing but the Place Details the kit already paid for.
#
# What is NEVER on a preview: their Google photos (Google's terms, and the
# photographer's copyright), the text of any review, a street address (a
# one-truck trade works from home; the city is what the page says), a claim
# about the business we did not read on the listing, and a price.
#
# Everything lives under ~/.local/state/claude-tools/previews (LEADS_PREVIEWS):
#   site/                what is uploaded: the root page, _headers, robots.txt,
#                        and <slug>/ per preview
#   meta/<slug>.json     the manifest (place_id, expiry, cost) — never uploaded
# One Cloudflare Pages project holds them all, so a publish is one upload of the
# whole tree: removing one preview is deleting its folder and publishing again,
# which is why a takedown takes a minute rather than an hour.

PREVIEWS = Path(os.environ.get("LEADS_PREVIEWS", Path.home() / ".local/state/claude-tools/previews"))
PREVIEW_PROJECT = os.environ.get("LEADS_PREVIEW_PROJECT", "patchlamp-previews")
PREVIEW_DOMAIN = os.environ.get("LEADS_PREVIEW_DOMAIN", "previews.patchlamp.com")
PREVIEW_DAYS = 30
TOOLBELT = Path(__file__).resolve().parent.parent
PREVIEW_TABLE = TOOLBELT / "templates" / "previews" / "categories.json"
PREVIEW_OVERLAY = TOOLBELT / "templates" / "sites" / "_preview"
SITE_TEMPLATES = TOOLBELT / "templates" / "sites"
# The toolbelt commands a preview shells out to. LEADS_PREVIEW_BIN points them at stand-ins so the
# tests can prove the claim and the publish without a Cloudflare project or a GitHub repo.
PREVIEW_BIN = Path(os.environ.get("LEADS_PREVIEW_BIN", TOOLBELT / "bin"))
SITE_BIN = PREVIEW_BIN / "site"
CLIENT_BIN = PREVIEW_BIN / "client"
# `img` for the photos; LEADS_IMG_BIN points at a stand-in so the tests never reach Pexels or Gemini.
IMG_BIN = Path(os.environ.get("LEADS_IMG_BIN", TOOLBELT / "bin" / "img"))
# The footer sentence, word for word. patchlamp/CLAIMS.md § Previews carries it;
# `tests/test_leads_preview.py` pins it. Change one and change all three. "Claim it" links to the
# preview's own claim/ page, a noindex redirect to CLAIM_START filled with the business (plan 28).
PREVIEW_FOOTER = ("A preview Patchlamp made for {name}. Not their official site. "
                  "Claim it, or ask us to take it down: founder@patchlamp.com")
CLAIM_START = os.environ.get("LEADS_CLAIM_START", "https://patchlamp.com/start")
# Every stock or generated picture used by any preview, one JSON line each ({id, slug, role, term,
# date}): the next preview skips an id already on another one (plan 28 § Contracts, gate 6).
PREVIEW_IMAGES = PREVIEWS / "images.jsonl"
IMAGE_REUSE_WINDOW = 60              # previews back that a photo may not repeat within


def now_date():
    """Today in Denver, or LEADS_NOW — the clock a preview's 30 days are measured against
    (so `sweep` can be proven by moving the clock instead of waiting a month)."""
    s = (os.environ.get("LEADS_NOW") or "").strip()
    if not s:
        return dt.datetime.now(TZ).date()
    try:
        return dt.date.fromisoformat(s)
    except ValueError:
        die("LEADS_NOW is a date: YYYY-MM-DD")


def esc(text):
    """Safe both in text and inside a double-quoted attribute, and still readable in the source:
    an apostrophe in a business name stays an apostrophe ("Mike's Pool Care"), not &#x27;."""
    return html.escape(str(text or ""), quote=False).replace('"', "&quot;")


def slugify(text):
    """"Mike's Pool Care" -> mikes-pool-care: an apostrophe closes up, everything else separates."""
    s = re.sub(r"['\u2019]", "", (text or "").lower())
    return re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", s)).strip("-")


def preview_copy(category):
    """The category's copy row from templates/previews/categories.json, over the default.
    An unknown category (a name looked up live, a segment we never scanned) still gets a page."""
    try:
        table = json.loads(PREVIEW_TABLE.read_text())
    except (OSError, ValueError) as exc:
        die(f"{PREVIEW_TABLE}: {exc}")
    row = dict(table["_default"])
    row.update(table["categories"].get(category or "", {}))
    row["category"] = category or "local business"
    return row


def preview_meta_dir():
    return PREVIEWS / "meta"


def preview_site_dir():
    return PREVIEWS / "site"


def previews_all():
    d = preview_meta_dir()
    out = []
    for p in sorted(d.glob("*.json")) if d.exists() else []:
        try:
            out.append(json.loads(p.read_text()))
        except ValueError:
            print(f"leads: {p} is not valid JSON — skipped", file=sys.stderr)
    return out


def preview_save(meta):
    preview_meta_dir().mkdir(parents=True, exist_ok=True)
    (preview_meta_dir() / f"{meta['slug']}.json").write_text(json.dumps(meta, indent=1, sort_keys=True) + "\n")


def preview_find(key):
    """A preview by slug, place id, or business name (the way `leads show` matches one)."""
    want = (key or "").strip().lower()
    rows = previews_all()
    for m in rows:
        if want in (m["slug"], (m.get("place_id") or "").lower()):
            return m
    hits = [m for m in rows if want == clean_name(m["name"]).lower()] or \
           [m for m in rows if want and want in m["name"].lower()]
    if len(hits) > 1:
        die("that matches " + ", ".join(m["slug"] for m in hits[:6]) + " — name the slug")
    return hits[0] if hits else None


def preview_slug(name, city, taken):
    base = "-".join(x for x in (slugify(clean_name(name)), slugify(city)) if x)[:60].strip("-") or "preview"
    slug, n = base, 2
    while slug in taken:
        slug, n = f"{base}-{n}", n + 1
    return slug


def phone_href(phone):
    digits = re.sub(r"\D", "", phone or "")
    if len(digits) == 10:
        return "+1" + digits
    if len(digits) == 11 and digits.startswith("1"):
        return "+" + digits
    return "+" + digits if digits else ""


WEEK_ORDER = [1, 2, 3, 4, 5, 6, 0]           # Monday first, the way a week reads on a site
LONG_DAY = {"sunday": 0, "monday": 1, "tuesday": 2, "wednesday": 3, "thursday": 4, "friday": 5, "saturday": 6}


def _group_week(per_day):
    """{day index: 'what it says'} -> ['Mon-Fri: 8am-6pm', 'Sat: 9am-2pm', 'Sun: closed'],
    runs of identical days folded into one line."""
    out, i = [], 0
    while i < len(WEEK_ORDER):
        val = per_day.get(WEEK_ORDER[i]) or "closed"
        j = i
        while j + 1 < len(WEEK_ORDER) and (per_day.get(WEEK_ORDER[j + 1]) or "closed") == val:
            j += 1
        label = DAYS[WEEK_ORDER[i]] if j == i else f"{DAYS[WEEK_ORDER[i]]}-{DAYS[WEEK_ORDER[j]]}"
        out.append(f"{label}: {val}")
        i = j + 1
    return out


def hours_lines(details):
    """The listing's hours as a site shows them: ['Mon-Fri: 8am-6pm', 'Sat: 9am-2pm', 'Sun: closed'],
    or [] when Google has none. Google's own weekdayDescriptions when the listing carries them (its
    wording, its rounding), else the periods, which is what the recorded fixtures hold. A single
    period with an open and no close is Google's "open 24 hours, every day"."""
    hours = (details or {}).get("regularOpeningHours") or {}
    descs = hours.get("weekdayDescriptions") or []
    if descs:
        per_day = {}
        for line in descs:
            day, _, rest = line.partition(":")
            d = LONG_DAY.get(day.strip().lower())
            if d is not None:
                per_day[d] = re.sub(r"\s*[\u2013\u2014-]\s*", "-", rest.strip().replace("\u202f", " ")) or "closed"
        if per_day:
            return _group_week(per_day)
    periods = hours.get("periods")
    if not periods:
        return []
    if len(periods) == 1 and "close" not in periods[0]:
        return ["Open 24 hours, every day"]
    per_day = {}
    for pd in periods:
        o, c = pd.get("open") or {}, pd.get("close")
        span = clock((o.get("hour", 0), o.get("minute", 0))) + (
            "-" + clock((c.get("hour", 0), c.get("minute", 0))) if c else " onwards")
        day = o.get("day")
        if day is None:
            continue
        per_day[day] = (per_day[day] + ", " + span) if day in per_day else span
    return _group_week(per_day) if per_day else []


def preview_where(c, details, city):
    """The city, never the street: a one-truck trade's listing address is often the owner's house."""
    if (details or {}).get("pureServiceAreaBusiness") or (c.get("segment") in ("services", "creatives")):
        return f"{city} and the towns nearby" if city else "The Wasatch Front"
    return f"{city}, Utah" if city else "Utah"


def fill_preview(text, values):
    for k, v in values.items():
        text = text.replace("{{" + k + "}}", str(v))
    return text


# ---- photos: stock by a seed, never one another preview already shows (plan 28, B64) ------

def image_registry():
    rows = []
    if PREVIEW_IMAGES.exists():
        for line in PREVIEW_IMAGES.read_text().splitlines():
            try:
                rows.append(json.loads(line))
            except ValueError:
                continue
    return rows


def image_ids_in_use(slug, role=None):
    """Ids on the last IMAGE_REUSE_WINDOW other previews, and on this one's other pictures: a new
    pick skips them (a rebuild may keep the photo it had in the same place)."""
    rows = image_registry()
    recent, ids = [], set()
    for r in reversed(rows):
        s = r.get("slug")
        if s == slug:
            if r.get("role") != role:
                ids.add(str(r.get("id")))
            continue
        if s not in recent:
            if len(recent) >= IMAGE_REUSE_WINDOW:
                break
            recent.append(s)
        ids.add(str(r.get("id")))
    return ids


def image_register(slug, role, img, term):
    PREVIEW_IMAGES.parent.mkdir(parents=True, exist_ok=True)
    with PREVIEW_IMAGES.open("a") as f:
        f.write(json.dumps({"id": img["id"], "slug": slug, "role": role, "source": img["source"],
                            "term": term, "date": now_date().isoformat()}) + "\n")


def _seed_index(seed, n):
    return int(hashlib.sha1(seed.encode()).hexdigest(), 16) % max(n, 1)


def image_dims(path):
    """(w, h) of a PNG or JPEG without Pillow, or (1600, 1000) when it can't be read."""
    try:
        with open(path, "rb") as f:
            head = f.read(26)
            if head[:8] == b"\x89PNG\r\n\x1a\n":
                return struct.unpack(">II", head[16:24])
            if head[:2] == b"\xff\xd8":
                f.seek(2)
                while True:
                    marker = f.read(2)
                    if len(marker) < 2 or marker[0] != 0xFF:
                        break
                    if marker[1] in (0xC0, 0xC1, 0xC2):
                        f.read(3)
                        h, w = struct.unpack(">HH", f.read(4))
                        return w, h
                    f.seek(struct.unpack(">H", f.read(2))[0] - 2, 1)
    except (OSError, struct.error):
        pass
    return 1600, 1000


def pick_stock(slug, role, terms, dest, width, orientation="landscape"):
    """One Pexels photo for `role` (hero, g1…): the term and the pick chosen by the slug (so a
    rebuild keeps its photos), from the first twenty results, skipping every id another preview
    already shows. Writes dest (a file path). Returns the content.json image row, or None."""
    terms = [t for t in (terms or []) if t]
    if not terms:
        return None
    skip = image_ids_in_use(slug, role)
    dest.parent.mkdir(parents=True, exist_ok=True)
    side = dest.with_suffix(".json")
    try:                                   # a rebuild keeps the photo it had, unless another preview took it since
        kept = json.loads(side.read_text())
        if dest.exists() and kept.get("id") not in skip and kept.get("term") in terms:
            return {k: kept[k] for k in ("file", "source", "id", "credit", "alt")}
    except (OSError, ValueError, KeyError):
        pass
    start = _seed_index(f"{slug}:{role}", len(terms))
    for k in range(len(terms)):
        term = terms[(start + k) % len(terms)]
        with tempfile.TemporaryDirectory() as tmp:
            skipf = Path(tmp) / "skip.txt"
            skipf.write_text("\n".join(sorted(i.split(":", 1)[-1] for i in skip if i.startswith("pexels:"))) + "\n")
            r = subprocess.run([str(IMG_BIN), "stock", term, "-n", "1", "--orientation", orientation,
                                "--width", str(width), "--seed", f"{slug}:{role}", "--skip-file", str(skipf),
                                "--out", str(Path(tmp) / "out"), "--json"], capture_output=True, text=True)
            try:
                got = json.loads(r.stdout or "[]") if r.returncode == 0 else []
            except ValueError:
                got = []
            if not got:
                continue
            g = got[0]
            shutil.move(g["path"], dest)
        row = {"file": str(dest), "source": "stock", "id": f"pexels:{g['id']}",
               "credit": f"Photo: {g.get('photographer') or 'unknown'} on Pexels",
               "alt": (g.get("alt") or term).strip().rstrip(".")[:140] or term}
        image_register(slug, role, row, term)
        side.write_text(json.dumps(dict(row, term=term)) + "\n")
        return row
    print(f"leads: no stock photo for {slug} {role} ({', '.join(terms[:2])}) — PEXELS_API_KEY?", file=sys.stderr)
    return None


def gen_image(slug, role, term, trade, dest):
    """One generated picture (Gemini, through `img gen`, which writes its own ledger row). `img gen
    --out` takes a FILE; 16:9 is an aspect it accepts. Returns the image row, or None."""
    dest.parent.mkdir(parents=True, exist_ok=True)
    side = dest.with_suffix(".json")
    try:                                   # a rebuild never pays twice for the same picture
        kept = json.loads(side.read_text())
        if dest.exists() and kept.get("term") == term:
            return {k: kept[k] for k in ("file", "source", "id", "credit", "alt")}
    except (OSError, ValueError, KeyError):
        pass
    prompt = (f"A realistic photograph for a {trade}'s website: {term}. Natural light, the work and "
              f"the place, no people's faces, no text, no logos.")
    r = subprocess.run([str(IMG_BIN), "gen", "--aspect", "16:9", "--quality", "menu", "--out", str(dest), prompt],
                       capture_output=True, text=True)
    if r.returncode != 0 or not dest.exists():
        print(f"leads: img gen failed for {slug} ({(r.stderr or r.stdout).strip()[-160:]}) — no {role}", file=sys.stderr)
        return None
    row = {"file": str(dest), "source": "generated",
           "id": "gen:" + hashlib.sha1(dest.read_bytes()).hexdigest()[:16],
           "credit": "Generated image", "alt": term[:1].upper() + term[1:]}
    image_register(slug, role, row, term)
    side.write_text(json.dumps(dict(row, term=term)) + "\n")
    return row


def preview_images(slug, copy, mode, into, gallery=4):
    """The pictures a preview carries: a hero and up to `gallery` more, all stock by default, the
    hero generated with --hero gen, none with --hero none. NEVER one of their Google photos."""
    if mode == "none":
        return {}
    heroes = copy.get("heroes") or [copy.get("hero")]
    shots = copy.get("gallery") or heroes
    out = {}
    if mode == "gen":
        row = gen_image(slug, "hero", heroes[0], copy.get("trade") or "local business", into / "hero.png")
    else:
        row = pick_stock(slug, "hero", heroes, into / "hero.jpg", 1600)
    if row:
        out["hero"] = row
    for i in range(1, gallery + 1):
        order = shots[i - 1:] + shots[:i - 1]           # a different first term for each picture
        row = pick_stock(slug, f"g{i}", order, into / f"g{i}.jpg", 1000)
        if row:
            out[f"g{i}"] = row
    return out


def preview_hero(slug, dest, term, mode):
    """The legacy one-page preview's hero (the templates without a section library yet): one stock
    landscape or one generated image under dest/images. Returns (relative src, kind, cost)."""
    if mode == "none":
        return None, None, 0.0
    copy = {"heroes": [term], "trade": "local business"}
    rows = preview_images(slug, copy, mode, dest / "images", gallery=0)
    row = rows.get("hero")
    if not row:
        return None, None, 0.0
    return f"images/{Path(row['file']).name}", row["source"], 0.0


# ---- hours a person reads ---------------------------------------------------------------

def hours_for_people(details, c, say=None):
    """The hours as the site says them. facts.hours.say wins; a service-area trade that Google lists
    as "Open 24 hours" every day is "Call or text any day" (a handyman is not open all night)."""
    if say:
        return [say]
    hrs = hours_lines(details)
    sab = (details or {}).get("pureServiceAreaBusiness") or (c.get("segment") in ("services", "creatives"))
    if sab and hrs and all("24 hours" in h.lower() for h in hrs):
        return ["Call or text any day"]
    return hrs


# ---- the renderer: content.json -> a whole site (plan 28 § Contracts, B64) ---------------------
#
# A template with a section library (templates/sites/<type>/sections/*.html, css/looks/*.css,
# fonts/) is rendered from a content.json: the sections in order into sections/_page.html, the
# type's stylesheet, the library's, the look's, its fonts, its script and its 404, and a photos
# page. The overlay a preview carries sits between markers so the claim can cut it without
# guessing at prose:
#   <!--p:NAME--> … <!--/p:NAME-->     preview only: the claim deletes the block
#   <!--c:NAME\n … \n/c:NAME-->        claim only: commented out on the preview, uncommented by the claim
# Forms are shown and switched off on a preview (a disabled fieldset, "This form goes live when the
# site is claimed.") and switched on by the claim. The section templates use a small language:
# {{key}} (escaped), {{&key}} (raw), <!--each:key-->…<!--/each:key-->, <!--if:key-->…<!--/if:key-->,
# <!--ifnot:key-->…; a {text, facts} object renders as its text.

SECTION_TYPES = ("hero", "proof", "services", "area", "about", "gallery", "quote", "contact",
                 "details", "booking")
SECTION_NEEDS = {"hero": ("heading",), "proof": ("items",), "services": ("heading", "items"),
                 "area": ("heading",), "about": ("heading", "paragraphs"), "gallery": ("heading",),
                 "quote": ("heading",), "contact": ("heading",), "details": ("heading", "where"),
                 "booking": ("heading",)}
TEXT_KEYS = ("heading", "kicker", "intro", "sub", "secondary", "note", "text", "where", "title")
TEXT_LISTS = ("paragraphs", "places", "hours")
NAV = {"services": ("index.html#services", "Services"), "area": ("index.html#area", "Area"),
       "about": ("index.html#about", "About"), "gallery": ("photos.html", "Photos"),
       "booking": ("index.html#booking", "Book"), "quote": ("index.html#quote", "Get a quote"),
       "contact": ("index.html#contact", "Contact"), "details": ("index.html#details", "Hours")}
_EACH = re.compile(r"<!--each:([\w.]+)-->\n?(.*?)<!--/each:\1-->\n?", re.S)
_IF = re.compile(r"<!--(if|ifnot):([\w.]+)-->\n?(.*?)<!--/\1:\2-->\n?", re.S)
_VAR = re.compile(r"\{\{(&?)([\w.]+)\}\}")


def _lookup(ctx, key):
    cur = ctx
    for part in key.split("."):
        if isinstance(cur, dict) and part in cur:
            cur = cur[part]
        else:
            return None
    return cur


def _text(v):
    return v.get("text") if isinstance(v, dict) and "text" in v else v


def render_tpl(tpl, ctx):
    """The section language (above). Loops first, then conditions, then values, one pass each, so a
    value is never read again as template."""
    def each(m):
        items = _lookup(ctx, m.group(1)) or []
        return "".join(render_tpl(m.group(2), dict(ctx, item=it, n=f"{i + 1:02d}",
                                                   item_class="lede" if i == 0 else ""))
                       for i, it in enumerate(items))
    tpl = _EACH.sub(each, tpl)

    def cond(m):
        v = bool(_text(_lookup(ctx, m.group(2))))
        return render_tpl(m.group(3), ctx) if v == (m.group(1) == "if") else ""
    tpl = _IF.sub(cond, tpl)

    def var(m):
        v = _text(_lookup(ctx, m.group(2)))
        v = "" if v is None else v
        return str(v) if m.group(1) else esc(v)
    return _VAR.sub(var, tpl)


def template_looks(kind):
    d = SITE_TEMPLATES / kind / "css" / "looks"
    return sorted(p.stem for p in d.glob("*.css")) if d.is_dir() else []


def has_library(kind):
    return (SITE_TEMPLATES / kind / "sections" / "_page.html").exists() and bool(template_looks(kind))


def content_texts(content):
    """Every text in a content.json, as (where, value): what the schema and the generic cap read."""
    out = [("cta", content.get("cta"))]
    for i, s in enumerate(content.get("sections") or []):
        at = f"sections[{i}] {s.get('type')}"
        for k in TEXT_KEYS:
            if k in s:
                out.append((f"{at}.{k}", s[k]))
        for k in TEXT_LISTS:
            for j, v in enumerate(s.get(k) or []):
                out.append((f"{at}.{k}[{j}]", v))
        for j, it in enumerate(s.get("items") or []):
            if isinstance(it, dict) and "title" in it:
                out += [(f"{at}.items[{j}].title", it.get("title")), (f"{at}.items[{j}].text", it.get("text"))]
            else:
                out.append((f"{at}.items[{j}]", it))
        for j, it in enumerate(s.get("links") or []):
            out.append((f"{at}.links[{j}]", it))
        if "phone" in s:
            out.append((f"{at}.phone", s["phone"]))
    return out


def validate_content(content, base, look=None):
    """The content.json contract (plan 28 § Contracts, schema 1). Returns a list of problems."""
    errs = []
    if not isinstance(content, dict):
        return ["content.json is not an object"]
    if content.get("schema", 1) != 1:
        errs.append(f"schema {content.get('schema')!r}: this renderer reads schema 1")
    for k in ("slug", "template", "look", "name", "cta", "sections"):
        if not content.get(k):
            errs.append(f"missing {k}")
    if errs:
        return errs
    if not re.fullmatch(r"[a-z0-9-]{3,80}", content["slug"]):
        errs.append(f"slug {content['slug']!r}: lowercase letters, digits and dashes, 3-80")
    kind = content["template"]
    if not has_library(kind):
        errs.append(f"template {kind!r} has no section library (templates/sites/{kind}/sections, css/looks)")
        return errs
    want = look or content["look"]
    if want not in template_looks(kind):
        errs.append(f"look {want!r}: the {kind} template has {', '.join(template_looks(kind))}")
    lib = SITE_TEMPLATES / kind / "sections"
    images = content.get("images") or {}
    for key, im in images.items():
        if not isinstance(im, dict):
            errs.append(f"images.{key} is not an object")
            continue
        for f in ("file", "source", "id", "alt"):
            if not im.get(f):
                errs.append(f"images.{key}: missing {f}")
        if im.get("source") not in ("stock", "generated"):
            errs.append(f"images.{key}: source is stock or generated")
        p = Path(im.get("file") or "")
        if not p.is_absolute():
            p = base / p
        if im.get("file") and not p.is_file():
            errs.append(f"images.{key}: no file at {p}")
    types = []
    for i, s in enumerate(content["sections"]):
        t = s.get("type") if isinstance(s, dict) else None
        if t not in SECTION_TYPES or not (lib / f"{t}.html").exists():
            errs.append(f"sections[{i}]: type {t!r} is not in the {kind} library "
                        f"({', '.join(p.stem for p in sorted(lib.glob('[a-z]*.html')) if p.stem != 'photos_head')})")
            continue
        types.append(t)
        for need in SECTION_NEEDS[t]:
            if not s.get(need):
                errs.append(f"sections[{i}] {t}: missing {need}")
        for key in ([s.get("image")] if s.get("image") else []) + list(s.get("images") or []):
            if key not in images:
                errs.append(f"sections[{i}] {t}: image {key!r} is not in images{{}}")
    if types.count("hero") != 1:
        errs.append("exactly one hero section")
    generic = set(content.get("generic") or [])
    for where, v in content_texts(content):
        if not isinstance(v, dict) or "text" not in v or not isinstance(v.get("facts", None), list):
            errs.append(f"{where}: a text is {{\"text\": …, \"facts\": [...]}}")
        elif not v["facts"] and v["text"] not in generic:
            errs.append(f"{where}: no facts and not listed in generic[]: {v['text'][:60]!r}")
    if not (content["cta"].get("href") if isinstance(content["cta"], dict) else None):
        errs.append("cta: missing href")
    return errs


def _facts_beside(base):
    try:
        return json.loads((base / "facts.json").read_text())
    except (OSError, ValueError):
        return {}


def claim_link(content, base):
    """patchlamp.com/start filled with the business, the one the footer's "Claim it" opens (B66
    reads business, city, category and preview from it)."""
    facts = _facts_beside(base)
    q = [("business", content["name"])]
    for k in ("city", "category"):
        v = content.get(k) or facts.get(k)
        if v:
            q.append((k, v))
    q.append(("preview", content["slug"]))
    return CLAIM_START + "?" + urllib.parse.urlencode(q)


def _copy_site_files(tdir, out, name, year):
    vals = {"NAME": esc(name), "YEAR": str(year)}
    (out / "css" / "looks").mkdir(parents=True, exist_ok=True)
    (out / "js").mkdir(parents=True, exist_ok=True)
    (out / "css" / "style.css").write_text(fill_preview((tdir / "css" / "style.css").read_text(), vals))
    if (tdir / "css" / "sections.css").exists():
        shutil.copy2(tdir / "css" / "sections.css", out / "css" / "sections.css")
    for p in sorted((tdir / "css" / "looks").glob("*.css")):
        shutil.copy2(p, out / "css" / "looks" / p.name)
    if (tdir / "fonts").is_dir():
        shutil.copytree(tdir / "fonts", out / "fonts", dirs_exist_ok=True)
    (out / "js" / "main.js").write_text(fill_preview((tdir / "js" / "main.js").read_text(), vals))
    if (tdir / "404.html").exists():
        (out / "404.html").write_text(fill_preview((tdir / "404.html").read_text(), vals))
    (out / "css" / "preview.css").write_text((PREVIEW_OVERLAY / "css" / "preview.css").read_text())


def render_content(content, base, out, today=None, days=PREVIEW_DAYS, look=None):
    """content.json -> the whole site under `out` (index.html, photos.html, 404.html, css/, fonts/,
    images/, js/, claim/). Dies on a content.json that breaks the contract. Returns a summary."""
    today = today or now_date()
    errs = validate_content(content, base, look)
    if errs:
        die("content.json doesn't fit the contract (plan 28 § Contracts):\n  " + "\n  ".join(errs))
    kind, look = content["template"], look or content["look"]
    tdir = SITE_TEMPLATES / kind
    lib = tdir / "sections"
    name, slug = content["name"], content["slug"]
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    _copy_site_files(tdir, out, name, today.year)

    imgs = {}
    for key, im in (content.get("images") or {}).items():
        src = Path(im["file"]) if Path(im["file"]).is_absolute() else base / im["file"]
        (out / "images").mkdir(exist_ok=True)
        target = out / "images" / (key + src.suffix.lower())
        shutil.copy2(src, target)
        w, h = image_dims(target)
        label = "Stock photo — their own go here" if im["source"] == "stock" else "Made with AI — their own go here"
        imgs[key] = {"src": f"images/{target.name}", "alt": im["alt"], "w": w, "h": h, "label": label,
                     "credit": im.get("credit") or "", "source": im["source"], "id": im["id"]}

    cta = dict(content["cta"])
    cta.setdefault("short", (_text(cta) or "Call").split(" ")[0])
    types = [s["type"] for s in content["sections"]]
    second = next((f"#{t}" for t in ("quote", "booking", "contact", "details") if t in types), "#details")
    gallery_keys = []
    for s in content["sections"]:
        gallery_keys += [k for k in (s.get("images") or []) if k not in gallery_keys]
    photo_keys = [k for k in (["hero"] if "hero" in imgs else []) + gallery_keys + [
        s.get("image") for s in content["sections"] if s.get("image")] if k]
    photo_keys = list(dict.fromkeys(photo_keys))
    has_photos = True             # every site has its photos page, as the template does (the claim keeps it)

    def section_html(s, alt):
        ctx = dict(s, name=name, cta=cta, alt=" alt" if alt else "", secondary_href=second,
                   image=imgs.get(s.get("image")) if s.get("image") else None,
                   images=[imgs[k] for k in (s.get("images") or []) if k in imgs],
                   has_image=" has-image" if s.get("image") else "")
        if s["type"] == "gallery":
            ctx["more"] = has_photos and len(photo_keys) > len(ctx["images"])
        html_ = render_tpl((lib / f"{s['type']}.html").read_text(), ctx)
        if s.get("claim_only"):
            # the claimed site gets it (the template's own feature); the preview shows nothing of it
            inner = re.sub(r"[ \t]*<!--(?!c:|/c:).*?-->\n?", "", claim_page(html_), flags=re.S).replace("-->", "")
            return f"<!--c:{s['type']}\n{inner.rstrip()}\n/c:{s['type']}-->\n"
        return html_

    body, alt = [], False
    for s in content["sections"]:
        banded = s["type"] not in ("hero", "proof")
        body.append(section_html(s, alt and banded))
        if banded and not s.get("claim_only"):
            alt = not alt
    hero = next(s for s in content["sections"] if s["type"] == "hero")
    shown = [t for t in ("services", "about", "area", "booking", "quote", "contact")
             if t in types and not any(x.get("claim_only") for x in content["sections"] if x["type"] == t)]
    ask = [t for t in shown if t in ("booking", "quote", "contact")][-1:]
    nav = [{"href": NAV[t][0], "label": NAV[t][1]}
           for t in [t for t in shown if t not in ("booking", "quote", "contact")][:2] + ["gallery"] + ask]
    expires = today + dt.timedelta(days=days)
    page_ctx = {"bar": render_tpl((PREVIEW_OVERLAY / "bar.html").read_text(), {"name": name}),
                "name": name, "look": look, "cta": cta, "nav": nav, "year": today.year,
                "photos": has_photos, "admin": bool(json.loads((tdir / "template.json").read_text()).get("db")),
                # the footer badge a claimed site carries (B60): the segment page this
                # kind of site belongs to, from its template.json
                "badge": json.loads((tdir / "template.json").read_text()).get("badge", "https://patchlamp.com/?from=badge"),
                "expires_long": expires.strftime("%-d %B %Y"), "built_long": today.strftime("%-d %B %Y"),
                "description": f"{name} — {_text(hero['heading'])}"}
    frame = (lib / "_page.html").read_text()
    pages = {"index.html": render_tpl(frame, dict(page_ctx, page="home", page_title=name,
                                                   sections="".join(body)))}
    if has_photos:
        head = render_tpl((lib / "photos_head.html").read_text(), {"heading": "Photos"})
        gal = render_tpl((lib / "gallery.html").read_text(),
                         {"heading": f"{name}, in pictures", "alt": "", "more": False,
                          "images": [imgs[k] for k in photo_keys]})
        pages["photos.html"] = render_tpl(frame, dict(page_ctx, page="photos", page_title=f"Photos — {name}",
                                                       sections=head + gal))
    for fname, html_ in pages.items():
        html_ = re.sub(r"\n{3,}", "\n\n", html_)
        left = sorted(set(re.findall(r"\{\{&?[\w.]+\}\}", html_)))
        if left:
            die(f"unfilled in {slug}/{fname}: {', '.join(left)}")
        (out / fname).write_text(html_)
    link = claim_link(content, base)
    (out / "claim").mkdir(exist_ok=True)
    (out / "claim" / "index.html").write_text(fill_preview((PREVIEW_OVERLAY / "claim.html").read_text(),
                                                           {"NAME": esc(name), "CLAIM_URL": esc(link)}))
    size = sum(p.stat().st_size for p in out.rglob("*") if p.is_file())
    return {"slug": slug, "template": kind, "look": look, "out": str(out), "pages": sorted(pages),
            "images": {k: {"id": v["id"], "source": v["source"]} for k, v in imgs.items()},
            "claim_url": link, "expires": expires.isoformat(), "bytes": size}


def content_from_listing(c, details, copy, slug, look, images, kind):
    """`leads preview NAME`'s content.json: the listing's facts (name, city, phone, rating, hours)
    and the category's words from categories.json, the category's words all declared generic (none
    of them is something this business told us), and the preview says so above the list."""
    name = clean_name(c["name"])
    city = (c.get("locality") or (c.get("city") or "").replace(", Utah", "")).strip()
    d = details or {}
    phone = d.get("nationalPhoneNumber") or c.get("phone") or ""
    rating = d.get("rating") if details else c.get("rating")
    reviews = d.get("userRatingCount") if details else c.get("reviews")
    maps = clean_maps(d.get("googleMapsUri") or c.get("google_maps_uri"))
    words = {"name": name, "city": city or "the valley", "category": copy["category"], "trade": copy["trade"]}
    generic = []

    def T(text, *facts):
        if not facts:
            generic.append(text)
        return {"text": text, "facts": list(facts)}

    where = preview_where(c, details, city)
    label = copy["category"][:1].upper() + copy["category"][1:]
    cta = dict(T(f"Call {phone}", "listing:phone"), href=f"tel:{phone_href(phone)}") if phone else \
        dict(T("See the listing", "listing:maps"), href=maps or "#details")
    hours = hours_for_people(details, c)
    heads = [h for h, _ in copy["services"]]
    hero = {"type": "hero", "kicker": T(f"{label} · {city}" if city else label, "listing:category", "listing:city"),
            "heading": T(copy["tagline"].format(**words), "listing:category", "listing:city"),
            "sub": T(" · ".join(heads[:3])), "secondary": T(copy["cta"])}
    if "hero" in images:
        hero["image"] = "hero"
    proof = []
    if rating is not None and reviews:
        proof.append(dict(T(f"{float(rating):.1f}★ on Google · {reviews} review{'s' if reviews != 1 else ''}",
                            "listing:rating"), **({"href": maps} if maps else {})))
    proof.append(T(where, "listing:city"))
    if len(hours) == 1:
        proof.append(T(hours[0], "listing:hours"))
    sections = [hero]
    if proof:
        sections.append({"type": "proof", "items": proof})
    sections.append({"type": "services", "heading": T("What we do"),
                     "note": T(f"What a {copy['trade']} is usually asked for — written from the category on "
                               f"their Google listing, not from anything {name} has told us. On their own site "
                               f"this is their list, in their words."),
                     "items": [{"title": T(h), "text": T(l.format(**words))} for h, l in copy["services"]]})
    about = {"type": "about", "heading": T(f"About {name}"), "paragraphs": [T(copy["intro"].format(**words))]}
    if "g1" in images:
        about["image"] = "g1"
    gal = [k for k in ("g2", "g3", "g4") if k in images]
    phone_row = dict(T(phone, "listing:phone"), href=f"tel:{phone_href(phone)}") if phone else None
    links = [dict(T("See us on Google", "listing:maps"), href=maps)] if maps else []
    if kind == "service":
        sections.append(about)
        if gal:
            sections.append({"type": "gallery", "heading": T("Recent work"), "images": gal})
        q = {"type": "quote", "heading": T("Ask for a quote"),
             "intro": T("Tell us what you need and we'll get back to you with a price.")}
        if phone_row:
            q["phone"] = phone_row
        sections.append(q)
        # the service template's calendar: on the claimed site from day one, never on the preview
        sections.append({"type": "booking", "claim_only": True, "heading": T("Book a visit"),
                         "intro": T("Pick an open time. We'll confirm by email or phone.")})
    else:
        if gal:
            sections.append({"type": "gallery", "heading": T("Selected work"), "images": gal})
        sections.append(about)
        sections.append({"type": "contact", "heading": T("Get in touch"),
                         "intro": T("Call to ask about a date."), "links": links})
    det = {"type": "details", "heading": T("Hours and contact"), "where": T(where, "listing:city"),
           "hours": [T(h, "listing:hours") for h in hours], "links": links}
    if phone_row:
        det["phone"] = phone_row
    sections.append(det)
    return {"schema": 1, "slug": slug, "template": kind, "look": look, "name": name,
            "place_id": c.get("place_id"), "city": city, "category": c.get("category") or copy["category"],
            "cta": cta, "images": images, "sections": sections, "generic": sorted(set(generic))}


def preview_content_dir(slug):
    return PREVIEWS / "content" / slug


def build_preview(c, details, args, taken, today=None):
    """One preview. A template with a section library: write content.json from the listing and
    categories.json, then render it (the one renderer, `--from`'s). Else the legacy one page."""
    today = today or now_date()
    copy = preview_copy(c.get("category"))
    kind = copy["template"]
    if not has_library(kind):
        return build_legacy_preview(c, details, args, taken, today)
    name = clean_name(c["name"])
    city = (c.get("locality") or (c.get("city") or "").replace(", Utah", "")).strip()
    slug = (c.get("_slug") or preview_slug(name, city, taken))
    looks = template_looks(kind)
    look = getattr(args, "look", None) or looks[_seed_index(slug, len(looks))]
    if look not in looks:
        die(f"--look {look}: the {kind} template has {', '.join(looks)}")
    cdir = preview_content_dir(slug)
    (cdir / "images").mkdir(parents=True, exist_ok=True)       # kept: a rebuild keeps its photos
    images = preview_images(slug, copy, args.hero, cdir / "images")
    for im in images.values():
        im["file"] = str(Path(im["file"]).relative_to(cdir))
    content = content_from_listing(c, details, copy, slug, look, images, kind)
    (cdir / "content.json").write_text(json.dumps(content, indent=1, ensure_ascii=False) + "\n")
    info = render_content(content, cdir, preview_site_dir() / slug, today=today, days=args.days)
    d = details or {}
    meta = {"slug": slug, "place_id": c.get("place_id"), "name": name, "city": city,
            "category": copy["category"], "segment": c.get("segment") or "", "template": kind, "look": look,
            "phone": d.get("nationalPhoneNumber") or c.get("phone") or "",
            "rating": d.get("rating") if details else c.get("rating"),
            "reviews": d.get("userRatingCount") if details else c.get("reviews"),
            "maps_url": clean_maps(d.get("googleMapsUri") or c.get("google_maps_uri")),
            "hero": (images.get("hero") or {}).get("source", "none"), "images": sorted(i["id"] for i in images.values()),
            "built": today.isoformat(), "expires": info["expires"], "days": args.days,
            "hours": bool(hours_lines(details)), "url": preview_url(slug), "claimed": None,
            "content": str(cdir / "content.json"), "claim_url": info["claim_url"], "cost_usd": 0.0}
    preview_save(meta)
    ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "preview",
                   "tool": "leads", "cost_usd": 0.0, "billed_to": "none", "project": "global", "slug": slug,
                   "hero": meta["hero"], "look": look, "for": f"preview {name} ({copy['category']})"})
    return meta


def preview_from(args):
    """`leads preview --from content.json [--out DIR] [--look L]`: render one content.json. With
    --out the site goes there and nothing is recorded; without it the site goes into the previews
    tree at <slug>/ with its manifest (what ls, --claim and --remove read)."""
    src = Path(args.from_file).expanduser().resolve()
    try:
        content = json.loads(src.read_text())
    except (OSError, ValueError) as exc:
        die(f"{src}: {exc}")
    today = now_date()
    if args.out:
        info = render_content(content, src.parent, Path(args.out).expanduser().resolve(), today=today,
                              days=args.days, look=args.look)
    else:
        info = render_content(content, src.parent, preview_site_dir() / content["slug"], today=today,
                              days=args.days, look=args.look)
        preview_root_files()
        facts = _facts_beside(src.parent)
        old = next((m for m in previews_all() if m["slug"] == content["slug"]), {})
        meta = dict(old, slug=content["slug"], place_id=content.get("place_id") or facts.get("place_id"),
                    name=content["name"], city=content.get("city") or facts.get("city") or "",
                    category=content.get("category") or facts.get("category") or "",
                    segment=content.get("segment") or facts.get("segment") or old.get("segment") or "",
                    template=info["template"], look=info["look"], built=today.isoformat(),
                    expires=info["expires"], days=args.days, url=preview_url(content["slug"]),
                    claimed=old.get("claimed"), content=str(src), claim_url=info["claim_url"],
                    hero=(info["images"].get("hero") or {}).get("source", "none"),
                    images=sorted(v["id"] for v in info["images"].values()),
                    hours=any(s.get("hours") for s in content["sections"] if s.get("type") == "details"),
                    cost_usd=old.get("cost_usd", 0.0))
        preview_save(meta)
        if not args.no_publish:
            ok, _ = preview_publish(dry=args.dry_run)
            if not ok:
                die("the publish failed; the site is under " + info["out"], 2)
    if args.json:
        print(json.dumps(info, indent=1))
        return
    print(f"rendered {info['slug']} ({info['template']}, look {info['look']}) -> {info['out']}  "
          f"[{', '.join(info['pages'])}, {info['bytes'] // 1024} KB]")
    print(f"  claim link: {info['claim_url']}")


def build_legacy_preview(c, details, args, taken, today=None):
    """One preview: the segment's template filled from the listing. Returns its manifest."""
    today = today or now_date()
    copy = preview_copy(c.get("category"))
    kind = copy["template"]
    tdir = SITE_TEMPLATES / kind
    if not (tdir / "css" / "style.css").exists():
        die(f"templates/sites/{kind} has no css/style.css (categories.json points at it)")
    name = clean_name(c["name"])
    city = (c.get("locality") or (c.get("city") or "").replace(", Utah", "")).strip()
    slug = (c.get("_slug") or preview_slug(name, city, taken))
    dest = preview_site_dir() / slug
    if dest.exists():
        shutil.rmtree(dest)
    (dest / "css").mkdir(parents=True, exist_ok=True)
    (dest / "js").mkdir(parents=True, exist_ok=True)
    vals = {"NAME": esc(name), "YEAR": str(today.year)}
    (dest / "css" / "style.css").write_text(fill_preview((tdir / "css" / "style.css").read_text(), vals))
    (dest / "css" / "preview.css").write_text((PREVIEW_OVERLAY / "css" / "preview.css").read_text())
    (dest / "js" / "main.js").write_text(fill_preview((tdir / "js" / "main.js").read_text(), vals))

    d = details or {}
    phone = d.get("nationalPhoneNumber") or c.get("phone") or ""
    rating = d.get("rating") if details else c.get("rating")
    reviews = d.get("userRatingCount") if details else c.get("reviews")
    maps = clean_maps(d.get("googleMapsUri") or c.get("google_maps_uri"))
    hero_src, hero_kind, hero_cost = preview_hero(slug, dest, copy["hero"], args.hero)
    hrs = hours_for_people(details, c)
    expires = today + dt.timedelta(days=args.days)
    words = {"name": name, "city": city or "the valley", "category": copy["category"], "trade": copy["trade"]}

    hero_block = ""
    if hero_src:
        hero_block = (f'    <figure class="hero-photo">\n'
                      f'      <img src="{hero_src}" alt="{esc(copy["trade"]).capitalize()} work" width="1200" height="400">\n'
                      f'<!--p:herocap-->\n'
                      f'      <figcaption>A stock photo, not {esc(name)}\'s — their own go here.</figcaption>\n'
                      f'<!--/p:herocap-->\n'
                      f'    </figure>')
    rating_block = ""
    if rating is not None and reviews:
        line = (f'<span class="stars">{float(rating):.1f}&#9733;</span> on Google, '
                f'{reviews} review{"s" if reviews != 1 else ""}')
        rating_block = (f'        <p class="rating-line">{line}'
                        + (f' &mdash; <a href="{esc(maps)}">see the listing</a>' if maps else "") + '</p>')
    hours_block = ("            <ul>\n" + "\n".join(f"              <li>{esc(h)}</li>" for h in hrs) + "\n            </ul>"
                   if hrs else
                   f'            <p class="muted">Google doesn\'t show hours for {esc(name)} yet &mdash; '
                   f'this is where they go.</p>')
    services = "\n".join(f'          <li><h3>{esc(h)}</h3><p class="card-meta">{esc(l.format(**words))}</p></li>'
                         for h, l in copy["services"])
    listing_li = f'              <li><a href="{esc(maps)}">Their listing on Google</a></li>' if maps else ""

    page = fill_preview((PREVIEW_OVERLAY / "page.html").read_text(), {
        "NAME": esc(name), "TAGLINE": esc(copy["tagline"].format(**words)),
        "INTRO": esc(copy["intro"].format(**words)), "TRADE": esc(copy["trade"]),
        "CTA": esc(copy["cta"]), "PHONE": esc(phone or "no number on Google"),
        "PHONE_HREF": esc(phone_href(phone)), "HERO_BLOCK": hero_block, "RATING_BLOCK": rating_block,
        "SERVICES": services, "WHERE": esc(preview_where(c, details, city)), "HOURS_BLOCK": hours_block,
        "LISTING_LI": listing_li, "YEAR": str(today.year),
        "EXPIRES_LONG": expires.strftime("%-d %B %Y"), "BUILT_LONG": today.strftime("%-d %B %Y"),
    })
    if "{{" in page:
        die(f"unfilled placeholder in {slug}: " + ", ".join(sorted(set(re.findall(r'\{\{[A-Z_]+\}\}', page)))))
    (dest / "index.html").write_text(re.sub(r"\n{3,}", "\n\n", page))
    link = claim_link({"name": name, "slug": slug, "city": city, "category": c.get("category") or copy["category"]},
                      dest)
    (dest / "claim").mkdir(exist_ok=True)
    (dest / "claim" / "index.html").write_text(fill_preview((PREVIEW_OVERLAY / "claim.html").read_text(),
                                                            {"NAME": esc(name), "CLAIM_URL": esc(link)}))
    meta = {"slug": slug, "place_id": c.get("place_id"), "name": name, "city": city,
            "category": copy["category"], "segment": c.get("segment") or "", "template": kind,
            "phone": phone, "rating": rating, "reviews": reviews, "maps_url": maps,
            "hero": hero_kind or "none", "built": today.isoformat(), "expires": expires.isoformat(),
            "days": args.days, "hours": bool(hrs), "url": preview_url(slug), "claimed": None,
            "cost_usd": round(hero_cost, 4)}
    preview_save(meta)
    ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "preview",
                   "tool": "leads", "cost_usd": round(hero_cost, 4), "billed_to": "none",
                   "project": "global", "slug": slug, "hero": hero_kind or "none",
                   "for": f"preview {meta['name']} ({copy['category']})"})
    return meta


def preview_host():
    """The host previews are served from: the custom domain once its CNAME exists, else the
    project's own pages.dev host (resolved once and remembered)."""
    cache = PREVIEWS / "project.json"
    if os.environ.get("LEADS_PREVIEW_HOST"):
        return os.environ["LEADS_PREVIEW_HOST"]
    try:
        row = json.loads(cache.read_text())
    except (OSError, ValueError):
        row = {}
    return row.get("domain") or row.get("pages_host") or f"{PREVIEW_PROJECT}.pages.dev"


def preview_url(slug):
    return f"https://{preview_host()}/{slug}/"


def preview_root_files():
    """The files the previews project needs at its root: the "nothing to see here" page, the
    404 an expired preview falls to, robots.txt and _headers (both halves of noindex)."""
    site = preview_site_dir()
    (site / "css").mkdir(parents=True, exist_ok=True)
    (site / "js").mkdir(parents=True, exist_ok=True)
    base = SITE_TEMPLATES / "business"
    (site / "css" / "style.css").write_text(fill_preview((base / "css" / "style.css").read_text(),
                                                         {"NAME": "Patchlamp previews"}))
    (site / "css" / "preview.css").write_text((PREVIEW_OVERLAY / "css" / "preview.css").read_text())
    (site / "js" / "main.js").write_text(fill_preview((base / "js" / "main.js").read_text(),
                                                      {"NAME": "Patchlamp previews"}))
    (site / "index.html").write_text((PREVIEW_OVERLAY / "root.html").read_text())
    (site / "404.html").write_text((PREVIEW_OVERLAY / "404.html").read_text())
    (site / "robots.txt").write_text((PREVIEW_OVERLAY / "robots.txt").read_text())
    (site / "_headers").write_text((PREVIEW_OVERLAY / "_headers").read_text())


def preview_publish(dry=False):
    """The whole tree -> the one Pages project, through `site previews` (SITE_ADMIN: it makes and
    writes an account-level project). Returns (ok, the host it reports)."""
    preview_root_files()
    cmd = [str(SITE_BIN), "previews", str(preview_site_dir()), "--project", PREVIEW_PROJECT]
    if dry:
        cmd.append("--dry-run")
    if os.environ.get("LEADS_PREVIEW_YES") == "1":      # Taylor's word, once, for the project's first publish
        cmd.append("--yes")
    r = subprocess.run(cmd, capture_output=True, text=True, env=dict(os.environ, SITE_ADMIN="1"))
    out = (r.stdout + r.stderr).strip()
    print(out)
    host = None
    m = re.search(r"pages host:\s*(\S+)", out)
    if m:
        host = m.group(1)
        PREVIEWS.mkdir(parents=True, exist_ok=True)
        row = {}
        try:
            row = json.loads((PREVIEWS / "project.json").read_text())
        except (OSError, ValueError):
            pass
        row["pages_host"] = host
        row["project"] = PREVIEW_PROJECT
        for dom in re.findall(r"domain:\s*(\S+)\s+active", out):
            row["domain"] = dom
        (PREVIEWS / "project.json").write_text(json.dumps(row, indent=1, sort_keys=True) + "\n")
    return r.returncode == 0, host


def preview_rows_for(args):
    """The businesses to build previews for: the names given, or today's remote-kit picks, or the
    nearest N of the segment's pool. Each comes back as (candidate, details)."""
    segment = resolve_segment(args.segment)
    key, where = (None, None) if args.census_only else places_key()
    places = Places(key, where, fixture=args.fixture, refresh=args.refresh)
    rows, cands = [], candidates_for(segment, args.min_reviews)
    by_id = {c["place_id"]: c for c in cands}
    if getattr(args, "place", None):
        # B90: the email lane's businesses mostly have a site of their own, so they are not in the kit's pool;
        # the census row by id is enough for the template fill.
        c = by_id.get(args.place) or next(iter(_census_by_id(args.place)), None)
        if not c:
            die(f"no place {args.place} in the census")
        rows.append(c)
    elif args.name:
        for raw in args.name:
            nm, _, city = raw.partition(",")
            hits = census_lookup(nm.strip(), city.strip() or None)
            if not hits:
                die(f"{raw!r} isn't in the census — `leads candidates --segment {segment}` lists the pool, "
                    f'or name the city: "Name, American Fork"')
            c = by_id.get(hits[0][1]["place_id"]) or hits[0][1]
            if len(hits) > 1 and not city.strip():
                print("leads: also matched " + ", ".join(f"{h[1]['name']} ({h[1]['locality'] or '?'})"
                                                         for h in hits[1:3]) + " — add the city to pick another",
                      file=sys.stderr)
            rows.append(c)
    elif args.kit:
        picks = preview_kit_picks(segment, args.n)
        if not picks:
            die(f"no remote kit today and no {SEGMENT_NOUN[segment]} in the pool; "
                f"run `leads kit --remote` first, or name a business")
        rows = [by_id.get(p) or _census_by_id(p) for p in picks]
        rows = [r for r in rows if r]
    else:
        die("which business? `leads preview \"Name, City\"`, or --kit for today's six")
    out = []
    for c in rows[:max(args.n, len(args.name or []))]:
        details = places.get(c["place_id"]) if (key or args.fixture) else None
        if places.failed and not args.fixture:
            details = None
        out.append((c, details))
    if places.calls:
        ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
                       "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
                       "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global",
                       "for": f"previews {segment} {now_date()}"})
    return out


def preview_kit_picks(segment, n):
    """Today's remote-kit place ids for this segment (so a preview matches the message that carries
    its link), else the nearest n of the pool that aren't previewed yet."""
    today = now_date().isoformat()
    log = STATE / "remote.jsonl"
    if log.exists():
        for line in reversed(log.read_text().splitlines()):
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if row.get("for") == today and (row.get("segment") or "restaurant") == segment:
                return row.get("place_ids") or []
    have = {m.get("place_id") for m in previews_all()}
    return [c["place_id"] for c in candidates_for(segment, None) if c["place_id"] not in have][:n]


def make_previews(rows, hero="stock", days=PREVIEW_DAYS, publish=True, dry=False, look=None):
    """Build a preview for each (candidate, details) and publish the tree once. A place that already
    has one is rebuilt in place, keeping its slug so a link already sent still works."""
    opts = argparse.Namespace(hero=hero, days=days, look=look)
    preview_root_files()       # the tree is complete on disk whether or not it is published
    taken = {m["slug"] for m in previews_all()}
    made = []
    for c, details in rows:
        existing = next((m for m in previews_all() if m.get("place_id") == c["place_id"]), None)
        if existing:
            c = dict(c, _slug=existing["slug"])
        made.append(build_preview(c, details, opts, taken))
        taken.add(made[-1]["slug"])
    ok = True
    if publish and made:
        ok, _ = preview_publish(dry=dry)
    for m in made:
        m["url"] = preview_url(m["slug"])
        preview_save(m)
    return made, ok


def previews_build(args):
    if getattr(args, "place", None) and args.json:
        return preview_place_json(args)
    rows = preview_rows_for(args)
    made, ok = make_previews(rows, hero=args.hero, days=args.days,
                             publish=not args.no_publish, dry=args.dry_run, look=args.look)
    if args.no_publish:
        print(f"built {len(made)} preview(s) under {preview_site_dir()} — not published (--no-publish)")
    elif not ok:
        die("the publish failed; the filled pages are still under " + str(preview_site_dir()), 2)
    if args.json:
        print(json.dumps(made, indent=1))
        return
    for m in made:
        print(f"  {m['name']} ({m['category']}, {m['template']} template"
              + (f", look {m['look']}" if m.get("look") else "") + f") -> {m['url']}"
              + ("" if m["hours"] else "  [no hours on Google]"))
    print(f"{len(made)} preview(s); each comes down {made[0]['expires'] if made else '-'} unless claimed "
          f"(`leads preview sweep`, or `leads preview --remove NAME` now).")


def preview_place_json(args):
    """`leads preview --place PLACE_ID --json` (B90, plan 37 § Contract): one business's preview, built (or rebuilt
    on its old slug) and published, as one JSON object on stdout — `url` is what the reply carries. The publish's own
    talk goes to stderr so stdout stays one object; a failure is still one object, with ok false and why, exit 2."""
    try:
        with contextlib.redirect_stdout(sys.stderr):
            rows = preview_rows_for(args)
            made, ok = make_previews(rows, hero=args.hero, days=args.days, publish=not args.no_publish,
                                     dry=args.dry_run, look=args.look)
    except SystemExit as exc:
        print(json.dumps({"ok": False, "place_id": args.place, "url": None,
                          "why": f"leads stopped (exit {exc.code}); its reason is on stderr"}))
        sys.exit(2)
    m = made[0] if made else {}
    out = {"ok": bool(made) and ok, "place_id": args.place, "url": m.get("url"), "slug": m.get("slug"),
           "name": m.get("name"), "category": m.get("category"), "city": m.get("city"),
           "expires": m.get("expires"), "published": bool(made) and ok and not args.no_publish and not args.dry_run}
    if not out["ok"]:
        out["why"] = "the publish failed; the filled pages are under " + str(preview_site_dir())
    print(json.dumps(out, indent=1))
    if not out["ok"]:
        sys.exit(2)


# ---- the press link (B91, ~/projects/plans/41-the-press-link.md) ------------------------------------------------
#
# The second and third batch letters carry `OUTREACH_LINK_BASE/<token>`, the token `outreach` minted per business
# (`secrets.token_urlsafe(9)` in its state dir's sequences.json, read here and never written). The page on the
# sending domain knows only sha256(token). Two calls, both one JSON object on stdout, made by the relay's
# press poll (sms-relay/relay/press.py), never by a timer of their own:
#
#   leads preview --press-tokens --json      {"ok", "links": [{"hash", "state": active|removed}]} for every
#                                            sequence with a token; removed = its address, the address's domain,
#                                            or its place is suppressed. No list without the suppression list.
#   leads preview --from-press HASH|TOKEN --json
#                                            {"ok", "state": ready|removed|unknown|failed, "url", "reused",
#                                            "place_id", "name", "city", "first", "brief", "why", "build_tail"}
#                                            ready: an unclaimed preview under its 30 days is reused, else one is
#                                            built and published as `--place` does. first: this business's first
#                                            press (presses.jsonl in the state dir), which carries the brief for
#                                            Taylor's notify, logs the lead as interested once (not again after a
#                                            yes), and runs `outreach pressed` (its touches stop; `build_tail` is
#                                            B92's "reply `build`" line for the end of Taylor's message).

def press_hash(token):
    return hashlib.sha256(str(token).encode()).hexdigest()


def press_sequences():
    """outreach's sequences, read-only (its OUTREACH_STATE, the same default as outreach's)."""
    d = Path(os.environ.get("OUTREACH_STATE") or Path.home() / ".local/state/claude-tools/outreach")
    try:
        data = json.loads((d / "sequences.json").read_text())
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as exc:
        raise RuntimeError(f"{d / 'sequences.json'}: {exc}")
    return [x for x in data if isinstance(x, dict) and x.get("token")] if isinstance(data, list) else []


def press_removed(seq, supp):
    e = str(seq.get("email") or "").strip().lower()
    dom = e.split("@", 1)[1] if "@" in e else ""
    vals = {v for v in (e, dom, "@" + dom if dom else "", str(seq.get("place_id") or "").strip().lower()) if v}
    return bool(supp & vals)


def press_out(obj, code=0):
    print(json.dumps(obj, indent=1))
    sys.exit(code)


def press_tokens(args):
    supp, where = suppressed()
    if supp is None:
        press_out({"ok": False, "links": [], "why": where}, 2)          # never a list that forgets who said no
    try:
        seqs = press_sequences()
    except RuntimeError as exc:
        press_out({"ok": False, "links": [], "why": str(exc)}, 2)
    links, seen = [], set()
    for q in seqs:
        h = press_hash(q["token"])
        if h in seen:
            continue
        seen.add(h)
        links.append({"hash": h, "state": "removed" if press_removed(q, supp) else "active"})
    press_out({"ok": True, "links": links, "count": len(links)})


def press_log():
    return STATE / "presses.jsonl"


def press_seen(place_id):
    p = press_log()
    if not p.exists():
        return False
    for line in p.read_text().splitlines():
        try:
            if json.loads(line).get("place_id") == place_id:
                return True
        except ValueError:
            continue
    return False


def press_self(*argv, timeout=120):
    """Run this same leads (the brief, the log) as its own process, so each keeps its own exits and output."""
    try:
        r = subprocess.run([sys.executable, str(Path(__file__).resolve()), *argv], capture_output=True, text=True,
                           timeout=timeout)
        return r.returncode, (r.stdout or "").strip(), (r.stderr or "").strip()
    except (OSError, subprocess.SubprocessError) as exc:
        return 1, "", f"{type(exc).__name__}: {exc}"


def press_build(args, pid):
    """(url, reused, why). An unclaimed preview still inside its days is reused; else the `--place` build."""
    today = now_date()
    have = next((m for m in previews_all() if m.get("place_id") == pid and not m.get("claimed")), None)
    if have and have.get("url") and str(have.get("expires") or "") >= today.isoformat():
        return have["url"], True, None
    args.place, args.name, args.kit = pid, [], False
    try:
        with contextlib.redirect_stdout(sys.stderr):
            rows = preview_rows_for(args)
            made, ok = make_previews(rows, hero=args.hero, days=args.days, publish=not args.no_publish,
                                     dry=args.dry_run, look=args.look)
    except SystemExit as exc:
        return None, False, f"leads stopped (exit {exc.code}); its reason is on stderr"
    except Exception as exc:  # noqa: BLE001 — a failed build is an answer, not a crash
        return None, False, f"{type(exc).__name__}: {str(exc)[:200]}"
    if not made:
        return None, False, "nothing was built"
    if not ok:
        return None, False, "the publish failed"
    if args.no_publish or args.dry_run:
        return made[0]["url"], False, "built, not published (--no-publish or --dry-run)"
    return made[0]["url"], False, None


def press_answer(args):
    raw = (args.from_press or "").strip()
    h = raw.lower() if re.fullmatch(r"[0-9a-fA-F]{64}", raw) else press_hash(raw)
    out = {"ok": False, "state": "unknown", "hash": h, "url": None, "reused": False, "place_id": None,
           "name": None, "city": None, "first": False, "brief": None, "why": None, "build_tail": None}
    try:
        seq = next((q for q in press_sequences() if press_hash(q["token"]) == h), None)
    except RuntimeError as exc:
        press_out(dict(out, state="failed", why=str(exc)), 2)
    if not seq:
        press_out(dict(out, why="no letter carries this link"))
    pid, name = seq.get("place_id"), clean_name(seq.get("name") or "")
    out.update(place_id=pid, name=name, city=seq.get("city"))
    supp, where = suppressed()
    if supp is None:
        press_out(dict(out, state="failed", why=f"the suppression list can't be read: {where}"), 2)
    if press_removed(seq, supp):
        press_out(dict(out, state="removed", why="the address, its domain or the place is suppressed"))
    if not pid:
        press_out(dict(out, state="failed", why="the letter's sequence has no place id"), 2)
    url, reused, why = press_build(args, pid)
    published = bool(url) and not (args.no_publish or args.dry_run)
    out.update(url=url, reused=reused, why=why,
               state="ready" if url else "failed", ok=bool(url) and (published or reused))
    if not press_seen(pid) and not (args.no_publish or args.dry_run):
        STATE.mkdir(parents=True, exist_ok=True)
        with open(press_log(), "a") as f:
            f.write(json.dumps({"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "place_id": pid, "name": name,
                                "hash": h, "state": out["state"], "url": url, "why": why}) + "\n")
        out["first"] = True
        # outreach owns the letters: the business's remaining touches stop, and its `build` word is offered
        # (`outreach pressed`, B91 with B92's offer_build). A failure here never stops the answer.
        try:
            r = subprocess.run([str(OUTREACH_BIN), "pressed", pid, "--name", name] + (["--url", url] if url else []),
                               capture_output=True, text=True, timeout=60)
            told = json.loads(r.stdout or "{}") if r.returncode == 0 else {}
            out["stopped"] = told.get("stopped")
            out["build_tail"] = told.get("build_tail") or None
            if r.returncode != 0:
                print(f"leads: outreach pressed failed ({(r.stderr or '').strip()[-160:]})", file=sys.stderr)
        except (OSError, subprocess.SubprocessError, ValueError) as exc:
            print(f"leads: outreach pressed didn't run ({exc})", file=sys.stderr)
        # one `interested` line a business: a yes that came first already wrote it
        lead = next((x for x in pipeline_state().values() if x.get("place_id") == pid), None)
        if lead and lead.get("stage") in ("interested", "demo", "won"):
            out["logged"] = False
        else:
            note = f"pressed the link in the letter; preview: {url}" if url else f"pressed the link in the letter; the build failed: {why}"
            code, _, err = press_self("log", name, "interested", note, "--place", pid, "--source", "email", "--next", "tomorrow")
            out["logged"] = code == 0
            if code != 0:
                print(f"leads: the pipeline line wasn't written ({err[-160:]})", file=sys.stderr)
        code, brief, err = press_self("brief", name, "--place", pid)
        out["brief"] = brief if code == 0 and brief else None
    press_out(out, 0 if out["state"] == "ready" else 2)


def kit_previews(picks, build=False, publish=True):
    """Hang a preview link on each of the kit's picks: the one it already has, and with --previews
    one built for every pick that hasn't got one. Sets `preview_url` (or None) on each pick."""
    rows = previews_all()
    have = {m.get("place_id"): m for m in rows if not m.get("claimed")}
    claimed = {m.get("place_id") for m in rows if m.get("claimed")}
    if build:
        missing = [(c, c.get("details")) for c in picks
                   if c["place_id"] not in have and c["place_id"] not in claimed]
        if missing:
            try:
                with contextlib.redirect_stdout(sys.stderr):      # `site previews` talks; --json stays clean
                    made, ok = make_previews(missing, publish=publish)
            except Exception as e:                                 # a failed build is a DM without "built you one"
                print(f"leads: the previews didn't build ({type(e).__name__}: {e}) — the messages offer to build one",
                      file=sys.stderr)
                made, ok = [], True
            if not ok:
                print("leads: the previews didn't publish — the messages go out without the link",
                      file=sys.stderr)
                made = []
            for m in made:
                have[m["place_id"]] = m
    for c in picks:
        m = have.get(c["place_id"])
        c["preview_url"] = m["url"] if m else None
        if c.get("message") and c.get("variant", "listing") == "listing":
            c["message"] = register_dm(c, c.get("faults") or [])   # "built you one" is true only now; no link in it
    return picks


def preview_sentence(url):
    """The line a message adds when the lead already has a page to look at."""
    return (f" I also built you a page to see what one could look like: {url} — nothing to sign, "
            f"and I'll take it down the moment you say so.")


def kit_json(picks, segment, today):
    """The seam `bin/outreach` reads (B46): one object per pick, the keys documented in the
    docstring above. Add keys, never rename one."""
    out = []
    for c in picks:
        rc = c.get("reach") or {}
        fb = rc.get("facebook")
        out.append({
            "place_id": c.get("place_id"), "name": clean_name(c["name"]),
            "first": first_name(c["name"]) or clean_name(c["name"]),
            "category": c.get("category") or "", "segment": c.get("segment") or segment,
            "city": c.get("locality") or (c.get("city") or "").replace(", Utah", ""),
            "phone": c.get("phone") or None, "email": rc.get("email") or None,
            "instagram": rc.get("instagram") or None,
            "facebook": ("https://" + fb if fb and not fb.startswith("http") else fb) or None,
            "faults": list(c.get("faults") or []), "preview_url": c.get("preview_url"),
            "maps_url": c.get("maps") or clean_maps(c.get("google_maps_uri")),
            # beyond the agreed shape, and additive: the draft itself, so a caller doesn't rebuild it
            "message": c.get("message"), "summary": c.get("summary"),
            # 2026-09-30: what the register reads (the reviews clause) and why a handle was refused
            "reviews": pick_reviews(c)[0], "rating": pick_reviews(c)[1], "variant": c.get("variant") or "listing",
            "reach_skipped": list(rc.get("skipped") or []),
            # B104/B107: what the table didn't find `high` — `email` above is a high address only, and the one it
            # held back (low or unsure) is here for `outreach send` to name in its skip line; never sent to
            "email_unconfirmed": next(({"address": u["value"], "why": u.get("why"), "confidence": u["confidence"]}
                                       for u in rc.get("unconfirmed") or [] if u["field"] == "email" and u.get("value")),
                                      None),
            "reach_unconfirmed": [{k: u.get(k) for k in ("field", "value", "confidence", "why", "label", "profile")}
                                  for u in rc.get("unconfirmed") or []],
            # B71: the letter's `{paying}` line (null drops it whole) and the fingerprint behind it
            "paying": paying_sentence(c.get("place_id"), "letter"),
            "host": host_json(c.get("place_id")),
            # B74: what language the business speaks to its customers (null: no pass yet, or no row)
            "language": language_info(c.get("place_id")),
        })
    return {"date": today.isoformat(), "segment": segment, "picks": out}


def host_json(place_id):
    hi = host_info(place_id)
    if not hi:
        return None
    return {k: hi[k] for k in ("vendor", "kind", "status", "price", "from", "to", "page", "brief", "why", "checked")}


def cmd_preview(args):
    if getattr(args, "press_tokens", False):
        return press_tokens(args)
    if getattr(args, "from_press", None):
        return press_answer(args)
    if args.from_file:
        return preview_from(args)
    if args.remove:
        return preview_remove(args)
    if args.claim:
        return preview_claim(args)
    first = (args.name or [None])[0]
    if first in ("ls", "list"):
        return preview_ls(args)
    if first == "sweep":
        return preview_sweep(args)
    return previews_build(args)


def preview_ls(args):
    rows = sorted(previews_all(), key=lambda m: m["expires"])
    today = now_date()
    if not rows:
        print(f"no previews yet ({preview_meta_dir()}); `leads preview --kit` builds today's")
        return
    print(f"{len(rows)} preview(s) on https://{preview_host()}/ (project {PREVIEW_PROJECT}); today {today}")
    w = max(len(m["slug"]) for m in rows)
    for m in rows:
        left = (dt.date.fromisoformat(m["expires"]) - today).days
        state = "CLAIMED " + m["claimed"] if m.get("claimed") else (
            "EXPIRED" if left < 0 else f"{left}d left")
        print(f"  {m['slug']:<{w}}  {state:<16} {m['name']} · {m['category']} · {m['city'] or '-'}")
    if args.json:
        print(json.dumps(rows, indent=1))


def preview_sweep(args):
    """Every preview past its 30 days comes down (the tree, the manifest, one publish)."""
    today = now_date()
    gone = [m for m in previews_all() if not m.get("claimed") and dt.date.fromisoformat(m["expires"]) < today]
    if not gone:
        print(f"nothing expired as of {today} ({len(previews_all())} preview(s) live)")
        return
    for m in gone:
        print(f"  removing {m['slug']} ({m['name']}, expired {m['expires']})")
        if not args.dry_run:
            shutil.rmtree(preview_site_dir() / m["slug"], ignore_errors=True)
            (preview_meta_dir() / f"{m['slug']}.json").unlink(missing_ok=True)
    if args.dry_run:
        print(f"dry run: {len(gone)} would come down")
        return
    preview_root_files()
    if not args.no_publish:
        preview_publish()
    print(f"{len(gone)} preview(s) removed; {len(previews_all())} left")


def preview_remove(args):
    """A takedown: the folder, the manifest, one publish. Minutes, not the hour we promise."""
    m = preview_find(args.remove)
    if not m:
        die(f"no preview for {args.remove!r} (`leads preview ls`)")
    shutil.rmtree(preview_site_dir() / m["slug"], ignore_errors=True)
    (preview_meta_dir() / f"{m['slug']}.json").unlink(missing_ok=True)
    print(f"removed {m['slug']} ({m['name']})")
    if not args.no_publish:
        ok, _ = preview_publish(dry=args.dry_run)
        if not ok:
            die("the files are gone locally but the publish failed — run `leads preview sweep` again", 2)
    print(f"{m['url']} is gone; reply to the owner that it's down.")


def preview_claim(args):
    """A claimed preview becomes the client's site: `client new` + `site new` from the same
    template, then the WHOLE rendered tree copied over it with the overlay cut at its markers and
    the forms switched on (plan 28, B64). It never overwrites a page with a thinner one: every form
    the template's own home page has must be on the page that replaces it, or nothing is copied.
    A legacy one-page preview (a template with no section library yet) keeps the template's home
    page and leaves the preview's page in the workspace's incoming/ for Patch to fold in."""
    m = preview_find(args.claim)
    if not m:
        die(f"no preview for {args.claim!r} (`leads preview ls`)")
    slug = args.slug or slugify(clean_name(m["name"]))
    ws = PROJECTS / "clients" / slug
    repo = f"{slug}-site"
    tree = preview_site_dir() / m["slug"]
    page = tree / "index.html"
    if not page.exists():
        die(f"{page} is gone — rebuild it first: leads preview \"{m['name']}\"")
    library = (tree / "css" / "sections.css").exists()
    files = claim_files(tree) if library else []
    print(f"claim {m['name']} -> clients/{slug}, site {repo} from the {m['template']} template"
          + (f", look {m.get('look')}" if m.get("look") else ""))
    copy = preview_copy(m["category"])
    steps = [[str(CLIENT_BIN), "new", slug, "--name", m["name"]],
             [str(SITE_BIN), "new", repo, "--template", m["template"], "--primary",
              "--tagline", copy["tagline"].format(name=m["name"], city=m["city"] or "the valley",
                                                  category=m["category"], trade=copy["trade"])]]
    if args.dry_run:
        for s in steps:
            print("  would run: " + " ".join(s[0].rsplit("/", 1)[-1:] + s[1:]))
        if library:
            print(f"  would copy the whole rendered site ({len(files)} files) over the template's: "
                  + ", ".join(f for f in files if "/" not in f)
                  + ", " + ", ".join(sorted({f.split('/')[0] + '/' for f in files if '/' in f})))
            print("  would cut the preview's overlay at its markers (the bar, noindex, the footer, the image "
                  "labels, the caveat), switch the forms on, and leave out claim/ and css/preview.css")
            print("  would refuse if the new home page lacks a form the template's has")
        else:
            print(f"  would keep the {m['template']} template's own index.html (its forms); the preview's page "
                  f"goes to clients/{slug}/incoming/preview-index.html for Patch to fold in; the hero is copied")
        print(f"  would commit, push, `site publish {repo}`")
        print(f"  would mark {m['slug']} claimed and take the preview down")
        return
    r = subprocess.run(steps[0], capture_output=True, text=True)
    if r.returncode != 0 and not ws.exists():
        die(f"client new {slug} failed: {(r.stderr or r.stdout).strip()[:300]}")
    print((r.stdout or "").strip()[-400:])
    r = subprocess.run(steps[1], capture_output=True, text=True, cwd=str(ws),
                       env=dict(os.environ, SITE_ADMIN="1"))
    print((r.stdout + r.stderr).strip()[-800:])
    dest = ws / "repos" / repo
    if r.returncode != 0 or not dest.exists():
        die(f"site new {repo} failed; the workspace is made — finish it by hand from {dest}", 2)
    if library:
        claim_tree(tree, dest)
    else:
        has_photos = (dest / "photos.html").exists()
        (ws / "incoming").mkdir(exist_ok=True)
        (ws / "incoming" / "preview-index.html").write_text(
            claim_html(page.read_text(), m["name"], now_date().year, has_photos))
        src_img = tree / "images"
        if src_img.is_dir():
            (dest / "images").mkdir(exist_ok=True)
            for p in src_img.iterdir():
                if p.is_file():
                    shutil.copy2(p, dest / "images" / p.name)
        print(f"  the {m['template']} template has no section library yet: its own home page stays (with its "
              f"forms); the preview's page is clients/{slug}/incoming/preview-index.html")
    for git_args in (["add", "-A"],
                     ["-c", "user.name=Patch (claude-tools leads)", "-c", "user.email=noreply@anthropic.com",
                      "commit", "-q", "-m", f"The site {m['name']} claimed, from their Patchlamp preview"],
                     ["push", "-q"]):
        g = subprocess.run(["git", "-C", str(dest), *git_args], capture_output=True, text=True)
        if g.returncode != 0:
            print(f"leads: git {git_args[0]} in {dest}: {(g.stderr or g.stdout).strip()[:160]}", file=sys.stderr)
    r = subprocess.run([str(SITE_BIN), "publish", repo], capture_output=True, text=True, cwd=str(ws))
    print((r.stdout + r.stderr).strip()[-600:])
    m["claimed"], m["claimed_on"] = slug, now_date().isoformat()     # the week counts claims by date (B52)
    preview_save(m)
    print(f"claimed: clients/{slug} · repos/{repo} · the preview is marked claimed "
          f"(`leads preview --remove {m['slug']}` takes it off the previews host)")


CLAIM_LEAVE = ("claim/", "css/preview.css")


def claim_files(tree):
    """The rendered site's files a claim copies: all of them but the claim redirect and the overlay's stylesheet."""
    return sorted(p.relative_to(tree).as_posix() for p in tree.rglob("*")
                  if p.is_file() and not any(p.relative_to(tree).as_posix().startswith(x) for x in CLAIM_LEAVE))


def claim_page(html_):
    """A rendered page as the client's own: every <!--p:NAME-->…<!--/p:NAME--> block cut, every
    <!--c:NAME … /c:NAME--> block uncommented (the forms switched on, the copyright, the title)."""
    html_ = re.sub(r"[ \t]*<!--p:([\w-]+)-->.*?<!--/p:\1-->\n?", "", html_, flags=re.S)
    html_ = re.sub(r"<!--c:([\w-]+)\n(.*?)\n[ \t]*/c:\1-->\n?", lambda m: m.group(2) + "\n", html_, flags=re.S)
    return re.sub(r"\n{3,}", "\n\n", html_)


def form_actions(html_):
    return set(re.findall(r'<form[^>]*\baction="([^"]+)"', html_ or ""))


def claim_tree(tree, dest):
    """Copy the rendered site into the client repo (after `site new`), overlay cut, forms on."""
    files = claim_files(tree)
    pages = {f: claim_page((tree / f).read_text()) for f in files if f.endswith(".html")}
    for f, html_ in pages.items():
        left = re.findall(r"<!--/?[pc]:[\w-]+|noindex|class=\"demo-bar\"|disabled>", html_)
        if left:
            die(f"the claimed {f} still carries preview markup ({', '.join(sorted(set(left))[:4])}); nothing copied")
    old = (dest / "index.html").read_text() if (dest / "index.html").exists() else ""
    lost = form_actions(old) - form_actions(pages.get("index.html", ""))
    if lost:
        die(f"the rendered home page has no form for {', '.join(sorted(lost))}, which the template's has — "
            f"a claim never replaces a page with a thinner one; add the section to content.json and render again")
    for f in files:
        target = dest / f
        target.parent.mkdir(parents=True, exist_ok=True)
        if f in pages:
            target.write_text(pages[f])
        else:
            shutil.copy2(tree / f, target)
    print(f"  copied {len(files)} files: the overlay cut, the forms on ({', '.join(sorted(form_actions(pages.get('index.html', ''))) ) or 'no forms'})")


LEGACY_STRIP = ("p:robots", "p:css", "p:bar", "p:caveat", "p:footer", "p:herocap")


def claim_html(page, name, year, has_photos):
    """The legacy one-page preview as a page of the client's own: every preview-only block cut at
    its markers, the disclaimers replaced with the site's own words."""
    for tag in LEGACY_STRIP:
        page = re.sub(rf"<!--{tag}-->.*?<!--/{tag}-->\n?", "", page, flags=re.S)
    page = page.replace("<!--c:head-->",
                        f"  <title>{esc(name)}</title>\n"
                        f'  <meta name="description" content="{esc(name)}">')
    page = page.replace("<!--c:nav-->", '      <a href="photos.html">Photos</a>' if has_photos else "")
    page = page.replace("<!--c:what-->", '        <h3>What we do</h3>')
    page = page.replace("<!--c:footer-->", f'    <p class="copyright">&copy; {year} {esc(name)}</p>')
    page = page.replace('<link rel="stylesheet" href="css/preview.css">', "")
    page = page.replace('class="preview-h3"', 'class="site-h3"').replace(">Their listing on Google<", ">See us on Google<")
    return re.sub(r"\n{3,}", "\n\n", page)


# ---- the pipeline (B7) ----------------------------------------------------------------

PIPELINE = Path(os.environ.get("LEADS_PIPELINE", PROJECTS / "private-docs/leads/pipeline.jsonl"))

# outcome -> (stage, default days to the follow-up, what it means)
OUTCOMES = {
    "held":       ("held", None, "not messaged: Taylor is holding it back (researching, weak fit)"),
    "messaged":   ("contacted", 4, "a DM or email went out, no answer yet"),
    "visited":    ("contacted", 3, "walked in, the decision-maker wasn't there"),
    "talked":     ("contacted", 7, "talked to the owner or manager, no decision"),
    "inbound":    ("interested", 1, "they came to us — the site form, the demo line, a reply"),
    "interested": ("interested", 2, "wants to hear more"),
    "demo":       ("negotiating", 2, "saw the demo / talked price"),
    "later":      ("contacted", 30, "not now; ask again in a month"),
    "trial":      ("trialing", 5, "the free week started"),
    "won":        ("won", None, "said yes"),
    "lost":       ("lost", None, "said no, or not a fit"),
    "churned":    ("churned", None, "was paying, cancelled"),
}
STAGES = ["held", "contacted", "interested", "negotiating", "trialing", "won", "lost", "churned"]
WEEKDAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]

# The channel a touch came through, so the week can be cut by it (B52, GROWTH § 2.4). `--via` is
# the older, freer word; this is the short list the week counts.
SOURCES = ("email", "dm", "group", "saturday", "referral", "inbound", "mail")
VIA_SOURCE = {"email": "email", "dm": "dm", "instagram": "dm", "facebook": "dm", "message": "dm",
              "group": "group", "counter": "saturday", "visit": "saturday", "door": "saturday",
              "referral": "referral", "mail": "mail", "postcard": "mail",
              "inbound": "inbound", "form": "inbound", "text": "inbound", "web": "inbound"}
# A conversation is a real exchange: the outcomes that mean somebody talked back (or came to us).
CONVERSATION = ("visited", "talked", "inbound", "interested", "demo", "later", "trial", "won", "lost")
# § 5.5: day 0 the fault and the preview, then these, and back in the pool at 90 — a good lead's (B73: STRENGTH_CADENCE).
CADENCE = (3, 10, 30)


def parse_when(text, today):
    """'tomorrow', 'fri', 'friday', '3d', '2w', '2026-10-01', 'oct 3', 'none' -> a date (or None)."""
    t = (text or "").strip().lower()
    if t in ("", "none", "never", "-"):
        return None
    if t in ("today",):
        return today
    if t in ("tomorrow", "tmrw", "tmw"):
        return today + dt.timedelta(days=1)
    m = re.fullmatch(r"(\d+)\s*(d|day|days|w|wk|week|weeks)", t)
    if m:
        n = int(m.group(1))
        return today + dt.timedelta(days=n * (7 if m.group(2).startswith("w") else 1))
    names = {"mon": "monday", "tue": "tuesday", "wed": "wednesday", "thu": "thursday", "fri": "friday", "sat": "saturday", "sun": "sunday"}
    t = re.sub(r"^next\s+", "", t)
    if t[:3] in names and names[t[:3]].startswith(t.rstrip(".")):
        ahead = (WEEKDAYS.index(t[:3]) - today.weekday()) % 7 or 7
        return today + dt.timedelta(days=ahead)
    try:
        return dt.date.fromisoformat(t)
    except ValueError:
        pass
    for fmt in ("%b %d", "%B %d", "%m/%d"):
        try:
            d = dt.datetime.strptime(t, fmt).date().replace(year=today.year)
            return d if d >= today else d.replace(year=today.year + 1)
        except ValueError:
            continue
    die(f"can't read the date \"{text}\" (tomorrow, fri, 3d, 2w, 2026-10-01, oct 3)")


def pipeline_events():
    if not PIPELINE.exists():
        return []
    out = []
    for line in PIPELINE.read_text().splitlines():
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return out


def pipeline_state():
    """key -> the lead as of its last event (stage, next, who, notes, the history)."""
    leads = {}
    for e in pipeline_events():
        if e.get("kind") == "strength":
            continue                      # Taylor's override (B73): read by strength_overrides(), never a lead by itself
        k = e["key"]
        lead = leads.setdefault(k, {"key": k, "place_id": e.get("place_id"), "name": e["name"], "city": e.get("city"),
                                    "history": [], "who": None, "email": None, "phone": None, "reach": None})
        lead["history"].append(e)
        for f in ("name", "city", "stage", "outcome", "next", "reach", "source"):
            if f in e:
                lead[f] = e[f]
        for f in ("who", "email", "phone"):
            if e.get(f):
                lead[f] = e[f]
        lead["last"] = e["date"]
    return leads


def source_for(explicit, via, outcome, lead=None, row=None, reach_row=None):
    """The channel to record (B52): what was asked for, else what `--via` says, else the channel this lead
    was already on, else — for a first message — the reach the kit would have used. Unknown stays unknown:
    the week counts an `unknown` row rather than inventing one."""
    if explicit:
        s = explicit.strip().lower()
        if s not in SOURCES:
            die(f"--source is one of: {', '.join(SOURCES)}")
        return s
    if via and VIA_SOURCE.get(via.strip().lower()):
        return VIA_SOURCE[via.strip().lower()]
    if outcome == "inbound":
        return "inbound"            # they came to us, whatever channel we were on with them
    if lead and lead_source(lead):
        return lead_source(lead)
    if outcome == "messaged":
        rc = reach_row or ((business_reach(row) if is_business(row) else reach(row)) if row else {})
        if rc.get("email"):
            return "email"
        if rc.get("instagram") or rc.get("facebook") or rc.get("directory"):
            return "dm"
    return None


def lead_source(lead):
    """The channel a lead is on: the first one any of its events recorded."""
    for e in lead.get("history") or []:
        if e.get("source"):
            return e["source"]
    return None


def claimed_places():
    """Place ids whose preview was claimed (B45): a client, not a lead. Cheap and never raises —
    the previews' manifests are small JSON files and may not exist at all."""
    try:
        return {m["place_id"] for m in previews_all() if m.get("claimed") and m.get("place_id")}
    except OSError:
        return set()


def pipeline_skip():
    """place_ids the kits should leave alone: anyone won or lost, and anyone with a follow-up still ahead."""
    today = dt.datetime.now(TZ).date().isoformat()
    state = pipeline_state()
    return {l["place_id"] for l in state.values()
            if l.get("place_id") and (l.get("stage") in ("won", "lost", "trialing", "churned")
                                      or (l.get("next") or "") > today)} | \
        {l["place_id"] for l in state.values() if l.get("place_id") and strength_hold(l, now_date())}   # B73


def resolve_lead(raw, place=None):
    """(key, place_id, name, city, row) for a name typed on a phone. The census first; else a free-text lead."""
    if place:
        hits = [h for h in census_lookup(raw.split(",")[0].strip() or "x") if h[1]["place_id"] == place] or \
               [(9, r) for r in _census_by_id(place)]
        if not hits:
            die(f"no place {place} in the census")
        r = hits[0][1]
        return f"place:{r['place_id']}", r["place_id"], clean_name(r["name"]), r.get("locality") or r.get("city"), r, []
    # a lead already in the pipeline wins: "log fong interested" shouldn't re-match the census
    name, _, city = raw.partition(",")
    want = " ".join(norm(name))
    for l in pipeline_state().values():
        if " ".join(norm(l["name"])) == want and (not city.strip() or norm(city)[0:1] == norm(l.get("city") or "")[0:1]):
            return l["key"], l.get("place_id"), l["name"], l.get("city"), None, []
    hits = census_lookup(name.strip(), city.strip() or None)
    if hits:
        r = hits[0][1]
        others = [h[1] for h in hits[1:3] if h[0] >= hits[0][0] - 0.3]
        return f"place:{r['place_id']}", r["place_id"], clean_name(r["name"]), r.get("locality") or r.get("city"), r, others
    slug = "-".join(norm(name)) or "lead"
    return f"name:{slug}", None, name.strip(), city.strip() or None, None, []


def _census_by_id(place_id):
    """The census row for one place, from either census (the services columns come too, so a services
    lead gets `business_reach` and the business faults, not a restaurant's)."""
    if not place_id or not CENSUS.exists():
        return []
    has_b, _ = businesses_state()
    b_cols = ("CASE WHEN r.place_id IS NULL THEN b.segment END AS segment, b.category, b.presence_class, "
              "b.presence_url, COALESCE(r.city, b.city) AS city" if has_b else
              "NULL AS segment, NULL AS category, NULL AS presence_class, NULL AS presence_url, r.city")
    b_join = "LEFT JOIN businesses b ON b.place_id = p.place_id" if has_b else ""
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    rows = conn.execute(f"""SELECT p.*, r.on_doordash, r.on_uber, r.on_grubhub, r.channel_class, r.parasite_url,
                                   r.serp_top3, r.contact_name, r.contact_email, {b_cols}
                            FROM place_cache p LEFT JOIN restaurants r ON r.place_id = p.place_id {b_join}
                            WHERE p.place_id = ?""", (place_id,)).fetchall()
    conn.close()
    return [dict(r) for r in rows]


def cmd_log(args):
    today = dt.datetime.now(TZ).date()
    outcome = args.outcome.lower()
    if outcome not in OUTCOMES:
        die(f"outcome is one of: {', '.join(OUTCOMES)}")
    key, pid, name, city, row, others = resolve_lead(" ".join(args.name), args.place)
    stage, days, _ = OUTCOMES[outcome]
    nxt = parse_when(args.next, today) if args.next is not None else (today + dt.timedelta(days=days) if days else None)
    if nxt and nxt.weekday() == 6 and args.next is None:
        nxt += dt.timedelta(days=1)            # nobody follows up on a Sunday
    lead = pipeline_state().get(key)
    event = {"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "date": today.isoformat(), "key": key,
             "place_id": pid, "name": name, "city": city, "outcome": outcome, "stage": stage,
             "next": nxt.isoformat() if nxt else None, "note": " ".join(args.note).strip() or None,
             "who": args.who, "email": args.email, "phone": args.phone or (row or {}).get("phone"), "via": args.via}
    if args.next is not None and nxt:
        event["next_by"] = "hand"          # a date Taylor named; the cadence never writes over it
    rc = None
    if row:
        rc = business_reach(row) if is_business(row) else reach(row)
        event["reach"] = (business_reach_line(rc) if is_business(row) else reach_line(rc)) or None
        event["email"] = event.get("email") or rc.get("email")
        if outcome == "messaged":
            event["was"] = "; ".join(lead_faults(row, None, today)[0][:2]) or None
    event["source"] = source_for(getattr(args, "source", None), args.via, outcome, lead, row, rc)
    event.update(strength_fields(row, lead=dict(lead or {"key": key, "place_id": pid}, who=args.who or (lead or {}).get("who"))))
    PIPELINE.parent.mkdir(parents=True, exist_ok=True)
    with open(PIPELINE, "a") as f:
        f.write(json.dumps({k: v for k, v in event.items() if v is not None or k == "next"}) + "\n")
    when = f"follow up {nxt.strftime('%a %-d %b')}" if nxt else "no follow-up"
    print(f"Logged: {name}{' (' + city + ')' if city else ''} — {outcome} → {stage}; {when}."
          + ("" if row or pid else " (not in the census; logged by name)"))
    if others:
        print("  (matched the census's " + name + (f" in {city}" if city else "")
              + "; also close: " + "; ".join(f"{clean_name(o['name'])} ({o.get('locality') or '?'}) --place {o['place_id']}" for o in others) + ")")
    print()
    print_list(today + dt.timedelta(days=1), args.n)


def cmd_sent(args):
    """`leads sent 1 3 4` (or `all`): those picks from the last remote kit were messaged."""
    p = STATE / "remote.jsonl"
    last = None
    if p.exists():
        for line in p.read_text().splitlines():
            try:
                last = json.loads(line)
            except json.JSONDecodeError:
                pass
    if not last:
        die("no remote kit yet; run `leads kit --remote`")
    ids, names = last["place_ids"], last["names"]
    picks = range(1, len(ids) + 1) if args.which == ["all"] else []
    if not picks:
        try:
            picks = [int(x) for x in args.which]
        except ValueError:
            die("say which: leads sent 1 3 4, or leads sent all")
    today = dt.datetime.now(TZ).date()
    done = []
    for i in picks:
        if not 1 <= i <= len(ids):
            die(f"the last remote kit ({last['for']}) has {len(ids)} leads, not {i}")
        row = (_census_by_id(ids[i - 1]) or [{}])[0]
        nxt = today + dt.timedelta(days=OUTCOMES["messaged"][1])
        biz = is_business(row)
        rc = (business_reach(row) if biz else reach(row)) if row else {}
        event = {"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "date": today.isoformat(),
                 "key": f"place:{ids[i - 1]}", "place_id": ids[i - 1], "name": clean_name(names[i - 1]),
                 "city": row.get("locality") or row.get("city"), "outcome": "messaged", "stage": "contacted",
                 "next": nxt.isoformat(), "via": args.via, "phone": row.get("phone"),
                 "reach": ((business_reach_line(rc) if biz else reach_line(rc)) or None) if row else None,
                 "email": rc.get("email"), "source": source_for(args.source, args.via, "messaged", None, row, rc),
                 "was": ("; ".join(lead_faults(row, None, today)[0][:2]) or None) if row else None,
                 "note": f"remote kit {last['for']} #{i}"}
        event.update(strength_fields(row or None, lead={"key": event["key"], "place_id": ids[i - 1]}))
        PIPELINE.parent.mkdir(parents=True, exist_ok=True)
        with open(PIPELINE, "a") as f:
            f.write(json.dumps({k: v for k, v in event.items() if v is not None}) + "\n")
        done.append(event["name"])
    print(f"Logged {len(done)} sent: {', '.join(done)}; follow up {nxt.strftime('%a %-d %b')} if they don't answer.")


def due_by(day):
    """Leads whose follow-up is on or before `day`, oldest first (won and lost never come back)."""
    rows = [l for l in pipeline_state().values()
            if l.get("next") and l["next"] <= day.isoformat() and l.get("stage") not in ("won", "lost")]
    return sorted(rows, key=lambda l: (l["next"], l["name"]))


def lead_line(l, day):
    late = (day - dt.date.fromisoformat(l["next"])).days
    tag = f" · {late}d late" if late > 0 else ""
    last = l["history"][-1]
    what = (f"day {last.get('touch')} touch by {last.get('channel')}" if last.get("kind") == "touch_due"
            else f"{last['outcome']} {last['date'][5:]}")
    note = f" — \"{last['note']}\"" if last.get("note") else ""
    parts = [l.get("who"), l.get("phone"), l.get("reach")]
    if l.get("email") and l["email"] not in (l.get("reach") or ""):
        parts.append(l["email"])                      # the reach line already carries it when B61 found one
    contact = " · ".join(x for x in parts if x)
    return (f"{l['name']}{' (' + l['city'] + ')' if l.get('city') else ''} · {l['stage']}, {what}"
            f"{tag}{note}" + (f"\n     {contact}" if contact else ""))


def print_list(day, n=6, segment=None):
    """The day's list: follow-ups due, then fresh leads from the census (the default segment's) to make up n."""
    due = due_by(day)
    label = ("Tomorrow, " if day == dt.datetime.now(TZ).date() + dt.timedelta(days=1) else "") + day.strftime("%a %-d %b")
    print(f"{label}: {len(due)} follow-up{'s' if len(due) != 1 else ''}"
          + (", then new ones" if len(due) < n else ""))
    for i, l in enumerate(due, 1):
        print(f"  {i}. {lead_line(l, day)}")
    if len(due) < n:
        taken = pipeline_skip() | {l["place_id"] for l in pipeline_state().values() if l.get("place_id")} | set(contacted())
        chains = chain_names()
        seg = segment or default_segment()
        pool = candidates_for(seg)
        fresh = [c for c in pool if c["place_id"] not in taken and (c["name"] or "").lower() not in chains]
        for c in fresh:
            c["reach"] = business_reach(c) if is_business(c) else reach(c)
            c["faults"], _ = lead_faults(c, None, day)
        fresh = [c for c in fresh if c["faults"]]
        fresh.sort(key=lambda c: (not (c["reach"]["instagram"] or c["reach"]["facebook"]), c["miles"]))
        for i, c in enumerate(fresh[: n - len(due)], len(due) + 1):
            how = (business_reach_line(c["reach"]) if is_business(c) else reach_line(c["reach"])) or c.get("phone") or ""
            what = f"{c.get('category')}, " if is_business(c) and c.get("category") else ""
            print(f"  {i}. NEW {clean_name(c['name'])} ({what}{c.get('locality') or ''}, {c['miles']} mi) · {c['faults'][0]}"
                  + (f"\n     {how}" if how else ""))
    if day.weekday() == 5:
        print("  (Saturday: the counter kit is `leads kit --last`)")


def cmd_next(args):
    today = dt.datetime.now(TZ).date()
    day = parse_when(args.when, today) if args.when else today + dt.timedelta(days=1)
    print_list(day, args.n, resolve_segment(args.segment) if args.segment else None)


def cmd_due(args):
    today = dt.datetime.now(TZ).date()
    due = due_by(today)
    if not due:
        print("No follow-ups due today.")
        return
    print(f"{len(due)} follow-up{'s' if len(due) != 1 else ''} due:")
    for i, l in enumerate(due, 1):
        print(f"  {i}. {lead_line(l, today)}")


def cmd_show(args):
    key, pid, name, city, row, _ = resolve_lead(" ".join(args.name), args.place)
    lead = pipeline_state().get(key)
    if not lead:
        print(f"{name}{' (' + city + ')' if city else ''}: not in the pipeline yet.")
        if row:
            fs, summary = lead_faults(row, None, dt.datetime.now(TZ).date())
            print(f"  census: {summary.replace(' · (census only)', '')}" + (f" · wrong: {'; '.join(fs[:2])}" if fs else ""))
        return
    print(f"{lead['name']}{' (' + lead['city'] + ')' if lead.get('city') else ''} — {lead['stage']}"
          + (f", follow up {lead['next']}" if lead.get("next") and lead["stage"] not in ("won", "lost") else ""))
    judged = reach_judgement(lead.get("place_id") or pid)
    for x in ("who", "phone", "email", "reach"):
        if lead.get(x):
            shown = shown_reach(lead[x], judged) if x in ("email", "reach") else lead[x]
            print(f"  {x}: {shown}")
    for e in lead["history"]:
        print(f"  {e['date']}  {e['outcome']:<10} {e.get('note') or ''}")


def reach_bit_field(bit):
    """Which reach field one ' · '-separated piece of a logged `reach` string is: ('instagram', 'x'), …, or None."""
    b = (bit or "").strip()
    m = re.match(r"^(?:Instagram\s+)?@([A-Za-z0-9_.]+)$", b) or re.match(r"^(?:https?://)?(?:www\.)?instagram\.com/", b)
    if m:
        return "instagram", ig_handle(m.group(1) if m.lastindex else b)
    if re.search(r"facebook\.com/", b):
        return "facebook", fb_page(b)
    if re.fullmatch(r"[^@\s]+@[^@\s]+\.[A-Za-z]{2,}", b):
        return "email", b.lower()
    return None, None


def shown_reach(text, judged):
    """A logged `reach` string with every handle or address the table doesn't find `high` replaced by its label and
    reason (B104: `leads show`). The pipeline itself is never rewritten; a handle the table doesn't know is left
    as logged. The label never carries the handle: a messaged lead's history shouldn't hand it back."""
    out = []
    for bit in str(text).split(" · "):
        field, value = reach_bit_field(bit)
        j = judged.get(field) if field else None
        if j and j["confidence"] != "high" and (not j.get("value") or j["value"] == reach_value(field, value)):
            word = {"rejected": "refused", "unsure": "unconfirmed, look before sending",
                    "low": "unconfirmed, call-only"}[j["confidence"]]
            out.append(f"{REACH_LABEL[field]} {word} ({j.get('why') or 'no reason given'})")
        else:
            out.append(bit)
    return " · ".join(out)


def cmd_recheck(args):
    """B104: every handle and address the week's `messaged` leads were logged with, judged again against the place by
    `reach.py --check <ids> --json` (no search; it reads a page only when the stored words don't settle it, and is
    $0). `ok   Name  handle — the place line` or `FAIL Name  handle — why`, then `N of M fail: …`. The pipeline is
    never rewritten; a FAIL is for Taylor to see what went out to whom, and `--dry-run` asks reach.py to fetch
    nothing and write nothing."""
    today = now_date()
    since = dt.date.fromisoformat(args.since) if args.since else today - dt.timedelta(days=today.weekday())
    sent = {}
    for e in pipeline_events():
        if e.get("outcome") != "messaged" or (e.get("date") or "") < since.isoformat() or not e.get("place_id"):
            continue
        rec = sent.setdefault(e["place_id"], {"name": e.get("name") or e["place_id"], "bits": []})
        for text in (e.get("reach"), e.get("email")):
            for bit in str(text or "").split(" · "):
                field, value = reach_bit_field(bit)
                if field and value and (field, value) not in rec["bits"]:
                    rec["bits"].append((field, value))
    rows = {pid: r for pid, r in sent.items() if r["bits"]}
    if not rows:
        print(f"no messaged lead since {since} was logged with a handle or an address — nothing to recheck")
        return
    code, out, err = reach_cli(["--check", *rows, "--json"] + (["--dry-run"] if args.dry_run else []))
    if code != 0:
        die(f"reach.py --check didn't run (exit {code}): {(err.strip().splitlines() or ['no output'])[-1]}")
    try:
        checked = {r["place_id"]: r.get("fields") or {} for r in json.loads(out or "[]")}
    except (ValueError, KeyError, TypeError) as exc:
        die(f"reach.py --check --json printed something that isn't its JSON ({exc})")
    census = {}
    for pid in rows:
        hit = census_row_by_id(pid)
        if hit:
            census[pid] = hit
    lines, fails, total = [], [], 0
    for pid, r in rows.items():
        fields = checked.get(pid) or {}
        c = census.get(pid) or {}
        link = c.get("website") or c.get("presence_url") or ""
        for field, value in r["bits"]:
            total += 1
            shown = f"@{value}" if field == "instagram" else value
            f = fields.get(field) or {}
            same = reach_value(field, f.get("value")) == value
            own = (field == "instagram" and "instagram.com" in link and ig_handle(link) == value) or (
                field == "facebook" and "facebook.com" in link and fb_page(link) == value)
            if own:
                lines.append(f"ok   {r['name']}  {shown} — the listing's own website link")
            elif same and f.get("confidence") == "high" and not f.get("hidden"):
                lines.append(f"ok   {r['name']}  {shown} — {f.get('place') or 'tied to the place'}")
            else:
                why = (f.get("hidden") and f"hidden: {f['hidden']}") or f.get("reason") or (
                    f"{f.get('confidence')} ({f.get('place')})" if same else
                    "the reach table holds no candidate for it now, so nothing ties it to the place")
                lines.append(f"FAIL {r['name']}  {shown} — {why}")
                fails.append(f"{r['name']} {shown}")
    print("\n".join(lines))
    print(f"{len(fails)} of {total} fail" + (": " + "; ".join(fails) if fails else "")
          + f" (messaged since {since}{'; dry run, nothing fetched or written' if args.dry_run else ''})")


def census_row_by_id(place_id):
    """{'website', 'presence_url'} for one place from the census, or None. Read-only."""
    if not CENSUS.exists():
        return None
    conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    try:
        tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        out = {}
        if "place_cache" in tables:
            r = conn.execute("SELECT website FROM place_cache WHERE place_id = ?", (place_id,)).fetchone()
            out["website"] = r["website"] if r else None
        if "businesses" in tables:
            r = conn.execute("SELECT presence_url FROM businesses WHERE place_id = ?", (place_id,)).fetchone()
            out["presence_url"] = r["presence_url"] if r else None
        return out
    finally:
        conn.close()


def week_bounds(today):
    start = today - dt.timedelta(days=today.weekday())
    return start, start + dt.timedelta(days=6)


# GROWTH § 2.4, week 1 of the ramp: what the machine should be producing in its first week.
WEEK1_TARGET = {"messages sent": "15", "previews built": "6", "replies": "3", "conversations": "5",
                "fixes / claims": "1", "trials": "1", "paid": "0–1"}
CHANNEL_COLS = ("sent", "replies", "conversations", "fixes", "trials", "paid", "churned")


def week_events(start, end):
    return [e for e in pipeline_events() if start.isoformat() <= e["date"] <= end.isoformat() and e.get("kind") != "strength"]


def event_source(e, state):
    """The channel to file an event under: its own, else the one the lead came in on."""
    return e.get("source") or lead_source(state.get(e["key"]) or {}) or "unknown"


def followups(start, end, state):
    """(due in the week, answered since) — the § 2.4 row nobody else counts."""
    due = done = 0
    for lead in state.values():
        for i, e in enumerate(lead["history"]):
            when = e.get("next")
            if not when or not (start.isoformat() <= when <= end.isoformat()):
                continue
            due += 1
            if any(x["date"] >= when for x in lead["history"][i + 1:]):
                done += 1
    return due, done


def week_numbers(start, end):
    """Everything the Sunday review reports (B52): the funnel per channel, the § 2.4 indicators."""
    state = pipeline_state()
    evs = week_events(start, end)
    messaged = {e["key"] for e in pipeline_events() if e.get("outcome") == "messaged"}
    by = {}
    for e in evs:
        src = event_source(e, state)
        row = by.setdefault(src, dict.fromkeys(CHANNEL_COLS, 0))
        o = e.get("outcome")
        if o == "messaged":
            row["sent"] += 1
        if o in CONVERSATION:
            row["conversations"] += 1
            if e["key"] in messaged:
                row["replies"] += 1            # an answer to something we sent
        if o == "trial":
            row["trials"] += 1
        if o == "won":
            row["paid"] += 1
        if o == "churned":
            row["churned"] += 1
    previews = [m for m in previews_all() if start.isoformat() <= (m.get("built") or "") <= end.isoformat()]
    linked = [m for m in previews if f"place:{m.get('place_id')}" in messaged]
    for m in previews_all():
        when = m.get("claimed_on") or ""
        if m.get("claimed") and start.isoformat() <= when <= end.isoformat():
            lead = state.get(f"place:{m.get('place_id')}") or {}
            by.setdefault(lead_source(lead) or "unknown", dict.fromkeys(CHANNEL_COLS, 0))["fixes"] += 1
    total = {c: sum(r[c] for r in by.values()) for c in CHANNEL_COLS}
    due, done = followups(start, end, state)
    return {"week_of": start.isoformat(), "by_channel": by, "total": total,
            "indicators": {"messages sent": total["sent"], "previews built": len(previews),
                           "previews linked": len(linked), "replies": total["replies"],
                           "conversations": total["conversations"], "fixes / claims": total["fixes"],
                           "trials": total["trials"], "paid": total["paid"],
                           "follow-ups due": due, "follow-ups done": done},
            "pipeline": {s: sum(1 for l in state.values() if l.get("stage") == s) for s in STAGES},
            "won_total": sum(1 for l in state.values() if l.get("stage") == "won"),
            "due_now": len(due_by(now_date()))}


def week_by_channel(w, start):
    """The Sunday message: under 25 lines, one row a channel, then the § 2.4 indicators."""
    lines = [f"Week of {start.strftime('%-d %b')} — by channel · " + " · ".join(CHANNEL_COLS)]
    order = sorted((s for s, r in w["by_channel"].items() if any(r.values())),
                   key=lambda s: (-w["by_channel"][s]["sent"], s))
    for src in order:
        r = w["by_channel"][src]
        lines.append(f"  {src:<9} " + " · ".join(str(r[c]) for c in CHANNEL_COLS))
    lines.append(f"  {'total':<9} " + " · ".join(str(w['total'][c]) for c in CHANNEL_COLS))
    if not order:
        lines.append("  (nothing logged this week — `leads log` after every conversation)")
    lines.append("Indicators (GROWTH § 2.4, week 1 in brackets):")
    ind = w["indicators"]
    shown = [f"{k} {v}" + (f" [{WEEK1_TARGET[k]}]" if k in WEEK1_TARGET else "")
             for k, v in ind.items() if not k.startswith("follow-ups")]
    shown.append(f"follow-ups due {ind['follow-ups due']}, done {ind['follow-ups done']}")
    for i in range(0, len(shown), 3):
        lines.append("  " + " · ".join(shown[i:i + 3]))
    lines.append("Pipeline now: " + " · ".join(f"{w['pipeline'][s]} {s}" for s in STAGES if w["pipeline"][s])
                 + f" · {w['due_now']} follow-ups due")
    lines.append(f"Target: 3 paying by 31 Oct, 10 by 31 Dec — {w['won_total']} won so far.")
    lines.append("One change for the week: pick the row above that is furthest from its § 2.4 number.")
    return "\n".join(lines) + "\n"


def cmd_week(args):
    today = now_date()
    start, end = week_bounds(today - dt.timedelta(weeks=args.ago))
    if args.by == "strength":                    # B73: outcomes by strength and by reason, and the strong, silent
        d = week_by_strength(min(end, today))
        msg = week_strength_message(d, min(end, today))
        print(json.dumps(dict(d, message=msg), indent=1, default=str) if args.json else msg, end="\n" if args.json else "")
        return
    if args.json and not args.by:                # B102: the overview's counts, nothing else (plan 42)
        return json_out(week_counts, start, end, today)
    if args.by == "channel":
        w = week_numbers(start, end)
        msg = week_by_channel(w, start)
        silent = strong_silent_lines()           # B73: the strong leads past their last touch, for Taylor's call
        if silent:
            msg += "\n".join(silent) + "\n"
        if args.json:
            print(json.dumps(dict(w, message=msg, strong_silent=[l["name"] for l in strong_silent()]),
                             indent=1, default=str))
            return
        print(msg, end="")
        return
    evs = week_events(start, end)
    counts = {o: sum(1 for e in evs if e["outcome"] == o) for o in OUTCOMES}
    convo = sum(counts[o] for o in ("visited", "talked", "interested", "demo", "later", "won", "lost"))
    state = pipeline_state()
    live = {s: sum(1 for l in state.values() if l.get("stage") == s) for s in STAGES}
    kits = sum(1 for k in kits_log() if start.isoformat() <= k.get("for", "") <= end.isoformat())
    remote = 0
    if (STATE / "remote.jsonl").exists():
        for line in (STATE / "remote.jsonl").read_text().splitlines():
            try:
                if start.isoformat() <= json.loads(line).get("for", "") <= end.isoformat():
                    remote += 1
            except json.JSONDecodeError:
                pass
    print(f"Week of {start.strftime('%-d %b')}: {convo} conversation{'s' if convo != 1 else ''}, {counts['messaged']} message{'s' if counts['messaged'] != 1 else ''} sent"
          f" · {counts['interested']} interested · {counts['demo']} demos · {counts['won']} won · {counts['lost']} lost")
    print(f"Pipeline now: " + " · ".join(f"{live[s]} {s}" for s in STAGES)
          + f" · {len(due_by(today))} follow-ups due")
    print(f"Kits: {kits} Saturday, {remote} remote this week.")
    won = sum(1 for l in state.values() if l.get("stage") == "won")
    print(f"Target: 3 paying by 31 Oct, 10 by 31 Dec — {won} won so far.")
    for line in strong_silent_lines(state):      # B73
        print(line)


# ---- the cadence, the 07:30 message and the brief (B48; the week by channel is B52) ------

OUTREACH_STATE = Path(os.environ.get("OUTREACH_STATE", Path.home() / ".local/state/claude-tools/outreach"))
EMAIL_RE = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}")

# GROWTH § 5.5. Day 0 is the fault and the preview; 90 is back in the pool, which the kit's
# own suppression already does. A day-3 touch is a DM or a second email, never a text to a cell.
TOUCH_WHAT = {
    3: "the other channel, one line: the preview's up, text Patch anything on it",
    10: "the preview comes down soon — want it kept? it's free to claim",
    30: "a fresh read of the listing: one new thing wrong, or the offer stands",
    # B73: a strong lead's three more (GROWTH § 5.5 re-cut) — the other channels, and a call in the list
    45: "the channel not tried yet, one line: the fault is still there and the preview can come back up",
    60: "a call — five minutes, `leads brief` first",
    90: "the last note: the offer stands whenever they want it; then Taylor's call on the Sunday list",
}
TOUCH_SHORT = {3: "the other channel", 10: "the preview expiry", 30: "a fresh read of the listing",
               45: "the channel not tried yet", 60: "a call", 90: "the last note"}

# GROWTH § 6.2, verbatim: the six objections and the answer to each. The brief carries the one
# that fits the segment, then the one that usually follows it.
OBJECTIONS = {
    "nephew": ('"My nephew does my website."',
               "Keep him. This is for the 4pm \"we're closed Monday\" that he's not answering. $99 and it's "
               "done in a minute; he can still do the big stuff."),
    "referrals": ('"All my work is referrals, I don\'t need a website."',
                  "Your referrals still Google you before they call. Right now they hit a dead link / a Facebook "
                  "page / nothing. That's the thing to fix; the rest is optional."),
    "directory": ('"I\'m on Thumbtack / Angi."',
                  "Then you're paying for every lead and sharing it with four others. A site of your own is where "
                  "the ones who already chose you land. Keep Thumbtack; stop being only on Thumbtack."),
    "ai": ('"AI will break something / say something wrong."',
           "It changes only your site, inside a folder that holds only your things, and every change is saved so "
           "\"undo that\" works. It never posts for you or answers a customer unless you tell it to, and it says "
           "it's AI if anyone asks."),
    "price": ('"$99 is a lot."',
              "It's a website, hosting, the changes and someone to call, on one bill. The $50 plan is the same "
              "thing for a menu or a price list that changes now and then; the $10 plan keeps a site up with a few small changes a month by text. "
              "Start where you're comfortable; moving up is a text."),
    "think": ('"Let me think about it."',
              "Sure. What day should I text you? — a date, logged; the day-10 preview expiry does the rest."),
}
# The one each segment hears first (GROWTH § 3.1–3.5: services sell against referrals, the rest against price),
# and the one that follows it. A directory profile as the website overrides both.
SEGMENT_OBJECTION = {"services": ("referrals", "price"), "creatives": ("price", "referrals"),
                     "retail": ("price", "referrals"), "nonprofit": ("price", "think"),
                     "restaurant": ("nephew", "price")}


def env_value(name):
    """A toolbelt setting by name (never a printed value; these are links and flags, not keys)."""
    return (os.environ.get(name) or _env_file(ENV_FILE).get(name) or "").strip() or None


def previews_on():
    """`leads today` builds previews by default once the previews project is published (project.json has a
    pages_host or a domain); LEADS_KIT_PREVIEWS=0/false/off turns it off, =1 forces it on."""
    v = (env_value("LEADS_KIT_PREVIEWS") or "").lower()
    if v in ("1", "true", "yes", "on"):
        return True
    if v in ("0", "false", "no", "off"):
        return False
    try:
        row = json.loads((PREVIEWS / "project.json").read_text())
    except (OSError, ValueError):
        return False
    return bool(row.get("pages_host") or row.get("domain"))


def lead_email(lead):
    if lead.get("email"):
        return lead["email"]
    m = EMAIL_RE.search(lead.get("reach") or "")
    return m.group(0) if m else None


def lead_handle(lead):
    """The page to message this lead on, from the reach line the kit recorded."""
    r = lead.get("reach") or ""
    m = re.search(r"Instagram @([A-Za-z0-9_.]+)", r)
    if m:
        return f"instagram.com/{m.group(1)}"
    m = re.search(r"(facebook\.com/[^\s·]+)", r)
    if m:
        return m.group(1)
    m = re.search(r"([A-Za-z][A-Za-z ]*) profile", r)
    return f"their {m.group(1)} profile" if m else None


def first_message(lead):
    for e in lead.get("history") or []:
        if e.get("outcome") == "messaged":
            return e
    return None


def answered_since(lead):
    """True once somebody talked back: the cadence chases silence only."""
    m = first_message(lead)
    if not m:
        return True
    return any(e.get("outcome") in CONVERSATION and e["date"] >= m["date"] for e in lead["history"])


def touches_done(lead):
    return {int(e["touch"]) for e in lead.get("history") or [] if e.get("kind") == "touch_due" and e.get("touch")}


def touch_channel(lead, touch):
    """§ 5.5: day 3 is the *other* channel; 10 and 30 are Patch's, so email where there is an address.
    Never SMS — a cold text is the one touch the law forbids (§ 8.1). `call` means Taylor's thumb."""
    has_mail, has_dm = bool(lead_email(lead)), bool(lead_handle(lead))
    if touch == 60:
        return "call" if lead.get("phone") else ("dm" if has_dm else "email" if has_mail else "call")
    if touch == 45:                  # the other channel from the first message, like day 3
        touch = 3
    want = ("dm" if lead_source(lead) == "email" else "email") if touch == 3 else "email"
    if want == "email" and has_mail:
        return "email"
    if want == "dm" and has_dm:
        return "dm"
    if has_dm:
        return "dm"
    return "email" if has_mail else "call"


def cadence_rows(today, state=None):
    """[(lead, touch, channel, due)] — each silent lead's next touch, due today or already late."""
    out = []
    for lead in (state or pipeline_state()).values():
        if lead.get("stage") in ("held", "won", "lost", "trialing", "churned") or answered_since(lead):
            continue
        last = lead["history"][-1]
        if last.get("next_by") == "hand" and lead.get("next"):
            continue                                  # a date Taylor named wins over the cadence
        done, d0 = touches_done(lead), dt.date.fromisoformat(first_message(lead)["date"])
        floor = max(done) if done else 0
        ready = [t for t in lead_cadence(lead) if t > floor and d0 + dt.timedelta(days=t) <= today]
        if ready:
            # the latest touch that has come due, never a catch-up queue: a day-3 line missed while
            # the timer was off is not worth sending on day 12 — the day-10 one is.
            touch = ready[-1]
            out.append((lead, touch, touch_channel(lead, touch), d0 + dt.timedelta(days=touch)))
    out.sort(key=lambda r: (r[3].isoformat(), r[0]["name"]))
    return out


def record_touch(lead, touch, channel, due, today):
    """The touch as a pipeline event, so `leads due` and the 07:30 message see it like any follow-up."""
    event = {"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "date": today.isoformat(),
             "key": lead["key"], "place_id": lead.get("place_id"), "name": lead["name"], "city": lead.get("city"),
             "outcome": "touch_due", "kind": "touch_due", "stage": lead.get("stage") or "contacted",
             "touch": touch, "channel": channel, "next": due.isoformat(), "source": lead_source(lead),
             "note": TOUCH_WHAT[touch]}
    event.update(strength_fields(lead=lead))
    PIPELINE.parent.mkdir(parents=True, exist_ok=True)
    with open(PIPELINE, "a") as f:
        f.write(json.dumps({k: v for k, v in event.items() if v is not None}) + "\n")
    return event


def touch_do(lead, touch, channel):
    """The one thing to do about this touch — a line Taylor can act on, or the command that drafts it."""
    if channel == "email":
        if touch in (3, 10):     # the approved letters; day 30 is one line off the fresh read, not a template
            return f"outreach send --touch {touch} --dry-run  (drafts it to {lead_email(lead)})"
        return f"one line to {lead_email(lead)} off the read below"
    if channel == "dm":
        return f"DM {lead_handle(lead)}"
    if touch == 60:
        return f"call {lead.get('phone') or 'them'} — `leads brief \"{lead['name']}\"` first"
    return f"call {lead.get('phone') or 'them'} — no page and no address (B61 hasn't found one)"


def cmd_cadence(args):
    today = now_date()
    rows = cadence_rows(today)
    if not rows:
        print("No touches due: every messaged lead has either answered or isn't at day 3 yet.")
        return
    lines = []
    for lead, touch, channel, due in rows:
        if not args.dry_run:
            record_touch(lead, touch, channel, due, today)
        late = (today - due).days
        lines.append(f"  {lead['name']} — day {touch}{f' ({late}d late)' if late else ''} by {channel}: "
                     f"{touch_do(lead, touch, channel)}")
    print(f"{len(rows)} touch{'es' if len(rows) != 1 else ''} due{' (dry run: nothing written)' if args.dry_run else ''}:")
    print("\n".join(lines))
    dm = [r for r in rows if r[2] != "email"]
    if dm:
        print(f"{len(dm)} for your thumb; the email ones are the schedule's `outreach send --touch N`.")


def due_touch(lead, today):
    """(what this lead is owed, the thing to do) for a row in `leads due` — a cadence touch, a date
    Taylor named, or the outcome's own default follow-up."""
    last = lead["history"][-1]
    if last.get("kind") == "touch_due":
        touch, channel = int(last.get("touch") or 0), last.get("channel") or "dm"
        return f"day {touch}, {TOUCH_SHORT.get(touch, 'a follow-up')}", touch_do(lead, touch, channel)
    if last.get("next_by") == "hand":
        when = dt.date.fromisoformat(lead["next"])
        return f"you said {when.strftime('%a')}", f"call {lead.get('phone') or lead_handle(lead) or 'them'}"
    _, days, meaning = OUTCOMES.get(last.get("outcome") or "", ("", None, "a follow-up"))
    return meaning, f"call {lead.get('phone') or lead_handle(lead) or 'them'}"


def thirty_day_read(lead, args, today):
    """§ 5.5's day 30: one fresh Place Details call (cached seven days), for a row due today only."""
    pid = lead.get("place_id")
    if not pid:
        return None
    key, where = (None, None) if args.census_only else places_key()
    if not (key or args.fixture):
        return "no Places key here — read the listing by hand"
    places = Places(key, where, fixture=args.fixture)
    details = places.get(pid)
    if places.calls:
        ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
                       "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
                       "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global",
                       "for": f"day-30 read {lead['name']} {today}"})
    if not details:
        return places.failed or "the listing wouldn't read"
    row = (_census_by_id(pid) or [{}])[0] or {"name": lead["name"]}
    fs, _ = lead_faults(row, details, today)
    was = (first_message(lead) or {}).get("was") or ""
    if not fs:
        return "the listing is clean now — lead with what a site would add"
    new = [f for f in fs if f not in was]
    return (f"new since the message: {new[0]}" if new else f"still {fs[0]} — the offer stands")


def yesterdays_replies(day):
    """(the lane is configured, [rows]) — read from `outreach`'s inbox log, never written here."""
    if not OUTREACH_STATE.exists():
        return False, []
    p = OUTREACH_STATE / "replies.jsonl"
    rows = []
    for line in (p.read_text().splitlines() if p.exists() else []):
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if r.get("date") == day.isoformat():
            rows.append(r)
    return True, rows


def inbound_rows(today, state=None):
    """What came to us since yesterday (the relay's inbound lane logs `leads log NAME inbound …`):
    the site form, the demo line, a reply on a channel we weren't watching."""
    since = (today - dt.timedelta(days=1)).isoformat()
    out = []
    for lead in (state or pipeline_state()).values():
        for e in lead["history"]:
            if e.get("outcome") == "inbound" and since <= e["date"] <= today.isoformat():
                out.append({"name": lead["name"], "date": e["date"], "note": e.get("note"),
                            "phone": lead.get("phone") or e.get("phone"), "key": lead["key"]})
    return sorted(out, key=lambda r: (r["date"], r["name"]), reverse=True)


def warmest(today, state=None):
    """The first call of the day (§ 5.1): the warmest thing in the pipeline, and why in one line."""
    best = None
    for lead in (state or pipeline_state()).values():
        if lead.get("stage") in ("won", "lost", "churned"):
            continue
        last = lead["history"][-1]
        rank = {"inbound": 5, "interested": 4, "demo": 4, "trial": 3,
                "talked": 2, "visited": 2}.get(last.get("outcome") or "")
        if not rank:
            continue
        if lead.get("next") and lead["next"] <= today.isoformat():
            rank += 1                                  # their own date has come
        if best is None or (rank, last["date"]) > (best[1], best[2]["date"]):
            best = (lead, rank, last)
    if not best:
        return None
    lead, _, last = best
    why = (f"{last['outcome']} {dt.date.fromisoformat(last['date']).strftime('%-d %b')}"
           + (f": \"{last['note']}\"" if last.get("note") else ""))
    return {"name": lead["name"], "phone": lead.get("phone"), "why": why, "key": lead["key"]}


def todays_kit(args, today):
    """Today's six: the remote run already saved today, else one run now (about $0.15 of Places; a preview
    for each pick too, built and published, once the previews project is up — `previews_on`; never with --no-save)."""
    folder = STATE / "remote"
    saved = sorted(folder.glob(f"{today.isoformat()}*.json"), key=lambda p: p.stat().st_mtime) if folder.exists() else []
    if saved and not args.fresh:
        try:
            return json.loads(saved[-1].read_text()), False
        except ValueError:
            pass
    segment = resolve_segment(args.segment)
    ns = argparse.Namespace(census_only=args.census_only, fixture=args.fixture, refresh=False, radius=30.0,
                            min_reviews=25 if segment == "restaurant" else None, allow_repeat=False,
                            n=args.n, previews=previews_on() and not args.no_save, no_save=args.no_save)
    try:
        _, picks = (build_remote if segment == "restaurant" else lambda a: build_segment_remote(a, segment))(ns)
    except SystemExit:
        return {"date": today.isoformat(), "segment": segment, "picks": []}, True
    return kit_json(picks, segment, today), True


def today_data(args, today):
    """Everything the 07:30 message says, as data (`--json` prints this and the message itself)."""
    kit, fresh = todays_kit(args, today)
    lane, reps = yesterdays_replies(today - dt.timedelta(days=1))
    state = pipeline_state()
    due = []
    for lead in due_by(today):
        what, do = due_touch(lead, today)
        row = {"name": lead["name"], "city": lead.get("city"), "what": what, "do": do,
               "late": (today - dt.date.fromisoformat(lead["next"])).days, "key": lead["key"]}
        last = lead["history"][-1]
        if last.get("kind") == "touch_due" and int(last.get("touch") or 0) == 30:
            row["listing"] = thirty_day_read(lead, args, today)
        due.append(row)
    email_off, n = email_gate(kit["picks"])
    words = []
    if not email_off and (env_value("OUTREACH_AUTO") or "") != "1":
        # B62: the reply words only when `outreach send --go` would actually put a letter in the post
        words = [f"go — send the {n} email{'s' if n != 1 else ''} in today's six",
                 "go 1 3 — only those", "hold 4 — hold one back"]
    six = [dict(p, **morning_pick(p, email_on=not email_off)) for p in kit["picks"]]
    return {"date": today.isoformat(), "segment": kit.get("segment"), "fresh_kit": fresh,
            "six": six, "lane": lane, "replies": reps, "inbound": inbound_rows(today, state),
            "due": due, "first_call": warmest(today, state), "words": words, "email_off": email_off}


def first_letter_approved():
    """Taylor's word on the day-0 letter, read the way `outreach send` reads it: the hash of first.md in APPROVED."""
    folder = Path(os.environ.get("OUTREACH_TEMPLATES", TOOLBELT / "templates" / "outreach"))
    t, a = folder / "first.md", folder / "APPROVED"
    if not (t.exists() and a.exists()):
        return False
    sha = hashlib.sha256(t.read_text().encode()).hexdigest()
    return any(l.split()[:2] == ["first", sha] for l in a.read_text().splitlines() if not l.startswith("#"))


def email_gate(picks):
    """(None, how many letters) when `outreach send --go` would send today, else (the first reason it wouldn't, 0).
    The settings in the order `outreach send` refuses on them, then today's picks — no provider call, no spend."""
    if not env_value("LEADS_MAIL_ADDRESS"):
        return "no postal address for the footer yet (LEADS_MAIL_ADDRESS, TAYLOR-TODO §1)", 0
    if not first_letter_approved():
        return "the first letter isn't approved yet (`outreach approve`)", 0
    if not (env_value("INSTANTLY_API_KEY") or (env_value("OUTREACH_PROVIDER") or "").lower() == "fake"):
        return "no mailbox yet (INSTANTLY_API_KEY)", 0
    try:
        per_day = int(env_value("OUTREACH_PER_DAY") or 0)
    except ValueError:
        per_day = 0
    if per_day <= 0:
        return "OUTREACH_PER_DAY is 0", 0
    with_email = [p for p in picks if p.get("email")]
    if not with_email:
        return "none of the six has an address (B61 is finding them)", 0
    ready = [p for p in with_email if p.get("preview_url")]
    if not ready:
        return "every letter carries a preview page and none of theirs is built yet (B45)", 0
    return None, min(len(ready), per_day)


def call_opener(p):
    """What to say when the only way in is the phone: the register in the approved prep call frame
    (templates/prep/message.md § call) — the same one fault as the DM, then ask to text the link."""
    biz = plain_name(p["name"])
    said, built, offer = register_parts(p, p.get("faults") or [])
    looked = f"Looked you up on Google — {said}" if said else "Looked you up on Google"
    if p.get("preview_url"):
        did = built.removeprefix("So ").rstrip(".")          # "I went ahead and built you one"
        return (f"Say: \"Hi, is this {biz}? This is Taylor, a small business owner in American Fork. {looked}, so {did}. "
                f"Could I text you the link? Nothing to sign, and I'll take it down the moment you say so.\"")
    return (f"Say: \"Hi, is this {biz}? This is Taylor, a small business owner in American Fork. {looked}. {offer} — could I text you "
            f"what it'd look like?\"")


def morning_pick(p, email_on):
    """B62: what Taylor does with one of the six — {"how": where it goes, "dm": message one to paste (the register,
    `register_dm`), "then": message two for when they say yes (the link, the AI line, the price; None without a
    preview), "say": the call opener, "skipped": the handles refused as another city's}. Added to each pick in
    `--json`; nothing there is renamed."""
    url = p.get("preview_url")
    if not url and p.get("place_id"):              # a saved kit, and a preview built since (`leads preview`)
        m = next((m for m in previews_all() if m.get("place_id") == p["place_id"] and not m.get("claimed")), None)
        url = m["url"] if m else None
    c = {"name": p["name"], "segment": p.get("segment"), "place_id": p.get("place_id"), "preview_url": url,
         "reviews": p.get("reviews"), "rating": p.get("rating"), "city": p.get("city")}
    faults = p.get("faults") or []
    if p.get("variant") == "tool" or (not faults and p.get("message")):
        dm = p.get("message")                      # the B40 booking message is its own; it is kept as saved
    else:
        dm = register_dm(c, faults) if faults else p.get("message")
    then = then_text(url) if (dm and url) else None
    ig, fb, skipped, email = pick_handles(p, with_email=True)
    p = dict(p, email=email)                       # B104: a saved address the table no longer finds `high` is gone
    phone = p.get("phone")
    out = {"dm": dm, "then": then, "say": None, "skipped": skipped, "preview_url": url}
    if ig:
        return dict(out, how=f"Instagram: instagram.com/{ig}")
    if fb:
        return dict(out, how="Facebook: " + fb)
    out.update(dm=None, then=None)
    if p.get("email") and email_on:
        return dict(out, how=f"email: {p['email']} — the letter goes on `go`")
    if phone:
        also = f" (the email to {p['email']} waits for the email lane)" if p.get("email") else ""
        return dict(out, how=f"call: {phone}{also}", say=call_opener(dict(p, preview_url=url)))
    return dict(out, how=f"no way in yet — leads brief \"{p['name']}\"")


def pick_handles(p, with_email=False):
    """(instagram handle, 'facebook.com/…', skipped) for a saved pick, read again: the Facebook page from the
    `reach` table when the saved one was cut short (facebook.com/p before 2026-09-30), and `reach_guard` over both.
    Since B104 `skipped` also carries the unconfirmed labels, and `with_email` adds the address as a 4th item, None
    when the table doesn't find it `high` (a kit saved before B104 may carry one)."""
    raw = p.get("facebook") or ""
    fb = fb_page(raw) if raw else None
    row_fb = ((reach_table() or {}).get(p.get("place_id") or "") or {}).get("facebook")
    if raw and row_fb and (fb is None or row_fb.startswith(fb + "/")):
        fb = row_fb
    out = reach_guard({"instagram": p.get("instagram"), "facebook": fb, "email": p.get("email"),
                       "skipped": list(p.get("reach_skipped") or [])},
                      {"place_id": p.get("place_id"), "name": p.get("name"), "city": p.get("city")})
    said = list(out.get("skipped") or [])
    said += [u["label"] for u in out.get("unconfirmed") or [] if u["label"] not in said]
    if with_email:
        return out["instagram"], out["facebook"], said, out.get("email")
    return out["instagram"], out["facebook"], said


def today_message(d, n_due=6):
    """The message itself: under 60 lines, a pick's line then its DM (or its call), nothing that isn't in `d`."""
    day = dt.date.fromisoformat(d["date"])
    six, due = d["six"], d["due"]
    head = (f"Morning — {day.strftime('%a %-d %b')} · {SEGMENT_TITLE.get(d['segment'], 'leads').lower()} · "
            f"{len(six)} to send, {len(d['replies'])} repl{'y' if len(d['replies']) == 1 else 'ies'} yesterday, "
            f"{len(due)} follow-up{'s' if len(due) != 1 else ''} due")
    lines = [head, ""]
    for i, p in enumerate(six, 1):
        m = p if "how" in p else dict(p, **morning_pick(p, email_on=not d.get("email_off")))
        bits = [f"{i}. {p['name']}", p.get("category") or p.get("segment") or "", p.get("city") or "", m["how"],
                "; ".join(m.get("skipped") or []), language_tag(p) or ""]
        bits.append(strength_tag(p, n=2))                                 # B73: the level and why, last
        lines.append(" · ".join(b for b in bits if b))
        if m.get("dm"):
            lines.append(m["dm"])          # its own line, no quotes or indent: a long-press copies it as it goes
            if m.get("then"):
                lines.append(f"When they say yes: {m['then']}")
            else:
                lines.append(f"(no preview built — leads preview \"{p['name']}\")")
        elif m.get("say"):
            lines.append(m["say"])
        lines.append("")
    if six:
        lines.pop()
    else:
        lines.append("No kit today — the pool is empty or every lead is already in the pipeline (`leads candidates`).")
    lines.append("")
    if not d["lane"]:
        lines.append("Yesterday: the email lane isn't running yet (`outreach doctor`), so replies are whatever came to your phone.")
    elif not d["replies"]:
        lines.append("Yesterday: no replies.")
    else:
        by = {}
        for r in d["replies"]:
            by.setdefault(r.get("class") or "other", []).append(r.get("name") or r.get("from") or "?")
        lines.append("Yesterday: " + " · ".join(f"{k} — {', '.join(v[:3])}" for k, v in sorted(by.items())))
    if d.get("inbound"):
        lines.append(f"What came to us ({len(d['inbound'])}) — answer these first:")
        for r in d["inbound"][:4]:
            lines.append(f"  {r['name']}{' · ' + r['phone'] if r.get('phone') else ''} — {r.get('note') or 'no note'}")
        if len(d["inbound"]) > 4:
            lines.append(f"  +{len(d['inbound']) - 4} more — `leads pipeline`")
    lines.append("")
    if due:
        lines.append(f"Due today ({len(due)}):")
        for r in due[:n_due]:
            late = f" · {r['late']}d late" if r["late"] > 0 else ""
            lines.append(f"  {r['name']} — {r['what']}{late}: {r['do']}")
            if r.get("listing"):
                lines.append(f"     the listing now: {r['listing']}")
        if len(due) > n_due:
            lines.append(f"  +{len(due) - n_due} more — `leads due`")
    else:
        lines.append("Due today: nothing.")
    lines.append("")
    fc = d["first_call"]
    if fc:
        lines.append(f"First call: {fc['name']}{' · ' + fc['phone'] if fc.get('phone') else ''} — {fc['why']}")
        lines.append(f"  the brief: leads brief \"{fc['name']}\"")
    elif six:
        lines.append(f"First call: nobody warm yet — the six above are the day's work.")
    if d["words"]:
        lines += ["", "Needs a word: " + " · ".join(d["words"])]
    elif d.get("email_off") and six:
        lines += ["", f"Email is off today — {d['email_off']} — so the six are yours to send; no word needed."]
    return "\n".join(lines) + "\n"


def cmd_today(args):
    today = now_date()
    d = today_data(args, today)
    msg = today_message(d)
    if args.json:
        print(json.dumps(dict(d, message=msg), indent=1, default=str))
        return
    print(msg, end="")


def objections_for(segment, presence_class):
    keys = list(SEGMENT_OBJECTION.get(segment or "", ("price", "think")))
    if presence_class == "directory":
        keys = ["directory"] + [k for k in keys if k != "directory"]
    return [(k, *OBJECTIONS[k]) for k in keys[:2]]


def cmd_brief(args):
    """One screen before a call (§ 6.2): the business, the faults, the preview, the listing, the history,
    the objection that is coming and its answer, the close, the booking link. No Places call unless --live."""
    today = now_date()
    key, pid, name, city, row, _ = resolve_lead(" ".join(args.name), args.place)
    lead = pipeline_state().get(key)
    if row is None and pid:
        row = (_census_by_id(pid) or [None])[0]
    details = None
    if args.live and pid:
        k, where = places_key()
        places = Places(k, where, fixture=args.fixture)
        details = places.get(pid)
        if places.calls:
            ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "places_details",
                           "tool": "leads", "calls": places.calls, "cost_usd": round(places.calls * DETAILS_COST_USD, 3),
                           "billed_to": f"google:GOOGLE_MAPS_API_KEY({where})", "project": "global",
                           "for": f"brief {name}"})
    if not lead and not row:
        die(f"{name} isn't in the pipeline or the census — `leads log \"{name}\" talked …` first")
    segment = (row or {}).get("segment") or ("restaurant" if row else None)
    fs, summary = lead_faults(row, details, today) if row else ([], None)
    if not fs and lead:
        fs = [x for x in ((first_message(lead) or {}).get("was") or "").split("; ") if x]
    pv = preview_find(name) or (next((m for m in previews_all() if m.get("place_id") == pid), None) if pid else None)

    print(f"{name}{' — ' + city if city else ''}"
          + (f" · {(row or {}).get('category') or SEGMENT_NOUN.get(segment or '', '')}" if row else ""))
    if summary:
        print(f"  Google: {summary}")
    phone = (lead or {}).get("phone") or (row or {}).get("phone")
    judged = reach_judgement(pid) if pid else {}                 # B104: a logged handle that isn't high is said, not shown
    shown = lambda t: shown_reach(t, judged) if t else t           # noqa: E731
    contact = " · ".join(x for x in (phone, shown((lead or {}).get("reach")), shown(lead_email(lead or {})),
                                     clean_maps((row or {}).get("google_maps_uri") or "") or None) if x)
    if contact:
        print(f"  {contact}")
    print("  Wrong: " + ("; ".join(fs[:3]) if fs else "nothing obvious — lead with what a site would add"))
    print("  Strength: " + strength_tag(row, n=9, lead=lead or {"key": key, "place_id": pid}))   # B73
    hosting = paying_sentence(pid) if pid else None
    if hosting:
        print(f"  Hosting: {hosting}")
    li = language_info(pid) if pid else None
    if li and li["language"] != "unknown":
        print(f"  Language: {li['language']} — {li['why']}")
    print(f"  Preview: {pv['url']} (down {dt.date.fromisoformat(pv['expires']).strftime('%-d %b')})" if pv
          else "  Preview: none yet — `leads preview \"" + name + "\"`")
    if lead:
        print(f"  Stage: {lead['stage']}" + (f", follow up {lead['next']}" if lead.get("next") else "")
              + (f" · came in by {lead_source(lead)}" if lead_source(lead) else ""))
        for e in lead["history"]:
            what = (f"day {e.get('touch')} touch ({e.get('channel')})" if e.get("kind") == "touch_due"
                    else e.get("outcome") or "")
            print(f"    {e['date']}  {what:<16} {e.get('note') or ''}".rstrip())
    else:
        print("  Stage: not in the pipeline yet — this is a cold call")
    print()
    for _, q, a in objections_for(segment, (row or {}).get("presence")):
        print(f"  They'll say {q}")
        print(f"    You say: {a}")
    print()
    print("  " + SEGMENT_CLOSE)
    if segment in SEGMENT_LADDER:
        print("  " + SEGMENT_LADDER[segment])
    book = env_value("LEADS_BOOKING_URL")
    print(f"  Book them while you're on the phone: {book}" if book else
          "  Booking link: not set yet (LEADS_BOOKING_URL, TAYLOR-TODO §1) — name a day and `leads log … --next`")


# ---- the owner's overview (B102, plan ~/projects/plans/42-owner-overview-contract.md) --------------------
# The relay pushes these two objects to patchlamp.com/account/overview. They leave the laptop, so they hold
# counts only: no lead's name, phone, email, place id or note. Each prints one JSON object on stdout and
# nothing else, so the relay can parse it whole; a failure is {"ok": false, "why": …} with a non-zero exit.

def json_out(fn, *a):
    try:
        out = dict({"ok": True}, **fn(*a))
    except SystemExit as exc:                    # die() already said why on stderr
        print(json.dumps({"ok": False, "why": f"leads exited {exc.code}; see stderr"}))
        sys.exit(1)
    except Exception as exc:                     # noqa: BLE001  the relay needs a reason, not a traceback
        # the message itself stays on stderr: it could quote a pipeline line, and this object leaves the laptop
        print(f"leads: {type(exc).__name__}: {exc}", file=sys.stderr)
        print(json.dumps({"ok": False, "why": f"reading the pipeline failed ({type(exc).__name__}); see stderr"}))
        sys.exit(1)
    print(json.dumps(out))


def pipeline_counts():
    """Every stage `leads pipeline` knows with its count (zeros included) and the follow-ups due today or earlier."""
    state = pipeline_state()
    stages = {s: sum(1 for l in state.values() if l.get("stage") == s) for s in STAGES}
    odd = sum(1 for l in state.values() if l.get("stage") not in STAGES)
    if odd:
        print(f"leads: {odd} lead(s) with no known stage, not counted", file=sys.stderr)
    return {"stages": stages, "due_today": len(due_by(now_date()))}


def week_counts(start, end, today):
    """The numbers `leads week`'s first line prints, for the week of `start`. `talked` is that line's
    "conversations" (visited, talked, interested, demo, later, won, lost); `replied` is what
    `leads week --by channel` calls replies: a conversation outcome this week from a lead we had messaged."""
    evs = week_events(start, end)
    counts = {o: sum(1 for e in evs if e.get("outcome") == o) for o in OUTCOMES}
    messaged = {e.get("key") for e in pipeline_events() if e.get("outcome") == "messaged"}
    replied = sum(1 for e in evs if e.get("outcome") in CONVERSATION and e.get("key") in messaged)
    convo = sum(counts[o] for o in ("visited", "talked", "interested", "demo", "later", "won", "lost"))
    return {"of": start.isoformat(), "messaged": counts["messaged"], "replied": replied, "talked": convo,
            "interested": counts["interested"], "demos": counts["demo"], "won": counts["won"], "lost": counts["lost"]}


def cmd_pipeline(args):
    if getattr(args, "json", False):
        return json_out(pipeline_counts)
    state = pipeline_state()
    if getattr(args, "strong", False):
        return cmd_pipeline_strong(state)
    if not state:
        print("The pipeline is empty. `leads log \"Name\" visited|talked|interested|demo|won|lost|messaged|later [note]`")
        return
    for s in STAGES:
        rows = sorted((l for l in state.values() if l.get("stage") == s), key=lambda l: l.get("next") or "9")
        if not rows or (s in ("won", "lost") and not args.all):
            if rows:
                print(f"{s}: {len(rows)}")
            continue
        print(f"{s}: {len(rows)}")
        for l in rows:
            print(f"  {l['name']}{' (' + l['city'] + ')' if l.get('city') else ''}"
                  + (f" · next {l['next']}" if l.get("next") else "") + f" · last {l['last']}")


# ---- strength (B73, plan ~/projects/plans/33-leads-by-strength.md; the weights: client-leads/strength.md) ----
#
# Every lead is strong, good or weak, from named reasons, so a line can say *why* in words. The weights and the
# two thresholds are read from client-leads/strength.md's tables (LEADS_STRENGTH overrides the path) and fall back
# to the ones below; re-weighting after a month is an edit to that file, not to this one. Taylor's
# `leads strength NAME strong|good|weak "why"` is a pipeline event (kind "strength") and always wins.

STRENGTH_DOC = Path(os.environ.get("LEADS_STRENGTH", PROJECTS / "client-leads/strength.md"))
STRENGTHS = ("strong", "good", "weak")
STRENGTH_RANK = {"strong": 0, "good": 1, "weak": 2}
# key -> (weight, the short label the week's by-reason table prints). Positive for, negative against.
STRENGTH_REASONS = {
    "paying_dead": (6, "agency site dead or parked"),
    "dead_link": (3, "a dead link of their own"),
    "no_site": (2, "no website"),
    "embarrassing": (1, "the listing embarrasses them"),
    "fit": (1, "10–300 reviews at 4.3★+"),
    "near": (1, "within 10 miles"),
    "reach": (1, "a reach with evidence"),
    "owner": (1, "a named owner"),
    "ladder": (1, "quotes jobs (the form)"),
    "chain": (-10, "a chain"),
    "franchise": (-4, "a franchise"),
    "cheap_builder": (-3, "a live builder site under $50"),
    "low_rating": (-2, "rated under 4.0"),
}
STRENGTH_AT = {"strong": 6, "good": 4}
FIT_BAND = ((10, 300), 4.3)               # prep's fit (plan 28 § B67.1), one of the reasons now
NEAR_MILES = 10.0
# The cadence by strength (GROWTH § 5.5, re-cut 2026-09-29): the touch days, and the day a silent lead is back
# in the pool (None: never without Taylor's word — it lands on "strong, silent" in `leads week`).
STRENGTH_CADENCE = {"weak": (3, 10), "good": (3, 10, 30), "strong": (3, 10, 30, 45, 60, 90)}
STRENGTH_POOL_DAY = {"weak": 30, "good": 90, "strong": None}
QUOTE_WORDS = ("roof", "plumb", "hvac", "heating", "air condition", "handyman", "paint", "landscap", "electric", "pest",
               "pressure wash", "power wash", "garage door", "pool", "snow", "concrete", "fenc", "remodel", "contractor",
               "floor", "tree", "gutter", "window", "sprinkler", "irrigation", "lawn", "junk", "mover", "moving", "carpet",
               "tile", "cabinet", "deck", "siding", "insulation", "solar", "mason", "excavat", "asphalt", "paving",
               "appliance", "photograph", "videograph", "dj", "cater")
FRANCHISE_BRANDS = ("mr. rooter", "mr rooter", "mr. handyman", "mr handyman", "mr. electric", "mr. appliance",
                    "roto-rooter", "molly maid", "merry maids", "the maids", "maid brigade", "servicemaster", "servpro",
                    "chem-dry", "chemdry", "window genie", "fish window", "one hour heating", "benjamin franklin plumbing",
                    "aire serv", "mosquito joe", "mosquito authority", "two men and a truck", "grounds guys", "weed man",
                    "lawn doctor", "terminix", "orkin", "truly nolen", "aptive", "glass doctor", "sir grout",
                    "dryer vent wizard", "bath fitter", "re-bath", "five star painting", "certapro", "college pro",
                    "men in kilts", "junk king", "1-800-got-junk", "college hunks", "window world", "renewal by andersen",
                    "leaffilter", "precision garage door", "a1 garage door", "overhead door", "puroclean",
                    "paul davis", "rainbow restoration", "budget blinds", "handyman connection", "neighborly")
_STRENGTH_W = None
_OVERRIDES = None
_CHAIN_IDS = None
_CHAIN_NAMES = None


def strength_weights():
    """(reason -> weight, level -> threshold): client-leads/strength.md's tables where they parse, else the defaults.
    A table row counts when its first cell is a known reason key (or `strong` / `good`) and its second a number."""
    global _STRENGTH_W
    if _STRENGTH_W is not None:
        return _STRENGTH_W
    w = {k: v[0] for k, v in STRENGTH_REASONS.items()}
    at = dict(STRENGTH_AT)
    try:
        text = STRENGTH_DOC.read_text()
    except OSError:
        text = ""
    for line in text.splitlines():
        if not line.startswith("|"):
            continue
        cells = [x.strip().strip("`*") for x in line.strip().strip("|").split("|")]
        if len(cells) < 2:
            continue
        try:
            n = int(cells[1].replace("−", "-").replace("+", ""))
        except ValueError:
            continue
        if cells[0] in w:
            w[cells[0]] = n
        elif cells[0] in at:
            at[cells[0]] = n
    _STRENGTH_W = (w, at)
    return _STRENGTH_W


def strength_overrides():
    """key -> Taylor's last `leads strength` event (its `strength` None when he cleared it with `auto`)."""
    global _OVERRIDES
    if _OVERRIDES is None:
        _OVERRIDES = {}
        for e in pipeline_events():
            if e.get("kind") == "strength":
                _OVERRIDES[e["key"]] = e
                if e.get("place_id"):
                    _OVERRIDES[f"place:{e['place_id']}"] = e
    return _OVERRIDES


def _chains():
    """(place ids the census flags as chains, names at three or more places) — read once."""
    global _CHAIN_IDS, _CHAIN_NAMES
    if _CHAIN_IDS is None:
        _CHAIN_IDS, _CHAIN_NAMES = set(), set()
        if CENSUS.exists():
            conn = sqlite3.connect(f"file:{CENSUS}?mode=ro", uri=True)
            try:
                tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
                if "businesses" in tables:
                    _CHAIN_IDS |= {r[0] for r in conn.execute(
                        "SELECT place_id FROM businesses WHERE (CASE WHEN chain_override = 'yes' THEN 1 "
                        "WHEN chain_override = 'no' THEN 0 ELSE COALESCE(is_chain, 0) END) = 1")}
                if "restaurants" in tables:
                    _CHAIN_IDS |= {r[0] for r in conn.execute("SELECT place_id FROM restaurants WHERE is_chain = 1")}
            finally:
                conn.close()
            _CHAIN_NAMES = chain_names()
    return _CHAIN_IDS, _CHAIN_NAMES


def cached_details(place_id):
    """The last listing read for this place, from the kit's cache, whatever its age — never a Places call."""
    p = STATE / "details" / f"{place_id}.json"
    try:
        return json.loads(p.read_text()) if place_id and p.exists() else None
    except (OSError, ValueError):
        return None


def _strength_row(obj):
    """A census row with the fields the score reads, from a candidate, a kit pick or a pipeline lead (by place id)."""
    pid = (obj or {}).get("place_id")
    if obj and "reviews" in obj and ("presence" in obj or "presence_class" in obj or "has_website" in obj):
        row = obj
    else:
        found = _census_by_id(pid) if pid else []
        if not found:
            return None
        row = dict(found[0])
    if not row.get("presence"):
        row = dict(row)
        row["presence"], row["presence_label"], row["presence_link"] = presence(row)
    if row.get("miles") is None and row.get("lat") is not None and row.get("lng") is not None:
        row = dict(row, miles=round(miles(home(), (row["lat"], row["lng"])), 1))
    return row


def strength_reasons(row, details=None, who=None):
    """[{key, says, weight}] for a census row, strongest first, the reasons against last."""
    w, _ = strength_weights()
    pid = row.get("place_id")
    out = []

    def add(key, says):
        out.append({"key": key, "says": says, "weight": w[key]})
    hi = host_info(pid)
    dead = host_dead(hi) if hi else False
    pcls = row.get("presence")
    if hi and hi["kind"] == "agency" and dead:
        add("paying_dead", f"{hi['says']} site {'parked' if hi.get('status') == 'parked' else 'dead'}")
    elif pcls == "dead" or (dead and hi["kind"] not in HOST_FREE_KINDS):
        link = host_of(row.get("presence_link") or row.get("website") or "") or row.get("presence_label")
        add("dead_link", f"dead link ({link})" if link else "dead link")
    if pcls == "none":
        add("no_site", "no website")
    d = details or cached_details(pid)
    if d:
        if d.get("businessStatus") == "CLOSED_TEMPORARILY" and any(
                (review_age_days(r, now_date()) or 999) <= 60 for r in d.get("reviews") or []):
            add("embarrassing", "Google says closed, reviews say open")
        elif d.get("businessStatus") in (None, "OPERATIONAL") and not (d.get("regularOpeningHours") or {}).get("periods"):
            add("embarrassing", "no hours on Google")
    (lo, hi_n), stars = FIT_BAND
    reviews, rating = int(row.get("reviews") or 0), float(row.get("rating") or 0)
    if lo <= reviews <= hi_n and rating >= stars:
        add("fit", f"{reviews} reviews at {rating:g}")
    if row.get("miles") is not None and row["miles"] <= NEAR_MILES:
        add("near", f"{row['miles']} mi")
    if is_business(row):
        rc = business_reach(dict(row))
        link = row.get("presence_link") or row.get("website") or ""
        own = bool(re.match(r"^(?:https?://)?(?:www\.|m\.|web\.)?(?:instagram|facebook)\.com/", link))
        ev = own or bool(((reach_table() or {}).get(pid) or {}).get("evidence"))
        has = [k for k in ("instagram", "facebook", "email") if rc.get(k)]
        if has and ev:
            add("reach", {"instagram": "Instagram", "facebook": "Facebook", "email": "an email"}[has[0]]
                + " with evidence")
    owner = who or row.get("contact_name") or first_name(row.get("name") or "")
    if owner:
        add("owner", f"owner {owner}")
    cat = f"{row.get('category') or ''} {row.get('primary_type') or ''}".lower().replace("_", " ")
    if any(x in cat for x in QUOTE_WORDS if x != "dj") or re.search(r"\bdj\b", cat):
        add("ladder", "quotes jobs")
    ids, names = _chains()
    name = (row.get("name") or "").lower()
    if pid in ids or name in names:
        add("chain", "a chain")
    else:
        brand = next((b for b in FRANCHISE_BRANDS if b in name), None)
        if brand:
            add("franchise", f"a franchise ({brand.title()})")
    if hi and hi["kind"] == "builder" and not dead and (
            (hi.get("evidence") or {}).get("url_host") or (hi.get("from") is not None and hi["from"] < 50)):
        add("cheap_builder", f"a live {hi['says']} site under $50")
    if row.get("rating") is not None and rating < 4.0:
        add("low_rating", f"rated {rating:g}")
    order = list(STRENGTH_REASONS)
    out.sort(key=lambda r: (r["weight"] < 0, -abs(r["weight"]) if r["weight"] < 0 else 0, order.index(r["key"])))
    return out


def strength(row, details=None, lead=None):
    """(level, reasons) — the one function candidates, the kits, today, brief, cadence, log, week and `prep pick` read.
    Taylor's override wins; a lead with no census row is `good` (today's cadence) until he says otherwise."""
    lead = lead or {}
    key = lead.get("key") or (f"place:{row['place_id']}" if row and row.get("place_id") else None)
    ov = strength_overrides().get(key) if key else None
    r = _strength_row(row) if row else None
    if r is None and lead.get("place_id"):
        r = _strength_row({"place_id": lead["place_id"]})
    if r is not None:
        reasons = strength_reasons(r, details, lead.get("who"))
        score = sum(x["weight"] for x in reasons)
        _, at = strength_weights()
        level = ("weak" if any(x["key"] == "chain" for x in reasons) else
                 "strong" if score >= at["strong"] else "good" if score >= at["good"] else "weak")
    else:
        level, reasons = "good", [{"key": "unscored", "says": "not in the census, scored good", "weight": 0}]
        for e in reversed(lead.get("history") or []):         # what was recorded when it was logged
            if e.get("strength") in STRENGTHS and e.get("kind") != "strength":
                level = e["strength"]
                break
    if ov and ov.get("strength") in STRENGTHS:
        says = f"Taylor: \"{ov['note']}\"" if ov.get("note") else "Taylor's word"
        return ov["strength"], [{"key": "taylor", "says": says, "weight": None}] + reasons
    return level, reasons


def strength_rank(row):
    return STRENGTH_RANK[strength(row)[0]]


def strength_order(row):
    """The sort key a list of leads takes to put strong first: the level, then the score within it (a stable sort
    keeps the list's own order — nearest, messageable — among equals)."""
    level, reasons = strength(row)
    return STRENGTH_RANK[level], -sum(r["weight"] or 0 for r in reasons)




def strength_tag(row, skip=(), n=3, lead=None):
    """'strong · Hibu site dead · 92 reviews at 4.9 · 1.1 mi' — the level and why, in words, for one line."""
    level, reasons = strength(row, lead=lead)
    pos = [r["says"] for r in reasons if (r["weight"] is None or r["weight"] > 0) and r["key"] not in skip]
    neg = [r["says"] for r in reasons if r["weight"] is not None and r["weight"] < 0]
    return " · ".join([level] + pos[:n] + neg[:1])


def strength_fields(row=None, lead=None):
    """The pipeline row's `strength` and `reasons` (the keys), as scored when the event is written."""
    level, reasons = strength(row, lead=lead)
    return {"strength": level, "reasons": [r["key"] for r in reasons]}


def lead_strength(lead):
    return strength(None, lead=lead)[0]


def lead_cadence(lead):
    return STRENGTH_CADENCE[lead_strength(lead)]


def strength_hold(lead, today):
    """True while the pipeline holds a silent messaged lead out of the kits: weak to day 30, good to day 90,
    strong until Taylor's word (`later`, `lost`, or `leads strength NAME good`)."""
    m = first_message(lead)
    if not m or lead.get("stage") in ("won", "lost", "churned") or answered_since(lead):
        return False
    day = STRENGTH_POOL_DAY[lead_strength(lead)]
    return day is None or today < dt.date.fromisoformat(m["date"]) + dt.timedelta(days=day)


def strong_silent(state=None):
    """Strong leads past their last touch with no answer: the Sunday review's list for Taylor's call."""
    last = STRENGTH_CADENCE["strong"][-1]
    out = []
    for lead in (state or pipeline_state()).values():
        if lead.get("stage") in ("won", "lost", "trialing", "churned") or answered_since(lead):
            continue
        if last in touches_done(lead) and lead_strength(lead) == "strong":
            out.append(lead)
    return sorted(out, key=lambda l: l["name"])


def strong_silent_lines(state=None):
    rows = strong_silent(state)
    if not rows:
        return []
    lines = [f"Strong, silent ({len(rows)}) — your call: `leads log NAME later` keeps it, "
             "`leads strength NAME good` lets it back into the pool, `lost` closes it"]
    for l in rows[:8]:
        m = first_message(l) or {}
        lines.append(f"  {l['name']}{' (' + l['city'] + ')' if l.get('city') else ''} — messaged {m.get('date', '?')}, "
                     f"six touches, no answer · {strength_tag(None, lead=l)}")
    if len(rows) > 8:
        lines.append(f"  +{len(rows) - 8} more — `leads pipeline --strong`")
    return lines


def week_by_strength(today):
    """Every lead messaged so far, by the strength it had when the first message went and by each reason it carried:
    what came of it. After a month the reasons that convert re-weight client-leads/strength.md."""
    state = pipeline_state()
    cols = ("messaged", "replied", "conversations", "trials", "won", "lost")
    by_level = {s: dict.fromkeys(cols, 0) for s in STRENGTHS}
    by_reason = {}
    for lead in state.values():
        m = first_message(lead)
        if not m or m["date"] > today.isoformat():
            continue
        level = m.get("strength") if m.get("strength") in STRENGTHS else lead_strength(lead)
        keys = m.get("reasons") if isinstance(m.get("reasons"), list) else [r["key"] for r in strength(None, lead=lead)[1]]
        after = [e for e in lead["history"] if e["date"] >= m["date"] and e.get("date") <= today.isoformat()]
        outs = {e.get("outcome") for e in after}
        row = {"messaged": 1, "replied": int(any(o in CONVERSATION for o in outs)),
               "conversations": sum(1 for e in after if e.get("outcome") in CONVERSATION),
               "trials": int("trial" in outs), "won": int("won" in outs), "lost": int("lost" in outs)}
        for c in cols:
            by_level[level][c] += row[c]
            for k in keys:
                by_reason.setdefault(k, dict.fromkeys(cols, 0))[c] += row[c]
    return {"by_strength": by_level, "by_reason": by_reason, "strong_silent": [l["name"] for l in strong_silent(state)]}


def week_strength_message(d, today):
    w, _ = strength_weights()
    lines = [f"Leads by strength — everyone messaged to {today.strftime('%-d %b')}, by the strength when the first "
             "message went · messaged · replied · conversations · trials · won · lost"]
    for s in STRENGTHS:
        r = d["by_strength"][s]
        rate = f" · {round(100 * r['replied'] / r['messaged'])}% replied" if r["messaged"] else ""
        lines.append(f"  {s:<7} " + " · ".join(str(r[c]) for c in ("messaged", "replied", "conversations", "trials",
                                                                   "won", "lost")) + rate)
    lines.append("By reason (a lead counts under each reason it carried; the weight is client-leads/strength.md's):")
    keys = sorted(d["by_reason"], key=lambda k: (-d["by_reason"][k]["messaged"], k))
    for k in keys:
        r = d["by_reason"][k]
        label = STRENGTH_REASONS.get(k, (0, {"taylor": "Taylor's word", "unscored": "not in the census"}.get(k, k)))[1]
        wt = w.get(k)
        lines.append(f"  {k:<13} {('%+d' % wt) if wt is not None else '  '}  {r['messaged']} messaged · {r['replied']} "
                     f"replied · {r['won']} won — {label}")
    if not keys:
        lines.append("  (nobody messaged yet — `leads sent`, `leads log NAME messaged`)")
    lines += strong_silent_lines()
    return "\n".join(lines) + "\n"


def cmd_strength(args):
    """`leads strength NAME` shows it; `leads strength NAME strong|good|weak "why"` is Taylor's override (it always
    wins, and a re-score never moves it); `auto` hands the lead back to the score."""
    key, pid, name, city, row, _ = resolve_lead(" ".join(args.name), args.place)
    lead = pipeline_state().get(key) or {"key": key, "place_id": pid, "name": name, "history": []}
    if args.level:
        lv = args.level.lower()
        if lv not in STRENGTHS + ("auto",):
            die("the level is strong, good, weak — or auto, to hand it back to the score")
        event = {"ts": dt.datetime.now(TZ).isoformat(timespec="seconds"), "date": now_date().isoformat(), "key": key,
                 "place_id": pid, "name": name, "city": city, "outcome": "strength", "kind": "strength",
                 "strength": None if lv == "auto" else lv, "reasons": ["taylor"], "by": "hand",
                 "note": " ".join(args.why).strip() or None}
        PIPELINE.parent.mkdir(parents=True, exist_ok=True)
        with open(PIPELINE, "a") as f:
            f.write(json.dumps({k: v for k, v in event.items() if v is not None or k == "strength"}) + "\n")
        global _OVERRIDES
        _OVERRIDES = None
    level, reasons = strength(row, lead=lead)
    print(f"{name}{' (' + city + ')' if city else ''}: {level}"
          + (" — Taylor's word" if reasons and reasons[0]["key"] == "taylor" else ""))
    for r in reasons:
        wt = "" if r["weight"] is None else f"{r['weight']:+d}  "
        print(f"  {wt}{r['says']}")
    cad = STRENGTH_CADENCE[level]
    pool = STRENGTH_POOL_DAY[level]
    print(f"  cadence: day {', '.join(map(str, cad))}" + (f", back in the pool at {pool}" if pool else
                                                         ", never back in the pool without your word"))


def cmd_pipeline_strong(state):
    rows = [l for l in state.values() if lead_strength(l) == "strong" and l.get("stage") not in ("won", "lost", "churned")]
    if not rows:
        print("No strong leads in the pipeline. `leads candidates` puts the strong ones first.")
        return
    print(f"strong: {len(rows)}")
    for l in sorted(rows, key=lambda l: l.get("next") or "9"):
        print(f"  {l['name']}{' (' + l['city'] + ')' if l.get('city') else ''} · {l.get('stage') or 'noted'}"
              + (f" · next {l['next']}" if l.get("next") else "") + f" · {strength_tag(None, lead=l)}")



