BUSINESS_FIX_HINTS = [
    ("no website", "A one-page site with what you do, the area you cover and a way to ask for a quote fixes the first one; Google links it the day it's up."),
    ("page, not a site", "A site of your own beats a social page on Google, and you keep the page too."),
    ("profile, not a site", "A site of your own means the customer who finds you on Google lands on your page, not a directory's."),
    ("business.site", "Google retired business.site pages in 2024; pointing the website link somewhere live takes two minutes in the Business Profile."),
    ("doesn't load", "Worth checking the domain renewed: a dead link on Google loses the calls that click it."),
    ("free ", "A free builder address works, but your own domain reads as a real business on Google and in a text."),
