                          re.I)


# ---- plumbing -------------------------------------------------------------------

def die(msg, code=1):
    print(f"outreach: {msg}", file=sys.stderr)
    sys.exit(code)


def say(msg=""):
    print(msg, flush=True)


def read_env():
    """The toolbelt env file. Values stay in memory; nothing here ever prints one."""
    keys = {}
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                keys[k.strip()] = v.strip().strip('"').strip("'")
    return keys


def toolbelt(name, default=None):
    v = os.environ.get(name)
    if v is None or v == "":
        v = read_env().get(name)
    return default if v is None or v == "" else v


def env_num(name, default, cast=float):
    raw = toolbelt(name)
    if raw is None:
        return default
    try:
        return cast(str(raw).strip())
    except ValueError:
        die(f"{name} should be a number, not {raw!r}")


def now():
    """Taylor's clock. OUTREACH_NOW moves it (tests: a day of ticks in a few seconds)."""
    fake = os.environ.get("OUTREACH_NOW")
    if fake:
        t = dt.datetime.fromisoformat(fake)
        return t.replace(tzinfo=TZ) if t.tzinfo is None else t.astimezone(TZ)
    return dt.datetime.now(TZ)


def today():
    return now().date()


def now_iso():
    return now().isoformat(timespec="seconds")


def state_dir(*parts):
    p = STATE.joinpath(*parts) if parts else STATE
    (p if not parts else p.parent).mkdir(parents=True, exist_ok=True)
    return p


def read_jsonl(path):
    if not Path(path).exists():
        return []
    out = []
    for line in Path(path).read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return out


def append_jsonl(path, row):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a") as f:
        f.write(json.dumps(row) + "\n")


def ledger_append(event):
    """One line per billable (or countable) thing, `img`'s convention. Never fatal:
    a ledger problem must not undo a send that already happened."""
    if DRY:
        return
    try:
        LEDGER.parent.mkdir(parents=True, exist_ok=True)
        with open(LEDGER, "a") as f:
            f.write(json.dumps(event) + "\n")
    except OSError as exc:
        print(f"outreach: ledger write failed ({exc})", file=sys.stderr)


def ledger_ai_spend_today():
    """What the classifier has already spent today, from the ledger alone. Ledger rows are
    stamped UTC (the house convention) and a day here is Taylor's, so compare the instants —
    a naive string prefix would reset the cap at 6pm."""
    start = dt.datetime.combine(today(), dt.time(0, 0), TZ)
    end = start + dt.timedelta(days=1)
    total = 0.0
    for row in read_jsonl(LEDGER):
        if row.get("tool") != "outreach" or row.get("kind") != "claude":
            continue
        try:
            when = dt.datetime.fromisoformat(str(row.get("ts", "")).replace("Z", "+00:00"))
        except ValueError:
            continue
        if when.tzinfo is None:
            when = when.replace(tzinfo=dt.timezone.utc)
        if start <= when < end:
            total += float(row.get("cost_usd") or 0)
    return round(total, 6)


def http(method, url, headers=None, body=None, timeout=25):
    """One request. Returns (status, parsed-or-text). Raises Unreachable on a network fault."""
    data = None
    headers = dict(headers or {})
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    headers.setdefault("Accept", "application/json")
    headers.setdefault("User-Agent", "claude-tools/outreach")
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode(errors="replace")
            return resp.status, (json.loads(raw) if raw.strip().startswith(("{", "[")) else raw)
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode(errors="replace")
        return exc.code, (json.loads(raw) if raw.strip().startswith(("{", "[")) else raw)
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        raise Unreachable(f"{urllib.parse.urlsplit(url).netloc}: {exc}") from exc


class Unreachable(Exception):
    pass


# ---- the letters ----------------------------------------------------------------

class Template:
    """One file in templates/outreach: a subject table, then the letter. `#` lines are
    comments and never sent. A line whose placeholder is empty is dropped whole."""

    def __init__(self, name, raw):
        self.name, self.raw = name, raw
        head, _, body = raw.partition("\n---\n")
        if not body:
            raise ValueError(f"{name}.md has no `---` line between the subjects and the letter")
        self.subjects = []
        for line in head.splitlines():
            line = line.strip()
            if line.startswith("#") or not line:
                continue
            m = re.match(r"^Subject\s+([a-z0-9_-]+)\s*:\s*(.+)$", line, re.I)
            if m:
                self.subjects.append((m.group(1).lower(), m.group(2).strip()))
        if not self.subjects or self.subjects[-1][0] != "default":
            raise ValueError(f"{name}.md needs subject lines ending with `Subject default:`")
        self.body = "\n".join(l for l in body.splitlines() if not l.startswith("#")).strip("\n")

    @property
    def sha(self):
        return letter_sha(self.raw)      # the text plus the price sentences it carries (lib/prices.py)

    def subject_for(self, fault):
        f = (fault or "").lower()
        for key, text in self.subjects:
            if key == "default":
                continue
            if any(w in f for w in SUBJECT_WORDS.get(key, (key,))):
                return text
        return self.subjects[-1][1]

    def render(self, values, fault=""):
        subject = fill(self.subject_for(fault), values)
        lines = []
        for line in self.body.splitlines():
            # `[?key] text` stays only when key has a value, `[!key] text` only when it hasn't:
            # the second touch carries a link when OUTREACH_LINK_BASE exists, a reply ask when not.
            cond = re.match(r"^\[([?!])([a-z_]+)\]\s?", line)
            if cond:
                has = bool(str(values.get(cond.group(2)) or "").strip())
                if has != (cond.group(1) == "?"):
                    continue
                line = line[cond.end():]
            holes = re.findall(r"\{([a-z_]+)\}", line)
            if holes and line.strip() and all(not str(values.get(h) or "").strip() for h in holes):
                continue                      # a line that is only an empty placeholder
            if any(h in values and not str(values.get(h) or "").strip() for h in holes) and len(holes) == 1:
                continue                      # "Phone: {phone}" with no phone
            filled = fill(line, values)
            if holes:                         # an empty mid-line placeholder ({paying}) leaves no double space
                filled = re.sub(r"(?<=\S) {2,}(?=\S)", " ", filled).rstrip()
            lines.append(filled)
        out = "\n".join(lines)
        out = re.sub(r"\n{3,}", "\n\n", out).strip() + "\n"
        return subject, out


SUBJECT_WORDS = {
    "dead": ("doesn't load", "does not load", "business.site", "dead", "404", "broken"),
    "website": ("no website", "no site of", "hasn't got a website", "no web site"),
    "marketplace": ("doordash", "ubereats", "uber eats", "grubhub", "marketplace", "facebook page you don't control",
                    "facebook page you do not control"),
    "hours": ("no hours", "hours are missing", "no opening hours"),
    "booking": ("no way to book", "no booking", "can't book", "cannot book"),
    "photos": ("photo",),
    "closed": ("says closed", "says you're closed", "says you are closed"),
}


def fill(text, values):
    out = text
    for k, v in values.items():
        out = out.replace("{" + k + "}", "" if v is None else str(v))
    return out


def load_template(name):
    p = TEMPLATES / f"{name}.md"
    if not p.exists():
        die(f"no template {p}")
    try:
        return Template(name, p.read_text())
    except ValueError as exc:
        die(str(exc))


def approved():
    """name -> sha from templates/outreach/APPROVED (Taylor's word on the exact text)."""
    p = TEMPLATES / "APPROVED"
    if not p.exists():
        return {}
    out = {}
    for line in p.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) >= 2:
            out[parts[0]] = parts[1]
    return out


def approval_problems(names):
    ok = approved()
    bad = []
    for n in names:
        t = load_template(n)
        if n not in ok:
            bad.append(f"{n}: not in APPROVED")
        elif ok[n] != t.sha:
            bad.append(f"{n}: the text changed since Taylor approved it")
    return bad


def sample_values(expiry=None):
    return {
        "first": "Dave", "business": "Highland Pool & Spa",
        # a fault as `leads` writes it, through the same to_you() a real letter uses (B62)
        "fault": to_you("the website link is a business.site page, and Google shut those down in 2024: it's a dead link"),
        "preview_url": "https://preview-highland-pool.pages.dev/",
        "price_line": PRICE_LINE, "prices_line": PRICES_LINE,
        # B71: the longest {paying} a letter can carry, so the sentence-count rule is checked at its worst
        "paying": "Your site's address is set up with Hibu, whose plans are reported to start at $449 a month.",
        "phone": toolbelt(V.sender.phone_env) or V.sender.sample_phone,
        "booking": toolbelt("LEADS_BOOKING_URL") or "https://cal.com/taylor/15min",
        "address": toolbelt(V.sender.postal_address_env) or V.sender.sample_address,
        "demo": toolbelt(V.sender.demo_number_env, DEMO_NUMBER_DEFAULT),
        "expiry": expiry or (today() + dt.timedelta(days=int(env_num("OUTREACH_PREVIEW_DAYS",
                                                                    DEFAULT_PREVIEW_DAYS, int)))).strftime("%-d %B"),
        # the batch letters (B90): two fault sentences exactly as `leads batch` gives them
        "fault_one": "your Google listing has no hours for Saturday",
        "fault_two": "your website has no layout for a phone, so it shows the desktop page shrunk",
        "fact": "",          # the fault-then-fact shape is checked too: see check_batch_template
        "see_url": "",
        "thread_subject": "two things I noticed about Highland Pool & Spa",
    }


def sample_link_base():
    """The second touch is checked both ways: with a link on the sending domain and without."""
    return V.outreach.link_example


def sentences(text):
    return [s for s in re.split(r"(?<=[.!?])\s+", text.strip()) if s.strip()]


def letter_body(body):
    """The letter itself: the paragraphs after the greeting and before the signature block (the one
    that starts with the sender's name), joined. Several short paragraphs count as one letter."""
    paras = [p.strip() for p in body.split("\n\n") if p.strip()]
    start = 1 if paras and paras[0].lower().startswith("hi ") else 0
    end = next((i for i, p in enumerate(paras) if p.startswith(V.sender.from_name)), len(paras))
    return "\n\n".join(paras[start:end]) if end > start else body


def links(text):
    return URL_RE.findall(text) + [h for h in BARE_HOST_RE.findall(text) if not URL_RE.search(h)]


def ai_placement_problems(body, variant, where=""):
    """Where the AI sentence sits in one rendered batch letter (B132, plan 53 § Changes 3): `intro` once,
    in the introduction's paragraph; `foot` once, as the body's last line before the signature; `none`
    not at all. Returns [problem, ...]."""
    n = body.count(DISCLOSURE_BATCH)
    letter = letter_body(body)
    paras = [p for p in letter.split("\n\n") if p.strip()]
    if variant == "none":
        return [f"the AI sentence is still in a `none` letter{where}"] if n or "patch, my ai" in body.lower() else []
    if n != 1:
        return [f"the disclosure isn't there exactly once: \"{DISCLOSURE_BATCH}\" ({n} times){where}"]
    if variant == "intro" and not (paras and DISCLOSURE_BATCH in paras[0].splitlines()):
        return [f"the disclosure isn't beside the introduction{where}"]
    if variant == "foot" and not (paras and paras[-1].splitlines()[-1].strip() == DISCLOSURE_BATCH):
        return [f"the disclosure isn't the body's last line, before the signature{where}"]
    return []


def check_batch_template(name, none_ok=None):
    """The batch letters' rules (plan 37 § 3), checked on a rendered sample, both with and
    without a link base for the follow-ups, and (B132) once for each placement of the AI
    sentence: none, intro, foot. `none` passes only while the AI-line test is open (or after
    Taylor's stop kept it: honoured, with AI_NONE_KEPT said wherever the checker reports, since
    that changes the brand rule and the rule is his); `none_ok=True` checks its shape alone, for a
    caller that isn't dealing a new one (approve, doctor, the tick finishing threads the test began).
    Returns [problem, ...]."""
    t = load_template(name)
    none_ok = ai_none_allowed() if none_ok is None else none_ok
    bad = []
    variants = [("no link base", sample_values())]
    if name == "batch-first":
        v = sample_values()
        v["fault_two"], v["fact"] = "", "more than 60 Google reviews, averaging 4.8"
        variants = [("two faults", sample_values()), ("a fault and a fact", v)]
    else:
        v = sample_values()
        v["see_url"] = sample_link_base()
        variants.append(("with a link base", v))
    variants = [(f"{label}, {ai}", {**vals, **ai_values(ai)}) for label, vals in variants for ai in AI_VARIANTS]
    if not none_ok:
        bad.append(f"`none`: {AI_NONE_REFUSAL}")
    for label, vals in variants:
        subject, body = t.render(vals)
        low = body.lower()
        where = f" ({label})"
        ai = next(v for v, k in AI_KEYS.items() if vals.get(k))
        bad += ai_placement_problems(body, ai, where)
        if "no thanks" not in low:
            bad.append(f"no opt-out line{where}")
        if "advertisement" not in low:
            bad.append(f"no ad identification (CAN-SPAM){where}")
        if vals["address"] not in body:
            bad.append(f"no postal address{where}")
        if not subject.strip():
            bad.append("empty subject")
        if BUILT_RE.search(body):
            bad.append(f"it says a site was built, and a batch pick has none yet{where}")
        found = links(body)
        if name == "batch-first":
            if found:
                bad.append(f"the first letter carries a link ({found}); it asks for a reply only")
            for f in ("fault_one", "fault_two", "fact"):
                if vals[f] and vals[f] not in body:
                    bad.append(f"{{{f}}} isn't in the letter verbatim{where}")
            if vals["fact"] and "two things" in body:
                bad.append(f"the letter calls a fact a thing to fix{where}")
            if fill(OFFER_SENTENCE, vals) not in body:
                bad.append("the offer sentence isn't there exactly: " + OFFER_SENTENCE)
            if "just reply" not in low:
                bad.append("the first letter doesn't ask for a reply (\"Just reply.\")")
            if PRICE_LINE not in body:
                bad.append("no price sentence ({price_line})")
            if V.sender.town.lower() not in low or V.sender.from_name.lower() not in low:
                bad.append(f"it doesn't say who {V.sender.first_name} is and where")
        else:
            if len(found) > 1:
                bad.append(f"{len(found)} links{where}; one at most")
            if vals["see_url"]:
                if len(found) != 1 or vals["see_url"] not in found[0]:
                    bad.append(f"the one link isn't the sending domain's link{where}")
            elif found:
                bad.append(f"a link with no link base{where}: {found}")
            elif "reply" not in low:
                bad.append(f"without a link it has to ask for a reply{where}")
    if re.search(r"\$\s?\d", t.raw.replace("{price_line}", "").replace("{prices_line}", "")):
        bad.append("a cold letter names money that isn't {price_line}")
    return sorted(set(bad), key=bad.index)


def check_template(name, none_ok=None):
    """The rules a letter has to keep, run against a rendered sample. Returns [problem, ...]."""
    if name in BATCH_LETTERS:
        return check_batch_template(name, none_ok=none_ok)
    t = load_template(name)
    subject, body = t.render(sample_values(), fault=sample_values()["fault"])
    bad = []
    low = body.lower()
    if name == "answer-yes":
        # B132: a `none` thread hears it here, in Codex's variant-B words, and every other thread keeps
        # the usual line; both renderings say it once.
        _, nbody = t.render({**sample_values(), "ai_none": "1"})
        if nbody.count(AI_NONE_ANSWER) != 1:
            bad.append(f"the answer to a yes in a `none` thread doesn't say \"{AI_NONE_ANSWER}\" once")
        if AI_NONE_ANSWER in body:
            bad.append("the answer to a yes outside a `none` thread carries the `none` sentence")
    if name == "answer-yes" and sample_values()["preview_url"] not in body:
        bad.append("the answer to a yes doesn't carry the preview's address")
    if "no thanks" not in low:
        bad.append("no opt-out line (\"reply 'no thanks'…\")")
    if "advertisement" not in low and "this is an ad" not in low:
        bad.append("no ad identification (CAN-SPAM)")
    if "patch, my ai operator" not in low and "patch, my ai" not in low:
        bad.append("no AI disclosure line")
    addr = sample_values()["address"]
    if addr not in body:
        bad.append("no postal address")
    if not subject.strip():
        bad.append("empty subject")
    if name in LETTERS:
        letter = letter_body(body)
        n = len(letter.split())
        # The letter is measured in words, not sentences, since 2026-10-05 (B130: one thought per
        # sentence makes more, shorter sentences; the rule was always about length). The day-0 note
        # is at most 130 words, the reference letter's length (GROWTH § 5.3 said four to six
        # sentences); the two follow-ups are meant to be short (§ 5.5), at most 90.
        lo, hi = (40, 130) if name == "first" else (15, 90)
        if not lo <= n <= hi:
            bad.append(f"the letter is {n} words, not {lo} to {hi}")
        found = links(letter)
        if len(found) != 1:
            bad.append(f"the letter has {len(found)} links, not one (the preview): {found}")
        elif sample_values()["preview_url"] not in found[0]:
            bad.append(f"the letter's one link isn't the preview: {found[0]}")
        if re.search(r"\$\s?\d", t.raw.replace("{price_line}", "").replace("{prices_line}", "")):
            bad.append("a cold letter names money that isn't {price_line}")
    return bad


def money_in(name):
    t = load_template(name)
    return re.findall(r"\$\s?[\d,]+(?:\.\d\d)?(?:[a-z ]{0,24})", t.raw.replace("{price_line}", "")
                      .replace("{prices_line}", ""), re.I)


# ---- suppression ----------------------------------------------------------------

def suppress_file():
    return state_dir("suppress.jsonl")


def suppressed():
    vals = set()
    for row in read_jsonl(suppress_file()):
        v = str(row.get("value") or "").strip().lower()
        if v:
            vals.add(v)
    return vals


def suppress_kind(value):
    """An address has an @, a domain has a dot (a census place id never does)."""
    v = str(value).strip()
    if "@" in v:
        return "email"
    if "." in v:
        return "domain"
    return "place"


def is_suppressed(email=None, place_id=None, supp=None):
    """The address, its domain, or the place. A domain is only ever suppressed by hand."""
    supp = suppressed() if supp is None else supp
    e = str(email or "").strip().lower()
    if e and (e in supp or mail.domain_of(e) in supp):
        return True
    return bool(place_id) and str(place_id).strip().lower() in supp


def suppress_add(value, reason, provider=None):
    """On the list before anything else, and told to the provider too. Idempotent."""
    value = str(value).strip()
    if not value:
        return False
    if value.lower() in suppressed():
        return False
    kind = suppress_kind(value)
    if not DRY:
        append_jsonl(suppress_file(), {"ts": now_iso(), "value": value, "kind": kind, "reason": reason})
    if kind == "email" and provider is not None:
        try:
            provider.suppress(value)
        except (Unreachable, ProviderError) as exc:
            print(f"outreach: the provider's block list didn't take {value} ({exc}); "
                  "it is on ours, so nothing goes out to it", file=sys.stderr)
    return True


# ---- the provider ---------------------------------------------------------------

class ProviderError(Exception):
    pass


CURSOR_IDS = 500


def advance(cursor, replies):
    """The cursor is a high-water timestamp plus the ids already handled, because two
    replies can land in the same second and a timestamp alone would swallow one."""
    new = dict(cursor)
    if not replies:
        return new
    seen = list(dict.fromkeys([r["id"] for r in replies] + list(cursor.get("ids") or [])))
    new["ids"] = seen[:CURSOR_IDS]
    stamps = [r["ts"] for r in replies if r.get("ts")]
    if stamps:
        new["ts"] = max([*stamps, cursor.get("ts") or ""])
    return new


class Provider:
    name = "?"

    def ensure_campaign(self):
        raise NotImplementedError

    def send(self, pick, subject, body):
        raise NotImplementedError

    def replies(self, cursor):
        """-> ([reply, ...], new_cursor). A reply is {id, thread_id, from, subject, text,
        ts, auto_reply, campaign_id}."""
        raise NotImplementedError

    def reply_to(self, reply, subject, body):
        raise NotImplementedError

    def suppress(self, value):
        raise NotImplementedError

    def analytics(self):
        """-> {sent, bounced, replies, unsubscribed, complaints}; complaints None when
        the provider has no count of its own."""
        raise NotImplementedError

    def warmup(self):
        raise NotImplementedError

    def ping(self):
        raise NotImplementedError


class Fake(Provider):
    """Files under the state dir. What the tests and --dry-run use; it is also the only
    provider that exists until Taylor's mailbox does."""

    name = "fake"

    def __init__(self, eaccount="outreach@example.invalid", root=None):
        self.eaccount = eaccount
        self.root = Path(root) if root else state_dir("fake")
        self.root.mkdir(parents=True, exist_ok=True)

    def _p(self, n):
        return self.root / n

    def ensure_campaign(self):
        p = self._p("campaign.json")
        if not p.exists() and not DRY:
            p.write_text(json.dumps({"id": "fake-campaign", "name": toolbelt("OUTREACH_CAMPAIGN", CAMPAIGN_DEFAULT),
                                     "created": now_iso()}))
        return "fake-campaign"

    def send(self, pick, subject, body, mailbox=None, thread=None):
        mb = mailbox or self.eaccount
        mid = mail.make_message_id(mail.domain_of(mb) or "example.invalid")
        row = {"ts": now_iso(), "id": f"fake-{int(time.time()*1000)}-{abs(hash(pick.get('email'))) % 9999}",
               "to": pick.get("email"), "from": mb, "subject": subject, "text": body,
               "campaign_id": self.ensure_campaign(), "message_id": mid,
               "in_reply_to": (thread or {}).get("in_reply_to")}
        if not DRY:
            append_jsonl(self._p("outbox.jsonl"), row)
        return {"id": row["id"], "how": "campaign", "message_id": mid, "mailbox": mb}

    def replies(self, cursor):
        rows = read_jsonl(self._p("inbox.jsonl"))
        seen = set(cursor.get("ids") or [])
        out = []
        for r in rows:
            rid = str(r.get("id") or "")
            if rid in seen:                # the id, not the clock: two replies can share a second
                continue
            ts = str(r.get("ts") or r.get("timestamp_created") or "")
            out.append({"id": rid, "thread_id": r.get("thread_id") or rid, "from": r.get("from") or r.get("lead"),
                        "subject": r.get("subject") or "", "text": r.get("text") or r.get("body") or "",
                        "ts": ts, "auto_reply": bool(r.get("auto_reply")), "campaign_id": r.get("campaign_id")})
        out.sort(key=lambda r: r["ts"])
        return out, advance(cursor, out)

    def reply_to(self, reply, subject, body):
        row = {"ts": now_iso(), "id": f"fake-reply-{int(time.time()*1000)}", "to": reply.get("from"),
               "from": self.eaccount, "subject": subject, "text": body, "in_reply_to": reply.get("id")}
        if not DRY:
            append_jsonl(self._p("sent-replies.jsonl"), row)
        return {"id": row["id"]}

    def suppress(self, value):
        if not DRY:
            append_jsonl(self._p("blocklist.jsonl"), {"ts": now_iso(), "value": value})
        return {"ok": True}

    def analytics(self):
        p = self._p("analytics.json")
        if p.exists():
            a = json.loads(p.read_text())
        else:
            a = {}
        sent = a.get("sent", len(read_jsonl(self._p("outbox.jsonl"))))
        return {"sent": sent, "bounced": a.get("bounced", 0), "replies": a.get("replies", 0),
                "unsubscribed": a.get("unsubscribed", 0), "complaints": a.get("complaints", 0)}

    def warmup(self):
        p = self._p("warmup.json")
        if p.exists():
            return json.loads(p.read_text())
        return {self.eaccount: {"sent": 0, "landed_inbox": 0, "landed_spam": 0, "state": "fake — no real mailbox"}}

    def ping(self):
        return True, f"fake provider, files under {self.root}"


class Instantly(Provider):
    """Instantly API v2. Endpoints and the reason a send is campaign-plus-lead are in
    ~/projects/plans/20-email-lane.md § Contract."""

    name = "instantly"

    def __init__(self, key, eaccount, base=None, per_day=None):
        self.key = key
        self.eaccount = eaccount
        self.base = (base or "https://api.instantly.ai").rstrip("/")
        self.per_day = per_day
        self.memo = state_dir("instantly.json")

    def _req(self, method, path, body=None, query=None):
        url = f"{self.base}{path}"
        if query:
            url += "?" + urllib.parse.urlencode({k: v for k, v in query.items() if v not in (None, "")})
        if DRY and method != "GET":
            say(f"  [dry-run] {method} {path} {json.dumps(body)[:200] if body else ''}")
            return {"id": "dry-run", "dry_run": True}
        status, data = http(method, url, headers={"Authorization": f"Bearer {self.key}"}, body=body)
        if status == 401:
            raise ProviderError("Instantly refused the key (401) — INSTANTLY_API_KEY is wrong or revoked")
        if status == 402:
            raise ProviderError("Instantly says the workspace has no active paid plan (402)")
        if status == 429:
            raise ProviderError("Instantly rate-limited us (429); the emails endpoint allows 20 a minute")
        if status >= 400:
            msg = data.get("message") if isinstance(data, dict) else str(data)[:200]
            raise ProviderError(f"Instantly {method} {path} -> {status}: {msg}")
        return data

    def _remembered(self):
        try:
            return json.loads(self.memo.read_text()) if self.memo.exists() else {}
        except (OSError, json.JSONDecodeError):
            return {}

    def _remember(self, **kw):
        if DRY:
            return
        d = self._remembered()
        d.update(kw)
        try:
            self.memo.write_text(json.dumps(d))
        except OSError:
            pass

    def ensure_campaign(self):
        name = toolbelt("OUTREACH_CAMPAIGN", CAMPAIGN_DEFAULT)
        got = self._remembered().get("campaign_id")
        if got:
            return got
        listed = self._req("GET", "/api/v2/campaigns", query={"limit": 100})
        for item in (listed or {}).get("items", []) if isinstance(listed, dict) else []:
            if item.get("name") == name:
                self._remember(campaign_id=item.get("id"))
                return item.get("id")
        made = self._req("POST", "/api/v2/campaigns", body={
            "name": name,
            "campaign_schedule": {"schedules": [{
                "name": "Weekday mornings", "timing": {"from": "08:00", "to": "16:00"},
                "days": {"1": True, "2": True, "3": True, "4": True, "5": True, "0": False, "6": False},
                "timezone": TZ_INSTANTLY}]},
            # One step; the letter itself is a per-lead custom variable, so every sentence
            # is composed in this tool where the template checks run.
            "sequences": [{"steps": [{"type": "email", "delay": 0, "variants": [
                {"subject": "{{subject_line}}", "body": "{{body_html}}"}]}]}],
            "email_list": [self.eaccount],
            "daily_limit": int(self.per_day) if self.per_day else None,
            "stop_on_reply": True, "link_tracking": False, "open_tracking": False,
            "text_only": True, "first_email_text_only": True,
        })
        cid = made.get("id") if isinstance(made, dict) else None
        if cid and cid != "dry-run":
            self._req("POST", f"/api/v2/campaigns/{cid}/activate")
            self._remember(campaign_id=cid)
        return cid

    def send(self, pick, subject, body, mailbox=None, thread=None):
        cid = self.ensure_campaign()
        lead = self._req("POST", "/api/v2/leads", body={
            "campaign": cid, "email": pick.get("email"),
            "first_name": pick.get("first") or None, "company_name": pick.get("name") or None,
            "phone": pick.get("phone") or None, "website": pick.get("preview_url") or None,
            "skip_if_in_workspace": True, "skip_if_in_campaign": True,
            "custom_variables": {"subject_line": subject, "body_html": html_lines(body),
                                 "body_text": body, "place_id": pick.get("place_id") or ""},
        })
        return {"id": (lead or {}).get("id"), "how": "campaign", "campaign_id": cid}

    def replies(self, cursor):
        """GET /api/v2/emails has no `since` filter: newest first, and stop paging once a
        page is older than the cursor. What is new is decided by the id, not the clock."""
        cid = self._remembered().get("campaign_id")
        seen, last = set(cursor.get("ids") or []), cursor.get("ts") or ""
        out, after, pages = [], None, 0
        while pages < 5:
            pages += 1
            page = self._req("GET", "/api/v2/emails",
                             query={"limit": 100, "sort_order": "desc", "campaign_id": cid, "starting_after": after})
            items = (page or {}).get("items") or []
            stop = False
            for it in items:
                rid, ts = str(it.get("id") or ""), str(it.get("timestamp_created") or "")
                if last and ts and ts < last:
                    stop = True               # older than anything we have read; nothing beyond it is new
                    continue
                if rid in seen:
                    continue
                if it.get("ue_type") != 2:            # 2 = Received; 1/3 are ours, 4 scheduled
                    continue
                out.append({"id": rid, "thread_id": it.get("thread_id") or rid,
                            "from": it.get("lead") or it.get("from_address_email"),
                            "subject": it.get("subject") or "",
                            "text": ((it.get("body") or {}).get("text")
                                     or strip_html((it.get("body") or {}).get("html") or "")),
                            "ts": ts, "auto_reply": bool(it.get("is_auto_reply")),
                            "campaign_id": it.get("campaign_id")})
            after = (page or {}).get("next_starting_after")
            if stop or not after or not items:
                break
        out.sort(key=lambda r: r["ts"])
        return out, advance(cursor, out)

    def reply_to(self, reply, subject, body):
        return self._req("POST", "/api/v2/emails/reply", body={
            "eaccount": self.eaccount, "reply_to_uuid": reply.get("id"), "subject": subject,
            "body": {"text": body, "html": html_lines(body)},
        })

    def suppress(self, value):
        return self._req("POST", "/api/v2/block-lists-entries", body={"bl_value": value})

    def analytics(self):
        cid = self._remembered().get("campaign_id")
        a = self._req("GET", "/api/v2/campaigns/analytics/overview", query={"id": cid}) or {}
        if isinstance(a, list):
            a = a[0] if a else {}
        return {"sent": int(a.get("emails_sent_count") or 0), "bounced": int(a.get("bounced_count") or 0),
                "replies": int(a.get("reply_count_unique") or 0),
                "unsubscribed": int(a.get("unsubscribed_count") or 0),
                # Instantly publishes no complaint count; Postmaster Tools is the source.
                "complaints": None}

    def warmup(self):
        got = self._req("POST", "/api/v2/accounts/warmup-analytics", body={"emails": [self.eaccount]}) or {}
        return got.get("aggregate_data") or got

    def ping(self):
        got = self._req("GET", "/api/v2/accounts", query={"limit": 1})
        n = len((got or {}).get("items") or []) if isinstance(got, dict) else 0
        return True, f"reachable; {n} mailbox(es) visible"


# ---- the mailboxes, their caps and the ramp (B90) -------------------------------

def mailboxes():
    """The sending addresses: OUTREACH_MAILBOXES, else the one OUTREACH_FROM."""
    raw = toolbelt("OUTREACH_MAILBOXES") or ""
    boxes = [b.strip().lower() for b in re.split(r"[,\s]+", raw) if b.strip()]
    if not boxes and toolbelt("OUTREACH_FROM"):
        boxes = [toolbelt("OUTREACH_FROM").strip().lower()]
    return list(dict.fromkeys(boxes))


def password_name(addr):
    """OUTREACH_APP_PASSWORD_ + the whole address, so two domains' `taylor@` never collide."""
    return "OUTREACH_APP_PASSWORD_" + re.sub(r"[^A-Z0-9]", "_", addr.upper())


def warmup_start():
    """(date or None, where it came from). The env wins over the state file."""
    raw = toolbelt("OUTREACH_WARMUP_START")
    src = "OUTREACH_WARMUP_START"
    if not raw:
        p = STATE / "warmup-start.json"
        try:
            raw = json.loads(p.read_text()).get("start") if p.exists() else None
        except (OSError, json.JSONDecodeError):
            raw = None
        src = "state (outreach warmup start)"
    if not raw:
        return None, "unset"
    try:
        return dt.date.fromisoformat(str(raw).strip()), src
    except ValueError:
        die(f"the warm-up start should be YYYY-MM-DD, not {raw!r}")


def ramp_day(day=None):
    start, _ = warmup_start()
    if start is None:
        return None
    return ((day or today()) - start).days


def parse_cap(raw):
    """"25" -> ("flat", 25); "14:5,21:20,28:28" -> ("ramp", [(14, 5), (21, 20), (28, 28)])."""
    raw = str(raw if raw is not None else "0").strip()
    if re.fullmatch(r"\d+", raw):
        return "flat", int(raw)
    steps = []
    for part in re.split(r"[,\s]+", raw):
        m = re.fullmatch(r"(\d+):(\d+)", part.strip())
        if not m:
            die(f"OUTREACH_MAILBOX_PER_DAY is a number or day:cap pairs like 14:5,21:20,28:28, not {raw!r}")
        steps.append((int(m.group(1)), int(m.group(2))))
    return "ramp", sorted(steps)


def cap_on(day=None):
    """One mailbox's cap on a day. A ramp with no recorded warm-up start is 0: the ramp
    counts from that day, and sending before anyone recorded it would be a guess."""
    kind, v = parse_cap(toolbelt("OUTREACH_MAILBOX_PER_DAY", "0"))
    if kind == "flat":
        return v
    rd = ramp_day(day)
    if rd is None:
        return 0
    cap = 0
    for d, c in v:
        if rd >= d:
            cap = c
    return cap


def sends_on(mailbox, day=None):
    stamp = (day or today()).isoformat()
    return sum(1 for r in cold_sends()
               if r.get("date") == stamp and str(r.get("mailbox") or "").lower() == mailbox)


def send_window(day=None):
    raw = toolbelt("OUTREACH_SEND_HOURS", DEFAULT_SEND_HOURS)
    m = re.fullmatch(r"\s*(\d{1,2})(?::(\d\d))?\s*-\s*(\d{1,2})(?::(\d\d))?\s*", str(raw))
    if not m:
        die(f"OUTREACH_SEND_HOURS is like 8-17 or 8:30-16:45, not {raw!r}")
    d = day or today()
    start = dt.datetime.combine(d, dt.time(int(m.group(1)), int(m.group(2) or 0)), TZ)
    end = dt.datetime.combine(d, dt.time(int(m.group(3)), int(m.group(4) or 0)), TZ)
    return start, end


def working_now(t=None):
    t = t or now()
    start, end = send_window(t.date())
    return t.weekday() < 5 and start <= t < end


def link_base():
    """OUTREACH_LINK_BASE, only when its host is on a sending domain: the product's own site sends the
    sign-in links and the clients' mail, and a link from the cold lane would tie its
    standing to the cold lane's (plan 37 § 3). Anything else is treated as unset."""
    raw = (toolbelt("OUTREACH_LINK_BASE") or "").strip().rstrip("/")
    if not raw:
        return ""
    host = (urllib.parse.urlsplit(raw).hostname or "").lower()
    domains = {mail.domain_of(b) for b in mailboxes()} - {""}
    if not host or raw.split(":", 1)[0] != "https" or V.site_host == host or host.endswith("." + V.site_host):
        return ""
    if not any(host == d or host.endswith("." + d) for d in domains):
        return ""
    return raw


# ---- the google provider (B90) ---------------------------------------------------

class Google(Provider):
    """Each mailbox's own Google mail server: SMTP to send, IMAP to read (lib/outreach_mail.py).
    Instantly's Growth plan warms these mailboxes but has no API, so this is the sender."""

    name = "google"

    def __init__(self, boxes, smtp=None, imap=None, from_name=None):
        self.boxes = boxes
        self.smtp = smtp or toolbelt("OUTREACH_SMTP_HOST", "smtp.gmail.com:465")
        self.imap = imap or toolbelt("OUTREACH_IMAP_HOST", "imap.gmail.com:993")
        self.from_name = from_name or toolbelt("OUTREACH_FROM_NAME", V.sender.from_name)

    def _password(self, mb):
        pw = toolbelt(password_name(mb))
        if not pw:
            raise ProviderError(f"{password_name(mb)} isn't set, so {mb} can't send or read (see `outreach doctor`)")
        return pw

    def ensure_campaign(self):
        return None

    def pick_mailbox(self):
        """For the six-a-day kit lane: the mailbox with the most room under today's cap."""
        cap = cap_on()
        paused = paused_boxes()
        room = [(cap - sends_on(mb), mb) for mb in self.boxes if mb not in paused]
        room = [x for x in room if x[0] > 0]
        if not room:
            raise ProviderError("every mailbox is at its cap today (OUTREACH_MAILBOX_PER_DAY) or paused")
        return max(room)[1]

    def send(self, pick, subject, body, mailbox=None, thread=None):
        mb = (mailbox or self.pick_mailbox()).lower()
        pw = self._password(mb)
        mid = mail.make_message_id(mail.domain_of(mb))
        thread = thread or {}
        msg = mail.build_message(mb, self.from_name, pick.get("email"), subject, body, mid,
                                 in_reply_to=thread.get("in_reply_to"), references=thread.get("references"),
                                 unsubscribe_mailto=mb, when=now())
        if DRY:
            say(f"  [dry-run] SMTP {mb} -> {pick.get('email')}")
            return {"id": mid, "message_id": mid, "mailbox": mb, "how": "smtp"}
        try:
            mail.smtp_send(self.smtp, mb, pw, msg)
        except mail.MailError as exc:
            raise ProviderError(str(exc)) from None
        return {"id": mid, "message_id": mid, "mailbox": mb, "how": "smtp"}

    def replies(self, cursor):
        """New mail in every mailbox, kept only when it answers something we sent.

        Instantly's warm-up network writes into these inboxes all day. A message is ours
        only if its In-Reply-To/References name a Message-ID we sent, or failing that it
        comes from an address we wrote to; anything else is counted as ignored and never
        read further. A delivery-status report counts when it names a message or an
        address of ours."""
        sends = read_jsonl(sends_file())
        by_mid = {r["message_id"]: r for r in sends if r.get("message_id")}
        probes = read_jsonl(probes_file())
        probe_mids = {r["message_id"]: r for r in probes if r.get("message_id")}
        probe_addrs = {str(r.get("email") or "").lower(): r for r in probes if r.get("email")}
        by_addr = {}
        for r in sends:
            if r.get("email"):
                by_addr[str(r["email"]).lower()] = r
        ours = set(self.boxes)
        imap_state = dict(cursor.get("imap") or {})
        seen = set(cursor.get("ids") or [])
        out, ignored, problems = [], 0, []
        for mb in self.boxes:
            try:
                pw = self._password(mb)
            except ProviderError as exc:
                problems.append(str(exc))
                continue
            st = imap_state.get(mb) or {}
            first = min((r.get("date") for r in sends if str(r.get("mailbox") or "").lower() == mb and r.get("date")),
                        default=today().isoformat())
            try:
                uv, msgs = mail.imap_fetch_new(self.imap, mb, pw, last_uid=st.get("last_uid"),
                                               uidvalidity=st.get("uidvalidity"),
                                               since=dt.date.fromisoformat(first))
            except mail.MailError as exc:
                problems.append(str(exc))
                continue
            top = st.get("last_uid")
            for uid, raw in msgs:
                top = max(uid, top or 0)
                rid = f"{mb}:{uv}:{uid}"
                if rid in seen:
                    continue
                p = mail.parse_incoming(raw)
                frm = (p.get("from") or "").lower()
                if frm in ours:
                    ignored += 1
                    continue
                dsn = p.get("dsn")
                if dsn is not None:
                    row = by_mid.get(dsn.get("original_message_id") or "")
                    if not row:
                        row = next((by_addr[a] for a in dsn.get("recipients") or [] if a in by_addr), None)
                    if not row or not dsn.get("failed"):
                        ignored += 1           # a warm-up bounce, or only a delay notice
                        continue
                    to = (dsn.get("recipients") or [row.get("email")])[0]
                    out.append({"id": rid, "thread_id": row.get("thread_root") or row.get("message_id"),
                                "from": p.get("from"), "subject": p.get("subject") or "",
                                "text": f"Delivery to {to} failed ({dsn.get('status')}).",
                                "ts": p.get("date") or now_iso(), "auto_reply": True, "campaign_id": None,
                                "mailbox": mb, "message_id": p.get("message_id"), "references": [],
                                "our_message_id": row.get("message_id"), "bounce": True, "bounced_to": to,
                                "matched_by": "dsn"})
                    continue
                refs = list(p.get("in_reply_to") or []) + list(p.get("references") or [])
                row = next((by_mid[x] for x in refs if x in by_mid), None)
                how = "thread"
                if row is None:
                    row, how = by_addr.get(frm), "address"
                if row is None:
                    pr = next((probe_mids[x] for x in refs if x in probe_mids), None) or probe_addrs.get(frm)
                    if pr is not None:
                        row, how = pr, "probe"     # an answer to `outreach probe`: shown, never a lead
                if row is None:
                    ignored += 1               # warm-up traffic or anything else: never a reply
                    continue
                out.append({"id": rid, "thread_id": row.get("thread_root") or row.get("message_id"),
                            "from": p.get("from"), "subject": p.get("subject") or "", "text": p.get("text") or "",
                            "ts": p.get("date") or now_iso(), "auto_reply": bool(p.get("auto_reply")),
                            "campaign_id": None, "mailbox": mb, "message_id": p.get("message_id"),
                            "references": refs, "our_message_id": row.get("message_id"), "matched_by": how})
            imap_state[mb] = {"uidvalidity": uv, "last_uid": top}
        for msg in problems:
            print(f"outreach: {msg}", file=sys.stderr)
        out.sort(key=lambda r: r["ts"])
        new = advance(cursor, out)
        new["imap"] = imap_state
        new["ignored"] = int(cursor.get("ignored") or 0) + ignored
        self.last_ignored = ignored
        return out, new

    def reply_to(self, reply, subject, body):
        mb = (reply.get("mailbox") or self.boxes[0]).lower()
        theirs = reply.get("message_id")
        refs = [r for r in (reply.get("references") or []) if r] + ([theirs] if theirs else [])
        return self.send({"email": reply.get("from")}, subject, body, mailbox=mb,
                         thread={"in_reply_to": theirs, "references": list(dict.fromkeys(refs))})

    def suppress(self, value):
        return {"ok": True}            # our list is the list; Google has none to tell

    def analytics(self):
        # counted since Taylor's last `outreach resume --lane`, as the stop rules are: a resume
        # starts the counting afresh, or the old bounces would stop the lane again at once
        since = resumed_at()
        sends = [r for r in cold_sends() if r.get("provider") == "google" and str(r.get("ts") or "") >= since]
        bounced = [b for b in read_jsonl(bounces_file()) if str(b.get("ts") or "") >= since]
        return {"sent": len(sends), "bounced": len(bounced), "replies": 0, "unsubscribed": 0, "complaints": None}

    def warmup(self):
        cap = cap_on()
        return {mb: {"state": f"cap today {cap}, sent today {sends_on(mb)}"
                     + (" — PAUSED" if mb in paused_boxes() else "")} for mb in self.boxes}

    def ping(self):
        if not self.boxes:
            return False, "no mailboxes: set OUTREACH_MAILBOXES"
        good, lines = True, []
        for mb in self.boxes:
            try:
                pw = self._password(mb)
                mail.smtp_check(self.smtp, mb, pw)
                mail.imap_check(self.imap, mb, pw)
                lines.append(f"{mb} logs in to SMTP and IMAP")
            except (ProviderError, mail.MailError) as exc:
                good = False
                lines.append(f"{mb}: {exc}")
        return good, "; ".join(lines)


def html_lines(text):
    esc = text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    return esc.replace("\n", "<br/>\n")


def strip_html(html):
    t = re.sub(r"<br\s*/?>", "\n", html or "", flags=re.I)
    t = re.sub(r"<[^>]+>", "", t)
    return (t.replace("&amp;", "&").replace("&lt;", "<").replace("&gt;", ">").replace("&nbsp;", " ")).strip()


def provider_wanted(want=None):
    key = toolbelt("INSTANTLY_API_KEY")
    return (want or toolbelt("OUTREACH_PROVIDER") or ("instantly" if key else "fake")).lower()


def pick_provider(want=None):
    eaccount = toolbelt("OUTREACH_FROM") or "outreach@example.invalid"
    key = toolbelt("INSTANTLY_API_KEY")
    want = provider_wanted(want)
    if DRY or want == "fake":
        return Fake(eaccount)
    if want == "google":
        boxes = mailboxes()
        if not boxes:
            die("OUTREACH_MAILBOXES isn't set, so the google provider has nobody to send as (see `outreach doctor`)")
        return Google(boxes)
    if want != "instantly":
        die(f"provider is google, instantly or fake, not {want!r}")
    if not key:
        die("INSTANTLY_API_KEY isn't set (see `outreach doctor`); nothing sends without the mailbox")
    per_day = int(env_num("OUTREACH_PER_DAY", DEFAULT_PER_DAY, int))
    return Instantly(key, eaccount, base=toolbelt("INSTANTLY_API_BASE"), per_day=per_day)


# ---- the other tools ------------------------------------------------------------

def tool_path(name):
    """The sibling in this repo wins over PATH, so a `git pull` here updates it.
    OUTREACH_LEADS_BIN / OUTREACH_NOTIFY_BIN override it (tests only)."""
    override = toolbelt(f"OUTREACH_{name.upper()}_BIN")
    if override:
        return override
    local = TOOLS / "bin" / name
    if local.exists():
        return str(local)
    from shutil import which
    return which(name) or str(local)


def run_tool(args, why):
    """A toolbelt command. On --dry-run it is printed, not run."""
    if DRY:
        say("  [dry-run] " + " ".join(args))
        return True, ""
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(f"outreach: {why} failed ({exc})", file=sys.stderr)
        return False, str(exc)
    if r.returncode != 0:
        print(f"outreach: {why} failed: {(r.stderr or r.stdout).strip()[:300]}", file=sys.stderr)
    return r.returncode == 0, (r.stdout or "").strip()


def leads_log(name, outcome, note, place_id=None, email=None, via="email", next_when=None, tags=None):
    cmd = [tool_path("leads"), "log", name, outcome, note, "--via", via]
    for k, v in (tags or {}).items():          # B132: kept under `outbound` on the pipeline event
        cmd += ["--tag", f"{k}={str(v).lower() if isinstance(v, bool) else v}"]
    if via == "email":
        cmd += ["--channel", "email"]           # B116: this lane's touches went by email; `leads log` needs it on messaged
    if place_id:
        cmd += ["--place", place_id]
    if email:
        cmd += ["--email", email]
    if next_when:
        cmd += ["--next", next_when]
    return run_tool(cmd, f"leads log {name} {outcome}")[0]


def pressed_already(pid):
    """A press on the see link (B91) already logged this business as interested."""
    return bool(pid) and any(r.get("class") == "pressed" and r.get("place_id") == pid
                             for r in read_jsonl(replies_file()))


def log_interested(name, note, place_id=None, email=None, next_when=None):
    """One `interested` line a business: a press (B91) or a reply, whichever comes first, logs it."""
    if pressed_already(place_id):
        say("  already in the pipeline as interested (they pressed the link); no second line")
        return True
    return leads_log(name, "interested", note, place_id=place_id, email=email, next_when=next_when)


def leads_sent(indices, via="email"):
    if not indices:
        return True
    cmd = [tool_path("leads"), "sent", *[str(i) for i in indices], "--via", via]
    if via == "email":
        cmd += ["--channel", "email"]           # B116: `leads sent` needs the channel; this lane's is email
    return run_tool(cmd, "leads sent")[0]


def notify(text):
    return run_tool([tool_path("notify"), text], "notify")[0]


SHAPE_PROBLEM = ("doesn't give the {date, segment, picks} shape yet (the plan's § Contract; "
                 "wick is adding it to `leads kit --remote --json`)")


def kit_shape(data, where):
    if not isinstance(data, dict) or not isinstance(data.get("picks"), list):
        return None, f"{where} {SHAPE_PROBLEM}"
    return data, None


def kit_json(path=None, free=False):
    """(payload, problem). The shape is the plan's § Contract: {date, segment, picks}.
    `free` adds --census-only --no-save, so `doctor` can check the shape without a
    Places call: a doctor never spends money."""
    path = path or toolbelt("OUTREACH_KIT_JSON")
    if path:
        p = Path(path).expanduser()
        if not p.exists():
            die(f"no kit file {p}")
        try:
            return kit_shape(json.loads(p.read_text()), str(p))
        except json.JSONDecodeError as exc:
            die(f"{p} isn't JSON ({exc})")
    cmd = [tool_path("leads"), "kit", "--remote", "--json"] + (["--census-only", "--no-save"] if free else [])
    shown = "`" + " ".join(["leads"] + cmd[1:]) + "`"
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return None, f"{shown} wouldn't run ({exc})"
    if r.returncode != 0:
        return None, f"{shown} exited {r.returncode}: {(r.stderr or '').strip()[:200]}"
    try:
        data = json.loads(r.stdout)
    except json.JSONDecodeError:
        return None, f"{shown} didn't print JSON"
    return kit_shape(data, shown)


# ---- caps and the kill switch ---------------------------------------------------

def probes_file():
    """`outreach probe`'s test mails (2026-10-02): Message-ID, mailbox and address, so a reply to one
    is recognised as ours and shown to Taylor, never classified as a lead's."""
    return state_dir("probes.jsonl")


def sends_file():
    return state_dir("sends.jsonl")


def replies_file():
    return state_dir("replies.jsonl")


TAYLOR_REPLY = "taylor-reply"


def cold_sends():
    """The letters the lane sent, without Taylor's own answers (`outreach reply`, B105). His answer
    is a row in sends.jsonl so a later reply still finds its thread, but it is a person writing back
    to someone who wrote to him, not a cold send: it doesn't count against a mailbox's daily cap,
    the day's sends, or the bounce and complaint rates the stop rules count."""
    return [r for r in read_jsonl(sends_file()) if r.get("how") != TAYLOR_REPLY]


def cursor_read():
    p = state_dir("cursor.json")
    try:
        return json.loads(p.read_text()) if p.exists() else {}
    except (OSError, json.JSONDecodeError):
        return {}


def cursor_write(cur):
    if DRY:
        return
    try:
        state_dir("cursor.json").write_text(json.dumps(cur))
    except OSError as exc:
        print(f"outreach: couldn't save the inbox cursor ({exc})", file=sys.stderr)


def sent_today(touch=None):
    stamp = today().isoformat()
    rows = [r for r in cold_sends() if r.get("date") == stamp]
    return [r for r in rows if touch is None or int(r.get("touch", 0)) == int(touch)]


def machine_replies_today():
    stamp = today().isoformat()
    return [r for r in read_jsonl(replies_file()) if r.get("date") == stamp and r.get("answered")
            and r.get("answered_by") != "taylor"]        # B105: Taylor's own replies aren't the machine's cap


def answered_thread_today(thread_id):
    stamp = today().isoformat()
    return any(r.get("thread_id") == thread_id and r.get("date") == stamp and r.get("answered")
               for r in read_jsonl(replies_file()))


def deliverability(provider):
    """(ok, rate, complaints, line). The switch: bounces over the cap, or any complaint."""
    cap = env_num("OUTREACH_BOUNCE_MAX_PCT", DEFAULT_BOUNCE_PCT)
    try:
        a = provider.analytics()
    except (Unreachable, ProviderError) as exc:
        return None, None, None, f"the provider's analytics wouldn't answer ({exc})"
    sent, bounced = int(a.get("sent") or 0), int(a.get("bounced") or 0)
    # counted over at least OUTREACH_BOUNCE_MIN_SENDS, so one bounce in a new mailbox's first
    # ten letters reads as what it is and doesn't stop the lane on its own
    floor = int(env_num("OUTREACH_BOUNCE_MIN_SENDS", DEFAULT_BOUNCE_MIN_SENDS, int))
    rate = (bounced / max(sent, floor) * 100) if bounced else 0.0
    complaints = a.get("complaints")
    if complaints is None:
        complaints = int(env_num("OUTREACH_COMPLAINTS", 0, int))
        src = "OUTREACH_COMPLAINTS (Postmaster Tools)"
    else:
        complaints = int(complaints)
        src = "the provider"
    line = (f"{sent} sent, {bounced} bounced ({rate:.1f}%, cap {cap:.1f}%), "
            f"{complaints} spam complaint(s) per {src}")
    return (rate <= cap and complaints == 0), rate, complaints, line


def file_todo_entry(title, one_line, steps, then, details):
    """One entry at the end of TAYLOR-TODO §7, in the house shape."""
    if DRY:
        say(f"  [dry-run] would file TAYLOR-TODO §7: {title}")
        return True
    if not TODO.exists():
        print(f"outreach: no {TODO}; the entry is only in this output", file=sys.stderr)
        return False
    text = TODO.read_text()
    if "## 7." not in text:
        print(f"outreach: {TODO} has no §7; the entry is only in this output", file=sys.stderr)
        return False
    if title in text:
        return False                      # already filed; don't stack the same thing
    lines = [f"\n- [ ] **{title}** {one_line}"]
    for i, s in enumerate(steps, 1):
        lines.append(f"  - **{i}.** {s}")
    if then:
        lines.append(f"  - **Then:** {then}")
    if details:
        lines.append(f"  - **Details:** {details}")
    lines.append(f"  _(outreach, {today().isoformat()})_")
    with open(TODO, "a") as f:
        f.write("\n".join(lines) + "\n")
    return True


def trip_switch(line):
    """Stop the lane, tell Taylor once, file it once, and hold it stopped until he resumes it."""
    marker = state_dir("killswitch", f"{today().isoformat()}.txt")
    already = marker.exists() or latch() is not None
    say(f"outreach: the lane is stopped — {line}")
    if already:
        say("  (already reported; `outreach resume --lane` once the cause is fixed)")
        return
    notify(f"Email lane stopped: {line}. Nothing else goes out until you say so.")
    file_todo_entry(
        "The email lane stopped itself: bounces or a spam complaint.",
        f"`outreach send` and `outreach tick` refuse until this is cleared. {line}",
        ["Open Google Postmaster Tools for the outreach domain and read the spam rate and the delivery errors.",
         "Run `outreach status` for the bounces by mailbox and by batch, and the angry replies; bounced and "
         "angry addresses are already on our suppression list (`outreach suppress ls`).",
         "Fix the cause (a bad address source, a warm-up that ramped too fast, or the copy), then run "
         "`outreach resume --lane`; the counting starts afresh from that moment."],
        "`outreach status` should show no stop rule crossed before the next `send`.",
        f"Filed by `outreach` on {today().isoformat()}. The rules (Taylor, 2026-10-01, answer 2): bounces over "
        f"OUTREACH_BOUNCE_MAX_PCT (default {DEFAULT_BOUNCE_PCT}%) per mailbox or per batch; angry replies plus "
        f"unsubscribes over {DEFAULT_ANGRY_PCT}% of the last {DEFAULT_COMPLAINT_WINDOW} sends; a Postmaster spam "
        f"rate at or over {DEFAULT_SPAM_RATE_PCT}%; any complaint a provider counts. Gmail's own line is 0.3% "
        "(plan 37 § 3).")
    if not DRY:
        try:
            marker.write_text(line + "\n")
            write_json(state_dir("stopped.json"), {"ts": now_iso(), "why": line})
        except OSError:
            pass


def lane_blocked(provider):
    """(blocked, line). The latch, our own stop rules, then the provider's numbers."""
    held = latch()
    if held:
        say(f"outreach: the lane is stopped since {held.get('ts')} — {held.get('why')}. "
            "`outreach resume --lane` is Taylor's, once the cause is fixed.")
        return True, held.get("why")
    reasons = stop_reasons()
    if reasons:
        trip_switch("; ".join(reasons))
        return True, "; ".join(reasons)
    ok, _, _, dline = deliverability(provider)
    if ok is False:
        trip_switch(dline)
        return True, dline
    if ok is None:
        say(f"outreach: can't read the bounce rate, so nothing goes out — {dline}")
        return True, dline
    return False, dline


# ---- the batch lane's state (B90) ------------------------------------------------

_LOCK_DEPTH = [0, None]


@contextlib.contextmanager
def state_lock():
    """One writer at a time: the tick timer and `outreach inbox` both change sequences.json."""
    if DRY:
        yield
        return
    if _LOCK_DEPTH[0]:
        _LOCK_DEPTH[0] += 1
        try:
            yield
        finally:
            _LOCK_DEPTH[0] -= 1
        return
    p = state_dir(".lock")
    f = open(p, "a")
    fcntl.flock(f, fcntl.LOCK_EX)
    _LOCK_DEPTH[0], _LOCK_DEPTH[1] = 1, f
    try:
        yield
    finally:
        _LOCK_DEPTH[0], _LOCK_DEPTH[1] = 0, None
        fcntl.flock(f, fcntl.LOCK_UN)
        f.close()


def read_json(path, default):
    try:
        return json.loads(Path(path).read_text()) if Path(path).exists() else default
    except (OSError, json.JSONDecodeError):
        return default


def write_json(path, data):
    if DRY:
        return
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=1))
    os.replace(tmp, path)


def seqs_load():
    return read_json(state_dir("sequences.json"), [])


def seqs_save(seqs):
    write_json(state_dir("sequences.json"), seqs)


def bounces_file():
    return state_dir("bounces.jsonl")


def paused_boxes():
    return read_json(state_dir("paused.json"), {})


def pause_box(mb, why):
    d = paused_boxes()
    if mb in d:
        return False
    d[mb] = {"ts": now_iso(), "why": why}
    write_json(state_dir("paused.json"), d)
    return True


def latch():
    return read_json(state_dir("stopped.json"), None)


def resumed_at():
    return (read_json(state_dir("resume.json"), {}) or {}).get("lane") or ""


def fault_sentence(f):
    return str(f.get("sentence") if isinstance(f, dict) else f or "").strip()


def details_of(pick):
    """A pick's two sentences as [{sentence, kind}], faults first (plan 37 § Contract, revised
    2026-10-01: the second may be a plain true fact in their favour). No kind means fault."""
    out = []
    for f in pick.get("faults") or []:
        sent = fault_sentence(f)
        if not sent:
            continue
        kind = str(f.get("kind") or "fault").strip().lower() if isinstance(f, dict) else "fault"
        # an entry whose kind is neither is kept as "bad", so screen_batch refuses the pick with
        # that reason rather than guessing which sentence the letter should call a fault
        key = str(f.get("key") or "").strip() if isinstance(f, dict) else ""
        out.append({"sentence": sent, "kind": kind if kind in ("fault", "fact") else "bad", "key": key})
    return sorted(out, key=lambda d: d["kind"] != "fault")


def next_touch(seq):
    for i, t in enumerate(seq.get("touches") or []):
        if not t.get("sent_ts"):
            return i, t
    return None, None


def touch_due(seq, t):
    """Day 0 is the day it was queued; day 3 and 10 count from the first letter's send."""
    if int(t["touch"]) == 0:
        return dt.date.fromisoformat(seq["queued"])
    first = (seq.get("touches") or [{}])[0].get("sent_ts")
    if not first:
        return None
    return dt.datetime.fromisoformat(first).date() + dt.timedelta(days=int(t["touch"]))


def seq_for(email=None, our_message_id=None, seqs=None):
    seqs = seqs_load() if seqs is None else seqs
    if our_message_id:
        for s in seqs:
            if any(t.get("message_id") == our_message_id for t in s.get("touches") or []):
                return s
    e = str(email or "").lower()
    if e:
        for s in seqs:
            if str(s.get("email") or "").lower() == e:
                return s
    return None


def stop_sequence(email=None, our_message_id=None, why="replied"):
    """A reply ends that business's remaining touches. Returns how many touches it stopped."""
    with state_lock():
        seqs = seqs_load()
        s = seq_for(email, our_message_id, seqs)
        if not s or s.get("status") in ("stopped", "done"):
            return 0
        left = sum(1 for t in s.get("touches") or [] if not t.get("sent_ts"))
        s.update(status="stopped", why=why, stopped_ts=now_iso())
        seqs_save(seqs)
        return left


def postmaster_file():
    return state_dir("postmaster.jsonl")


def stop_reasons():
    """The lane's stop rules (Taylor, answer 2), counted from our own records since the last
    `outreach resume --lane`. Returns [reason, ...]; empty means the lane may run."""
    since = resumed_at()
    sends = [r for r in cold_sends() if str(r.get("ts") or "") >= since]
    bounces = [b for b in read_jsonl(bounces_file()) if str(b.get("ts") or "") >= since]
    cap = env_num("OUTREACH_BOUNCE_MAX_PCT", DEFAULT_BOUNCE_PCT)
    floor = int(env_num("OUTREACH_BOUNCE_MIN_SENDS", DEFAULT_BOUNCE_MIN_SENDS, int))
    out = []
    for field, label in (("mailbox", "mailbox"), ("batch_id", "batch")):
        n, b = {}, {}
        for r in sends:
            if r.get(field):
                n[r[field]] = n.get(r[field], 0) + 1
        for r in bounces:
            if r.get(field):
                b[r[field]] = b.get(r[field], 0) + 1
        for k, nb in sorted(b.items()):
            rate = nb / max(n.get(k, 0), floor) * 100
            if rate > cap:
                out.append(f"bounces on {label} {k}: {nb} of {n.get(k, 0)} sent ({rate:.1f}% counted over at least "
                           f"{floor}, cap {cap:.1f}%)")
    window = int(env_num("OUTREACH_COMPLAINT_WINDOW", DEFAULT_COMPLAINT_WINDOW, int))
    last = sends[-window:]
    addrs = {str(r.get("email") or "").lower() for r in last}
    events = [r for r in read_jsonl(replies_file()) if str(r.get("ts") or "") >= since
              and r.get("class") in ("angry", "no") and str(r.get("email") or r.get("from") or "").lower() in addrs]
    acap = env_num("OUTREACH_ANGRY_MAX_PCT", DEFAULT_ANGRY_PCT)
    arate = len(events) / max(len(last), window) * 100 if window else 0.0
    if arate > acap:
        out.append(f"angry replies plus unsubscribes: {len(events)} over the last {len(last)} sends "
                   f"({arate:.2f}% of {max(len(last), window)}, cap {acap:.1f}%)")
    scap = env_num("OUTREACH_SPAM_RATE_MAX_PCT", DEFAULT_SPAM_RATE_PCT)
    latest = {}
    for r in read_jsonl(postmaster_file()):
        if str(r.get("ts") or "") >= since and r.get("rate") is not None:   # B136: reputation-only isn't 0%
            latest[r.get("domain") or "?"] = r
    for d, r in sorted(latest.items()):
        if float(r.get("rate") or 0) >= scap:
            out.append(f"Postmaster spam rate on {d}: {float(r['rate']):.2f}% (stops at {scap:.2f}%)")
    return out


def stop_numbers():
    """The figures behind the stop rules, for `status` and `doctor`."""
    since = resumed_at()
    sends = [r for r in cold_sends() if str(r.get("ts") or "") >= since]
    bounces = [b for b in read_jsonl(bounces_file()) if str(b.get("ts") or "") >= since]
    window = int(env_num("OUTREACH_COMPLAINT_WINDOW", DEFAULT_COMPLAINT_WINDOW, int))
    last = sends[-window:]
    addrs = {str(r.get("email") or "").lower() for r in last}
    reps = [r for r in read_jsonl(replies_file()) if str(r.get("ts") or "") >= since]
    angry = [r for r in reps if r.get("class") == "angry" and str(r.get("email") or r.get("from") or "").lower() in addrs]
    nos = [r for r in reps if r.get("class") == "no" and str(r.get("email") or r.get("from") or "").lower() in addrs]
    pm = [r for r in read_jsonl(postmaster_file()) if r.get("rate") is not None]
    return {"sends": len(sends), "bounces": len(bounces), "window": len(last), "angry": len(angry), "no": len(nos),
            "postmaster": pm[-1] if pm else None, "since": since or "the beginning"}


# ---- verification before a first send (B90) --------------------------------------

VERIFY_RESULTS = ("ok", "catch_all", "unknown", "invalid", "disposable", "error")
VERIFY_USD_EACH = 0.004


def verify_kind():
    return (toolbelt("OUTREACH_VERIFY") or "none").strip().lower()


def verify_address(email):
    """One address through the verifier, cached for good in state/verify.jsonl, one ledger
    row a paid check. -> one of VERIFY_RESULTS. Never raises: a fault is "error"."""
    e = str(email).strip().lower()
    for row in reversed(read_jsonl(state_dir("verify.jsonl"))):
        if row.get("email") == e and row.get("result") != "error":
            return row["result"]
    kind = verify_kind()
    if kind != "millionverifier":
        return "error"
    key = toolbelt("MILLIONVERIFIER_API_KEY")
    if not key:
        return "error"
    if DRY:
        say(f"  [dry-run] would verify {e} (about ${VERIFY_USD_EACH})")
        return "error"
    base = (toolbelt("OUTREACH_VERIFY_BASE") or "https://api.millionverifier.com").rstrip("/")
    url = f"{base}/api/v3/?" + urllib.parse.urlencode({"api": key, "email": e, "timeout": 10})
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "claude-tools/outreach", "Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=25) as resp:
            data = json.loads(resp.read().decode(errors="replace"))
    except (urllib.error.URLError, TimeoutError, OSError, json.JSONDecodeError) as exc:
        # the URL carries the key, so the fault is reported by its type alone
        print(f"outreach: the verifier didn't answer for {e} ({type(exc).__name__}); it waits", file=sys.stderr)
        return "error"
    result = str(data.get("result") or "").strip().lower().replace("-", "_")
    if result not in VERIFY_RESULTS:
        result = "error"
    append_jsonl(state_dir("verify.jsonl"), {"ts": now_iso(), "email": e, "result": result, "by": kind})
    ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "email_verify",
                   "tool": "outreach", "calls": 1, "cost_usd": VERIFY_USD_EACH, "project": "global",
                   "billed_to": f"{kind}:MILLIONVERIFIER_API_KEY", "for": f"verify {e}: {result}"})
    return result


def mx_ok(seq):
    return str(seq.get("email_mx") or "").strip().lower() in ("ok", "true", "yes", "1") or seq.get("mx_ok") is True


def first_send_gate(seq):
    """Before a business's first letter: ("send", why) | ("hold", until, why) | ("drop", why).

    The first month after the warm-up start is when a bounce costs the most, so in it
    accept-all and unknown addresses wait; with no verifier, only addresses the batch
    marked MX-ok on the business's own domain go (plan 37 § 3)."""
    start, _ = warmup_start()
    first_month_ends = (start + dt.timedelta(days=NEW_SENDER_DAYS)) if start else None
    young = first_month_ends is None or today() < first_month_ends
    hold_until = first_month_ends if first_month_ends else today() + dt.timedelta(days=1)
    kind = verify_kind()
    if kind == "none":
        own = seq.get("email_kind") == "own-domain"
        if young:
            if own and mx_ok(seq):
                return "send", "own domain, MX ok"
            return "hold", hold_until, ("no verifier, so only own-domain MX-ok addresses go in the first "
                                        f"{NEW_SENDER_DAYS} days")
        if str(seq.get("email_mx") or "").strip().lower() in ("none", "no", "false"):
            return "drop", "no mail server for that domain"
        return "send", "past the first month"
    res = verify_address(seq.get("email"))
    if res == "ok":
        return "send", "verified"
    if res in ("invalid", "disposable"):
        return "drop", f"the verifier says {res}"
    if res == "error":
        return "hold", today() + dt.timedelta(days=1), "the verifier couldn't check it today"
    if young:
        return "hold", hold_until, f"the verifier says {res}; those wait out the first {NEW_SENDER_DAYS} days"
    return "send", f"verifier {res}, past the first month"


# ---- the classifier -------------------------------------------------------------

def quoted_off(text):
    """The person's own words: everything above the first quoted line or 'On … wrote:'."""
    out = []
    for line in (text or "").splitlines():
        s = line.strip()
        if s.startswith(">") or re.match(r"^On .{5,60} wrote:$", s) or s.startswith("-----Original Message"):
            break
        out.append(line)
    return "\n".join(out).strip()


def rule_class(reply):
    """The classes that must never wait on an API call: a no, a bounce, an auto-reply."""
    body = quoted_off(reply.get("text") or "")
    low = (body + " " + (reply.get("subject") or "")).lower()
    frm = (reply.get("from") or "").lower()
    if reply.get("bounce") or any(b in frm for b in BOUNCE_FROM) or any(
            s in (reply.get("subject") or "").lower() for s in BOUNCE_SUBJECTS):
        return "bounce", "the sender or subject is a delivery notification"
    if any(re.search(p, low) for p in ANGRY_PATTERNS):
        return "angry", "upset at being written to, or calls it spam"
    if any(re.search(p, low) for p in NO_PATTERNS):
        return "no", "the reply asks to be left alone"
    if reply.get("auto_reply") or any(re.search(p, low) for p in OOF_PATTERNS):
        return "out of office", "an automatic reply"
    return None, None


def guess_class(reply):
    """The fallback when there is no classifier: nothing is machine-answered."""
    words = quoted_off(reply.get("text") or "")
    low = words.lower()
    if any(re.search(p, low) for p in CALLME_PATTERNS):
        return "interested", "asks to talk"
    if "?" not in words and len(words.split()) <= 8 and YES_RE.match(words.strip()):
        return "yes", "a short yes and nothing else"
    return "other", "no classifier available, so a person reads it"


def question_topic(reply):
    low = quoted_off(reply.get("text") or "").lower()
    if any(re.search(p, low) for p in PRICE_QUESTION):
        return "price"
    if any(re.search(p, low) for p in HOW_QUESTION):
        return "how"
    return None


def named_time(reply):
    m = WHEN_RE.search(quoted_off(reply.get("text") or ""))
    return m.group(0).strip() if m else None


def ai_classify(reply):
    """One small Messages API call. Returns (row, spent) or (None, 0) when it can't run."""
    key_name = "ANTHROPIC_KEY_OUTREACH" if toolbelt("ANTHROPIC_KEY_OUTREACH") else "ANTHROPIC_KEY_RELAY"
    key = toolbelt(key_name)
    if not key:
        return None, 0.0
    cap = env_num("OUTREACH_AI_USD_PER_DAY", DEFAULT_AI_USD)
    if ledger_ai_spend_today() >= cap:
        return None, 0.0
    base = (toolbelt("ANTHROPIC_API_BASE") or "https://api.anthropic.com").rstrip("/")
    body = quoted_off(reply.get("text") or "")[:4000]
    system = (
        f"You read one reply to a cold email. {V.sender.from_name} builds and looks after websites for local "
        f"businesses from {V.sender.town}, {V.sender.state_name}; his letter named two things about the business's Google "
        "listing or website and offered to build a free preview of a site. Your answer decides what "
        "happens next, so here is what each class sets in motion:\n"
        "- \"yes\": they simply accept the free preview and ask nothing else. A preview is built and its "
        "link goes back to them automatically.\n"
        "- \"interested\": they want to talk, name a time, ask for a call, or say yes with a question or a "
        "condition attached. Taylor answers these himself.\n"
        "- \"question\": only a question about the price (topic \"price\") or only about what this is or "
        "how it works (topic \"how\"). A short answer Taylor approved goes back.\n"
        "- \"not now\": maybe later.\n"
        "- \"no\": they ask to stop, to unsubscribe, or say they are not interested. They are taken off "
        "the list for good.\n"
        "- \"angry\": they are upset at being written to, call it spam, or say they will report it. The "
        "mailbox that wrote to them pauses and Taylor is told. A polite no is \"no\", not \"angry\".\n"
        "- \"bounce\" and \"out of office\": delivery failures and automatic replies.\n"
        "- \"unsure\": you can't tell which of these it is. That is a good answer, not a failure: Taylor "
        "reads every unsure reply himself, so a guess costs more than an unsure.\n"
        "- \"other\": clearly none of these, such as an unrelated message.\n"
        "If you couldn't read the message (garbled, or a language you can't follow), answer \"unsure\" "
        "and say why in \"why\"; the reason is passed to Taylor.\n"
        "You have about 300 tokens. Reply with one JSON object and nothing else, with these keys: "
        "class (one of the ten above), topic (\"price\", \"how\" or null), when (a time they named, "
        "copied exactly, or null), why (one short clause)."
    )
    try:
        status, data = http("POST", f"{base}/v1/messages",
                            headers={"x-api-key": key, "anthropic-version": ANTHROPIC_VERSION},
                            body={"model": AI_MODEL, "max_tokens": AI_MAX_TOKENS, "system": system,
                                  "messages": [{"role": "user", "content":
                                                f"Subject: {reply.get('subject') or ''}\n\n{body}"}]})
    except Unreachable as exc:
        print(f"outreach: the classifier is unreachable ({exc}); this reply goes to Taylor", file=sys.stderr)
        return None, 0.0
    if status >= 400:
        msg = data.get("error", {}).get("message") if isinstance(data, dict) else str(data)[:200]
        print(f"outreach: the classifier answered {status} ({msg}); this reply goes to Taylor", file=sys.stderr)
        return None, 0.0
    usage = (data or {}).get("usage") or {}
    tin, tout = int(usage.get("input_tokens") or 0), int(usage.get("output_tokens") or 0)
    pin, pout = AI_PRICES.get(AI_MODEL, (1.0, 5.0))
    cost = round(tin / 1e6 * pin + tout / 1e6 * pout, 6)
    ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "claude",
                   "tool": "outreach", "model": AI_MODEL, "tokens_in": tin, "tokens_out": tout,
                   "cost_usd": cost, "billed_to": f"anthropic:{key_name}", "project": "global",
                   "for": f"classify {reply.get('id')}"})
    text = "".join(b.get("text", "") for b in (data or {}).get("content", []) if b.get("type") == "text")
    m = re.search(r"\{.*\}", text, re.S)
    if not m:
        return None, cost
    try:
        got = json.loads(m.group(0))
    except json.JSONDecodeError:
        return None, cost
    cls = str(got.get("class") or "").strip().lower()
    if cls not in CLASSES:
        return None, cost
    return {"class": cls, "topic": (got.get("topic") or None), "when": (got.get("when") or None),
            "why": str(got.get("why") or "")[:120], "ai": True}, cost


def wants_a_person(reply):
    low = quoted_off(reply.get("text") or "").lower()
    return any(re.search(p, low) for p in CALLME_PATTERNS)


def classify(reply):
    cls, why = rule_class(reply)
    if cls:
        return {"class": cls, "topic": None, "when": None, "why": why, "ai": False}
    got, _ = ai_classify(reply)
    if got:
        if got["class"] == "question" and not got.get("topic"):
            got["topic"] = question_topic(reply)
        if not got.get("when"):
            got["when"] = named_time(reply)
        # A rule, not a judgement: somebody asking to be called gets a person, whatever
        # else the classifier read in the message.
        if got["class"] not in ("no", "bounce", "angry") and wants_a_person(reply):
            got.update({"class": "interested", "topic": None,
                        "why": (got.get("why") or "") + "; asks to talk, so it is Taylor's"})
        return got
    g = guess_class(reply)
    return {"class": g[0], "topic": None, "when": named_time(reply), "why": g[1], "ai": False}


# ---- lead lookup ---------------------------------------------------------------

def sent_rows_by_email():
    by = {}
    for r in read_jsonl(sends_file()):
        e = str(r.get("email") or "").lower()
        if e:
            by[e] = r
    return by


EMAIL_RE = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}")


def address_we_sent_to(reply):
    """The address this reply is about. A bounce comes from MAILER-DAEMON and names the
    real recipient in its body, so match any address we have actually written to."""
    by = sent_rows_by_email()
    frm = str(reply.get("from") or "").strip()
    if frm.lower() in by:
        return frm
    haystack = f"{reply.get('subject') or ''}\n{reply.get('text') or ''}"
    for found in EMAIL_RE.findall(haystack):
        if found.lower() in by:
            return found
    return frm


def send_row_for(reply):
    """The send a reply answers: by the Message-ID it names (B90), else by the address."""
    mid = reply.get("our_message_id")
    if mid:
        for r in read_jsonl(sends_file()):
            if r.get("message_id") == mid:
                return r
    if reply.get("bounced_to"):
        return sent_rows_by_email().get(str(reply["bounced_to"]).lower())
    return sent_rows_by_email().get(address_we_sent_to(reply).lower())


def who_replied(reply):
    """The send this reply belongs to: (name, place_id, email, first)."""
    row = send_row_for(reply)
    if row:
        return row.get("name"), row.get("place_id"), row.get("email"), (row.get("first") or "")
    addr = address_we_sent_to(reply)
    row = sent_rows_by_email().get(addr.lower())
    if row:
        return row.get("name"), row.get("place_id"), row.get("email"), (row.get("first") or "")
    return (addr.split("@")[0] or "someone"), None, addr, ""


# ---- send ----------------------------------------------------------------------

def values_for(pick, touch):
    fault = to_you((pick.get("faults") or [""])[0])
    days = int(env_num("OUTREACH_PREVIEW_DAYS", DEFAULT_PREVIEW_DAYS, int))
    expiry = (today() + dt.timedelta(days=max(days - touch, 1))).strftime("%-d %B")
    business = pick.get("name") or ""
    return {
        "first": greeting_name(pick.get("first"), business),
        "business": business, "fault": fault, "preview_url": pick.get("preview_url") or "",
        "price_line": PRICE_LINE, "prices_line": PRICES_LINE,
        # B71: one sentence in the vendor's own public price, from `leads` (client-leads/vendor_prices.md);
        # empty when the vendor is unknown, free or unpriced, and then the sentence is gone whole
        "paying": pick.get("paying") or "",
        "phone": toolbelt(V.sender.phone_env) or "",
        "booking": toolbelt("LEADS_BOOKING_URL") or "",
        "address": toolbelt(V.sender.postal_address_env) or "",
        "demo": toolbelt(V.sender.demo_number_env, DEMO_NUMBER_DEFAULT),
        "expiry": expiry,
    }


COMPANY_TAIL = re.compile(r"[,\s]+(?:llc|l\.l\.c\.?|inc|inc\.|co|co\.|corp|corp\.|ltd|ltd\.|pllc|lc)$", re.I)


# `leads` writes a fault about the place ("no hours on Google", "not a site of their own");
# a letter says it to the owner. The phrasings match `leads`'s own to_you() (B62), except
# that here the fault stands alone after "I looked X up on Google:", so it never says "it".
# Duplicated rather than imported: `leads` is a 3,800-line script, this is a dozen lines.
FAULT_SAID = {
    "no website on Google": "there's no website on your Google listing",
    "no hours on Google": "there are no hours on your Google listing",
    "no photos": "there are no photos on your Google listing",
    "no phone on Google": "there's no phone number on your Google listing",
}


def to_you(fault):
    """A fault is written about a place; a letter is written to it."""
    f = (fault or "").strip()
    if f in FAULT_SAID:
        return FAULT_SAID[f]
    m = re.match(r"^only (\d+) photos$", f)
    if m:
        return f"your Google listing has only {m.group(1)} photos"
    m = re.match(r"^a (\d)★ review (.+)$", f)
    if m:
        return f"there's a {m.group(1)}★ review on your Google listing from {m.group(2)}"
    if f.startswith("newest review is "):
        return "your " + f
    f = (f.replace("the website link is a business.site page, and Google shut those down in 2024: it's a dead link",
                   "your listing's website link is a business.site page, which Google shut down in 2024, so it goes nowhere")
         .replace("the website link", "your listing's website link").replace("the website is", "your website is")
         .replace("Google says closed", "Google says you're closed")
         .replace("searching the name brings up", "searching your name brings up"))
    f = re.sub(r"\btheirs\b", "yours", f)
    f = re.sub(r"\btheir\b", "your", f)
    f = re.sub(r"\bthey (serve|don't|do not|control)\b", r"you \1", f)   # never "check they're right" (the hours)
    f = re.sub(r"\bthem\b", "you", f)
    return f


def greeting_name(first, business):
    """"Hi Dave," when there is a person, "Hi Pinnacle Painting team," when `first` is just
    the business name again (which is what the census gives for a company)."""
    first = (first or "").strip()
    plain = COMPANY_TAIL.sub("", (business or "").strip()).strip()
    looks_like_a_person = first and len(first.split()) == 1 and first.lower() != (business or "").lower()
    if looks_like_a_person:
        return first
    return f"{plain} team" if plain else "there"


def unconfirmed_address(p):
    """The skip reason for a kit pick whose address isn't one the census tied to the place (B104, plan 44), or None.
    `leads kit --json` puts only a `high` address in `email` and the held-back one in `email_unconfirmed`; a pick
    from a kit made before B104 has no `email_unconfirmed` key at all, so its address was never judged and waits
    for a fresh kit. A letter to a namesake reaches a stranger with Taylor's name on it, so this fails closed."""
    held = p.get("email_unconfirmed")
    if isinstance(held, dict) and held.get("address") and not (p.get("email") or "").strip():
        return f"unconfirmed address {held['address']} ({held.get('why') or 'no reason given'}), call-only"
    if (p.get("email") or "").strip() and "email_unconfirmed" not in p:
        return (f"unconfirmed address {p['email'].strip()} (a kit made before B104: never judged against the place; "
                "run the kit again), call-only")
    return None


def cmd_send(args):
    global DRY
    if getattr(args, "batch", None):
        return cmd_send_batch(args, provider_wanted(args.provider))
    per_day = int(env_num("OUTREACH_PER_DAY", DEFAULT_PER_DAY, int))
    touch = int(args.touch)
    if touch not in TOUCH_TEMPLATE:
        die("--touch is 0, 3 or 10 (the day-0 note and the two follow-ups, GROWTH § 5.5)")
    tname = TOUCH_TEMPLATE[touch]

    addr = toolbelt(V.sender.postal_address_env)
    if not addr:
        die(f"{V.sender.postal_address_env} isn't set, so no email may go out: US law wants a real postal address on "
            "every commercial email (TAYLOR-TODO §1). Nothing sent.")
    bad = approval_problems([tname])
    if bad:
        die("the letter isn't approved — " + "; ".join(bad)
            + f". Have Taylor read {TEMPLATES / (tname + '.md')} and run `outreach approve`. Nothing sent.")
    checks = check_template(tname)
    if checks:
        die(f"{tname}.md breaks its own rules: " + "; ".join(checks) + ". Nothing sent.")

    provider = pick_provider(args.provider)
    held = latch()
    if held:
        say(f"outreach: the lane is stopped since {held.get('ts')} — {held.get('why')}. "
            "`outreach resume --lane` is Taylor's, once the cause is fixed.")
        sys.exit(1)
    reasons = stop_reasons()
    if reasons:
        trip_switch("; ".join(reasons))
        sys.exit(1)
    ok, _, _, dline = deliverability(provider)
    if ok is False:
        trip_switch(dline)
        sys.exit(1)
    if ok is None:
        # Sending blind would make the kill switch decorative: no numbers, no send.
        die(f"can't read the bounce rate, so nothing goes out — {dline}")
    say(f"Deliverability: {dline}")

    payload, problem = kit_json(args.kit)
    if problem:
        say(f"Nothing to send: {problem}")
        sys.exit(0)
    picks = [p for p in (payload.get("picks") or []) if isinstance(p, dict)]
    say(f"Kit {payload.get('date') or today()} · segment {payload.get('segment') or '?'} · {len(picks)} picks · "
        f"touch day {touch} ({tname}) · provider {provider.name}{' · DRY RUN' if DRY else ''}")

    if args.only:
        keep = {int(i) for i in args.only}
        picks = [p for i, p in enumerate(picks, 1) if i in keep]
        say(f"  --only {' '.join(str(i) for i in sorted(keep))}")
    if args.hold:
        drop = {int(i) for i in args.hold}
        picks = [p for i, p in enumerate(picks, 1) if i not in drop]
        say(f"  --hold {' '.join(str(i) for i in sorted(drop))} (dropped)")

    supp, already = suppressed(), {str(r.get("email") or "").lower() for r in sent_today(touch)}
    plan, skipped = [], []
    for i, p in enumerate(picks, 1):
        email = (p.get("email") or "").strip()
        held = unconfirmed_address(p)
        if held:
            skipped.append((i, p.get("name"), held))
            continue
        if not email:
            skipped.append((i, p.get("name"), "no address on the listing"))
            continue
        if is_suppressed(email, p.get("place_id"), supp):
            skipped.append((i, p.get("name"), "suppressed"))
            continue
        if email.lower() in already:
            skipped.append((i, p.get("name"), "already sent today"))
            continue
        if not (p.get("preview_url") or "").strip():
            # Every letter's middle sentence is "I've made you a page…". Without one there
            # is no letter to send — B45 builds them (`leads kit --remote --previews`).
            skipped.append((i, p.get("name"), "no preview page yet (B45)"))
            continue
        plan.append((i, p))

    room = per_day - len(sent_today(touch))
    if per_day <= 0:
        say(f"OUTREACH_PER_DAY is {per_day}, so nothing sends. Set it (14 days of a handful, then 20, then 40 — "
            "GROWTH § 5.3) and try again.")
        for i, name, why in skipped:
            say(f"  {i}. {name} — skipped: {why}")
        sys.exit(0)
    if room <= 0:
        say(f"The day's cap is spent: {len(sent_today(touch))} of {per_day} already went out.")
        sys.exit(0)
    if len(plan) > room:
        say(f"  cap: {room} of {per_day} left today, so {len(plan) - room} pick(s) wait for tomorrow")
        plan = plan[:room]

    if not args.go and str(toolbelt("OUTREACH_AUTO") or "") != "1":
        say(f"\nWaiting on `go` — {len(plan)} ready. Two weeks of Taylor's word before OUTREACH_AUTO=1 "
            "(GROWTH § 5.3); the schedule passes --go on the morning he said it.")
        for i, p in plan:
            subject, _ = load_template(tname).render(values_for(p, touch),
                                                    fault=(p.get("faults") or [""])[0])
            say(f"  {i}. {p.get('name')} <{p.get('email')}> — \"{subject}\"")
        for i, name, why in skipped:
            say(f"  {i}. {name} — skipped: {why}")
        sys.exit(0)

    t = load_template(tname)
    sent, indices, failed = [], [], 0
    say("")
    for i, p in plan:
        vals = values_for(p, touch)
        subject, letter = t.render(vals, fault=(p.get("faults") or [""])[0])
        say(f"{i}. {p.get('name')} <{p.get('email')}> — \"{subject}\"")
        if DRY or args.show:
            say("".join(f"   | {l}\n" for l in letter.splitlines()))
        if claims_a_site(letter, p.get("preview_url")):
            say("   REFUSED: the letter says a site was built, and this pick has no preview")
            continue
        try:
            res = provider.send(p, subject, letter)
        except (Unreachable, ProviderError) as exc:
            say(f"   FAILED: {exc}")
            failed += 1
            continue
        row = {"ts": now_iso(), "date": today().isoformat(), "touch": touch, "template": tname,
               "place_id": p.get("place_id"), "name": p.get("name"), "first": p.get("first") or "",
               "email": p.get("email"), "subject": subject, "provider": provider.name,
               "provider_id": (res or {}).get("id"), "preview_url": p.get("preview_url"), "kit_index": i,
               "mailbox": str((res or {}).get("mailbox") or getattr(provider, "eaccount", "") or "").lower() or None,
               "message_id": (res or {}).get("message_id")}
        if not DRY:
            append_jsonl(sends_file(), row)
        ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "outreach_email",
                       "tool": "outreach", "calls": 1, "cost_usd": 0, "project": "global",
                       "billed_to": f"{provider.name}:INSTANTLY_API_KEY" if provider.name == "instantly" else "fake",
                       "for": f"{tname} day{touch} -> {p.get('name')} <{p.get('email')}>"})
        sent.append(row)
        indices.append(i)

    # The pipeline is `leads`'. `sent` teaches the kit what went out; `log` records the subject.
    if sent and not args.kit:
        leads_sent(indices)
    for row in sent:
        leads_log(row["name"], "messaged", f"email: {row['subject']}",
                  place_id=row.get("place_id"), email=row.get("email"))

    say("")
    say(f"Sent {len(sent)} of {per_day} today ({len(sent_today(touch))} logged) on {provider.name}"
        f"{' — DRY RUN, nothing left the machine' if DRY else ''}.")
    for i, name, why in skipped:
        say(f"  {i}. {name} — skipped: {why}")
    if sent and not DRY:
        say("Replies: `outreach inbox` (the timer runs it every 15 minutes, 07:00–20:00).")
    if failed and not sent:
        die(f"every send failed ({failed}); the provider is the problem, not the picks")


# ---- the batch lane: send --batch and the tick (B90) ------------------------------

def load_batch(src):
    """The plan's § Contract shape from `leads batch --json`, a file or stdin."""
    try:
        raw = sys.stdin.read() if src == "-" else Path(src).expanduser().read_text()
    except OSError as exc:
        die(f"can't read the batch ({exc})")
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        die(f"the batch isn't JSON ({exc})")
    if not isinstance(data, dict) or not isinstance(data.get("picks"), list):
        die("the batch isn't the {batch_id, picks: [...]} shape of `leads batch --json` (plan 37 § Contract)")
    if not data.get("batch_id"):
        die("the batch has no batch_id; `leads batch --json` gives one, and every send is counted by it")
    return data


def screen_batch(batch):
    """-> (plan, skipped). Never twice to an address or a place, never a suppressed one,
    and only picks with exactly two fault sentences (a business with fewer isn't written to)."""
    supp = suppressed()
    seqs = seqs_load()
    in_seq = {str(s.get("email") or "").lower() for s in seqs} | {str(s.get("place_id") or "") for s in seqs}
    written = {str(r.get("email") or "").lower() for r in read_jsonl(sends_file())}
    plan, skipped, seen = [], [], set()
    for i, p in enumerate(batch.get("picks") or [], 1):
        if not isinstance(p, dict):
            continue
        name, email = p.get("name") or "?", str(p.get("email") or "").strip()
        faults = details_of(p)
        why = None
        if email and p.get("email_confidence") != "high":
            why = (f"unconfirmed address {email} ({p.get('email_place') or p.get('email_confidence') or 'no place judgement on it: a batch made before B104'}), "
                   "call-only")
        elif not email or "@" not in email:
            why = "no address"
        elif is_suppressed(email, p.get("place_id"), supp):
            why = "suppressed"
        elif len(faults) != 2:
            why = f"{len(faults)} sentence(s), not two"
        elif any(f["kind"] == "bad" for f in faults):
            why = "an entry's kind is neither fault nor fact (plan 37 § Contract)"
        elif faults[0]["kind"] != "fault":
            why = "no fault worth naming, only facts"
        elif email.lower() in in_seq or str(p.get("place_id") or "") in in_seq:
            why = "already in a sequence"
        elif email.lower() in written:
            why = "already written to"
        elif email.lower() in seen:
            why = "twice in this batch"
        if why:
            skipped.append((i, name, why))
            continue
        seen.add(email.lower())
        plan.append((i, p, faults))
    return plan, skipped


def new_sequence(batch, p, faults, variant=None, test=None):
    """One business's three touches. `variant` is where its letters carry the AI sentence (B132), kept to
    the end of the thread; `test` is the AI-line test's start stamp when the test dealt it, so a `none`
    thread can show it began inside the test. The fault key, segment and prebuilt flag ride along so
    every send row and pipeline event can be cut by them later."""
    return {"id": f"{batch['batch_id']}/{p.get('place_id') or p.get('email')}", "batch_id": batch["batch_id"],
            "place_id": p.get("place_id"), "name": p.get("name"), "first": p.get("first") or "",
            "email": str(p.get("email")).strip(), "email_kind": p.get("email_kind"),
            "email_mx": p.get("email_mx"), "mx_ok": p.get("mx_ok"), "city": p.get("city"),
            "category": p.get("category"), "faults": [d["sentence"] for d in faults],
            "kinds": [d["kind"] for d in faults], "preview_url": p.get("preview_url") or "",
            "variant": variant or AI_DEFAULT, "ai_test": test,
            "fault_key": (faults[0].get("key") if faults else "") or "",
            "segment": p.get("segment") or batch.get("segment") or "",
            "prebuilt": bool(str(p.get("preview_url") or "").strip()),
            "token": secrets.token_urlsafe(9), "mailbox": None, "status": "active", "why": "",
            "queued": today().isoformat(), "queued_ts": now_iso(),
            "touches": [{"touch": d, "template": t, "sent_ts": None, "message_id": None, "subject": None}
                        for d, t in BATCH_TOUCHES]}


# ---- the AI-line test (B132) ---------------------------------------------------------

def ai_test_file():
    return state_dir("ai-test.json")


def ai_test():
    """{open, started, stopped, keep}: the test's state. No file means it was never started."""
    d = read_json(ai_test_file(), {}) or {}
    return {"open": bool(d.get("open")), "started": d.get("started"), "stopped": d.get("stopped"),
            "keep": d.get("keep") if d.get("keep") in AI_VARIANTS else None}


def ai_none_allowed():
    """A letter with no AI sentence may be dealt only inside the test, or after Taylor's stop kept `none`
    (his word on the rule itself)."""
    t = ai_test()
    return t["open"] or t["keep"] == "none"


def ai_kept_none():
    """Taylor's stop kept `none`: honoured, and every place the checker speaks says the rule is his to change."""
    t = ai_test()
    return not t["open"] and t["keep"] == "none"


def ai_variant_outside_test():
    t = ai_test()
    return t["keep"] or AI_DEFAULT


def deal_variants(plan):
    """[(i, p, faults)] -> {i: variant}. While the test is open: ordered within each fault key by
    sha256(place_id) and dealt none, intro, foot in turn, so no variant collects one kind of fault.
    The deal carries on from where the test's last batch stopped (the count of sequences this test has
    already dealt), so leftovers rotate: thirty give ten each, and a run of small or uneven batches
    (holds, caps) keeps the three within one of each other instead of piling the odd ones on `none`.
    It depends only on the picks and the test's state, never on the order picks arrive in, so a dry run
    shows what `go` will deal. Outside the test every business gets the kept placement (intro unless
    Taylor's stop said otherwise)."""
    t = ai_test()
    if not t["open"]:
        v = ai_variant_outside_test()
        return {i: v for i, _, _ in plan}
    def order(item):
        i, p, faults = item
        key = (faults[0].get("key") if faults else "") or ""
        ident = str(p.get("place_id") or p.get("email") or i)
        return (key, hashlib.sha256(ident.encode()).hexdigest())
    start = sum(1 for s in seqs_load() if s.get("ai_test") == t["started"])
    return {i: AI_VARIANTS[(start + n) % len(AI_VARIANTS)] for n, (i, _, _) in enumerate(sorted(plan, key=order))}


def cmd_ai_test(args):
    """`outreach ai-test start|stop [--keep V]|show`. Start and stop are Taylor's word only (his text, as
    `go` is): the test never stops itself, and `status --by variant` only reports."""
    t = ai_test()
    act = args.action or "show"
    if act == "show":
        say(ai_test_line(t))
        return
    if act == "start":
        if t["open"]:
            say(f"The AI-line test is already open (since {t['started']}); nothing changed.")
            return
        row = {"open": True, "started": now_iso(), "stopped": None, "keep": None}
        if DRY:
            say("[dry-run] would open the AI-line test")
            return
        write_json(ai_test_file(), row)
        append_jsonl(state_dir("ai-test.jsonl"), {"ts": now_iso(), "action": "start"})
        say(f"The AI-line test is open from {row['started']}: each new batch is dealt a third each to none, "
            "intro and foot. `outreach status --by variant` reads it; it stops only on Taylor's word "
            "(`outreach ai-test stop --keep intro|foot|none`).")
        return
    # stop
    keep = args.keep or AI_DEFAULT
    if not t["open"]:
        say("The AI-line test isn't open; nothing to stop." + (f" New letters go out {t['keep']}." if t["keep"] else ""))
        return
    row = {"open": False, "started": t["started"], "stopped": now_iso(), "keep": keep}
    if DRY:
        say(f"[dry-run] would stop the AI-line test, keeping {keep}")
        return
    write_json(ai_test_file(), row)
    append_jsonl(state_dir("ai-test.jsonl"), {"ts": now_iso(), "action": "stop", "keep": keep})
    say(f"The AI-line test stopped at {row['stopped']}. New sequences go out {keep}"
        + ("" if args.keep else " (no --keep given, so the placement from before the test)")
        + "; sequences already running finish as they began.")
    if keep == "none":
        say(f"Note: {AI_NONE_KEPT}.")


def ai_test_line(t=None):
    t = t or ai_test()
    if t["open"]:
        return (f"AI-line test: open since {t['started']} — new batches are dealt none / intro / foot, a third "
                "each; it stops only on Taylor's word (`outreach ai-test stop --keep X`)")
    if t["stopped"]:
        line = f"AI-line test: stopped {t['stopped']}, kept {t['keep'] or AI_DEFAULT}; new letters go out that way"
        return line + (f". {AI_NONE_KEPT}" if t["keep"] == "none" else "")
    return f"AI-line test: not started; every letter carries the AI sentence beside the introduction ({AI_DEFAULT})"


def see_url(seq):
    base = link_base()
    return f"{base}/{seq['token']}" if base and seq.get("token") else ""


def batch_values(seq, touch):
    name = seq.get("name") or ""
    second_kind = ((seq.get("kinds") or ["fault", "fault"]) + ["fault", "fault"])[1]
    first_subject = ((seq.get("touches") or [{}])[0].get("subject")
                     or f"two things I noticed about {name}")
    return {
        "first": greeting_name(seq.get("first"), name), "business": name,
        "fault_one": seq["faults"][0],
        "fault_two": seq["faults"][1] if second_kind != "fact" else "",
        "fact": seq["faults"][1] if second_kind == "fact" else "",
        "price_line": PRICE_LINE, "prices_line": PRICES_LINE,
        "phone": toolbelt(V.sender.phone_env) or "",
        "address": toolbelt(V.sender.postal_address_env) or "",
        "see_url": see_url(seq) if touch > 0 else "",
        "thread_subject": re.sub(r"^(?:re:\s*)+", "", first_subject, flags=re.I),
        "preview_url": seq.get("preview_url") or "",
        **ai_values(seq.get("variant") or AI_DEFAULT),
    }


def ai_values(variant):
    """The one `[?ai_*]` key the variant names turns on; the others stay empty, so their lines drop."""
    return {k: ("1" if v == variant else "") for v, k in AI_KEYS.items()}


def claims_a_site(letter, preview_url):
    """True when the letter says a site exists and none does: never sent (plan 37 § 3)."""
    return bool(BUILT_RE.search(letter)) and not str(preview_url or "").strip()


def batch_problems(none_ok=True):
    """What must hold before any batch letter leaves. `none_ok=False` when a new `none` sequence is
    about to be dealt outside the AI-line test (it never is: deal_variants only deals it inside)."""
    bad = []
    if not toolbelt(V.sender.postal_address_env):
        bad.append(f"{V.sender.postal_address_env} isn't set (US law wants a postal address on every commercial email)")
    bad += approval_problems(BATCH_LETTERS)
    for n in BATCH_LETTERS:
        bad += [f"{n}: {b}" for b in check_template(n, none_ok=none_ok)]
    return bad


def cmd_send_batch(args, provider_name):
    batch = load_batch(args.batch)
    plan, skipped = screen_batch(batch)
    # Taylor's `hold 4` / `only 1 3` after the batch, by its numbers (as in the kit lane)
    if args.only or args.hold:
        try:
            only = {int(i) for i in args.only or []}
            hold = {int(i) for i in args.hold or []}
        except ValueError:
            die("--only and --hold take the batch's numbers, e.g. --hold 4")
        kept = {i for i, _p, _f in plan if (not only or i in only) and i not in hold}
        skipped += [(i, p.get("name") or "?", "held back by Taylor") for i, p, _f in plan if i not in kept]
        plan = [x for x in plan if x[0] in kept]
    dealt = deal_variants(plan)
    test = ai_test()
    problems = batch_problems(none_ok=("none" not in dealt.values()) or ai_none_allowed())
    if test["open"] and plan:
        counts = {v: sum(1 for x in dealt.values() if x == v) for v in AI_VARIANTS}
        ai_line = "AI-line test open: " + ", ".join(f"{counts[v]} {v}" for v in AI_VARIANTS)
    else:
        ai_line = f"AI sentence: {ai_variant_outside_test()} for every letter (no AI-line test open)"
        if ai_kept_none():
            ai_line += f"\nNote: {AI_NONE_KEPT}."
    city = batch.get("city")
    where = "across the corridor" if not city or str(city).lower() == "any" else f"in {city}"
    say(f"Batch {batch['batch_id']} · {batch.get('category') or '?'} {where} · "
        f"{len(batch.get('picks') or [])} picks, {len(plan)} to write to · three touches each (day 0, 3, 10)"
        f"{' · DRY RUN' if DRY else ''}")
    say(ai_line)
    if DRY:
        tpl = load_template("batch-first")
        for i, p, faults in plan:
            seq = new_sequence(batch, p, faults, dealt[i])
            subject, letter = tpl.render(batch_values(seq, 0))
            say(f"\n{i}. {p.get('name')} <{p.get('email')}> — \"{subject}\" [AI sentence: {dealt[i]}]")
            say("".join(f"   | {l}\n" for l in letter.splitlines()), )
        for i, name, why in skipped:
            say(f"  {i}. {name} — skipped: {why}")
        say(f"\nDry run: {len(plan)} first letters rendered; nothing queued, nothing sent.")
        if problems:
            say("Before `go` can send: " + "; ".join(problems))
        return
    # Every batch waits on Taylor's `go`, OUTREACH_AUTO or not: each letter says "I approve each
    # batch" (his disclosure, answer 1), and that sentence has to stay true. AUTO is the kit lane's.
    if not args.go:
        say(f"\nWaiting on `go` for this batch — {len(plan)} businesses, each with the two facts its letter "
            "will carry:")
        for i, p, faults in plan:
            say(f"  {i}. {p.get('name')} <{p.get('email')}>")
            for f in faults:
                say(f"       - {f['sentence']}" + ("  (a fact in their favour)" if f["kind"] == "fact" else ""))
        for i, name, why in skipped:
            say(f"  {i}. {name} — skipped: {why}")
        if problems:
            say("Before `go` can send: " + "; ".join(problems))
        sys.exit(0)
    if problems:
        die("nothing queued — " + "; ".join(problems))
    if provider_name == "instantly":
        die("the batch lane sends through the google provider (or fake); Instantly's campaign path is the six-a-day "
            "kit lane only. Set OUTREACH_PROVIDER=google. Nothing queued.")
    provider = pick_provider(args.provider)
    with state_lock():
        blocked, _ = lane_blocked(provider)
        if blocked:
            sys.exit(1)
        seqs = seqs_load()
        for i, p, faults in plan:
            seqs.append(new_sequence(batch, p, faults, dealt[i], test["started"] if test["open"] else None))
        seqs_save(seqs)
        append_jsonl(state_dir("batches.jsonl"), {"ts": now_iso(), "batch_id": batch["batch_id"], "queued": len(plan),
                                                  "skipped": len(skipped), "approved": "go",
                                                  "variants": {v: sum(1 for i, _, _ in plan if dealt[i] == v)
                                                               for v in AI_VARIANTS},
                                                  "ai_test": test["started"] if test["open"] else None})
        say(f"Queued {len(plan)} businesses, three touches each; the tick sends them across working hours.")
        for i, name, why in skipped:
            say(f"  {i}. {name} — skipped: {why}")
        run_tick(provider)


def next_gap(t, remaining, rng, end):
    """The wait before a mailbox's next letter: the time left in the window shared over the
    letters left, drawn at random between about half and one and a half of that, never
    under the minimum. Irregular on purpose: a fixed interval reads as a machine."""
    if remaining <= 0:
        return end
    left = max((end - t).total_seconds() / 60, 0)
    base = left / (remaining + 0.5)
    gap = max(env_num("OUTREACH_MIN_GAP_MINUTES", DEFAULT_MIN_GAP), base * rng.uniform(0.55, 1.45))
    return t + dt.timedelta(minutes=gap)


def send_touch(provider, seq, mb):
    """One letter of one sequence from one mailbox. -> True when it left."""
    i, t = next_touch(seq)
    if t is None:
        return False
    tname, touch = t["template"], int(t["touch"])
    variant = seq.get("variant") or AI_DEFAULT
    if variant == "none" and not seq.get("ai_test") and not ai_none_allowed():
        # a `none` thread the test didn't deal (a hand edit, a stray state file): the rule holds
        seq.update(status="stopped", why=AI_NONE_REFUSAL)
        say(f"  REFUSED {seq.get('name')}: {AI_NONE_REFUSAL}")
        return False
    vals = batch_values(seq, touch)
    tpl = load_template(tname)
    subject, letter = tpl.render(vals)
    if claims_a_site(letter, seq.get("preview_url")):
        seq.update(status="stopped", why=f"{tname} says a site was built and none exists; fix the letter")
        say(f"  REFUSED {seq.get('name')}: {tname} says a site was built, and there is no preview for it")
        return False
    thread = None
    if touch > 0:
        ids = [x.get("message_id") for x in seq["touches"] if x.get("message_id")]
        thread = {"in_reply_to": ids[-1] if ids else None, "references": ids}
    pick = {"email": seq["email"], "name": seq.get("name"), "place_id": seq.get("place_id")}
    try:
        res = provider.send(pick, subject, letter, mailbox=mb, thread=thread) or {}
    except (Unreachable, ProviderError) as exc:
        say(f"  FAILED {seq.get('name')} from {mb}: {exc}")
        seq["failures"] = int(seq.get("failures") or 0) + 1
        return False
    mid = res.get("message_id") or res.get("id")
    t.update(sent_ts=now_iso(), message_id=mid, subject=subject, mailbox=mb)
    seq["mailbox"] = mb
    if next_touch(seq)[1] is None:
        seq["status"] = "done"
    row = {"ts": now_iso(), "date": today().isoformat(), "touch": touch, "template": tname,
           "place_id": seq.get("place_id"), "name": seq.get("name"), "first": seq.get("first") or "",
           "email": seq["email"], "subject": subject, "provider": provider.name, "provider_id": res.get("id"),
           "mailbox": mb, "message_id": mid, "thread_root": seq["touches"][0].get("message_id"),
           "batch_id": seq.get("batch_id"), "seq_id": seq.get("id")}
    row.update(outbound_of(seq, tpl.sha), ai_test=seq.get("ai_test"))
    if not DRY:
        append_jsonl(sends_file(), row)
    ledger_append({"ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()), "kind": "outreach_email",
                   "tool": "outreach", "calls": 1, "cost_usd": 0, "project": "global",
                   "billed_to": f"{provider.name}:{mb}",
                   "for": f"{tname} day{touch} -> {seq.get('name')} <{seq['email']}>"})
    say(f"  {now().strftime('%H:%M')} {mb} -> {seq.get('name')} <{seq['email']}> day {touch}: \"{subject}\"")
    leads_log(seq.get("name") or seq["email"], "messaged", f"email day {touch}: {subject}",
              place_id=seq.get("place_id"), email=seq["email"],
              tags={k: row[k] for k in OUTBOUND_FIELDS})
    return True


def outbound_of(seq, sha):
    """The five fields every batch send row carries (B132), so a reply can be cut by any of them."""
    return {"variant": seq.get("variant") or AI_DEFAULT, "fault_key": seq.get("fault_key") or "",
            "segment": seq.get("segment") or "", "letter_sha": sha, "prebuilt": bool(seq.get("prebuilt"))}


def cmd_tick(args):
    provider = pick_provider(args.provider)
    if not getattr(args, "until", None):
        with state_lock():
            code = run_tick(provider)
        sys.exit(code or 0)
    # A run of ticks in one process, for the tests: a working day of five-minute ticks as
    # separate processes took about twenty seconds, so a week of them made the suite crawl.
    # Only on the test clock: on the real one there is nothing to step through.
    if not os.environ.get("OUTREACH_NOW"):
        die("--until steps the test clock (OUTREACH_NOW) and means nothing without it; the timer runs plain `tick`")
    t = now()
    try:
        stop = dt.datetime.fromisoformat(args.until)
    except ValueError:
        die(f"--until is an ISO time like 2026-10-19T17:05, not {args.until!r}")
    stop = stop.replace(tzinfo=TZ) if stop.tzinfo is None else stop.astimezone(TZ)
    step = dt.timedelta(minutes=max(int(args.every or 5), 1))
    worst = 0
    while t <= stop:
        os.environ["OUTREACH_NOW"] = t.isoformat()
        with state_lock():
            worst = max(worst, run_tick(provider) or 0)
        t += step
    sys.exit(worst)


def run_tick(provider):
    """Send what is due now: at most one letter a mailbox, follow-ups before new first
    letters, each mailbox under today's cap, at irregular gaps inside working hours."""
    t = now()
    day = t.date()
    seqs = seqs_load()
    for s in seqs:                          # a hold ends on its day
        if s.get("status") == "held" and s.get("hold_until") and dt.date.fromisoformat(s["hold_until"]) <= day:
            s.update(status="active", hold_until=None)
    live = [s for s in seqs if s.get("status") == "active"]
    if not live:
        say("Nothing queued.")
        seqs_save(seqs)
        return 0
    blocked, _ = lane_blocked(provider)
    if blocked:
        return 1
    problems = batch_problems()
    if problems:
        say("Nothing sends: " + "; ".join(problems))
        return 1
    if not working_now(t):
        start, end = send_window(day)
        say(f"Outside the sending window ({start:%H:%M}–{end:%H:%M} weekdays); {len(live)} sequences wait.")
        seqs_save(seqs)
        return 0
    boxes, paused = mailboxes(), paused_boxes()
    if not boxes:
        say("No mailboxes (OUTREACH_MAILBOXES); nothing sends.")
        return 1
    cap = cap_on(day)
    if cap <= 0:
        rd = ramp_day(day)
        say(f"Each mailbox's cap today is 0 (OUTREACH_MAILBOX_PER_DAY"
            + (f", ramp day {rd}" if rd is not None else ", no warm-up start recorded") + "); nothing sends.")
        seqs_save(seqs)
        return 0
    _, end = send_window(day)
    ticks = read_json(state_dir("tick.json"), {})
    k = (t.hour * 60 + t.minute) // 5
    order = boxes[k % len(boxes):] + boxes[:k % len(boxes)]
    sent = 0
    for mb in order:
        if mb in paused:
            continue
        used = sends_on(mb, day)
        if used >= cap:
            continue
        st = ticks.get(mb) or {}
        if st.get("date") != day.isoformat():
            r0 = random.Random(f"{mb}|{day.isoformat()}")
            start, _ = send_window(day)
            st = {"date": day.isoformat(), "next_at": (start + dt.timedelta(minutes=r0.uniform(0, 40))).isoformat()}
        if t < dt.datetime.fromisoformat(st["next_at"]):
            ticks[mb] = st
            continue
        follow = []
        for s in seqs:
            if s.get("status") != "active" or s.get("mailbox") != mb:
                continue
            _, nt = next_touch(s)
            due = touch_due(s, nt) if nt else None
            if nt and int(nt["touch"]) > 0 and due and due <= day:
                follow.append((due, s))
        follow.sort(key=lambda x: x[0])
        fresh = [s for s in seqs if s.get("status") == "active" and not s.get("mailbox")
                 and next_touch(s)[1] is not None and int(next_touch(s)[1]["touch"]) == 0
                 and touch_due(s, next_touch(s)[1]) <= day]
        chosen = follow[0][1] if follow else None
        while chosen is None and fresh:
            s = fresh.pop(0)
            gate = first_send_gate(s)
            if gate[0] == "send":
                chosen = s
            elif gate[0] == "hold":
                s.update(status="held", hold_until=gate[1].isoformat(), why=gate[2])
            else:
                s.update(status="stopped", why=gate[1])
                suppress_add(s["email"], f"not sent: {gate[1]}")
        if chosen is None:
            ticks[mb] = st
            continue
        if send_touch(provider, chosen, mb):
            sent += 1
            used += 1
        others = sum(1 for b in boxes if b not in paused) or 1
        remaining = min(cap - used, max(len(follow) - 1, 0) + -(-len(fresh) // others))
        rng = random.Random(f"{mb}|{t.isoformat()}")
        st["next_at"] = next_gap(t, remaining, rng, end).isoformat()
        ticks[mb] = st
    seqs_save(seqs)
    write_json(state_dir("tick.json"), ticks)
    waiting = sum(1 for s in seqs if s.get("status") == "active")
    say(f"Tick {t:%Y-%m-%d %H:%M}: {sent} sent; {waiting} sequences still running"
        f"{' · DRY RUN' if DRY else ''}.")
    return 0


# ---- inbox ----------------------------------------------------------------------

def preview_for(place_id):
    """`leads preview --place ID --json` (wick, B90) -> (url, why-not)."""
    ok, out = run_tool([tool_path("leads"), "preview", "--place", place_id, "--json"], f"leads preview {place_id}")
    if DRY:
        return None, "a dry run builds nothing"
    if not ok:
        return None, "`leads preview --place` failed or isn't there yet"
    try:
        data = json.loads(out)
    except json.JSONDecodeError:
        return None, "`leads preview --place --json` didn't print JSON"
    if not isinstance(data, dict) or data.get("ok") is False:
        return None, "`leads preview` said it couldn't build one"
    url = data.get("url")
    return (url, None) if url else (None, "`leads preview` returned no URL")


def answer_yes(provider, r, row, name, pid, email, first, first200, room):
    """A plain yes to the batch letter's offer: build the preview and answer with its address
    (plan 37 § 4). Anything that stops that hands the reply to Taylor as interested, which
    is what happened before there was a yes path. -> True when the machine answered."""
    def hand_over(why):
        notify(f"{name} said yes to the preview, and it couldn't go back automatically ({why}): {first200} — "
               f"`leads brief {name}` before you answer{offer_build(row, pid)}")
        log_interested(name, f"said yes to the preview: {first200[:120]}", place_id=pid, email=email,
                  next_when="tomorrow")
        say(f"  handed to Taylor: {why}")
        return False

    seq = seq_for(email, r.get("our_message_id"))
    if not pid or seq is None:
        return hand_over("it isn't a batch letter's thread")
    bad = approval_problems(["answer-yes"])
    if bad:
        return hand_over("; ".join(bad))
    if answered_thread_today(r.get("thread_id")):
        return hand_over("this thread already had a machine reply today")
    if room <= 0:
        return hand_over("the day's machine-reply cap is spent")
    url, why = preview_for(pid)
    if not url:
        return hand_over(why)
    with state_lock():
        seqs = seqs_load()
        s = seq_for(email, r.get("our_message_id"), seqs)
        if s is not None:
            s["preview_url"] = url
            seqs_save(seqs)
            seq = s
    link = see_url(seq)
    if not link:
        # The answer's link lives on the sending domain, never the preview host: a link
        # from the cold lane would tie the product site's standing to it (plan 37 § 3). Until
        # OUTREACH_LINK_BASE is set (the see page, B91), Taylor sends this one himself.
        return hand_over(f"there's no link on the sending domain yet (OUTREACH_LINK_BASE); the preview is "
                         f"built at {url} for you to send")
    vals = values_for({"name": name, "first": first, "faults": []}, 0)
    vals["preview_url"] = link
    # B132: a `none` thread's cold letters said nothing about AI, so this first answer says it
    vals.update(ai_values(seq.get("variant") or AI_DEFAULT))
    subject, letter = load_template("answer-yes").render(vals)
    theirs = (r.get("subject") or "").strip()
    if theirs:
        subject = theirs if theirs.lower().startswith("re:") else f"Re: {theirs}"
    say(f"  answering with the preview: \"{subject}\" ({link})")
    try:
        provider.reply_to(r, subject, letter)
    except (Unreachable, ProviderError) as exc:
        return hand_over(f"the reply didn't go: {exc}")
    row.update(answered=True, answer_template="answer-yes", preview_url=url,
               answer_ai=AI_NONE_ANSWER if seq.get("variant") == "none" else None)
    notify(f"{name} said yes; their preview went back: {url}. `leads brief {name}` before a call"
           f"{offer_build(row, pid)}")
    log_interested(name, f"said yes; preview sent: {url}", place_id=pid, email=email, next_when="tomorrow")
    return True


# ---- the build word (B92, plan 37 § 4) -----------------------------------------------
# The message to Taylor about an interested reply (or a yes) ends with BUILD_LINE, and the reply row
# remembers it offered. His "build" reaches this tool through Patch, which runs `outreach build` on
# his word, as `go` becomes `outreach send --go`. Only that command starts `prep one`: the inbox pass,
# the tick and the classifier never do, and a lead writing the word "build" is just a reply.

BUILD_LINE = "reply `build` and the full site is ready before you call"
BUILD_OFFER_DAYS = 14


def offer_build(row, pid):
    """The tail of Taylor's message when one word from him can start the researched site: only for a
    business we can name by its census place id. Marks the reply row so `outreach build` can find it."""
    if not pid:
        return "."
    row["build_offered"] = True
    return f" — {BUILD_LINE}."


def builds_file():
    return state_dir("builds.jsonl")


def build_offers():
    """The replies whose message to Taylor offered `build` in the last BUILD_OFFER_DAYS, newest first,
    one a place."""
    cutoff = (today() - dt.timedelta(days=BUILD_OFFER_DAYS)).isoformat()
    seen, out = set(), []
    for r in reversed(read_jsonl(replies_file())):
        pid = r.get("place_id")
        if r.get("build_offered") and pid and (r.get("date") or "") >= cutoff and pid not in seen:
            seen.add(pid)
            out.append(r)
    return out


def build_target(who):
    """(reply row, None) for the business Taylor means, or (None, a line saying why not / which one)."""
    started = {b.get("place_id") for b in read_jsonl(builds_file()) if b.get("ok")}
    offers = build_offers()
    if not who:
        waiting = [r for r in offers if r["place_id"] not in started]
        if len(waiting) == 1:
            return waiting[0], None
        if not waiting:
            return None, (f"Nothing is waiting on `build`: no interested reply in the last {BUILD_OFFER_DAYS} days "
                          f"that hasn't been started. `outreach build NAME` names one.")
        lines = [f"{len(waiting)} replies are waiting on `build`; which one?"]
        lines += [f"  {r.get('name')} ({r.get('date')}): {(r.get('text') or '')[:80]}" for r in waiting]
        lines.append("Say `build NAME` for the one you mean.")
        return None, "\n".join(lines)
    low = who.lower()
    rows = [r for r in reversed(read_jsonl(replies_file())) if r.get("place_id")]
    hits = ([r for r in rows if r["place_id"] == who]
            or [r for r in offers if low in str(r.get("name") or "").lower()]
            or [r for r in rows if low in str(r.get("name") or "").lower()])
    places = list(dict.fromkeys(r["place_id"] for r in hits))
    if not places:
        return None, (f"No reply from a business matching \"{who}\". `outreach build` alone takes the one the "
                      f"last message was about; `prep one PLACE_ID` builds any business in the census.")
    if len(places) > 1:
        names = sorted({str(r.get("name")) for r in hits})
        return None, f"\"{who}\" matches {len(places)} businesses ({', '.join(names)}); say a longer name."
    return hits[0], None


def cmd_build(args):
    """Taylor's word: `prep one` for the business an interested reply was about, detached. The outline
    comes by notify when it finishes (an hour or two); this answers at once with what started."""
    target, why = build_target(" ".join(args.who or []).strip())
    if not target:
        say(why)
        sys.exit(1)
    pid, name = target["place_id"], target.get("name") or target["place_id"]
    cmd = [tool_path("prep"), "one", pid, "--why", f"outreach build: {name} replied {target.get('date') or ''}".strip()]
    if DRY:
        cmd.append("--dry-run")                          # prep's own dry run: it says what it would spend
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
        code, out = r.returncode, ((r.stdout or "") + (r.stderr or "")).strip()
    except (OSError, subprocess.TimeoutExpired) as exc:
        code, out = 1, f"`prep one {pid}` couldn't run: {exc}"
    say(out or f"`prep one {pid}` exited {code} and said nothing")
    if not DRY:
        append_jsonl(builds_file(), {"ts": now_iso(), "place_id": pid, "name": name, "ok": code == 0,
                                     "reply_ts": target.get("ts"), "said": out[-400:]})
    sys.exit(code)


def cmd_pressed(args):
    """B91 (plan 41): someone pressed the link in their letter. Called by `leads preview --from-press` on a
    business's first press. Their remaining touches stop the way an interested reply stops them (they have
    seen the site; day 10's "still one press away" would be wrong, and from here it is Taylor's
    conversation), and a `pressed` row lands in replies.jsonl so `outreach build` finds it like an
    interested reply and a later yes logs no second `interested` line. Prints one JSON object; `build_tail`
    is the line Taylor's message ends with when the place is known."""
    pid = args.place
    with state_lock():
        seq = next((q for q in seqs_load() if q.get("place_id") == pid), None)
    email, name = (seq or {}).get("email"), (seq or {}).get("name") or args.name or pid
    left = 0 if DRY or not seq else stop_sequence(email, why="pressed the link")
    row = {"ts": now_iso(), "date": today().isoformat(), "name": name, "place_id": pid, "email": email,
           "class": "pressed", "answered": False, "text": "pressed the link in the letter",
           "url": args.url or None, "batch_id": (seq or {}).get("batch_id")}
    tail = offer_build(row, pid)
    again = pressed_already(pid)
    if not DRY and not again:
        append_jsonl(replies_file(), row)
    print(json.dumps({"ok": True, "place_id": pid, "stopped": left, "already": again,
                      "build_tail": tail if tail != "." else ""}))


def answer_for(topic):
    return {"price": "answer-price", "how": "answer-how"}.get(topic)


def thread_fields(r):
    """B105: what `outreach reply` needs to answer in the thread later — their subject, their
    Message-ID and References, and the letter of ours they answered. Added fields; none renamed."""
    return {"subject": r.get("subject") or "", "their_message_id": r.get("message_id"),
            "references": [x for x in (r.get("references") or []) if x], "our_message_id": r.get("our_message_id"),
            "mail_ts": r.get("ts")}


def cmd_inbox(args):
    provider = pick_provider(args.provider)
    cap = int(env_num("OUTREACH_MAX_REPLIES_PER_DAY", DEFAULT_MAX_REPLIES, int))
    room = cap - len(machine_replies_today())
    cur = cursor_read()
    try:
        replies, new_cur = provider.replies(cur)
    except (Unreachable, ProviderError) as exc:
        die(f"couldn't read the replies: {exc}")
    say(f"{len(replies)} new repl{'y' if len(replies) == 1 else 'ies'} on {provider.name}"
        f" · {room} of {cap} machine replies left today{' · DRY RUN' if DRY else ''}")
    if args.limit:
        replies = replies[: int(args.limit)]
    for r in replies:
        if r.get("matched_by") == "probe":
            first200 = " ".join(quoted_off(r.get("text") or "").split())[:200]
            say(f"\nprobe reply from {r.get('from')} to {r.get('mailbox')}: {first200}")
            if not DRY:
                notify(f"Probe reply from {r.get('from')} (to {r.get('mailbox')}): {first200}")
                append_jsonl(replies_file(), {"ts": now_iso(), "date": today().isoformat(), "email_id": r.get("id"),
                                              "thread_id": r.get("thread_id"), "from": r.get("from"), "name": "probe",
                                              "place_id": None, "class": "probe", "ai": False, "answered": False,
                                              "text": first200, "email": r.get("from"), "mailbox": r.get("mailbox"),
                                              **thread_fields(r)})
            continue
        name, pid, email, first = who_replied(r)
        got = classify(r)
        if got["class"] == "yes" and seq_for(email, r.get("our_message_id")) is None:
            # A yes outside a batch letter's thread (the kit lane already sent a preview): Taylor's.
            got.update({"class": "interested", "why": (got.get("why") or "") + "; not a batch thread"})
        cls, why = got["class"], got.get("why") or ""
        first200 = " ".join(quoted_off(r.get("text") or "").split())[:200]
        say(f"\n{name} <{r.get('from')}> — {cls}{'' if got.get('ai') else ' (by rule)'}{': ' + why if why else ''}")
        row = {"ts": now_iso(), "date": today().isoformat(), "email_id": r.get("id"),
               "thread_id": r.get("thread_id"), "from": r.get("from"), "name": name, "place_id": pid,
               "class": cls, "topic": got.get("topic"), "when": got.get("when"), "ai": bool(got.get("ai")),
               "answered": False, "text": first200, "email": email, **thread_fields(r)}
        sent_row = send_row_for(r) or {}
        mb = str(r.get("mailbox") or sent_row.get("mailbox") or "").lower() or None
        row["mailbox"], row["batch_id"] = mb, sent_row.get("batch_id")
        # B132: the letter's variant, fault key, segment, sha and prebuilt flag, so replies cut by them
        row.update({k: sent_row[k] for k in OUTBOUND_FIELDS if k in sent_row})
        if cls not in ("out of office",):
            # Any answer from a person ends that business's remaining touches (a bounce too).
            left = stop_sequence(email, r.get("our_message_id") or sent_row.get("message_id"),
                                 why="bounced" if cls == "bounce" else f"replied ({cls})")
            if left:
                say(f"  the sequence stopped: {left} touch(es) won't go")
        if cls == "bounce" and not DRY:
            append_jsonl(bounces_file(), {"ts": now_iso(), "email": email, "mailbox": mb,
                                          "batch_id": sent_row.get("batch_id"), "reply_id": r.get("id")})

        if cls == "angry":
            # As a no, and the mailbox that wrote to them pauses until Taylor says (answer 2).
            suppress_add(email, "angry reply", provider)
            if pid:
                suppress_add(pid, "angry reply", provider)
            paused_now = bool(mb) and (DRY or pause_box(mb, f"angry reply from {email}"))
            notify(f"Angry reply from {name} <{r.get('from')}>: {first200}"
                   + (f" — {mb} is paused; `outreach resume {mb}` when you're ready." if paused_now else ""))
            leads_log(name, "lost", "replied angry to the email", place_id=pid, email=email, next_when="none")
            say(f"  suppressed; {'mailbox ' + mb + ' paused; ' if paused_now else ''}Taylor told; no reply sent")
        elif cls == "yes" and answer_yes(provider, r, row, name, pid, email, first, first200, room):
            room -= 1
        elif cls == "no":
            # Before anything else, and before any reply: the address and the place both go.
            if suppress_add(email, "replied no thanks", provider):
                say("  suppressed: the address is off the list for good")
            if pid and suppress_add(pid, "replied no thanks", provider):
                say(f"  suppressed: the place {pid} too, so no kit picks it up again")
            leads_log(name, "lost", "replied no thanks to the email", place_id=pid, email=email, next_when="none")
            say("  no reply sent, by policy")
        elif cls == "bounce":
            # The daemon's own address is worthless; suppress the recipient it names.
            if suppress_add(email, "bounced", provider):
                say(f"  suppressed: {email} bounced")
            else:
                say(f"  {email} was already suppressed")
            say("  no reply sent; not a conversation, so nothing goes in the pipeline")
        elif cls == "out of office":
            say("  noted; nothing sent and nothing logged")
        elif cls == "question" and answer_for(got.get("topic")):
            tname = answer_for(got["topic"])
            bad = approval_problems([tname])
            if bad:
                say(f"  NOT answered: {'; '.join(bad)} — handing it to Taylor instead")
                notify(f"{name} asked about {got['topic']} and {tname} isn't approved: {first200}")
                leads_log(name, "talked", f"asked: {first200[:120]}", place_id=pid, email=email)
            elif answered_thread_today(r.get("thread_id")):
                say("  already answered this thread today; one machine reply a thread a day, so it waits")
            elif room <= 0:
                say(f"  the day's reply cap ({cap}) is spent; it waits for tomorrow")
            else:
                t = load_template(tname)
                subject, letter = t.render(values_for({"name": name, "first": first, "faults": []}, 0), fault="")
                theirs = (r.get("subject") or "").strip()
                if theirs:
                    subject = theirs if theirs.lower().startswith("re:") else f"Re: {theirs}"
                say(f"  answering: \"{subject}\"")
                if DRY:
                    say("".join(f"   | {l}\n" for l in letter.splitlines()))
                try:
                    provider.reply_to(r, subject, letter)
                    row["answered"], row["answer_template"] = True, tname
                    room -= 1
                except (Unreachable, ProviderError) as exc:
                    say(f"  the reply didn't go ({exc}); handing it to Taylor")
                    notify(f"{name} asked about {got['topic']} and the reply failed: {first200}")
                leads_log(name, "talked", f"asked: {first200[:120]}", place_id=pid, email=email)
        elif cls == "yes":
            pass                                # answer_yes handed it to Taylor and said why
        else:
            # interested, a named time, a question we won't answer, unsure, anything unclear: Taylor's.
            when = got.get("when")
            book = toolbelt("LEADS_BOOKING_URL") or "the booking link (LEADS_BOOKING_URL isn't set)"
            tail = f"reply yes to book {when}" if when else f"reply yes to send the booking link ({book})"
            # an "unsure" carries the classifier's reason to Taylor, as its prompt promises
            because = f" (the classifier was unsure: {why})" if cls == "unsure" and why else ""
            quiet = (" (AI-line test: this thread's letters carried no AI sentence, so the first answer "
                     "should say Patch drafted them)") if row.get("variant") == "none" else ""
            notify(f"{name} replied: {first200}{because}{quiet} — leads brief pending; {tail}"
                   + (offer_build(row, pid) if cls == "interested" else "."))
            log_interested(name, f"replied to the email: {first200[:120]}",
                      place_id=pid, email=email, next_when="tomorrow")
            say(f"  handed to Taylor: {tail}")
            say("  no machine reply — interested, a time, or unclear is never answered by the machine")

        if not DRY:
            append_jsonl(replies_file(), row)
    cursor_write(new_cur)
    if not replies:
        say("Nothing new. The cursor is where it was.")


# ---- the campaign inbox (B105) ----------------------------------------------------
# One window on the three mailboxes: `outreach inbox` already reads them all, keeps only what
# answers a letter (warm-up mail never gets here) and logs each reply in replies.jsonl. These two
# commands read that log and let Taylor answer in his own words. Mail is not forwarded to one box:
# the warm-up pool writes twenty to forty mails a day into each, and a forward loses the identity
# the thread was written from.

# Classes nobody needs to answer: a no and an unsubscribe were suppressed, a bounce has nobody to
# read it, an out-of-office isn't a person, a probe was Taylor testing the mailboxes.
CLOSED_CLASSES = ("no", "unsubscribe", "angry", "bounce", "out of office", "probe")
REPLIES_DAYS = 14


def thread_key(r):
    return r.get("thread_id") or str(r.get("email") or r.get("from") or "").lower() or r.get("email_id")


def answered_by(r):
    if r.get("answered_by") == "taylor":
        return "taylor"
    return "machine" if r.get("answered") else None


def is_open(r):
    """Waits on Taylor: a person wrote, nobody has answered, and it isn't a class with nothing to say."""
    return not r.get("answered") and r.get("class") not in CLOSED_CLASSES


def letter_for(r):
    """The letter this reply answered, as a short phrase: batch, touch and date (or the probe)."""
    if r.get("class") == "probe":
        pr = next((p for p in read_jsonl(probes_file())
                   if p.get("message_id") and p.get("message_id") == r.get("our_message_id")), None)
        pr = pr or next((p for p in read_jsonl(probes_file()) if str(p.get("mailbox") or "").lower()
                         == str(r.get("mailbox") or "").lower()), None)
        return f"probe {pr.get('date')}" if pr else "probe"
    sends = [x for x in read_jsonl(sends_file()) if x.get("how") != TAYLOR_REPLY]
    row = None
    mid = r.get("our_message_id")
    if mid:
        row = next((x for x in sends if x.get("message_id") == mid), None)
    if row is None and r.get("thread_id"):
        row = next((x for x in sends if x.get("thread_root") == r["thread_id"] or x.get("message_id") == r["thread_id"]), None)
    if row is None:
        e = str(r.get("email") or "").lower()
        row = next((x for x in reversed(sends) if e and str(x.get("email") or "").lower() == e), None)
    if row is None:
        return "no letter on record"
    what = f"batch {row['batch_id']}" if row.get("batch_id") else (row.get("template") or "kit letter")
    return f"{what}, touch {int(row.get('touch') or 0)}, sent {row.get('date')}"


def reply_threads(rows=None):
    """One entry a thread, newest first: the newest reply in it decides its state."""
    rows = read_jsonl(replies_file()) if rows is None else rows
    by = {}
    for r in rows:
        k = thread_key(r)
        if k is None:
            continue
        t = by.setdefault(k, {"key": k, "rows": []})
        t["rows"].append(r)
    out = []
    for t in by.values():
        t["rows"].sort(key=lambda x: str(x.get("ts") or ""))
        t["last"] = t["rows"][-1]
        out.append(t)
    out.sort(key=lambda t: str(t["last"].get("ts") or ""), reverse=True)
    return out


def thread_matches(t, needle):
    n = needle.strip().lower()
    last = t["last"]
    return any(n in str(last.get(f) or "").lower() for f in ("name", "email", "from"))


def thread_view(t):
    r = t["last"]
    who = answered_by(r)
    state = ("answered by Taylor" if who == "taylor" else "answered by the machine" if who == "machine"
             else "waiting on you" if is_open(r) else "nothing to answer")
    return {"name": r.get("name"), "from": r.get("from"), "email": r.get("email"), "mailbox": r.get("mailbox"),
            "letter": letter_for(r), "date": r.get("date"), "ts": r.get("ts"), "class": r.get("class"),
            "text": r.get("text") or "", "state": state, "open": is_open(r), "replies": len(t["rows"]),
            "thread_id": r.get("thread_id"), "email_id": r.get("email_id"), "place_id": r.get("place_id")}


def cmd_replies(args):
    threads = reply_threads()
    since = None
    if args.today:
        since = today().isoformat()
    elif args.since:
        try:
            since = dt.date.fromisoformat(args.since).isoformat()
        except ValueError:
            die(f"--since wants a date like 2026-10-14, not {args.since!r}")
    elif not args.count:
        since = (today() - dt.timedelta(days=REPLIES_DAYS)).isoformat()
    if since:
        threads = [t for t in threads if str(t["last"].get("date") or "") >= since]
    if args.open or args.count:
        threads = [t for t in threads if is_open(t["last"])]
    if args.name:
        threads = [t for t in threads if thread_matches(t, " ".join(args.name))]
    if args.count:
        print(len(threads))
        return
    views = [thread_view(t) for t in threads]
    if args.json:
        print(json.dumps(views, indent=1))
        return
    scope = ("open " if args.open else "") + ("today" if args.today else f"since {since}" if since else "")
    if not views:
        say(f"No replies {scope.strip() or 'on record'}." if not args.open else
            f"Nothing waiting on you ({'today' if args.today else f'since {since}'}).")
        return
    say(f"{len(views)} thread{'' if len(views) == 1 else 's'}{' waiting on you' if args.open else ''}, newest first")
    for v in views:
        name = v["name"] or v["email"] or v["from"]
        more = f" · {v['replies']} replies" if v["replies"] > 1 else ""
        say(f"\n{name} <{v['from']}> · {v['mailbox'] or 'mailbox unknown'} · {v['date']}{more}")
        say(f"  letter: {v['letter']}")
        say(f"  \"{v['text']}\"" if v["text"] else "  (no text)")
        say(f"  {v['class']} · {v['state']}")
    if any(v["open"] for v in views):
        say("\nTo answer one: outreach reply NAME \"your words\" (by text: reply NAME: your words).")


def signature():
    """Taylor's sign-off on his own answers: name, phone if set, and the postal address, which the
    law wants on commercial mail; a reply in a sales thread is commercial mail."""
    lines = [toolbelt("OUTREACH_FROM_NAME", V.sender.from_name)]
    phone = toolbelt(V.sender.phone_env)
    if phone:
        lines.append(phone)
    lines.append(toolbelt(V.sender.postal_address_env))
    return "\n".join(lines)


def mark_taylor_answered(email_id, thread_id, ts):
    """Rewrite replies.jsonl with that row marked answered by Taylor (added fields, none renamed).
    Under the state lock, and read again right before the swap, so an inbox pass's append isn't lost."""
    if DRY:
        return
    p = replies_file()
    with state_lock():
        lines = p.read_text().splitlines() if p.exists() else []
        out = []
        for line in lines:
            try:
                r = json.loads(line)
            except json.JSONDecodeError:
                out.append(line)
                continue
            if r.get("email_id") == email_id and r.get("thread_id") == thread_id:
                r.update(answered=True, answered_by="taylor", answered_ts=ts)
                line = json.dumps(r)
            out.append(line)
        tmp = p.with_suffix(".jsonl.tmp")
        tmp.write_text("".join(l + "\n" for l in out))
        os.replace(tmp, p)


def cmd_reply(args):
    """Taylor's own words, in the thread, from the mailbox that owns it. No template, no AI."""
    needle = (args.name or "").strip()
    text = (args.text or "").strip()
    if not needle or not text:
        die('usage: outreach reply NAME "your words"')
    if not toolbelt(V.sender.postal_address_env):
        die(f"{V.sender.postal_address_env} isn't set, and a reply in a sales thread must carry the postal address; "
            "nothing sent (see `outreach doctor`)")
    threads = reply_threads()
    pool = threads if args.any else [t for t in threads if is_open(t["last"])]
    hits = [t for t in pool if thread_matches(t, needle)]
    exact = [t for t in hits if str(t["last"].get("name") or "").lower() == needle.lower()]
    if len(exact) == 1:
        hits = exact
    if not hits:
        closed = [t for t in threads if thread_matches(t, needle)] if not args.any else []
        if closed:
            v = thread_view(closed[0])
            die(f"{v['name'] or v['from']}'s thread isn't waiting on you ({v['class']}, {v['state']}); "
                f"add --any to answer it anyway. Nothing sent.")
        die(f"no open thread matches {needle!r}; `outreach replies --open` lists them. Nothing sent.")
    if len(hits) > 1:
        say(f"{len(hits)} threads match {needle!r}, so nothing was sent. Say which:")
        for t in hits:
            v = thread_view(t)
            say(f"  {v['name']} <{v['from']}> · {v['mailbox']} · {v['date']} · \"{v['text'][:80]}\"")
        sys.exit(2)
    r = hits[0]["last"]
    to = str(r.get("from") or "").strip()
    if "@" not in to:
        die(f"the reply from {r.get('name')} has no address to answer ({to!r}); nothing sent")
    # Never to a suppressed or bounced address: a no, an angry reply and a bounce put it on the list,
    # and writing again after "no thanks" is the one thing the opt-out promises we won't do.
    supp = suppressed()
    for addr in dict.fromkeys(a for a in (to.lower(), str(r.get("email") or "").lower()) if a):
        if is_suppressed(email=addr, place_id=r.get("place_id") if addr == to.lower() else None, supp=supp):
            why = next((x.get("reason") for x in reversed(read_jsonl(suppress_file()))
                        if str(x.get("value") or "").lower() in (addr, mail.domain_of(addr), str(r.get("place_id") or "").lower())), None)
            die(f"{addr} is suppressed ({why or 'on the list'}), so nothing goes to it; nothing sent")
        if any(str(b.get("email") or "").lower() == addr for b in read_jsonl(bounces_file())):
            die(f"{addr} bounced a letter before, so a reply wouldn't arrive; nothing sent")
    mb = str(r.get("mailbox") or "").lower()
    if not mb:
        die(f"the reply from {r.get('name')} has no mailbox on record, so I can't tell which one owns the thread; nothing sent")
    theirs = (r.get("subject") or "").strip()
    if not theirs:
        sent = next((x for x in read_jsonl(sends_file()) if x.get("message_id") in (r.get("our_message_id"), r.get("thread_id"))), {})
        theirs = sent.get("subject") or ""
    subject = theirs if theirs.lower().startswith("re:") else (f"Re: {theirs}" if theirs else "Re: your note")
    body = f"{text}\n\n{signature()}\n"
    # In-Reply-To: their own Message-ID; a row logged before B105 has none, so it points at our letter
    # instead, which keeps the thread together in their mail client just as well.
    in_reply = r.get("their_message_id") or r.get("our_message_id") or r.get("thread_id")
    refs = [x for x in (r.get("references") or []) if x]
    if not refs and r.get("thread_id"):
        refs = [r["thread_id"]]
    reply = {"from": to, "mailbox": mb, "message_id": in_reply, "references": refs, "id": r.get("email_id")}
    provider = pick_provider(args.provider)
    say(f"{'[dry-run] ' if DRY else ''}{mb} -> {r.get('name')} <{to}>: \"{subject}\"")
    say("".join(f"   | {l}\n" for l in body.splitlines()).rstrip("\n"))
    try:
        res = provider.reply_to(reply, subject, body) or {}
    except (Unreachable, ProviderError) as exc:
        die(f"the reply didn't go ({exc}); nothing is marked, so you can try again")
    if DRY:
        say("dry run: nothing sent, nothing marked")
        return
    ts = now_iso()
    mark_taylor_answered(r.get("email_id"), r.get("thread_id"), ts)
    if r.get("class") != "probe":
        orig = send_row_for({"our_message_id": r.get("our_message_id"), "from": to}) or {}
        append_jsonl(sends_file(), {
            "ts": ts, "date": today().isoformat(), "how": TAYLOR_REPLY, "template": None,
            "place_id": r.get("place_id") or orig.get("place_id"), "name": r.get("name") or orig.get("name"),
            "first": orig.get("first") or "", "email": to, "subject": subject, "provider": provider.name,
            "provider_id": res.get("id"), "mailbox": mb, "message_id": res.get("message_id") or res.get("id"),
            "thread_root": r.get("thread_id") or orig.get("thread_root"), "batch_id": r.get("batch_id") or orig.get("batch_id"),
            "seq_id": orig.get("seq_id"), "in_reply_to": in_reply})
        # The sequence stopped when they wrote; this keeps it stopped (a no-op unless the only
        # reply was an out-of-office, and after Taylor writes, no cold touch should follow him).
        left = stop_sequence(r.get("email"), r.get("our_message_id"), why="Taylor replied")
        if left:
            say(f"  the sequence stopped: {left} touch(es) won't go")
        leads_log(r.get("name") or to, "talked", f"Taylor replied by email: {text[:120]}",
                  place_id=r.get("place_id"), email=r.get("email"))
    say(f"sent from {mb}, in the thread; marked answered by Taylor")


# ---- the small commands ---------------------------------------------------------

def cmd_suppress(args):
    provider = pick_provider(args.provider) if args.action == "add" else None
    if args.action == "ls":
        rows = read_jsonl(suppress_file())
        if getattr(args, "json", False):
            # the seam `leads batch` reads (plan 37 § Contract): addresses and domains, places too
            out, seen = [], set()
            for r in rows:
                v = str(r.get("value") or "").strip()
                if v and v.lower() not in seen:
                    seen.add(v.lower())
                    k = suppress_kind(v)
                    out.append({"value": v.lower() if k != "place" else v,
                                "kind": {"email": "address", "domain": "domain"}.get(k, "place_id")})
            print(json.dumps(out))
            return
        if not rows:
            say("Nobody is suppressed yet.")
            return
        say(f"{len(rows)} suppressed:")
        for r in rows:
            say(f"  {r.get('value')}  ({r.get('kind')}, {r.get('reason') or 'no reason given'}, "
                f"{str(r.get('ts'))[:10]})")
        return
    if not args.value:
        die("say what: outreach suppress add hello@x.example | ChIJ…")
    for v in args.value:
        added = suppress_add(v, args.reason or "by hand", provider)
        say(f"{'suppressed' if added else 'already suppressed'}: {v}")


BY_CUTS = {"variant": "variant", "fault": "fault_key", "segment": "segment", "letter": "letter_sha",
           "prebuilt": "prebuilt"}


def pipeline_file():
    return Path(toolbelt("LEADS_PIPELINE") or PROJECTS / "private-docs/leads/pipeline.jsonl")


def cut_label(by, row):
    v = row.get(BY_CUTS[by])
    if by == "prebuilt":
        return "(not recorded)" if v is None else ("prebuilt" if v else "not prebuilt")
    if v in (None, ""):
        return "(not recorded)"
    return str(v)[:12] if by == "letter" else str(v)


def cut_numbers(by):
    """{group: {delivered, clicks, replies, positive, customers}} for the batch lane, one business once.
    Delivered is a first letter sent and not bounced; a click is a press on its link (B91); a reply is any
    class but bounce, out of office, probe; positive is yes, interested or a question; a customer is a
    `won` line in the pipeline for that place. `--by variant` counts the AI-line test's own businesses
    when a test was ever started, since letters before it carried no variant."""
    test = ai_test()
    firsts = {}
    for r in cold_sends():
        if not r.get("batch_id") or int(r.get("touch") or 0) != 0:
            continue
        if by == "variant" and test["started"] and r.get("ai_test") != test["started"]:
            continue
        key = r.get("place_id") or str(r.get("email") or "").lower()
        firsts.setdefault(key, r)
    reps = read_jsonl(replies_file())
    def mine(r, row):
        return bool((row.get("place_id") and r.get("place_id") == row.get("place_id"))
                    or (row.get("email") and str(r.get("email") or "").lower() == str(row["email"]).lower()))
    won = {e.get("place_id") for e in read_jsonl(pipeline_file()) if e.get("outcome") == "won" and e.get("place_id")}
    out = {}
    for row in firsts.values():
        g = out.setdefault(cut_label(by, row), {"delivered": 0, "clicks": 0, "replies": 0, "positive": 0,
                                                "customers": 0})
        theirs = [r for r in reps if mine(r, row)]
        if any(r.get("class") == "bounce" for r in theirs):
            continue
        g["delivered"] += 1
        g["clicks"] += any(r.get("class") == "pressed" for r in theirs)
        g["replies"] += any(r.get("class") not in NOT_A_REPLY for r in theirs)
        g["positive"] += any(r.get("class") in POSITIVE_CLASSES for r in theirs)
        g["customers"] += bool(row.get("place_id") and row["place_id"] in won)
    return out


def per_hundred(n, d):
    return f"{n} ({100.0 * n / d:.1f})" if d else f"{n} (–)"


def cut_report(by):
    """`outreach status --by variant|fault|segment|letter|prebuilt`: the five counts a group, each also per
    hundred delivered, and a plain word on whether the numbers can decide anything. It reports; it never
    stops the test (that is Taylor's word)."""
    test = ai_test()
    groups = cut_numbers(by)
    say(ai_test_line(test))
    scope = ("the businesses the AI-line test dealt" if by == "variant" and test["started"]
             else "every business the batch lane wrote to")
    say(f"By {by} — {scope}; one business counts once; (per 100 delivered)")
    if not groups:
        say("  nothing delivered yet, so nothing to compare")
        return
    order = [v for v in AI_VARIANTS if v in groups] if by == "variant" else []
    order += sorted(g for g in groups if g not in order)
    w = max(len(by), *(len(g) for g in order))
    say(f"  {by:<{w}}  {'delivered':>9}  {'preview clicks':>14}  {'replies':>12}  {'positive':>12}  {'customers':>12}")
    for g in order:
        n = groups[g]
        d = n["delivered"]
        say(f"  {g:<{w}}  {d:>9}  {per_hundred(n['clicks'], d):>14}  {per_hundred(n['replies'], d):>12}  "
            f"{per_hundred(n['positive'], d):>12}  {per_hundred(n['customers'], d):>12}")
    smallest = min(groups[g]["delivered"] for g in order)
    positive = sum(groups[g]["positive"] for g in order)
    if smallest < TEST_FLOOR_DELIVERED or positive < TEST_FLOOR_POSITIVE:
        say(f"Too few to decide: the smallest group has {smallest} delivered (the floor is {TEST_FLOOR_DELIVERED} a "
            f"group) and {positive} positive repl{'y' if positive == 1 else 'ies'} in all (the floor is "
            f"{TEST_FLOOR_POSITIVE}). At about "
            "six replies in a hundred, 200 letters give roughly four replies a variant, so a gap of one or two is "
            "chance. The counts above are what there is; the test goes on until Taylor says stop.")
        return
    rates = sorted(((100.0 * groups[g]["replies"] / groups[g]["delivered"], g) for g in order), reverse=True)
    rest = ", ".join(f"{r:.1f} ({g})" for r, g in rates[1:])
    say(f"Directional, not proven: {rates[0][1]} leads with {rates[0][0]:.1f} replies per hundred delivered, "
        f"against {rest}. A real gap of two or three in a hundred needs several hundred letters a group to show "
        "clearly; the test goes on until Taylor says stop.")


def cmd_status(args):
    if getattr(args, "by", None):
        return cut_report(args.by)
    provider = pick_provider(args.provider)
    per_day = int(env_num("OUTREACH_PER_DAY", DEFAULT_PER_DAY, int))
    cap = int(env_num("OUTREACH_MAX_REPLIES_PER_DAY", DEFAULT_MAX_REPLIES, int))
    ai_cap = env_num("OUTREACH_AI_USD_PER_DAY", DEFAULT_AI_USD)
    stamp = today().isoformat()
    day = [r for r in cold_sends() if r.get("date") == stamp]
    say(f"Email lane — {stamp} · provider {provider.name}")
    addr = toolbelt(V.sender.postal_address_env)
    say(f"  for: {V.name} ({V.venture_name}), from {toolbelt('OUTREACH_FROM_NAME', V.sender.from_name)} in "
        f"{V.sender.town} · sending domains {', '.join(V.outreach.domains)} · postal address "
        + (addr if addr else f"not set ({V.sender.postal_address_env})"))
    say(f"  sends today: {len(day)} of {per_day}"
        + ("  (0 means the lane is off until OUTREACH_PER_DAY is set)" if per_day <= 0 else ""))
    by_touch = {}
    for r in day:
        by_touch[int(r.get("touch", 0))] = by_touch.get(int(r.get("touch", 0)), 0) + 1
    if by_touch:
        say("    " + ", ".join(f"day {k}: {v}" for k, v in sorted(by_touch.items())))
    reps = read_jsonl(replies_file())
    dayreps = [r for r in reps if r.get("date") == stamp]
    say(f"  replies today: {len(dayreps)} ({len([r for r in dayreps if r.get('answered')])} answered by the "
        f"machine, cap {cap})")
    counts = {}
    for r in reps:
        counts[r.get("class") or "?"] = counts.get(r.get("class") or "?", 0) + 1
    if counts:
        say("  all replies by class: " + ", ".join(f"{k} {v}" for k, v in sorted(counts.items())))
    say(f"  classifier spend today: ${ledger_ai_spend_today():.4f} of ${ai_cap:.2f}")
    ok, _, _, dline = deliverability(provider)
    say(f"  deliverability: {dline}")
    postmaster_status()                 # B136
    if ok is False:
        say("  THE LANE IS STOPPED by the kill switch; `outreach send` refuses until it is cleared.")
    marker = STATE / "killswitch" / f"{stamp}.txt"
    if marker.exists():
        say(f"  kill switch tripped today: {marker.read_text().strip()}")
    say(f"  suppressed: {len(suppressed())}")
    bad = approval_problems(ALL_TEMPLATES)
    say("  templates: " + ("all approved" if not bad else "; ".join(bad)))
    batch_status()


def batch_status():
    """The batch lane: the mailboxes, the ramp, the queue and the stop-rule numbers."""
    seqs = seqs_load()
    boxes = mailboxes()
    start, src = warmup_start()
    rd = ramp_day()
    cap = cap_on()
    say("\nBatch lane (B90)")
    say(f"  warm-up start: {start or 'not recorded'} ({src})" + (f" · ramp day {rd}" if rd is not None else ""))
    say(f"  OUTREACH_MAILBOX_PER_DAY: {toolbelt('OUTREACH_MAILBOX_PER_DAY', '0')} -> cap today {cap} a mailbox"
        + ("  (0: nothing sends)" if cap <= 0 else ""))
    paused = paused_boxes()
    for mb in boxes:
        say(f"  {mb}: {sends_on(mb)} of {cap} today" + (f" — PAUSED ({paused[mb].get('why')})" if mb in paused else ""))
    if not boxes:
        say("  no mailboxes (OUTREACH_MAILBOXES)")
    by = {}
    for x in seqs:
        by[x.get("status")] = by.get(x.get("status"), 0) + 1
    say("  sequences: " + (", ".join(f"{k} {v}" for k, v in sorted(by.items())) if by else "none"))
    say("  " + ai_test_line() + " · `outreach status --by variant`")
    n = stop_numbers()
    pm = n["postmaster"]
    say(f"  since {n['since']}: {n['sends']} sent, {n['bounces']} bounced; angry {n['angry']} + no {n['no']} over "
        f"the last {n['window']} sends; Postmaster "
        + (f"{float(pm['rate']):.2f}% on {pm.get('domain')} ({str(pm.get('ts'))[:10]})" if pm else "no reading"))
    held = latch()
    reasons = stop_reasons()
    if held:
        say(f"  THE LANE IS STOPPED since {held.get('ts')}: {held.get('why')} (`outreach resume --lane`)")
    elif reasons:
        say("  a stop rule is crossed: " + "; ".join(reasons))
    else:
        say("  stop rules: none crossed")


def cmd_warmup(args):
    if getattr(args, "action", None) == "start":
        if not args.date:
            die("say the day: outreach warmup start 2026-10-02")
        try:
            d = dt.date.fromisoformat(args.date)
        except ValueError:
            die(f"the date is YYYY-MM-DD, not {args.date!r}")
        write_json(state_dir("warmup-start.json"), {"start": d.isoformat(), "ts": now_iso()})
        say(f"Warm-up start recorded: {d.isoformat()}" + (" (dry run, not written)" if DRY else "")
            + ("; OUTREACH_WARMUP_START is set and wins over it" if os.environ.get("OUTREACH_WARMUP_START")
               or read_env().get("OUTREACH_WARMUP_START") else ""))
        return
    start, src = warmup_start()
    kind, steps = parse_cap(toolbelt("OUTREACH_MAILBOX_PER_DAY", "0"))
    say(f"Ramp — warm-up start {start or 'not recorded'} ({src})"
        + (f", day {ramp_day()}" if start else "") + f"; cap today {cap_on()} a mailbox")
    if kind == "ramp":
        say("  " + ", ".join(f"from day {d}: {c} a day" for d, c in steps) + "; before that, nothing")
    provider = pick_provider(args.provider)
    try:
        data = provider.warmup()
    except (Unreachable, ProviderError) as exc:
        die(f"couldn't read the warm-up state: {exc}")
    say(f"Warm-up — {provider.name}")
    if not data:
        say("  nothing yet.")
        return
    for who, d in (data.items() if isinstance(data, dict) else []):
        if isinstance(d, dict):
            sent = d.get("sent", "?")
            inbox, spam = d.get("landed_inbox", "?"), d.get("landed_spam", "?")
            say(f"  {who}: {sent} sent, {inbox} landed in the inbox, {spam} in spam"
                + (f" — {d['state']}" if d.get("state") else ""))
        else:
            say(f"  {who}: {d}")
    say("  The plan (37 § 3): fourteen days of warm-up, a handful a day, then 20, then 25–30 a mailbox; full "
        "volume in weeks four to six. OUTREACH_MAILBOX_PER_DAY governs the batch lane, OUTREACH_PER_DAY the kit lane.")


def cmd_postmaster(args):
    """A Google Postmaster Tools spam-rate reading, entered by hand: there is no API for it
    today. A reading at or over OUTREACH_SPAM_RATE_MAX_PCT stops the lane."""
    if args.rate in POSTMASTER_OPS:            # B136: fetch | check | grant, by API
        return POSTMASTER_OPS[args.rate](args)
    if args.rate is None:
        rows = read_jsonl(postmaster_file())
        if not rows:
            say("No Postmaster readings yet. `outreach postmaster 0.05` records one (percent).")
        for r in rows[-10:]:
            say(f"  {str(r.get('ts'))[:16]}  {r.get('domain')}: {float(r.get('rate')):.2f}%")
        return
    try:
        rate = float(str(args.rate).rstrip("%"))
    except ValueError:
        die(f"the reading is a percent like 0.08, not {args.rate!r}")
    domain = (args.domain or (mail.domain_of(mailboxes()[0]) if mailboxes() else "") or "?").lower()
    if not DRY:
        append_jsonl(postmaster_file(), {"ts": now_iso(), "domain": domain, "rate": rate})
    scap = env_num("OUTREACH_SPAM_RATE_MAX_PCT", DEFAULT_SPAM_RATE_PCT)
    say(f"Recorded {rate:.2f}% for {domain}" + (" (dry run)" if DRY else "") + ".")
    if rate >= scap:
        trip_switch(f"Postmaster spam rate on {domain}: {rate:.2f}% (stops at {scap:.2f}%)")
        sys.exit(1)


# ---- the Postmaster reading by API (B136, plan 55 § 3.1, § 5.3) -------------------------------------
# The work is lib/postmaster.py; these are the outreach views of it. The domains are the venture's
# (V.outreach.domains), or --domain.

def postmaster_domains(args=None):
    d = getattr(args, "domain", None) if args else None
    return [d.strip().lower()] if d else [x.lower() for x in V.outreach.domains]


def postmaster_status():
    """`outreach status`: yesterday's reading for every sending domain, or why there is none."""
    day = (today() - dt.timedelta(days=1)).isoformat()
    path = postmaster_file()
    missing = pmapi.missing_credentials(toolbelt)
    for d in postmaster_domains():
        r = pmapi.on_day(d, day, path)
        if r:
            say(f"  Postmaster {d}, yesterday ({day}): {pmapi.describe(r)}")
            continue
        last, lf = pmapi.latest(d, path), pmapi.last_fetch(d, path)
        if missing:
            why = "not set up (" + ", ".join(missing) + " unset)"
        elif lf:
            why = f"last fetch: {lf.get('outcome')}" + (f", {lf['detail']}" if lf.get("detail") else "")
        else:
            why = "never fetched"
        say(f"  Postmaster {d}: no reading for yesterday ({day}); {why}"
            + (f"; latest {last['date']}: {pmapi.describe(last)}" if last else ""))


def cmd_postmaster_fetch(args):
    """The daily read (systemd/outreach-postmaster.timer): the last few days of each domain, new days
    appended to postmaster.jsonl, and a reading at or over the cap stops the lane like a hand reading."""
    try:
        end = dt.date.fromisoformat(args.date) if args.date else today() - dt.timedelta(days=1)
    except ValueError:
        die(f"the date is YYYY-MM-DD, not {args.date!r}")
    start = end - dt.timedelta(days=pmapi.LOOKBACK_DAYS - 1)
    path = postmaster_file()
    scap = env_num("OUTREACH_SPAM_RATE_MAX_PCT", DEFAULT_SPAM_RATE_PCT)
    missing = pmapi.missing_credentials(toolbelt)
    if missing:
        say("Postmaster by API isn't set up: " + ", ".join(missing) + " unset. Nothing fetched, nothing written. "
            "TAYLOR-TODO § 1 \"Postmaster Tools by API\" has the steps; `outreach postmaster grant` is the last one.")
        if not DRY:
            for d in postmaster_domains(args):
                pmapi.log_fetch(path, d, "not set up", ", ".join(missing), now_iso())
        return
    tripped, failed = [], False
    for d in postmaster_domains(args):
        rows, problem = pmapi.fetch(d, start, end, toolbelt)
        if problem:
            failed = True
            say(f"  {d}: {problem}")
            if not DRY:
                pmapi.log_fetch(path, d, "failed", problem, now_iso())
            continue
        written = rows if DRY else pmapi.record(path, rows, now_iso())
        if not rows:
            say(f"  {d}: Google has no data for {start} to {end} (it publishes a day only above its volume line)")
        elif not written:
            say(f"  {d}: nothing new ({len(rows)} day(s) already recorded)")
        for r in written:
            say(f"  {d} {r['date']}: {pmapi.describe(r)}" + (" (dry run, not written)" if DRY else ""))
        if not DRY:
            pmapi.log_fetch(path, d, "ok" if rows else "no data", f"{len(rows)} day(s), {len(written)} new", now_iso())
        for r in written:
            if r.get("rate") is not None and float(r["rate"]) >= scap:
                tripped.append(f"Postmaster spam rate on {d}: {float(r['rate']):.2f}% on {r['date']} "
                               f"(stops at {scap:.2f}%)")
    if tripped:
        trip_switch("; ".join(tripped))
        sys.exit(1)
    if failed:
        sys.exit(2)


def cmd_postmaster_check(args):
    """For HEALTH § 1: one line a domain with no reading for --days (3) days or more; exit 1 if any."""
    days = args.days or pmapi.STALE_DAYS
    missing = pmapi.missing_credentials(toolbelt)
    if missing:
        lines = [f"Postmaster: not set up ({', '.join(missing)} unset), so no reading can come "
                 "(TAYLOR-TODO § 1 \"Postmaster Tools by API\")"]
    else:
        lines = pmapi.stale_lines(postmaster_domains(args), postmaster_file(), today(), days)
    for line in lines:
        say(line)
    if not lines:
        say(f"Postmaster: every domain read within {days} days ({', '.join(postmaster_domains(args))})")
    sys.exit(1 if lines else 0)


def cmd_postmaster_grant(args):
    """The one consent (Taylor): without --code, the link; with --code, the refresh token into the env file."""
    if not (toolbelt("POSTMASTER_CLIENT_ID") and toolbelt("POSTMASTER_CLIENT_SECRET")):
        die("POSTMASTER_CLIENT_ID and POSTMASTER_CLIENT_SECRET first (setenv.sh); TAYLOR-TODO § 1 has the steps")
    if not args.code:
        say("Open this signed in as the account that sees the sending domain in Postmaster Tools, allow it, and copy "
            "the address the browser lands on (that page won't load; that's expected):\n")
        say(pmapi.grant_url(toolbelt))
        say("\nThen: outreach postmaster grant --code '<that address>'")
        return
    try:
        token = pmapi.exchange_code(toolbelt, args.code)
    except pmapi.PostmasterError as e:
        die(f"the exchange failed: {e}")
    if DRY:
        say("Got a refresh token (dry run: not written).")
        return
    write_env_key("POSTMASTER_REFRESH_TOKEN", token)
    say(f"POSTMASTER_REFRESH_TOKEN written to {ENV_FILE} (not shown). `outreach postmaster fetch` reads now.")


def write_env_key(name, value):
    """Set one key in the toolbelt env file the way setenv.sh does (0600, one KEY=value line). Never printed."""
    ENV_FILE.parent.mkdir(parents=True, exist_ok=True)
    lines = ENV_FILE.read_text().splitlines() if ENV_FILE.exists() else []
    lines = [ln for ln in lines if not ln.startswith(f"{name}=")] + [f"{name}={value}"]
    old = os.umask(0o077)
    try:
        ENV_FILE.write_text("\n".join(lines) + "\n")
    finally:
        os.umask(old)
    os.chmod(ENV_FILE, 0o600)


POSTMASTER_OPS = {"fetch": cmd_postmaster_fetch, "check": cmd_postmaster_check, "grant": cmd_postmaster_grant}


def cmd_resume(args):
    """Taylor's word: a paused mailbox back on, or the stopped lane back on with the counts
    starting afresh."""
    if args.lane:
        write_json(state_dir("resume.json"), {"lane": now_iso()})
        for p in (STATE / "stopped.json", STATE / "killswitch" / f"{today().isoformat()}.txt"):
            if not DRY:
                p.unlink(missing_ok=True)
        say("The lane is back on; the stop rules count from now.")
        return
    if not args.mailbox:
        die(f"say which: outreach resume taylor@{V.outreach.domains[0]} | --lane")
    d = paused_boxes()
    mb = args.mailbox.strip().lower()
    if mb not in d:
        say(f"{mb} isn't paused.")
        return
    d.pop(mb)
    write_json(state_dir("paused.json"), d)
    say(f"{mb} is back on.")


def cmd_approve(args):
    names = list(args.template) if args.template else list(ALL_TEMPLATES)
    say("The text as it will go out (one rendered sample each):\n")
    problems = []
    for n in names:
        t = load_template(n)
        vals = sample_values()
        if n in ("batch-second", "batch-third"):
            vals["see_url"] = sample_link_base()     # shown with the link; checked both ways
        # B132: a batch letter goes out three ways during the AI-line test and the answer to a yes two ways;
        # each is the text Taylor is approving, so each is shown
        if n in BATCH_LETTERS:
            shown = [(f" — AI sentence {v}" + (" (only inside the AI-line test)" if v == "none" else ""),
                      {**vals, **ai_values(v)}) for v in ("intro", "foot", "none")]
        elif n == "answer-yes":
            shown = [("", vals), (" — in a `none` thread of the AI-line test", {**vals, "ai_none": "1"})]
        else:
            shown = [("", vals)]
        for label, v in shown:
            subject, body = t.render(v, fault=vals["fault"])
            say(f"───── {n}.md{label} ─────")
            say(f"Subject: {subject}")
            say(body)
        bad = check_template(n, none_ok=True)
        if n in BATCH_LETTERS and ai_kept_none():
            say(f"  NOTE: {AI_NONE_KEPT}.")
        money = money_in(n)
        if bad:
            problems += [f"{n}: {b}" for b in bad]
            say("  PROBLEMS: " + "; ".join(bad))
        if money:
            say(f"  money in this text (check each against {V.site_host}/pricing): " + ", ".join(m.strip() for m in money))
        say("")
    if problems:
        die("not approved — fix these first: " + "; ".join(problems))
    if DRY:
        say("[dry-run] APPROVED not written.")
        return
    lines = ["# templates/outreach/APPROVED — the exact text Taylor approved. `outreach send` refuses",
             "# while a hash here is missing or stale, so editing a letter un-approves it.",
             f"# Written by `outreach approve` on {today().isoformat()}.", ""]
    keep = approved()
    for n in ALL_TEMPLATES:
        keep[n] = load_template(n).sha if n in names else keep.get(n, "")
    for n in ALL_TEMPLATES:
        if keep.get(n):
            lines.append(f"{n:14s} {keep[n]}")
    (TEMPLATES / "APPROVED").write_text("\n".join(lines) + "\n")
    say(f"Approved {', '.join(names)} → {TEMPLATES / 'APPROVED'}")
    say("Whoever ran this command approved it; it is Taylor's step, and the file records the exact hash.")


def probe_replies(args):
    """`outreach probe --replies`: today's mail in each mailbox read afresh (the inbox cursor is not
    moved or consulted), and every message that answers a probe or comes from a probed address is
    printed. Read-only; nothing is classified, notified or written."""
    probes = read_jsonl(probes_file())
    if not probes:
        die("no probes on record; `outreach probe ADDRESS` first")
    mids = {r["message_id"] for r in probes if r.get("message_id")}
    addrs = {str(r.get("email") or "").lower() for r in probes if r.get("email")}
    since = min((r.get("date") for r in probes if r.get("date")), default=today().isoformat())
    boxes = [args.mailbox] if getattr(args, "mailbox", None) else mailboxes()
    imap = toolbelt("OUTREACH_IMAP_HOST", "imap.gmail.com:993")
    found = 0
    for mb in boxes:
        pw = toolbelt(password_name(mb))
        if not pw:
            say(f"  {mb}: {password_name(mb)} isn't set — skipped"); continue
        try:
            _uv, msgs = mail.imap_fetch_new(imap, mb, pw, last_uid=None, uidvalidity=None,
                                            since=dt.date.fromisoformat(since))
        except mail.MailError as exc:
            say(f"  {mb}: {exc}"); continue
        for _uid, raw in msgs:
            p = mail.parse_incoming(raw)
            frm = (p.get("from") or "").lower()
            refs = list(p.get("in_reply_to") or []) + list(p.get("references") or [])
            if not (any(x in mids for x in refs) or frm in addrs):
                continue
            found += 1
            text = " ".join(quoted_off(p.get("text") or "").split())[:300]
            say(f"\n{mb}  <-  {p.get('from')}  ·  {p.get('date') or ''}\n  {p.get('subject') or ''}\n  {text}")
    say(f"\n{found} repl{'y' if found == 1 else 'ies'} to the probes" if found else "No replies to the probes yet.")


def cmd_probe(args):
    if getattr(args, "replies", False):
        return probe_replies(args)
    """One plain test mail from each mailbox (or --mailbox) to an address Taylor names.
    The same builder and SMTP path a letter uses; nothing is logged as a send, no pipeline row,
    no ledger line. Only Taylor asks for it (it writes to a real inbox)."""
    to = args.to or ""
    if "@" not in to:
        die(f"{to!r} isn't an address")
    boxes = [args.mailbox] if getattr(args, "mailbox", None) else mailboxes()
    if not boxes:
        die("OUTREACH_MAILBOXES isn't set (see `outreach doctor`)")
    smtp = toolbelt("OUTREACH_SMTP_HOST", "smtp.gmail.com:465")
    from_name = toolbelt("OUTREACH_FROM_NAME", V.sender.from_name)
    when = dt.datetime.now().strftime("%a %-d %b %H:%M")
    ok = 0
    for i, mb in enumerate(boxes, 1):
        pw = toolbelt(password_name(mb))
        if not pw:
            say(f"  {mb}: {password_name(mb)} isn't set — skipped"); continue
        mid = mail.make_message_id(mail.domain_of(mb))
        msg = mail.build_message(mb, from_name, to, f"outreach probe {i} of {len(boxes)} — {mb}",
                                 f"A test from {mb} through the outreach tool's own sender, {when}.\n"
                                 f"Nothing to do with it; if it reached you, this mailbox can send.\n\n{V.sender.from_name}\n",
                                 mid)
        if DRY:
            say(f"  [dry-run] {mb} -> {to}"); ok += 1; continue
        try:
            mail.smtp_send(smtp, mb, pw, msg)
        except mail.MailError as exc:
            say(f"  {mb}: FAILED — {exc}"); continue
        say(f"  {mb} -> {to}: sent ({mid})"); ok += 1
        append_jsonl(probes_file(), {"ts": now_iso(), "date": today().isoformat(), "mailbox": mb,
                                     "email": to.lower(), "message_id": mid})
    say(f"{ok} of {len(boxes)} sent" + (" (dry run)" if DRY else ""))
    if ok != len(boxes):
        sys.exit(1)


def cmd_doctor(args):
    ok = True
    keys = read_env()
    say("Keys and settings (by name; no value is ever printed)")
    google = provider_wanted(args.provider) == "google"
    for k, need in (("INSTANTLY_API_KEY", not google), ("ANTHROPIC_KEY_OUTREACH", False),
                    ("ANTHROPIC_KEY_RELAY", False), ("OUTREACH_FROM", not google),
                    (V.sender.postal_address_env, True), ("LEADS_BOOKING_URL", True),
                    (V.sender.phone_env, False)):
        set_ = bool(os.environ.get(k) or keys.get(k))
        say(f"  {k}: {'set' if set_ else 'MISSING'}{'' if set_ or not need else '  (needed)'}")
        if need and not set_:
            ok = False
    if not (toolbelt("ANTHROPIC_KEY_OUTREACH") or toolbelt("ANTHROPIC_KEY_RELAY")):
        say("  no classifier key, so every reply would go to Taylor unread by the machine")
        ok = False
    say(f"  {V.sender.demo_number_env}: {toolbelt(V.sender.demo_number_env, DEMO_NUMBER_DEFAULT)}")

    say("\nCaps (environment, not prose)")
    per_day = int(env_num("OUTREACH_PER_DAY", DEFAULT_PER_DAY, int))
    say(f"  OUTREACH_PER_DAY: {per_day}" + ("  (0 — the lane sends nothing)" if per_day <= 0 else ""))
    say(f"  OUTREACH_MAX_REPLIES_PER_DAY: {int(env_num('OUTREACH_MAX_REPLIES_PER_DAY', DEFAULT_MAX_REPLIES, int))}")
    say(f"  OUTREACH_AI_USD_PER_DAY: ${env_num('OUTREACH_AI_USD_PER_DAY', DEFAULT_AI_USD):.2f}"
        f"  (spent today ${ledger_ai_spend_today():.4f})")
    say(f"  OUTREACH_BOUNCE_MAX_PCT: {env_num('OUTREACH_BOUNCE_MAX_PCT', DEFAULT_BOUNCE_PCT):.1f}%"
        f" · OUTREACH_COMPLAINTS: {int(env_num('OUTREACH_COMPLAINTS', 0, int))}")
    say(f"  OUTREACH_AUTO: {toolbelt('OUTREACH_AUTO') or '0'} ("
        + ("--go not needed" if str(toolbelt("OUTREACH_AUTO") or "") == "1" else "`send` needs --go") + ")")

    say(f"\nTemplates ({TEMPLATES})")
    appr = approved()
    for n in ALL_TEMPLATES:
        p = TEMPLATES / f"{n}.md"
        if not p.exists():
            say(f"  {n}: MISSING")
            ok = False
            continue
        t = load_template(n)
        bad = check_template(n, none_ok=True)     # the `none` rule is about sending: see the AI-line test line
        if n in BATCH_LETTERS and ai_kept_none():
            say(f"  {n}: `none` goes out outside any test — {AI_NONE_KEPT}")
        state = "approved" if appr.get(n) == t.sha else ("STALE — the text changed" if n in appr else "NOT APPROVED")
        say(f"  {n}: {state}; sha {t.sha[:12]}…; {'rules ok' if not bad else 'PROBLEMS: ' + '; '.join(bad)}")
        if bad or appr.get(n) != t.sha:
            ok = False
        money = money_in(n)
        if money:
            say(f"      money in the text (check /pricing): {', '.join(m.strip() for m in money)}")
    if not (TEMPLATES / "APPROVED").exists():
        say(f"  APPROVED is missing. Taylor reads the letters, then runs `outreach approve`.")

    say("\nThe day's picks (census only here — a doctor spends nothing)")
    payload, problem = kit_json(args.kit, free=True)
    if problem:
        say(f"  {problem}")
        ok = False
    else:
        picks = payload.get("picks") or []
        withmail = [p for p in picks if (p.get("email") or "").strip()]
        say(f"  leads kit --remote --json: {len(picks)} picks, {len(withmail)} with an address, "
            f"segment {payload.get('segment') or '?'}")

    say("\nProvider")
    if provider_wanted(args.provider) == "google" and not mailboxes():
        say("  google: no mailboxes (OUTREACH_MAILBOXES), so there is nothing to log in to")
        ok = False
    else:
        provider = pick_provider(args.provider)
        if provider.name == "google":
            say("  google: each mailbox's login is checked under Batch lane below")
        else:
            try:
                good, detail = provider.ping()
                say(f"  {provider.name}: {detail}")
                if not good:
                    ok = False
            except (Unreachable, ProviderError) as exc:
                say(f"  {provider.name}: FAIL {exc}")
                ok = False
        _, _, _, dline = deliverability(provider)
        say(f"  deliverability: {dline}")
    say(f"  never Resend (its terms forbid cold mail) and never {V.site_host}'s domain")

    if not doctor_batch():
        ok = False

    say("\nState and neighbours")
    say(f"  state: {STATE}  ({len(read_jsonl(sends_file()))} sends, {len(read_jsonl(replies_file()))} replies, "
        f"{len(suppressed())} suppressed)")
    _threads = reply_threads()
    say(f"  replies: {sum(1 for t in _threads if is_open(t['last']))} open, "
        f"{sum(1 for t in _threads if answered_by(t['last']) == 'taylor')} answered by Taylor "
        "(`outreach replies --open`)")
    say(f"  ledger: {LEDGER}")
    for t in ("leads", "notify", "prep"):
        p = tool_path(t)
        say(f"  {t}: {p if Path(p).exists() else 'MISSING — ' + p}")
        if not Path(p).exists():
            ok = False
    sys.exit(0 if ok else 1)


def doctor_batch():
    """The batch lane's half of the doctor. Plain about what's missing; True when it could send."""
    ok = True
    want = provider_wanted()
    boxes = mailboxes()
    say("\nBatch lane (B90)")
    say(f"  provider: {want}" + ("" if want == "google" else
                                 "  (the batch lane sends through google; set OUTREACH_PROVIDER=google)"))
    if not toolbelt("OUTREACH_MAILBOXES"):
        say("  OUTREACH_MAILBOXES: MISSING  (the sending addresses, comma-separated)")
        if want == "google":
            ok = False
    for mb in boxes:
        has = bool(toolbelt(password_name(mb)))
        say(f"  {password_name(mb)}: {'set' if has else 'MISSING'}")
        if want == "google" and not has:
            ok = False
    start, src = warmup_start()
    kind, _ = parse_cap(toolbelt("OUTREACH_MAILBOX_PER_DAY", "0"))
    cap = cap_on()
    say(f"  OUTREACH_MAILBOX_PER_DAY: {toolbelt('OUTREACH_MAILBOX_PER_DAY', '0')} ({kind}) -> {cap} a mailbox today"
        + ("  (0: nothing sends)" if cap <= 0 else ""))
    say(f"  warm-up start: {start or 'not recorded (OUTREACH_WARMUP_START or `outreach warmup start DATE`)'}"
        + (f" ({src}, day {ramp_day()})" if start else ""))
    if kind == "ramp" and not start:
        say("  the cap is a ramp and no warm-up start is recorded, so the cap is 0")
    s0, e0 = send_window()
    say(f"  sending window: {s0:%H:%M}–{e0:%H:%M} weekdays (OUTREACH_SEND_HOURS) · least gap "
        f"{env_num('OUTREACH_MIN_GAP_MINUTES', DEFAULT_MIN_GAP):g} min")
    raw = toolbelt("OUTREACH_LINK_BASE")
    if raw and not link_base():
        say("  OUTREACH_LINK_BASE is set but not an https address on a sending domain, so it is ignored: the "
            "second touch asks for a reply instead")
    else:
        say(f"  link base: {link_base() or 'unset — the second and third touches ask for a reply'}")
    v = verify_kind()
    if v == "none":
        ends = (start + dt.timedelta(days=NEW_SENDER_DAYS)) if start else None
        say(f"  verification: none. Until {ends or 'thirty days after a warm-up start is recorded'}, only addresses "
            "the batch marks MX-ok on the business's own domain are sent; the rest wait.")
    elif v == "millionverifier":
        has = bool(toolbelt("MILLIONVERIFIER_API_KEY"))
        say(f"  verification: millionverifier (about ${VERIFY_USD_EACH} an address); MILLIONVERIFIER_API_KEY: "
            f"{'set' if has else 'MISSING'}")
        if not has:
            ok = False
    else:
        say(f"  verification: {v!r} isn't a verifier this tool knows (none | millionverifier)")
        ok = False
    if want == "google" and boxes:
        try:
            good, detail = Google(boxes).ping()
        except (ProviderError, mail.MailError) as exc:
            good, detail = False, str(exc)
        say(f"  mailboxes: {detail}")
        ok = ok and good
    n = stop_numbers()
    say(f"  stop rules: bounces > {env_num('OUTREACH_BOUNCE_MAX_PCT', DEFAULT_BOUNCE_PCT):g}% a mailbox or a batch; "
        f"angry + unsubscribes > {env_num('OUTREACH_ANGRY_MAX_PCT', DEFAULT_ANGRY_PCT):g}% of the last "
        f"{int(env_num('OUTREACH_COMPLAINT_WINDOW', DEFAULT_COMPLAINT_WINDOW, int))}; Postmaster ≥ "
        f"{env_num('OUTREACH_SPAM_RATE_MAX_PCT', DEFAULT_SPAM_RATE_PCT):g}% "
        f"(now: {n['bounces']} bounces, {n['angry']} angry, {n['no']} no, "
        + (f"Postmaster {float(n['postmaster']['rate']):.2f}%" if n["postmaster"] else "no Postmaster reading") + ")")
    say("  " + ai_test_line())
    if latch():
        say(f"  THE LANE IS STOPPED: {latch().get('why')}")
    for mb, d in paused_boxes().items():
        say(f"  {mb} is PAUSED: {d.get('why')}")
    return ok


# ---- main ----------------------------------------------------------------------

def main():
    global DRY
    ap = argparse.ArgumentParser(prog="outreach", description=V.fill(__doc__),
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--dry-run", action="store_true", help="print everything, send nothing, write nothing")
    common.add_argument("--provider", help="instantly | fake (default: instantly once the key is set)")
    sub = ap.add_subparsers(dest="cmd")

    s = sub.add_parser("send", parents=[common], help="the day's approved emails")
    s.add_argument("--go", action="store_true", help="Taylor said go (or set OUTREACH_AUTO=1)")
    s.add_argument("--only", nargs="+", help="only these picks, by kit number")
    s.add_argument("--hold", nargs="+", help="drop these picks, by kit number")
    s.add_argument("--touch", type=int, default=0, choices=(0, 3, 10), help="day 0, 3 or 10 (GROWTH § 5.5)")
    s.add_argument("--kit", help="a kit JSON file instead of running `leads kit --remote --json` (tests)")
    s.add_argument("--show", action="store_true", help="print each letter as it goes")
    s.add_argument("--batch", help="a batch from `leads batch --json` (a file, or - for stdin)")
    s.set_defaults(fn=cmd_send)

    s = sub.add_parser("tick", parents=[common], help="send what is due now (the timer runs it)")
    s.add_argument("--until", help="tests only: tick from OUTREACH_NOW to this ISO time")
    s.add_argument("--every", type=int, default=5, help="tests only: minutes between those ticks (default 5)")
    s.set_defaults(fn=cmd_tick)

    s = sub.add_parser("postmaster", parents=[common], help="record a Postmaster spam-rate reading (percent)")
    s.add_argument("rate", nargs="?", help="a percent, or fetch | check | grant (B136)")
    s.add_argument("--domain")
    s.add_argument("--date", help="fetch: the last day to ask for (default yesterday)")
    s.add_argument("--days", type=int, help="check: how many days without a reading is a line (default 3)")
    s.add_argument("--code", help="grant: the address the browser landed on after consent")
    s.set_defaults(fn=cmd_postmaster)

    s = sub.add_parser("resume", parents=[common], help="a paused mailbox, or the stopped lane, back on")
    s.add_argument("mailbox", nargs="?")
    s.add_argument("--lane", action="store_true")
    s.set_defaults(fn=cmd_resume)

    s = sub.add_parser("inbox", parents=[common], help="replies: classified, the routine ones answered")
    s.add_argument("--limit", type=int, help="only the first N new replies")
    s.set_defaults(fn=cmd_inbox)

    s = sub.add_parser("replies", parents=[common],
                       help="B105: every reply thread across the mailboxes, newest first (last 14 days)")
    s.add_argument("name", nargs="*", help="only threads whose business name or address holds this")
    s.add_argument("--open", action="store_true", help="only what waits on Taylor")
    s.add_argument("--today", action="store_true", help="only today's")
    s.add_argument("--since", help="since this date (YYYY-MM-DD)")
    s.add_argument("--count", action="store_true", help="print one number: the threads waiting on Taylor")
    s.add_argument("--json", action="store_true", help="the threads as JSON")
    s.set_defaults(fn=cmd_replies)

    s = sub.add_parser("reply", parents=[common],
                       help="B105: Taylor's own words, in the thread, from the mailbox that owns it")
    s.add_argument("name", help="the business name or address of one open thread")
    s.add_argument("text", help="what to say; his name, phone and the postal address are added")
    s.add_argument("--any", action="store_true", help="also a thread that isn't waiting (answered, or a probe)")
    s.set_defaults(fn=cmd_reply)

    s = sub.add_parser("build", parents=[common],
                       help="Taylor's `build`: the researched site (prep one) for an interested reply")
    s.add_argument("who", nargs="*", help="a name or place id (default: the one the last message offered)")
    s.set_defaults(fn=cmd_build)

    s = sub.add_parser("pressed", parents=[common],
                       help="B91: a business pressed its letter's link; stop its touches, offer `build` (one JSON object)")
    s.add_argument("place", help="the census place id")
    s.add_argument("--name", help="the business, if the sequence doesn't name it")
    s.add_argument("--url", help="the preview it was shown")
    s.set_defaults(fn=cmd_pressed)

    s = sub.add_parser("suppress", parents=[common], help="off the list for good")
    s.add_argument("action", choices=("add", "ls"))
    s.add_argument("value", nargs="*", help="an email address or a census place id")
    s.add_argument("--reason")
    s.add_argument("--json", action="store_true", help="ls: [{value, kind}] as JSON (kind address|domain|place_id)")
    s.set_defaults(fn=cmd_suppress)

    s = sub.add_parser("status", parents=[common], help="today's sends, the caps, the replies, the bounce rate")
    s.add_argument("--by", choices=tuple(BY_CUTS), help="B132: delivered → clicks → replies → positive → customers "
                                                         "per group, each per hundred delivered")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("ai-test", parents=[common], help="B132: the AI-line test — start | stop [--keep V] | show "
                                                         "(start and stop on Taylor's word only)")
    s.add_argument("action", nargs="?", choices=("start", "stop", "show"))
    s.add_argument("--keep", choices=AI_VARIANTS, help="stop: the placement new letters take from now on")
    s.set_defaults(fn=cmd_ai_test)

    s = sub.add_parser("warmup", parents=[common], help="the warm-up state and the ramp")
    s.add_argument("action", nargs="?", choices=("start",))
    s.add_argument("date", nargs="?")
    s.set_defaults(fn=cmd_warmup)

    s = sub.add_parser("approve", parents=[common], help="print each letter, then record Taylor's approval")
    s.add_argument("--template", action="append", help="just this one (repeatable)")
    s.set_defaults(fn=cmd_approve)

    s = sub.add_parser("probe", parents=[common], help="one plain test mail from each mailbox to an address (Taylor's ask)")
    s.add_argument("to", nargs="?")
    s.add_argument("--mailbox", help="just this one")
    s.add_argument("--replies", action="store_true", help="read today's mail afresh and print the answers to the probes")
    s.set_defaults(fn=cmd_probe)

    s = sub.add_parser("doctor", parents=[common])
    s.add_argument("--kit", help="a kit JSON file instead of running `leads kit --remote --json`")
    s.set_defaults(fn=cmd_doctor)

    args = ap.parse_args()
    if not args.cmd:
        ap.print_help()
        sys.exit(0)
    DRY = bool(getattr(args, "dry_run", False))
    if not hasattr(args, "kit"):
        args.kit = None
    args.fn(args)


if __name__ == "__main__":
    main()
