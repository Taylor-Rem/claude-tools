CLASSES = ("interested", "question", "not now", "no", "bounce", "out of office", "other")

# The only price sentences that may leave this tool. Starter, exactly as /pricing and
# patchlamp/CLAIMS.md state it; change these only with a CLAIMS.md row in hand.
