#!/usr/bin/env python3
"""pay — take money on the owner's own Stripe account, by text (ROADMAP B22,
plan ~/projects/plans/16-payments.md § Build 4, § Contract E).

  pay link 45 "June service"                      # a Payment Link on their account; prints the URL
  pay invoice "Smith" 450 "June service" [--due 14d] [--email smith@x.com] [--send]
                                                  # a Stripe invoice from their account; prints the payable link
  pay deposit 100 "catering 10/12"                # a Payment Link for a deposit
  pay status                                      # can they take money, get paid, what Stripe still wants; recent payments
  pay doctor                                      # key by name, the account, reachable, test or live
  --dry-run anywhere: print the requests, send nothing.

The owner connects their own Stripe account to Patchlamp's platform once
(`CONNECT: stripe | <name>` by text or the Connect Stripe button on
/account; Stripe's hosted onboarding). After that every call here is made
with the **platform** key and `Stripe-Account: acct_…`, so the object — the
link, the invoice, the charge — lives on *their* account: they are the
merchant of record, Stripe's fees are theirs, the money goes to their bank.
This tool never sends `application_fee_amount`, `transfer_data` or
`on_behalf_of`: we take nothing.

Which account: `STRIPE_CONNECTED_ACCOUNT` in the run's environment (the
relay injects it for a project whose Stripe is connected); outside a run,
`--project SLUG` (or this workspace's `.client.json`) asks patchlamp.com
the way `connections` does, or `--account acct_…` outside a workspace.
Inside a client workspace the account must be the one patchlamp.com has
for this workspace — a run can't reach another client's Stripe.

Which key, by NAME, never printed: `STRIPE_KEY_PATCHLAMP` (live) or
`STRIPE_TEST_KEY` (`--test`, or automatically when patchlamp.com says the
connected account is a test-mode one — the demos). Amounts are dollars on
the command line ("450", "$1,200.50"), cents to Stripe, USD.

Free to run: Stripe charges the owner its own processing fee when a
customer pays; nothing here spends our money, so no ledger line.

Config, by name, never printed:
  STRIPE_KEY_PATCHLAMP / STRIPE_TEST_KEY   ~/.config/claude-tools/env
  PATCHLAMP_RELAY_SHARED_SECRET            only to look the account up on patchlamp.com
  PATCHLAMP_URL                            optional; default https://patchlamp.com
  STRIPE_API_BASE                          tests only: a stand-in for api.stripe.com
"""

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid
from decimal import Decimal, InvalidOperation
from pathlib import Path

ENV_FILE = Path(os.environ.get("CLAUDE_TOOLS_ENV", Path.home() / ".config/claude-tools/env"))
STRIPE = (os.environ.get("STRIPE_API_BASE") or "https://api.stripe.com").rstrip("/")
LIVE_KEY, TEST_KEY = "STRIPE_KEY_PATCHLAMP", "STRIPE_TEST_KEY"
ACCT_RE = re.compile(r"^acct_[A-Za-z0-9]{6,64}$")
MIN_CENTS, MAX_CENTS = 50, 99_999_999            # Stripe's own floor and ceiling for a USD charge
FORBIDDEN = ("application_fee", "transfer_data", "on_behalf_of")   # never, in any request (VISION: no percentage)
DRY = False


def die(msg, code=1):
    print(f"pay: {msg}", file=sys.stderr)
    sys.exit(code)


def say(msg=""):
    print(msg, flush=True)


def read_env():
    keys = {}
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                keys[k.strip()] = v.strip()
    return keys


def toolbelt(name):
    return os.environ.get(name) or read_env().get(name)


def workspace_slug():
    p = Path.cwd() / ".client.json"
    if not p.exists():
        return None
    try:
        return json.loads(p.read_text()).get("slug")
    except (ValueError, OSError):
        return None


# ---- money ---------------------------------------------------------------------

def cents(text):
    """'450' / '$1,200.50' / '45.5' -> 45000 / 120050 / 4550. Refuses anything odd."""
    raw = str(text).strip().replace(",", "").lstrip("$").strip()
    try:
        d = Decimal(raw)
    except InvalidOperation:
        die(f"{text!r} isn't an amount (dollars, like 450 or 1200.50)")
    if d != d.quantize(Decimal("0.01")):
        die(f"{text!r} has more than two decimal places")
    c = int(d * 100)
    if c < MIN_CENTS:
        die(f"{text!r} is below Stripe's minimum of $0.50")
    if c > MAX_CENTS:
        die(f"{text!r} is more than Stripe takes in one payment ($999,999.99)")
    return c


def dollars(c):
    return f"${c / 100:,.2f}"


def due_days(text):
    m = re.fullmatch(r"\s*(\d{1,3})\s*d?(ays?)?\s*", str(text or ""))
    if not m or not (1 <= int(m.group(1)) <= 365):
        die(f"--due {text!r}: a number of days, like 14d or 30")
    return int(m.group(1))


# ---- the account + the key -------------------------------------------------------

def patchlamp_row(slug):
    """The stripe connection row patchlamp.com has for this project, or None."""
    secret = toolbelt("PATCHLAMP_RELAY_SHARED_SECRET")
    if not secret:
        return "no-secret"
    base = (toolbelt("PATCHLAMP_URL") or "https://patchlamp.com").rstrip("/")
    req = urllib.request.Request(f"{base}/internal/relay/projects/{slug}/connections",
                                 headers={"Authorization": f"Bearer {secret}", "Accept": "application/json",
                                          "User-Agent": "claude-tools/pay"})
    try:
        with urllib.request.urlopen(req, timeout=25) as resp:
            data = json.loads(resp.read().decode() or "{}")
    except urllib.error.HTTPError as exc:
        die(f"patchlamp.com: HTTP {exc.code} for project {slug}")
    except urllib.error.URLError as exc:
        die(f"patchlamp.com unreachable: {exc.reason}")
    rows = [c for c in data.get("connections") or [] if c.get("kind") == "stripe" and c.get("status") != "revoked"]
    return rows[0] if rows else None


def row_account(row):
    return ((row.get("env") or {}).get("STRIPE_CONNECTED_ACCOUNT") or row.get("stripe_account")
            or row.get("external_id") or "")


class Target:
    """Which connected account, which key (by name), test or live."""

    def __init__(self, args):
        self.account, self.livemode, self.source = "", None, ""
        ws = workspace_slug()
        project = getattr(args, "project", None)
        if ws and project and project != ws:
            die(f"this workspace is {ws}; it can't reach another project's Stripe")
        env_acct = os.environ.get("STRIPE_CONNECTED_ACCOUNT", "").strip()
        flag_acct = (getattr(args, "account", None) or "").strip()
        if flag_acct and ws and flag_acct != env_acct:
            die("--account is for a terminal outside a client workspace; here the account is this client's own")
        slug = project or ws
        row = None
        if slug and (project or not flag_acct):
            row = patchlamp_row(slug)
            if row == "no-secret":
                row = None
                if not env_acct and not flag_acct:
                    die("PATCHLAMP_RELAY_SHARED_SECRET is not in the toolbelt, so the account can't be looked up; "
                        "pass --account acct_… from a terminal")
            elif row is None and not (env_acct or flag_acct):
                die(f"{slug} hasn't connected Stripe yet. The owner connects it once: end the reply with "
                    f"`CONNECT: stripe | <business name>` (or the Connect Stripe button on patchlamp.com/account).")
        if row:
            acct = row_account(row)
            if env_acct and acct and env_acct != acct:
                die(f"the run's STRIPE_CONNECTED_ACCOUNT isn't the account patchlamp.com has for {slug}; refusing")
            if row.get("status") != "connected":
                need = ", ".join(row.get("requirements") or []) or "the rest of Stripe's sign-up"
                die(f"{slug}'s Stripe isn't finished: Stripe still needs {need}. Ask the owner to finish it "
                    f"(`CONNECT: stripe | <name>` sends them a fresh link).")
            self.account, self.source = acct, f"patchlamp.com ({slug})"
            if row.get("livemode") is not None:
                self.livemode = bool(row["livemode"])
        else:
            self.account = env_acct or flag_acct
            self.source = "the run's environment" if env_acct else "--account"
        if not self.account:
            die("no connected Stripe account: STRIPE_CONNECTED_ACCOUNT isn't in this run's environment.\n"
                "     The owner connects once (`CONNECT: stripe | <name>`); from a terminal pass --project SLUG.")
        if not ACCT_RE.match(self.account):
            die(f"{self.account!r} isn't a Stripe account id (acct_…)")
        if getattr(args, "test", False):
            self.livemode = False
        self.key_name = TEST_KEY if self.livemode is False else LIVE_KEY

    def key(self):
        val = toolbelt(self.key_name)
        if not val:
            die(f"{self.key_name} is not in the toolbelt (Taylor: ~/.config/claude-tools/setenv.sh {self.key_name}; "
                f"TAYLOR-TODO §1)")
        want = "_test_" if self.key_name == TEST_KEY else "_live_"
        if not val.startswith(("sk", "rk")) or want not in val[:8]:
            die(f"{self.key_name} doesn't look like a {'test' if want == '_test_' else 'live'} Stripe secret key")
        return val

    @property
    def mode(self):
        return "test" if self.key_name == TEST_KEY else "live"


# ---- HTTP ------------------------------------------------------------------------------

def form(obj, prefix="", out=None):
    out = [] if out is None else out
    for k, v in obj.items():
        key = f"{prefix}[{k}]" if prefix else k
        if v is None:
            continue
        if isinstance(v, dict):
            form(v, key, out)
        elif isinstance(v, list):
            for i, x in enumerate(v):
                if isinstance(x, dict):
                    form(x, f"{key}[{i}]", out)
                else:
                    out.append((f"{key}[{i}]", str(x)))
        elif isinstance(v, bool):
            out.append((key, "true" if v else "false"))
        else:
            out.append((key, str(v)))
    return out


class StripeError(Exception):
    def __init__(self, status, message):
        super().__init__(message)
        self.status, self.message = status, message


def stripe(t, method, path, fields=None, params=None, _retry=True):
    """One call on the connected account. Every call carries Stripe-Account."""
    body = form(fields or {})
    for k, _ in body:
        if any(f in k for f in FORBIDDEN):
            die(f"refusing to send {k}: we never take a fee or move their money")
    url = f"{STRIPE}{path}" + ("?" + urllib.parse.urlencode(form(params)) if params else "")
    if DRY and method != "GET":
        say(f"  would {method} {path}  (Stripe-Account: {t.account}, {t.key_name}, {t.mode} mode)")
        for k, v in body:
            say(f"    {k} = {v}")
        return {"id": f"(dry-run {path.split('/')[2]})", "url": "(dry run: no link made)",
                "hosted_invoice_url": "(dry run: no invoice made)"}
    headers = {"Authorization": f"Bearer {t.key()}", "Stripe-Account": t.account,
               "User-Agent": "claude-tools/pay", "Accept": "application/json"}
    data = None
    if method == "POST":
        headers["Content-Type"] = "application/x-www-form-urlencoded"
        headers["Idempotency-Key"] = str(uuid.uuid4())
        data = urllib.parse.urlencode(body).encode()
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode() or "{}")
    except urllib.error.HTTPError as exc:
        try:
            msg = (json.loads(exc.read().decode()).get("error") or {}).get("message") or ""
        except ValueError:
            msg = ""
        # a demo's account is a test-mode one; a terminal run without --test finds out here
        if _retry and t.key_name == LIVE_KEY and "exists in test mode" in msg and toolbelt(TEST_KEY):
            t.key_name = TEST_KEY
            return stripe(t, method, path, fields, params, _retry=False)
        raise StripeError(exc.code, msg or f"HTTP {exc.code}")
    except urllib.error.URLError as exc:
        die(f"Stripe unreachable: {exc.reason}")


def call(t, *a, **kw):
    try:
        return stripe(t, *a, **kw)
    except StripeError as e:
        die(explain(e))


def explain(e):
    m = e.message
    if e.status == 401:
        return f"Stripe refused {'the test' if 'test' in m.lower() else 'the platform'} key (401). Nothing was made."
    if "No such account" in m or e.status == 403:
        return ("Stripe says this platform can't act on that account — disconnected, or not finished? "
                f"`pay status` / `connections`. ({m[:200]})")
    if "charges_enabled" in m or "cannot currently make live charges" in m or "activate" in m.lower():
        return f"Stripe isn't letting the account take payments yet: {m[:200]} — `pay status` says what it still needs."
    return f"Stripe said HTTP {e.status}: {m[:300]}"


# ---- commands -------------------------------------------------------------------------

def mode_note(t):
    return " (TEST MODE — card 4242 4242 4242 4242, nothing is charged)" if t.mode == "test" else ""


def make_link(t, amount_cents, name, kind):
    price = call(t, "POST", "/v1/prices", {
        "currency": "usd", "unit_amount": amount_cents,
        "product_data": {"name": name[:250], "metadata": {"patchlamp": kind}}})
    link = call(t, "POST", "/v1/payment_links", {
        "line_items": [{"price": price["id"], "quantity": 1}],
        "metadata": {"patchlamp": kind},
        "payment_intent_data": {"description": name[:500], "metadata": {"patchlamp": kind}}})
    return link


def cmd_link(args, t):
    c = cents(args.amount)
    link = make_link(t, c, args.description, "link")
    say(f"{dollars(c)} for {args.description} — pay here:{mode_note(t)}")
    say(link.get("url") or "(no url)")


def cmd_deposit(args, t):
    c = cents(args.amount)
    link = make_link(t, c, f"Deposit — {args.description}", "deposit")
    say(f"{dollars(c)} deposit for {args.description} — pay here:{mode_note(t)}")
    say(link.get("url") or "(no url)")


def find_customer(t, who, email):
    email = email or (who if "@" in who else None)
    name = None if (who and "@" in who) else who
    if email:
        found = (call(t, "GET", "/v1/customers", params={"email": email, "limit": 3}) or {}).get("data") or []
        if found:
            return found[0], False
    elif name and not DRY:
        q = name.replace("\\", "").replace("'", "\\'")
        found = (call(t, "GET", "/v1/customers/search", params={"query": f"name:'{q}'", "limit": 5}) or {}).get("data") or []
        if len(found) > 1:
            listing = "; ".join(f"{c.get('name')} <{c.get('email') or 'no email'}>" for c in found)
            die(f"more than one customer called {name!r} on their Stripe ({listing}); say which with --email")
        if found:
            return found[0], False
    made = call(t, "POST", "/v1/customers", {"name": name or None, "email": email or None,
                                             "metadata": {"patchlamp": "pay invoice"}})
    return made, True


def cmd_invoice(args, t):
    c = cents(args.amount)
    days = due_days(args.due)
    cust, made = find_customer(t, args.customer, args.email)
    inv = call(t, "POST", "/v1/invoices", {
        "customer": cust["id"], "collection_method": "send_invoice", "days_until_due": days,
        "pending_invoice_items_behavior": "exclude", "auto_advance": False,
        "description": args.description[:500], "metadata": {"patchlamp": "invoice"}})
    call(t, "POST", "/v1/invoiceitems", {
        "customer": cust["id"], "invoice": inv["id"], "amount": c, "currency": "usd",
        "description": args.description[:500]})
    fin = call(t, "POST", f"/v1/invoices/{inv['id']}/finalize", {"auto_advance": False})
    sent = False
    if args.send:
        if not (cust.get("email") or args.email or "@" in args.customer):
            say("  not emailed: the customer has no email on their Stripe (text them the link, or --email)")
        else:
            fin = call(t, "POST", f"/v1/invoices/{inv['id']}/send") or fin
            sent = True
    who = cust.get("name") or cust.get("email") or args.customer
    say(f"Invoice {fin.get('number') or inv['id']} for {who}: {dollars(c)} — {args.description}, due in {days} days"
        f"{' (new customer on their Stripe)' if made else ''}{'; Stripe emailed it' if sent else ''}.{mode_note(t)}")
    say(fin.get("hosted_invoice_url") or "(no link yet)")


def cmd_status(args, t):
    acct = call(t, "GET", "/v1/account")
    req = (acct.get("requirements") or {})
    due = req.get("currently_due") or []
    name = ((acct.get("business_profile") or {}).get("name") or ((acct.get("settings") or {}).get("dashboard") or {}).get("display_name")
            or acct.get("email") or t.account)
    say(f"{name} ({t.account}, {t.mode} mode, via {t.source})")
    say(f"  taking payments: {'yes' if acct.get('charges_enabled') else 'NOT YET'}")
    say(f"  payouts to their bank: {'on' if acct.get('payouts_enabled') else 'NOT YET'}")
    say(f"  Stripe still needs: {', '.join(due) if due else 'nothing'}")
    if req.get("disabled_reason"):
        say(f"  disabled: {req['disabled_reason']}")
    try:
        invs = (stripe(t, "GET", "/v1/invoices", params={"limit": 5}) or {}).get("data") or []
        charges = (stripe(t, "GET", "/v1/charges", params={"limit": 5}) or {}).get("data") or []
    except StripeError as e:
        say(f"  recent: couldn't read ({e.message[:120]})")
        return
    if invs:
        say("  recent invoices:")
        for i in invs:
            say(f"    {i.get('number') or i['id']}  {dollars(i.get('amount_due') or 0)}  {i.get('status')}  "
                f"{i.get('customer_name') or i.get('customer_email') or ''}")
    paid = [ch for ch in charges if ch.get("paid") and ch.get("status") == "succeeded"]
    if paid:
        say("  recent payments:")
        for ch in paid:
            say(f"    {dollars(ch.get('amount') or 0)}  {ch.get('description') or ''}  "
                f"{(ch.get('billing_details') or {}).get('name') or ''}{'  refunded' if ch.get('refunded') else ''}")
    if not invs and not paid:
        say("  no invoices or payments yet")


def cmd_doctor(args):
    ok = True
    keys = read_env()
    for k in (LIVE_KEY, TEST_KEY, "PATCHLAMP_RELAY_SHARED_SECRET"):
        say(f"toolbelt {k}: {'set' if (os.environ.get(k) or keys.get(k)) else 'MISSING'}")
    if not (os.environ.get(LIVE_KEY) or keys.get(LIVE_KEY)):
        ok = False
    ws = workspace_slug()
    say(f"workspace: {ws or '(none — outside a client workspace)'}")
    has_target = os.environ.get("STRIPE_CONNECTED_ACCOUNT") or args.account or args.project or ws
    if not has_target:
        say("account: none here (inside a run the relay sets STRIPE_CONNECTED_ACCOUNT; or --project SLUG / --account acct_…)")
        sys.exit(0 if ok else 1)
    try:
        t = Target(args)
    except SystemExit:
        say("account: not usable (the line above says why)")
        sys.exit(1)
    say(f"account: {t.account} from {t.source}; key {t.key_name} ({t.mode} mode)")
    try:
        acct = stripe(t, "GET", "/v1/account")
    except StripeError as e:
        say(f"  FAIL {explain(e)}")
        sys.exit(1)
    say(f"  reachable: yes; taking payments {'yes' if acct.get('charges_enabled') else 'NOT YET'}, "
        f"payouts {'on' if acct.get('payouts_enabled') else 'NOT YET'}")
    if not acct.get("charges_enabled"):
        ok = False
    say("  fees: none of ours (no application fee, no transfer); Stripe's own fees are the owner's")
    sys.exit(0 if ok else 1)


def main():
    global DRY
    ap = argparse.ArgumentParser(prog="pay", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--project", help="project slug (default: this workspace's .client.json)")
    common.add_argument("--account", help="acct_… (a terminal outside a client workspace only)")
    common.add_argument("--test", action="store_true", help=f"use {TEST_KEY} (test mode)")
    common.add_argument("--dry-run", action="store_true", help="print the requests, send nothing")
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("link", parents=[common], help="a Payment Link for AMOUNT")
    s.add_argument("amount"); s.add_argument("description")
    s.set_defaults(fn=cmd_link)
    s = sub.add_parser("deposit", parents=[common], help="a Payment Link for a deposit")
    s.add_argument("amount"); s.add_argument("description")
    s.set_defaults(fn=cmd_deposit)
    s = sub.add_parser("invoice", parents=[common], help="a Stripe invoice from their account")
    s.add_argument("customer", help="the customer's name or email")
    s.add_argument("amount"); s.add_argument("description")
    s.add_argument("--due", default="14d", help="days to pay (default 14d)")
    s.add_argument("--email", help="the customer's email (found or added on their Stripe)")
    s.add_argument("--send", action="store_true", help="also have Stripe email it")
    s.set_defaults(fn=cmd_invoice)
    s = sub.add_parser("status", parents=[common], help="can they take money; recent invoices and payments")
    s.set_defaults(fn=cmd_status)
    s = sub.add_parser("doctor", parents=[common])
    s.set_defaults(fn=None)
    args = ap.parse_args()
    DRY = args.dry_run
    if args.cmd == "doctor":
        return cmd_doctor(args)
    t = Target(args)
    args.fn(args, t)


if __name__ == "__main__":
    main()
