#!/usr/bin/env python3
"""
pf — Plateful operator API from the command line.

    pf me                                   who am I, which restaurants, which scopes
    pf menu [-r SUBDOMAIN] [--json]         menu with item ids, prices, photo status
    pf find "torpedo"                       menu items whose name/description match
    pf item ID                              one menu item (full record)
    pf upload-image ITEM_ID FILE|URL        set a menu item's photo
    pf remove-image ITEM_ID
    pf set-image logo|hero|about FILE|URL   restaurant branding slots
    pf remove-image-kind logo|hero|about
    pf photos                               gallery
    pf add-photo FILE|URL [--caption ..]
    pf remove-photo PHOTO_ID
    pf availability ITEM_ID on|off
    pf orders [--status ..]  |  pf order NUMBER  |  pf kitchen
    pf keys create -r SUBDOMAIN --name N --scopes a,b --save KEY_NAME
                                            mint a restaurant-scoped key and write it
                                            straight into the toolbelt (never printed)
    pf doctor                               which key is in use, does it authenticate

Which key: if PF_RESTAURANT is set (the relay sets it for a tenant workspace),
pf uses PLATEFUL_KEY_<SUBDOMAIN> from ~/.config/claude-tools/env and refuses to
fall back — a tenant session can only ever hold a tenant-scoped key. Otherwise
PLATEFUL_API_KEY (the platform key). -r picks the restaurant for platform keys;
a restaurant-scoped key implies it.
"""

import argparse
import json
import os
import re
import sys
from pathlib import Path

import requests

BASE = os.environ.get("PF_BASE", "https://plateful.fyi/api/v1/operator")
TOOLBELT = Path(os.environ.get("CLAUDE_TOOLS_ENV", Path.home() / ".config/claude-tools/env"))


def die(msg, code=1):
    print(f"pf: {msg}", file=sys.stderr)
    sys.exit(code)


def read_toolbelt():
    keys = {}
    if TOOLBELT.exists():
        for line in TOOLBELT.read_text().splitlines():
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                keys[k.strip()] = v.strip()
    return keys


def key_name_for(subdomain):
    return "PLATEFUL_KEY_" + re.sub(r"[^A-Z0-9]", "_", subdomain.upper())


def resolve_auth(args_restaurant):
    """Returns (token, key_name, restaurant_subdomain_or_None)."""
    keys = read_toolbelt()
    tenant = os.environ.get("PF_RESTAURANT")
    if tenant:
        name = key_name_for(tenant)
        if not keys.get(name):
            die(f"PF_RESTAURANT={tenant} but {name} is not in the toolbelt. "
                f"Mint one: pf keys create -r {tenant} --name Claude --scopes menu:read,menu:write,restaurants:read,restaurants:write,orders:read --save {name}")
        if args_restaurant and args_restaurant != tenant:
            die(f"this session is scoped to {tenant}; -r {args_restaurant} is not allowed")
        return keys[name], name, tenant
    if not keys.get("PLATEFUL_API_KEY"):
        die("PLATEFUL_API_KEY is not in the toolbelt")
    return keys["PLATEFUL_API_KEY"], "PLATEFUL_API_KEY", args_restaurant


class Client:
    def __init__(self, restaurant):
        self.token, self.key_name, self.restaurant = resolve_auth(restaurant)
        self.s = requests.Session()
        self.s.headers.update({"Authorization": f"Bearer {self.token}", "Accept": "application/json"})

    def req(self, method, path, **kw):
        r = self.s.request(method, f"{BASE}/{path.lstrip('/')}", timeout=kw.pop("timeout", 60), **kw)
        if r.status_code >= 400:
            try:
                body = r.json()
                msg = body.get("message") or body
                if body.get("errors"):
                    msg = f"{msg} {json.dumps(body['errors'])}"
            except ValueError:
                msg = r.text[:300]
            die(f"HTTP {r.status_code} on {method} {path}: {msg}")
        return r.json().get("data") if r.content else None

    def rpath(self, rest):
        """restaurants/{sub}/<rest>, resolving the subdomain if needed."""
        if not self.restaurant:
            me = self.req("GET", "me")
            rs = me.get("restaurants", [])
            if len(rs) == 1:
                self.restaurant = rs[0]["subdomain"]
            else:
                die("which restaurant? pass -r SUBDOMAIN (options: " + ", ".join(r["subdomain"] for r in rs) + ")")
        return f"restaurants/{self.restaurant}/{rest}"


def image_payload(src):
    """FILE -> multipart; http(s) URL -> source_url form field."""
    if re.match(r"^https?://", src):
        return {"data": {"source_url": src}, "files": None}
    p = Path(src)
    if not p.exists():
        die(f"no such file: {src}")
    return {"data": {}, "files": {"image": (p.name, p.open("rb"))}}


# ---------------------------------------------------------------- commands

def cmd_me(c, a):
    me = c.req("GET", "me")
    print(f"{me['type']} '{me['name']}'  platform={me['isPlatform']}  scopes={me['scopes']}  (key: {c.key_name})")
    for r in me.get("restaurants", []):
        print(f"  {r['subdomain']:<16} {r['name']:<24} role={r['role']} scopes={r['scopes']} live={r['isLive']} url={r['publicUrl']}")


def _menu(c):
    return c.req("GET", c.rpath("menu"))


def cmd_menu(c, a):
    data = _menu(c)
    if a.json:
        print(json.dumps(data, indent=2))
        return
    total = with_photo = 0
    for cat in data:
        items = cat.get("items", [])
        print(f"\n{cat['name']}  ({len(items)} items)")
        for it in items:
            has = bool(it.get("imageUrl"))
            total += 1
            with_photo += has
            flag = "📷" if has else "  "
            avail = "" if it.get("isAvailable", True) else "  [unavailable]"
            print(f"  {flag} {it['id']:>5}  ${it['priceCents']/100:>6.2f}  {it['name']}{avail}")
    print(f"\n{with_photo}/{total} items have photos")


def cmd_find(c, a):
    q = a.query.lower()
    for cat in _menu(c):
        for it in cat.get("items", []):
            hay = f"{it['name']} {it.get('description') or ''}".lower()
            if q in hay:
                print(f"{it['id']:>5}  {it['name']}  [{cat['name']}]  photo={'yes' if it.get('imageUrl') else 'no'}")
                if it.get("description"):
                    print(f"       {it['description']}")


def cmd_item(c, a):
    for cat in _menu(c):
        for it in cat.get("items", []):
            if it["id"] == a.id:
                it["_category"] = cat["name"]
                print(json.dumps(it, indent=2))
                return
    die(f"no menu item with id {a.id}")


def cmd_upload_image(c, a):
    p = image_payload(a.source)
    it = c.req("POST", c.rpath(f"menu-items/{a.id}/image"), data=p["data"], files=p["files"], timeout=120)
    print(f"set photo on {it['id']} {it['name']}\n  {it['imageMediumUrl']}")


def cmd_remove_image(c, a):
    c.req("DELETE", c.rpath(f"menu-items/{a.id}/image"))
    print(f"removed photo from item {a.id}")


def cmd_set_image(c, a):
    p = image_payload(a.source)
    r = c.req("POST", c.rpath(f"images/{a.kind}"), data=p["data"], files=p["files"], timeout=120)
    print(f"set {a.kind} image\n  {json.dumps(r, indent=2)[:400]}")


def cmd_remove_image_kind(c, a):
    c.req("DELETE", c.rpath(f"images/{a.kind}"))
    print(f"removed {a.kind} image")


def cmd_photos(c, a):
    for ph in c.req("GET", c.rpath("photos")) or []:
        print(f"{ph.get('id'):>5}  pos={ph.get('position')}  {ph.get('caption') or ''}\n       {ph.get('mediumUrl') or ph.get('url')}")


def cmd_add_photo(c, a):
    p = image_payload(a.source)
    if a.caption:
        p["data"]["caption"] = a.caption
    r = c.req("POST", c.rpath("photos"), data=p["data"], files=p["files"], timeout=120)
    print(f"added gallery photo {r.get('id')}\n  {r.get('mediumUrl') or r.get('url')}")


def cmd_remove_photo(c, a):
    c.req("DELETE", c.rpath(f"photos/{a.id}"))
    print(f"removed gallery photo {a.id}")


def cmd_availability(c, a):
    on = a.state in ("on", "true", "1", "yes")
    it = c.req("PATCH", c.rpath(f"menu-items/{a.id}/availability"), json={"is_available": on})
    print(f"{it['name']}: {'available' if it['isAvailable'] else 'unavailable'}")


def cmd_orders(c, a):
    params = {"status": a.status} if a.status else {}
    for o in c.req("GET", c.rpath("orders"), params=params) or []:
        print(f"{o.get('number')}  {o.get('status'):<12} ${o.get('totalCents', 0)/100:>7.2f}  {o.get('placedAt') or o.get('createdAt', '')}")


def cmd_order(c, a):
    print(json.dumps(c.req("GET", c.rpath(f"orders/{a.number}")), indent=2))


def cmd_kitchen(c, a):
    print(json.dumps(c.req("GET", c.rpath("kitchen")), indent=2))


def cmd_keys_create(c, a):
    if os.environ.get("PF_RESTAURANT"):
        die("tenant sessions can't mint keys")
    if not a.restaurant:
        die("-r SUBDOMAIN is required")
    scopes = [s.strip() for s in a.scopes.split(",") if s.strip()]
    body = {"name": a.name, "scopes": scopes}
    if a.expires:
        body["expires_at"] = a.expires
    r = c.req("POST", f"restaurants/{a.restaurant}/api-keys", json=body)
    plain = r["plainTextKey"]
    save = a.save or key_name_for(a.restaurant)
    # Write straight into the toolbelt; never print the key.
    keys = read_toolbelt()
    keys[save] = plain
    TOOLBELT.parent.mkdir(parents=True, exist_ok=True)
    tmp = TOOLBELT.with_suffix(".tmp")
    body = ("# Claude toolbelt keys. Managed by setenv.sh — values never echoed.\n"
            + "".join(f"{k}={v}\n" for k, v in sorted(keys.items())))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)   # private from the first byte
    with os.fdopen(fd, "w") as fh:
        fh.write(body)
    tmp.replace(TOOLBELT)
    k = r["key"]
    print(f"minted key '{k.get('name')}' (id {k.get('id')}) for {a.restaurant} scopes={k.get('scopes')} -> saved as {save} in the toolbelt")


def cmd_doctor(c, a):
    print(f"base: {BASE}\nkey:  {c.key_name}  (PF_RESTAURANT={os.environ.get('PF_RESTAURANT') or '-'})")
    me = c.req("GET", "me")
    print(f"auth: OK as {me['type']} '{me['name']}' scopes={me['scopes']} restaurants={[r['subdomain'] for r in me.get('restaurants', [])]}")


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(prog="pf", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-r", "--restaurant", help="restaurant subdomain (platform keys only)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("me").set_defaults(fn=cmd_me)
    p = sub.add_parser("menu"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_menu)
    p = sub.add_parser("find"); p.add_argument("query"); p.set_defaults(fn=cmd_find)
    p = sub.add_parser("item"); p.add_argument("id", type=int); p.set_defaults(fn=cmd_item)
    p = sub.add_parser("upload-image"); p.add_argument("id", type=int); p.add_argument("source"); p.set_defaults(fn=cmd_upload_image)
    p = sub.add_parser("remove-image"); p.add_argument("id", type=int); p.set_defaults(fn=cmd_remove_image)
    p = sub.add_parser("set-image"); p.add_argument("kind", choices=["logo", "hero", "about"]); p.add_argument("source"); p.set_defaults(fn=cmd_set_image)
    p = sub.add_parser("remove-image-kind"); p.add_argument("kind", choices=["logo", "hero", "about"]); p.set_defaults(fn=cmd_remove_image_kind)
    sub.add_parser("photos").set_defaults(fn=cmd_photos)
    p = sub.add_parser("add-photo"); p.add_argument("source"); p.add_argument("--caption"); p.set_defaults(fn=cmd_add_photo)
    p = sub.add_parser("remove-photo"); p.add_argument("id", type=int); p.set_defaults(fn=cmd_remove_photo)
    p = sub.add_parser("availability"); p.add_argument("id", type=int); p.add_argument("state", choices=["on", "off"]); p.set_defaults(fn=cmd_availability)
    p = sub.add_parser("orders"); p.add_argument("--status"); p.set_defaults(fn=cmd_orders)
    p = sub.add_parser("order"); p.add_argument("number"); p.set_defaults(fn=cmd_order)
    sub.add_parser("kitchen").set_defaults(fn=cmd_kitchen)
    keys = sub.add_parser("keys").add_subparsers(dest="keys_cmd", required=True)
    p = keys.add_parser("create"); p.add_argument("--name", required=True); p.add_argument("--scopes", required=True)
    p.add_argument("--save", help="toolbelt key name (default PLATEFUL_KEY_<SUBDOMAIN>)"); p.add_argument("--expires"); p.set_defaults(fn=cmd_keys_create)
    sub.add_parser("doctor").set_defaults(fn=cmd_doctor)

    a = ap.parse_args()
    a.fn(Client(a.restaurant), a)


if __name__ == "__main__":
    main()
