#!/usr/bin/env python3
"""social — one photo and a line on Facebook, Instagram, X and Google at once
(ROADMAP B19, plan ~/projects/plans/10-social-posting.md).

  social                                   # what's connected here, and the last posts
  social post IMAGE "caption"              # in a client workspace: their Page + Instagram (+ Google if connected)
  social post BRAND IMAGE "caption"        # outside one: the house brand (patchlamp) or --project SLUG
  social post BRAND [N]                    # the oldest queued draft for that brand (or the Nth in `social queue`) — B24's "post" reply
      --only facebook,instagram,google     # a subset (default: every one that is connected)
      --page ID|NAME                       # when more than one Page is connected
      --dry-run                            # prepare the image and say what would go where; post nothing
  social queue                             # house drafts waiting for "post" (~/projects/social/queue/)
  social queue add BRAND IMAGE "caption" [--pillar P] [--topic T] [--mood M] [--art A] [--kind K] [--hold]
      --hold                               # a bare `social post BRAND` skips it; it goes up only by `social post BRAND N`
  social queue drop N
  social check N [--kind text|raccoon|data|pinned]   # one fresh judge looks at draft N's picture (B112)
  social check --image FILE --kind K       #   or at any image; exit 0 pass, 1 fail, 3 unsure, 4 couldn't check
  social connect [BRAND] [--network x]     # the signed link (24h) the account's owner opens to grant it
      --x-text "…"                         # (post) the X version; default: the caption cut to 280, any link kept last
  social ls [BRAND]                        # recent posts with their links
  social doctor

The Page token stays on patchlamp.com: this sends the photo (as a JPEG, at
most 1440px, which is what Instagram takes) and the caption, and prints
what each network answered — a link, or its own refusal, one line each.
Google goes through `gbp post` on the project's Google connection.

Meta's app is in Development mode until App Review (TAYLOR-TODO §1 "Meta
app"): only our own Page and @patchlamp can be connected until then.

Config, by name, never printed:
  PATCHLAMP_RELAY_SHARED_SECRET   ~/.config/claude-tools/env
  PATCHLAMP_URL                   optional; default https://patchlamp.com
  SOCIAL_DIR                      optional; default ~/projects/social (the house queue and posted.jsonl)
  SOCIAL_JUDGE                    optional; a stand-in command for the judge (tests), prompt on stdin
  SOCIAL_JUDGE_MODEL              optional; default opus (never Fable, always named)
  IMG_PATCH_REF                   optional; the portrait the raccoon is compared with
"""

import argparse
import base64
import datetime as dt
import json
import os
import shutil
import subprocess
import sys
import re
import tempfile
import urllib.error
import urllib.request
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import tenant  # noqa: E402  (shared tenant-identity check, B80)

ENV_FILE = Path(os.environ.get("CLAUDE_TOOLS_ENV", Path.home() / ".config/claude-tools/env"))
SOCIAL_DIR = Path(os.environ.get("SOCIAL_DIR", Path.home() / "projects/social"))
HOUSE = ("patchlamp",)   # the one house brand since 2026-09-23 (VISION § Decided)
NETWORKS = ("facebook", "instagram", "x", "google")
MAX_SIDE = 1440
IG_RATIO = (0.8, 1.91)          # Instagram's feed: 4:5 portrait to 1.91:1 landscape
PATCH_REF = Path(os.environ.get("IMG_PATCH_REF", Path.home() / "projects/patchlamp/brand/patch-portrait.jpg"))
KINDS = ("text", "raccoon", "data", "pinned")   # social/calendar.md § Three kinds of post, + the pinned explainer


def die(msg, code=1):
    print(f"social: {msg}", file=sys.stderr)
    sys.exit(code)


def read_env():
    keys = {}
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                keys[k.strip()] = v.strip()
    return keys


def base_url():
    return (os.environ.get("PATCHLAMP_URL") or read_env().get("PATCHLAMP_URL") or "https://patchlamp.com").rstrip("/")


def secret():
    val = os.environ.get("PATCHLAMP_RELAY_SHARED_SECRET") or read_env().get("PATCHLAMP_RELAY_SHARED_SECRET")
    if not val:
        die("PATCHLAMP_RELAY_SHARED_SECRET is not in the toolbelt; this needs Taylor (setenv.sh)")
    return val


def workspace_slug():
    p = Path.cwd() / ".client.json"
    if not p.exists():
        return None
    try:
        slug = json.loads(p.read_text()).get("slug")
    except (ValueError, OSError):
        return None
    tenant.enforce(slug, die)   # B80: the file identity must match the run's RELAY_PROJECT
    return slug


def api(method, path, body=None, ok=(200, 201), timeout=30):
    req = urllib.request.Request(base_url() + path, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": f"Bearer {secret()}", "Accept": "application/json",
                                          "Content-Type": "application/json", "User-Agent": "claude-tools/social"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read().decode() or "{}")
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode(errors="replace")
        try:
            data = json.loads(raw)
        except ValueError:
            data = {"error": raw[:200]}
        if exc.code in ok:
            return exc.code, data
        if exc.code == 404 and "could not be found" in str(data.get("message", "")):
            die("patchlamp.com doesn't have the social endpoints yet (B19 is on `dev`; merge the PR to deploy)")
        die(f"{data.get('error') or data.get('message') or raw[:200]} (HTTP {exc.code})")
    except urllib.error.URLError as exc:
        die(f"{method} {path}: {exc.reason}")


# ---- which project ----------------------------------------------------------------

def resolve(args, positional):
    """(slug, remaining positionals). In a workspace the project is fixed; elsewhere the first word is the brand."""
    ws = workspace_slug()
    if ws:
        if getattr(args, "project", None) and args.project != ws:
            die(f"this workspace is {ws}; it can't post for another project")
        if positional and positional[0] in HOUSE and len(positional) in (1, 3):
            die(f"this workspace is {ws}; house brands are posted from ~/projects")
        return ws, positional
    if getattr(args, "project", None):
        return args.project, positional
    if positional and positional[0] in HOUSE:
        return positional[0], positional[1:]
    die(f"say which brand ({' or '.join(HOUSE)}) or pass --project SLUG")


# ---- the image ---------------------------------------------------------------------

def magick():
    return shutil.which("magick") or shutil.which("convert")


def prepare(src, workdir):
    """A JPEG at most MAX_SIDE on the long side, oriented, no metadata. Returns (path, width, height)."""
    src = Path(src)
    if not src.is_file():
        die(f"{src}: no such file")
    tool = magick()
    if not tool:
        die("ImageMagick is not installed (apt install imagemagick)")
    out = Path(workdir) / (src.stem + ".jpg")
    r = subprocess.run([tool, str(src) + "[0]", "-auto-orient", "-resize", f"{MAX_SIDE}x{MAX_SIDE}>", "-strip",
                        "-background", "white", "-alpha", "remove", "-quality", "88", f"jpg:{out}"],
                       capture_output=True, text=True)
    if r.returncode != 0 or not out.exists():
        die(f"couldn't read {src.name} as an image: {r.stderr.strip()[:160]}")
    ident = shutil.which("identify")
    w = h = 0
    if ident:
        q = subprocess.run([ident, "-format", "%w %h", str(out)], capture_output=True, text=True)
        try:
            w, h = (int(x) for x in q.stdout.split()[:2])
        except ValueError:
            pass
    return out, w, h


# ---- the house queue ---------------------------------------------------------------

def queue_dir():
    return SOCIAL_DIR / "queue"


def drafts(brand=None):
    d = queue_dir()
    out = []
    for p in sorted(d.glob("*.json")) if d.exists() else []:
        try:
            item = json.loads(p.read_text())
        except ValueError:
            continue
        item["_path"] = p
        if brand is None or item.get("brand") == brand:
            out.append(item)
    return out


def log_posted(brand, caption, results, draft=None):
    row = {"date": dt.date.today().isoformat(), "brand": brand, "pillar": (draft or {}).get("pillar"),
           "mood": (draft or {}).get("mood"), "art": (draft or {}).get("art"),
           "topic": (draft or {}).get("topic") or caption.split("\n")[0][:80], "status": "posted",
           "kind": (draft or {}).get("kind"), "check": (draft or {}).get("check"),
           "path": (draft or {}).get("image"), "links": {k: v.get("url") for k, v in results.items() if v.get("ok")}}
    SOCIAL_DIR.mkdir(parents=True, exist_ok=True)
    with (SOCIAL_DIR / "posted.jsonl").open("a") as f:
        f.write(json.dumps(row) + "\n")


# ---- commands -----------------------------------------------------------------------

def connected(slug):
    """(pages, google_connected) for a project."""
    _, social = api("GET", f"/internal/relay/projects/{slug}/social")
    _, conns = api("GET", f"/internal/relay/projects/{slug}/connections", ok=(200, 404))
    google = any(c.get("kind") == "google" and c.get("status") == "connected" for c in conns.get("connections") or [])
    return social, google


def page_line(p):
    ig = f" + @{p['instagram']} on Instagram" if p.get("instagram") else " (no Instagram linked to it yet)"
    return f"  Facebook: {p.get('label')}{ig}"


def cmd_status(args):
    slugs = [workspace_slug()] if workspace_slug() else ([args.project] if args.project else list(HOUSE))
    for slug in slugs:
        social, google = connected(slug)
        print(f"{slug}:")
        pages = social.get("pages") or []
        for p in pages:
            print(page_line(p))
        if not pages:
            print("  Facebook + Instagram: not connected (`social connect" + ("" if workspace_slug() else f" {slug}") + "`)")
        xs = social.get("x") or []
        print(f"  X: {xs[0].get('label') if xs else 'not connected (`social connect' + ('' if workspace_slug() else f' {slug}') + ' --network x`)'}")
        print(f"  Google: {'connected (posts go through gbp)' if google else 'not connected'}")
        for p in (social.get("posts") or [])[:3]:
            print(f"  last: {p['created_at'][:16]} {p['status']} — {p['caption'][:60]}")
    if not workspace_slug():
        q = drafts()
        print(f"queue: {len(q)} draft(s) waiting" + (" — `social queue`" if q else ""))


def cmd_post(args):
    slug, rest = resolve(args, args.words)
    draft = None
    if len(rest) == 0 or (len(rest) == 1 and rest[0].isdigit()):
        if slug not in HOUSE or workspace_slug():
            die('say what to post: social post IMAGE "caption"')
        waiting = drafts(slug)
        if not waiting:
            die(f"nothing queued for {slug} (`social queue add {slug} IMAGE \"caption\"`)")
        if rest:
            n = int(rest[0])                                  # `social post BRAND N` — the Nth draft of `social queue`
        else:                                                 # the oldest that isn't held (a held one waits for its N)
            n = next((i for i, d in enumerate(waiting, 1) if not d.get("hold")), 0)
            if not n:
                die(f"every draft for {slug} is held; `social post {slug} N` puts one up")
        if not 1 <= n <= len(waiting):
            die(f"no draft {n} for {slug}; `social queue` lists {len(waiting)}")
        draft = waiting[n - 1]
        image, caption = draft["image"], draft["caption"]
    elif len(rest) == 2:
        image, caption = rest
    else:
        die('usage: social post [BRAND] IMAGE "caption"  |  social post BRAND [N]')
    caption = caption.strip()
    if not caption:
        die("the caption is empty")
    if len(caption) > 2200:
        die(f"the caption is {len(caption)} characters; Instagram takes 2,200")
    want = [n.strip() for n in args.only.split(",")] if args.only else list(NETWORKS)
    bad = [n for n in want if n not in NETWORKS]
    if bad:
        die(f"unknown network {', '.join(bad)} (facebook, instagram, x, google)")

    social, google = connected(slug)
    pages = social.get("pages") or []
    xs = social.get("x") or []
    meta_nets = [n for n in want if n in ("facebook", "instagram", "x")]     # the ones patchlamp.com posts
    if any(n in meta_nets for n in ("facebook", "instagram")) and not pages:
        if args.only and "x" not in meta_nets:
            die(f"no Facebook Page is connected on {slug} (`social connect`)")
        print(f"  Facebook + Instagram: not connected on {slug} — skipped (`social connect`)")
        meta_nets = [n for n in meta_nets if n == "x"]
    if "x" in meta_nets and not xs:
        if args.only == "x":
            die(f"no X account is connected on {slug} (`social connect --network x`)")
        if args.only:
            print(f"  X: not connected on {slug} — skipped (`social connect --network x`)")
        meta_nets.remove("x")
    if "google" in want and not google:
        if args.only == "google":
            die(f"no Google listing is connected on {slug} (connections google invite)")
        want.remove("google")
        if not args.only:
            print("  Google: not connected — skipped")
    if not meta_nets and "google" not in want:
        die("nothing to post to")

    work = tempfile.mkdtemp(prefix="social-")
    try:
        jpg, w, h = prepare(image, work)
        if "instagram" in meta_nets and w and h and not IG_RATIO[0] <= w / h <= IG_RATIO[1]:
            die(f"the image is {w}x{h}; Instagram takes 4:5 portrait to 1.91:1 landscape. Crop it "
                f"(`magick IN -gravity center -crop 1:1 OUT`) or post with --only facebook,google")
        if args.dry_run:
            print(f"would post {jpg.stat().st_size // 1024} KB, {w}x{h}, to {slug}: "
                  f"{', '.join(meta_nets + (['google'] if 'google' in want else []))}")
            for p in pages:
                print(page_line(p))
            print(f"caption: {caption}")
            return
        results = {}
        public = None
        if meta_nets:
            body = {"image": base64.b64encode(jpg.read_bytes()).decode(), "caption": caption, "networks": meta_nets}
            if args.page:
                body["page"] = args.page
            if args.x_text:
                body["x_text"] = args.x_text
            code, r = api("POST", f"/internal/relay/projects/{slug}/social", body, ok=(201, 409), timeout=180)
            if code == 409:
                die(r.get("error", "refused") + "".join(f"\n  {p.get('external_id')}  {p.get('label')}" for p in r.get("pages") or []))
            results.update((r.get("post") or {}).get("results") or {})
            public = (r.get("post") or {}).get("image_url")
        if "google" in want:
            gbp = shutil.which("gbp") or str(Path(__file__).resolve().parent / "gbp")
            cmd = [gbp] + ([] if workspace_slug() else ["--project", slug]) + ["post", caption, "--photo", public or str(jpg)]
            g = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
            said = (g.stdout.strip() or g.stderr.strip()).splitlines()
            results["google"] = {"ok": g.returncode == 0, "url": None,
                                 **({"said": said[0] if said else "posted"} if g.returncode == 0
                                    else {"error": (g.stderr.strip() or g.stdout.strip())[:200].replace("gbp: ", "")})}
    finally:
        shutil.rmtree(work, ignore_errors=True)

    names = {"facebook": "Facebook", "instagram": "Instagram", "x": "X", "google": "Google"}
    for net in ("facebook", "instagram", "x", "google"):
        if net in results:
            r = results[net]
            print(f"  {names[net]}: " + ((r.get("url") or r.get("said") or "posted") if r.get("ok") else f"not posted — {r.get('error')}"))
    good = [n for n, r in results.items() if r.get("ok")]
    if slug in HOUSE and not workspace_slug() and good:
        log_posted(slug, caption, results, draft)
        if draft:
            draft["_path"].unlink(missing_ok=True)
    if not good:
        sys.exit(1)


def cmd_queue(args):
    if workspace_slug():
        die("the queue is for the house brands; in a workspace, post directly")
    words = args.words
    op = words[0] if words else "ls"
    if op == "ls":
        q = drafts()
        if not q:
            print("no drafts queued")
        for i, d in enumerate(q, 1):
            tags = "".join(f" [{t}]" for t in (d.get("kind"), "held" if d.get("hold") else None,
                                                 (d.get("check") or {}).get("verdict")) if t)
            print(f"  {i}. {d['brand']:<10} {d.get('added', '')[:16]}  {d['caption'][:70]}  ({Path(d['image']).name}){tags}")
        return
    if op == "add":
        if len(words) != 4 or words[1] not in HOUSE:
            die(f'usage: social queue add {"|".join(HOUSE)} IMAGE "caption"')
        brand, src, caption = words[1:]
        src = Path(src).expanduser().resolve()
        if not src.is_file():
            die(f"{src}: no such file")
        queue_dir().mkdir(parents=True, exist_ok=True)
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
        img = queue_dir() / f"{stamp}-{brand}{src.suffix.lower()}"
        shutil.copy2(src, img)
        item = {"brand": brand, "image": str(img), "caption": caption.strip(), "pillar": args.pillar, "topic": args.topic,
                "mood": args.mood, "art": args.art, "kind": args.kind, "hold": bool(args.hold) or None,
                "added": dt.datetime.now().isoformat(timespec="seconds")}
        item = {k: v for k, v in item.items() if v is not None or k in ("pillar", "topic", "mood", "art")}
        (queue_dir() / f"{stamp}-{brand}.json").write_text(json.dumps(item, indent=1) + "\n")
        n = len(drafts(brand))
        print(f"queued for {brand} as draft {n}: {caption.strip()[:70]} — "
              + (f"held: only `social post {brand} {n}` puts it up" if args.hold else f"`social post {brand}` puts it up"))
        return
    if op == "drop" and len(words) == 2 and words[1].isdigit():
        q = drafts()
        i = int(words[1])
        if not 1 <= i <= len(q):
            die(f"no draft {i}")
        d = q[i - 1]
        d["_path"].unlink(missing_ok=True)
        if str(Path(d["image"]).parent) == str(queue_dir()):
            Path(d["image"]).unlink(missing_ok=True)
        print(f"dropped: {d['caption'][:70]}")
        return
    die('usage: social queue [ls | add BRAND IMAGE "caption" | drop N]')


# ---- the check (B112, plan ~/projects/plans/48-feed-one-raccoon.md) ----------------------
# The 2026-10-03 review: eleven posts, nine pictures of Patch as nine different animals, and no
# tile showed a phone, a site or a listing, so the grid didn't say what we sell. The 8am run used
# to look at its own draft; this is a second pair of eyes that has not seen the prompt. It asks
# two questions and leaves the answers to the judge. A judge's doubt is never turned into a fail:
# "unsure" posts with the doubt shown to Taylor, and a judge that couldn't look says why and the
# draft goes to Taylor, instead of being asked again the same way.

JUDGE_MODEL_DEFAULT = "opus"
JUDGE_TIMEOUT = 180          # seconds: three minutes for one look at two pictures
JUDGE_TURNS = 4              # read the draft, read the portrait, answer, one spare
JUDGE_SCRUB = ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL", "CLAUDE_CODE_USE_BEDROCK",
               "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY", "ANTHROPIC_MODEL", "CLAUDE_CONFIG_DIR",
               "CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT")
EXIT = {"pass": 0, "fail": 1, "unsure": 3, "couldnt": 4}
PRODUCT = ("yes", "no", "unsure")
RACCOON = ("same", "different", "absent", "unsure")

JUDGE_PROMPT = """You are looking at one picture for Patchlamp's social feed before it is posted, as a second pair of eyes. You have not seen the prompt that made it, and that is the point.

In this directory: `draft{ext}` is the picture, and `portrait.jpg` is Patch, the raccoon who is the brand's one character. Read both files.

Two questions. Answer each from what you see; there is no answer we are hoping for.

1. Does the picture show what Patchlamp sells? It sells a small business's website and Google listing kept right by text: the owner texts a change and it is done. So the product, in a picture, is something like a phone with a text conversation on it, a website or page layout on a screen, a business listing being fixed, or a before-and-after of one of those. Screens show shapes rather than readable words, because the image generator misspells; message bubbles and a page layout as shapes count. Why it matters: the feed's pictures used to be a raccoon in a different art style each day and nothing else, so a stranger scrolling could not tell what the account sells. Answer "yes", "no" or "unsure", and say what you see in `product_what`.

2. Is the raccoon in the picture the same character as the portrait? The art medium may differ (painted, clay, a flat cartoon); what should carry over is the face and its mask markings, the one notched ear, the old headset with a brass microphone boom, and the general look of him. Why it matters: one recognisable character across posts is what makes the feed read as one company. Answer "same", "different", "absent" (no raccoon in the picture) or "unsure".

"unsure" is a good answer whenever you are unsure; it is passed on to Taylor as your doubt, and it does not block the post. If you could not open or see one of the images, say so: set "looked" to false and say why in "why". That is a fine outcome and goes to Taylor as it is.

Your budget is a few turns and about three minutes: read the two files, then answer. No other tools are needed.

Reply with one JSON object and nothing after it, with these keys:
{{"looked": true or false, "product": one of "yes" / "no" / "unsure", "product_what": "what you see that is or isn't the product", "raccoon": one of "same" / "different" / "absent" / "unsure", "why": "one or two sentences on both answers"}}
"""


def judge_model():
    m = os.environ.get("SOCIAL_JUDGE_MODEL") or JUDGE_MODEL_DEFAULT
    if not m or "fable" in m.lower():
        die(f"judge model {m!r}: the check never runs on Fable, and always with a model named")
    return m


def judge_cmd():
    """The command that runs the judge in its directory, the prompt on stdin. SOCIAL_JUDGE stands in for it
    in the tests (a shell command); otherwise a fresh `claude -p` that can only read, in that directory."""
    if os.environ.get("SOCIAL_JUDGE"):
        return ["sh", "-c", os.environ["SOCIAL_JUDGE"]]
    exe = shutil.which("claude") or "claude"
    return [exe, "-p", "--model", judge_model(), "--output-format", "json", "--restricted",
            "--tools", "Read", "--allowedTools", "Read", "--permission-mode", "dontAsk",
            "--strict-mcp-config", "--disable-slash-commands", "--max-turns", str(JUDGE_TURNS)]


def last_json_object(text):
    """The last {...} in a model's reply that parses as a dict, or None."""
    if not text:
        return None
    for m in reversed(list(re.finditer(r"\{", text))):
        try:
            obj, _ = json.JSONDecoder().raw_decode(text[m.start():])
        except ValueError:
            continue
        if isinstance(obj, dict) and ("product" in obj or "raccoon" in obj or "looked" in obj):
            return obj
    return None


def ask_judge(image):
    """Run one judge on IMAGE beside the portrait. Returns (answer dict or None, why-not text)."""
    if not PATCH_REF.exists():
        return None, f"the portrait to compare with isn't at {PATCH_REF}"
    tmp = tempfile.mkdtemp(prefix="social-check-")
    try:
        ext = Path(image).suffix.lower() or ".jpg"
        shutil.copy2(image, Path(tmp) / f"draft{ext}")
        shutil.copy2(PATCH_REF, Path(tmp) / "portrait.jpg")
        env = {k: v for k, v in os.environ.items() if k not in JUDGE_SCRUB}
        try:
            r = subprocess.run(judge_cmd(), input=JUDGE_PROMPT.format(ext=ext), capture_output=True, text=True,
                               cwd=tmp, env=env, timeout=JUDGE_TIMEOUT)
        except subprocess.TimeoutExpired:
            return None, f"the judge did not answer within {JUDGE_TIMEOUT // 60} minutes"
        except OSError as exc:
            return None, f"the judge could not start ({exc})"
        out = r.stdout or ""
        try:                                   # claude --output-format json wraps the reply
            wrap = json.loads(out)
            if isinstance(wrap, dict) and isinstance(wrap.get("result"), str):
                if wrap.get("is_error"):
                    return None, f"the judge's session ended in an error: {wrap.get('result')[:200]}"
                out = wrap["result"]
        except ValueError:
            pass
        ans = last_json_object(out)
        if ans is None:
            tail = (out.strip() or r.stderr.strip())[-200:]
            return None, f"the judge's answer had no JSON in it (exit {r.returncode}): {tail}"
        return ans, ""
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def recent_kinds(n=6):
    """The kinds of the last n posts. Before B112 posted.jsonl had no kind: a `room` pillar was the raccoon post,
    a `number` pillar the data post, anything else a text post."""
    f = SOCIAL_DIR / "posted.jsonl"
    rows = []
    if f.exists():
        for line in f.read_text().splitlines():
            try:
                rows.append(json.loads(line))
            except ValueError:
                continue
    rows = [r_ for r_ in rows if r_.get("status", "posted") == "posted"][-n:]
    old = {"room": "raccoon", "number": "data", "pinned": "pinned"}
    return [r_.get("kind") or old.get(r_.get("pillar"), "text") for r_ in rows]


def verdict(kind, ans, why_not=""):
    """(verdict, reason) from the judge's answer. Pure, so the tests can walk every branch."""
    if kind == "raccoon" and "raccoon" in recent_kinds():
        return "fail", ("a raccoon-only post already went up in the last six; mood-only is at most one in seven "
                        "(calendar.md § Three kinds of post), so make this one show the product")
    if kind == "data":
        return "pass", "a data post: a stock photo of a real thing, no raccoon and no product picture asked for"
    if ans is None:
        return "couldnt", why_not or "no answer from the judge"
    if ans.get("looked") is False:
        return "couldnt", "the judge couldn't look: " + str(ans.get("why") or "no reason given")
    product, raccoon = str(ans.get("product", "")).lower(), str(ans.get("raccoon", "")).lower()
    if product not in PRODUCT or raccoon not in RACCOON:
        return "couldnt", f"the judge's answer was not one of the choices (product={product!r}, raccoon={raccoon!r})"
    said = f"product {product} ({ans.get('product_what') or '-'}); raccoon {raccoon}. {ans.get('why') or ''}".strip()
    if raccoon == "different":
        return "fail", "a different raccoon from the portrait: " + said
    if product == "no" and kind in ("text", "pinned"):
        return "fail", "no product in the picture: " + said
    if kind == "raccoon" and raccoon == "absent":
        return "fail", "the raccoon post has no raccoon in it: " + said
    if product == "unsure" or raccoon == "unsure":
        return "unsure", "unsure: " + said
    return "pass", said


def kind_of(draft):
    if draft.get("kind") in KINDS:
        return draft["kind"]
    return {"room": "raccoon", "number": "data", "pinned": "pinned"}.get(draft.get("pillar"), "text")


def cmd_check(args):
    draft = None
    if args.image:
        image = Path(args.image).expanduser()
        if not image.is_file():
            die(f"{image}: no such file")
        if not args.kind:
            die("--image needs --kind (text, raccoon, data or pinned)")
        kind = args.kind
    else:
        if len(args.words) != 1 or not args.words[0].isdigit():
            die("usage: social check N [--kind K]  |  social check --image FILE --kind K")
        q = drafts()
        n = int(args.words[0])
        if not 1 <= n <= len(q):
            die(f"no draft {n}; `social queue` lists {len(q)}")
        draft = q[n - 1]
        image = Path(draft["image"])
        kind = args.kind or kind_of(draft)
    ans, why_not = (None, "")
    if kind != "data" and not (kind == "raccoon" and "raccoon" in recent_kinds()):
        ans, why_not = ask_judge(image)
    v, reason = verdict(kind, ans, why_not)
    result = {"verdict": v, "kind": kind, "reason": reason, "answer": ans,
              "model": "stand-in (SOCIAL_JUDGE)" if os.environ.get("SOCIAL_JUDGE") else (None if ans is None else judge_model()),
              "at": dt.datetime.now().isoformat(timespec="seconds")}
    if draft is not None:
        path = draft.pop("_path")
        draft["check"], draft["kind"] = result, kind
        path.write_text(json.dumps(draft, indent=1) + "\n")
    if args.json:
        print(json.dumps(result))
    else:
        print(f"{v}: {reason}" + ("" if v != "couldnt" else
              "\n(send the draft and this line to Taylor and wait for post / swap / skip; don't ask the judge again)"))
    sys.exit(EXIT[v])


def cmd_connect(args):
    slug, _ = resolve(args, args.words)
    if args.network == "x":
        code, r = api("POST", f"/internal/relay/projects/{slug}/connections/x/grant-url", {}, ok=(200, 503))
        if code == 503:
            die(r.get("error", "X is not configured on patchlamp.com"))
        print(f"Open this logged into X as the {slug} account (good for 24 hours) and approve Patchlamp:")
        print(r["url"])
        return
    code, r = api("POST", f"/internal/relay/projects/{slug}/connections/meta/grant-url", {}, ok=(200, 503))
    if code == 503:
        die(r.get("error", "Meta is not configured on patchlamp.com"))
    print(f"Open this logged into Facebook as an admin of the {slug} Page (good for 24 hours), and tick the Page and its Instagram account:")
    print(r["url"])
    if not r.get("reviewed"):
        print("(Meta hasn't reviewed our app yet, so this works only for accounts added to the app — ours. Clients wait on App Review, TAYLOR-TODO §1.)")


def cmd_ls(args):
    slug, _ = resolve(args, args.words)
    _, social = api("GET", f"/internal/relay/projects/{slug}/social")
    posts = social.get("posts") or []
    if not posts:
        print(f"no posts on {slug} yet")
    for p in posts:
        print(f"{p['created_at'][:16]}  {p['status']:<8} {p['caption'][:70]}")
        for net, r in (p.get("results") or {}).items():
            print(f"    {net}: {r.get('url') if r.get('ok') else 'refused — ' + str(r.get('error'))}")


def cmd_doctor(args):
    bad = 0

    def line(ok, text):
        nonlocal bad
        bad += 0 if ok else 1
        print(f"{'ok ' if ok else 'BAD'} {text}")

    s = os.environ.get("PATCHLAMP_RELAY_SHARED_SECRET") or read_env().get("PATCHLAMP_RELAY_SHARED_SECRET")
    line(bool(s), "PATCHLAMP_RELAY_SHARED_SECRET in the toolbelt")
    line(bool(magick()), "ImageMagick (the JPEG Instagram takes)")
    line(bool(shutil.which("gbp")), "gbp on PATH (the Google leg)")
    line(PATCH_REF.exists(), f"the portrait `social check` compares with: {PATCH_REF}")
    line(bool(os.environ.get("SOCIAL_JUDGE") or shutil.which("claude")),
         f"the judge for `social check`: claude on PATH, model {os.environ.get('SOCIAL_JUDGE_MODEL') or JUDGE_MODEL_DEFAULT}")
    if not s:
        sys.exit(1)
    slugs = [workspace_slug()] if workspace_slug() else list(HOUSE)
    code, r = api("POST", f"/internal/relay/projects/{slugs[0]}/connections/meta/grant-url", {}, ok=(200, 503))
    line(code == 200, "Meta app keys on patchlamp.com" + ("" if code == 200 else f" — {r.get('error')}"))
    if code == 200:
        print(f"    app review: {'approved — clients can connect' if r.get('reviewed') else 'not yet (Development mode: our own Page and @patchlamp only)'}")
    code, r = api("POST", f"/internal/relay/projects/{slugs[0]}/connections/x/grant-url", {}, ok=(200, 404, 503))
    line(code == 200, "X app keys on patchlamp.com" + ("" if code == 200 else f" — {r.get('error') or 'the X endpoints are not deployed yet'}"))
    for slug in slugs:
        social, google = connected(slug)
        pages = social.get("pages") or []
        line(bool(pages), f"{slug}: Facebook Page connected" + (f" — {pages[0].get('label')}" if pages else " (`social connect`)"))
        if pages:
            line(any(p.get("instagram") for p in pages), f"{slug}: Instagram linked to the Page"
                 + (f" — @{pages[0]['instagram']}" if pages[0].get("instagram") else " (Page → Settings → Linked accounts)"))
        xs = social.get("x") or []
        print(f"    {slug}: X {xs[0].get('label') + ' connected' if xs else 'not connected (social connect ' + slug + ' --network x)'}")
        print(f"    {slug}: Google {'connected' if google else 'not connected'}")
        last = (social.get("posts") or [None])[0]
        if last:
            print(f"    {slug}: last post {last['created_at'][:16]} {last['status']}")
    if not workspace_slug():
        print(f"    queue: {len(drafts())} draft(s) in {queue_dir()}")
    sys.exit(1 if bad else 0)


def main():
    ap = argparse.ArgumentParser(prog="social", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--project", help="project slug, outside a client workspace")
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("post")
    p.add_argument("words", nargs="*")
    p.add_argument("--only")
    p.add_argument("--page")
    p.add_argument("--x-text", help="the X version, if the caption cut to 280 won't do")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--project", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_post)
    q = sub.add_parser("queue")
    q.add_argument("words", nargs="*")
    q.add_argument("--pillar")
    q.add_argument("--topic")
    q.add_argument("--mood", help="the night-shift mood (social/calendar.md § Three dials)")
    q.add_argument("--art", help="the art style the image was made in")
    q.add_argument("--kind", choices=KINDS, help="text, raccoon, data or pinned (what `social check` holds it to)")
    q.add_argument("--hold", action="store_true", help="a bare `social post BRAND` skips it (the pinned explainer)")
    q.set_defaults(fn=cmd_queue)
    k = sub.add_parser("check", help="one fresh judge looks at a draft's picture: product shown? the same raccoon?")
    k.add_argument("words", nargs="*", help="N, the draft's number in `social queue`")
    k.add_argument("--image", help="any image instead of a queued draft")
    k.add_argument("--kind", choices=KINDS)
    k.add_argument("--json", action="store_true", help="print the result as JSON")
    k.set_defaults(fn=cmd_check)
    for name, fn in (("connect", cmd_connect), ("ls", cmd_ls)):
        c = sub.add_parser(name)
        c.add_argument("words", nargs="*")
        c.add_argument("--project", default=argparse.SUPPRESS)
        if name == "connect":
            c.add_argument("--network", choices=("meta", "x"), default="meta", help="meta (Facebook + Instagram, the default) or x")
        c.set_defaults(fn=fn)
    d = sub.add_parser("doctor")
    d.set_defaults(fn=cmd_doctor)
    args = ap.parse_args()
    if not args.cmd:
        return cmd_status(args)
    args.fn(args)


if __name__ == "__main__":
    main()
