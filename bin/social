#!/usr/bin/env python3
"""social — one photo and a line on Facebook, Instagram, X and Google at once
(ROADMAP B19, plan ~/projects/plans/10-social-posting.md).

  social                                   # what's connected here, and the last posts
  social post IMAGE "caption"              # in a client workspace: their Page + Instagram (+ Google if connected)
  social post BRAND IMAGE "caption"        # outside one: the house brand (patchlamp) or --project SLUG
  social post BRAND [N]                    # the oldest queued draft for that brand (or the Nth in `social queue`) — B24's "post" reply
      --only facebook,instagram,google     # a subset (default: every one that is connected)
      --page ID|NAME                       # when more than one Page is connected
      --dry-run                            # prepare the image and say what would go where; post nothing
  social queue                             # house drafts waiting for "post" (~/projects/social/queue/)
  social queue add BRAND IMAGE "caption" [--pillar P] [--topic T] [--mood M] [--art A] [--kind K] [--hold]
      --hold                               # a bare `social post BRAND` skips it; it goes up only by `social post BRAND N`
  social queue drop N
  social check N [--kind text|raccoon|data|pinned|demo]   # one fresh judge looks at draft N's picture (B112; B129 for demo/text)
  social check --image FILE --kind K       #   or at any image; exit 0 pass, 1 fail, 3 unsure, 4 couldn't check
  social demo --project SLUG --ask "TEXT" [--page /path] [--after DIR] [--out DIR] [--queue "caption"]
                                           # B129: a 1080x1350 tile from a template demo's golden copy, changed by one
                                           # Sonnet run (or by hand, --after); the ask in a bubble, the page, the change boxed
  social packet [--date D] [--topic-line N]   # B133: today's facts quoted from their files -> social/packets/<date>.md
  social draft [--no-codex]                # Opus and Codex each write from the packet (a caption, a ledger, three lines of why)
  social facts [N] | --draft FILE          # code checks every number/price against its re-read line, then a fresh judge; 0 pass, 1 fail, 4 couldn't
  social facts capture CMD ...             # keep a command's output in social/facts/<date>.md so a count from it can be cited
  social pick [--image IMG --mood M --art A]   # the passing drafts picked blind (A/B), a splice re-checked; --image queues the winner
  social receipt [N]                       # each claim beside its source, who wrote it, the verdicts (under 12 lines)
  social lessons [week | propose "rule" ["rule"] | keep N | drop N | retire]   # taste lessons only on Taylor's keep
  social connect [BRAND] [--network x]     # the signed link (24h) the account's owner opens to grant it
      --x-text "…"                         # (post) the X version; default: the caption cut to 280, any link kept last
  social ls [BRAND]                        # recent posts with their links
  social doctor

The Page token stays on patchlamp.com: this sends the photo (as a JPEG, at
most 1440px, which is what Instagram takes) and the caption, and prints
what each network answered — a link, or its own refusal, one line each.
Google goes through `gbp post` on the project's Google connection.

Meta's app is in Development mode until App Review (TAYLOR-TODO §1 "Meta
app"): only our own Page and @patchlamp can be connected until then.

Config, by name, never printed:
  PATCHLAMP_RELAY_SHARED_SECRET   ~/.config/claude-tools/env
  PATCHLAMP_URL                   optional; default https://patchlamp.com
  SOCIAL_DIR                      optional; default ~/projects/social (the house queue and posted.jsonl)
  SOCIAL_JUDGE                    optional; a stand-in command for the judge (tests), prompt on stdin
  SOCIAL_JUDGE_MODEL              optional; default opus (never Fable, always named)
  SOCIAL_DEMO_EDITOR              optional; a stand-in command for the demo's change run (tests), prompt on stdin, cwd the copy
  SOCIAL_DEMO_EDITOR_MODEL        optional; default sonnet
  SOCIAL_DEMO_TIMEOUT             optional; seconds for the change run, default 600
  SOCIAL_CLIENTS                  optional; default ~/projects/clients (where the demos' repos are)
  SOCIAL_DEMO_KEEP                optional; keep the temp dir and the before/after shots beside the tile
  IMG_PATCH_REF                   optional; the portrait the raccoon is compared with
  SOCIAL_WRITER_OPUS / SOCIAL_WRITER_CODEX / SOCIAL_FACTS_JUDGE / SOCIAL_PICKER   stand-ins for tests (prompt on stdin)
  SOCIAL_PICKER_MODEL             optional; default opus (background jobs stay off Fable)
  SOCIAL_LEDGER                   optional; the cost ledger (default IMG_LEDGER's, ~/.local/state/claude-tools/ledger.jsonl)
  SOCIAL_CODEX_TIMEOUT / SOCIAL_WRITER_TIMEOUT   seconds; default 300 each
  SOCIAL_PROJECTS, SOCIAL_MARKETING_DIR, SOCIAL_PRICES_FILE, SOCIAL_TODAY   paths and the date, for tests
"""

import argparse
import base64
import datetime as dt
import difflib
import json
import os
import shutil
import subprocess
import sys
import re
import tempfile
import urllib.error
import urllib.request
from html import unescape
from html.parser import HTMLParser
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import tenant  # noqa: E402  (shared tenant-identity check, B80)

ENV_FILE = Path(os.environ.get("CLAUDE_TOOLS_ENV", Path.home() / ".config/claude-tools/env"))
SOCIAL_DIR = Path(os.environ.get("SOCIAL_DIR", Path.home() / "projects/social"))
HOUSE = ("patchlamp",)   # the one house brand since 2026-09-23 (VISION § Decided)
NETWORKS = ("facebook", "instagram", "x", "google")
MAX_SIDE = 1440
IG_RATIO = (0.8, 1.91)          # Instagram's feed: 4:5 portrait to 1.91:1 landscape
PATCH_REF = Path(os.environ.get("IMG_PATCH_REF", Path.home() / "projects/patchlamp/brand/patch-portrait.jpg"))
KINDS = ("text", "raccoon", "data", "pinned", "demo")   # social/calendar.md § Three kinds of post, + the pinned explainer
                                                        # and the demo tile (B129: a text causing a change on a real demo page)


def die(msg, code=1):
    print(f"social: {msg}", file=sys.stderr)
    sys.exit(code)


def read_env():
    keys = {}
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                keys[k.strip()] = v.strip()
    return keys


def base_url():
    return (os.environ.get("PATCHLAMP_URL") or read_env().get("PATCHLAMP_URL") or "https://patchlamp.com").rstrip("/")


def secret():
    val = os.environ.get("PATCHLAMP_RELAY_SHARED_SECRET") or read_env().get("PATCHLAMP_RELAY_SHARED_SECRET")
    if not val:
        die("PATCHLAMP_RELAY_SHARED_SECRET is not in the toolbelt; this needs Taylor (setenv.sh)")
    return val


def workspace_slug():
    p = Path.cwd() / ".client.json"
    if not p.exists():
        return None
    try:
        slug = json.loads(p.read_text()).get("slug")
    except (ValueError, OSError):
        return None
    tenant.enforce(slug, die)   # B80: the file identity must match the run's RELAY_PROJECT
    return slug


def api(method, path, body=None, ok=(200, 201), timeout=30):
    req = urllib.request.Request(base_url() + path, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": f"Bearer {secret()}", "Accept": "application/json",
                                          "Content-Type": "application/json", "User-Agent": "claude-tools/social"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read().decode() or "{}")
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode(errors="replace")
        try:
            data = json.loads(raw)
        except ValueError:
            data = {"error": raw[:200]}
        if exc.code in ok:
            return exc.code, data
        if exc.code == 404 and "could not be found" in str(data.get("message", "")):
            die("patchlamp.com doesn't have the social endpoints yet (B19 is on `dev`; merge the PR to deploy)")
        die(f"{data.get('error') or data.get('message') or raw[:200]} (HTTP {exc.code})")
    except urllib.error.URLError as exc:
        die(f"{method} {path}: {exc.reason}")


# ---- which project ----------------------------------------------------------------

def resolve(args, positional):
    """(slug, remaining positionals). In a workspace the project is fixed; elsewhere the first word is the brand."""
    ws = workspace_slug()
    if ws:
        if getattr(args, "project", None) and args.project != ws:
            die(f"this workspace is {ws}; it can't post for another project")
        if positional and positional[0] in HOUSE and len(positional) in (1, 3):
            die(f"this workspace is {ws}; house brands are posted from ~/projects")
        return ws, positional
    if getattr(args, "project", None):
        return args.project, positional
    if positional and positional[0] in HOUSE:
        return positional[0], positional[1:]
    die(f"say which brand ({' or '.join(HOUSE)}) or pass --project SLUG")


# ---- the image ---------------------------------------------------------------------

def magick():
    return shutil.which("magick") or shutil.which("convert")


def prepare(src, workdir):
    """A JPEG at most MAX_SIDE on the long side, oriented, no metadata. Returns (path, width, height)."""
    src = Path(src)
    if not src.is_file():
        die(f"{src}: no such file")
    tool = magick()
    if not tool:
        die("ImageMagick is not installed (apt install imagemagick)")
    out = Path(workdir) / (src.stem + ".jpg")
    r = subprocess.run([tool, str(src) + "[0]", "-auto-orient", "-resize", f"{MAX_SIDE}x{MAX_SIDE}>", "-strip",
                        "-background", "white", "-alpha", "remove", "-quality", "88", f"jpg:{out}"],
                       capture_output=True, text=True)
    if r.returncode != 0 or not out.exists():
        die(f"couldn't read {src.name} as an image: {r.stderr.strip()[:160]}")
    ident = shutil.which("identify")
    w = h = 0
    if ident:
        q = subprocess.run([ident, "-format", "%w %h", str(out)], capture_output=True, text=True)
        try:
            w, h = (int(x) for x in q.stdout.split()[:2])
        except ValueError:
            pass
    return out, w, h


# ---- the house queue ---------------------------------------------------------------

def queue_dir():
    return SOCIAL_DIR / "queue"


def drafts(brand=None):
    d = queue_dir()
    out = []
    for p in sorted(d.glob("*.json")) if d.exists() else []:
        try:
            item = json.loads(p.read_text())
        except ValueError:
            continue
        item["_path"] = p
        if brand is None or item.get("brand") == brand:
            out.append(item)
    return out


def log_posted(brand, caption, results, draft=None):
    row = {"date": dt.date.today().isoformat(), "brand": brand, "pillar": (draft or {}).get("pillar"),
           "mood": (draft or {}).get("mood"), "art": (draft or {}).get("art"),
           "topic": (draft or {}).get("topic") or caption.split("\n")[0][:80], "status": "posted",
           "kind": (draft or {}).get("kind"), "check": (draft or {}).get("check"),
           "path": (draft or {}).get("image"), "caption": caption, "links": {k: v.get("url") for k, v in results.items() if v.get("ok")}}
    SOCIAL_DIR.mkdir(parents=True, exist_ok=True)
    with (SOCIAL_DIR / "posted.jsonl").open("a") as f:
        f.write(json.dumps(row) + "\n")


# ---- commands -----------------------------------------------------------------------

def connected(slug):
    """(pages, google_connected) for a project."""
    _, social = api("GET", f"/internal/relay/projects/{slug}/social")
    _, conns = api("GET", f"/internal/relay/projects/{slug}/connections", ok=(200, 404))
    google = any(c.get("kind") == "google" and c.get("status") == "connected" for c in conns.get("connections") or [])
    return social, google


def page_line(p):
    ig = f" + @{p['instagram']} on Instagram" if p.get("instagram") else " (no Instagram linked to it yet)"
    return f"  Facebook: {p.get('label')}{ig}"


def unchecked_words(draft):
    """Why a queued house draft may not post without --unchecked, or ''. B133: the words are gated in code, not
    by the mode line's wording. A draft made by `social pick` (it carries `day`) posts only when its facts
    passed; any other draft of today's kind (the 8am run's shape) is refused; a held draft (the pinned explainer)
    and a draft of another kind than today's are Taylor's own and pass."""
    if draft.get("day"):
        return "" if draft.get("facts") == "pass" else f"its fact check was {draft.get('facts') or 'not run'}"
    if draft.get("hold"):
        return ""
    try:
        wd = dt.date.fromisoformat(os.environ.get("SOCIAL_TODAY") or dt.date.today().isoformat()).weekday()
    except ValueError:
        return ""
    today_kind = DAY_PLAN.get(wd, (None,))[0]
    kind = kind_of(draft)
    if kind == "demo":           # B129: a demo tile is what a text day posts, so its words are held the same way
        kind = "text"
    if today_kind and kind == today_kind:
        return f"a {today_kind} draft that `social pick` didn't make"
    return ""


def cmd_status(args):
    slugs = [workspace_slug()] if workspace_slug() else ([args.project] if args.project else list(HOUSE))
    for slug in slugs:
        social, google = connected(slug)
        print(f"{slug}:")
        pages = social.get("pages") or []
        for p in pages:
            print(page_line(p))
        if not pages:
            print("  Facebook + Instagram: not connected (`social connect" + ("" if workspace_slug() else f" {slug}") + "`)")
        xs = social.get("x") or []
        print(f"  X: {xs[0].get('label') if xs else 'not connected (`social connect' + ('' if workspace_slug() else f' {slug}') + ' --network x`)'}")
        print(f"  Google: {'connected (posts go through gbp)' if google else 'not connected'}")
        for p in (social.get("posts") or [])[:3]:
            print(f"  last: {p['created_at'][:16]} {p['status']} — {p['caption'][:60]}")
    if not workspace_slug():
        q = drafts()
        print(f"queue: {len(q)} draft(s) waiting" + (" — `social queue`" if q else ""))


def cmd_post(args):
    slug, rest = resolve(args, args.words)
    draft = None
    if len(rest) == 0 or (len(rest) == 1 and rest[0].isdigit()):
        if slug not in HOUSE or workspace_slug():
            die('say what to post: social post IMAGE "caption"')
        waiting = drafts(slug)
        if not waiting:
            die(f"nothing queued for {slug} (`social queue add {slug} IMAGE \"caption\"`)")
        if rest:
            n = int(rest[0])                                  # `social post BRAND N` — the Nth draft of `social queue`
        else:                                                 # the oldest that isn't held (a held one waits for its N)
            n = next((i for i, d in enumerate(waiting, 1) if not d.get("hold")), 0)
            if not n:
                die(f"every draft for {slug} is held; `social post {slug} N` puts one up")
        if not 1 <= n <= len(waiting):
            die(f"no draft {n} for {slug}; `social queue` lists {len(waiting)}")
        draft = waiting[n - 1]
        image, caption = draft["image"], draft["caption"]
        why = unchecked_words(draft)
        if why and not args.unchecked:
            die(f"unchecked words: run social facts/pick ({why}). Taylor can post it as it is with --unchecked, by hand")
    elif len(rest) == 2:
        image, caption = rest
    else:
        die('usage: social post [BRAND] IMAGE "caption"  |  social post BRAND [N]')
    caption = caption.strip()
    if not caption:
        die("the caption is empty")
    if len(caption) > 2200:
        die(f"the caption is {len(caption)} characters; Instagram takes 2,200")
    want = [n.strip() for n in args.only.split(",")] if args.only else list(NETWORKS)
    bad = [n for n in want if n not in NETWORKS]
    if bad:
        die(f"unknown network {', '.join(bad)} (facebook, instagram, x, google)")

    social, google = connected(slug)
    pages = social.get("pages") or []
    xs = social.get("x") or []
    meta_nets = [n for n in want if n in ("facebook", "instagram", "x")]     # the ones patchlamp.com posts
    if any(n in meta_nets for n in ("facebook", "instagram")) and not pages:
        if args.only and "x" not in meta_nets:
            die(f"no Facebook Page is connected on {slug} (`social connect`)")
        print(f"  Facebook + Instagram: not connected on {slug} — skipped (`social connect`)")
        meta_nets = [n for n in meta_nets if n == "x"]
    if "x" in meta_nets and not xs:
        if args.only == "x":
            die(f"no X account is connected on {slug} (`social connect --network x`)")
        if args.only:
            print(f"  X: not connected on {slug} — skipped (`social connect --network x`)")
        meta_nets.remove("x")
    if "google" in want and not google:
        if args.only == "google":
            die(f"no Google listing is connected on {slug} (connections google invite)")
        want.remove("google")
        if not args.only:
            print("  Google: not connected — skipped")
    if not meta_nets and "google" not in want:
        die("nothing to post to")

    work = tempfile.mkdtemp(prefix="social-")
    try:
        jpg, w, h = prepare(image, work)
        if "instagram" in meta_nets and w and h and not IG_RATIO[0] <= w / h <= IG_RATIO[1]:
            die(f"the image is {w}x{h}; Instagram takes 4:5 portrait to 1.91:1 landscape. Crop it "
                f"(`magick IN -gravity center -crop 1:1 OUT`) or post with --only facebook,google")
        if args.dry_run:
            print(f"would post {jpg.stat().st_size // 1024} KB, {w}x{h}, to {slug}: "
                  f"{', '.join(meta_nets + (['google'] if 'google' in want else []))}")
            for p in pages:
                print(page_line(p))
            print(f"caption: {caption}")
            return
        results = {}
        public = None
        if meta_nets:
            body = {"image": base64.b64encode(jpg.read_bytes()).decode(), "caption": caption, "networks": meta_nets}
            if args.page:
                body["page"] = args.page
            if args.x_text:
                body["x_text"] = args.x_text
            code, r = api("POST", f"/internal/relay/projects/{slug}/social", body, ok=(201, 409), timeout=180)
            if code == 409:
                die(r.get("error", "refused") + "".join(f"\n  {p.get('external_id')}  {p.get('label')}" for p in r.get("pages") or []))
            results.update((r.get("post") or {}).get("results") or {})
            public = (r.get("post") or {}).get("image_url")
        if "google" in want:
            gbp = shutil.which("gbp") or str(Path(__file__).resolve().parent / "gbp")
            cmd = [gbp] + ([] if workspace_slug() else ["--project", slug]) + ["post", caption, "--photo", public or str(jpg)]
            g = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
            said = (g.stdout.strip() or g.stderr.strip()).splitlines()
            results["google"] = {"ok": g.returncode == 0, "url": None,
                                 **({"said": said[0] if said else "posted"} if g.returncode == 0
                                    else {"error": (g.stderr.strip() or g.stdout.strip())[:200].replace("gbp: ", "")})}
    finally:
        shutil.rmtree(work, ignore_errors=True)

    names = {"facebook": "Facebook", "instagram": "Instagram", "x": "X", "google": "Google"}
    for net in ("facebook", "instagram", "x", "google"):
        if net in results:
            r = results[net]
            print(f"  {names[net]}: " + ((r.get("url") or r.get("said") or "posted") if r.get("ok") else f"not posted — {r.get('error')}"))
    good = [n for n, r in results.items() if r.get("ok")]
    if slug in HOUSE and not workspace_slug() and good:
        log_posted(slug, caption, results, draft)
        if draft:
            draft["_path"].unlink(missing_ok=True)
    if not good:
        sys.exit(1)


def cmd_queue(args):
    if workspace_slug():
        die("the queue is for the house brands; in a workspace, post directly")
    words = args.words
    op = words[0] if words else "ls"
    if op == "ls":
        q = drafts()
        if not q:
            print("no drafts queued")
        for i, d in enumerate(q, 1):
            tags = "".join(f" [{t}]" for t in (d.get("kind"), "held" if d.get("hold") else None,
                                                 (d.get("check") or {}).get("verdict")) if t)
            print(f"  {i}. {d['brand']:<10} {d.get('added', '')[:16]}  {d['caption'][:70]}  ({Path(d['image']).name}){tags}")
        return
    if op == "add":
        if len(words) != 4 or words[1] not in HOUSE:
            die(f'usage: social queue add {"|".join(HOUSE)} IMAGE "caption"')
        brand, src, caption = words[1:]
        src = Path(src).expanduser().resolve()
        if not src.is_file():
            die(f"{src}: no such file")
        queue_dir().mkdir(parents=True, exist_ok=True)
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
        img = queue_dir() / f"{stamp}-{brand}{src.suffix.lower()}"
        shutil.copy2(src, img)
        item = {"brand": brand, "image": str(img), "caption": caption.strip(), "pillar": args.pillar, "topic": args.topic,
                "mood": args.mood, "art": args.art, "kind": args.kind, "hold": bool(args.hold) or None,
                "added": dt.datetime.now().isoformat(timespec="seconds")}
        item = {k: v for k, v in item.items() if v is not None or k in ("pillar", "topic", "mood", "art")}
        (queue_dir() / f"{stamp}-{brand}.json").write_text(json.dumps(item, indent=1) + "\n")
        n = len(drafts(brand))
        print(f"queued for {brand} as draft {n}: {caption.strip()[:70]} — "
              + (f"held: only `social post {brand} {n}` puts it up" if args.hold else f"`social post {brand}` puts it up"))
        return
    if op == "drop" and len(words) == 2 and words[1].isdigit():
        q = drafts()
        i = int(words[1])
        if not 1 <= i <= len(q):
            die(f"no draft {i}")
        d = q[i - 1]
        d["_path"].unlink(missing_ok=True)
        if str(Path(d["image"]).parent) == str(queue_dir()):
            Path(d["image"]).unlink(missing_ok=True)
        print(f"dropped: {d['caption'][:70]}")
        return
    die('usage: social queue [ls | add BRAND IMAGE "caption" | drop N]')


# ---- the check (B112, plan ~/projects/plans/48-feed-one-raccoon.md) ----------------------
# The 2026-10-03 review: eleven posts, nine pictures of Patch as nine different animals, and no
# tile showed a phone, a site or a listing, so the grid didn't say what we sell. The 8am run used
# to look at its own draft; this is a second pair of eyes that has not seen the prompt. It asks
# two questions and leaves the answers to the judge. A judge's doubt is never turned into a fail:
# "unsure" posts with the doubt shown to Taylor, and a judge that couldn't look says why and the
# draft goes to Taylor, instead of being asked again the same way.

JUDGE_MODEL_DEFAULT = "opus"
JUDGE_TIMEOUT = 180          # seconds: three minutes for one look at two pictures
JUDGE_TURNS = 4              # read the draft, read the portrait, answer, one spare
JUDGE_SCRUB = ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL", "CLAUDE_CODE_USE_BEDROCK",
               "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY", "ANTHROPIC_MODEL", "CLAUDE_CONFIG_DIR",
               "CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT")
EXIT = {"pass": 0, "fail": 1, "unsure": 3, "couldnt": 4}
PRODUCT = ("yes", "no", "unsure")
RACCOON = ("same", "different", "absent", "unsure")
CHANGE = ("yes", "no", "unsure")
CHANGE_KINDS = ("demo", "text")   # B129: these are asked "can you see what changed on the page?" in place of "is a product in frame"

JUDGE_PROMPT = """You are looking at one picture for Patchlamp's social feed before it is posted, as a second pair of eyes. You have not seen the prompt that made it, and that is the point.

In this directory: `draft{ext}` is the picture, and `portrait.jpg` is Patch, the raccoon who is the brand's one character. Read both files.

Two questions. Answer each from what you see; there is no answer we are hoping for.

1. Does the picture show what Patchlamp sells? It sells a small business's website and Google listing kept right by text: the owner texts a change and it is done. So the product, in a picture, is something like a phone with a text conversation on it, a website or page layout on a screen, a business listing being fixed, or a before-and-after of one of those. Screens show shapes rather than readable words, because the image generator misspells; message bubbles and a page layout as shapes count. Why it matters: the feed's pictures used to be a raccoon in a different art style each day and nothing else, so a stranger scrolling could not tell what the account sells. Answer "yes", "no" or "unsure", and say what you see in `product_what`.

2. Is the raccoon in the picture the same character as the portrait? The art medium may differ (painted, clay, a flat cartoon); what should carry over is the face and its mask markings, the one notched ear, the old headset with a brass microphone boom, and the general look of him. Why it matters: one recognisable character across posts is what makes the feed read as one company. Answer "same", "different", "absent" (no raccoon in the picture) or "unsure".

"unsure" is a good answer whenever you are unsure; it is passed on to Taylor as your doubt, and it does not block the post. If you could not open or see one of the images, say so: set "looked" to false and say why in "why". That is a fine outcome and goes to Taylor as it is.

Your budget is a few turns and about three minutes: read the two files, then answer. No other tools are needed.

Reply with one JSON object and nothing after it, with these keys:
{{"looked": true or false, "product": one of "yes" / "no" / "unsure", "product_what": "what you see that is or isn't the product", "raccoon": one of "same" / "different" / "absent" / "unsure", "why": "one or two sentences on both answers"}}
"""


# B129 (plan ~/projects/plans/51-feed-shows-the-change.md): a drawn phone is still a picture of the idea, so a text or
# demo post is asked whether a stranger can see what a text changed on a page. The judge says what it read as the ask
# and the change, which is the cold read the feed is for; "unsure" posts with the doubt shown, as before.
CHANGE_PROMPT = """You are looking at one picture for Patchlamp's social feed before it is posted, as a second pair of eyes. You have not seen how it was made, and that is the point.

In this directory: `draft{ext}` is the picture{portrait_file}. Read {files}.

Patchlamp keeps a small business's website and Google listing right by text: the owner texts a change and it is done. A picture for this feed is meant to show that happening: a text asking for something, and a web page where the thing asked for has changed. Why it matters: the feed used to show a raccoon holding a drawn phone, and a drawn phone is still a picture of the idea; a stranger scrolling should be able to see a text cause a change on a page. Answer from what you see; there is no answer we are hoping for.

1. Can you see what changed on the page? Say what was asked, as you read it in the picture, and what changed on the page, in your own words. Answer "yes" if you can point to the change, "no" if there is no page to see or nothing on it you can tell was changed, or "unsure".
{raccoon_q}
"unsure" is a good answer whenever you are unsure; it is passed on to Taylor as your doubt, and it does not block the post. If you could not open or see the picture, say so: set "looked" to false and say why in "why". That is a fine outcome and goes to Taylor as it is.

Your budget is a few turns and about three minutes: read the {nfiles}, then answer. No other tools are needed.

Reply with one JSON object and nothing after it, with these keys:
{{"looked": true or false, "change": one of "yes" / "no" / "unsure", "asked": "what was asked, as you read it, or empty", "changed": "what changed on the page, as you see it, or empty",{raccoon_key} "why": "one or two sentences"}}
"""

CHANGE_RACCOON_Q = """
2. Is the raccoon in the picture the same character as the portrait? The art medium may differ (painted, clay, a flat cartoon); what should carry over is the face and its mask markings, the one notched ear, the old headset with a brass microphone boom, and the general look of him. Why it matters: one recognisable character across posts is what makes the feed read as one company. Answer "same", "different", "absent" (no raccoon in the picture) or "unsure".
"""


def judge_prompt(kind, ext):
    """The judge's question for KIND. A demo tile's portrait is pasted in by code, so it isn't asked about."""
    if kind == "demo":
        return CHANGE_PROMPT.format(ext=ext, portrait_file="", files="it", nfiles="file", raccoon_q="", raccoon_key="")
    if kind == "text":
        return CHANGE_PROMPT.format(ext=ext, portrait_file=", and `portrait.jpg` is Patch, the raccoon who is the brand's one character",
                                    files="both files", nfiles="two files", raccoon_q=CHANGE_RACCOON_Q,
                                    raccoon_key=' "raccoon": one of "same" / "different" / "absent" / "unsure",')
    return JUDGE_PROMPT.format(ext=ext)


def judge_model():
    m = os.environ.get("SOCIAL_JUDGE_MODEL") or JUDGE_MODEL_DEFAULT
    if not m or "fable" in m.lower():
        die(f"judge model {m!r}: the check never runs on Fable, and always with a model named")
    return m


def judge_cmd():
    """The command that runs the judge in its directory, the prompt on stdin. SOCIAL_JUDGE stands in for it
    in the tests (a shell command); otherwise a fresh `claude -p` that can only read, in that directory."""
    if os.environ.get("SOCIAL_JUDGE"):
        return ["sh", "-c", os.environ["SOCIAL_JUDGE"]]
    exe = shutil.which("claude") or "claude"
    return [exe, "-p", "--model", judge_model(), "--output-format", "json", "--restricted",
            "--tools", "Read", "--allowedTools", "Read", "--permission-mode", "dontAsk",
            "--strict-mcp-config", "--disable-slash-commands", "--max-turns", str(JUDGE_TURNS)]


def last_json_object(text):
    """The last {...} in a model's reply that parses as a dict, or None."""
    if not text:
        return None
    for m in reversed(list(re.finditer(r"\{", text))):
        try:
            obj, _ = json.JSONDecoder().raw_decode(text[m.start():])
        except ValueError:
            continue
        if isinstance(obj, dict) and ("product" in obj or "raccoon" in obj or "looked" in obj or "change" in obj):
            return obj
    return None


def ask_judge(image, kind="text"):
    """Run one judge on IMAGE (beside the portrait, unless it's a demo tile). Returns (answer dict or None, why-not)."""
    if kind != "demo" and not PATCH_REF.exists():
        return None, f"the portrait to compare with isn't at {PATCH_REF}"
    tmp = tempfile.mkdtemp(prefix="social-check-")
    try:
        ext = Path(image).suffix.lower() or ".jpg"
        shutil.copy2(image, Path(tmp) / f"draft{ext}")
        if kind != "demo":
            shutil.copy2(PATCH_REF, Path(tmp) / "portrait.jpg")
        env = {k: v for k, v in os.environ.items() if k not in JUDGE_SCRUB}
        try:
            r = subprocess.run(judge_cmd(), input=judge_prompt(kind, ext), capture_output=True, text=True,
                               cwd=tmp, env=env, timeout=JUDGE_TIMEOUT)
        except subprocess.TimeoutExpired:
            return None, f"the judge did not answer within {JUDGE_TIMEOUT // 60} minutes"
        except OSError as exc:
            return None, f"the judge could not start ({exc})"
        out = r.stdout or ""
        try:                                   # claude --output-format json wraps the reply
            wrap = json.loads(out)
            if isinstance(wrap, dict) and isinstance(wrap.get("result"), str):
                if wrap.get("is_error"):
                    return None, f"the judge's session ended in an error: {wrap.get('result')[:200]}"
                out = wrap["result"]
        except ValueError:
            pass
        ans = last_json_object(out)
        if ans is None:
            tail = (out.strip() or r.stderr.strip())[-200:]
            return None, f"the judge's answer had no JSON in it (exit {r.returncode}): {tail}"
        return ans, ""
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def recent_kinds(n=6):
    """The kinds of the last n posts. Before B112 posted.jsonl had no kind: a `room` pillar was the raccoon post,
    a `number` pillar the data post, anything else a text post."""
    f = SOCIAL_DIR / "posted.jsonl"
    rows = []
    if f.exists():
        for line in f.read_text().splitlines():
            try:
                rows.append(json.loads(line))
            except ValueError:
                continue
    rows = [r_ for r_ in rows if r_.get("status", "posted") == "posted"][-n:]
    old = {"room": "raccoon", "number": "data", "pinned": "pinned"}
    return [r_.get("kind") or old.get(r_.get("pillar"), "text") for r_ in rows]


def verdict(kind, ans, why_not=""):
    """(verdict, reason) from the judge's answer. Pure, so the tests can walk every branch."""
    if kind == "raccoon" and "raccoon" in recent_kinds():
        return "fail", ("a raccoon-only post already went up in the last six; mood-only is at most one in seven "
                        "(calendar.md § Three kinds of post), so make this one show the product")
    if kind == "data":
        return "pass", "a data post: a stock photo of a real thing, no raccoon and no product picture asked for"
    if ans is None:
        return "couldnt", why_not or "no answer from the judge"
    if ans.get("looked") is False:
        return "couldnt", "the judge couldn't look: " + str(ans.get("why") or "no reason given")
    if kind in CHANGE_KINDS:
        return change_verdict(kind, ans)
    product, raccoon = str(ans.get("product", "")).lower(), str(ans.get("raccoon", "")).lower()
    if product not in PRODUCT or raccoon not in RACCOON:
        return "couldnt", f"the judge's answer was not one of the choices (product={product!r}, raccoon={raccoon!r})"
    said = f"product {product} ({ans.get('product_what') or '-'}); raccoon {raccoon}. {ans.get('why') or ''}".strip()
    if raccoon == "different":
        return "fail", "a different raccoon from the portrait: " + said
    if product == "no" and kind in ("text", "pinned"):
        return "fail", "no product in the picture: " + said
    if kind == "raccoon" and raccoon == "absent":
        return "fail", "the raccoon post has no raccoon in it: " + said
    if product == "unsure" or raccoon == "unsure":
        return "unsure", "unsure: " + said
    return "pass", said


def change_verdict(kind, ans):
    """A demo or text post: can a stranger see what the text changed on the page? (B129)"""
    change = str(ans.get("change", "")).lower()
    raccoon = str(ans.get("raccoon", "")).lower() if kind == "text" else ""
    if change not in CHANGE or (kind == "text" and raccoon not in RACCOON):
        return "couldnt", (f"the judge's answer was not one of the choices (change={change!r}"
                           + (f", raccoon={raccoon!r})" if kind == "text" else ")"))
    said = (f"change {change} (asked: {ans.get('asked') or '-'}; changed: {ans.get('changed') or '-'})"
            + (f"; raccoon {raccoon}" if raccoon else "") + f". {ans.get('why') or ''}").strip()
    if raccoon == "different":
        return "fail", "a different raccoon from the portrait: " + said
    if change == "no":
        return "fail", "the judge can't see what changed on the page: " + said
    if change == "unsure" or raccoon == "unsure":
        return "unsure", "unsure: " + said
    return "pass", said


def kind_of(draft):
    if draft.get("kind") in KINDS:
        return draft["kind"]
    return {"room": "raccoon", "number": "data", "pinned": "pinned"}.get(draft.get("pillar"), "text")


def cmd_check(args):
    draft = None
    if args.image:
        image = Path(args.image).expanduser()
        if not image.is_file():
            die(f"{image}: no such file")
        if not args.kind:
            die("--image needs --kind (text, raccoon, data, pinned or demo)")
        kind = args.kind
    else:
        if len(args.words) != 1 or not args.words[0].isdigit():
            die("usage: social check N [--kind K]  |  social check --image FILE --kind K")
        q = drafts()
        n = int(args.words[0])
        if not 1 <= n <= len(q):
            die(f"no draft {n}; `social queue` lists {len(q)}")
        draft = q[n - 1]
        image = Path(draft["image"])
        kind = args.kind or kind_of(draft)
    ans, why_not = (None, "")
    if kind != "data" and not (kind == "raccoon" and "raccoon" in recent_kinds()):
        ans, why_not = ask_judge(image, kind)
    v, reason = verdict(kind, ans, why_not)
    result = {"verdict": v, "kind": kind, "reason": reason, "answer": ans,
              "model": "stand-in (SOCIAL_JUDGE)" if os.environ.get("SOCIAL_JUDGE") else (None if ans is None else judge_model()),
              "at": dt.datetime.now().isoformat(timespec="seconds")}
    if draft is not None:
        path = draft.pop("_path")
        draft["check"], draft["kind"] = result, kind
        path.write_text(json.dumps(draft, indent=1) + "\n")
    if args.json:
        print(json.dumps(result))
    else:
        print(f"{v}: {reason}" + ("" if v != "couldnt" else
              "\n(send the draft and this line to Taylor and wait for post / swap / skip; don't ask the judge again)"))
    sys.exit(EXIT[v])


# ---- a feed you can trust (B133, plan ~/projects/plans/54-a-feed-you-can-trust.md) --------------
# What got through before this: the 2026-10-03 post's "24 / 12 / 7" were in no file, the 2026-09-29
# post said more than its stat, and a topic line outlived its corrected brief by a week. The run
# that wrote a caption also traced its own numbers, and the only other judge looked at the picture.
# So: the facts a writer may use are quoted from their files by code (`packet`), two writers draft
# from the same packet (`draft`), the words are checked by code and then by a judge that never saw
# the writer's reasons (`facts`), a blind pick chooses (`pick`), and the morning's message carries
# each claim beside its source (`receipt`). Fact lessons are written by code; taste lessons only on
# Taylor's Sunday `keep N`, because an argument that persuades a model is not evidence.

PROJECTS = Path(os.environ.get("SOCIAL_PROJECTS", Path.home() / "projects"))
MARKETING = Path(os.environ.get("SOCIAL_MARKETING_DIR", PROJECTS / "marketing"))
PRICES_FILE = Path(os.environ.get("SOCIAL_PRICES_FILE", PROJECTS / "patchlamp/app/Support/Prices.php"))
WRITER_TIMEOUT = int(os.environ.get("SOCIAL_WRITER_TIMEOUT", "300"))     # five minutes a writer
CODEX_TIMEOUT = int(os.environ.get("SOCIAL_CODEX_TIMEOUT", str(WRITER_TIMEOUT)))
FACTS_TIMEOUT = 180                                                         # three minutes for the judge
PICK_TIMEOUT = 180                                                          # three for the picker
FACTS_EXIT = {"pass": 0, "fail": 1, "couldnt": 4}
FACT_VERDICTS = ("supported", "not supported", "unsure", "no claim")
LESSONS_CAP = 30
TASTE_CAP = 12
SIGNOFFS = ("patched.", "all it takes is a text.")
# weekday -> (kind, the topic pillars to draw from, in order); calendar.md § Leans by weekday
DAY_PLAN = {0: ("text", ["ask", "fix"]), 1: ("data", ["number"]), 2: ("text", ["nothing", "how"]),
            3: ("data", ["number"]), 4: ("raccoon", ["room"]), 5: ("text", ["stepin", "thread", "ask"])}
# a topic line that says it waits on something code can't confirm is not drawn by itself
GATED = ("only after", "after s1", "after a real", "post only once", "citable only once", "ask first",
         "restaurant day only", "empty on purpose", "only once stripe", "not before /pricing")
LINK_CLAIMS = {"/check": ["Free no account nothing to sign What's wrong with your Google listing check",
                          "business name goes in reads that listing live opens the website link the way the census did"],
               "/templates": ["Each demo is a real site anyone can text templates"]}
SOURCE_FILES = {"DATA_STORY": "client-leads/DATA_STORY_STATS.md", "CLAIMS": "patchlamp/CLAIMS.md",
                "BRAND": "patchlamp/BRAND.md"}
STOP = set("that this with from have your they them their what when will just about into than then there here "
           "only once link post data never name line lines each every more most some been were also does".split())


def today_str(args=None):
    return (getattr(args, "date", None) or os.environ.get("SOCIAL_TODAY") or dt.date.today().isoformat())


def day_file(date):
    return SOCIAL_DIR / "packets" / f"{date}.json"


def load_day(date, need=True):
    f = day_file(date)
    if not f.exists():
        if need:
            die(f"no packet for {date} (`social packet --date {date}` first)")
        return None
    return json.loads(f.read_text())


def save_day(day):
    if COSTS:
        day.setdefault("costs", []).extend([who, usd] for who, usd in COSTS)
        COSTS.clear()
    f = day_file(day["date"])
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text(json.dumps(day, indent=1, ensure_ascii=False) + "\n")


def norm(text):
    t = (text or "").lower().replace("’", "'").replace("‘", "'").replace("“", '"').replace("”", '"')
    t = re.sub(r"\*\*|__|`", "", t)
    return re.sub(r"\s+", " ", t).strip()


CLOCK = re.compile(r"\b\d{1,2}:\d{2}\s*(?:am|pm)?\b", re.I)
NUM = re.compile(r"\$?\d[\d,]*(?:\.\d+)?%?")


UNITS = {w: i for i, w in enumerate("zero one two three four five six seven eight nine ten eleven twelve thirteen "
                                    "fourteen fifteen sixteen seventeen eighteen nineteen".split())}
TENS = {w: 10 * i for i, w in enumerate("_ _ twenty thirty forty fifty sixty seventy eighty ninety".split()) if i > 1}
SCALES = {"hundred": 100, "thousand": 1000}
NUMWORD = r"(?:" + "|".join(sorted(list(UNITS) + list(TENS) + list(SCALES), key=len, reverse=True)) + r")"
NUMWORDS = re.compile(r"\b" + NUMWORD + r"(?:(?:[\s-]+|\s+and\s+)" + NUMWORD + r")*\b", re.I)


def words_to_digits(text):
    """'Twenty-four trades' -> '24 trades', 'five thousand eight hundred' -> '5800', so a number spelled out
    is checked like one in digits. A lone 'one' or 'zero' is left as a word: "one text", "Is yours one?" and
    "Zero calls." are the feed's ordinary speech, not counts, and reading them as 1 or 0 would fail most posts."""
    def conv(m):
        words = [w for w in re.split(r"[\s-]+", m.group().lower()) if w and w != "and"]
        if len(words) == 1 and words[0] in ("one", "zero"):
            return m.group()
        total = cur = 0
        for w in words:
            if w in UNITS:
                cur += UNITS[w]
            elif w in TENS:
                cur += TENS[w]
            elif w == "hundred":
                cur = (cur or 1) * 100
            elif w == "thousand":
                total += (cur or 1) * 1000
                cur = 0
        return str(total + cur)
    return NUMWORDS.sub(conv, text or "")


def num_tokens(text):
    """The numbers in a text as (digits, unit): ('5865', ''), ('23', '%'), ('20', '$'). '23 percent' and
    '23 %' are '%'. A clock time (2:14am) is the night shift's premise, not a claim, so it is left out;
    so are links and hashtags."""
    t = re.sub(r"https?://\S+|\S*patchlamp\.\w+\S*|#\w+", " ", text or "")
    t = CLOCK.sub(" ", words_to_digits(t))
    out = []
    for m in re.finditer(r"(\$\s?)?(\d[\d,]*(?:\.\d+)?)(\s?%|\s+percent\b)?", t, re.I):
        v = m.group(2).replace(",", "").rstrip(".")
        if v:
            out.append((v, "$" if m.group(1) else ("%" if m.group(3) else "")))
    return out


def numbers(text):
    """The numbers in a text as plain digit strings ('5,865' -> '5865', '3%' -> '3', 'twenty-four' -> '24')."""
    return [v for v, _ in num_tokens(text)]


def prices_in(text):
    t = re.sub(r"https?://\S+", " ", text or "")
    return [m.group(1).replace(",", "") for m in re.finditer(r"\$\s?(\d[\d,]*(?:\.\d\d)?)", t)]


def pricing_table():
    """{tier: (name, monthly dollars, line number)} and the set of every dollar amount /pricing shows,
    read from Prices::TIERS (the one place a price lives). (None, None) if the file can't be read."""
    try:
        lines = PRICES_FILE.read_text().splitlines()
    except OSError:
        return None, None
    tiers, allowed, cur = {}, set(), None
    inside = False
    for i, line in enumerate(lines, 1):
        if "const TIERS" in line:
            inside = True
            continue
        if not inside:
            continue
        if re.match(r"\s*\];", line):
            break
        m = re.match(r"\s*'([a-z_+]+)' => \[", line)
        if m:
            cur = m.group(1)
            continue
        m = re.match(r"\s*'name' => '([^']+)'", line)
        if m and cur:
            tiers.setdefault(cur, {})["name"] = m.group(1)
        m = re.match(r"\s*'(monthly|usage|first_month_usage|topup|extra_site)' => (\d[\d_]*)", line)
        if m and cur:
            dollars = int(m.group(2).replace("_", "")) / 100
            if m.group(1) == "monthly":       # the six plan prices; usage and top-up amounts are not prices to quote
                allowed.add(f"{dollars:g}")
                tiers.setdefault(cur, {}).update(monthly=dollars, line=i)
    return tiers, allowed


def pricing_line(tier, row):
    return f"{row.get('name', tier)}: ${row['monthly']:,.0f} a month"


# ---- sources: quoted from the file, re-read when checked ---------------------------------------

def read_lines(rel):
    p = (PROJECTS / rel).resolve()
    if not str(p).startswith(str(PROJECTS.resolve()) + os.sep) or not p.is_file():
        return None
    return p.read_text(errors="replace").splitlines()


def heading_path(lines, i):
    """The '## …' and '### …' headings above line i (1-based), as 'A › B'."""
    h2 = h3 = None
    for j in range(i - 1, -1, -1):
        s = lines[j]
        if s.startswith("### ") and h3 is None and h2 is None:
            h3 = s[4:].strip()
        elif s.startswith("## ") and h2 is None:
            h2 = s[3:].strip()
            break
        elif s.startswith("# ") and h2 is None:
            h2 = s[2:].strip()
            break
    return " › ".join(x for x in (h2, h3) if x)


def block_at(lines, i):
    """The markdown block line i (1-based) belongs to: one table row, or a bullet / paragraph up to 8 lines."""
    s = lines[i - 1]
    if s.lstrip().startswith("|"):
        return i, i
    a = i
    while a > 1 and lines[a - 2].strip() and not re.match(r"\s*(?:[-*] |\d+\. |#)", lines[a - 1]) \
            and not lines[a - 2].lstrip().startswith(("|", "#")) and i - a < 6:
        a -= 1
    b = i
    while b < len(lines) and lines[b].strip() and not re.match(r"\s*(?:[-*] |\d+\. |\||#)", lines[b]) and b - a < 7:
        b += 1
    return a, b


def table_header(lines, i):
    j = i
    while j > 1 and lines[j - 2].lstrip().startswith("|"):
        j -= 1
    return j if j != i else None


def make_source(rel, a, b, lines=None):
    lines = lines or read_lines(rel)
    text = " ".join(x.strip() for x in lines[a - 1:b])
    return {"file": rel, "lines": [a, b], "text": text, "section": heading_path(lines, a)}


def section_range(lines, words):
    """(start, end) of the '## ' section whose heading holds every word, else the whole file."""
    for i, s in enumerate(lines):
        if s.startswith("## ") and all(w.lower() in s.lower() for w in words):
            for j in range(i + 1, len(lines)):
                if lines[j].startswith("## "):
                    return i + 1, j
            return i + 1, len(lines)
    return 1, len(lines)


def keywords(text):
    return {w for w in re.findall(r"[a-z][a-z']{3,}", norm(text)) if w not in STOP}


def find_sources(rel, topic, section_words=(), want=4, pinned_line=None):
    lines = read_lines(rel)
    if lines is None:
        return [], f"{rel} isn't there to quote"
    lo, hi = section_range(lines, section_words) if section_words else (1, len(lines))
    picks = []
    if pinned_line and 1 <= pinned_line <= len(lines):
        picks.append(pinned_line)
    allnums = set(numbers(topic))
    nums = [n for n in allnums if len(n) > 1 or n not in ("1", "2", "3")] or list(allnums)
    hits = {}
    for i in range(lo, hi + 1):
        have = set(numbers(lines[i - 1]))
        if have & set(nums):
            hits[i] = len(have & allnums)
    # the lines that hold the most of the topic's numbers, best first
    picks.extend(sorted(hits, key=lambda i: (-hits[i], i))[:want])
    if not nums or len(picks) < 2:
        kw = keywords(topic)
        scored = sorted(((len(kw & keywords(lines[i - 1])), i) for i in range(lo, hi + 1)), reverse=True)
        picks.extend(i for s, i in scored[:want] if s >= 2)
    out, seen = [], set()
    for i in picks:
        a, b = block_at(lines, i)
        h = table_header(lines, i)
        hdr = [(h, h)] if h and h < len(lines) and re.match(r"\s*\|\s*:?-{3}", lines[h]) else []
        for rng in [(a, b)] + hdr:      # the row first; a real header row after it, for the columns' meaning
            if rng not in seen:
                seen.add(rng)
                out.append(make_source(rel, rng[0], rng[1], lines))
    return out[: want + 3], ""


def ready_lines(rel, section_words):
    """The '### Ready-to-use lines' bullets of a DATA_STORY section: the sentences already cleared to quote."""
    lines = read_lines(rel)
    if lines is None:
        return []
    lo, hi = section_range(lines, section_words)
    out = []
    for i in range(lo, hi + 1):
        if lines[i - 1].startswith("### Ready-to-use"):
            j = i + 1
            while j <= hi and not lines[j - 1].startswith("#"):
                if lines[j - 1].lstrip().startswith("- "):
                    a, b = block_at(lines, j)
                    out.append(make_source(rel, a, b, lines))
                    j = b + 1
                else:
                    j += 1
            break
    return out


def topic_sources(topic):
    """Every source a topic line names, quoted from its file. Returns (sources, notes)."""
    src, notes = [], []
    paren = " ".join(re.findall(r"\(([^()]*(?:\([^()]*\)[^()]*)*)\)", topic)) or topic
    body = re.sub(r"\([^()]*(?:\([^()]*\)[^()]*)*\)", " ", topic)
    for m in re.finditer(r"(research/[\w./-]+\.md)(?::(\d+))?", paren):
        got, why = find_sources(m.group(1), body, pinned_line=int(m.group(2)) if m.group(2) else None)
        src += got
        notes += [why] if why else []
    if re.search(r"DATA_STORY", paren):
        words = ["Services"] if re.search(r"§\s*Services", paren) else (["v3"] if "v3" in paren else [])
        rel = SOURCE_FILES["DATA_STORY"]
        if words == ["Services"]:
            src += ready_lines(rel, words)
        got, why = find_sources(rel, body, section_words=words)
        src += got
        notes += [why] if why else []
    m = re.search(r"CLAIMS(?:\s*§[^:;)]*)?:?\s*([^)]*)", paren)
    if m:
        phrases = [p.strip() for p in re.split(r"[;,]", m.group(1)) if p.strip() and "link" not in p] or [body]
        for p in phrases[:4]:
            got, why = find_sources(SOURCE_FILES["CLAIMS"], p + " " + (body if len(keywords(p)) < 2 else ""), want=1)
            src += got[:2]
    for link, queries in LINK_CLAIMS.items():        # the page the post links to, so an invitation to it is checkable
        if link in paren:
            for query in queries:
                got, _ = find_sources(SOURCE_FILES["CLAIMS"], query, want=1)
                src += got[:1]
    if re.search(r"BRAND", paren):
        got, _ = find_sources(SOURCE_FILES["BRAND"], body, want=2)
        src += got
    if re.search(r"/pricing|\$\d|Starter|plans? from", topic):
        tiers, _ = pricing_table()
        if tiers is None:
            notes.append(f"the prices file isn't readable ({PRICES_FILE}), so no price can be posted today")
        else:
            for t, row in tiers.items():
                if "monthly" in row:
                    src.append({"file": "/pricing", "lines": [row["line"], row["line"]], "tier": t,
                                "text": pricing_line(t, row), "section": "Prices::TIERS (what /pricing shows)"})
    return src, notes


def facts_file_sources(date):
    rel = f"social/facts/{date}.md"
    lines = read_lines(rel) if (PROJECTS / rel).exists() else None
    if not lines:
        return []
    return [make_source(rel, i, i, lines) for i, s in enumerate(lines, 1)
            if s.strip() and not s.startswith("#")][:40]


def draw_topic(kind, pillars, weekday, line_no=None):
    """(line number, text) of the topic line: --topic-line N, else the top unstruck, ungated line of the first
    pillar that has one. Tuesday prefers a DATA_STORY line, Thursday a research brief (calendar § Leans)."""
    f = SOCIAL_DIR / "topics" / "patchlamp.md"
    lines = f.read_text().splitlines() if f.exists() else []
    if line_no:
        if not 1 <= line_no <= len(lines):
            die(f"topics/patchlamp.md has no line {line_no}")
        return line_no, lines[line_no - 1]
    for pillar in pillars:
        cands = [(i, s) for i, s in enumerate(lines, 1)
                 if s.startswith(f"- [{pillar}]") and "~~" not in s and not any(g in s.lower() for g in GATED)]
        if kind == "data" and cands:
            pref = "DATA_STORY" if weekday == 1 else "research/"
            cands.sort(key=lambda c: 0 if pref in c[1] else 1)
        if cands:
            return cands[0]
    return None, None


def last_captions(n=6):
    f = SOCIAL_DIR / "posted.jsonl"
    rows = []
    for line in (f.read_text().splitlines() if f.exists() else []):
        try:
            r_ = json.loads(line)
        except ValueError:
            continue
        if r_.get("status", "posted") == "posted":
            rows.append(r_)
    return [f"{r_.get('date')} [{r_.get('kind') or r_.get('pillar')}] {r_.get('caption') or r_.get('topic')}" for r_ in rows[-n:]]


def read_social(name, default=""):
    f = SOCIAL_DIR / name
    return f.read_text().strip() if f.exists() else default


def source_line(sid, s):
    a, b = s["lines"]
    where = f"{s['file']}:{a}" + (f"-{b}" if b != a else "")
    sec = f" ({s['section']})" if s.get("section") else ""
    return f"{sid}  {where}{sec}\n    {s['text']}"


def cmd_packet(args):
    date = today_str(args)
    try:
        d = dt.date.fromisoformat(date)
    except ValueError:
        die(f"--date {date}: not a date (YYYY-MM-DD)")
    wd = d.weekday()
    if wd not in DAY_PLAN and not args.kind:
        die(f"{date} is a Sunday: no post (calendar.md § Leans by weekday)")
    kind, pillars = DAY_PLAN.get(wd, (args.kind, []))
    kind = args.kind or kind
    if args.pillar:
        pillars = [args.pillar]
    line_no, topic = draw_topic(kind, pillars, wd, args.topic_line)
    sources, notes = topic_sources(topic) if topic else ([], [f"no unstruck topic line for {', '.join(pillars)}"])
    sources += facts_file_sources(date)
    seen, uniq = set(), []
    for s in sources:
        k = (s["file"], tuple(s["lines"]))
        if k not in seen:
            seen.add(k)
            uniq.append(s)
    src = {f"S{i}": s for i, s in enumerate(uniq[:30], 1)}
    rules = read_social("rules.md", "(social/rules.md is missing)")
    lessons = read_social("lessons.md", "(no lessons yet)")
    md = [f"# Packet — {date}, a {kind} post" + (f" (pillar {pillars[0]})" if pillars else ""), "",
          "Built by `social packet` from the files, no model. Write only from what is quoted here.", "",
          "## Today's topic line", "",
          (f"topics/patchlamp.md:{line_no}: {topic}" if topic else "none: " + "; ".join(notes)), "",
          "The topic line is a suggestion in someone's words, not a source. Its own claims count only where a "
          "source line below says them.", "",
          "## Sources (quoted verbatim, file and line; cite them by id)", ""]
    md += [source_line(k, v) for k, v in src.items()] or ["(none: a post with a fact in it can't be written from this packet)"]
    if notes:
        md += ["", "Notes from the packet: " + "; ".join(notes)]
    md += ["", "## The last six posts (don't repeat a shape or an opening)", ""] + [f"- {c}" for c in last_captions()]
    md += ["", "## Lessons (social/lessons.md)", "", lessons, "", "## The rules (social/rules.md)", "", rules, ""]
    (SOCIAL_DIR / "packets").mkdir(parents=True, exist_ok=True)
    (SOCIAL_DIR / "packets" / f"{date}.md").write_text("\n".join(md))
    old = load_day(date, need=False) or {}
    day = {"date": date, "kind": kind, "pillar": pillars[0] if pillars else None, "topic_line": line_no,
           "topic": topic, "sources": src, "notes": notes, "built": dt.datetime.now().isoformat(timespec="seconds")}
    if old.get("drafts") and not args.fresh:
        day.update({k: old[k] for k in ("drafts", "pick", "queued") if k in old})
    save_day(day)
    print(f"packet {SOCIAL_DIR / 'packets' / (date + '.md')}: a {kind} post, {len(src)} source line(s)"
          + (f", topic line {line_no}" if line_no else ", no topic line") + ("; " + "; ".join(notes) if notes else ""))


# ---- the writers ---------------------------------------------------------------------------------

WRITER_BRIEF = """You are writing one caption for Patchlamp's social feed, for {date}: a {kind} post. Patchlamp keeps a small business's website and Google listing right by text: the owner texts a change and it is done. Patch is the raccoon who does it, and the feed is in his voice.

The packet below holds everything you may stand on: today's topic line, the source lines quoted from their files with file and line, the last six posts, the lessons from earlier mornings and the one-page rule sheet. Use only facts that a source line in it says. The reason: after you, a checker re-reads each line you cite from its file and a separate judge reads your caption beside those lines, and a sentence they can't find in a source does not post. A number has to appear in the line you cite, written the same way. A joke, a mood or an invitation needs no source.

Another writer is drafting from the same packet; someone who doesn't know which of you wrote which will pick one. Write the one you would put your name on.

Your budget: about five minutes and one draft. If the packet doesn't hold enough to write a true post of this kind today, say so: "nothing true to post in this shape today, because ..." is a good answer, it is passed on as you wrote it, and nobody asks again.

Reply with one JSON object and nothing after it:
{{"caption": "the caption exactly as it would post, or empty if you decline", "ledger": [{{"sentence": "a factual sentence from the caption, word for word", "sources": ["S1"]}}], "why": ["three short lines on why you wrote it this way"], "declined": "empty, or why there is nothing true to post"}}
Every sentence that says what Patchlamp does or costs, or carries a number, goes in the ledger with the ids it stands on.

---

{packet}
"""

CODEX_ASSIGNMENT = """# Assignment: today's feed caption ({date})
from Flint's `social draft` (stamped by code, B133) · write to `marketing/copy/{name}.md` (a new file; an older feed brief is not this one) · worth five minutes

One caption for this morning's post on Patchlamp's feed, a {kind} post. Another writer drafts from the same packet, and the drafts are picked blind, so write yours as you'd want it to run.

**What is fixed.** Everything you may stand on is in the packet below (you can't read outside `marketing/`, so it is inline): the topic line, the source lines quoted from their files with file and line, the last six posts, the lessons and the rule sheet. Use only facts a source line says, a number exactly as its line writes it. After you, code re-reads each cited line from its file and a judge reads the caption beside those lines; a sentence they can't find does not post. A joke, a mood or an invitation needs no source.

**If it can't be done truthfully.** "Nothing true to post in this shape today, because ..." is a good answer; it is passed on as written.

**The brief** has your usual headings (Now: "none, a new post"; Proposed: the caption; Why: three short lines; Facts: each factual sentence beside the source ids it stands on), and ends with one fenced ```json block holding the same thing for the code that reads it:
{{"caption": "...", "ledger": [{{"sentence": "...", "sources": ["S1"]}}], "why": ["...", "...", "..."], "declined": ""}}

---

{packet}
"""


def scrubbed_env():
    return {k: v for k, v in os.environ.items() if k not in JUDGE_SCRUB}


def claude_cmd(model, turns):
    exe = shutil.which("claude") or "claude"
    return [exe, "-p", "--model", model, "--output-format", "json", "--restricted", "--tools", "",
            "--permission-mode", "dontAsk", "--strict-mcp-config", "--disable-slash-commands",
            "--no-session-persistence", "--max-turns", str(turns)]


COSTS = []    # (who, dollars at list price) for each model run this command made; kept on the day's file


def unwrap(out, who="a model"):
    """claude --output-format json wraps the reply; return (text, error or '')."""
    try:
        wrap = json.loads(out)
        if isinstance(wrap, dict) and isinstance(wrap.get("total_cost_usd"), (int, float)):
            COSTS.append((who, round(wrap["total_cost_usd"], 4)))
        if isinstance(wrap, dict) and isinstance(wrap.get("result"), str):
            if wrap.get("is_error"):
                return "", f"the session ended in an error: {wrap['result'][:200]}"
            return wrap["result"], ""
    except ValueError:
        pass
    return out, ""


def last_obj(text, keys):
    for m in reversed(list(re.finditer(r"\{", text or ""))):
        try:
            obj, _ = json.JSONDecoder().raw_decode(text[m.start():])
        except ValueError:
            continue
        if isinstance(obj, dict) and any(k in obj for k in keys):
            return obj
    return None


def plural_minutes(seconds):
    if seconds < 60:
        return f"{seconds} seconds"
    return f"{seconds // 60} minute" + ("s" if seconds >= 120 else "")


def run_group(cmd, prompt, timeout, cwd, env):
    """subprocess.run in its own process group, and on a timeout the whole group is killed: a `sh -c` stand-in
    or a CLI that forks would otherwise leave its children running after the morning has moved on."""
    p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                         cwd=cwd, env=env, start_new_session=True)
    try:
        out, err = p.communicate(prompt, timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, 9)
        except OSError:
            pass
        p.communicate()
        raise
    return subprocess.CompletedProcess(cmd, p.returncode, out, err)


def run_model(cmd, prompt, timeout, cwd, keys, who):
    """Run one model command; (answer dict or None, why-not)."""
    try:
        r = run_group(cmd, prompt, timeout, cwd, scrubbed_env())
    except subprocess.TimeoutExpired:
        return None, f"{who} did not answer within {plural_minutes(timeout)}", True
    except OSError as exc:
        return None, f"{who} could not start ({exc})", False
    text, err = unwrap(r.stdout or "", who)
    if err:
        return None, f"{who}: {err}", False
    ans = last_obj(text, keys)
    if ans is None:
        return None, f"{who}'s answer had no JSON in it (exit {r.returncode}): {(text.strip() or r.stderr.strip())[-160:]}", False
    return ans, "", False


def writer_opus(day, packet):
    prompt = WRITER_BRIEF.format(date=day["date"], kind=day["kind"], packet=packet)
    tmp = tempfile.mkdtemp(prefix="social-draft-")
    try:
        (Path(tmp) / "packet.md").write_text(packet)
        cmd = ["sh", "-c", os.environ["SOCIAL_WRITER_OPUS"]] if os.environ.get("SOCIAL_WRITER_OPUS") \
            else claude_cmd(os.environ.get("SOCIAL_WRITER_MODEL") or "opus", 3)
        return run_model(cmd, prompt, WRITER_TIMEOUT, tmp, ("caption", "declined"), "Opus")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def writer_codex(day, packet):
    date = day["date"]
    name = f"feed-{date}"
    n = 2
    while (MARKETING / "copy" / f"{name}.md").exists():   # a rerun gets its own brief: Codex found the old one
        name = f"feed-{date}-{n}"                          # "already done" once and wrote nothing new (2026-10-06)
        n += 1
    assign = MARKETING / "assignments" / f"{name}.md"
    brief = MARKETING / "copy" / f"{name}.md"
    text = CODEX_ASSIGNMENT.format(date=date, kind=day["kind"], packet=packet, name=name)
    try:
        assign.parent.mkdir(parents=True, exist_ok=True)
        assign.write_text(text)
    except OSError as exc:
        return None, f"couldn't stamp Codex's assignment ({exc})", False
    tmp = tempfile.mkdtemp(prefix="social-codex-")
    out = Path(tmp) / "last.md"
    try:
        if os.environ.get("SOCIAL_WRITER_CODEX"):
            cmd = ["sh", "-c", os.environ["SOCIAL_WRITER_CODEX"]]
            prompt = text
        else:
            exe = shutil.which("codex")
            if not exe:
                return None, "codex is not on PATH", False
            cmd = [exe, "exec", "-C", str(MARKETING), "-s", "workspace-write", "--skip-git-repo-check", "-o", str(out),
                   f"read ../AGENTS.md, do assignments/{name}.md"]
            prompt = ""          # stdin closed: a background codex waits on input forever otherwise
        started = dt.datetime.now().timestamp() - 1   # a brief left from an earlier run of the same date is not today's answer
        try:
            r = run_group(cmd, prompt, CODEX_TIMEOUT, str(MARKETING), scrubbed_env())
        except subprocess.TimeoutExpired:
            return None, f"Codex did not answer within {plural_minutes(CODEX_TIMEOUT)}", True
        except OSError as exc:
            return None, f"Codex could not start ({exc})", False
        said = ""
        for f in (brief, out):
            if f.exists() and f.stat().st_mtime >= started:
                said = f.read_text()
                ans = last_obj(said, ("caption", "declined"))
                if ans is not None:
                    return ans, "", False
        ans = last_obj(r.stdout, ("caption", "declined"))
        if ans is not None:
            return ans, "", False
        return None, f"Codex's answer had no JSON in it (exit {r.returncode}): {(said or r.stdout or r.stderr).strip()[-160:]}", False
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def clean_draft(writer, ans, why_not, timed_out):
    if ans is None:
        return {"writer": writer, "status": "timeout" if timed_out else "error", "reason": why_not}
    caption = str(ans.get("caption") or "").strip()
    declined = str(ans.get("declined") or "").strip()
    if not caption:
        return {"writer": writer, "status": "declined", "reason": declined or "an empty caption and no reason"}
    ledger = []
    for e in ans.get("ledger") or []:
        if isinstance(e, dict) and e.get("sentence"):
            srcs = e.get("sources") or ([e["source"]] if e.get("source") else [])
            ledger.append({"sentence": str(e["sentence"]), "sources": [str(s) for s in srcs],
                           **({"quote": e["quote"]} if e.get("quote") else {})})
    why = ans.get("why") or []
    return {"writer": writer, "status": "ok", "caption": caption, "ledger": ledger,
            "why": [str(w) for w in (why if isinstance(why, list) else [why])][:3]}


def cmd_draft(args):
    date = today_str(args)
    day = load_day(date)
    packet = (SOCIAL_DIR / "packets" / f"{date}.md").read_text()
    results = {}

    def go(name, fn):
        results[name] = clean_draft(name, *fn(day, packet))

    import threading
    jobs = [("opus", writer_opus)] + ([] if args.no_codex else [("codex", writer_codex)])
    threads = [threading.Thread(target=go, args=j) for j in jobs]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    if args.no_codex:
        results["codex"] = {"writer": "codex", "status": "skipped", "reason": "--no-codex"}
    day["drafts"] = [results["opus"], results["codex"]]
    day["costs"] = []                 # a rerun's morning is this run's; the cost line and the ledger count it alone
    day.pop("pick", None)
    save_day(day)
    for i, d in enumerate(day["drafts"], 1):
        if d["status"] == "ok":
            print(f"{i}. {d['writer']}: {d['caption']}")
            for w in d.get("why") or []:
                print(f"     why: {w}")
        else:
            print(f"{i}. {d['writer']}: {d['status']} — {d['reason']}")
    ok = [d for d in day["drafts"] if d["status"] == "ok"]
    if len(ok) == 1:
        other = next(d for d in day["drafts"] if d["status"] != "ok")
        print(f"one draft today ({other['writer']} {other['status']}: {other['reason']})")
    if not ok:
        print("no draft today: send Taylor the reasons above as written, and don't ask the writers again")
        sys.exit(1)


# ---- the fact check: code first, then a judge who never saw the writer ---------------------------

def resolve_ref(ref, sources, quote=None):
    """A ledger citation -> (file, a, b, quote or None, problem). 'S3' is a packet line; 'path:12' or
    'path:12-14' a file line; '/pricing:starter' a tier as Prices::TIERS has it."""
    ref = str(ref).strip()
    if ref in (sources or {}):
        s = sources[ref]
        return s["file"], s["lines"][0], s["lines"][1], s.get("tier") or s["text"], ""
    m = re.match(r"^/pricing:(\w[\w+]*)$", ref)
    if m:
        return "/pricing", 0, 0, m.group(1), ""
    m = re.match(r"^([\w./+-]+\.\w+):(\d+)(?:-(\d+))?$", ref)
    if m:
        a = int(m.group(2))
        return m.group(1), a, int(m.group(3) or a), quote, ""
    return None, 0, 0, None, f"cites {ref!r}, which is not a line in a file"


def reread(file, a, b, quote, packet_ids=None):
    """(text as the file says it now, problem). The file is read again, never the packet."""
    if file == "/pricing":
        tiers, _ = pricing_table()
        if tiers is None:
            return None, f"the prices file ({PRICES_FILE}) can't be read"
        row = tiers.get(quote) or next((r for t, r in tiers.items() if r.get("name", "").lower() == str(quote).lower()), None)
        if not row or "monthly" not in row:
            return None, f"/pricing has no tier {quote!r}"
        return pricing_line(quote, row), ""
    lines = read_lines(file)
    if lines is None:
        return None, f"cites {file}, which isn't a file under ~/projects"
    if not (1 <= a <= b <= len(lines)):
        return None, f"cites {file}:{a}-{b}, but the file has {len(lines)} lines"
    text = " ".join(x.strip() for x in lines[a - 1:b])
    if quote and norm(quote) not in norm(text):
        return None, f"cites {file}:{a}" + (f"-{b}" if b != a else "") + f" for \"{quote[:80]}\", but that line now reads \"{text[:80]}\""
    return text, ""


def sentences(caption):
    """The caption's sentences that could carry a claim: links, hashtags and the sign-offs are left out."""
    out = []
    for line in (caption or "").splitlines():
        line = re.sub(r"https?://\S+|\S*patchlamp\.(?:com|site)\S*|#\w+", " ", line).strip()
        for s in re.split(r"(?<=[.?!])\s+(?=[\"'A-Z0-9“$])", line):
            s = s.strip()
            if s and norm(s) not in SIGNOFFS and re.search(r"[A-Za-z0-9]", s):
                out.append(s)
    return out


def ledger_for(sentence, ledger):
    ns = norm(sentence).strip(" .\"'")
    best, score = None, 0.0
    for e in ledger or []:
        ne = norm(e.get("sentence")).strip(" .\"'")
        if not ne:
            continue
        if ne == ns or (len(ne) > 12 and (ne in ns or ns in ne)):
            return e
        a, b = set(ns.split()), set(ne.split())
        j = len(a & b) / max(len(a | b), 1)
        if j > score:
            best, score = e, j
    return best if score >= 0.6 else None


def code_check(caption, ledger, sources, in_packet=True):
    """Every problem code can see, as [(sentence, category, reason)], and the cited lines as re-read
    {ref: (file, a, b, text)}. Pure apart from reading the cited files."""
    problems, cited = [], {}
    _, allowed = pricing_table()
    for s in sentences(caption):
        nums = numbers(s)
        e = ledger_for(s, ledger)
        if nums and e is None:
            problems.append((s, "no-source", f"it has a number ({', '.join(nums)}) and no source in the ledger"))
            continue
        if e is None:
            continue
        texts = []
        for ref in e.get("sources") or []:
            file, a, b, quote, prob = resolve_ref(ref, sources, e.get("quote"))
            if prob:
                problems.append((s, "no-source", prob))
                continue
            if file != "/pricing" and (file.startswith(("marketing/", "social/")) and not file.startswith("social/facts/")):
                problems.append((s, "no-source", f"cites {file}, and a draft, a brief or a topic line is not a source"))
                continue
            if in_packet and not sources:
                problems.append((s, "not-in-packet", f"cites {ref}, but today's packet holds no source lines"))
                continue
            if in_packet and file != "/pricing" and ref not in sources and \
                    not any(v["file"] == file and list(v["lines"]) == [a, b] for v in sources.values()):
                problems.append((s, "not-in-packet", f"cites {ref}, which is not a line in today's packet"))
                continue
            text, prob = reread(file, a, b, quote)
            if prob:
                problems.append((s, "stale-cite", prob))
                continue
            cited[str(ref)] = (file, a, b, text)
            texts.append(text)
        if nums and not texts and not any(p[0] == s for p in problems):
            problems.append((s, "no-source", f"it has a number ({', '.join(nums)}) and cites no line in a file"))
            continue
        have = set()
        for t in texts:
            have.update(num_tokens(t))
        plain = {v for v, _ in have}
        missing = [(u if u == "$" else "") + v + (u if u == "%" else "") for v, u in num_tokens(s)
                   if (v not in plain if not u else (v, u) not in have)]
        if texts and missing:
            problems.append((s, "number", f"{', '.join(missing)} is not in the line it cites, written that way"))
        held = {v for v, u in have if u == "$"}
        for p in prices_in(s):
            v = f"{float(p):g}"
            if allowed is None:
                problems.append((s, "price", f"a price (${p}) and the prices file ({PRICES_FILE}) can't be read"))
            elif v not in allowed and v not in held and p not in held:
                problems.append((s, "price", f"${p} is not a plan price on /pricing (Prices::TIERS), nor in the line it cites"))
    for s in sentences(caption):                       # a price in a sentence with no ledger line still has to be a plan price
        if ledger_for(s, ledger) is None:
            for p in prices_in(s):
                if allowed is not None and f"{float(p):g}" not in allowed and not any(x[0] == s and x[1] == "price" for x in problems):
                    problems.append((s, "price", f"${p} is not a plan price on /pricing (Prices::TIERS)"))
    return problems, cited


FACTS_PROMPT = """You are checking the words of one post for Patchlamp's social feed before it goes up. You did not write it and you have not seen why it was written; that is the point. Patchlamp keeps a small business's website and Google listing right by text; Patch, a raccoon, is the voice.

Below are the caption, its sentences numbered, and the source lines the writer cited, each quoted from its file just now. For each numbered sentence, say whether the sources support it:
- "supported": a source line says this, at least as strongly as the sentence does.
- "not supported": no source line says it, or the sentence says more than its source (a wider claim, a different number, a detail the source doesn't have).
- "unsure": you can't tell from these lines. That is a good answer whenever it is true; it is passed on to Taylor as your doubt.
- "no claim": the sentence states no fact (a joke, a mood, an invitation like "Is yours one?"). If you are in doubt whether it is a claim, treat it as one.
Your job is the claim, not the style. Why it matters: Taylor stopped trusting the feed after a post carried numbers no file held and another said more than its stat; this check is what lets him stop cross-checking.

If you couldn't do the check (the text is garbled, the sources are missing), set "looked" to false and say why; that goes to Taylor as it is.

Your budget is a couple of turns and about three minutes; no tools are needed.

Reply with one JSON object and nothing after it:
{{"looked": true or false, "sentences": [{{"n": 1, "verdict": one of "supported" / "not supported" / "unsure" / "no claim", "why": "one line"}}]}}

## The caption

{caption}

## The sentences

{numbered}

## The cited sources

{sources}
"""


def ask_facts_judge(caption, sents, cited):
    src = "\n".join(f"- {f}" + (f":{a}" + (f"-{b}" if b != a else "") if a else "") + f"\n  {t}"
                    for f, a, b, t in cited.values()) or "(none cited)"
    prompt = FACTS_PROMPT.format(caption=caption, numbered="\n".join(f"{i}. {s}" for i, s in enumerate(sents, 1)), sources=src)
    cmd = ["sh", "-c", os.environ["SOCIAL_FACTS_JUDGE"]] if os.environ.get("SOCIAL_FACTS_JUDGE") \
        else claude_cmd(judge_model(), 2)
    tmp = tempfile.mkdtemp(prefix="social-facts-")
    try:
        ans, why, _ = run_model(cmd, prompt, FACTS_TIMEOUT, tmp, ("sentences", "looked"), "the judge")
        return ans, why
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def must_claim(sents, ledger):
    """The sentence numbers the judge may not call "no claim": the writer put them in its ledger, or they hold a
    number, a price or a percentage. A factual sentence waved through as "no claim" would post unchecked."""
    return {i for i, s in enumerate(sents, 1) if numbers(s) or prices_in(s) or ledger_for(s, ledger) is not None}


def facts_verdict(problems, sents, ans, why_not="", claims=()):
    """(verdict, [(sentence, line)]) — pass only when code found nothing and the judge called every sentence
    supported or no claim. Stricter than the picture check on purpose: an unsure fact doesn't post. Pure."""
    if problems:
        return "fail", [(s, r) for s, _, r in problems]
    if not sents:
        return "pass", []
    if ans is None:
        return "couldnt", [("", why_not or "no answer from the judge")]
    if ans.get("looked") is False:
        return "couldnt", [("", "the judge couldn't check: " + str(ans.get("why") or "no reason given"))]
    by_n = {}
    for e in ans.get("sentences") or []:
        try:
            by_n[int(e.get("n"))] = e
        except (TypeError, ValueError):
            continue
    lines, bad = [], False
    for i, s in enumerate(sents, 1):
        e = by_n.get(i)
        v = str((e or {}).get("verdict", "")).lower().strip()
        if v not in FACT_VERDICTS:
            return "couldnt", [(s, f"the judge's answer for sentence {i} was not one of the choices ({v or 'missing'})")]
        if v == "no claim" and i in claims:
            v, e = "unsure", {"why": "called no claim, but it is in the ledger or holds a number: "
                              + str((e or {}).get("why") or "-")}
        lines.append((s, f"{v}: {(e or {}).get('why') or '-'}"))
        bad = bad or v in ("not supported", "unsure")
    return ("fail" if bad else "pass"), lines


def check_draft(d, sources, in_packet=True):
    """Run both layers on one draft; returns the facts record stored on it."""
    problems, cited = code_check(d["caption"], d.get("ledger"), sources, in_packet)
    sents = sentences(d["caption"])
    ans, why_not = (None, "")
    if not problems and sents:
        ans, why_not = ask_facts_judge(d["caption"], sents, cited)
    v, lines = facts_verdict(problems, sents, ans, why_not, must_claim(sents, d.get("ledger")))
    return {"verdict": v, "layer": "code" if problems else "judge", "lines": [[s, r] for s, r in lines],
            "problems": [list(p) for p in problems],
            "cited": {k: list(v_) for k, v_ in cited.items()},
            "model": None if problems else ("stand-in (SOCIAL_FACTS_JUDGE)" if os.environ.get("SOCIAL_FACTS_JUDGE") else judge_model()),
            "at": dt.datetime.now().isoformat(timespec="seconds")}


def print_facts(label, rec):
    print(f"{label}: {rec['verdict']} ({rec['layer']})")
    for s, r in rec["lines"]:
        print(f"  - \"{s[:90]}\" — {r}" if s else f"  - {r}")


def cmd_facts(args):
    words = args.words
    if words and words[0] == "capture":
        return facts_capture(args, words[1:])
    date = today_str(args)
    if args.draft:
        f = Path(args.draft).expanduser()
        try:
            d = json.loads(f.read_text())
        except (OSError, ValueError) as exc:
            die(f"{f}: {exc}")
        rec = check_draft(d, d.get("sources") or {}, in_packet=bool(d.get("sources")))
        print_facts(d.get("label") or f.name, rec)
        if COSTS:
            print(f"  (the judge: ${sum(c for _, c in COSTS):.2f} at list price, on the subscription)")
        if not args.no_lessons:
            fact_lessons(d.get("date") or date, rec)
        if args.json:
            print(json.dumps(rec))
        sys.exit(FACTS_EXIT[rec["verdict"]])
    day = load_day(date)
    drafts_ = day.get("drafts") or []
    which = [int(w) for w in words if w.isdigit()] or [i for i, d in enumerate(drafts_, 1) if d.get("status") == "ok"]
    if not which:
        die(f"no drafts to check for {date} (`social draft` first)")
    verdicts = []
    for n in which:
        if not 1 <= n <= len(drafts_) or drafts_[n - 1].get("status") != "ok":
            die(f"no written draft {n} for {date}")
        d = drafts_[n - 1]
        d["facts"] = rec = check_draft(d, day.get("sources") or {})
        print_facts(f"{n}. {d['writer']}", rec)
        if not args.no_lessons:
            fact_lessons(date, rec)
        verdicts.append(rec["verdict"])
    save_day(day)
    if "pass" in verdicts:
        print("next: `social pick` (it picks among the drafts that passed and queues the winner); post only the draft it queues")
    else:
        print("no draft passed: `social pick` sends the closer one to Taylor for post / swap / skip")
    # one passing draft is enough for the morning to go on to `social pick`; otherwise the worst reason
    sys.exit(0 if "pass" in verdicts else (FACTS_EXIT["couldnt"] if "couldnt" in verdicts else FACTS_EXIT["fail"]))


def facts_capture(args, cmd):
    """`social facts capture CMD …` runs a command and keeps its output in social/facts/<date>.md, so a count
    from it (a week's kits, a `front` number) is in a file the packet can quote and the checker can re-read."""
    if not cmd:
        die("usage: social facts capture COMMAND [ARGS…]   (e.g. social facts capture leads week)")
    date = today_str(args)
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
    except (OSError, subprocess.TimeoutExpired) as exc:
        die(f"{' '.join(cmd)}: {exc}")
    if r.returncode != 0:
        die(f"{' '.join(cmd)} failed (exit {r.returncode}): {(r.stderr or r.stdout).strip()[:200]}; nothing kept")
    f = SOCIAL_DIR / "facts" / f"{date}.md"
    f.parent.mkdir(parents=True, exist_ok=True)
    head = "" if f.exists() else f"# Facts for {date}: command output kept by `social facts capture`, quoted by the packet\n"
    with f.open("a") as fh:
        fh.write(f"{head}\n## `{' '.join(cmd)}` at {dt.datetime.now().isoformat(timespec='minutes')}\n\n{r.stdout.rstrip()}\n")
    print(f"kept {len(r.stdout.splitlines())} line(s) of `{' '.join(cmd)}` in {f}")


# ---- lessons: facts by themselves, taste on Taylor's keep ----------------------------------------

LESSON_TEXT = {
    "no-source": "a number needs a line in a file that says it",
    "number": "a number is written as its source line writes it, or not at all",
    "price": "a price is one /pricing shows, or none",
    "stale-cite": "a cited line must still say it when the file is read again",
    "not-in-packet": "cite the packet's lines; a fact outside the packet can't be checked that morning",
    "judge": "a sentence says no more than its source",
}
PER_CATEGORY = 3


def lessons_parts():
    f = SOCIAL_DIR / "lessons.md"
    text = f.read_text() if f.exists() else ""
    head, facts, taste, part = [], [], [], "head"
    for line in text.splitlines():
        if line.startswith("## Facts"):
            part = "facts"
            continue
        if line.startswith("## Taste"):
            part = "taste"
            continue
        if part == "head":
            head.append(line)
        elif line.startswith("- "):
            (facts if part == "facts" else taste).append(line)
    if not any(h.strip() for h in head):
        head = ["# Lessons for the feed (B133, plan 54) — both writers read this in the packet",
                "",
                "Fact lessons are written by `social facts` when a check fails. Taste lessons are written only when",
                "Taylor answers the Sunday review with `keep N`: an argument that persuades a model is not evidence,",
                f"and left alone the loop drifts toward what models like to read. At most {LESSONS_CAP} lines below.", ""]
    return head, facts, taste


def write_lessons(head, facts, taste):
    while head and not head[-1].strip():
        head = head[:-1]
    out = head + ["", "## Facts", ""] + facts + ["", "## Taste", ""] + taste
    (SOCIAL_DIR / "lessons.md").write_text("\n".join(out) + "\n")


def fact_lessons(date, rec):
    """One line per failure, by itself. Same category and sentence twice is one line; a category keeps its
    newest few, so the fact lines stay short enough for a writer to hold."""
    if rec["verdict"] != "fail":
        return
    adds = []
    if rec["layer"] == "code":
        for s, cat, reason in rec["problems"]:
            adds.append((cat, f"- {date} · {LESSON_TEXT.get(cat, 'a fact needs its source')}: \"{s[:70]}\" ({reason[:110]}) [{cat}]"))
    else:
        for s, r in rec["lines"]:
            if r.startswith(("not supported", "unsure")):
                adds.append(("judge", f"- {date} · {LESSON_TEXT['judge']}: \"{s[:70]}\" (judge, {r[:110]}) [judge]"))
    if not adds:
        return
    SOCIAL_DIR.mkdir(parents=True, exist_ok=True)
    head, facts, taste = lessons_parts()
    for cat, line in adds:
        key = line.split("·", 1)[1].split("(")[0]
        if any(key in f for f in facts):
            continue
        facts.append(line)
        same = [f for f in facts if f.endswith(f"[{cat}]")]
        for old in same[:-PER_CATEGORY]:
            facts.remove(old)
    write_lessons(head, facts, taste)


def proposals_file():
    return SOCIAL_DIR / "packets" / "proposed-taste.json"


def cmd_lessons(args):
    words = args.words or ["ls"]
    op = words[0]
    head, facts, taste = lessons_parts()
    if op == "ls":
        print((SOCIAL_DIR / "lessons.md").read_text() if (SOCIAL_DIR / "lessons.md").exists() else "no lessons yet")
        return
    if op == "week":
        since = (dt.date.fromisoformat(today_str(args)) - dt.timedelta(days=7)).isoformat()
        f = SOCIAL_DIR / "picks.jsonl"
        rows = [json.loads(x) for x in (f.read_text().splitlines() if f.exists() else []) if x.strip()]
        rows = [r_ for r_ in rows if r_.get("date", "") > since]
        print(f"the week's picks since {since}: {len(rows)}")
        for r_ in rows:
            print(f"  {r_['date']} {r_.get('kind')}: {r_.get('how')}, won by {r_.get('won')} — {r_.get('argument') or '-'}")
        p = SOCIAL_DIR / "posted.jsonl"
        skips = [json.loads(x) for x in (p.read_text().splitlines() if p.exists() else []) if x.strip()]
        skips = [r_ for r_ in skips if r_.get("date", "") > since and r_.get("status") == "skipped"]
        for r_ in skips:
            print(f"  skipped {r_['date']}: {r_.get('topic')}")
        print(f"fact lessons this week: {sum(1 for x in facts if x[2:12] > since)}; taste lines: {len(taste)} "
              f"(cap {LESSONS_CAP} lines in all, {len(facts) + len(taste)} now)")
        return
    if op == "propose":
        rules = [w.strip() for w in words[1:] if w.strip()]
        if not 1 <= len(rules) <= 2:
            die('usage: social lessons propose "rule — reason (the post that showed it)" ["second rule"]  (at most two)')
        proposals_file().parent.mkdir(parents=True, exist_ok=True)
        proposals_file().write_text(json.dumps({"date": today_str(args), "rules": rules}, indent=1) + "\n")
        print("Proposed for the feed's taste lessons (nothing is written until you keep one):")
        for i, r_ in enumerate(rules, 1):
            print(f"  {i}. {r_}")
        print("Reply keep N or drop N.")
        if len(facts) + len(taste) + len(rules) > LESSONS_CAP and taste:
            print(f"At the cap ({LESSONS_CAP} lines): `retire` drops the oldest taste line: {taste[0][2:]}")
        return
    if op in ("keep", "drop"):
        try:
            prop = json.loads(proposals_file().read_text())
        except (OSError, ValueError):
            die("no proposed taste rules waiting")
        if len(words) != 2 or not words[1].isdigit() or not 1 <= int(words[1]) <= len(prop["rules"]):
            die(f"usage: social lessons {op} N  (N from 1 to {len(prop['rules'])})")
        rule = prop["rules"][int(words[1]) - 1]
        prop["rules"][int(words[1]) - 1] = None
        if op == "keep" and len(taste) >= TASTE_CAP:
            die(f"there are {len(taste)} taste lines already (at most {TASTE_CAP}); retire one first (`social lessons retire`)")
        if op == "keep":
            taste.append(f"- {today_str(args)} · {rule} (kept by Taylor)")
            write_lessons(head, facts, taste)
            print(f"kept: {rule}")
        else:
            print(f"dropped: {rule}")
        if any(prop["rules"]):
            proposals_file().write_text(json.dumps(prop, indent=1) + "\n")
        else:
            proposals_file().unlink(missing_ok=True)
        return
    if op == "retire":
        if not taste:
            die("no taste lines to retire")
        old = taste.pop(0)
        write_lessons(head, facts, taste)
        print(f"retired: {old[2:]}")
        return
    die("usage: social lessons [ls | week | propose \"rule\" [\"rule\"] | keep N | drop N | retire]")


# ---- the pick: blind, with both sets of reasons ---------------------------------------------------

PICK_PROMPT = """Two drafts of this morning's post for Patchlamp's feed (a {kind} post) both passed the fact check: every number is in its cited line and a judge called each sentence supported. Pick the one a small-business owner scrolling past is likelier to stop for and believe, or splice the two into one better caption. The writers are not named, on purpose: pick the words, not the writer.

{a_and_b}

The rule sheet the writers had:

{rules}

If you splice, keep every factual sentence word for word from A or B (with its sources), because a new sentence is a new claim and goes back through the check; a splice that fails it falls back to the draft you name in "prefer". Your budget is about three minutes and one answer.

Reply with one JSON object and nothing after it:
{{"choice": one of "A" / "B" / "splice", "prefer": one of "A" / "B", "caption": "only for a splice: the spliced caption", "ledger": [{{"sentence": "...", "sources": ["S1"]}}], "argument": "the one argument that decided it, in a sentence"}}
"""


def draft_text(label, d):
    why = "\n".join(f"  - {w}" for w in d.get("why") or []) or "  (none given)"
    return f"## Draft {label}\n\n{d['caption']}\n\nWhy, in its writer's words:\n{why}\n"


def picker_model():
    return os.environ.get("SOCIAL_PICKER_MODEL") or "opus"    # background jobs stay off Fable (plan capacity)


def ask_picker(day, a, b):
    prompt = PICK_PROMPT.format(kind=day["kind"], a_and_b=draft_text("A", a) + "\n" + draft_text("B", b),
                                rules=read_social("rules.md", "(missing)"))
    cmd = ["sh", "-c", os.environ["SOCIAL_PICKER"]] if os.environ.get("SOCIAL_PICKER") else claude_cmd(picker_model(), 2)
    tmp = tempfile.mkdtemp(prefix="social-pick-")
    try:
        ans, why, _ = run_model(cmd, prompt, PICK_TIMEOUT, tmp, ("choice", "argument"), "the picker")
        return ans, why
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def score(d):
    """Lower is better: how many sentences fell short (for choosing which failed draft goes to Taylor)."""
    rec = d.get("facts") or {}
    return sum(1 for s, r in rec.get("lines", []) if not str(r).startswith(("supported", "no claim")))


def cmd_pick(args):
    import random
    date = today_str(args)
    day = load_day(date)
    drafts_ = day.get("drafts") or []
    written = [d for d in drafts_ if d.get("status") == "ok"]
    unchecked = [d for d in written if "facts" not in d]
    if unchecked:
        die(f"run `social facts` first ({', '.join(d['writer'] for d in unchecked)} not checked)")
    passed = [d for d in written if d["facts"]["verdict"] == "pass"]
    codex = next((d for d in drafts_ if d["writer"] == "codex"), {})
    pick = {"date": date, "kind": day["kind"], "writers": [d["writer"] for d in written],
            "codex": codex.get("status", "missing") + (f": {codex.get('reason')}" if codex.get("reason") else "")}
    if not passed:
        best = min(written, key=score) if written else None
        pick.update(how="none", won=None, argument=None)
        day["pick"] = pick
        save_day(day)
        append_pick(pick)
        ledger_line(day, None)
        if best:
            print(f"no draft passed the fact check; the closer one ({best['writer']}) goes to Taylor for post / swap / skip:")
            print(best["caption"])
            for s, r in best["facts"]["lines"]:
                print(f"  - \"{s[:90]}\" — {r}" if s else f"  - {r}")
        else:
            print("no draft was written today; send Taylor the writers' reasons (`social receipt`)")
        sys.exit(1)
    if len(passed) == 1:
        win = passed[0]
        pick.update(how="only", won=win["writer"], argument="the only draft that passed the fact check"
                    if len(written) > 1 else "the only draft written")
    else:
        order = passed[:]
        random.shuffle(order)
        a, b = order
        pick["labels"] = {"A": a["writer"], "B": b["writer"]}
        ans, why_not = ask_picker(day, a, b)
        choice = str((ans or {}).get("choice", "")).strip().upper()
        if ans is None or choice not in ("A", "B", "SPLICE"):
            win = min(passed, key=lambda d: len(d["caption"]))
            pick.update(how="fallback", won=win["writer"],
                        argument=f"the picker couldn't choose ({why_not or 'no A, B or splice'}); the shorter draft went up")
        elif choice == "SPLICE":
            caption = str(ans.get("caption") or "").strip()
            # each sentence keeps the source its writer gave it: matched by sentence in code, the picker's own
            # ledger only where neither draft had the sentence
            carried = []
            for sent in sentences(caption):
                e = ledger_for(sent, (a.get("ledger") or []) + (b.get("ledger") or [])) or \
                    ledger_for(sent, [x for x in ans.get("ledger") or [] if isinstance(x, dict)])
                if e is not None:
                    carried.append(dict(e, sentence=sent))
            splice = {"writer": "splice", "status": "ok", "caption": caption, "ledger": carried, "why": [ans.get("argument") or ""]}
            splice["facts"] = check_draft(splice, day.get("sources") or {}) if splice["caption"] else \
                {"verdict": "fail", "layer": "code", "lines": [["", "the splice was empty"]], "problems": [], "cited": {}}
            fact_lessons(date, splice["facts"])
            if splice["facts"]["verdict"] == "pass":
                win = splice
                day["drafts"].append(splice)
                pick.update(how="splice", won="splice", argument=ans.get("argument"))
            else:
                pref = str(ans.get("prefer", "A")).upper()
                win = a if pref != "B" else b
                pick.update(how="splice-failed", won=win["writer"], argument=f"{ans.get('argument')} (the splice failed the "
                            f"fact check, so the preferred draft went up: {splice['facts']['lines'][0][1][:80]})")
        else:
            win = a if choice == "A" else b
            pick.update(how="pick", won=win["writer"], argument=ans.get("argument"))
        pick["model"] = "stand-in (SOCIAL_PICKER)" if os.environ.get("SOCIAL_PICKER") else picker_model()
    day["pick"] = pick
    day["winner"] = win
    append_pick(pick)
    save_day(day)                     # folds this run's costs in before the ledger line reads them
    ledger_line(day, win)
    print(f"winner ({pick['how']}, {win['writer']}): {win['caption']}")
    if pick.get("argument"):
        print(f"  because: {pick['argument']}")
    if args.image:
        n = queue_winner(day, win, args)
        day["queued"] = n
        print(f"queued as draft {n}: `social check {n}`, then `social post patchlamp {n}`")
    save_day(day)


def ledger_line(day, win):
    """One line a morning in the toolbelt's cost ledger, the way `img` writes one an image: the models the words
    took, what they cost at list price (Claude on the subscription; Codex doesn't report), and the verdict."""
    path = Path(os.environ.get("SOCIAL_LEDGER") or os.environ.get("IMG_LEDGER") or Path.home() / ".local/state/claude-tools/ledger.jsonl")
    costs = day.get("costs") or []
    event = {"ts": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S+00:00"), "kind": "social-words",
             "day": day["date"], "models": sorted({w for w, _ in costs}) + (["codex"] if any(
                 d["writer"] == "codex" and d.get("status") in ("ok", "declined") for d in day.get("drafts") or []) else []),
             "cost_usd": round(sum(c for _, c in costs), 4), "billed_to": "subscription",
             "verdict": (win or {}).get("facts", {}).get("verdict") if win else "none", "won": (win or {}).get("writer")}
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a") as f:
            f.write(json.dumps(event) + "\n")
    except OSError as exc:
        print(f"social: ledger write failed ({exc})", file=sys.stderr)


def append_pick(pick):
    SOCIAL_DIR.mkdir(parents=True, exist_ok=True)
    with (SOCIAL_DIR / "picks.jsonl").open("a") as f:
        f.write(json.dumps({k: v for k, v in pick.items()}, ensure_ascii=False) + "\n")


def queue_winner(day, win, args):
    src = Path(args.image).expanduser().resolve()
    if not src.is_file():
        die(f"{src}: no such file")
    queue_dir().mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    img = queue_dir() / f"{stamp}-patchlamp{src.suffix.lower()}"
    shutil.copy2(src, img)
    item = {"brand": "patchlamp", "image": str(img), "caption": win["caption"], "pillar": day.get("pillar"),
            "topic": (day.get("topic") or "")[:80] or None, "mood": args.mood, "art": args.art,
            "kind": getattr(args, "kind", None) or (day["kind"] if day["kind"] in KINDS else None), "day": day["date"], "writer": win["writer"],
            "facts": win["facts"]["verdict"], "added": dt.datetime.now().isoformat(timespec="seconds")}
    (queue_dir() / f"{stamp}-patchlamp.json").write_text(json.dumps(item, indent=1) + "\n")
    q = drafts()
    return next(i for i, d in enumerate(q, 1) if d["_path"].name == f"{stamp}-patchlamp.json")


# ---- the receipt -----------------------------------------------------------------------------------

def snippet(text, sentence, width=70):
    """The part of a source line that bears on the sentence: around its first number, else its best words."""
    t = re.sub(r"\s+", " ", text or "").strip()
    if len(t) <= width:
        return t
    at = -1
    for n in numbers(sentence):
        m = re.search(r"(?<![\d,.])(?:" + re.escape(n) + (f"|{int(n):,}" if n.isdigit() and len(n) > 3 else "") + r")(?![\d])", t)
        if m:
            at = m.start()
            break
    if at < 0:
        words = sorted(keywords(sentence), key=len, reverse=True)
        at = next((t.lower().find(w) for w in words if t.lower().find(w) >= 0), 0)
    start = max(0, min(at - width // 3, len(t) - width))
    return ("…" if start else "") + t[start:start + width] + ("…" if start + width < len(t) else "")


def short(text, n):
    t = re.sub(r"\s+", " ", str(text or "")).strip()
    return t if len(t) <= n else t[:n - 1].rsplit(" ", 1)[0] + "…"


def receipt_lines(day, picture=None):
    """The morning's receipt, under 12 lines: each claim beside its source, who wrote it, the verdicts."""
    win, pick = day.get("winner"), day.get("pick") or {}
    out = []
    if not win:
        out.append(f"receipt {day['date']}: nothing posted from the drafts ({pick.get('how') or 'no pick yet'})")
        for d in day.get("drafts") or []:
            if d.get("status") != "ok":
                out.append(f"  {d['writer']}: {d['status']} — {d.get('reason')}")
        return out[:12]
    who = {"opus": "Opus", "codex": "Codex", "splice": "a splice of both"}.get(win["writer"], win["writer"])
    how = {"pick": "picked blind over the other", "only": "the only draft that passed" if len(pick.get("writers") or []) > 1 else "the only draft", "splice": "spliced from both",
           "splice-failed": "picked; the splice failed its check", "fallback": "the picker couldn't choose"}.get(pick.get("how"), pick.get("how"))
    out.append(f"receipt {day['date']} · {day['kind']} · written by {who} ({how})" + (f": {short(pick['argument'], 140)}" if pick.get("argument") and pick.get("how") != "only" else ""))
    codex = next((d for d in day.get("drafts") or [] if d["writer"] == "codex"), None)
    if codex and codex.get("status") != "ok":
        out.append(f"  one draft today: Codex {codex['status']} ({codex.get('reason')})")
    for d in day.get("drafts") or []:
        if d is not win and d.get("status") == "ok" and (d.get("facts") or {}).get("verdict") != "pass" and d["writer"] != "splice":
            bad = next(((s, r) for s, r in (d.get("facts") or {}).get("lines", []) if not str(r).startswith(("supported", "no claim"))), ("", "not checked"))
            out.append(f"  {d['writer'].capitalize()}'s draft didn't pass: \"{bad[0][:50]}\" — {bad[1][:70]}")
    rec = win.get("facts") or {}
    cited = rec.get("cited") or {}
    verdicts = {s: r for s, r in rec.get("lines", [])}
    room = 12 - len(out) - 3
    for e in (win.get("ledger") or [])[:max(room, 1)]:
        refs = [cited.get(str(r_)) for r_ in e.get("sources") or [] if cited.get(str(r_))]
        src = "; ".join(f"{f}" + (f":{a}" + (f"-{b}" if b != a else "") if a else "") + f" \"{snippet(t, e['sentence'])}\"" for f, a, b, t in refs) or "no source"
        out.append(f"  \"{e['sentence'][:60]}\" → {src}")
    nclaims = sum(1 for r in verdicts.values() if r.startswith("supported"))
    out.append(f"  facts: {rec.get('verdict')} (code, then the judge: {nclaims} supported, "
               f"{sum(1 for r in verdicts.values() if r.startswith('no claim'))} no claim)")
    if picture:
        out.append(f"  picture: {picture}")
    if day.get("costs"):
        codex_ran = any(d["writer"] == "codex" and d.get("status") in ("ok", "declined") for d in day.get("drafts") or [])
        out.append(f"  the words cost ${sum(c for _, c in day['costs']):.2f} at list price ({len(day['costs'])} Claude runs, "
                   f"on the subscription)" + ("; Codex: cost not reported" if codex_ran else ""))
    return out[:12]


def cmd_receipt(args):
    date = today_str(args)
    picture = None
    if args.words and args.words[0].isdigit():
        q = drafts()
        n = int(args.words[0])
        if not 1 <= n <= len(q):
            die(f"no draft {n}")
        date = q[n - 1].get("day") or date
        chk = q[n - 1].get("check") or {}
        picture = chk.get("verdict") and f"{chk['verdict']} ({chk.get('reason', '')[:70]})"
    day = load_day(date)
    if picture is None:
        p = SOCIAL_DIR / "posted.jsonl"
        for line in reversed(p.read_text().splitlines() if p.exists() else []):
            try:
                r_ = json.loads(line)
            except ValueError:
                continue
            if r_.get("date") == date and r_.get("check"):
                picture = f"{r_['check'].get('verdict')} ({str(r_['check'].get('reason', ''))[:70]})"
                break
    print("\n".join(receipt_lines(day, picture)))


# ---- the demo tile (B129, plan ~/projects/plans/51-feed-shows-the-change.md) ------------------------
# B112 put a phone in every generated picture, and a drawn phone is still a picture of the idea
# (marketing/audit-2026-10-05.md § Social). A demo post shows the thing itself: the ask as a text
# bubble on the left, a real template demo's page after the change on the right, the one changed
# thing marked. It is made in code from screenshots, not generated, so every word on it is the
# ask or "demo" and nothing on it can be invented. The change is made on a copy of the demo's
# golden files, never on the live demo, because strangers are texting it.

CLIENTS = Path(os.environ.get("SOCIAL_CLIENTS", PROJECTS / "clients"))
DEMO_GOLDEN = "golden"               # bin/demo's GOLDEN: the ref the 04:10 reset returns every demo to
EDITOR_TIMEOUT = int(os.environ.get("SOCIAL_DEMO_TIMEOUT", "600"))   # ten minutes for the change run
EDITOR_TURNS = 40
EDITOR_TOOLS = "Read,Edit,Write,Glob,Grep"
EDITOR_MODEL_DEFAULT = "sonnet"
ASK_MAX = 160                        # characters: longer than this doesn't read at feed size
TILE_W, TILE_H = 1080, 1350          # 4:5, Instagram's tallest feed shape
ROOM, PANEL, LINE, INK, AMBER, BRASS = "#0F1413", "#16302F", "#2A4C49", "#E9E3D6", "#F0A63A", "#B59063"
FONT = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
FONT_BOLD = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
PAGE_X, PAGE_Y, PAGE_W, PAGE_H = 500, 130, 520, 1160     # where the page sits on the tile
MOST_OF_PAGE = 0.5                   # a box taller than this share of the page is no one thing to mark

EDITOR_PROMPT = """You are Patch, working on a copy of the {slug} demo site for one picture on Patchlamp's social feed. The picture shows the text below as a message bubble on the left and the page after your change on the right, with the change marked, so the change you make here is what people will see.

The site's files are in `repos/{repo}/` in this directory. `CLAUDE.md` here is the demo workspace's own notes: read it for how the site is put together and what a demo keeps (the "This is a demo" bar stays). Make the change by editing files under `repos/{repo}/` with Edit or Write. This is a throwaway copy: there is no shell, nothing to commit and nothing to publish, and the live demo is not touched, because strangers are texting it.

Change only what the text asks for and leave everything else as it is, because the picture marks whatever changed and anything extra would read as part of the ask. Write it the way the site already talks, and keep exactly what the owner meant: the picture puts their text beside your words, so a line that says something slightly different reads as a mistake. Make it visible on the page `{page}` as a phone shows it, since that page is what the picture shows. Don't name a real business or person.

Your budget is about ten minutes. If you can't make the change, or it wouldn't show on that page, "I couldn't, because ..." is a fine answer: it is passed on as you write it, and no one asks you again the same way.

The text, as the owner sent it:

{ask}

When you're done, end your reply with one JSON object and nothing after it:
{{"done": true or false, "changed": "one sentence: what you changed and where on the page", "couldnt": "if done is false, why"}}
"""


def demo_repo(slug, name=None):
    """(repo dir, golden sha) for a template demo. Only a repo with the golden ref is a demo: the six demos are
    made-up businesses with a "This is a demo" bar on every page, so a tile from one can't be taken for a client."""
    base = CLIENTS / slug / "repos"
    repos = sorted(p for p in base.iterdir() if (p / ".git").exists()) if base.is_dir() else []
    if name:
        repos = [p for p in repos if p.name == name]
    if not repos:
        die(f"no repo for {slug} under {base}" + (f" named {name}" if name else ""))
    if len(repos) > 1:
        die(f"{slug} has {len(repos)} repos ({', '.join(p.name for p in repos)}); say which with --repo")
    repo = repos[0]
    r = subprocess.run(["git", "-C", str(repo), "rev-parse", "--verify", "-q", DEMO_GOLDEN + "^{commit}"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"{slug} has no `{DEMO_GOLDEN}` ref, so it isn't one of the template demos; a demo tile is only "
            "made from a demo (`demo ls`), so nothing on it can be taken for a real customer")
    return repo, r.stdout.strip()


def golden_copy(repo, dest):
    dest.mkdir(parents=True, exist_ok=True)
    arc = subprocess.run(["git", "-C", str(repo), "archive", DEMO_GOLDEN], capture_output=True)
    if arc.returncode != 0:
        die(f"git archive {DEMO_GOLDEN} failed in {repo}: {arc.stderr.decode(errors='replace')[:160]}")
    t = subprocess.run(["tar", "-x", "-C", str(dest)], input=arc.stdout, capture_output=True)
    if t.returncode != 0:
        die(f"couldn't unpack the golden copy: {t.stderr.decode(errors='replace')[:160]}")


def page_file(site, page):
    """The file `shot` serves for PAGE: / is the folder, /x is x.html or x/index.html (Pages-style URLs)."""
    p = (page or "/").split("?")[0].split("#")[0].strip("/")
    if not p:
        return site
    for cand in (site / p, site / f"{p}.html", site / p / "index.html"):
        if cand.is_file():
            return cand
    die(f"no page {page} in the demo (looked for {p}, {p}.html, {p}/index.html)")


def editor_cmd():
    if os.environ.get("SOCIAL_DEMO_EDITOR"):
        return ["sh", "-c", os.environ["SOCIAL_DEMO_EDITOR"]]
    m = os.environ.get("SOCIAL_DEMO_EDITOR_MODEL") or EDITOR_MODEL_DEFAULT
    if "fable" in m.lower():
        die("the change run never runs on Fable")
    exe = shutil.which("claude") or "claude"
    return [exe, "-p", "--model", m, "--output-format", "json", "--restricted", "--tools", EDITOR_TOOLS,
            "--allowedTools", EDITOR_TOOLS, "--permission-mode", "dontAsk", "--strict-mcp-config",
            "--disable-slash-commands", "--no-session-persistence", "--max-turns", str(EDITOR_TURNS)]


def run_editor(work, slug, repo_name, page, ask):
    """One change run in WORK. Returns (said, couldnt): what it changed, or why it couldn't, in its own words."""
    prompt = EDITOR_PROMPT.format(slug=slug, repo=repo_name, page=page or "/", ask=ask)
    try:
        r = run_group(editor_cmd(), prompt, EDITOR_TIMEOUT, str(work), scrubbed_env())
    except subprocess.TimeoutExpired:
        return "", f"the change run did not finish within {plural_minutes(EDITOR_TIMEOUT)}"
    except OSError as exc:
        return "", f"the change run could not start ({exc})"
    text, err = unwrap(r.stdout or "", "the change run")
    if err:
        return "", f"the change run: {err}"
    ans = last_obj(text, ("done", "couldnt", "changed"))
    if ans is None:
        return "", f"the change run's answer had no JSON in it (exit {r.returncode}): {(text.strip() or r.stderr.strip())[-200:]}"
    if ans.get("done") is not True:
        return "", str(ans.get("couldnt") or ans.get("changed") or "it said it couldn't, and gave no reason")
    return str(ans.get("changed") or "").strip(), ""


def shoot(target, out):
    sibling = Path(__file__).resolve().parent / "shot"     # a worktree has no node_modules, so the installed one first
    exe = [os.environ.get("SOCIAL_SHOT") or shutil.which("shot") or str(sibling)]
    r = subprocess.run(exe + [str(target), "--mobile", "--full", "--out", str(out)], capture_output=True, text=True,
                       cwd=str(out.parent), timeout=120)
    if r.returncode != 0 or not out.exists():
        die(f"shot couldn't take {target}: {(r.stderr or r.stdout).strip()[-200:]}")


def pixels(png):
    """(width, height, rows) of a PNG as raw RGB rows, through ImageMagick (no imaging library here)."""
    tool = magick() or die("ImageMagick is not installed (apt install imagemagick)")
    ident = subprocess.run([tool, "identify", "-format", "%w %h", str(png) + "[0]"] if tool.endswith("magick")
                           else ["identify", "-format", "%w %h", str(png) + "[0]"], capture_output=True, text=True)
    w, h = (int(x) for x in ident.stdout.split()[:2])
    raw = subprocess.run([tool, str(png) + "[0]", "-alpha", "off", "-depth", "8", "rgb:-"], capture_output=True).stdout
    stride = w * 3
    return w, h, [raw[i * stride:(i + 1) * stride] for i in range(h)]


MARK_RGB = b"\xff\x00\xff"      # the outline the marked shot draws round the changed elements: a colour no demo uses
MARK_CSS = ("<style>[data-patch-mark]{outline:4px solid #ff00ff !important;outline-offset:0 !important;"
            "box-shadow:none !important}</style>")
# the mark in the picture: a highlighter behind the changed words with a thin amber edge, so no letter beside them is
# covered (a box drawn over the shot hid the comma and the "t" next to "e-bike repairs," in the first cold read)
HIGHLIGHT_CSS = ("<style>[data-patch-mark]{background-color:rgba(240,166,58,.45) !important;"
                 "box-shadow:0 0 0 3px #F0A63A !important;border-radius:3px !important;"
                 "-webkit-box-decoration-break:clone;box-decoration-break:clone}</style>")
SKIP_TAGS = ("script", "style", "title", "head", "noscript", "template")
VOID_TAGS = ("img", "br", "hr", "input", "meta", "link", "source", "area", "base", "col", "embed", "param", "track", "wbr")


class _Flat(HTMLParser):
    """Every element with text of its own (and every image), in document order, with where its start tag is."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.stack, self.items = [], []

    def handle_starttag(self, tag, attrs):
        if tag in VOID_TAGS:
            if tag == "img":
                a = dict(attrs)
                self.items.append((self.getpos(), "img", f"{a.get('src') or ''}|{a.get('alt') or ''}"))
            return
        self.stack.append([tag, [], self.getpos()])

    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)
        if tag not in VOID_TAGS and self.stack:
            self.stack.pop()

    def handle_endtag(self, tag):
        if not any(t == tag for t, _, _ in self.stack):
            return
        while self.stack:
            t, buf, pos = self.stack.pop()
            text = " ".join("".join(buf).split())
            if text and t not in SKIP_TAGS and not any(x[0] in SKIP_TAGS for x in self.stack):
                self.items.append((pos, t, text))
            if t == tag:
                break

    def handle_data(self, data):
        if self.stack:
            self.stack[-1][1].append(data)


def flat(html):
    f = _Flat()
    f.feed(html)
    f.close()
    return sorted(f.items)


def _plain_content(html, at, tag):
    """(start, end) of an element's content when it is text only (no child tags), else None."""
    gt = html.find(">", at)
    lt = html.find("<", gt + 1) if gt >= 0 else -1
    if lt < 0 or html[lt:lt + 2 + len(tag)].lower() != "</" + tag:
        return None
    return gt + 1, lt


def _mark_words(raw, before_text):
    """RAW (an element's text-only content) with the words that aren't in BEFORE_TEXT wrapped in a marked span, or
    None when most of it is new (the whole element is marked then). The mark sits on what the text changed, not on
    the paragraph round it: a cold read of the first tiles couldn't tell which words in a boxed paragraph were new."""
    tokens = re.split(r"(\s+)", raw)
    words = [(i, t) for i, t in enumerate(tokens) if t and not t.isspace()]
    if not words:
        return None
    sm = difflib.SequenceMatcher(None, before_text.split(), [unescape(t) for _, t in words], autojunk=False)
    new = {words[j][0] for op, _, _, j1, j2 in sm.get_opcodes() if op in ("replace", "insert") for j in range(j1, j2)}
    if not new or len(new) > 0.7 * len(words):
        return None
    out = []
    for i, t in enumerate(tokens):
        if i in new and (i - 2) not in new:    # tokens alternate word, space: the word before this one is i - 2
            out.append("<span data-patch-mark>")
        out.append(t)
        if i in new and (i + 2) not in new:
            out.append("</span>")
    return "".join(out)


def mark_changed(before_html, after_html, css=MARK_CSS):
    """AFTER's HTML with the changed text marked: the new words inside an element whose text was edited, or the whole
    element when it is new or mostly new (an image, a line added); and the style that outlines them. None when no
    element's text changed (a style change, a script-drawn page)."""
    a, b = flat(before_html), flat(after_html)
    sm = difflib.SequenceMatcher(None, [(t, x) for _, t, x in a], [(t, x) for _, t, x in b], autojunk=False)
    changed = []                                   # (after item, the before text it replaced, or None)
    for op, i1, i2, j1, j2 in sm.get_opcodes():
        if op == "insert" or (op == "replace" and i2 - i1 != j2 - j1):
            changed += [(b[j], None) for j in range(j1, j2)]
        elif op == "replace":
            changed += [(b[j1 + k], a[i1 + k][2] if a[i1 + k][1] == b[j1 + k][1] else None) for k in range(j2 - j1)]
    if not changed:
        return None
    starts = [0]
    for line in after_html.splitlines(keepends=True):
        starts.append(starts[-1] + len(line))
    edits = []                                     # (start, end, replacement), applied from the end
    for ((line, col), tag, _), was in changed:
        at = starts[line - 1] + col
        if after_html[at:at + 1 + len(tag)].lower() != "<" + tag:
            continue
        span = _plain_content(after_html, at, tag) if was is not None and tag != "img" else None
        marked = _mark_words(after_html[span[0]:span[1]], was) if span else None
        if marked is not None:
            edits.append((span[0], span[1], marked))
        else:
            edits.append((at + 1 + len(tag), at + 1 + len(tag), " data-patch-mark"))
    html = after_html
    for s_, e_, text in sorted(edits, reverse=True):
        html = html[:s_] + text + html[e_:]
    low = html.lower()
    i = low.find("</head>")
    return html[:i] + css + html[i:] if i >= 0 else css + html


def marked_box(before_site, after_site, page, shots):
    """The box round the changed elements, found by outlining them in a copy of the page and shooting that copy:
    exact, and not thrown by everything below an added line moving down. None when there's nothing to outline."""
    bf, af = page_file(before_site, page), page_file(after_site, page)
    bf = bf / "index.html" if bf.is_dir() else bf
    af_file = af / "index.html" if af.is_dir() else af
    if not (bf.is_file() and af_file.is_file()):
        return None
    html = mark_changed(bf.read_text(errors="replace"), af_file.read_text(errors="replace"))
    if html is None:
        return None
    marked = shots / "marked-site"
    shutil.copytree(after_site, marked, symlinks=True)
    target = marked / af_file.relative_to(after_site)
    target.write_text(html)
    shoot(target if af != after_site else marked, shots / "marked.png")
    w, h, rows = pixels(shots / "marked.png")
    x0, y0, x1, y1 = w, h, -1, -1
    for y, row in enumerate(rows):
        i = row.find(MARK_RGB)
        while i >= 0 and i % 3:
            i = row.find(MARK_RGB, i + 1)
        if i < 0:
            continue
        j = row.rfind(MARK_RGB)
        while j >= 0 and j % 3:
            j = row.rfind(MARK_RGB, 0, j + 2)
        x0, x1, y0, y1 = min(x0, i // 3), max(x1, j // 3), min(y0, y), max(y1, y)
    if x1 < 0:
        return None
    target.write_text(mark_changed(bf.read_text(errors="replace"), af_file.read_text(errors="replace"), HIGHLIGHT_CSS))
    shoot(target if af != after_site else marked, shots / "highlight.png")
    return {"x": x0, "y": y0, "w": x1 - x0 + 1, "h": y1 - y0 + 1, "page_h": h, "page_w": w, "pad": (14, 10),
            "picture": str(shots / "highlight.png")}


def change_box(before, after):
    """The changed region of AFTER as {x, y, w, h}, or None when the pages are the same. Rows are matched from the
    top and from the bottom, so a line added in the middle marks the new rows, not everything that moved down."""
    wa, ha, A = pixels(before)
    wb, hb, B = pixels(after)
    if wa != wb:
        return {"x": 0, "y": 0, "w": wb, "h": hb, "page_h": hb, "page_w": wb}
    n = min(ha, hb)
    top = next((i for i in range(n) if A[i] != B[i]), n)
    if top == n and ha == hb:
        return None
    k = 0
    while k < n - top and A[ha - 1 - k] == B[hb - 1 - k]:
        k += 1
    y0, y1 = top, max(top + 1, hb - k)
    x0, x1 = wb, -1
    for y in range(y0, min(y1, hb)):
        row = B[y]
        ref = A[y] if ha == hb else bytes(row[:3]) * wb    # a moved page: the extent of what's in the new rows
        if row == ref:
            continue
        i = next(j for j in range(0, len(row), 3) if row[j:j + 3] != ref[j:j + 3])
        jj = next(j for j in range(len(row) - 3, -1, -3) if row[j:j + 3] != ref[j:j + 3])
        x0, x1 = min(x0, i // 3), max(x1, jj // 3)
    if x1 < 0:
        x0, x1 = 0, wb - 1
    for y in range(y0, min(y1, hb)):          # the whole line the change is on, so the mark doesn't cut a word in half
        row = B[y]
        bg = row[:3]
        i = next((j for j in range(0, len(row), 3) if row[j:j + 3] != bg), None)
        if i is not None:
            jj = next(j for j in range(len(row) - 3, -1, -3) if row[j:j + 3] != bg)
            x0, x1 = min(x0, i // 3), max(x1, jj // 3)
    return {"x": x0, "y": y0, "w": x1 - x0 + 1, "h": y1 - y0, "page_h": hb, "page_w": wb}


def im_text(s):
    """Text for ImageMagick's caption:, read literally: % escapes, backslashes and a leading @ (a file read) off."""
    s = s.replace("\\", "\\\\").replace("%", "%%")
    return "\\" + s if s.startswith("@") else s


def im(*cmd):
    tool = magick() or die("ImageMagick is not installed (apt install imagemagick)")
    r = subprocess.run([tool, *[str(c) for c in cmd]], capture_output=True, text=True)
    if r.returncode != 0:
        die(f"ImageMagick: {r.stderr.strip()[:200]}")
    return r.stdout


def compose_demo(ask, after_png, box, out, portrait=None, work=None):
    """The 1080x1350 tile: "DEMO" in brass small caps at the top, the ask in a text bubble on the left (ink on
    panel), the page after the change on the right with the change boxed in amber, Patch's portrait small and
    round at the bottom left. Returns the box as drawn on the tile."""
    work = Path(work or tempfile.mkdtemp(prefix="social-tile-"))
    pw, ph = box["page_w"], box["page_h"]
    padx, pady = box.get("pad") or (max(24, pw // 26), max(10, pw // 80))   # room round the change, off the words
    bx0, by0 = max(0, box["x"] - padx), max(0, box["y"] - pady)
    bx1, by1 = min(pw, box["x"] + box["w"] + padx), min(ph, box["y"] + box["h"] + pady)
    scale = PAGE_W / pw
    win_h = int(PAGE_H / scale)                       # the slice of the page that fits, in page pixels
    need = by1 - by0
    if need > win_h * 0.8:                            # a tall change: show more page, smaller
        scale = min(scale, PAGE_H * 0.8 / max(need, 1))
        win_h = int(PAGE_H / scale)
    win_h = min(win_h, ph)
    mid = (by0 + by1) // 2
    y0 = max(0, min(ph - win_h, mid - win_h // 2))
    if by0 - y0 < win_h // 6 and y0 > 0:              # keep some page above the change for context
        y0 = max(0, min(ph - win_h, by0 - win_h // 4))
    _, _, rows = pixels(after_png)                    # start the slice in a gap between blocks, not mid-paragraph
    blank = [r == r[:3] * (len(r) // 3) for r in rows]
    near = sorted(range(max(0, y0 - 400, by1 - win_h + 10), min(ph - win_h, by0 - 10, y0 + 400) + 1), key=lambda y: abs(y - y0))
    y0 = 0 if 0 in near else next((y for y in near if y >= 32 and all(blank[y - 32:y + 1])),
                                  next((y for y in near if blank[y]), y0))
    shown_w, shown_h = int(pw * scale), int(win_h * scale)
    # the page slice, the change boxed, the corners rounded
    page = work / "page.png"
    rx0, ry0 = int(bx0 * scale), int((by0 - y0) * scale)
    rx1, ry1 = int(bx1 * scale), int((by1 - y0) * scale)
    rx0, rx1 = max(4, rx0), min(shown_w - 5, rx1)
    ry0, ry1 = max(4, ry0), min(shown_h - 5, ry1)
    marked_in_page = bool(box.get("picture"))         # the page carries its own highlight; else a box goes on top
    im(box.get("picture") or after_png, "-crop", f"{pw}x{win_h}+0+{y0}", "+repage", "-resize", f"{shown_w}x{shown_h}!",
       *([] if marked_in_page else ["-fill", "none", "-stroke", AMBER, "-strokewidth", "6",
                                    "-draw", f"roundrectangle {rx0},{ry0} {rx1},{ry1} 10,10"]),
       "(", "+clone", "-alpha", "extract", "-fill", "black", "-colorize", "100", "-fill", "white",
       "-draw", f"roundrectangle 0,0 {shown_w - 1},{shown_h - 1} 22,22", ")",
       "-alpha", "off", "-compose", "CopyOpacity", "-composite", page)
    # the ask, in a bubble
    size = 40 if len(ask) <= 90 else 34
    text = work / "ask.png"
    im("-background", "none", "-fill", INK, "-font", FONT, "-pointsize", size, "-interline-spacing", "6",
       "-size", "320x", "caption:" + im_text(ask), text)
    tw, th = (int(v) for v in im(text, "-format", "%w %h", "info:").split())
    bw, bh = tw + 64, th + 52
    bubble = work / "bubble.png"
    # a text message's bubble, not a speech balloon: the small tail tucked in at the bottom corner (two judges read
    # the first tiles' long tail as "a speech bubble rather than a text")
    im("-size", f"{bw + 12}x{bh + 2}", "xc:none", "-fill", PANEL, "-draw", f"roundrectangle 10,0 {bw + 10},{bh} 34,34",
       "-draw", f"path 'M 12,{bh - 40} L 44,{bh - 40} L 44,{bh} Q 22,{bh + 1} 0,{bh} Q 13,{bh - 10} 12,{bh - 40} Z'",
       text, "-geometry", "+42+26", "-composite", bubble)
    # the bubble sits level with the change, an amber line from it to the box
    box_mid = PAGE_Y + (PAGE_H - shown_h) // 2 + (ry0 + ry1) // 2
    top_y = max(150, min(TILE_H - 260 - bh, box_mid - bh // 2))
    page_x = PAGE_X + (PAGE_W - shown_w) // 2
    page_y = PAGE_Y + (PAGE_H - shown_h) // 2
    line_y = max(top_y + 30, min(top_y + bh - 30, box_mid))
    args = ["-size", f"{TILE_W}x{TILE_H}", f"xc:{ROOM}",
            "-fill", LINE, "-draw", f"roundrectangle {page_x - 3},{page_y - 3} {page_x + shown_w + 2},{page_y + shown_h + 2} 24,24",
            page, "-geometry", f"+{page_x}+{page_y}", "-composite",
            bubble, "-geometry", f"+50+{top_y}", "-composite",
            "-stroke", AMBER, "-strokewidth", "5", "-draw", f"line {60 + bw + 14},{line_y} {page_x - 16},{page_y + (ry0 + ry1) // 2}",
            "-stroke", "none", "-fill", AMBER, "-draw", f"circle {page_x - 16},{page_y + (ry0 + ry1) // 2} {page_x - 7},{page_y + (ry0 + ry1) // 2}",
            "-fill", BRASS, "-font", FONT_BOLD, "-pointsize", "34", "-kerning", "9", "-annotate", "+62+92", "DEMO"]
    portrait = Path(portrait or PATCH_REF)
    if portrait.is_file():
        round_ = work / "portrait.png"
        im(portrait, "-resize", "128x128^", "-gravity", "center", "-extent", "128x128",
           "(", "+clone", "-alpha", "extract", "-fill", "black", "-colorize", "100", "-fill", "white",
           "-draw", "circle 64,64 64,1", ")", "-alpha", "off", "-compose", "CopyOpacity", "-composite", round_)
        args += ["-fill", "none", "-stroke", BRASS, "-strokewidth", "3", "-draw", f"circle 124,{TILE_H - 124} 124,{TILE_H - 191}",
                 "-stroke", "none", round_, "-geometry", f"+60+{TILE_H - 188}", "-composite"]
    out.parent.mkdir(parents=True, exist_ok=True)
    im(*args, "-quality", "92", out)
    return {"x": page_x + rx0, "y": page_y + ry0, "w": rx1 - rx0, "h": ry1 - ry0}


def demo_ledger(row):
    path = Path(os.environ.get("SOCIAL_LEDGER") or os.environ.get("IMG_LEDGER") or Path.home() / ".local/state/claude-tools/ledger.jsonl")
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a") as f:
            f.write(json.dumps(row) + "\n")
    except OSError as exc:
        print(f"social: ledger write failed ({exc})", file=sys.stderr)


def couldnt(msg, as_json=False, **extra):
    """The run's "I couldn't", passed on as it is: exit 4, like the check's, so a schedule reads it the same way."""
    if as_json:
        print(json.dumps({"made": False, "couldnt": msg, **extra}))
    else:
        print(f"I couldn't: {msg}")
    sys.exit(4)


def cmd_demo(args):
    if workspace_slug():
        die("a demo tile is the house feed's; make it from ~/projects, not inside a client workspace")
    if not getattr(args, "project", None):
        die("say which demo: --project SLUG (`demo ls` names the six)")
    ask = " ".join(args.ask.split())
    if not ask:
        die("--ask is empty")
    if len(ask) > ASK_MAX:
        die(f"the ask is {len(ask)} characters; at most {ASK_MAX} read at feed size, so say it shorter")
    repo, sha = demo_repo(args.project, args.repo)
    tmp = Path(tempfile.mkdtemp(prefix="social-demo-"))
    keep = bool(os.environ.get("SOCIAL_DEMO_KEEP"))
    try:
        before = tmp / "before"
        golden_copy(repo, before)
        said, cost = "", None
        if args.after:
            after = Path(args.after).expanduser().resolve()
            if not after.is_dir():
                die(f"--after {after}: not a folder")
            said = "made by hand (--after)"
        else:
            work = tmp / "work"
            after = work / "repos" / repo.name
            shutil.copytree(before, after, symlinks=True)
            ws_md = CLIENTS / args.project / "CLAUDE.md"
            if ws_md.is_file():
                shutil.copy2(ws_md, work / "CLAUDE.md")
            print(f"the change run ({os.environ.get('SOCIAL_DEMO_EDITOR_MODEL') or EDITOR_MODEL_DEFAULT}, up to "
                  f"{plural_minutes(EDITOR_TIMEOUT)}) on a copy of {args.project}'s golden files ...", file=sys.stderr)
            said, why_not = run_editor(work, args.project, repo.name, args.page, ask)
            cost = sum(c for _, c in COSTS) if COSTS else None
            demo_ledger({"ts": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S+00:00"), "kind": "social-demo",
                         "project": args.project, "model": "stand-in" if os.environ.get("SOCIAL_DEMO_EDITOR")
                         else (os.environ.get("SOCIAL_DEMO_EDITOR_MODEL") or EDITOR_MODEL_DEFAULT),
                         "cost_usd": round(cost or 0, 4), "billed_to": "subscription", "made": not why_not})
            if why_not:
                couldnt(why_not, args.json, project=args.project, ask=ask)
        shots = tmp / "shots"
        shots.mkdir()
        shoot(page_file(before, args.page), shots / "before.png")
        shoot(page_file(after, args.page), shots / "after.png")
        box = marked_box(before, after, args.page, shots) or change_box(shots / "before.png", shots / "after.png")
        if box is None:
            couldnt(f"the page {args.page or '/'} looks the same after the change, so there's nothing to mark"
                    + (f" (the run said: {said})" if said else ""), args.json, project=args.project, ask=ask)
        if box["h"] > box["page_h"] * MOST_OF_PAGE or box["w"] * box["h"] > box["page_w"] * box["page_h"] * MOST_OF_PAGE:
            couldnt(f"most of the page changed ({box['h']} of {box['page_h']} rows), so there's no one thing to mark"
                    + (f" (the run said: {said})" if said else ""), args.json, project=args.project, ask=ask)
        if box["h"] > PAGE_H * box["page_w"] / PAGE_W:
            couldnt(f"the change runs taller than a phone screen ({box['h']} rows of a {box['page_w']}-wide page), so "
                    "there's no one thing to mark" + (f" (the run said: {said})" if said else ""),
                    args.json, project=args.project, ask=ask)
        out_dir = Path(args.out).expanduser() if args.out else SOCIAL_DIR / "generated" / "demo"
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        out = out_dir / f"{stamp}-{args.project}.jpg"
        tile_box = compose_demo(ask, shots / "after.png", box, out, work=tmp)
        side = {"kind": "demo", "project": args.project, "repo": repo.name, "page": args.page or "/", "ask": ask,
                "golden": sha, "box": {k: box[k] for k in ("x", "y", "w", "h")}, "page_size": [box["page_w"], box["page_h"]],
                "tile_box": tile_box, "changed": said, "cost_usd": cost,
                "what": f"a template demo ({args.project}): a made-up business with a 'This is a demo' bar on every page, not a customer",
                "made": dt.datetime.now().isoformat(timespec="seconds")}
        out.with_suffix(".json").write_text(json.dumps(side, indent=1) + "\n")
        if keep:
            for name in ("before.png", "after.png"):
                shutil.copy2(shots / name, out.with_name(f"{out.stem}-{name}"))
        n = None
        if args.queue is not None:
            if not args.queue.strip():
                die("--queue needs the caption (Codex's, through Flint)")
            queue_dir().mkdir(parents=True, exist_ok=True)
            qimg = queue_dir() / f"{stamp}-patchlamp.jpg"
            shutil.copy2(out, qimg)
            item = {"brand": "patchlamp", "image": str(qimg), "caption": args.queue.strip(), "pillar": "demo",
                    "topic": ask[:80], "mood": args.mood, "art": "demo tile", "kind": "demo",
                    "demo": {k: side[k] for k in ("project", "page", "ask", "golden")},
                    "added": dt.datetime.now().isoformat(timespec="seconds")}
            (queue_dir() / f"{stamp}-patchlamp.json").write_text(json.dumps(item, indent=1) + "\n")
            n = next(i for i, d in enumerate(drafts(), 1) if d["_path"].name == f"{stamp}-patchlamp.json")
        if args.json:
            print(json.dumps({"made": True, "tile": str(out), "sidecar": str(out.with_suffix(".json")), "draft": n,
                              "changed": said, "box": side["box"]}))
        else:
            print(f"tile {out}\n  asked: {ask}\n  changed: {said}\n  box: {side['box']} on a {box['page_w']}x{box['page_h']} page"
                  + (f"\n  queued as draft {n}: `social check {n}` next" if n else ""))
    finally:
        if not keep:
            shutil.rmtree(tmp, ignore_errors=True)
        else:
            print(f"(kept {tmp})", file=sys.stderr)


def cmd_connect(args):
    slug, _ = resolve(args, args.words)
    if args.network == "x":
        code, r = api("POST", f"/internal/relay/projects/{slug}/connections/x/grant-url", {}, ok=(200, 503))
        if code == 503:
            die(r.get("error", "X is not configured on patchlamp.com"))
        print(f"Open this logged into X as the {slug} account (good for 24 hours) and approve Patchlamp:")
        print(r["url"])
        return
    code, r = api("POST", f"/internal/relay/projects/{slug}/connections/meta/grant-url", {}, ok=(200, 503))
    if code == 503:
        die(r.get("error", "Meta is not configured on patchlamp.com"))
    print(f"Open this logged into Facebook as an admin of the {slug} Page (good for 24 hours), and tick the Page and its Instagram account:")
    print(r["url"])
    if not r.get("reviewed"):
        print("(Meta hasn't reviewed our app yet, so this works only for accounts added to the app — ours. Clients wait on App Review, TAYLOR-TODO §1.)")


def cmd_ls(args):
    slug, _ = resolve(args, args.words)
    _, social = api("GET", f"/internal/relay/projects/{slug}/social")
    posts = social.get("posts") or []
    if not posts:
        print(f"no posts on {slug} yet")
    for p in posts:
        print(f"{p['created_at'][:16]}  {p['status']:<8} {p['caption'][:70]}")
        for net, r in (p.get("results") or {}).items():
            print(f"    {net}: {r.get('url') if r.get('ok') else 'refused — ' + str(r.get('error'))}")


def cmd_doctor(args):
    bad = 0

    def line(ok, text):
        nonlocal bad
        bad += 0 if ok else 1
        print(f"{'ok ' if ok else 'BAD'} {text}")

    s = os.environ.get("PATCHLAMP_RELAY_SHARED_SECRET") or read_env().get("PATCHLAMP_RELAY_SHARED_SECRET")
    line(bool(s), "PATCHLAMP_RELAY_SHARED_SECRET in the toolbelt")
    line(bool(magick()), "ImageMagick (the JPEG Instagram takes)")
    line(bool(shutil.which("gbp")), "gbp on PATH (the Google leg)")
    line(PATCH_REF.exists(), f"the portrait `social check` compares with: {PATCH_REF}")
    line(bool(os.environ.get("SOCIAL_JUDGE") or shutil.which("claude")),
         f"the judge for `social check`: claude on PATH, model {os.environ.get('SOCIAL_JUDGE_MODEL') or JUDGE_MODEL_DEFAULT}")
    line(bool(os.environ.get("SOCIAL_WRITER_CODEX") or shutil.which("codex")), "codex on PATH (the second writer, B133)")
    line((SOCIAL_DIR / "rules.md").exists(), f"the rule sheet: {SOCIAL_DIR / 'rules.md'}")
    line((SOCIAL_DIR / "lessons.md").exists(), f"the lessons: {SOCIAL_DIR / 'lessons.md'}")
    tiers, _ = pricing_table()
    line(bool(tiers), f"the prices `social facts` checks against: {PRICES_FILE}" + (f" ({len(tiers)} tiers)" if tiers else ""))
    print(f"    the picker: {picker_model()} (SOCIAL_PICKER_MODEL)")
    if not s:
        sys.exit(1)
    slugs = [workspace_slug()] if workspace_slug() else list(HOUSE)
    code, r = api("POST", f"/internal/relay/projects/{slugs[0]}/connections/meta/grant-url", {}, ok=(200, 503))
    line(code == 200, "Meta app keys on patchlamp.com" + ("" if code == 200 else f" — {r.get('error')}"))
    if code == 200:
        print(f"    app review: {'approved — clients can connect' if r.get('reviewed') else 'not yet (Development mode: our own Page and @patchlamp only)'}")
    code, r = api("POST", f"/internal/relay/projects/{slugs[0]}/connections/x/grant-url", {}, ok=(200, 404, 503))
    line(code == 200, "X app keys on patchlamp.com" + ("" if code == 200 else f" — {r.get('error') or 'the X endpoints are not deployed yet'}"))
    for slug in slugs:
        social, google = connected(slug)
        pages = social.get("pages") or []
        line(bool(pages), f"{slug}: Facebook Page connected" + (f" — {pages[0].get('label')}" if pages else " (`social connect`)"))
        if pages:
            line(any(p.get("instagram") for p in pages), f"{slug}: Instagram linked to the Page"
                 + (f" — @{pages[0]['instagram']}" if pages[0].get("instagram") else " (Page → Settings → Linked accounts)"))
        xs = social.get("x") or []
        print(f"    {slug}: X {xs[0].get('label') + ' connected' if xs else 'not connected (social connect ' + slug + ' --network x)'}")
        print(f"    {slug}: Google {'connected' if google else 'not connected'}")
        last = (social.get("posts") or [None])[0]
        if last:
            print(f"    {slug}: last post {last['created_at'][:16]} {last['status']}")
    if not workspace_slug():
        print(f"    queue: {len(drafts())} draft(s) in {queue_dir()}")
    sys.exit(1 if bad else 0)


def main():
    ap = argparse.ArgumentParser(prog="social", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--project", help="project slug, outside a client workspace")
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("post")
    p.add_argument("words", nargs="*")
    p.add_argument("--only")
    p.add_argument("--page")
    p.add_argument("--x-text", help="the X version, if the caption cut to 280 won't do")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--unchecked", action="store_true", help="post a queued draft whose words weren't checked (by hand only, never the 8am run)")
    p.add_argument("--project", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_post)
    q = sub.add_parser("queue")
    q.add_argument("words", nargs="*")
    q.add_argument("--pillar")
    q.add_argument("--topic")
    q.add_argument("--mood", help="the night-shift mood (social/calendar.md § Three dials)")
    q.add_argument("--art", help="the art style the image was made in")
    q.add_argument("--kind", choices=KINDS, help="text, raccoon, data or pinned (what `social check` holds it to)")
    q.add_argument("--hold", action="store_true", help="a bare `social post BRAND` skips it (the pinned explainer)")
    q.set_defaults(fn=cmd_queue)
    dm = sub.add_parser("demo", help="a demo tile: the ask in a bubble, a template demo's page after the change, the change marked (B129)")
    dm.add_argument("--project", default=argparse.SUPPRESS, help="the template demo (`demo ls`)")
    dm.add_argument("--ask", required=True, help="the text, as an owner would send it")
    dm.add_argument("--page", default="/", help="the page the change shows on (default /)")
    dm.add_argument("--repo", help="the repo, when the demo has more than one")
    dm.add_argument("--after", help="a folder holding the site after a change made by hand (skips the change run)")
    dm.add_argument("--out", help="where the tile goes (default social/generated/demo/)")
    dm.add_argument("--queue", metavar="CAPTION", help="queue the tile with this caption as a demo draft (Codex's words, through Flint)")
    dm.add_argument("--mood", help="the mood, for the queue")
    dm.add_argument("--json", action="store_true")
    dm.set_defaults(fn=cmd_demo)
    k = sub.add_parser("check", help="one fresh judge looks at a draft's picture: product shown? the same raccoon? (demo, text: what changed?)")
    k.add_argument("words", nargs="*", help="N, the draft's number in `social queue`")
    k.add_argument("--image", help="any image instead of a queued draft")
    k.add_argument("--kind", choices=KINDS)
    k.add_argument("--json", action="store_true", help="print the result as JSON")
    k.set_defaults(fn=cmd_check)
    for name, fn in (("connect", cmd_connect), ("ls", cmd_ls)):
        c = sub.add_parser(name)
        c.add_argument("words", nargs="*")
        c.add_argument("--project", default=argparse.SUPPRESS)
        if name == "connect":
            c.add_argument("--network", choices=("meta", "x"), default="meta", help="meta (Facebook + Instagram, the default) or x")
        c.set_defaults(fn=fn)
    pk = sub.add_parser("packet", help="today's facts quoted from their files, the lessons and the rule sheet (B133)")
    pk.add_argument("--date")
    pk.add_argument("--kind", choices=KINDS)
    pk.add_argument("--pillar")
    pk.add_argument("--topic-line", type=int, help="draw this line of topics/patchlamp.md instead")
    pk.add_argument("--fresh", action="store_true", help="forget the day's drafts and pick")
    pk.set_defaults(fn=cmd_packet)
    dr = sub.add_parser("draft", help="Opus and Codex each write from the packet (B133)")
    dr.add_argument("--date")
    dr.add_argument("--no-codex", action="store_true")
    dr.set_defaults(fn=cmd_draft)
    fc = sub.add_parser("facts", help="the words checked: code, then a judge who never saw the writer (B133)")
    fc.add_argument("words", nargs="*", help="N (a draft of `social draft`), or capture -- CMD ...")
    fc.add_argument("--date")
    fc.add_argument("--draft", help="a draft file (caption, ledger, sources) instead of today's")
    fc.add_argument("--no-lessons", action="store_true", help="don't write a failure to lessons.md")
    fc.add_argument("--json", action="store_true")
    fc.set_defaults(fn=cmd_facts)
    pi = sub.add_parser("pick", help="the drafts that passed, picked blind; --image queues the winner (B133)")
    pi.add_argument("--date")
    pi.add_argument("--image")
    pi.add_argument("--mood")
    pi.add_argument("--art")
    pi.add_argument("--kind", choices=KINDS, help="the queued draft's kind, when it isn't the day's (a demo tile on a text day)")
    pi.set_defaults(fn=cmd_pick)
    rc = sub.add_parser("receipt", help="each claim beside its source, who wrote it, the verdicts (B133)")
    rc.add_argument("words", nargs="*")
    rc.add_argument("--date")
    rc.set_defaults(fn=cmd_receipt)
    ls_ = sub.add_parser("lessons", help="the writers' lessons; Sunday's propose / keep N / drop N (B133)")
    ls_.add_argument("words", nargs="*")
    ls_.add_argument("--date")
    ls_.set_defaults(fn=cmd_lessons)
    d = sub.add_parser("doctor")
    d.set_defaults(fn=cmd_doctor)
    args = ap.parse_args()
    if not args.cmd:
        return cmd_status(args)
    args.fn(args)


if __name__ == "__main__":
    main()
