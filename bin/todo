#!/usr/bin/env python3
"""todo — Taylor's todo list (~/projects/TAYLOR-TODO.md) in the terminal and on the web.

The file stays where every session writes it. A tiny git repo whose git-dir
lives beside it (~/projects/.todo-git, work tree ~/projects, everything but
the tracked docs excluded) mirrors it to a PRIVATE GitHub repo; a systemd user
timer runs `todo sync` every two minutes so local edits go up and ticks made
on the web come down. Since 2026-09-21 the same side-car also carries the
root planning docs (ROADMAP.md, VISION.md, HISTORY.md, CLAUDE.md, COWORK.md,
plans/) so Cowork on the MacBook reads the same plan (`TRACKED` below). The web page is a static file on GitHub Pages (a PUBLIC
repo holding only the page) that reads and writes the private file through the
GitHub API with a fine-grained token Taylor pastes once in the browser.

  todo ls [--all]              open items by section, numbered
  todo done <n> [<n>...]       tick item(s) by number from `todo ls`
  todo add "text" [--section N]   a new item (default: the "Later" section)
  todo sync                    local edits up, web ticks down (the timer's job)
  todo init                    one time: the private data repo, the timer
  todo site push               publish todo-site/index.html to the Pages repo
  todo open                    print the page URL
  todo request "<prompt>" [--later] | ls | run NAME     the request box (below)
  todo request --dry-run "<prompt>"   print how that prompt would launch; files nothing
  todo inbox ls | run NAME     Flint's inbox (flint/inbox -> flint/outbox)
  todo doctor

Unattended runs (B83, 2026-09-30). A request, an inbox answer and build-night's
/build all start from a file that came through the shared repo, so none of them
runs under the ambient ~/projects rules or with Taylor's connectors. Each is
`claude -p` in ~/projects with a settings file stamped from
templates/headless/ (--settings, --setting-sources project, so the project's
CLAUDE.md and skills still load), --strict-mcp-config with a playwright-only
--mcp-config, --no-chrome, and ENABLE_CLAUDEAI_MCP_SERVERS=false. A /build
request (or the old /continue, rewritten to /build) gets settings.build.json
in auto mode; anything else gets settings.request.json in dontAsk mode. The
login: a dedicated CLAUDE_CONFIG_DIR (~/.local/state/claude-tools/headless/
config) signed in by CLAUDE_HEADLESS_OAUTH_TOKEN, a long-lived subscription
token Taylor makes once with `claude setup-token`; until it's set, the run uses
the interactive login the way `prep` does (connectors still off), and says so
in its reply and in `todo doctor`. `claude auth status` is checked before every
run; a run that can't sign in writes its reply saying why instead of failing
silently.

Config, by name only (values never printed):
  GITHUB_TOKEN  in ~/.config/claude-tools/env — passed to gh as GH_TOKEN when
                present; otherwise gh's own login. Pushes use SSH.
  CLAUDE_HEADLESS_OAUTH_TOKEN  in the same file: the unattended runs' login
                (`claude setup-token`). Passed to the run as CLAUDE_CODE_OAUTH_TOKEN.
  TODO_HEADLESS_LOGIN=dedicated  refuse to fall back to the interactive login
  TODO_REQUEST_MODEL (fable) / TODO_FLINT_MODEL (fable) / TODO_BUILD_PERMISSION_MODE (auto)
  TODO_FILE     the markdown file (default ~/projects/TAYLOR-TODO.md)
  TODO_OWNER    GitHub owner for both repos (default: gh's logged-in user)
  TODO_DATA_REPO / TODO_SITE_REPO   default taylor-todo (private) / todo (public)
"""

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import time
import sys
import tempfile
from datetime import date
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
SITE_DIR = HERE / "todo-site"
UNITS_DIR = HERE / "systemd"
TOOLBELT = Path(os.environ.get("CLAUDE_TOOLS_ENV", "~/.config/claude-tools/env")).expanduser()

TODO_FILE = Path(os.environ.get("TODO_FILE", "~/projects/TAYLOR-TODO.md")).expanduser()
WORK_TREE = TODO_FILE.parent
GIT_DIR = WORK_TREE / ".todo-git"
DATA_REPO = os.environ.get("TODO_DATA_REPO", "taylor-todo")
SITE_REPO = os.environ.get("TODO_SITE_REPO", "todo")
BRANCH = "main"
# Everything the side-car mirrors, relative to WORK_TREE. TAYLOR-TODO.md is
# the web page's file; the rest is the plan Cowork reads on the MacBook.
TRACKED = [TODO_FILE.name, "ROADMAP.md", "VISION.md", "HISTORY.md", "CLAUDE.md", "GROWTH.md",
           "COWORK.md", "plans", "mac", "requests", "social", "flint", "research", "days", ".gitattributes"]
# `days` (2026-09-30, Taylor: "a directory where we keep day specific plans"): one file a day, `days/YYYY-MM-DD.md`.
# `research` (2026-09-29, Flint, on Taylor's "commit everything"): the sourced briefs, so they are versioned and on the Mac.
# `social` (added 2026-09-23, Flint): the group posts, the boards and the
# day-1 mock posts, so Cowork can post them from the Mac (ROADMAP B24).
# `flint` (2026-09-23): Cowork ↔ Flint mail — inbox/ (Cowork writes), outbox/ (Flint writes).
# The request box (plans/01-cowork-bridge.md, B17): Cowork drops
# requests/<name>.md in the shared repo; each sync starts one unanswered
# request as a headless claude session in WORK_TREE and the reply lands in
# requests/<name>.reply.md, which the next sync pushes back.
REQUESTS = WORK_TREE / "requests"
REQUEST_TIMEOUT = int(os.environ.get("TODO_REQUEST_TIMEOUT", 45 * 60))
REQUEST_MAX_CHARS = 4000
REQUEST_NAME = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
# Flint's inbox (2026-09-24, Flint): a file Cowork writes to flint/inbox/ is a
# question for Flint. Each sync starts one unanswered inbox file as a headless
# Flint session that writes flint/outbox/<same name>.md; Taylor no longer
# carries the ping. Same queue as the request box: one session at a time
# across both. A first line `model: opus` in the inbox file picks the model.
FLINT = WORK_TREE / "flint"
INBOX, OUTBOX = FLINT / "inbox", FLINT / "outbox"
INBOX_NAME = re.compile(r"^\d{4}-\d{2}-\d{2}-[a-z0-9][a-z0-9-]{0,63}$")
INBOX_SINCE = "2026-09-24"   # files dated before this were answered by hand
INBOX_TIMEOUT = int(os.environ.get("TODO_INBOX_TIMEOUT", 15 * 60))
INBOX_MODELS = {"fable": "claude-fable-5-1", "opus": "claude-opus-5-5", "sonnet": "claude-sonnet-5"}
INBOX_MODEL = os.environ.get("TODO_FLINT_MODEL", "fable")
INBOX_MAX_CHARS = 12000
FLINT_PROMPT = """You are Flint - Taylor's planner and verifier (CLAUDE.md "Who's who"), answering mail from Cowork, the Claude session on Taylor's MacBook, without Taylor carrying the ping. This is a headless run started by `todo sync`; nobody is watching, so finish the job and leave the record true.

Read first: flint/README.md, then ROADMAP.md, TAYLOR-TODO.md (fresh, from disk), HISTORY.md's session log for this week, and any earlier files in flint/inbox and flint/outbox on the same topic. Your memory directory is loaded as usual.

Cowork's note is flint/inbox/{name}.md (its text follows). Answer it by writing flint/outbox/{name}.md - that exact path; the file's existence is what closes the topic. Head it "# Flint -> Cowork - {today}, <topic>" then the answer: what Cowork can act on, what is Taylor's, what is a build session's. Verify before you assert: when the docs and the live system could differ, check the live system (shot, front, db doctor, the relay's read-only commands, git logs).

Rules: anything that changes the plan goes into ROADMAP / TAYLOR-TODO / HISTORY by the usual rules (edit in place after re-reading from disk; one HISTORY session-log line tagged Flint if you changed something). Never write a secret or the id of one. Never restart a relay daemon, push a repo, merge a PR, post anywhere or spend money. If Cowork asks for something only Taylor can do, write the TAYLOR-TODO entry and say so. If a decision is Taylor's, recommend and file it in TAYLOR-TODO section 3 instead of deciding. Keep the reply under about 2,500 characters. Never write into flint/inbox. If you truly cannot answer, write the outbox file saying why and what Taylor should look at. Your final message is discarded; only the outbox file reaches Cowork.

--- flint/inbox/{name}.md ---
{text}
"""

# The unattended runs (B83; private-docs/security/2026-09-30-plan.md § B83, host-H2 and M10).
HEADLESS = HERE / "templates" / "headless"
HEADLESS_STATE = Path(os.environ.get("TODO_HEADLESS_STATE", "~/.local/state/claude-tools/headless")).expanduser()
HEADLESS_CONFIG = HEADLESS_STATE / "config"          # the runs' own CLAUDE_CONFIG_DIR
HEADLESS_TOKEN = "CLAUDE_HEADLESS_OAUTH_TOKEN"       # by name in the toolbelt env; `claude setup-token`
HEADLESS_LOGIN = os.environ.get("TODO_HEADLESS_LOGIN", "fallback")   # "dedicated": no fallback
CLAUDE = os.environ.get("TODO_CLAUDE") or "claude"   # the tests' fake
REQUEST_MODEL = os.environ.get("TODO_REQUEST_MODEL", "fable")
BUILD_MODE = os.environ.get("TODO_BUILD_PERMISSION_MODE", "auto")
BUILD_COMMANDS = ("/build", "/continue")             # /continue: the old name, until 2026-09-30
# What a run must never inherit from the launcher's environment: an API key would bill outside
# Taylor's plan (VISION § Rules 1), and a config dir or token from the caller would undo the login choice.
HEADLESS_SCRUB = ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL", "ANTHROPIC_MODEL",
                  "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY",
                  "CLAUDE_CONFIG_DIR", "CLAUDE_CODE_OAUTH_TOKEN", "CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT",
                  HEADLESS_TOKEN)
# The denies `todo doctor` insists on (the plan's acceptance): a stamped file without them fails loudly.
HEADLESS_REQUIRED_DENY = ("Read(~/.config/**)", "Read(~/.ssh/**)", "Read(~/.claude/**)", "Read(~/.claude.json)",
                          "mcp__playwright__browser_run_code_unsafe", "mcp__playwright__browser_file_upload")
# One sentence a run gets about its own boundary, so a refused call reads as the boundary and not as a
# fault to work around (VISION § Rules 8). B78 (c) owns the rest of the framing (the cap, writing early).
BOUNDARY = {
    "request": ("About this run's boundary: its prompt came through the shared repo, so it runs unattended under "
                "a narrow permission set (claude-tools/templates/headless/settings.request.json). It can read the "
                "tree, edit ROADMAP.md, TAYLOR-TODO.md, HISTORY.md and flint/outbox/, and run the read-only checks "
                "(git logs, todo ls, front, ctx, shot, the relay's queue/costs/billing/check, gh pr view); it can't "
                "push, publish, message anyone, change settings, use the claude.ai connectors, or read the key files "
                "under ~/.config, ~/.ssh and ~/.claude. A refused tool call is that boundary, not a fault: say in "
                "the answer what you couldn't do and who can (usually Taylor, at the terminal)."),
    "build": ("About this run's boundary: it is an unattended /build started through the request box or "
              "build-night, so it runs under a stamped permission set "
              "(claude-tools/templates/headless/settings.build.json) in auto mode. You and your builders can "
              "read, edit, test, commit, push branches, open and merge pull requests and run the relay's queue "
              "and check; you can't read the key files under ~/.config, ~/.ssh and ~/.claude, use the claude.ai "
              "connectors, change permission or MCP settings, run the relay's money or messaging commands, "
              "restart a daemon with systemctl, force-push or start another claude. A refused call is that "
              "boundary, not a fault: record what it stopped (TAYLOR-TODO § 1, as the skill says) and carry on "
              "with the rest."),
}


def is_build(prompt):
    words = (prompt or "").split(None, 1)
    return bool(words) and words[0] in BUILD_COMMANDS


def as_build(prompt):
    """`/continue` was renamed `/build` on 2026-09-30 (the desktop app reads /continue as "continue a
    session"). A request or note that still says /continue runs as /build, so the alias skill can go."""
    s = (prompt or "").lstrip()
    return "/build" + s[len("/continue"):] if s.split(None, 1)[:1] == ["/continue"] else prompt


def _fill(text):
    return (text.replace("{{PROJECTS}}", str(WORK_TREE)).replace("{{CONFIG}}", str(HEADLESS_CONFIG))
            .replace("{{TOOLBELT}}", str(HERE)))


def stamped_settings(variant):
    """settings.common.json + settings.<variant>.json, placeholders filled; the lists concatenate."""
    common = json.loads(_fill((HEADLESS / "settings.common.json").read_text()))
    own = json.loads(_fill((HEADLESS / f"settings.{variant}.json").read_text()))
    out = {k: v for k, v in common.items() if k not in ("_about", "permissions")}
    out.update({k: v for k, v in own.items() if k not in ("_about", "permissions")})
    perms = dict(common.get("permissions") or {})
    for k, v in (own.get("permissions") or {}).items():
        perms[k] = (perms.get(k) or []) + v if isinstance(v, list) else v
    return {"_about": f"stamped by `todo` from claude-tools/templates/headless/settings.common.json + "
                      f"settings.{variant}.json; edit those, not this file", "permissions": perms, **out}


def _write_private(path, text):
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    tmp.chmod(0o600)
    tmp.replace(path)


def stamp_headless(variant):
    """Write the stamped settings and the playwright-only MCP config under HEADLESS_STATE; -> (settings, mcp)."""
    HEADLESS_STATE.mkdir(parents=True, exist_ok=True)
    HEADLESS_STATE.chmod(0o700)
    settings, mcp = HEADLESS_STATE / f"settings.{variant}.json", HEADLESS_STATE / "mcp.json"
    _write_private(settings, json.dumps(stamped_settings(variant), indent=2) + "\n")
    _write_private(mcp, json.dumps(json.loads(_fill((HEADLESS / "mcp.json").read_text())), indent=2) + "\n")
    return settings, mcp


def project_slug(path):
    return re.sub(r"[^A-Za-z0-9]", "-", str(path))


def prepare_config_dir():
    """The dedicated CLAUDE_CONFIG_DIR: ~/projects marked trusted in its .claude.json (an untrusted
    workspace loses the project's settings source, and with it CLAUDE.md and the /build skill), and a
    fresh copy of Flint's memory, so a run starts knowing what the interactive Flint knows while what it
    writes there stays in the copy (an unattended run can't change what later sessions remember)."""
    HEADLESS_CONFIG.mkdir(parents=True, exist_ok=True)
    HEADLESS_CONFIG.chmod(0o700)
    cj = HEADLESS_CONFIG / ".claude.json"
    try:
        data = json.loads(cj.read_text()) if cj.exists() else {}
    except ValueError:
        data = None                         # not ours to repair; the run will say if it can't start
    if data is not None:
        entry = data.setdefault("projects", {}).setdefault(str(WORK_TREE), {})
        if not entry.get("hasTrustDialogAccepted"):
            entry["hasTrustDialogAccepted"] = True
            _write_private(cj, json.dumps(data, indent=2) + "\n")
    src = Path.home() / ".claude" / "projects" / project_slug(WORK_TREE) / "memory"
    dst = HEADLESS_CONFIG / "projects" / project_slug(WORK_TREE) / "memory"
    if src.is_dir():
        if dst.exists():
            shutil.rmtree(dst)
        shutil.copytree(src, dst)


def headless_login():
    """-> (env additions, label). The dedicated config dir signs in with the long-lived token Taylor
    makes once; without it the run uses the interactive login, as `prep` does, unless
    TODO_HEADLESS_LOGIN=dedicated (then label 'none' and the run is refused)."""
    tok = toolbelt().get(HEADLESS_TOKEN)
    if tok:
        return {"CLAUDE_CONFIG_DIR": str(HEADLESS_CONFIG), "CLAUDE_CODE_OAUTH_TOKEN": tok}, "dedicated"
    if HEADLESS_LOGIN == "dedicated":
        return {"CLAUDE_CONFIG_DIR": str(HEADLESS_CONFIG)}, "none"
    return {}, "interactive"


LOGIN_WORDS = {
    "dedicated": f"the dedicated config dir {HEADLESS_CONFIG}, signed in by {HEADLESS_TOKEN}",
    "interactive": (f"the interactive login (fallback: {HEADLESS_TOKEN} isn't set; connectors stay off through "
                    f"--strict-mcp-config and ENABLE_CLAUDEAI_MCP_SERVERS=false)"),
    "none": f"none: {HEADLESS_TOKEN} isn't set and TODO_HEADLESS_LOGIN=dedicated refuses the fallback",
}


def headless_env(variant, extra=None):
    env = {k: v for k, v in os.environ.items() if k not in HEADLESS_SCRUB}
    login, label = headless_login()
    env.update(login)
    env["ENABLE_CLAUDEAI_MCP_SERVERS"] = "false"
    if variant == "request":
        env["SHOT_SANDBOX"] = "1"          # shot's paths stay inside ~/projects, no private addresses
    env.update(extra or {})
    return env, label


def headless_cmd(prompt, variant, model_id, settings, mcp):
    mode = "dontAsk" if variant == "request" else BUILD_MODE
    cmd = [CLAUDE, "-p", prompt, "--model", model_id, "--output-format", "json",
           "--permission-mode", mode, "--settings", str(settings), "--setting-sources", "project",
           "--strict-mcp-config", "--mcp-config", str(mcp), "--no-chrome",
           "--append-system-prompt", BOUNDARY[variant]]
    if "fable" in model_id:
        cmd += ["--effort", "high"]        # what ~/.claude/settings.json gives Fable; user settings don't load here
    return cmd


def headless_auth(env):
    """(ok, why) — the run's login, asked the way the run will ask it."""
    try:
        r = subprocess.run([CLAUDE, "auth", "status", "--json"], env=env, cwd=WORK_TREE,
                           capture_output=True, text=True, timeout=60)
        st = json.loads(r.stdout or "{}")
    except (OSError, subprocess.SubprocessError, ValueError) as exc:
        return False, f"couldn't ask claude for its login ({exc.__class__.__name__})"
    method = str(st.get("authMethod") or "none")
    if st.get("loggedIn") and method != "none" and "api" not in method.lower():
        return True, method
    return False, f"not signed in ({method})"


def headless_launch(prompt, variant, model_id, timeout, extra_env):
    """Run one unattended session. -> (CompletedProcess or None, login label, refusal or None).
    TimeoutExpired / FileNotFoundError reach the caller, as before."""
    settings, mcp = stamp_headless(variant)
    env, label = headless_env(variant, extra_env)
    if label == "none":
        return None, label, LOGIN_WORDS["none"]
    if label == "dedicated":
        prepare_config_dir()
    ok, why = headless_auth(env)
    if not ok:
        return None, label, (f"the run's login ({LOGIN_WORDS[label]}) is {why}. Taylor: `claude setup-token`, "
                             f"then `~/.config/claude-tools/setenv.sh {HEADLESS_TOKEN}` (TAYLOR-TODO § 1)")
    cmd = headless_cmd(prompt, variant, model_id, settings, mcp)
    return subprocess.run(cmd, cwd=WORK_TREE, capture_output=True, text=True, timeout=timeout, env=env), label, None


def request_model(prompt):
    # The build is supervised by a Fable session (VISION § Decided 2026-09-28): it spawns the Opus
    # builders itself. A plain request ran on ~/.claude/settings.json's model (Fable) and still does.
    return INBOX_MODELS["fable"] if is_build(prompt) else INBOX_MODELS.get(REQUEST_MODEL, REQUEST_MODEL)


def describe_launch(prompt, variant, model_id):
    """What `--dry-run` prints: the files, the login, the env it adds (names only) and the command."""
    settings, mcp = stamp_headless(variant)
    env, label = headless_env(variant)
    shown = {k: ("<" + HEADLESS_TOKEN + ">" if k == "CLAUDE_CODE_OAUTH_TOKEN" else env[k])
             for k in ("CLAUDE_CONFIG_DIR", "CLAUDE_CODE_OAUTH_TOKEN", "ENABLE_CLAUDEAI_MCP_SERVERS", "SHOT_SANDBOX")
             if k in env}
    cmd = headless_cmd(f"<prompt, {len(prompt)} chars>", variant, model_id, settings, mcp)
    cmd[cmd.index("--append-system-prompt") + 1] = "<the boundary sentence>"
    mode = cmd[cmd.index("--permission-mode") + 1]
    lines = [f"variant: {variant} ({mode}) from {HEADLESS}/settings.common.json + settings.{variant}.json",
             f"settings: {settings}", f"mcp: {mcp} (servers: {', '.join(json.loads(mcp.read_text())['mcpServers'])})",
             f"login: {LOGIN_WORDS[label]}",
             f"CLAUDE_CONFIG_DIR: {env.get('CLAUDE_CONFIG_DIR') or f'unset (the interactive one); the dedicated dir is {HEADLESS_CONFIG}'}",
             "env added: " + " ".join(f"{k}={v}" for k, v in shown.items()),
             "cwd: " + str(WORK_TREE),
             "command: " + shlex.join(cmd),
             "boundary sentence: " + BOUNDARY[variant]]
    return "\n".join(lines)


def tracked_paths():
    return [str(WORK_TREE / t) for t in TRACKED if (WORK_TREE / t).exists()]


def write_exclude():
    """Only the tracked docs are ever seen by the side-car; everything else is excluded."""
    (GIT_DIR / "info").mkdir(exist_ok=True)
    lines = ["*"] + [f"!/{t}" for t in TRACKED] + ["!/plans/**", "!/mac/**", "!/requests/**", "!/social/**", "!/flint/**", "!/research/**", "!/days/**"]
    # The same union rule as a tracked .gitattributes, so the MacBook's clone
    # (which has no info/attributes of its own) merges the same way (2026-09-24).
    ga = WORK_TREE / ".gitattributes"
    if not ga.exists():
        ga.write_text("*.md merge=union\n*.jsonl merge=union\n")
    (GIT_DIR / "info" / "exclude").write_text("\n".join(lines) + "\n")
    # When both sides add a line at the same spot (two HISTORY log lines, two
    # TODO entries), keep both instead of one side's whole file: git's union
    # driver. A duplicated row is visible; a dropped line was not (2026-09-21
    # TODO, 2026-09-23 HISTORY). Binary files (social/mock) are left to git.
    (GIT_DIR / "info" / "attributes").write_text("*.md merge=union\n*.jsonl merge=union\n")


ITEM_RE = re.compile(r"^- \[( |~|x)\] \*\*(.{12,80}?)(?:\*\*|$)", re.M)


def item_keys(text):
    """{first 12–80 chars of an item's bold title: its tick state}."""
    return {m.group(2): m.group(1) for m in ITEM_RE.finditer(text)}


def item_block(text, key):
    i = text.index("**" + key) - len("- [ ] ")
    m = re.search(r"\n(?=- \[|## )", text[i + 1:])
    return text[i:i + 1 + m.start() + 1] if m else text[i:]


def restore_dropped_items(before, after):
    """A remote edit (Cowork writing a stale copy) can silently delete open
    items. Ticking is fine; vanishing is not. Put the lost blocks back at the
    top of §1 and say so. Returns the new text and the keys restored."""
    b, a = item_keys(before), item_keys(after)
    lost = [k for k, st in b.items() if st in " ~" and k not in a]
    if not lost:
        return after, []
    blocks = []
    for k in lost:
        blk = item_block(before, k).rstrip("\n")
        blk += f"\n  _(restored by `todo sync` {date.today()}: a remote edit dropped it)_\n"
        blocks.append(blk)
    m = re.search(r"^## 1\..*$", after, re.M)
    if not m:
        return after + "\n" + "\n".join(blocks), lost
    first = re.search(r"^- \[", after[m.end():], re.M)
    at = m.end() + (first.start() if first else 0)
    return after[:at] + "\n".join(blocks) + "\n" + after[at:], lost


def guard_dropped(before, quiet):
    """After taking remote changes: put back any open item they deleted."""
    after = TODO_FILE.read_text()
    fixed, lost = restore_dropped_items(before, after)
    if not lost:
        return
    TODO_FILE.write_text(fixed)
    git("add", "--", str(TODO_FILE))
    git("commit", "-q", "-m", f"todo: restored {len(lost)} open item(s) a remote edit dropped")
    git("push", "-q", "origin", f"HEAD:{BRANCH}", check=False)
    print(f"restored {len(lost)} open item(s) a remote edit had dropped: "
          + "; ".join(k[:40] for k in lost), file=sys.stderr)

ITEM = re.compile(r"^- \[( |x|X)\] (.*)$")
SECTION = re.compile(r"^## (.*)$")
BOLD = re.compile(r"\*\*(.+?)\*\*")


# --- helpers ---------------------------------------------------------------

def die(msg, code=2):
    print(f"todo: {msg}", file=sys.stderr)
    sys.exit(code)


def toolbelt():
    env = {}
    if TOOLBELT.exists():
        for line in TOOLBELT.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, _, v = line.partition("=")
                env[k.strip()] = v.strip().strip('"').strip("'")
    return env


def gh_env():
    env = dict(os.environ)
    tok = toolbelt().get("GITHUB_TOKEN")
    if tok:
        env["GH_TOKEN"] = tok
    return env


def gh(*args, check=True, capture=True):
    r = subprocess.run(["gh", *args], env=gh_env(), text=True, capture_output=capture)
    if check and r.returncode:
        die(f"gh {' '.join(args[:2])} failed: {(r.stderr or r.stdout).strip()}")
    return r


def owner():
    o = os.environ.get("TODO_OWNER")
    if o:
        return o
    r = gh("api", "user", "--jq", ".login", check=False)
    if r.returncode:
        die("not logged in to GitHub: `gh auth login`, or setenv.sh GITHUB_TOKEN")
    return r.stdout.strip()


def git(*args, check=True, capture=True, quiet=False):
    """git against the side-car repo. Never touches anything but TODO_FILE."""
    cmd = ["git", f"--git-dir={GIT_DIR}", f"--work-tree={WORK_TREE}", *args]
    r = subprocess.run(cmd, text=True, capture_output=capture,
                       env=dict(os.environ, GIT_EDITOR="true", GIT_TERMINAL_PROMPT="0"))
    if check and r.returncode:
        die(f"git {args[0]}: {(r.stderr or r.stdout).strip()}")
    return r


def repo_ready():
    return (GIT_DIR / "HEAD").exists()


def site_url(o=None):
    o = (o or owner()).lower()
    return f"https://{o}.github.io/{SITE_REPO}/"


# --- the file --------------------------------------------------------------

def parse(text):
    """-> [{name, items: [{n, line, done, title}]}] ; n counts across sections.
    An item is `- [ ]`/`- [x]` at column 0 plus its indented continuation lines;
    the title is its first **bold** run (which may wrap), else the first line."""
    sections, cur, n = [], None, 0
    lines = text.splitlines()
    for i, line in enumerate(lines):
        m = SECTION.match(line)
        if m:
            cur = {"name": m.group(1).strip(), "items": []}
            sections.append(cur)
            continue
        m = ITEM.match(line)
        if m and cur is not None:
            n += 1
            body = [m.group(2).strip()]
            j = i + 1
            while j < len(lines) and (lines[j].startswith("  ") or (not lines[j].strip() and j + 1 < len(lines) and lines[j + 1].startswith("  "))):
                body.append(lines[j].strip())
                j += 1
            joined = " ".join(b for b in body if b)
            b = BOLD.search(joined)
            title = (b.group(1) if b else body[0])[:110]
            cur["items"].append({"n": n, "line": i, "done": m.group(1) != " ", "title": title})
    return sections


def cmd_ls(args):
    text = TODO_FILE.read_text()
    open_n = 0
    for s in parse(text):
        items = [it for it in s["items"] if args.all or not it["done"]]
        if not items:
            continue
        print(f"\n{s['name']}")
        for it in items:
            mark = "x" if it["done"] else " "
            open_n += not it["done"]
            print(f"  [{mark}] {it['n']:>2}  {it['title']}")
    print(f"\n{open_n} open · {TODO_FILE}")


def cmd_done(args):
    text = TODO_FILE.read_text()
    lines = text.splitlines(keepends=True)
    by_n = {it["n"]: it for s in parse(text) for it in s["items"]}
    for n in args.n:
        it = by_n.get(n)
        if not it:
            die(f"no item {n} (see `todo ls`)")
        if it["done"]:
            print(f"already done: {it['title']}")
            continue
        lines[it["line"]] = lines[it["line"]].replace("- [ ]", "- [x]", 1)
        print(f"done: {it['title']}")
    TODO_FILE.write_text("".join(lines))
    if repo_ready():
        cmd_sync(argparse.Namespace(quiet=True))


def cmd_add(args):
    text = TODO_FILE.read_text()
    lines = text.splitlines(keepends=True)
    sections = parse(text)
    if not sections:
        die("no '## ' sections in the file")
    # default: the "Later" section, wherever it sits — the file ends with a
    # Done archive, which is the last thing a new item should land in
    default = next((i + 1 for i, s in enumerate(sections) if "later" in s["name"].lower()), len(sections))
    idx = (args.section or default) - 1
    if not 0 <= idx < len(sections):
        die(f"--section must be 1..{len(sections)}")
    # insert after the section's last item (or its header), before the next header
    start = next(i for i, l in enumerate(lines) if SECTION.match(l) and SECTION.match(l).group(1).strip() == sections[idx]["name"])
    end = next((i for i in range(start + 1, len(lines)) if SECTION.match(lines[i])), len(lines))
    at = end
    while at > start + 1 and not lines[at - 1].strip():
        at -= 1
    who = args.by or "Taylor"
    entry = f"- [ ] **{args.text.strip().rstrip('.')}.** _({who}, {date.today().isoformat()})_\n"
    if at == start + 1 and lines[start].endswith("\n") and not (len(lines) > start + 1 and not lines[start + 1].strip()):
        entry = "\n" + entry            # a blank line under the header, like the other sections
    lines.insert(at, entry)
    TODO_FILE.write_text("".join(lines))
    print(f"added to {sections[idx]['name']}: {args.text.strip()}")
    if repo_ready():
        cmd_sync(argparse.Namespace(quiet=True))


# --- git sync --------------------------------------------------------------

def cmd_sync(args):
    if not repo_ready():
        die("no data repo yet: run `todo init`")
    if not TODO_FILE.exists():
        die(f"{TODO_FILE} is missing")
    q = getattr(args, "quiet", False)
    write_exclude()
    git("add", "--", *tracked_paths())
    if git("diff", "--cached", "--quiet", check=False).returncode:
        git("commit", "-q", "-m", "todo: local edit")
        if not q:
            print("committed local edit")
    r = git("fetch", "-q", "origin", BRANCH, check=False)
    if r.returncode:
        die(f"fetch failed (offline?): {r.stderr.strip()}", 1)
    local = git("rev-parse", "HEAD").stdout.strip()
    remote = git("rev-parse", f"origin/{BRANCH}").stdout.strip()
    before = TODO_FILE.read_text()
    if local == remote:
        if not q:
            print("in sync")
        start_requests(q)
        return
    if git("merge-base", "--is-ancestor", remote, local, check=False).returncode == 0:
        git("push", "-q", "origin", f"HEAD:{BRANCH}")
        if not q:
            print("pushed")
        start_requests(q)
        return
    if git("merge-base", "--is-ancestor", local, remote, check=False).returncode == 0:
        git("merge", "-q", "--ff-only", f"origin/{BRANCH}")
        if not q:
            print("pulled web changes")
        guard_dropped(before, q)
        start_requests(q)
        return
    # both moved: replay local on top of the web's version; on a clash the local line wins
    r = git("rebase", f"origin/{BRANCH}", check=False)
    if r.returncode:   # a clash the union driver couldn't take (binary, deleted file)
        git("checkout", "--theirs", "--", *tracked_paths(), check=False)
        git("add", "--", *tracked_paths())
        r2 = git("rebase", "--continue", check=False)
        if r2.returncode:
            git("rebase", "--abort", check=False)
            die("rebase clash I couldn't settle; local file kept, will retry next tick", 1)
        print("merged: local edit and a web tick touched the same line; local kept")
    git("push", "-q", "origin", f"HEAD:{BRANCH}")
    if not q:
        print("merged and pushed")
    guard_dropped(before, q)
    start_requests(q)


# --- the request box -------------------------------------------------------

def request_files():
    """(name, prompt path, reply path, running marker) for every request, oldest first."""
    if not REQUESTS.exists():
        return []
    out = []
    for p in sorted(REQUESTS.glob("*.md"), key=lambda x: x.stat().st_mtime):
        if p.name.endswith(".reply.md"):
            continue
        name = p.stem
        if not REQUEST_NAME.match(name):
            continue
        out.append((name, p, REQUESTS / f"{name}.reply.md", REQUESTS / f"{name}.running"))
    return out


def inbox_files():
    """(name, note path, reply path, running marker) for every inbox file, oldest first.
    Answered = an outbox file with the same name, or `<name>-reply.md` (the hand-written convention)."""
    if not INBOX.exists():
        return []
    out = []
    for p in sorted(INBOX.glob("*.md"), key=lambda x: x.stat().st_mtime):
        name = p.stem
        if not INBOX_NAME.match(name) or name[:10] < INBOX_SINCE:
            continue
        out.append((name, p, OUTBOX / f"{name}.md", OUTBOX / f"{name}.running"))
    return out


def inbox_state(name, note, reply, running):
    if reply.exists() or (OUTBOX / f"{name}-reply.md").exists():
        return "answered"
    if running.exists():
        return "running"
    return "waiting"


def request_state(name, prompt, reply, running):
    if reply.exists():
        return "answered"
    if running.exists():
        return "running"
    return "waiting"


def new_request_name(prompt):
    stem = re.sub(r"[^a-z0-9]+", "-", prompt.strip().lower())[:40].strip("-") or "request"
    stamp = time.strftime("%m%d-%H%M")
    name = f"{stem}-{stamp}"
    n = 2
    while (REQUESTS / f"{name}.md").exists():
        name = f"{stem}-{stamp}-{n}"
        n += 1
    return name


def start_requests(quiet=False):
    """Start the oldest unanswered request, detached, unless one is running.
    Never raises: a broken request box must not stop the sync."""
    try:
        jobs = [("request", request_state(*r), r) for r in request_files()] + \
               [("inbox", inbox_state(*r), r) for r in inbox_files()]
        # Any marker in requests/ holds the queue, not only a request's own: a prep run files
        # requests/prep-<id>.running with its pid (plan 28 § B67.2), and `build-night` reads the
        # same glob. One long job at a time, whoever filed it.
        if any(state == "running" for _, state, _ in jobs) or \
                (REQUESTS.exists() and any(REQUESTS.glob("*.running"))):
            return
        for kind, state, (name, prompt, reply, running) in jobs:
            if state != "waiting":
                continue
            running.write_text(f"started {time.strftime('%Y-%m-%d %H:%M:%S')} by todo sync\n")
            cmd = ["systemd-run", "--user", "--quiet", "--collect", f"--unit=todo-{kind}-{name}",
                   "--setenv=PATH=" + os.environ.get("PATH", "") + ":" + str(Path.home() / ".local/bin"),
                   str(Path(__file__).resolve()), kind, "run", name]
            r = subprocess.run(cmd, capture_output=True, text=True)
            if r.returncode:
                running.unlink(missing_ok=True)
                print(f"todo: could not start request {name}: {(r.stderr or r.stdout).strip()}", file=sys.stderr)
            elif not quiet:
                print(f"started {kind} {name}")
            return
    except Exception as exc:  # noqa: BLE001
        print(f"todo: request box skipped: {exc}", file=sys.stderr)


def cmd_request(args):
    if args.action == "ls":
        reqs = request_files()
        if not reqs:
            print("no requests")
        for name, prompt, reply, running in reqs:
            first = prompt.read_text().strip().splitlines()[0] if prompt.read_text().strip() else ""
            print(f"  {request_state(name, prompt, reply, running):<9} {name}  {first[:70]}")
        return
    if args.action == "run":
        run_request(args.name)
        return
    # action == "new": file one (and start it now unless --later)
    text = (args.name or "").strip()
    if not text:
        die("todo request \"<prompt>\"")
    if len(text) > REQUEST_MAX_CHARS:
        die(f"prompt is over {REQUEST_MAX_CHARS} characters")
    if args.dry_run:                        # how it would launch; files nothing, starts nothing
        text = as_build(text)
        print(describe_launch(text, "build" if is_build(text) else "request", request_model(text)))
        return
    REQUESTS.mkdir(exist_ok=True)
    name = new_request_name(text)
    (REQUESTS / f"{name}.md").write_text(text + "\n")
    print(name)
    if not args.later:
        start_requests(quiet=True)


def run_request(name):
    """Run one request to its reply file. Called detached by start_requests."""
    if not REQUEST_NAME.match(name or ""):
        die("bad request name")
    prompt_path, reply, running = REQUESTS / f"{name}.md", REQUESTS / f"{name}.reply.md", REQUESTS / f"{name}.running"
    if not prompt_path.exists():
        die(f"no such request: {name}")
    if reply.exists():
        die(f"{name} is already answered")
    prompt = as_build(prompt_path.read_text().strip()[:REQUEST_MAX_CHARS])
    variant = "build" if is_build(prompt) else "request"
    started = time.strftime("%Y-%m-%d %H:%M:%S")
    running.write_text(f"started {started}\n")
    head = [f"# reply to {name}", f"started {started} in {WORK_TREE}", ""]
    try:
        r, label, refusal = headless_launch(prompt, variant, request_model(prompt), REQUEST_TIMEOUT,
                                            {"TODO_REQUEST": name})
        head[-1:] = [f"boundary: templates/headless/settings.{variant}.json; login: {label}", ""]
        if refusal:
            status, body = "not started", f"I couldn't start this request: {refusal}."
        else:
            body, meta = r.stdout, {}
            try:
                data = json.loads(r.stdout)
                body = data.get("result") or r.stdout
                meta = {k: data.get(k) for k in ("num_turns", "duration_ms", "total_cost_usd", "is_error") if k in data}
            except ValueError:
                pass
            status = f"finished {time.strftime('%Y-%m-%d %H:%M:%S')}, exit {r.returncode}"
            if meta:
                status += f", {meta.get('num_turns', '?')} turns, {round((meta.get('duration_ms') or 0) / 60000, 1)} min, ${meta.get('total_cost_usd') or 0:.2f}"
            if r.returncode and r.stderr.strip():
                body = (body or "") + "\n\nstderr:\n" + r.stderr.strip()[-2000:]
    except subprocess.TimeoutExpired:
        status = f"timed out after {REQUEST_TIMEOUT // 60} minutes"
        body = "(the session was stopped at the cap; whatever it committed is in the repos)"
    except FileNotFoundError:
        status = "failed: claude is not on PATH for the runner"
        body = ""
    reply.write_text("\n".join(head + [status, "", (body or "").strip()[-20000:], ""]))
    running.unlink(missing_ok=True)
    notify_reply(name, status, reply)


def notify_reply(name, status, reply, kind="request"):
    """Tell Taylor a request is answered (relay `notify`: the channel he last used, else a DM).
    Best effort — a missing relay never breaks the runner."""
    try:
        subprocess.run(["notify", "--file", str(reply), "--chars", "1200", f"{kind} {name}: {status}"],
                       capture_output=True, text=True, timeout=60, cwd=WORK_TREE)
    except (OSError, subprocess.SubprocessError):
        pass


def run_inbox(name):
    """Answer one inbox file as a headless Flint. Called detached by start_requests."""
    if not INBOX_NAME.match(name or ""):
        die("bad inbox name")
    note, reply, running = INBOX / f"{name}.md", OUTBOX / f"{name}.md", OUTBOX / f"{name}.running"
    if not note.exists():
        die(f"no such inbox file: {name}")
    if inbox_state(name, note, reply, running) == "answered":
        die(f"{name} is already answered")
    text = note.read_text().strip()
    model = INBOX_MODEL
    first = text.splitlines()[0].strip().lower() if text else ""
    if first.startswith("model:"):
        model = first.split(":", 1)[1].strip()
        text = text.split("\n", 1)[1] if "\n" in text else ""
    model_id = INBOX_MODELS.get(model, model)
    started = time.strftime("%Y-%m-%d %H:%M:%S")
    OUTBOX.mkdir(parents=True, exist_ok=True)
    running.write_text(f"started {started}\n")
    prompt = FLINT_PROMPT.format(name=name, today=time.strftime("%Y-%m-%d %H:%M %Z"), text=text[:INBOX_MAX_CHARS])
    body, status, refusal = "", "", None
    try:
        # An inbox note is answered, never built from: always the narrow boundary, whatever its first word.
        r, label, refusal = headless_launch(prompt, "request", model_id, INBOX_TIMEOUT, {"TODO_INBOX": name})
        if refusal:
            status, body = f"not started, login {label}", f"I couldn't answer this note: {refusal}."
        else:
            body, meta = r.stdout, {}
            try:
                data = json.loads(r.stdout)
                body = data.get("result") or r.stdout
                meta = {k: data.get(k) for k in ("num_turns", "duration_ms", "total_cost_usd") if k in data}
            except ValueError:
                pass
            status = f"{model}, login {label}, {meta.get('num_turns', '?')} turns, {round((meta.get('duration_ms') or 0) / 60000, 1)} min"
            if r.returncode:
                status += f", exit {r.returncode}"
                if r.stderr.strip():
                    body = (body or "") + "\n\nstderr:\n" + r.stderr.strip()[-2000:]
    except subprocess.TimeoutExpired:
        status = f"stopped at the {INBOX_TIMEOUT // 60}-minute cap"
        body = "(the session was stopped at the cap before it wrote the reply)"
    except FileNotFoundError:
        status = "failed: claude is not on PATH for the runner"
    stamp = time.strftime("%Y-%m-%d %H:%M %Z")
    if reply.exists():
        with reply.open("a") as f:
            f.write(f"\n_(answered by a headless Flint session, {status}, {stamp})_\n")
    else:
        reply.write_text(f"# Flint -> Cowork - {stamp}, {name} (the session left no reply file)\n\n"
                         f"{(body or '').strip()[-6000:]}\n\n_(headless Flint session, {status}; "
                         f"tell Taylor if this keeps happening)_\n")
    running.unlink(missing_ok=True)
    if refusal:                             # only Taylor can sign the runs in; tell him, once a note
        notify_reply(name, status, reply, kind="inbox")


def cmd_inbox(args):
    if args.action == "run":
        run_inbox(args.name)
        return
    items = inbox_files()
    if not items:
        print("no inbox files since " + INBOX_SINCE)
    for name, note, reply, running in items:
        first = next((l for l in note.read_text().splitlines() if l.strip() and not l.lower().startswith("model:")), "")
        print(f"  {inbox_state(name, note, reply, running):<9} {name}  {first[:70]}")


def cmd_init(args):
    o = owner()
    if not TODO_FILE.exists():
        die(f"{TODO_FILE} doesn't exist")
    full = f"{o}/{DATA_REPO}"
    if gh("repo", "view", full, "--json", "name", check=False).returncode:
        gh("repo", "create", full, "--private", "--description", "Taylor's todo list (synced from ~/projects/TAYLOR-TODO.md)")
        print(f"created private repo {full}")
    else:
        vis = gh("repo", "view", full, "--json", "visibility", "--jq", ".visibility").stdout.strip()
        if vis.upper() != "PRIVATE":
            die(f"{full} exists but is {vis}; the todo has client names in it — make it private first")
    if not repo_ready():
        git("init", "-q", "-b", BRANCH)
        write_exclude()
        git("config", "core.worktree", str(WORK_TREE))
        git("config", "user.name", "todo sync")
        git("config", "user.email", "todo@localhost")
        git("remote", "add", "origin", f"git@github.com:{full}.git")
        print(f"side-car repo at {GIT_DIR} (tracks {', '.join(TRACKED)})")
    r = git("fetch", "-q", "origin", BRANCH, check=False)
    if r.returncode == 0 and git("rev-parse", "-q", "--verify", "HEAD", check=False).returncode:
        # remote has history, we have none: adopt it, then commit the local version on top
        git("reset", "-q", "--soft", f"origin/{BRANCH}")
    git("add", "--", *tracked_paths())
    if git("diff", "--cached", "--quiet", check=False).returncode or git("rev-parse", "-q", "--verify", "HEAD", check=False).returncode:
        git("commit", "-q", "-m", "todo: sync from the laptop")
    git("push", "-q", "-u", "origin", f"HEAD:{BRANCH}")
    print(f"pushed {TODO_FILE.name} to {full}")
    install_timer()
    print("next: `todo site push` to publish the page, then create the browser token (todo doctor lists the steps)")


def install_timer():
    user_units = Path.home() / ".config/systemd/user"
    user_units.mkdir(parents=True, exist_ok=True)
    for name in ("todo-sync.service", "todo-sync.timer"):
        src = UNITS_DIR / name
        if not src.exists():
            die(f"missing {src}")
        dst = user_units / name
        if dst.is_symlink() or dst.exists():
            dst.unlink()
        dst.symlink_to(src)
    r = subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True, text=True)
    if r.returncode:
        print(f"note: systemctl --user daemon-reload failed ({r.stderr.strip()}); enable the timer by hand")
        return
    subprocess.run(["systemctl", "--user", "enable", "--now", "todo-sync.timer"], capture_output=True, text=True)
    print("timer: todo-sync.timer every 2 minutes (systemctl --user status todo-sync.timer)")


# --- the page --------------------------------------------------------------

def cmd_site(args):
    if args.action != "push":
        die("site: only `push`")
    o = owner()
    full = f"{o}/{SITE_REPO}"
    page = SITE_DIR / "index.html"
    if not page.exists():
        die(f"missing {page}")
    if gh("repo", "view", full, "--json", "name", check=False).returncode:
        gh("repo", "create", full, "--public", "--description", "A checklist page for TAYLOR-TODO.md (data lives in a private repo)")
        print(f"created public repo {full}")
    with tempfile.TemporaryDirectory() as tmp:
        clone = Path(tmp) / "site"
        r = subprocess.run(["git", "clone", "-q", "--depth", "1", f"git@github.com:{full}.git", str(clone)],
                           capture_output=True, text=True, env=dict(os.environ, GIT_TERMINAL_PROMPT="0"))
        if r.returncode:                    # empty repo: clone fails, so start one
            clone.mkdir()
            subprocess.run(["git", "init", "-q", "-b", BRANCH], cwd=clone, check=True)
            subprocess.run(["git", "remote", "add", "origin", f"git@github.com:{full}.git"], cwd=clone, check=True)
        for f in SITE_DIR.iterdir():
            if f.is_file():
                shutil.copy(f, clone / f.name)
        (clone / ".nojekyll").write_text("")
        (clone / "README.md").write_text(
            f"# todo\n\nThe page at {site_url(o)} — a checklist view of a markdown todo file that lives "
            f"in a private repo. This repo holds only the page; it has no data in it.\n"
            f"Source of truth: `claude-tools/todo-site/`, published with `todo site push`.\n")
        subprocess.run(["git", "add", "-A"], cwd=clone, check=True)
        if subprocess.run(["git", "diff", "--cached", "--quiet"], cwd=clone).returncode == 0 and \
                subprocess.run(["git", "rev-parse", "-q", "--verify", "HEAD"], cwd=clone, capture_output=True).returncode == 0:
            print("page unchanged")
        else:
            subprocess.run(["git", "-c", "user.name=todo", "-c", "user.email=todo@localhost", "commit", "-q", "-m",
                            "publish todo page"], cwd=clone, check=True)
            subprocess.run(["git", "push", "-q", "origin", f"HEAD:{BRANCH}"], cwd=clone, check=True)
            print(f"pushed page to {full}")
    r = gh("api", f"repos/{full}/pages", check=False)
    if r.returncode:
        r = gh("api", "-X", "POST", f"repos/{full}/pages", "-f", f"source[branch]={BRANCH}", "-f", "source[path]=/", check=False)
        if r.returncode:
            die(f"couldn't enable Pages: {(r.stderr or r.stdout).strip()} — Settings → Pages → branch main")
        print("Pages turned on (first build takes a minute)")
    print(site_url(o))


def cmd_open(args):
    print(site_url())


def settings_valid(variant, settings):
    """`claude -p` ignores a settings file that fails validation without a word, which would leave a run
    without its deny rules; `claude doctor` names every invalid file and rule, so ask it, on a copy."""
    with tempfile.TemporaryDirectory() as tmp:
        (Path(tmp) / "proj" / ".claude").mkdir(parents=True)
        (Path(tmp) / "proj" / ".claude" / "settings.json").write_text(settings.read_text())
        env = {k: v for k, v in os.environ.items() if k not in HEADLESS_SCRUB}
        env["CLAUDE_CONFIG_DIR"] = str(Path(tmp) / "cfg")
        try:
            r = subprocess.run([CLAUDE, "doctor"], cwd=Path(tmp) / "proj", env=env, stdin=subprocess.DEVNULL,
                               capture_output=True, text=True, timeout=120)
        except (OSError, subprocess.SubprocessError) as exc:
            return ("warn", f"unattended {variant}: couldn't ask `claude doctor` to validate the settings ({exc.__class__.__name__})")
    bad = [l.strip("- ").split("›", 1)[-1].strip() for l in r.stdout.splitlines() if "settings.json ›" in l]
    if bad:
        return ("FAIL", f"unattended {variant}: claude rejects part of the stamped settings: " + "; ".join(bad)[:600])
    if "Claude Code doctor" not in r.stdout:
        return ("warn", f"unattended {variant}: `claude doctor` gave no report to validate against (exit {r.returncode})")
    return ("ok", f"unattended {variant}: claude doctor accepts the stamped settings")


def headless_checks(mcp_list=True):
    """[(level, line)], level ok | warn | FAIL: the unattended launchers still carry the boundary (B83)."""
    out = []
    for variant in ("request", "build"):
        try:
            settings, mcp = stamp_headless(variant)
            doc = json.loads(settings.read_text())
            servers = sorted(json.loads(mcp.read_text()).get("mcpServers") or {})
        except (OSError, ValueError) as exc:
            out.append(("FAIL", f"unattended {variant}: templates/headless won't stamp ({exc})"))
            continue
        cmd = headless_cmd("x", variant, "claude-opus-5-5", settings, mcp)
        arg = lambda flag: cmd[cmd.index(flag) + 1] if flag in cmd else None
        want_mode = "dontAsk" if variant == "request" else BUILD_MODE
        flags_ok = ("--strict-mcp-config" in cmd and arg("--mcp-config") == str(mcp) and arg("--settings") == str(settings)
                    and arg("--setting-sources") == "project" and "--no-chrome" in cmd and arg("--permission-mode") == want_mode)
        out.append(("ok" if flags_ok else "FAIL",
                    f"unattended {variant}: --settings {settings.name}, --setting-sources project, --strict-mcp-config, "
                    f"--no-chrome, {arg('--permission-mode')}" + ("" if flags_ok else " (a launch flag is missing)")))
        deny = set((doc.get("permissions") or {}).get("deny") or [])
        missing = [d for d in HEADLESS_REQUIRED_DENY if d not in deny]
        out.append(("FAIL" if missing else "ok", f"unattended {variant}: {len(deny)} deny rules"
                    + (f"; missing {', '.join(missing)}" if missing else ", the key-file reads and the two unsafe browser tools among them")))
        if variant == "build" and doc.get("permissions", {}).get("defaultMode") != BUILD_MODE:
            out.append(("warn", f"unattended build: the stamped defaultMode isn't {BUILD_MODE}"))
        out.append(("ok" if servers == ["playwright"] else "FAIL", f"unattended {variant}: MCP servers {', '.join(servers) or 'none'}"
                    + ("" if servers == ["playwright"] else " (should be playwright only)")))
        if doc.get("disableClaudeAiConnectors") is not True:
            out.append(("FAIL", f"unattended {variant}: disableClaudeAiConnectors isn't set"))
        out.append(settings_valid(variant, settings))
    cli = HERE / "node_modules" / "@playwright" / "mcp" / "cli.js"
    out.append(("ok" if cli.exists() else "warn", f"playwright MCP for the runs: {cli}" + ("" if cli.exists() else " missing (npm install here)")))
    env, label = headless_env("request")
    out.append(({"dedicated": "ok", "interactive": "warn", "none": "FAIL"}[label], "unattended login: " + LOGIN_WORDS[label]
                + ("" if label == "dedicated" else f" — Taylor: `claude setup-token`, then `~/.config/claude-tools/setenv.sh {HEADLESS_TOKEN}`")))
    if label == "dedicated":
        prepare_config_dir()
        mode = oct(HEADLESS_CONFIG.stat().st_mode & 0o777)
        cred = (HEADLESS_CONFIG / ".credentials.json").exists()        # by path only; never opened
        out.append(("warn" if cred or mode != "0o700" else "ok", f"config dir {HEADLESS_CONFIG} ({mode})"
                    + ("; it holds an interactive login too (someone ran /login there): remove it so only the token signs in" if cred else "")))
    if label != "none":
        good, why = headless_auth(env)
        out.append(("ok" if good else "FAIL", f"unattended login signs in: {why}"))
    try:
        proj = json.loads((WORK_TREE / ".claude" / "settings.json").read_text())
        reviewed = json.loads((HEADLESS / "inherited.json").read_text())
        new = [a for a in (proj.get("permissions") or {}).get("allow") or [] if a not in reviewed["rules"]]
        out.append(("warn" if new else "ok", "project allow rules the runs inherit: "
                    + (f"{len(new)} not reviewed in templates/headless/inherited.json: {', '.join(new)}" if new
                       else f"all reviewed ({reviewed['reviewed']})")))
    except (OSError, ValueError, KeyError):
        out.append(("ok", f"project allow rules the runs inherit: none ({WORK_TREE / '.claude/settings.json'} unreadable or absent)"))
    if mcp_list and label != "none":
        try:
            r = subprocess.run([CLAUDE, "mcp", "list"], env=env, cwd=WORK_TREE, capture_output=True, text=True, timeout=180)
            names = [l.split(": ", 1)[0] for l in r.stdout.splitlines() if ": " in l and not l.startswith("Checking")]
            conn = [n for n in names if n.startswith("claude.ai ")]
            plug = [n for n in names if n.startswith("plugin:")]
            out.append(("FAIL" if conn else "ok", "claude mcp list under the runs' login: "
                        + (f"connectors visible: {', '.join(conn)}" if conn else
                           (", ".join(names) or "nothing") + " (no claude.ai connectors"
                           + ("; plugin servers come from user settings, which the runs don't load" if plug else "") + ")")))
        except (OSError, subprocess.SubprocessError) as exc:
            out.append(("warn", f"claude mcp list: couldn't run ({exc.__class__.__name__})"))
    return out


def cmd_doctor(args):
    hl = headless_checks(mcp_list=not args.quick)
    mark = {"ok": "[  ok  ]", "warn": "[ warn ]", "FAIL": "[ FAIL ]"}
    if args.headless:
        for level, line in hl:
            print(f"{mark[level]} {line}")
        sys.exit(1 if any(level == "FAIL" for level, _ in hl) else 0)
    o = owner()
    ok = lambda c: "[  ok  ]" if c else "[ FAIL ]"
    print(f"{ok(TODO_FILE.exists())} {TODO_FILE}")
    print(f"{ok(repo_ready())} side-car repo {GIT_DIR}" + ("" if repo_ready() else " — run `todo init`"))
    data = gh("repo", "view", f"{o}/{DATA_REPO}", "--json", "visibility", "--jq", ".visibility", check=False)
    print(f"{ok(data.returncode == 0 and data.stdout.strip().upper() == 'PRIVATE')} data repo {o}/{DATA_REPO} is private")
    if repo_ready():
        r = git("fetch", "-q", "origin", BRANCH, check=False)
        head = git("rev-parse", "HEAD", check=False).stdout.strip()
        rem = git("rev-parse", f"origin/{BRANCH}", check=False).stdout.strip()
        print(f"{ok(r.returncode == 0)} fetch from origin" + (f"; {'in sync' if head == rem else 'differs — todo sync'}" if r.returncode == 0 else ""))
    t = subprocess.run(["systemctl", "--user", "is-active", "todo-sync.timer"], capture_output=True, text=True).stdout.strip()
    print(f"{ok(t == 'active')} todo-sync.timer {t or 'not installed'}")
    ib = [inbox_state(*i) for i in inbox_files()]
    print(f"{ok('running' not in ib or True)} flint inbox: {ib.count('waiting')} waiting, {ib.count('running')} running, {ib.count('answered')} answered since {INBOX_SINCE} (model {INBOX_MODEL}, cap {INBOX_TIMEOUT // 60} min)")
    site = gh("api", f"repos/{o}/{SITE_REPO}/pages", "--jq", ".html_url", check=False)
    print(f"{ok(site.returncode == 0)} Pages site " + (site.stdout.strip() if site.returncode == 0 else "not published — `todo site push`"))
    for level, line in hl:
        print(f"{mark[level]} {line}")
    print("\nBrowser token (one time, in the browser, never in a repo):")
    print("  github.com/settings/personal-access-tokens/new → Repository access: Only select → "
          f"{DATA_REPO}; Permissions → Contents: Read and write; expiry 1 year → Generate,")
    print(f"  then open {site_url(o)} and paste it. It stays in that browser's localStorage.")
    if any(level == "FAIL" for level, _ in hl):
        sys.exit(1)


def main():
    ap = argparse.ArgumentParser(prog="todo", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("ls"); p.add_argument("--all", action="store_true"); p.set_defaults(fn=cmd_ls)
    p = sub.add_parser("done"); p.add_argument("n", type=int, nargs="+"); p.set_defaults(fn=cmd_done)
    p = sub.add_parser("add"); p.add_argument("text"); p.add_argument("--section", type=int); p.add_argument("--by"); p.set_defaults(fn=cmd_add)
    p = sub.add_parser("sync"); p.add_argument("--quiet", action="store_true"); p.set_defaults(fn=cmd_sync)
    p = sub.add_parser("init"); p.set_defaults(fn=cmd_init)
    p = sub.add_parser("site"); p.add_argument("action", choices=["push"]); p.set_defaults(fn=cmd_site)
    p = sub.add_parser("open"); p.set_defaults(fn=cmd_open)
    p = sub.add_parser("doctor")
    p.add_argument("--headless", action="store_true", help="only the unattended runs' checks (B83)")
    p.add_argument("--quick", action="store_true", help="skip `claude mcp list` (it starts every server to check it)")
    p.set_defaults(fn=cmd_doctor)
    p = sub.add_parser("request", help="the request box: todo request \"<prompt>\" | todo request ls | todo request run NAME")
    p.add_argument("name", nargs="?", help="the prompt (new), or the request name (run)")
    p.add_argument("--later", action="store_true", help="file it; let the next sync start it")
    p.add_argument("--dry-run", action="store_true", help="print how the prompt would launch; file nothing")
    p.add_argument("--run", dest="action", action="store_const", const="run", default="new")
    p.add_argument("--ls", dest="action", action="store_const", const="ls")
    p.set_defaults(fn=cmd_request)
    p = sub.add_parser("inbox", help="Flint's inbox (flint/inbox -> flint/outbox): todo inbox ls | todo inbox run NAME")
    p.add_argument("name", nargs="?", help="the inbox file's name (run)")
    p.add_argument("--run", dest="action", action="store_const", const="run", default="ls")
    p.add_argument("--ls", dest="action", action="store_const", const="ls")
    p.set_defaults(fn=cmd_inbox)
    argv = sys.argv[1:]
    if argv[:2] == ["request", "ls"]:
        argv = ["request", "--ls"]
    elif argv[:2] == ["request", "run"]:
        argv = ["request", "--run", *argv[2:]]
    elif argv[:2] == ["inbox", "ls"]:
        argv = ["inbox", "--ls"]
    elif argv[:2] == ["inbox", "run"]:
        argv = ["inbox", "--run", *argv[2:]]
    args = ap.parse_args(argv)
    args.fn(args)


if __name__ == "__main__":
    main()
