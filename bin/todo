#!/usr/bin/env python3
"""todo — Taylor's todo list (~/projects/TAYLOR-TODO.md) in the terminal and on the web.

The file stays where every session writes it. A tiny git repo whose git-dir
lives beside it (~/projects/.todo-git, work tree ~/projects, everything but
the tracked docs excluded) mirrors it to a PRIVATE GitHub repo; a systemd user
timer runs `todo sync` every two minutes so local edits go up and ticks made
on the web come down. Since 2026-09-21 the same side-car also carries the
root planning docs (ROADMAP.md, VISION.md, HISTORY.md, CLAUDE.md, COWORK.md,
plans/) so Cowork on the MacBook reads the same plan (`TRACKED` below). The web page is a static file on GitHub Pages (a PUBLIC
repo holding only the page) that reads and writes the private file through the
GitHub API with a fine-grained token Taylor pastes once in the browser.

  todo ls [--all]              open items by section, numbered
  todo done <n> [<n>...]       tick item(s) by number from `todo ls`
  todo add "text" [--section N]   a new item (default: the "Later" section)
  todo sync                    local edits up, web ticks down (the timer's job)
  todo init                    one time: the private data repo, the timer
  todo site push               publish todo-site/index.html to the Pages repo
  todo open                    print the page URL
  todo doctor

Config, by name only (values never printed):
  GITHUB_TOKEN  in ~/.config/claude-tools/env — passed to gh as GH_TOKEN when
                present; otherwise gh's own login. Pushes use SSH.
  TODO_FILE     the markdown file (default ~/projects/TAYLOR-TODO.md)
  TODO_OWNER    GitHub owner for both repos (default: gh's logged-in user)
  TODO_DATA_REPO / TODO_SITE_REPO   default taylor-todo (private) / todo (public)
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import time
import sys
import tempfile
from datetime import date
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
SITE_DIR = HERE / "todo-site"
UNITS_DIR = HERE / "systemd"
TOOLBELT = Path(os.environ.get("CLAUDE_TOOLS_ENV", "~/.config/claude-tools/env")).expanduser()

TODO_FILE = Path(os.environ.get("TODO_FILE", "~/projects/TAYLOR-TODO.md")).expanduser()
WORK_TREE = TODO_FILE.parent
GIT_DIR = WORK_TREE / ".todo-git"
DATA_REPO = os.environ.get("TODO_DATA_REPO", "taylor-todo")
SITE_REPO = os.environ.get("TODO_SITE_REPO", "todo")
BRANCH = "main"
# Everything the side-car mirrors, relative to WORK_TREE. TAYLOR-TODO.md is
# the web page's file; the rest is the plan Cowork reads on the MacBook.
TRACKED = [TODO_FILE.name, "ROADMAP.md", "VISION.md", "HISTORY.md", "CLAUDE.md",
           "COWORK.md", "plans", "mac", "requests", "social"]
# `social` (added 2026-09-23, Flint): the group posts, the boards and the
# day-1 mock posts, so Cowork can post them from the Mac (ROADMAP B24).
# The request box (plans/01-cowork-bridge.md, B17): Cowork drops
# requests/<name>.md in the shared repo; each sync starts one unanswered
# request as a headless claude session in WORK_TREE and the reply lands in
# requests/<name>.reply.md, which the next sync pushes back.
REQUESTS = WORK_TREE / "requests"
REQUEST_TIMEOUT = int(os.environ.get("TODO_REQUEST_TIMEOUT", 45 * 60))
REQUEST_MAX_CHARS = 4000
REQUEST_NAME = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")


def tracked_paths():
    return [str(WORK_TREE / t) for t in TRACKED if (WORK_TREE / t).exists()]


def write_exclude():
    """Only the tracked docs are ever seen by the side-car; everything else is excluded."""
    (GIT_DIR / "info").mkdir(exist_ok=True)
    lines = ["*"] + [f"!/{t}" for t in TRACKED] + ["!/plans/**", "!/mac/**", "!/requests/**", "!/social/**"]
    (GIT_DIR / "info" / "exclude").write_text("\n".join(lines) + "\n")


ITEM_RE = re.compile(r"^- \[( |~|x)\] \*\*(.{12,80}?)(?:\*\*|$)", re.M)


def item_keys(text):
    """{first 12–80 chars of an item's bold title: its tick state}."""
    return {m.group(2): m.group(1) for m in ITEM_RE.finditer(text)}


def item_block(text, key):
    i = text.index("**" + key) - len("- [ ] ")
    m = re.search(r"\n(?=- \[|## )", text[i + 1:])
    return text[i:i + 1 + m.start() + 1] if m else text[i:]


def restore_dropped_items(before, after):
    """A remote edit (Cowork writing a stale copy) can silently delete open
    items. Ticking is fine; vanishing is not. Put the lost blocks back at the
    top of §1 and say so. Returns the new text and the keys restored."""
    b, a = item_keys(before), item_keys(after)
    lost = [k for k, st in b.items() if st in " ~" and k not in a]
    if not lost:
        return after, []
    blocks = []
    for k in lost:
        blk = item_block(before, k).rstrip("\n")
        blk += f"\n  _(restored by `todo sync` {date.today()}: a remote edit dropped it)_\n"
        blocks.append(blk)
    m = re.search(r"^## 1\..*$", after, re.M)
    if not m:
        return after + "\n" + "\n".join(blocks), lost
    first = re.search(r"^- \[", after[m.end():], re.M)
    at = m.end() + (first.start() if first else 0)
    return after[:at] + "\n".join(blocks) + "\n" + after[at:], lost


def guard_dropped(before, quiet):
    """After taking remote changes: put back any open item they deleted."""
    after = TODO_FILE.read_text()
    fixed, lost = restore_dropped_items(before, after)
    if not lost:
        return
    TODO_FILE.write_text(fixed)
    git("add", "--", str(TODO_FILE))
    git("commit", "-q", "-m", f"todo: restored {len(lost)} open item(s) a remote edit dropped")
    git("push", "-q", "origin", f"HEAD:{BRANCH}", check=False)
    print(f"restored {len(lost)} open item(s) a remote edit had dropped: "
          + "; ".join(k[:40] for k in lost), file=sys.stderr)

ITEM = re.compile(r"^- \[( |x|X)\] (.*)$")
SECTION = re.compile(r"^## (.*)$")
BOLD = re.compile(r"\*\*(.+?)\*\*")


# --- helpers ---------------------------------------------------------------

def die(msg, code=2):
    print(f"todo: {msg}", file=sys.stderr)
    sys.exit(code)


def toolbelt():
    env = {}
    if TOOLBELT.exists():
        for line in TOOLBELT.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, _, v = line.partition("=")
                env[k.strip()] = v.strip().strip('"').strip("'")
    return env


def gh_env():
    env = dict(os.environ)
    tok = toolbelt().get("GITHUB_TOKEN")
    if tok:
        env["GH_TOKEN"] = tok
    return env


def gh(*args, check=True, capture=True):
    r = subprocess.run(["gh", *args], env=gh_env(), text=True, capture_output=capture)
    if check and r.returncode:
        die(f"gh {' '.join(args[:2])} failed: {(r.stderr or r.stdout).strip()}")
    return r


def owner():
    o = os.environ.get("TODO_OWNER")
    if o:
        return o
    r = gh("api", "user", "--jq", ".login", check=False)
    if r.returncode:
        die("not logged in to GitHub: `gh auth login`, or setenv.sh GITHUB_TOKEN")
    return r.stdout.strip()


def git(*args, check=True, capture=True, quiet=False):
    """git against the side-car repo. Never touches anything but TODO_FILE."""
    cmd = ["git", f"--git-dir={GIT_DIR}", f"--work-tree={WORK_TREE}", *args]
    r = subprocess.run(cmd, text=True, capture_output=capture,
                       env=dict(os.environ, GIT_EDITOR="true", GIT_TERMINAL_PROMPT="0"))
    if check and r.returncode:
        die(f"git {args[0]}: {(r.stderr or r.stdout).strip()}")
    return r


def repo_ready():
    return (GIT_DIR / "HEAD").exists()


def site_url(o=None):
    o = (o or owner()).lower()
    return f"https://{o}.github.io/{SITE_REPO}/"


# --- the file --------------------------------------------------------------

def parse(text):
    """-> [{name, items: [{n, line, done, title}]}] ; n counts across sections.
    An item is `- [ ]`/`- [x]` at column 0 plus its indented continuation lines;
    the title is its first **bold** run (which may wrap), else the first line."""
    sections, cur, n = [], None, 0
    lines = text.splitlines()
    for i, line in enumerate(lines):
        m = SECTION.match(line)
        if m:
            cur = {"name": m.group(1).strip(), "items": []}
            sections.append(cur)
            continue
        m = ITEM.match(line)
        if m and cur is not None:
            n += 1
            body = [m.group(2).strip()]
            j = i + 1
            while j < len(lines) and (lines[j].startswith("  ") or (not lines[j].strip() and j + 1 < len(lines) and lines[j + 1].startswith("  "))):
                body.append(lines[j].strip())
                j += 1
            joined = " ".join(b for b in body if b)
            b = BOLD.search(joined)
            title = (b.group(1) if b else body[0])[:110]
            cur["items"].append({"n": n, "line": i, "done": m.group(1) != " ", "title": title})
    return sections


def cmd_ls(args):
    text = TODO_FILE.read_text()
    open_n = 0
    for s in parse(text):
        items = [it for it in s["items"] if args.all or not it["done"]]
        if not items:
            continue
        print(f"\n{s['name']}")
        for it in items:
            mark = "x" if it["done"] else " "
            open_n += not it["done"]
            print(f"  [{mark}] {it['n']:>2}  {it['title']}")
    print(f"\n{open_n} open · {TODO_FILE}")


def cmd_done(args):
    text = TODO_FILE.read_text()
    lines = text.splitlines(keepends=True)
    by_n = {it["n"]: it for s in parse(text) for it in s["items"]}
    for n in args.n:
        it = by_n.get(n)
        if not it:
            die(f"no item {n} (see `todo ls`)")
        if it["done"]:
            print(f"already done: {it['title']}")
            continue
        lines[it["line"]] = lines[it["line"]].replace("- [ ]", "- [x]", 1)
        print(f"done: {it['title']}")
    TODO_FILE.write_text("".join(lines))
    if repo_ready():
        cmd_sync(argparse.Namespace(quiet=True))


def cmd_add(args):
    text = TODO_FILE.read_text()
    lines = text.splitlines(keepends=True)
    sections = parse(text)
    if not sections:
        die("no '## ' sections in the file")
    # default: the "Later" section, wherever it sits — the file ends with a
    # Done archive, which is the last thing a new item should land in
    default = next((i + 1 for i, s in enumerate(sections) if "later" in s["name"].lower()), len(sections))
    idx = (args.section or default) - 1
    if not 0 <= idx < len(sections):
        die(f"--section must be 1..{len(sections)}")
    # insert after the section's last item (or its header), before the next header
    start = next(i for i, l in enumerate(lines) if SECTION.match(l) and SECTION.match(l).group(1).strip() == sections[idx]["name"])
    end = next((i for i in range(start + 1, len(lines)) if SECTION.match(lines[i])), len(lines))
    at = end
    while at > start + 1 and not lines[at - 1].strip():
        at -= 1
    who = args.by or "Taylor"
    entry = f"- [ ] **{args.text.strip().rstrip('.')}.** _({who}, {date.today().isoformat()})_\n"
    if at == start + 1 and lines[start].endswith("\n") and not (len(lines) > start + 1 and not lines[start + 1].strip()):
        entry = "\n" + entry            # a blank line under the header, like the other sections
    lines.insert(at, entry)
    TODO_FILE.write_text("".join(lines))
    print(f"added to {sections[idx]['name']}: {args.text.strip()}")
    if repo_ready():
        cmd_sync(argparse.Namespace(quiet=True))


# --- git sync --------------------------------------------------------------

def cmd_sync(args):
    if not repo_ready():
        die("no data repo yet: run `todo init`")
    if not TODO_FILE.exists():
        die(f"{TODO_FILE} is missing")
    q = getattr(args, "quiet", False)
    write_exclude()
    git("add", "--", *tracked_paths())
    if git("diff", "--cached", "--quiet", check=False).returncode:
        git("commit", "-q", "-m", "todo: local edit")
        if not q:
            print("committed local edit")
    r = git("fetch", "-q", "origin", BRANCH, check=False)
    if r.returncode:
        die(f"fetch failed (offline?): {r.stderr.strip()}", 1)
    local = git("rev-parse", "HEAD").stdout.strip()
    remote = git("rev-parse", f"origin/{BRANCH}").stdout.strip()
    before = TODO_FILE.read_text()
    if local == remote:
        if not q:
            print("in sync")
        start_requests(q)
        return
    if git("merge-base", "--is-ancestor", remote, local, check=False).returncode == 0:
        git("push", "-q", "origin", f"HEAD:{BRANCH}")
        if not q:
            print("pushed")
        start_requests(q)
        return
    if git("merge-base", "--is-ancestor", local, remote, check=False).returncode == 0:
        git("merge", "-q", "--ff-only", f"origin/{BRANCH}")
        if not q:
            print("pulled web changes")
        guard_dropped(before, q)
        start_requests(q)
        return
    # both moved: replay local on top of the web's version; on a clash the local line wins
    r = git("rebase", f"origin/{BRANCH}", check=False)
    if r.returncode:
        git("checkout", "--theirs", "--", *tracked_paths(), check=False)
        git("add", "--", *tracked_paths())
        r2 = git("rebase", "--continue", check=False)
        if r2.returncode:
            git("rebase", "--abort", check=False)
            die("rebase clash I couldn't settle; local file kept, will retry next tick", 1)
        print("merged: local edit and a web tick touched the same line; local kept")
    git("push", "-q", "origin", f"HEAD:{BRANCH}")
    if not q:
        print("merged and pushed")
    guard_dropped(before, q)
    start_requests(q)


# --- the request box -------------------------------------------------------

def request_files():
    """(name, prompt path, reply path, running marker) for every request, oldest first."""
    if not REQUESTS.exists():
        return []
    out = []
    for p in sorted(REQUESTS.glob("*.md"), key=lambda x: x.stat().st_mtime):
        if p.name.endswith(".reply.md"):
            continue
        name = p.stem
        if not REQUEST_NAME.match(name):
            continue
        out.append((name, p, REQUESTS / f"{name}.reply.md", REQUESTS / f"{name}.running"))
    return out


def request_state(name, prompt, reply, running):
    if reply.exists():
        return "answered"
    if running.exists():
        return "running"
    return "waiting"


def new_request_name(prompt):
    stem = re.sub(r"[^a-z0-9]+", "-", prompt.strip().lower())[:40].strip("-") or "request"
    stamp = time.strftime("%m%d-%H%M")
    name = f"{stem}-{stamp}"
    n = 2
    while (REQUESTS / f"{name}.md").exists():
        name = f"{stem}-{stamp}-{n}"
        n += 1
    return name


def start_requests(quiet=False):
    """Start the oldest unanswered request, detached, unless one is running.
    Never raises: a broken request box must not stop the sync."""
    try:
        reqs = request_files()
        if any(state == "running" for state in (request_state(*r) for r in reqs)):
            return
        for name, prompt, reply, running in reqs:
            if request_state(name, prompt, reply, running) != "waiting":
                continue
            running.write_text(f"started {time.strftime('%Y-%m-%d %H:%M:%S')} by todo sync\n")
            cmd = ["systemd-run", "--user", "--quiet", "--collect", f"--unit=todo-request-{name}",
                   "--setenv=PATH=" + os.environ.get("PATH", "") + ":" + str(Path.home() / ".local/bin"),
                   str(Path(__file__).resolve()), "request", "run", name]
            r = subprocess.run(cmd, capture_output=True, text=True)
            if r.returncode:
                running.unlink(missing_ok=True)
                print(f"todo: could not start request {name}: {(r.stderr or r.stdout).strip()}", file=sys.stderr)
            elif not quiet:
                print(f"started request {name}")
            return
    except Exception as exc:  # noqa: BLE001
        print(f"todo: request box skipped: {exc}", file=sys.stderr)


def cmd_request(args):
    if args.action == "ls":
        reqs = request_files()
        if not reqs:
            print("no requests")
        for name, prompt, reply, running in reqs:
            first = prompt.read_text().strip().splitlines()[0] if prompt.read_text().strip() else ""
            print(f"  {request_state(name, prompt, reply, running):<9} {name}  {first[:70]}")
        return
    if args.action == "run":
        run_request(args.name)
        return
    # action == "new": file one (and start it now unless --later)
    text = (args.name or "").strip()
    if not text:
        die("todo request \"<prompt>\"")
    if len(text) > REQUEST_MAX_CHARS:
        die(f"prompt is over {REQUEST_MAX_CHARS} characters")
    REQUESTS.mkdir(exist_ok=True)
    name = new_request_name(text)
    (REQUESTS / f"{name}.md").write_text(text + "\n")
    print(name)
    if not args.later:
        start_requests(quiet=True)


def run_request(name):
    """Run one request to its reply file. Called detached by start_requests."""
    if not REQUEST_NAME.match(name or ""):
        die("bad request name")
    prompt_path, reply, running = REQUESTS / f"{name}.md", REQUESTS / f"{name}.reply.md", REQUESTS / f"{name}.running"
    if not prompt_path.exists():
        die(f"no such request: {name}")
    if reply.exists():
        die(f"{name} is already answered")
    prompt = prompt_path.read_text().strip()[:REQUEST_MAX_CHARS]
    started = time.strftime("%Y-%m-%d %H:%M:%S")
    running.write_text(f"started {started}\n")
    head = [f"# reply to {name}", f"started {started} in {WORK_TREE}", ""]
    try:
        r = subprocess.run(["claude", "-p", prompt, "--permission-mode", "auto", "--output-format", "json"],
                           cwd=WORK_TREE, capture_output=True, text=True, timeout=REQUEST_TIMEOUT,
                           env=dict(os.environ, TODO_REQUEST=name))
        body, meta = r.stdout, {}
        try:
            data = json.loads(r.stdout)
            body = data.get("result") or r.stdout
            meta = {k: data.get(k) for k in ("num_turns", "duration_ms", "total_cost_usd", "is_error") if k in data}
        except ValueError:
            pass
        status = f"finished {time.strftime('%Y-%m-%d %H:%M:%S')}, exit {r.returncode}"
        if meta:
            status += f", {meta.get('num_turns', '?')} turns, {round((meta.get('duration_ms') or 0) / 60000, 1)} min, ${meta.get('total_cost_usd') or 0:.2f}"
        if r.returncode and r.stderr.strip():
            body = (body or "") + "\n\nstderr:\n" + r.stderr.strip()[-2000:]
    except subprocess.TimeoutExpired:
        status = f"timed out after {REQUEST_TIMEOUT // 60} minutes"
        body = "(the session was stopped at the cap; whatever it committed is in the repos)"
    except FileNotFoundError:
        status = "failed: claude is not on PATH for the runner"
        body = ""
    reply.write_text("\n".join(head + [status, "", (body or "").strip()[-20000:], ""]))
    running.unlink(missing_ok=True)


def cmd_init(args):
    o = owner()
    if not TODO_FILE.exists():
        die(f"{TODO_FILE} doesn't exist")
    full = f"{o}/{DATA_REPO}"
    if gh("repo", "view", full, "--json", "name", check=False).returncode:
        gh("repo", "create", full, "--private", "--description", "Taylor's todo list (synced from ~/projects/TAYLOR-TODO.md)")
        print(f"created private repo {full}")
    else:
        vis = gh("repo", "view", full, "--json", "visibility", "--jq", ".visibility").stdout.strip()
        if vis.upper() != "PRIVATE":
            die(f"{full} exists but is {vis}; the todo has client names in it — make it private first")
    if not repo_ready():
        git("init", "-q", "-b", BRANCH)
        write_exclude()
        git("config", "core.worktree", str(WORK_TREE))
        git("config", "user.name", "todo sync")
        git("config", "user.email", "todo@localhost")
        git("remote", "add", "origin", f"git@github.com:{full}.git")
        print(f"side-car repo at {GIT_DIR} (tracks {', '.join(TRACKED)})")
    r = git("fetch", "-q", "origin", BRANCH, check=False)
    if r.returncode == 0 and git("rev-parse", "-q", "--verify", "HEAD", check=False).returncode:
        # remote has history, we have none: adopt it, then commit the local version on top
        git("reset", "-q", "--soft", f"origin/{BRANCH}")
    git("add", "--", *tracked_paths())
    if git("diff", "--cached", "--quiet", check=False).returncode or git("rev-parse", "-q", "--verify", "HEAD", check=False).returncode:
        git("commit", "-q", "-m", "todo: sync from the laptop")
    git("push", "-q", "-u", "origin", f"HEAD:{BRANCH}")
    print(f"pushed {TODO_FILE.name} to {full}")
    install_timer()
    print("next: `todo site push` to publish the page, then create the browser token (todo doctor lists the steps)")


def install_timer():
    user_units = Path.home() / ".config/systemd/user"
    user_units.mkdir(parents=True, exist_ok=True)
    for name in ("todo-sync.service", "todo-sync.timer"):
        src = UNITS_DIR / name
        if not src.exists():
            die(f"missing {src}")
        dst = user_units / name
        if dst.is_symlink() or dst.exists():
            dst.unlink()
        dst.symlink_to(src)
    r = subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True, text=True)
    if r.returncode:
        print(f"note: systemctl --user daemon-reload failed ({r.stderr.strip()}); enable the timer by hand")
        return
    subprocess.run(["systemctl", "--user", "enable", "--now", "todo-sync.timer"], capture_output=True, text=True)
    print("timer: todo-sync.timer every 2 minutes (systemctl --user status todo-sync.timer)")


# --- the page --------------------------------------------------------------

def cmd_site(args):
    if args.action != "push":
        die("site: only `push`")
    o = owner()
    full = f"{o}/{SITE_REPO}"
    page = SITE_DIR / "index.html"
    if not page.exists():
        die(f"missing {page}")
    if gh("repo", "view", full, "--json", "name", check=False).returncode:
        gh("repo", "create", full, "--public", "--description", "A checklist page for TAYLOR-TODO.md (data lives in a private repo)")
        print(f"created public repo {full}")
    with tempfile.TemporaryDirectory() as tmp:
        clone = Path(tmp) / "site"
        r = subprocess.run(["git", "clone", "-q", "--depth", "1", f"git@github.com:{full}.git", str(clone)],
                           capture_output=True, text=True, env=dict(os.environ, GIT_TERMINAL_PROMPT="0"))
        if r.returncode:                    # empty repo: clone fails, so start one
            clone.mkdir()
            subprocess.run(["git", "init", "-q", "-b", BRANCH], cwd=clone, check=True)
            subprocess.run(["git", "remote", "add", "origin", f"git@github.com:{full}.git"], cwd=clone, check=True)
        for f in SITE_DIR.iterdir():
            if f.is_file():
                shutil.copy(f, clone / f.name)
        (clone / ".nojekyll").write_text("")
        (clone / "README.md").write_text(
            f"# todo\n\nThe page at {site_url(o)} — a checklist view of a markdown todo file that lives "
            f"in a private repo. This repo holds only the page; it has no data in it.\n"
            f"Source of truth: `claude-tools/todo-site/`, published with `todo site push`.\n")
        subprocess.run(["git", "add", "-A"], cwd=clone, check=True)
        if subprocess.run(["git", "diff", "--cached", "--quiet"], cwd=clone).returncode == 0 and \
                subprocess.run(["git", "rev-parse", "-q", "--verify", "HEAD"], cwd=clone, capture_output=True).returncode == 0:
            print("page unchanged")
        else:
            subprocess.run(["git", "-c", "user.name=todo", "-c", "user.email=todo@localhost", "commit", "-q", "-m",
                            "publish todo page"], cwd=clone, check=True)
            subprocess.run(["git", "push", "-q", "origin", f"HEAD:{BRANCH}"], cwd=clone, check=True)
            print(f"pushed page to {full}")
    r = gh("api", f"repos/{full}/pages", check=False)
    if r.returncode:
        r = gh("api", "-X", "POST", f"repos/{full}/pages", "-f", f"source[branch]={BRANCH}", "-f", "source[path]=/", check=False)
        if r.returncode:
            die(f"couldn't enable Pages: {(r.stderr or r.stdout).strip()} — Settings → Pages → branch main")
        print("Pages turned on (first build takes a minute)")
    print(site_url(o))


def cmd_open(args):
    print(site_url())


def cmd_doctor(args):
    o = owner()
    ok = lambda c: "[  ok  ]" if c else "[ FAIL ]"
    print(f"{ok(TODO_FILE.exists())} {TODO_FILE}")
    print(f"{ok(repo_ready())} side-car repo {GIT_DIR}" + ("" if repo_ready() else " — run `todo init`"))
    data = gh("repo", "view", f"{o}/{DATA_REPO}", "--json", "visibility", "--jq", ".visibility", check=False)
    print(f"{ok(data.returncode == 0 and data.stdout.strip().upper() == 'PRIVATE')} data repo {o}/{DATA_REPO} is private")
    if repo_ready():
        r = git("fetch", "-q", "origin", BRANCH, check=False)
        head = git("rev-parse", "HEAD", check=False).stdout.strip()
        rem = git("rev-parse", f"origin/{BRANCH}", check=False).stdout.strip()
        print(f"{ok(r.returncode == 0)} fetch from origin" + (f"; {'in sync' if head == rem else 'differs — todo sync'}" if r.returncode == 0 else ""))
    t = subprocess.run(["systemctl", "--user", "is-active", "todo-sync.timer"], capture_output=True, text=True).stdout.strip()
    print(f"{ok(t == 'active')} todo-sync.timer {t or 'not installed'}")
    site = gh("api", f"repos/{o}/{SITE_REPO}/pages", "--jq", ".html_url", check=False)
    print(f"{ok(site.returncode == 0)} Pages site " + (site.stdout.strip() if site.returncode == 0 else "not published — `todo site push`"))
    print("\nBrowser token (one time, in the browser, never in a repo):")
    print("  github.com/settings/personal-access-tokens/new → Repository access: Only select → "
          f"{DATA_REPO}; Permissions → Contents: Read and write; expiry 1 year → Generate,")
    print(f"  then open {site_url(o)} and paste it. It stays in that browser's localStorage.")


def main():
    ap = argparse.ArgumentParser(prog="todo", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("ls"); p.add_argument("--all", action="store_true"); p.set_defaults(fn=cmd_ls)
    p = sub.add_parser("done"); p.add_argument("n", type=int, nargs="+"); p.set_defaults(fn=cmd_done)
    p = sub.add_parser("add"); p.add_argument("text"); p.add_argument("--section", type=int); p.add_argument("--by"); p.set_defaults(fn=cmd_add)
    p = sub.add_parser("sync"); p.add_argument("--quiet", action="store_true"); p.set_defaults(fn=cmd_sync)
    p = sub.add_parser("init"); p.set_defaults(fn=cmd_init)
    p = sub.add_parser("site"); p.add_argument("action", choices=["push"]); p.set_defaults(fn=cmd_site)
    p = sub.add_parser("open"); p.set_defaults(fn=cmd_open)
    p = sub.add_parser("doctor"); p.set_defaults(fn=cmd_doctor)
    p = sub.add_parser("request", help="the request box: todo request \"<prompt>\" | todo request ls | todo request run NAME")
    p.add_argument("name", nargs="?", help="the prompt (new), or the request name (run)")
    p.add_argument("--later", action="store_true", help="file it; let the next sync start it")
    p.add_argument("--run", dest="action", action="store_const", const="run", default="new")
    p.add_argument("--ls", dest="action", action="store_const", const="ls")
    p.set_defaults(fn=cmd_request)
    argv = sys.argv[1:]
    if argv[:2] == ["request", "ls"]:
        argv = ["request", "--ls"]
    elif argv[:2] == ["request", "run"]:
        argv = ["request", "--run", *argv[2:]]
    args = ap.parse_args(argv)
    args.fn(args)


if __name__ == "__main__":
    main()
