[Unit]
Description=Put every demo site (clients/demo-*, testaurant) back to its golden copy, files and data (ROADMAP B4, B30)
After=network-online.target

[Service]
TimeoutStartSec=1800
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/demo reset --all
StandardOutput=append:%h/projects/claude-tools/logs/demo-reset.log
StandardError=append:%h/projects/claude-tools/logs/demo-reset.log
