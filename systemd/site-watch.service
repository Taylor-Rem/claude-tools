[Unit]
Description=Patchlamp: every live client site and preview checked; the record in sms-relay/state/uptime.json (ROADMAP B72)
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=600
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/site watch --once
StandardOutput=append:%h/projects/claude-tools/logs/site-watch.log
StandardError=append:%h/projects/claude-tools/logs/site-watch.log
