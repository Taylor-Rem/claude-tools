{
  "model": "opus",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Glob",
      "Grep",
      "Bash(ls)",
      "Bash(ls repos/*)",
      "Bash(ls incoming/*)",
      "Bash(ls -la repos/*)",
      "Bash(ls -la incoming/*)",
      "Bash(head repos/*)",
      "Bash(head incoming/*)",
      "Bash(wc * repos/*)",
      "Bash(grep * repos/*)",
      "Bash(file incoming/*)",
      "Bash(rm incoming/*)",
      "Bash(mv incoming/*)",
      "Bash(python3 -m json.tool repos/*)",
      "Bash(img *)",
      "Bash(site *)",
      "Bash(newsletter *)",
      "Bash(gbp *)",
      "Bash(social *)",
      "Bash(shot *)"
    ],
    "deny": [
      "Bash(* /home/*)",
      "Bash(*~/*)",
      "Bash(*../*)",
      "Bash(*$HOME*)",
      "Bash(*$ANTHROPIC*)",
      "Bash(*$GEMINI*)",
      "Bash(*_API_KEY*)",
      "Bash(*_TOKEN*)",
      "Bash(*printenv*)",
      "Bash(*${*)",
      "Bash(*$(*)",
      "Bash(*`*)",
      "Bash(*/etc/*)",
      "Bash(* /tmp/*)",
      "Bash(*/proc/*)",
      "Bash(*/var/*)",
      "Bash(*/root/*)",
      "Bash(* .claude/*)",
      "Bash(* .client.json*)",
      "Bash(* .git/*)",
      "Bash(git -C repos/* push *--force*)",
      "Bash(git -C repos/* push *-f*)",
      "Bash(git -C repos/* push *:*)",
      "Bash(git -C repos/* reset --hard*)",
      "Bash(git -C repos/* config *)",
      "Bash(git -C repos/* clean*)",
      "Bash(git -C repos/* branch -D*)",
      "Bash(git -C repos/* remote *)",
      "Bash(git push*)",
      "Bash(git config*)",
      "Bash(rm -rf:*)",
      "Bash(python3 -c:*)",
      "Bash(python -c:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(env:*)",
      "Read(~/.config/**)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Read(~/projects/sms-relay/**)",
      "Read(~/projects/claude-tools/**)",
      "Read(~/projects/rem-portfolio/**)",
      "Read(~/projects/rooms/**)",
      "Bash(cat *)",
      "Bash(cp *)",
      "Bash(mv repos/* incoming/*)",
      "mcp__playwright"
    ]
  },
  "_rules": {
    "repos": [
      "Bash(git -C repos/* status*)",
      "Bash(git -C repos/* log*)",
      "Bash(git -C repos/* diff*)",
      "Bash(git -C repos/* show*)",
      "Bash(git -C repos/* add *)",
      "Bash(git -C repos/* commit *)",
      "Bash(git -C repos/* push)",
      "Bash(git -C repos/* push origin main)",
      "Bash(git -C repos/* pull)",
      "Bash(git -C repos/* pull origin main)",
      "Bash(git -C repos/* revert HEAD*)",
      "Bash(git -C repos/* checkout -- *)",
      "Bash(git -C repos/* rev-parse*)",
      "Bash(git -C repos/* mv *)",
      "Bash(git -C repos/* rm *)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(python3 -m http.server*)",
      "Bash(mkdir repos/*)",
      "Bash(mv incoming/* repos/*)",
      "Bash(mv repos/* repos/*)",
      "Bash(rm repos/*)",
      "Bash(cp incoming/* repos/*)",
      "Bash(cp repos/* repos/*)",
      "Bash(magick incoming/*)",
      "Bash(magick repos/*)",
      "Bash(magick * incoming/*)",
      "Bash(magick * repos/*)",
      "Bash(identify incoming/*)",
      "Bash(identify repos/*)"
    ],
    "live_url": [
      "Bash(curl -s {url}*)",
      "Bash(curl -sI {url}*)",
      "Bash(curl -s -o /dev/null -w * {url}*)"
    ]
  }
}
