{
  "mcpServers": {
    "playwright": {
      "command": "node",
      "args": [
        "{{TOOLBELT}}/node_modules/@playwright/mcp/cli.js",
        "--browser",
        "chrome",
        "--headless",
        "--isolated",
        "--viewport-size",
        "1280x800",
        "--output-dir",
        "{{PROJECTS}}/shots/mcp"
      ]
    }
  }
}
