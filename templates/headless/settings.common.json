{
  "_about": "B83: the part every unattended run shares (the request box, Flint's inbox, build-night). `todo` merges this with settings.request.json or settings.build.json into ~/.local/state/claude-tools/headless/ before each run and launches with --settings <that file> --setting-sources project --strict-mcp-config --mcp-config <mcp.json>. A prompt that arrives through the shared repo can be written by anyone holding one of the repo's credentials, so these runs never get the key files, the claude.ai connectors, the two browser tools that run code or send files, or the settings that decide what later sessions may do. Deny rules win over every allow, including the ones inherited from ~/projects/.claude/settings.json. {{PROJECTS}}, {{CONFIG}} and {{TOOLBELT}} are filled in at stamp time.",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(~/.config/**)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Read(~/.claude-relay/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/scripts/.dev-refresh.env)",
      "Read(/{{CONFIG}}/*.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(/{{PROJECTS}}/sms-relay/config.json)",

      "Edit(~/.config/**)",
      "Write(~/.config/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "Edit(~/.claude.json)",
      "Write(~/.claude.json)",
      "Edit(/{{CONFIG}}/*.json)",
      "Write(/{{CONFIG}}/*.json)",
      "Edit(/{{PROJECTS}}/.claude/**)",
      "Write(/{{PROJECTS}}/.claude/**)",
      "Edit(/{{PROJECTS}}/.mcp.json)",
      "Write(/{{PROJECTS}}/.mcp.json)",
      "Edit(/{{PROJECTS}}/.todo-git/**)",
      "Write(/{{PROJECTS}}/.todo-git/**)",
      "Edit(**/.git/hooks/**)",
      "Write(**/.git/hooks/**)",
      "Edit(~/.local/bin/**)",
      "Write(~/.local/bin/**)",
      "Edit(~/.bashrc)",
      "Write(~/.bashrc)",
      "Edit(~/.profile)",
      "Write(~/.profile)",

      "mcp__playwright__browser_run_code_unsafe",
      "mcp__playwright__browser_file_upload",

      "Bash(*.config/claude-tools*)",
      "Bash(*.ssh*)",
      "Bash(*.credentials.json*)",
      "Bash(*.claude.json*)",
      "Bash(*.claude-relay*)",
