{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read(/{{DIR}}/**)",
      "Edit(/{{DIR}}/content.json)",
      "Write(/{{DIR}}/content.json)",
      "Edit(/{{DIR}}/message.json)",
      "Write(/{{DIR}}/message.json)",
      "Write(/{{DIR}}/notes.md)",
      "Edit(/{{DIR}}/notes.md)",
      "Glob",
      "Grep",
      "Bash(leads preview --from content.json --out site)",
      "Bash(leads preview --from content.json --out site:*)",
      "Bash(shot:*)",
      "Bash(img stock:*)",
      "Bash(prep check)",
      "Bash(prep check:*)",
      "Bash(prep message)",
      "Bash(prep message:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "WebFetch(domain:facebook.com)",
      "WebFetch(domain:*.facebook.com)",
      "WebFetch(domain:fb.com)",
      "WebFetch(domain:*.fb.com)",
      "WebFetch(domain:fb.me)",
      "WebFetch(domain:*.fb.me)",
      "WebFetch(domain:fb.gg)",
      "WebFetch(domain:*.fb.gg)",
      "WebFetch(domain:fb.watch)",
      "WebFetch(domain:*.fb.watch)",
      "WebFetch(domain:fbcdn.net)",
      "WebFetch(domain:*.fbcdn.net)",
      "WebFetch(domain:fbsbx.com)",
      "WebFetch(domain:*.fbsbx.com)",
      "WebFetch(domain:facebook.net)",
      "WebFetch(domain:*.facebook.net)",
      "WebFetch(domain:instagram.com)",
      "WebFetch(domain:*.instagram.com)",
      "WebFetch(domain:instagr.am)",
      "WebFetch(domain:*.instagr.am)",
      "WebFetch(domain:cdninstagram.com)",
      "WebFetch(domain:*.cdninstagram.com)",
      "WebFetch(domain:ig.me)",
      "WebFetch(domain:*.ig.me)",
      "WebFetch(domain:threads.net)",
      "WebFetch(domain:*.threads.net)",
      "WebFetch(domain:threads.com)",
      "WebFetch(domain:*.threads.com)",
      "WebFetch(domain:messenger.com)",
      "WebFetch(domain:*.messenger.com)",
      "WebFetch(domain:m.me)",
      "WebFetch(domain:*.m.me)",
      "WebFetch(domain:whatsapp.com)",
      "WebFetch(domain:*.whatsapp.com)",
      "WebFetch(domain:whatsapp.net)",
      "WebFetch(domain:*.whatsapp.net)",
      "WebFetch(domain:wa.me)",
      "WebFetch(domain:*.wa.me)",
      "WebFetch(domain:meta.com)",
      "WebFetch(domain:*.meta.com)",
      "WebFetch(domain:meta.ai)",
      "WebFetch(domain:*.meta.ai)",
      "Edit(/{{DIR}}/log/**)",
      "Write(/{{DIR}}/log/**)",
      "Edit(/{{DIR}}/.claude/**)",
      "Write(/{{DIR}}/.claude/**)",
      "Edit(/{{DIR}}/listing.json)",
      "Write(/{{DIR}}/listing.json)",
      "Edit(/{{DIR}}/packet.json)",
      "Write(/{{DIR}}/packet.json)",
      "Edit(/{{DIR}}/facts.json)",
      "Write(/{{DIR}}/facts.json)",
      "Edit(/{{DIR}}/site/**)",
      "Write(/{{DIR}}/site/**)",
      "Edit(/{{DIR}}/shots/**)",
      "Write(/{{DIR}}/shots/**)",
      "Edit(/{{DIR}}/BUILD.md)",
      "Write(/{{DIR}}/BUILD.md)",
      "Edit(/{{DIR}}/CLAUDE.md)",
      "Write(/{{DIR}}/CLAUDE.md)",
      "Edit(/{{DIR}}/review.json)",
      "Write(/{{DIR}}/review.json)",
      "Edit(/{{DIR}}/check.json)",
      "Write(/{{DIR}}/check.json)",
      "Read(~/.config/**)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/**)",
      "Read(~/.claude-relay/**)",
      "Read(~/projects/**)",
      "Read(~/.local/state/claude-tools/leads/**)",
      "Read(/etc/**)",
      "Bash(site:*)",
      "Bash(git:*)",
      "Bash(notify:*)",
      "Bash(client:*)",
      "Bash(outreach:*)",
      "Bash(social:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(python3:*)",
      "Bash(ssh:*)",
      "Bash(img gen:*)",
      "Bash(img edit:*)",
      "Bash(img video:*)",
      "Bash(leads kit:*)",
      "Bash(leads sent:*)",
      "Bash(leads log:*)",
      "Bash(prep run:*)",
      "Bash(prep finish:*)",
      "Bash(prep publish:*)",
      "Bash(prep approve:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK}}",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
