#!/usr/bin/env python3
"""A stand-in for `claude` in tests/test_todo_headless.py: no network, no model.
Records every call (argv and the env names the launcher decides) to $FAKE_LOG as JSON lines."""
import json
import os
import sys

argv = sys.argv[1:]
keys = ("CLAUDE_CONFIG_DIR", "CLAUDE_CODE_OAUTH_TOKEN", "ENABLE_CLAUDEAI_MCP_SERVERS", "SHOT_SANDBOX",
        "ANTHROPIC_API_KEY", "CLAUDE_HEADLESS_OAUTH_TOKEN", "TODO_REQUEST", "TODO_INBOX")
if os.environ.get("FAKE_LOG"):
    with open(os.environ["FAKE_LOG"], "a") as f:
        f.write(json.dumps({"argv": argv, "env": {k: os.environ[k] for k in keys if k in os.environ}}) + "\n")
if argv[:2] == ["auth", "status"]:
    method = os.environ.get("FAKE_AUTH", "claude.ai")
    print(json.dumps({"loggedIn": method != "none", "authMethod": method}))
    sys.exit(0 if method != "none" else 1)
if argv[:1] == ["doctor"]:
    print("Claude Code doctor\n")
    if os.environ.get("FAKE_INVALID"):
        print("Invalid settings\n- /x/.claude/settings.json › permissions.deny: Invalid permission rule \"Bogus(x\" was skipped")
    sys.exit(0)
if argv[:2] == ["mcp", "list"]:
    print("Checking MCP server health…\n")
    if os.environ.get("FAKE_CONNECTORS"):
        print("claude.ai Gmail: https://gmailmcp.example/mcp - ✔ Connected")
    print("playwright: node cli.js --headless - ✔ Connected")
    sys.exit(0)
if "-p" in argv:
    print(json.dumps({"result": "fake answer", "num_turns": 1, "duration_ms": 1000, "total_cost_usd": 0}))
    sys.exit(0)
print("fake-claude: unexpected call " + " ".join(argv), file=sys.stderr)
sys.exit(2)
